# sing-box-plus-manager 的 .env 只放**构建与推拉所需的本地输入**（README §5），
# 不放任何运行时配置——真实运行配置在 /etc/proxy-manager/server.toml 与 nodes.toml。
#
# 复制成 .env 后填本机实际值。.env 已被仓库根 .gitignore 挡住，不要提交。

# git pull / push 用的 SSH 私钥与口令（仓库根 CLAUDE.md「Git 约定」）
PrivateKey=
Passphrase=

# 节点侧契约来源：同仓库的 sing-box-plus 子项目。
# 夹具按这个路径读取上游样例入口；留空则回落到 ../sing-box-plus。
SING_BOX_PLUS_DIR=

# 导出上游样例用的 Python 解释器。留空则用 PATH 上的 python3。
# 缺失时测试**判失败而不是跳过**——skip 不等于 pass（README §8）。
PYTHON=
