# sing-box-plus 本地开发与构建的可选输入。
# 实际使用时复制为 .env（已在 .gitignore 中），不要提交任何真实值。
# 该文件只允许 KEY=VALUE 行，由 scripts/lib.sh 按固定白名单导入，绝不作为 shell 执行。

# 上游仓库覆盖地址（默认取 upstream.lock 的 repository）
UPSTREAM_REPOSITORY=

# Go 模块缓存与构建缓存（用于可复现构建时把路径固定下来）
GOMODCACHE=
GOCACHE=

# 构建 tag 集。生产集见 README §9.1（D4）：
#   with_utls,badlinkname,with_user_stats
# 里程碑 2 的 PoC 集额外加 with_v2ray_api
SING_BOX_BUILD_TAGS=with_utls,badlinkname,with_user_stats
