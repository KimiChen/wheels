+    fn udp_cooldown_anchors_on_the_last_eligible_attempt() {
+        let cache = UdpAuditWindowCache::new(4, USER_AUDIT_UDP_WINDOW_SHARDS * 4);
+        let server_id: Arc<str> = Arc::from("server-a");
+        let association = [9u8; 16];
