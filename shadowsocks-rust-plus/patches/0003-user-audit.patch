+[package]
+name = "shadowsocks-audit-protocol-fuzz"
+version = "0.0.0"
+publish = false
+edition = "2024"
+
+# Keep the fuzz package outside the production workspace. cargo-fuzz creates
+# its own target directory and lockfile, while the normal workspace remains
+# reproducible with the checked-in Cargo.lock.
+[workspace]
+
+[package.metadata]
+cargo-fuzz = true
+
+[dependencies]
+libfuzzer-sys = "0.4"
+serde_json = "1.0"
+shadowsocks-audit-protocol = { path = "../crates/shadowsocks-audit-protocol" }
+
+[[bin]]
+name = "audit_protocol"
+path = "fuzz_targets/audit_protocol.rs"
+test = false
+doc = false
+bench = false
