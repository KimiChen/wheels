+    /// m-173/M-41: §9.4 requires recovery to scan the fixed `gap_event_id`
+    /// first and only complete the pending transaction when that gap is already
+    /// durable.  The scan is the `durable_gap_reasons` index, so the index has
+    /// to be built *before* the startup flush block that consults it.  This
+    /// fixture reproduces the crash window `evict_sealed_locked` leaves behind
+    /// (batch deleted, fixed gap durable, pending entry and its marker not yet
+    /// compacted): rebuilding the index after the flush leaves it empty here
+    /// and appends a second record carrying the same `gap_event_id`.
+    #[test]
+    fn restart_inside_the_eviction_window_does_not_duplicate_the_fixed_gap() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        let gap_id = format!("{GAP_ID_PREFIX}{}", "1".repeat(32));
+        let batch_id = "2".repeat(32);
+        let spool = Spool::open(config(dir.path())).expect("spool");
+        // A producer record keeps the epoch and cursor provable, so the restart
+        // below takes the ordinary recovery path instead of a state reset.
+        spool.append(&event(1), 1).expect("append");
+        {
+            let mut inner = lock(&spool.inner);
+            spool
+                .add_tombstone_locked(&mut inner, eviction_pending_for_test(&gap_id, &batch_id))
+                .expect("pending eviction");
+            spool
+                .write_gap_locked(&mut inner, &eviction_gap_spec_for_test(&gap_id, &batch_id))
+                .expect("durable eviction gap");
+        }
+        let marker = dir.path().join(format!(
+            "{TOMBSTONE_PENDING_MARKER_PREFIX}{}.json",
+            &gap_id[GAP_ID_PREFIX.len()..]
+        ));
+        assert!(marker.exists(), "the crash window keeps the pending marker on disk");
+        assert_eq!(
+            durable_gap_ids(dir.path()),
+            vec![gap_id.clone()],
+            "the fixture must start with exactly one durable copy of the fixed gap"
+        );
+        let sequence_before = lock(&spool.inner).next_sequence;
+        drop(spool);
+
+        let recovered = Spool::open(config(dir.path())).expect("recover eviction window");
+        assert_eq!(
+            durable_gap_ids(dir.path()),
+            vec![gap_id.clone()],
+            "recovery must not append a second record with the same fixed gap_event_id"
+        );
+        let inner = lock(&recovered.inner);
+        assert_eq!(
+            inner.next_sequence, sequence_before,
+            "an already durable gap must not consume another spool sequence"
+        );
+        assert!(
+            inner
+                .tombstones
+                .iter()
+                .any(|entry| matches!(entry, TombstoneEntry::EvictedReceipt(value) if value.batch_id == batch_id)),
+            "the pending transaction must still be compacted into its receipt"
+        );
+        drop(inner);
+        assert!(!marker.exists(), "resolved pending marker should be removed");
+    }
