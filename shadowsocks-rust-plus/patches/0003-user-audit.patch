+            body.split_inclusive(|byte| *byte == b'\n').count(),
+            1,
+            "only the record that triggered the barrier may be on disk"
+        );
+        assert!(
+            body.windows(first_gap.len())
+                .any(|window| window == first_gap.as_bytes())
+        );
+        assert!(
+            !body
+                .windows(second_gap.len())
+                .any(|window| window == second_gap.as_bytes()),
+            "no further gap may be written after the fatal barrier"
+        );
+        assert!(
+            !body.windows(9).any(|window| window == b"\"access\""),
+            "the producer event must not reach the spool after the fatal barrier"
+        );
+    }
