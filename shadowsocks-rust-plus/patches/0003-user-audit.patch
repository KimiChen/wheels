+    /// `m-235`：state.json 的写屏障完整成功之后，事后量文件大小失败不得再
+    /// 升级成 `DurabilityUncertain` 关停守护进程——与 m-234 在 tombstones.json
+    /// 上确立的是同一条规则：屏障结果已确定时，一次纯记账读失败只让增量字节
+    /// 索引不可信，清掉 `spool_bytes_known` 强制全量重测即可。state.json 每条
+    /// record 都要重写，误退出的暴露面比 tombstones.json 更大。
+    ///
+    /// 变异检验：把记账失败改回 `return Err(AtomicWriteError::AfterRename(..))`，
+    /// 第一个 `expect` 立刻 panic，本条转红。
+    #[test]
+    fn post_commit_state_accounting_failure_degrades_without_stopping() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        let spool = Spool::open(config(dir.path())).expect("spool");
+        {
+            let mut inner = lock(&spool.inner);
+            inner.faults.persist_state_accounting = true;
+        }
+        let ack = spool
+            .append(&event(1), 1)
+            .expect("a successful write barrier must not fail on its accounting read");
+        assert_eq!(ack.spool_sequence, 1);
+        {
+            let inner = lock(&spool.inner);
+            assert!(
+                !inner.durability_uncertain,
+                "a post-commit accounting read must not stop the daemon"
+            );
+            assert!(
+                !inner.spool_bytes_known,
+                "the byte index must be invalidated so the next capacity decision re-measures"
+            );
+            assert!(
+                inner.storage_rejected_attempts > 0,
+                "the accounting failure must still be observable"
+            );
+        }
+        let committed = load_state(&dir.path().join("state.json"))
+            .expect("state read")
+            .expect("committed state");
+        assert_eq!(committed.next_spool_sequence.0, 2, "the durable cursor advanced");
+        let retry = spool
+            .append(&event(2), 2)
+            .expect("service continues after a post-commit accounting fault");
+        assert_eq!(retry.spool_sequence, 2);
+    }
