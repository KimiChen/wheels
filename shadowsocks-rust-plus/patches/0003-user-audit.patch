+/// Entry point used by the root `shadowsocks-auditd` wrapper binary.
+pub fn cli_main() -> std::process::ExitCode {
+    use std::{env, path::PathBuf};
+
+    fn config_path() -> Result<PathBuf, String> {
+        let mut path = None;
+        let mut args = env::args_os();
+        let _ = args.next();
+        while let Some(arg) = args.next() {
+            if arg != "--config" {
+                return Err(format!("unknown argument: {}", arg.to_string_lossy()));
+            }
+            if path.is_some() {
+                return Err("duplicate --config".to_owned());
+            }
+            let value = args.next().ok_or_else(|| "--config requires a path".to_owned())?;
+            let value = value
+                .into_string()
+                .map_err(|_| "--config path must be valid UTF-8".to_owned())?;
+            if value.is_empty() {
+                return Err("--config path must not be empty".to_owned());
+            }
+            path = Some(PathBuf::from(value));
+        }
+        Ok(path.unwrap_or_else(|| PathBuf::from(DEFAULT_CONFIG_PATH)))
+    }
+
+    let path = match config_path() {
+        Ok(value) => value,
+        Err(error) => {
+            eprintln!("shadowsocks-auditd: {error}");
+            return std::process::ExitCode::from(2);
+        }
+    };
+    let config = match AuditdConfig::load_from_file(&path) {
+        Ok(value) => value,
+        Err(error) => {
+            eprintln!("shadowsocks-auditd: invalid configuration: {error}");
+            return std::process::ExitCode::from(78);
+        }
+    };
+    let runtime = match tokio::runtime::Builder::new_current_thread().enable_all().build() {
+        Ok(value) => value,
+        Err(error) => {
+            eprintln!("shadowsocks-auditd: runtime startup failed: {error}");
+            return std::process::ExitCode::from(1);
+        }
+    };
+    match runtime.block_on(async {
+        let daemon = AuditDaemon::new(config)?;
+        daemon.run().await.map_err(ConfigError::Io)
+    }) {
+        Ok(()) => std::process::ExitCode::SUCCESS,
+        Err(error) => {
+            eprintln!("shadowsocks-auditd: {error}");
+            std::process::ExitCode::from(1)
+        }
+    }
+}
diff --git a/crates/shadowsocks-auditd/src/main.rs b/crates/shadowsocks-auditd/src/main.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ecec5f1a71c27e50d6a8741413a8eee4588cfad3
--- /dev/null
+++ b/crates/shadowsocks-auditd/src/main.rs
@@ -0,0 +1,62 @@
+#[cfg(not(target_os = "linux"))]
+compile_error!("shadowsocks-auditd is supported on Linux only");
+
+use std::{env, path::PathBuf, process::ExitCode};
+
+use shadowsocks_auditd::{AuditDaemon, AuditdConfig, DEFAULT_CONFIG_PATH};
+
+fn parse_config_path() -> Result<PathBuf, String> {
+    let mut path = None;
+    let mut args = env::args_os();
+    let _program = args.next();
+    while let Some(arg) = args.next() {
+        if arg == "--config" {
+            if path.is_some() {
+                return Err("duplicate --config".to_owned());
+            }
+            let value = args.next().ok_or_else(|| "--config requires a path".to_owned())?;
+            let value = value
+                .into_string()
+                .map_err(|_| "--config path must be valid UTF-8".to_owned())?;
+            if value.is_empty() {
+                return Err("--config path must not be empty".to_owned());
+            }
+            path = Some(PathBuf::from(value));
+        } else {
+            let value = arg.to_string_lossy();
+            return Err(format!("unknown argument: {value}"));
+        }
+    }
+    Ok(path.unwrap_or_else(|| PathBuf::from(DEFAULT_CONFIG_PATH)))
+}
+
+#[tokio::main(flavor = "current_thread")]
+async fn main() -> ExitCode {
+    let path = match parse_config_path() {
+        Ok(path) => path,
+        Err(error) => {
+            eprintln!("shadowsocks-auditd: {error}");
+            return ExitCode::from(2);
+        }
+    };
+    let config = match AuditdConfig::load_from_file(&path) {
+        Ok(config) => config,
+        Err(error) => {
+            eprintln!("shadowsocks-auditd: invalid configuration: {error}");
+            return ExitCode::from(78);
+        }
+    };
+    match AuditDaemon::new(config) {
+        Ok(daemon) => match daemon.run().await {
+            Ok(()) => ExitCode::SUCCESS,
+            Err(error) => {
+                eprintln!("shadowsocks-auditd: {error}");
+                ExitCode::from(1)
+            }
+        },
+        Err(error) => {
+            eprintln!("shadowsocks-auditd: startup failed: {error}");
+            ExitCode::from(78)
+        }
+    }
+}
diff --git a/crates/shadowsocks-auditd/src/protocol.rs b/crates/shadowsocks-auditd/src/protocol.rs
new file mode 100644
index 0000000000000000000000000000000000000000..49aa2a4af252a5bf3bc8997bbd5240cfb3be42ee
--- /dev/null
+++ b/crates/shadowsocks-auditd/src/protocol.rs
@@ -0,0 +1,151 @@
+//! Adapter around the shared, strict audit wire protocol.
+//!
+//! The daemon must not maintain a second interpretation of event JSON.  This
+//! module only adds the small amount of routing metadata needed by ingest and
+//! translates the shared error into the daemon's error type.
+
+use serde::Serialize;
+use serde_json::Value;
+use thiserror::Error;
+
+use shadowsocks_audit_protocol as wire;
+
+use crate::config::{MAX_EVENT_BYTES, MAX_FRAME_BYTES};
+
+#[allow(unused_imports)]
+pub use wire::{
+    AccessEvent, AuditRecord, DecimalU64, EventAck as WireEventAck, EventNack, EventNackCode, FrameType, Hello,
+    HelloAck, HelloErrorCode, HelloNack, ProducerGap, SpoolGap, UdpWindowContention,
+};
+
+#[derive(Debug, Error)]
+pub enum ProtocolError {
+    #[error("shared protocol error: {0}")]
+    Shared(#[from] wire::ProtocolError),
+    #[error("invalid protocol value: {0}")]
+    Invalid(String),
+}
+
+#[derive(Debug, Clone, Copy, Eq, PartialEq)]
+pub enum EventKind {
+    AccessTcp,
+    AccessUdp,
+    ProducerGap,
+    UdpContention,
+}
+
+#[derive(Debug, Clone)]
+pub struct EventInfo {
+    // These fields are retained for callers that need to classify diagnostics;
+    // ingest currently only needs the identity fields for routing and dedup.
+    #[allow(dead_code)]
+    pub kind: EventKind,
+    pub event_id: String,
+    pub node_id: String,
+    pub runtime_id: String,
+    #[allow(dead_code)]
+    pub audit_sequence: Option<u64>,
+}
+
+/// Parse and validate one producer event.  `spool_gap` is intentionally not
+/// accepted from producers; it is generated only by auditd.
+pub fn parse_event(raw: &[u8]) -> Result<EventInfo, ProtocolError> {
+    if raw.is_empty() || raw.len() > MAX_EVENT_BYTES {
+        return Err(ProtocolError::Invalid(
+            "event payload length is outside 1..=8192".to_owned(),
+        ));
+    }
+    if raw.iter().any(|byte| matches!(byte, b'\r' | b'\n')) {
+        return Err(ProtocolError::Invalid(
+            "event payload must not contain CR or LF".to_owned(),
+        ));
+    }
+    let record = wire::parse_canonical_record(raw)?;
+    let (kind, event_id, node_id, runtime_id, sequence) = match record {
+        wire::AuditRecord::Access(value) => {
+            let kind = match value.transport {
+                wire::Transport::Tcp => EventKind::AccessTcp,
+                wire::Transport::Udp => EventKind::AccessUdp,
+            };
+            (
+                kind,
+                value.event_id,
+                value.node_id,
+                value.runtime_id,
+                value.audit_sequence.get(),
+            )
+        }
+        wire::AuditRecord::ProducerGap(value) => (
+            EventKind::ProducerGap,
+            value.event_id,
+            value.node_id,
+            value.runtime_id,
+            value.audit_sequence.get(),
+        ),
+        wire::AuditRecord::UdpWindowContention(value) => (
+            EventKind::UdpContention,
+            value.event_id,
+            value.node_id,
+            value.runtime_id,
+            value.audit_sequence.get(),
+        ),
+        wire::AuditRecord::SpoolGap(_) => {
+            return Err(ProtocolError::Invalid(
+                "spool_gap is not accepted from producers".to_owned(),
+            ));
+        }
+    };
+    Ok(EventInfo {
+        kind,
+        event_id,
+        node_id,
+        runtime_id,
+        audit_sequence: Some(sequence),
+    })
+}
+
+/// Strictly parse one JSON value (duplicate keys and trailing data rejected).
+#[allow(dead_code)]
+pub fn parse_strict_json(raw: &[u8]) -> Result<Value, ProtocolError> {
+    Ok(wire::parse_json_exact(raw)?)
+}
+
+#[allow(dead_code)]
+pub fn compact_json<T: Serialize>(value: &T) -> Result<Vec<u8>, ProtocolError> {
+    Ok(wire::serialize_canonical(value)?)
+}
+
+#[allow(dead_code)]
+pub fn encode_frame(payload: &[u8]) -> Result<Vec<u8>, ProtocolError> {
+    if payload.is_empty() || payload.len() > MAX_FRAME_BYTES {
+        return Err(ProtocolError::Invalid(
+            "frame payload length is outside 1..=8192".to_owned(),
+        ));
+    }
+    Ok(wire::encode_frame(payload)?)
+}
+
+#[allow(dead_code)]
+pub fn decode_frame(input: &[u8]) -> Result<&[u8], ProtocolError> {
+    Ok(wire::decode_frame(input)?)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const EVENT: &[u8] = br#"{"schema_version":1,"record_type":"access","event_type":"tcp_target_success","event_id":"0123456789abcdef0123456789abcdef:1","audit_sequence":"1","occurred_at_unix_ms":"1","runtime_monotonic_ms":"1","node_id":"node-test","runtime_id":"0123456789abcdef0123456789abcdef","server_id":"server","server_generation":1,"identity_kind":"user","identity_name":"user","identity_generation":1,"transport":"tcp","target":{"kind":"ip","host":"192.0.2.1","normalized_host":"192.0.2.1","port":443,"remote_ip":"192.0.2.1"},"success_evidence":"tcp_bidirectional_payload"}"#;
+
+    #[test]
+    fn shared_parser_is_used_for_events() {
+        let info = parse_event(EVENT).expect("valid event");
+        assert_eq!(info.kind, EventKind::AccessTcp);
+        assert_eq!(info.audit_sequence, Some(1));
+    }
+
+    #[test]
+    fn framing_is_bounded() {
+        assert!(encode_frame(&[]).is_err());
+        assert!(encode_frame(&vec![0; MAX_FRAME_BYTES + 1]).is_err());
+    }
+}
diff --git a/crates/shadowsocks-auditd/src/spool.rs b/crates/shadowsocks-auditd/src/spool.rs
new file mode 100644
index 0000000000000000000000000000000000000000..4a6e00cdceed1ca1367cfb517382b23995d7884b
--- /dev/null
+++ b/crates/shadowsocks-auditd/src/spool.rs
@@ -0,0 +1,2999 @@
+//! Durable, node-local audit spool.
+//!
+//! The spool is deliberately synchronous.  Ingest and export perform their
+//! small file operations behind this mutex, which gives the durability barrier
+//! a single ordering and keeps ACK/lease state deterministic.
+
+use std::{
+    collections::{HashMap, HashSet, VecDeque},
+    ffi::CString,
+    fs::{self, File, OpenOptions},
+    io::{self, Read, Write},
+    os::{
+        fd::{AsRawFd, FromRawFd, OwnedFd},
+        unix::{
+            ffi::OsStrExt,
+            fs::{OpenOptionsExt, PermissionsExt},
+        },
+    },
+    path::{Path, PathBuf},
+    sync::{Arc, Mutex, MutexGuard},
+    time::{Duration, Instant, SystemTime, UNIX_EPOCH},
+};
+
+use serde::Serialize;
+use sha2::{Digest, Sha256};
+use shadowsocks_audit_protocol as wire;
+use thiserror::Error;
+
+use crate::{
+    config::{ACKED_RETENTION_SECONDS, AuditdConfig, DEFAULT_EXPORT_MAX_RESPONSE_BYTES, MAX_TOMBSTONES},
+    protocol::{self, ProtocolError},
+};
+
+const STATE_SCHEMA_VERSION: u8 = 1;
+const TOMBSTONE_RETENTION_SECONDS: u64 = 7 * 86_400;
+const GAP_ID_PREFIX: &str = "spool:";
+const PRODUCER_DISCONNECT_GRACE: Duration = Duration::from_secs(5);
+// A segment is configured at most 4 MiB and the export contract permits up to
+// 8 MiB for a legacy segment that was written before the current limits were
+// applied.  Never let recovery turn an attacker-controlled regular file into
+// an unbounded allocation.  Files larger than this are treated as corrupt and
+// quarantined by the caller.
+const MAX_SPOOL_FILE_BYTES: usize = DEFAULT_EXPORT_MAX_RESPONSE_BYTES as usize;
+
+#[derive(Debug, Error)]
+pub enum SpoolError {
+    #[error("spool I/O failed: {0}")]
+    Io(#[from] io::Error),
+    #[error("spool JSON failed: {0}")]
+    Json(#[from] serde_json::Error),
+    #[error("spool protocol error: {0}")]
+    Protocol(#[from] ProtocolError),
+    #[error("spool is temporarily unavailable")]
+    StorageUnavailable,
+    #[error("spool sequence exhausted")]
+    SequenceExhausted,
+    #[error("batch body digest mismatch")]
+    DigestMismatch,
+    #[error("unknown batch")]
+    UnknownBatch,
+    #[error("batch was evicted")]
+    BatchEvicted,
+    #[error("invalid spool state: {0}")]
+    InvalidState(String),
+}
+
+type PendingStateReset = wire::StateReset;
+type TombstoneEntry = wire::TombstoneEntry;
+
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub struct EventAck {
+    pub event_id: String,
+    pub spool_epoch: String,
+    pub spool_sequence: u64,
+}
+
+#[derive(Debug, Clone)]
+pub struct BatchInfo {
+    pub node_id: String,
+    pub spool_epoch: String,
+    pub batch_id: String,
+    pub first_spool_sequence: u64,
+    pub last_spool_sequence: u64,
+    pub event_count: u64,
+    pub raw_bytes: u64,
+    pub body_sha256: String,
+    pub first_received_at_unix_ms: u64,
+    pub last_received_at_unix_ms: u64,
+    pub path: PathBuf,
+}
+
+#[derive(Debug, Clone)]
+pub struct BatchLease {
+    pub info: BatchInfo,
+    pub body: Vec<u8>,
+}
+
+#[derive(Debug, Clone, Copy, Eq, PartialEq)]
+pub enum AckOutcome {
+    Acked,
+    Unknown,
+    Evicted,
+    DigestMismatch,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct HealthSnapshot {
+    pub schema_version: u32,
+    pub node_id: String,
+    pub status: String,
+    pub producer_connected: bool,
+    pub producer_runtime_id: Option<String>,
+    pub last_ingest_at_unix_ms: Option<u64>,
+    pub spool_epoch: String,
+    pub spool_bytes: u64,
+    pub max_spool_bytes: u64,
+    pub sealed_batches: u64,
+    pub oldest_unacked_at_unix_ms: Option<u64>,
+    pub stored_records: u64,
+    pub storage_rejected_attempts: u64,
+    pub evicted_unacked_records: u64,
+}
+
+#[derive(Debug)]
+struct OpenMetadata {
+    bytes: u64,
+    first_sequence: Option<u64>,
+    last_sequence: Option<u64>,
+    event_count: u64,
+    first_received_at: Option<u64>,
+    last_received_at: Option<u64>,
+    opened_at: SystemTime,
+}
+
+impl OpenMetadata {
+    fn empty() -> Self {
+        Self {
+            bytes: 0,
+            first_sequence: None,
+            last_sequence: None,
+            event_count: 0,
+            first_received_at: None,
+            last_received_at: None,
+            opened_at: SystemTime::now(),
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+struct GapSpec {
+    event_id: String,
+    occurred_at_unix_ms: u64,
+    lost_spool_epoch: Option<String>,
+    reason: wire::SpoolGapReason,
+    first_lost_spool_sequence: Option<u64>,
+    last_lost_spool_sequence: Option<u64>,
+    lost_events: Option<u64>,
+    lost_bytes: Option<u64>,
+    lost_batch_id: Option<String>,
+}
+
+fn corruption_gap_spec(hint: Option<&BatchInfo>) -> Result<GapSpec, SpoolError> {
+    Ok(GapSpec {
+        event_id: format!("{}{}", GAP_ID_PREFIX, random_hex_id()?),
+        occurred_at_unix_ms: unix_millis()?,
+        lost_spool_epoch: hint.map(|value| value.spool_epoch.clone()),
+        reason: wire::SpoolGapReason::SegmentCorruption,
+        first_lost_spool_sequence: hint.map(|value| value.first_spool_sequence),
+        last_lost_spool_sequence: hint.map(|value| value.last_spool_sequence),
+        lost_events: hint.map(|value| value.event_count),
+        lost_bytes: hint.map(|value| value.raw_bytes),
+        lost_batch_id: hint.map(|value| value.batch_id.clone()),
+    })
+}
+
+#[derive(Debug)]
+struct RecoveryResult {
+    epoch: String,
+    next_sequence: u64,
+    degraded: bool,
+    gap_degraded: bool,
+    open_meta: OpenMetadata,
+    pending_state_reset: Option<PendingStateReset>,
+    recovery_gaps: VecDeque<GapSpec>,
+}
+
+#[derive(Debug)]
+struct SpoolInner {
+    epoch: String,
+    next_sequence: u64,
+    open_file: File,
+    open_meta: OpenMetadata,
+    leased_batch: Option<String>,
+    degraded: bool,
+    // `degraded` records the current health state; this flag identifies the
+    // recoverable portion caused by an unacknowledged spool gap.  It lets a
+    // successful ACK restore `ok` without erasing unrelated counters.
+    gap_degraded: bool,
+    producer_connected: bool,
+    producer_disconnected_at: Option<Instant>,
+    producer_runtime_id: Option<String>,
+    last_ingest_at_unix_ms: Option<u64>,
+    storage_rejected_attempts: u64,
+    evicted_unacked_records: u64,
+    pending_state_reset: Option<PendingStateReset>,
+    recovery_gaps: VecDeque<GapSpec>,
+    tombstones: Vec<TombstoneEntry>,
+}
+
+pub struct Spool {
+    config: Arc<AuditdConfig>,
+    root: PathBuf,
+    inner: Mutex<SpoolInner>,
+}
+
+impl Spool {
+    pub fn open(config: Arc<AuditdConfig>) -> Result<Self, SpoolError> {
+        let root = config.spool_dir.clone();
+        ensure_dir(&root, 0o700)?;
+        for name in ["open", "sealed", "acked", "quarantine"] {
+            ensure_dir(&root.join(name), 0o700)?;
+        }
+
+        let recovery = recover_layout(&root, &config.node_id)?;
+        let open_path = root.join("open/current.ndjson");
+        if recovery.pending_state_reset.is_some()
+            && fs::symlink_metadata(&open_path)
+                .map(|metadata| metadata.file_type().is_symlink() || (metadata.is_file() && metadata.len() > 0))
+                .unwrap_or(false)
+        {
+            // `recover_layout` normally moves the old open inode away when a
+            // new epoch is required.  Refuse to append after a failed move:
+            // doing so would place the new state-reset gap behind untrusted
+            // bytes.  A retryable startup error is safer than silently
+            // exporting a mixed-epoch segment.
+            quarantine_path(&root, &open_path, "state-reset")?;
+        }
+        let open_file = OpenOptions::new()
+            .create(true)
+            .read(true)
+            .append(true)
+            .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+            .mode(0o600)
+            .open(&open_path)?;
+        set_file_mode(&open_path, 0o600)?;
+
+        let mut degraded = recovery.degraded;
+        let tombstones = match load_tombstones(&root) {
+            Ok(value) => value,
+            Err(_) => {
+                degraded = true;
+                let _ = quarantine_path(&root, &root.join("tombstones.json"), "tombstones-corrupt");
+                Vec::new()
+            }
+        };
+        let spool = Self {
+            config,
+            root,
+            inner: Mutex::new(SpoolInner {
+                epoch: recovery.epoch,
+                next_sequence: recovery.next_sequence,
+                open_file,
+                open_meta: recovery.open_meta,
+                leased_batch: None,
+                degraded,
+                gap_degraded: recovery.gap_degraded,
+                producer_connected: false,
+                producer_disconnected_at: None,
+                producer_runtime_id: None,
+                last_ingest_at_unix_ms: None,
+                storage_rejected_attempts: 0,
+                evicted_unacked_records: 0,
+                pending_state_reset: recovery.pending_state_reset,
+                recovery_gaps: recovery.recovery_gaps,
+                tombstones,
+            }),
+        };
+
+        // Complete any transaction that was durable before a previous crash.
+        // A failure leaves the pending entry in place; the next open can retry
+        // it without inventing a second gap ID.
+        {
+            let mut inner = lock(&spool.inner);
+            // A pending state reset owns the first sequence in its new epoch,
+            // so materialize it before eviction/recovery diagnostics.
+            // Do not let another gap consume a sequence when this barrier is
+            // still pending.  In particular, a failed state.json sync after
+            // the reset record was written must leave that record as the
+            // first writable record on the next retry.
+            let reset_ready = match spool.flush_state_reset_locked(&mut inner) {
+                Ok(()) => true,
+                Err(_) => {
+                    inner.degraded = true;
+                    false
+                }
+            };
+            if reset_ready {
+                if spool.reconcile_tombstones_locked(&mut inner).is_err() {
+                    inner.degraded = true;
+                }
+                // A crash may have completed sealed -> acked and both
+                // directory fsyncs, but stopped before the receipt ledger
+                // barrier.  Rebuild receipts while the acked directory still
+                // exists so a later cleanup cannot erase the ACK proof.
+                if spool.rebuild_acked_receipts_locked(&mut inner).is_err() {
+                    inner.degraded = true;
+                }
+                if spool.flush_recovery_gaps_locked(&mut inner).is_err() {
+                    inner.degraded = true;
+                }
+            }
+        }
+        Ok(spool)
+    }
+
+    pub fn root(&self) -> &Path {
+        &self.root
+    }
+
+    pub fn set_producer_state(&self, connected: bool, runtime_id: Option<String>, at_unix_ms: Option<u64>) {
+        let mut inner = lock(&self.inner);
+        if connected {
+            inner.producer_disconnected_at = None;
+        } else if inner.producer_connected && inner.producer_disconnected_at.is_none() {
+            inner.producer_disconnected_at = Some(Instant::now());
+        }
+        inner.producer_connected = connected;
+        inner.producer_runtime_id = runtime_id;
+        if connected {
+            // Replace the timestamp with the latest valid observation.  A
+            // missing value is intentional (clock unavailable or only a
+            // hello was received) and must not inherit another runtime's
+            // wall-clock value.
+            inner.last_ingest_at_unix_ms = at_unix_ms;
+        } else {
+            // A disconnected producer has no current runtime or last-ingest
+            // timestamp in the health contract.  Do not retain the previous
+            // runtime's timestamp after a disconnect notification.
+            inner.last_ingest_at_unix_ms = None;
+        }
+    }
+
+    /// Append one already-canonical producer event and return its durable
+    /// spool position.  No sequence is consumed when the capacity barrier
+    /// cannot be completed.
+    pub fn append(&self, event_raw: &[u8], received_at_unix_ms: u64) -> Result<EventAck, SpoolError> {
+        let info = protocol::parse_event(event_raw)?;
+        let mut inner = lock(&self.inner);
+
+        if let Err(error) = self.flush_state_reset_locked(&mut inner) {
+            inner.degraded = true;
+            if matches!(&error, SpoolError::StorageUnavailable) {
+                inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            }
+            return Err(error);
+        }
+        if let Err(error) = self.reconcile_tombstones_locked(&mut inner) {
+            inner.degraded = true;
+            if matches!(&error, SpoolError::StorageUnavailable) {
+                inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            }
+            return Err(error);
+        }
+        if let Err(error) = self.flush_recovery_gaps_locked(&mut inner) {
+            inner.degraded = true;
+            if matches!(&error, SpoolError::StorageUnavailable) {
+                inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            }
+            return Err(error);
+        }
+
+        // Capacity cleanup can itself emit durable `spool_gap` records (for
+        // example while evicting an unacked batch or quarantine entry).  Such
+        // records consume sequence numbers, so construct the producer wrapper
+        // only after the cleanup barrier has settled, and rebuild it whenever
+        // the cursor moved underneath us.
+        let (sequence, wrapper) = loop {
+            let sequence = inner.next_sequence;
+            if sequence == u64::MAX {
+                inner.degraded = true;
+                return Err(SpoolError::SequenceExhausted);
+            }
+            let wrapper = wrapper_bytes(&inner.epoch, sequence, received_at_unix_ms, event_raw)?;
+            let wrapper_len = wrapper.len() as u64;
+            if wrapper_len > self.config.segment_max_bytes {
+                inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                inner.degraded = true;
+                return Err(SpoolError::StorageUnavailable);
+            }
+            if inner.open_meta.bytes > 0
+                && inner.open_meta.bytes.saturating_add(wrapper_len) > self.config.segment_max_bytes
+            {
+                if let Err(error) = self.seal_locked(&mut inner) {
+                    inner.degraded = true;
+                    return Err(error);
+                }
+                continue;
+            }
+            if let Err(error) = self.ensure_capacity_locked(&mut inner, wrapper_len) {
+                inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                inner.degraded = true;
+                return Err(error);
+            }
+            // Eviction/quarantine recovery may have written one or more gap
+            // records while checking capacity.  Never write the producer event
+            // with the stale sequence captured before that work.
+            if inner.next_sequence != sequence {
+                continue;
+            }
+            break (sequence, wrapper);
+        };
+        if let Err(error) = self.write_record_locked(&mut inner, &wrapper, sequence, received_at_unix_ms) {
+            // A record is acknowledged only after both the open-file sync and
+            // state cursor persistence.  Surface any barrier failure as a
+            // degraded storage condition and keep the producer-side retry
+            // contract intact.
+            inner.degraded = true;
+            if matches!(&error, SpoolError::Io(_) | SpoolError::StorageUnavailable) {
+                inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            }
+            return Err(error);
+        }
+        if (inner.open_meta.bytes >= self.config.segment_max_bytes
+            || inner.open_meta.opened_at.elapsed().unwrap_or_default()
+                >= Duration::from_secs(self.config.segment_max_age_seconds))
+            && let Err(error) = self.seal_locked(&mut inner)
+        {
+            // The record and its next-sequence cursor were already durable
+            // before this best-effort seal.  Returning the error would make
+            // the producer retry and append the same event a second time.
+            // Keep the durable ACK contract, mark health degraded, and let
+            // the next lease/append retry sealing.
+            inner.degraded = true;
+            let _ = error;
+        }
+        Ok(EventAck {
+            event_id: info.event_id,
+            spool_epoch: inner.epoch.clone(),
+            spool_sequence: sequence,
+        })
+    }
+
+    /// Return the oldest sealed batch.  A non-empty open segment is sealed at
+    /// lease time so a quiet producer does not strand durable records forever.
+    pub fn lease(&self) -> Result<Option<BatchLease>, SpoolError> {
+        let mut inner = lock(&self.inner);
+        if let Err(error) = self.flush_state_reset_locked(&mut inner) {
+            inner.degraded = true;
+            return Err(error);
+        }
+        if let Err(error) = self.reconcile_tombstones_locked(&mut inner) {
+            inner.degraded = true;
+            return Err(error);
+        }
+        if let Err(error) = self.flush_recovery_gaps_locked(&mut inner) {
+            inner.degraded = true;
+            return Err(error);
+        }
+        if inner.open_meta.event_count > 0 {
+            if let Err(error) = self.seal_locked(&mut inner) {
+                inner.degraded = true;
+                return Err(error);
+            }
+        }
+        if let Some(batch_id) = inner.leased_batch.clone() {
+            if let Some((path, _)) = self.find_batch_with_digest(&self.root.join("sealed"), &batch_id)? {
+                match self.read_batch(&path, false) {
+                    Ok(Some(lease)) => return Ok(Some(lease)),
+                    Ok(None) | Err(_) => {
+                        // A leased batch may have been damaged between two
+                        // lease calls.  Isolate it before looking for another
+                        // batch; silently skipping it would hide a spool gap.
+                        inner.degraded = true;
+                        self.quarantine_batch_locked(&mut inner, &path, "batch-corrupt")?;
+                    }
+                }
+            }
+            inner.leased_batch = None;
+        }
+
+        // Directory names start with a random epoch, so lexical path order is
+        // not a valid "oldest" order (and decimal sequence strings do not sort
+        // numerically either).  Read the trusted metadata first and sort by
+        // receive time, sequence, epoch, then batch ID for deterministic FIFO
+        // leasing across epochs.
+        let mut candidates = Vec::new();
+        for path in list_batch_dirs(&self.root.join("sealed"))? {
+            let Some(info) = self.read_meta(&path)? else {
+                inner.degraded = true;
+                self.quarantine_batch_locked(&mut inner, &path, "batch-corrupt")?;
+                continue;
+            };
+            candidates.push((path, info));
+        }
+        candidates.sort_by(|(_, left), (_, right)| {
+            (
+                left.first_received_at_unix_ms,
+                left.first_spool_sequence,
+                &left.spool_epoch,
+                &left.batch_id,
+            )
+                .cmp(&(
+                    right.first_received_at_unix_ms,
+                    right.first_spool_sequence,
+                    &right.spool_epoch,
+                    &right.batch_id,
+                ))
+        });
+        for (path, _) in candidates {
+            match self.read_batch(&path, false) {
+                Ok(Some(lease)) => {
+                    inner.leased_batch = Some(lease.info.batch_id.clone());
+                    return Ok(Some(lease));
+                }
+                Ok(None) | Err(_) => {
+                    inner.degraded = true;
+                    self.quarantine_batch_locked(&mut inner, &path, "batch-corrupt")?;
+                }
+            }
+        }
+        Ok(None)
+    }
+
+    /// Isolate a leased batch that cannot be represented by the export
+    /// response limit.  The lease is cleared only when it still refers to the
+    /// supplied batch, so a late response from an older request cannot release
+    /// a newer lease.  Quarantining rather than merely clearing the marker is
+    /// important: otherwise every subsequent lease call would select the same
+    /// poison batch again.
+    pub fn quarantine_oversized_lease(&self, batch_id: &str, max_bytes: u64) -> Result<bool, SpoolError> {
+        let mut inner = lock(&self.inner);
+        if inner.leased_batch.as_deref() != Some(batch_id) {
+            return Ok(false);
+        }
+        let Some((path, _)) = self.find_batch_with_digest(&self.root.join("sealed"), batch_id)? else {
+            inner.leased_batch = None;
+            return Ok(false);
+        };
+        let oversized = match self.read_batch(&path, false) {
+            Ok(Some(lease)) => lease.body.len() as u64 > max_bytes,
+            Ok(None) => true,
+            Err(error) => {
+                // Clear the in-memory marker even when the quarantine barrier
+                // itself fails.  Leaving it set would make a transient disk
+                // error pin this batch forever; a later lease can retry the
+                // recovery path after the daemon reports degraded health.
+                inner.leased_batch = None;
+                inner.degraded = true;
+                return Err(error);
+            }
+        };
+        if !oversized {
+            return Ok(false);
+        }
+        inner.degraded = true;
+        let quarantine_result = self.quarantine_batch_locked(&mut inner, &path, "batch-too-large");
+        inner.leased_batch = None;
+        quarantine_result.map(|()| true)
+    }
+
+    /// ACK a batch by ID and body digest.  Both the first ACK and retries are
+    /// backed by a durable receipt; an acked directory can rebuild a receipt
+    /// after a crash between the rename and ledger write.
+    pub fn ack(&self, batch_id: &str, body_sha256: &str) -> Result<AckOutcome, SpoolError> {
+        if !is_hex(batch_id, 32) || !is_hex(body_sha256, 64) {
+            return Ok(AckOutcome::Unknown);
+        }
+        let mut inner = lock(&self.inner);
+        if let Err(error) = self.flush_state_reset_locked(&mut inner) {
+            inner.degraded = true;
+            return Err(error);
+        }
+        if let Err(error) = self.reconcile_tombstones_locked(&mut inner) {
+            inner.degraded = true;
+            return Err(error);
+        }
+        if let Err(error) = self.flush_recovery_gaps_locked(&mut inner) {
+            inner.degraded = true;
+            return Err(error);
+        }
+        if let Err(error) = self.prune_receipts_locked(&mut inner) {
+            inner.degraded = true;
+            return Err(error);
+        }
+
+        if let Some(entry) = inner.tombstones.iter().find(|entry| entry.batch_id() == Some(batch_id)) {
+            match entry {
+                TombstoneEntry::AckedReceipt(value) => {
+                    let outcome = if value.body_sha256 == body_sha256 {
+                        AckOutcome::Acked
+                    } else {
+                        AckOutcome::DigestMismatch
+                    };
+                    if outcome == AckOutcome::Acked {
+                        self.refresh_degraded_after_ack_locked(&mut inner);
+                    }
+                    return Ok(outcome);
+                }
+                TombstoneEntry::EvictedReceipt(value) => {
+                    return Ok(if value.body_sha256 == body_sha256 {
+                        AckOutcome::Evicted
+                    } else {
+                        AckOutcome::DigestMismatch
+                    });
+                }
+                TombstoneEntry::EvictionPending(_) | TombstoneEntry::QuarantinePending(_) => {
+                    return Ok(AckOutcome::Unknown);
+                }
+            }
+        }
+
+        if let Some((path, info)) = self.find_batch_with_digest(&self.root.join("acked"), batch_id)? {
+            if info.body_sha256 != body_sha256 {
+                return Ok(AckOutcome::DigestMismatch);
+            }
+            // Never acknowledge a directory based only on its metadata.  The
+            // body digest and every wrapped line must still validate, because
+            // a tampered/corrupt acked batch cannot be used to reconstruct a
+            // trustworthy receipt.
+            if self.read_batch(&path, true)?.is_none() {
+                inner.degraded = true;
+                return Err(SpoolError::StorageUnavailable);
+            }
+            let receipt = TombstoneEntry::AckedReceipt(wire::AckedReceipt::new(
+                info.batch_id.clone(),
+                info.body_sha256.clone(),
+                unix_millis()?,
+            ));
+            self.add_receipt_locked(&mut inner, receipt)?;
+            let _ = path;
+            self.refresh_degraded_after_ack_locked(&mut inner);
+            return Ok(AckOutcome::Acked);
+        }
+
+        let Some((path, info)) = self.find_batch_with_digest(&self.root.join("sealed"), batch_id)? else {
+            if inner
+                .tombstones
+                .iter()
+                .any(|entry| matches!(entry, TombstoneEntry::EvictedReceipt(value) if value.batch_id == batch_id))
+            {
+                return Ok(AckOutcome::Evicted);
+            }
+            return Ok(AckOutcome::Unknown);
+        };
+        if info.body_sha256 != body_sha256 {
+            return Ok(AckOutcome::DigestMismatch);
+        }
+        if self.read_batch(&path, false)?.is_none() {
+            inner.degraded = true;
+            return Err(SpoolError::StorageUnavailable);
+        }
+        let name = path
+            .file_name()
+            .and_then(|value| value.to_str())
+            .ok_or_else(|| SpoolError::InvalidState("invalid batch directory name".to_owned()))?;
+        let target = self.root.join("acked").join(format!("{}-{}", unix_seconds()?, name));
+        if let Err(error) = fs::rename(&path, &target) {
+            inner.degraded = true;
+            return Err(error.into());
+        }
+        if let Err(error) = sync_dir(&self.root.join("sealed")) {
+            inner.degraded = true;
+            return Err(error.into());
+        }
+        if let Err(error) = sync_dir(&self.root.join("acked")) {
+            inner.degraded = true;
+            return Err(error.into());
+        }
+
+        // The receipt is the recovery proof that allows a later capacity
+        // cleanup to remove this acked directory.  Persist it only after the
+        // cross-directory move and both directory fsync barriers.  If this
+        // write fails, the moved batch remains available for a retry and the
+        // next ACK/recovery pass rebuilds the receipt from its metadata.
+        let receipt = TombstoneEntry::AckedReceipt(wire::AckedReceipt::new(
+            info.batch_id.clone(),
+            info.body_sha256.clone(),
+            unix_millis()?,
+        ));
+        if let Err(error) = self.add_receipt_locked(&mut inner, receipt) {
+            inner.degraded = true;
+            return Err(error);
+        }
+        if inner.leased_batch.as_deref() == Some(batch_id) {
+            inner.leased_batch = None;
+        }
+        self.refresh_degraded_after_ack_locked(&mut inner);
+        Ok(AckOutcome::Acked)
+    }
+
+    /// Clear the recoverable degraded marker once every unacknowledged
+    /// `spool_gap` has been acknowledged.  Historical counters remain intact;
+    /// malformed batches, pending transactions, and unreadable files keep the
+    /// daemon degraded conservatively.
+    fn refresh_degraded_after_ack_locked(&self, inner: &mut SpoolInner) {
+        if !inner.gap_degraded || inner.pending_state_reset.is_some() || !inner.recovery_gaps.is_empty() {
+            return;
+        }
+        if self.has_unacked_spool_gap_locked() {
+            return;
+        }
+        inner.gap_degraded = false;
+        inner.degraded = false;
+    }
+
+    fn has_unacked_spool_gap_locked(&self) -> bool {
+        let open_path = self.root.join("open/current.ndjson");
+        match read_regular_file(&open_path) {
+            Ok(body) if body_contains_spool_gap(&body) => return true,
+            Ok(_) => {}
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+            Err(_) => return true,
+        }
+        let Ok(paths) = list_batch_dirs(&self.root.join("sealed")) else {
+            return true;
+        };
+        for path in paths {
+            match self.read_batch(&path, false) {
+                Ok(Some(lease)) if body_contains_spool_gap(&lease.body) => return true,
+                Ok(Some(_)) => {}
+                Ok(None) | Err(_) => return true,
+            }
+        }
+        false
+    }
+
+    pub fn health(&self) -> HealthSnapshot {
+        let mut inner = lock(&self.inner);
+        let spool_bytes = directory_size(&self.root).unwrap_or(u64::MAX);
+        let sealed = list_batch_dirs(&self.root.join("sealed")).unwrap_or_default();
+        let mut oldest = None;
+        let mut valid_count = 0_u64;
+        for path in &sealed {
+            match self.read_batch(path, false) {
+                Ok(Some(info)) => {
+                    valid_count = valid_count.saturating_add(1);
+                    oldest = Some(oldest.map_or(info.info.first_received_at_unix_ms, |value: u64| {
+                        value.min(info.info.first_received_at_unix_ms)
+                    }));
+                }
+                Ok(None) | Err(_) => {
+                    // Health is also the runtime corruption signal.  Do not
+                    // report `ok` merely because a malformed batch was
+                    // skipped during enumeration.
+                    inner.degraded = true;
+                }
+            }
+        }
+        let status = if inner.degraded
+            || spool_bytes >= self.config.max_spool_bytes
+            || !free_space_ok(&self.root, self.config.min_free_bytes)
+            || inner
+                .producer_disconnected_at
+                .is_some_and(|at| at.elapsed() >= PRODUCER_DISCONNECT_GRACE)
+        {
+            "degraded"
+        } else {
+            "ok"
+        };
+        HealthSnapshot {
+            schema_version: 1,
+            node_id: self.config.node_id.clone(),
+            status: status.to_owned(),
+            producer_connected: inner.producer_connected,
+            producer_runtime_id: inner.producer_runtime_id.clone(),
+            last_ingest_at_unix_ms: inner.last_ingest_at_unix_ms,
+            spool_epoch: inner.epoch.clone(),
+            spool_bytes,
+            max_spool_bytes: self.config.max_spool_bytes,
+            sealed_batches: valid_count,
+            oldest_unacked_at_unix_ms: oldest,
+            stored_records: inner.next_sequence.saturating_sub(1),
+            storage_rejected_attempts: inner.storage_rejected_attempts,
+            evicted_unacked_records: inner.evicted_unacked_records,
+        }
+    }
+
+    fn find_batch_with_digest(&self, root: &Path, batch_id: &str) -> Result<Option<(PathBuf, BatchInfo)>, SpoolError> {
+        for path in list_batch_dirs(root)? {
+            let Some(info) = self.read_meta(&path)? else { continue };
+            if info.batch_id == batch_id {
+                return Ok(Some((path, info)));
+            }
+        }
+        Ok(None)
+    }
+
+    /// Find a sealed object associated with a pending eviction even when its
+    /// metadata no longer parses.  Batch directory names end in the random
+    /// batch ID, so this bounded fallback lets recovery quarantine a corrupt
+    /// object instead of leaving it indefinitely in the export set.
+    fn find_batch_path_by_id(&self, root: &Path, batch_id: &str) -> Result<Option<PathBuf>, SpoolError> {
+        let suffix = format!("-{batch_id}");
+        for path in list_batch_dirs(root)? {
+            let name_matches = path
+                .file_name()
+                .and_then(|value| value.to_str())
+                .is_some_and(|name| name.ends_with(&suffix));
+            let metadata_matches = !name_matches
+                && read_meta_hint(&path, &self.config.node_id).is_some_and(|info| info.batch_id == batch_id);
+            if name_matches || metadata_matches {
+                return Ok(Some(path));
+            }
+        }
+        Ok(None)
+    }
+
+    fn read_batch(&self, path: &Path, _acked: bool) -> Result<Option<BatchLease>, SpoolError> {
+        let Some(info) = self.read_meta(path)? else {
+            return Ok(None);
+        };
+        let body = read_regular_file(&path.join("segment.ndjson"))?;
+        if body.len() as u64 != info.raw_bytes || digest_hex(&body) != info.body_sha256 || !body.ends_with(b"\n") {
+            return Ok(None);
+        }
+        validate_segment_body(&body, &info, &self.config.node_id)?;
+        Ok(Some(BatchLease { info, body }))
+    }
+
+    fn read_meta(&self, path: &Path) -> Result<Option<BatchInfo>, SpoolError> {
+        if fs::symlink_metadata(path)
+            .map(|metadata| metadata.file_type().is_symlink())
+            .unwrap_or(false)
+        {
+            return Ok(None);
+        }
+        let bytes = match read_regular_file(&path.join("meta.json")) {
+            Ok(value) => value,
+            Err(error)
+                if error.kind() == io::ErrorKind::NotFound
+                    || error.kind() == io::ErrorKind::InvalidData
+                    || error.raw_os_error() == Some(libc::ELOOP) =>
+            {
+                return Ok(None);
+            }
+            Err(error) => return Err(error.into()),
+        };
+        let meta = match wire::parse_spool_meta(&bytes) {
+            Ok(value) => value,
+            Err(_) => return Ok(None),
+        };
+        if meta.node_id != self.config.node_id {
+            return Ok(None);
+        }
+        let info = BatchInfo {
+            node_id: meta.node_id,
+            spool_epoch: meta.spool_epoch,
+            batch_id: meta.batch_id,
+            first_spool_sequence: meta.first_spool_sequence.0,
+            last_spool_sequence: meta.last_spool_sequence.0,
+            event_count: meta.event_count.0,
+            raw_bytes: meta.raw_bytes.0,
+            body_sha256: meta.body_sha256,
+            first_received_at_unix_ms: meta.first_received_at_unix_ms.0,
+            last_received_at_unix_ms: meta.last_received_at_unix_ms.0,
+            path: path.to_path_buf(),
+        };
+        if info.first_spool_sequence == 0
+            || info.last_spool_sequence < info.first_spool_sequence
+            || info.event_count == 0
+            || info.last_received_at_unix_ms < info.first_received_at_unix_ms
+        {
+            return Ok(None);
+        }
+        Ok(Some(info))
+    }
+
+    /// Move a malformed sealed/acked object out of the export set and queue a
+    /// durable corruption gap.  Metadata is copied only when the strict meta
+    /// document itself is valid; body corruption must not erase trustworthy
+    /// batch/range evidence from the diagnostic record.
+    fn quarantine_batch_locked(&self, inner: &mut SpoolInner, path: &Path, label: &str) -> Result<(), SpoolError> {
+        let hint = read_meta_hint(path, &self.config.node_id);
+        let gap = corruption_gap_spec(hint.as_ref())?;
+        quarantine_path(&self.root, path, label)?;
+        inner.recovery_gaps.push_back(gap);
+        inner.gap_degraded = true;
+        // Do not let a corruption gap jump ahead of an outstanding state
+        // reset.  This guard is mostly for runtime fault injection; normal
+        // callers flush the reset at the beginning of lease/append.
+        if inner.pending_state_reset.is_none() {
+            self.flush_recovery_gaps_locked(inner)?;
+        }
+        Ok(())
+    }
+
+    fn write_record_locked(
+        &self,
+        inner: &mut SpoolInner,
+        wrapper: &[u8],
+        sequence: u64,
+        received_at_unix_ms: u64,
+    ) -> Result<(), SpoolError> {
+        inner.open_file.write_all(wrapper)?;
+        // `sync_data` is the fdatasync-equivalent required before state.json.
+        inner.open_file.sync_data()?;
+        update_open_metadata(
+            &mut inner.open_meta,
+            sequence,
+            received_at_unix_ms,
+            wrapper.len() as u64,
+        );
+        let next = sequence.checked_add(1).ok_or(SpoolError::SequenceExhausted)?;
+        inner.next_sequence = next;
+        persist_state(
+            &self.root,
+            &inner.epoch,
+            inner.next_sequence,
+            inner.pending_state_reset.clone(),
+        )?;
+        Ok(())
+    }
+
+    fn flush_state_reset_locked(&self, inner: &mut SpoolInner) -> Result<(), SpoolError> {
+        let Some(pending) = inner.pending_state_reset.clone() else {
+            return Ok(());
+        };
+        inner.gap_degraded = true;
+        // If recovery already found the fixed gap, only the state transition is
+        // needed.  Otherwise write that exact event before clearing pending.
+        if !event_id_exists_in_epoch(&self.root, &pending.gap_event_id, &inner.epoch)? {
+            let spec = GapSpec {
+                event_id: pending.gap_event_id.clone(),
+                occurred_at_unix_ms: pending.occurred_at_unix_ms.0,
+                lost_spool_epoch: pending.lost_spool_epoch.clone(),
+                reason: wire::SpoolGapReason::StateReset,
+                first_lost_spool_sequence: pending.first_lost_spool_sequence.map(|v| v.0),
+                last_lost_spool_sequence: pending.last_lost_spool_sequence.map(|v| v.0),
+                lost_events: None,
+                lost_bytes: None,
+                lost_batch_id: None,
+            };
+            self.write_gap_locked(inner, &spec)?;
+        }
+        // Keep the marker in memory until the clearing state write itself is
+        // durable.  If that second barrier fails, a retry must rediscover the
+        // same gap ID rather than accepting ordinary records with an
+        // unproven cursor.
+        inner.pending_state_reset = None;
+        if let Err(error) = persist_state(&self.root, &inner.epoch, inner.next_sequence, None) {
+            inner.pending_state_reset = Some(pending);
+            return Err(error);
+        }
+        Ok(())
+    }
+
+    fn flush_recovery_gaps_locked(&self, inner: &mut SpoolInner) -> Result<(), SpoolError> {
+        while let Some(spec) = inner.recovery_gaps.front().cloned() {
+            if event_id_exists_in_epoch(&self.root, &spec.event_id, &inner.epoch)? {
+                inner.recovery_gaps.pop_front();
+                continue;
+            }
+            self.write_gap_locked(inner, &spec)?;
+            inner.recovery_gaps.pop_front();
+        }
+        Ok(())
+    }
+
+    fn write_gap_locked(&self, inner: &mut SpoolInner, spec: &GapSpec) -> Result<(), SpoolError> {
+        if event_id_exists_in_epoch(&self.root, &spec.event_id, &inner.epoch)? {
+            return Ok(());
+        }
+        let gap = wire::SpoolGap {
+            schema_version: wire::SCHEMA_VERSION,
+            record_type: "diagnostic".to_owned(),
+            event_type: "spool_gap".to_owned(),
+            event_id: spec.event_id.clone(),
+            occurred_at_unix_ms: spec.occurred_at_unix_ms.into(),
+            node_id: self.config.node_id.clone(),
+            spool_epoch: inner.epoch.clone(),
+            lost_spool_epoch: spec.lost_spool_epoch.clone(),
+            reason: spec.reason,
+            first_lost_spool_sequence: spec.first_lost_spool_sequence.map(Into::into),
+            last_lost_spool_sequence: spec.last_lost_spool_sequence.map(Into::into),
+            lost_events: spec.lost_events.map(Into::into),
+            lost_bytes: spec.lost_bytes.map(Into::into),
+            lost_batch_id: spec.lost_batch_id.clone(),
+        };
+        let bytes = wire::serialize_canonical_record(&wire::AuditRecord::SpoolGap(gap))
+            .map_err(ProtocolError::from)
+            .map_err(SpoolError::Protocol)?;
+        let sequence = inner.next_sequence;
+        if sequence == u64::MAX {
+            return Err(SpoolError::SequenceExhausted);
+        }
+        let wrapper = wrapper_bytes(&inner.epoch, sequence, spec.occurred_at_unix_ms, &bytes)?;
+        if wrapper.len() as u64 > self.config.segment_max_bytes {
+            return Err(SpoolError::StorageUnavailable);
+        }
+        if inner.open_meta.bytes > 0
+            && inner.open_meta.bytes.saturating_add(wrapper.len() as u64) > self.config.segment_max_bytes
+        {
+            self.seal_locked(inner)?;
+        }
+        if !self.capacity_ok(wrapper.len() as u64) {
+            return Err(SpoolError::StorageUnavailable);
+        }
+        self.write_record_locked(inner, &wrapper, sequence, spec.occurred_at_unix_ms)?;
+        if inner.open_meta.bytes >= self.config.segment_max_bytes {
+            self.seal_locked(inner)?;
+        }
+        Ok(())
+    }
+
+    fn capacity_ok(&self, additional: u64) -> bool {
+        let size_ok = directory_size(&self.root)
+            .ok()
+            .and_then(|size| size.checked_add(additional))
+            .is_some_and(|size| size <= self.config.max_spool_bytes);
+        size_ok && free_space_ok(&self.root, self.config.min_free_bytes)
+    }
+
+    fn ensure_capacity_locked(&self, inner: &mut SpoolInner, additional: u64) -> Result<(), SpoolError> {
+        if self.capacity_ok(additional) {
+            return Ok(());
+        }
+        self.cleanup_locked(inner, additional)?;
+        if self.capacity_ok(additional) {
+            Ok(())
+        } else {
+            Err(SpoolError::StorageUnavailable)
+        }
+    }
+
+    fn cleanup_locked(&self, inner: &mut SpoolInner, additional: u64) -> Result<(), SpoolError> {
+        let now_seconds = unix_seconds()?;
+        self.remove_aged_acked_locked(inner, now_seconds.saturating_sub(ACKED_RETENTION_SECONDS))?;
+        // The active open segment is never deleted in place.  When it is the
+        // only reclaimable history, seal it first so the normal oldest-sealed
+        // eviction path can make progress while preserving its durability
+        // barriers.
+        if !self.capacity_ok(additional) && inner.open_meta.event_count > 0 {
+            self.seal_locked(inner)?;
+        }
+        while !self.capacity_ok(additional) {
+            let mut removed = false;
+            let mut paths = list_batch_dirs(&self.root.join("acked"))?;
+            paths.sort_by(|left, right| {
+                acked_timestamp(left)
+                    .unwrap_or(u64::MAX)
+                    .cmp(&acked_timestamp(right).unwrap_or(u64::MAX))
+                    .then_with(|| left.cmp(right))
+            });
+            for path in paths {
+                let Some(info) = self.read_meta(&path)? else {
+                    inner.degraded = true;
+                    self.quarantine_batch_locked(inner, &path, "acked-corrupt")?;
+                    removed = true;
+                    break;
+                };
+                match self.read_batch(&path, true) {
+                    Ok(Some(_)) => {}
+                    Ok(None) | Err(_) => {
+                        inner.degraded = true;
+                        self.quarantine_batch_locked(inner, &path, "acked-corrupt")?;
+                        removed = true;
+                        break;
+                    }
+                }
+                self.ensure_receipt_for_batch_locked(inner, &info)?;
+                fs::remove_dir_all(&path)?;
+                sync_dir(&self.root.join("acked"))?;
+                removed = true;
+                break;
+            }
+            if removed {
+                continue;
+            }
+            let mut quarantine = list_entries(&self.root.join("quarantine"))?;
+            quarantine.sort_by(|left, right| {
+                path_age_key(left)
+                    .cmp(&path_age_key(right))
+                    .then_with(|| left.cmp(right))
+            });
+            if let Some(path) = quarantine.first() {
+                self.evict_quarantine_locked(inner, path)?;
+                continue;
+            }
+            let mut sealed = Vec::new();
+            for path in list_batch_dirs(&self.root.join("sealed"))? {
+                let key = self.read_meta(&path)?.map(|info| {
+                    (
+                        info.first_received_at_unix_ms,
+                        info.first_spool_sequence,
+                        info.spool_epoch,
+                        info.batch_id,
+                    )
+                });
+                sealed.push((key, path));
+            }
+            sealed.sort_by(|(left_key, left_path), (right_key, right_path)| {
+                left_key.cmp(right_key).then_with(|| left_path.cmp(right_path))
+            });
+            if let Some((_, path)) = sealed.first() {
+                self.evict_sealed_locked(inner, path)?;
+                continue;
+            }
+            break;
+        }
+        if self.capacity_ok(additional) {
+            Ok(())
+        } else {
+            Err(SpoolError::StorageUnavailable)
+        }
+    }
+
+    /// Remove expired ACKed batches only after a durable receipt exists for
+    /// each one.  A crash can leave an ACKed directory behind before its
+    /// receipt barrier completes; deleting such a directory would make a
+    /// later duplicate ACK indistinguishable from an unknown batch.
+    fn remove_aged_acked_locked(&self, inner: &mut SpoolInner, cutoff_seconds: u64) -> Result<(), SpoolError> {
+        let mut candidates = Vec::new();
+        for path in list_batch_dirs(&self.root.join("acked"))? {
+            let Some(timestamp) = acked_timestamp(&path) else {
+                // Unknown names are retained conservatively.  They can still
+                // be considered by the regular capacity path, which will
+                // quarantine a malformed object instead of silently deleting
+                // it.
+                continue;
+            };
+            if timestamp < cutoff_seconds {
+                candidates.push((timestamp, path));
+            }
+        }
+        candidates.sort_by(|(left_time, left_path), (right_time, right_path)| {
+            left_time.cmp(right_time).then_with(|| left_path.cmp(right_path))
+        });
+        for (_, path) in candidates {
+            let Some(info) = self.read_meta(&path)? else {
+                inner.degraded = true;
+                self.quarantine_batch_locked(inner, &path, "acked-corrupt")?;
+                continue;
+            };
+            match self.read_batch(&path, true) {
+                Ok(Some(_)) => {}
+                Ok(None) | Err(_) => {
+                    inner.degraded = true;
+                    self.quarantine_batch_locked(inner, &path, "acked-corrupt")?;
+                    continue;
+                }
+            }
+            // This call is the receipt durability barrier.  On failure we do
+            // not remove the directory and propagate the retryable storage
+            // error to the append path.
+            self.ensure_receipt_for_batch_locked(inner, &info)?;
+            fs::remove_dir_all(&path)?;
+            sync_dir(&self.root.join("acked"))?;
+        }
+        Ok(())
+    }
+
+    fn prune_receipts_locked(&self, inner: &mut SpoolInner) -> Result<(), SpoolError> {
+        let cutoff = unix_seconds()?
+            .saturating_sub(TOMBSTONE_RETENTION_SECONDS)
+            .saturating_mul(1_000);
+        let old = inner.tombstones.clone();
+        inner
+            .tombstones
+            .retain(|entry| entry.is_pending() || entry.recorded_at_unix_ms() >= cutoff);
+        while inner.tombstones.len() > MAX_TOMBSTONES {
+            let Some((index, _)) = inner
+                .tombstones
+                .iter()
+                .enumerate()
+                .filter(|(_, entry)| !entry.is_pending())
+                .min_by_key(|(_, entry)| entry.recorded_at_unix_ms())
+            else {
+                break;
+            };
+            inner.tombstones.remove(index);
+        }
+        if inner.tombstones != old
+            && let Err(error) = persist_tombstones(&self.root, &inner.tombstones)
+        {
+            inner.tombstones = old;
+            return Err(error);
+        }
+        Ok(())
+    }
+
+    fn add_tombstone_locked(&self, inner: &mut SpoolInner, entry: TombstoneEntry) -> Result<(), SpoolError> {
+        self.prune_receipts_locked(inner)?;
+        for existing in &inner.tombstones {
+            let same_batch =
+                existing.batch_id().is_some() && entry.batch_id().is_some() && existing.batch_id() == entry.batch_id();
+            let same_gap = existing.gap_event_id().is_some()
+                && entry.gap_event_id().is_some()
+                && existing.gap_event_id() == entry.gap_event_id();
+            if same_batch || same_gap {
+                if existing == &entry {
+                    return Ok(());
+                }
+                return Err(SpoolError::InvalidState(
+                    "tombstone contains a conflicting duplicate identity".to_owned(),
+                ));
+            }
+        }
+        let old = inner.tombstones.clone();
+        if inner.tombstones.len() >= MAX_TOMBSTONES {
+            let Some((index, _)) = inner
+                .tombstones
+                .iter()
+                .enumerate()
+                .filter(|(_, item)| !item.is_pending())
+                .min_by_key(|(_, item)| item.recorded_at_unix_ms())
+            else {
+                return Err(SpoolError::StorageUnavailable);
+            };
+            inner.tombstones.remove(index);
+        }
+        inner.tombstones.push(entry);
+        if let Err(error) = persist_tombstones(&self.root, &inner.tombstones) {
+            inner.tombstones = old;
+            return Err(error);
+        }
+        Ok(())
+    }
+
+    fn remove_tombstone_locked(&self, inner: &mut SpoolInner, index: usize) -> Result<(), SpoolError> {
+        if index >= inner.tombstones.len() {
+            return Err(SpoolError::InvalidState("tombstone index is out of bounds".to_owned()));
+        }
+        let old = inner.tombstones.clone();
+        inner.tombstones.remove(index);
+        if let Err(error) = persist_tombstones(&self.root, &inner.tombstones) {
+            inner.tombstones = old;
+            return Err(error);
+        }
+        Ok(())
+    }
+
+    fn replace_tombstone_locked(
+        &self,
+        inner: &mut SpoolInner,
+        index: usize,
+        replacement: Option<TombstoneEntry>,
+    ) -> Result<(), SpoolError> {
+        if index >= inner.tombstones.len() {
+            return Err(SpoolError::InvalidState("tombstone index is out of bounds".to_owned()));
+        }
+        let old = inner.tombstones.clone();
+        if let Some(value) = replacement {
+            inner.tombstones[index] = value;
+        } else {
+            inner.tombstones.remove(index);
+        }
+        if let Err(error) = persist_tombstones(&self.root, &inner.tombstones) {
+            inner.tombstones = old;
+            return Err(error);
+        }
+        Ok(())
+    }
+
+    fn add_receipt_locked(&self, inner: &mut SpoolInner, entry: TombstoneEntry) -> Result<(), SpoolError> {
+        self.add_tombstone_locked(inner, entry)
+    }
+
+    fn rebuild_acked_receipts_locked(&self, inner: &mut SpoolInner) -> Result<(), SpoolError> {
+        let mut first_error = None;
+        for path in list_batch_dirs(&self.root.join("acked"))? {
+            let Some(info) = self.read_meta(&path)? else {
+                inner.degraded = true;
+                continue;
+            };
+            if self.read_batch(&path, true)?.is_none() {
+                inner.degraded = true;
+                continue;
+            }
+            if let Err(error) = self.ensure_receipt_for_batch_locked(inner, &info) {
+                // A full ledger containing only pending transactions must
+                // never cause an ACKed batch to be deleted.  Keep scanning so
+                // healthy batches can still rebuild their receipts, then
+                // report the storage barrier failure to the caller.
+                first_error.get_or_insert(error);
+            }
+        }
+        if let Some(error) = first_error {
+            Err(error)
+        } else {
+            Ok(())
+        }
+    }
+
+    fn ensure_receipt_for_batch_locked(&self, inner: &mut SpoolInner, info: &BatchInfo) -> Result<(), SpoolError> {
+        for entry in &inner.tombstones {
+            match entry {
+                TombstoneEntry::AckedReceipt(value) if value.batch_id == info.batch_id => {
+                    if value.body_sha256 == info.body_sha256 {
+                        return Ok(());
+                    }
+                    return Err(SpoolError::DigestMismatch);
+                }
+                TombstoneEntry::EvictedReceipt(value) if value.batch_id == info.batch_id => {
+                    // An acked directory and an evicted receipt for the same
+                    // batch are mutually exclusive.  Refuse to delete or
+                    // acknowledge it until recovery resolves the inconsistency.
+                    return Err(SpoolError::InvalidState(
+                        "acked batch has an evicted receipt".to_owned(),
+                    ));
+                }
+                _ => {}
+            }
+        }
+        self.add_receipt_locked(
+            inner,
+            TombstoneEntry::AckedReceipt(wire::AckedReceipt::new(
+                info.batch_id.clone(),
+                info.body_sha256.clone(),
+                unix_millis()?,
+            )),
+        )
+    }
+
+    fn evict_sealed_locked(&self, inner: &mut SpoolInner, path: &Path) -> Result<(), SpoolError> {
+        let lease = match self.read_batch(path, false) {
+            Ok(Some(value)) => value,
+            Ok(None) | Err(_) => {
+                inner.degraded = true;
+                self.quarantine_batch_locked(inner, path, "batch-corrupt")?;
+                return Ok(());
+            }
+        };
+        let info = lease.info;
+        let gap_event_id = format!("{}{}", GAP_ID_PREFIX, random_hex_id()?);
+        let pending = wire::EvictionPending::new(
+            info.batch_id.clone(),
+            info.body_sha256.clone(),
+            unix_millis()?,
+            gap_event_id.clone(),
+            if free_space_ok(&self.root, self.config.min_free_bytes) {
+                "capacity_eviction"
+            } else {
+                "min_free_eviction"
+            },
+            info.spool_epoch.clone(),
+            info.first_spool_sequence,
+            info.last_spool_sequence,
+            info.event_count,
+            info.raw_bytes,
+        );
+        self.add_tombstone_locked(inner, TombstoneEntry::EvictionPending(pending.clone()))?;
+        fs::remove_dir_all(path)?;
+        sync_dir(&self.root.join("sealed"))?;
+        if inner.leased_batch.as_deref() == Some(info.batch_id.as_str()) {
+            // The collector may still ACK this ID after the leased batch was
+            // evicted; the durable evicted receipt below will turn that into
+            // the specified 410 response instead of leaving a stale lease.
+            inner.leased_batch = None;
+        }
+        let spec = GapSpec {
+            event_id: gap_event_id,
+            occurred_at_unix_ms: unix_millis()?,
+            lost_spool_epoch: Some(info.spool_epoch),
+            reason: if pending.reason == "min_free_eviction" {
+                wire::SpoolGapReason::MinFreeEviction
+            } else {
+                wire::SpoolGapReason::CapacityEviction
+            },
+            first_lost_spool_sequence: Some(info.first_spool_sequence),
+            last_lost_spool_sequence: Some(info.last_spool_sequence),
+            lost_events: Some(info.event_count),
+            lost_bytes: Some(info.raw_bytes),
+            lost_batch_id: Some(info.batch_id.clone()),
+        };
+        inner.gap_degraded = true;
+        if let Err(error) = self.write_gap_locked(inner, &spec) {
+            inner.degraded = true;
+            return Err(error);
+        }
+        let replacement = TombstoneEntry::EvictedReceipt(wire::EvictedReceipt::from_pending(&pending));
+        if let Some(index) = inner.tombstones.iter().position(|entry| {
+            matches!(entry, TombstoneEntry::EvictionPending(value) if value.gap_event_id == pending.gap_event_id)
+        }) {
+            self.replace_tombstone_locked(inner, index, Some(replacement))?;
+        }
+        inner.evicted_unacked_records = inner.evicted_unacked_records.saturating_add(info.event_count);
+        Ok(())
+    }
+
+    fn evict_quarantine_locked(&self, inner: &mut SpoolInner, path: &Path) -> Result<(), SpoolError> {
+        let basename = path
+            .file_name()
+            .and_then(|value| value.to_str())
+            .ok_or_else(|| SpoolError::InvalidState("invalid quarantine basename".to_owned()))?
+            .to_owned();
+        let hint = read_meta_hint(path, &self.config.node_id);
+        let gap_event_id = format!("{}{}", GAP_ID_PREFIX, random_hex_id()?);
+        let pending = wire::QuarantinePending::new(
+            gap_event_id.clone(),
+            basename,
+            unix_millis()?,
+            hint.as_ref().map(|value| value.batch_id.clone()),
+            hint.as_ref().map(|value| value.body_sha256.clone()),
+            hint.as_ref().map(|value| value.spool_epoch.clone()),
+            hint.as_ref().map(|value| value.first_spool_sequence),
+            hint.as_ref().map(|value| value.last_spool_sequence),
+            hint.as_ref().map(|value| value.event_count),
+            hint.as_ref().map(|value| value.raw_bytes),
+        );
+        self.add_tombstone_locked(inner, TombstoneEntry::QuarantinePending(pending.clone()))?;
+        remove_path(path)?;
+        sync_dir(&self.root.join("quarantine"))?;
+        let spec = GapSpec {
+            event_id: gap_event_id,
+            occurred_at_unix_ms: unix_millis()?,
+            // `read_meta_hint` only returns strict, node-matching metadata;
+            // preserve every field that remains trustworthy even though the
+            // quarantined body itself was not exportable.  Recovery follows
+            // the same rule when replaying a durable quarantine_pending entry.
+            lost_spool_epoch: pending.spool_epoch.clone(),
+            reason: wire::SpoolGapReason::QuarantineEviction,
+            first_lost_spool_sequence: pending.first_spool_sequence.map(|value| value.0),
+            last_lost_spool_sequence: pending.last_spool_sequence.map(|value| value.0),
+            lost_events: pending.event_count.map(|value| value.0),
+            lost_bytes: pending.raw_bytes.map(|value| value.0),
+            lost_batch_id: pending.batch_id.clone(),
+        };
+        inner.gap_degraded = true;
+        self.write_gap_locked(inner, &spec)?;
+        if let Some(index) = inner.tombstones.iter().position(|entry| {
+            matches!(entry, TombstoneEntry::QuarantinePending(value) if value.gap_event_id == pending.gap_event_id)
+        }) {
+            self.remove_tombstone_locked(inner, index)?;
+        }
+        Ok(())
+    }
+
+    fn reconcile_tombstones_locked(&self, inner: &mut SpoolInner) -> Result<(), SpoolError> {
+        self.prune_receipts_locked(inner)?;
+        let mut index = 0;
+        while index < inner.tombstones.len() {
+            let entry = inner.tombstones[index].clone();
+            match entry {
+                TombstoneEntry::EvictionPending(pending) => {
+                    inner.gap_degraded = true;
+                    // Locate the batch even when its metadata is malformed.
+                    // `find_batch_with_digest` intentionally ignores such an
+                    // object; leaving it in `sealed/` would make a pending
+                    // eviction appear complete while the corrupt bytes stay
+                    // eligible for export and capacity scans.
+                    if let Some(path) = self.find_batch_path_by_id(&self.root.join("sealed"), &pending.batch_id)? {
+                        match self.read_batch(&path, false) {
+                            Ok(Some(_)) => {
+                                // The crash happened before the delete
+                                // barrier; retaining the complete batch is
+                                // safer than claiming it was evicted.  Drop
+                                // only the pending transaction marker.
+                                self.remove_tombstone_locked(inner, index)?;
+                                continue;
+                            }
+                            Ok(None) | Err(_) => {
+                                // The fixed eviction gap already describes
+                                // this batch.  Quarantine the malformed copy
+                                // directly instead of creating a second,
+                                // unrelated corruption gap.
+                                inner.degraded = true;
+                                quarantine_path(&self.root, &path, "batch-corrupt")?;
+                            }
+                        }
+                    }
+                    let spec = GapSpec {
+                        event_id: pending.gap_event_id.clone(),
+                        occurred_at_unix_ms: pending.recorded_at_unix_ms.0,
+                        lost_spool_epoch: Some(pending.spool_epoch.clone()),
+                        reason: if pending.reason == "min_free_eviction" {
+                            wire::SpoolGapReason::MinFreeEviction
+                        } else {
+                            wire::SpoolGapReason::CapacityEviction
+                        },
+                        first_lost_spool_sequence: Some(pending.first_spool_sequence.0),
+                        last_lost_spool_sequence: Some(pending.last_spool_sequence.0),
+                        lost_events: Some(pending.event_count.0),
+                        lost_bytes: Some(pending.raw_bytes.0),
+                        lost_batch_id: Some(pending.batch_id.clone()),
+                    };
+                    if !event_id_exists_in_epoch(&self.root, &pending.gap_event_id, &inner.epoch)? {
+                        self.write_gap_locked(inner, &spec)?;
+                    }
+                    self.replace_tombstone_locked(
+                        inner,
+                        index,
+                        Some(TombstoneEntry::EvictedReceipt(wire::EvictedReceipt::from_pending(
+                            &pending,
+                        ))),
+                    )?;
+                }
+                TombstoneEntry::QuarantinePending(pending) => {
+                    inner.gap_degraded = true;
+                    if find_quarantine_entry(&self.root.join("quarantine"), &pending.quarantine_basename).is_some() {
+                        self.remove_tombstone_locked(inner, index)?;
+                        continue;
+                    }
+                    let spec = GapSpec {
+                        event_id: pending.gap_event_id.clone(),
+                        occurred_at_unix_ms: pending.recorded_at_unix_ms.0,
+                        lost_spool_epoch: pending.spool_epoch.clone(),
+                        reason: wire::SpoolGapReason::QuarantineEviction,
+                        first_lost_spool_sequence: pending.first_spool_sequence.map(|v| v.0),
+                        last_lost_spool_sequence: pending.last_spool_sequence.map(|v| v.0),
+                        lost_events: pending.event_count.map(|v| v.0),
+                        lost_bytes: pending.raw_bytes.map(|v| v.0),
+                        lost_batch_id: pending.batch_id.clone(),
+                    };
+                    if !event_id_exists_in_epoch(&self.root, &pending.gap_event_id, &inner.epoch)? {
+                        self.write_gap_locked(inner, &spec)?;
+                    }
+                    self.remove_tombstone_locked(inner, index)?;
+                }
+                TombstoneEntry::AckedReceipt(_) | TombstoneEntry::EvictedReceipt(_) => {
+                    index += 1;
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn seal_locked(&self, inner: &mut SpoolInner) -> Result<(), SpoolError> {
+        if inner.open_meta.event_count == 0 {
+            return Ok(());
+        }
+        inner.open_file.sync_all()?;
+        let batch_id = random_hex_id()?;
+        let first = inner
+            .open_meta
+            .first_sequence
+            .ok_or_else(|| SpoolError::InvalidState("open metadata missing first sequence".to_owned()))?;
+        let last = inner
+            .open_meta
+            .last_sequence
+            .ok_or_else(|| SpoolError::InvalidState("open metadata missing last sequence".to_owned()))?;
+        let sealed_root = self.root.join("sealed");
+        let tmp = sealed_root.join(format!(".tmp-{batch_id}"));
+        let final_dir = sealed_root.join(format!("{}-{}-{}-{}", inner.epoch, first, last, batch_id));
+        let open_path = self.root.join("open/current.ndjson");
+        let segment_path = tmp.join("segment.ndjson");
+        let mut moved_open = false;
+        let operation = (|| -> Result<File, SpoolError> {
+            ensure_dir(&tmp, 0o700)?;
+            fs::rename(&open_path, &segment_path)?;
+            moved_open = true;
+            sync_dir(&self.root.join("open"))?;
+            sync_dir(&tmp)?;
+            let body = read_regular_file(&segment_path)?;
+            let meta =
+                wire::SpoolMeta::new(
+                    self.config.node_id.clone(),
+                    inner.epoch.clone(),
+                    batch_id.clone(),
+                    first,
+                    last,
+                    inner.open_meta.event_count,
+                    body.len() as u64,
+                    digest_hex(&body),
+                    inner.open_meta.first_received_at.ok_or_else(|| {
+                        SpoolError::InvalidState("open metadata missing first receive time".to_owned())
+                    })?,
+                    inner.open_meta.last_received_at.ok_or_else(|| {
+                        SpoolError::InvalidState("open metadata missing last receive time".to_owned())
+                    })?,
+                );
+            let meta_bytes = meta
+                .canonical_bytes()
+                .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+            write_atomic_file(&tmp.join("meta.json"), &meta_bytes, 0o600)?;
+            sync_dir(&tmp)?;
+            fs::rename(&tmp, &final_dir)?;
+            sync_dir(&sealed_root)?;
+            let new_file = OpenOptions::new()
+                .create(true)
+                .read(true)
+                .append(true)
+                .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+                .mode(0o600)
+                .open(&open_path)?;
+            set_file_mode(&open_path, 0o600)?;
+            new_file.sync_all()?;
+            sync_dir(&self.root.join("open"))?;
+            Ok(new_file)
+        })();
+        match operation {
+            Ok(new_file) => {
+                inner.open_file = new_file;
+                inner.open_meta = OpenMetadata::empty();
+                Ok(())
+            }
+            Err(error) => {
+                // Once current.ndjson has been renamed, the old descriptor in
+                // `inner.open_file` points at the segment inode.  Repair that
+                // invariant before returning the I/O error: callers may retry
+                // a seal, and must never append into a temporary or sealed
+                // directory through the stale descriptor.
+                self.recover_seal_failure(inner, &open_path, &segment_path, &tmp, &final_dir, moved_open)?;
+                Err(error)
+            }
+        }
+    }
+
+    fn recover_seal_failure(
+        &self,
+        inner: &mut SpoolInner,
+        open_path: &Path,
+        segment_path: &Path,
+        tmp: &Path,
+        final_dir: &Path,
+        moved_open: bool,
+    ) -> Result<(), SpoolError> {
+        if !moved_open {
+            // No rename succeeded, so the original descriptor still points at
+            // current.ndjson.  Keep the metadata and inode intact; the caller
+            // can retry the operation after reporting the original error.
+            return Ok(());
+        }
+        if fs::symlink_metadata(final_dir).is_ok() {
+            // The batch rename completed.  The original records are now
+            // durable in sealed/, so establish a fresh writable open inode.
+            let file = OpenOptions::new()
+                .create(true)
+                .read(true)
+                .append(true)
+                .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+                .mode(0o600)
+                .open(open_path)?;
+            set_file_mode(open_path, 0o600)?;
+            file.sync_all()?;
+            sync_dir(&self.root.join("open"))?;
+            inner.open_file = file;
+            inner.open_meta = OpenMetadata::empty();
+            return Ok(());
+        }
+
+        // The final rename did not complete.  Put the segment back in its
+        // original location when possible, then remove the incomplete temp
+        // directory.  This preserves the in-memory metadata and lets the
+        // caller retry the seal without losing the open records.
+        if fs::symlink_metadata(segment_path).is_ok() && fs::symlink_metadata(open_path).is_err() {
+            fs::rename(segment_path, open_path)?;
+            sync_dir(tmp.parent().unwrap_or_else(|| Path::new(".")))?;
+            sync_dir(open_path.parent().unwrap_or_else(|| Path::new(".")))?;
+        }
+        if fs::symlink_metadata(open_path).is_ok() {
+            if fs::symlink_metadata(tmp).is_ok() {
+                let _ = fs::remove_dir_all(tmp);
+                if let Some(parent) = tmp.parent() {
+                    sync_dir(parent)?;
+                }
+            }
+            let file = OpenOptions::new()
+                .read(true)
+                .append(true)
+                .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+                .open(open_path)?;
+            set_file_mode(open_path, 0o600)?;
+            inner.open_file = file;
+            return Ok(());
+        }
+
+        // If rollback itself could not find the inode, leave the temp object
+        // for crash recovery and create an empty open file only when the
+        // filesystem permits it.  The caller marks the spool degraded; the
+        // preserved temp object will be quarantined or promoted on restart.
+        let file = OpenOptions::new()
+            .create(true)
+            .read(true)
+            .append(true)
+            .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+            .mode(0o600)
+            .open(open_path)?;
+        set_file_mode(open_path, 0o600)?;
+        file.sync_all()?;
+        sync_dir(open_path.parent().unwrap_or_else(|| Path::new(".")))?;
+        inner.open_file = file;
+        inner.open_meta = OpenMetadata::empty();
+        Ok(())
+    }
+}
+
+#[derive(Debug)]
+struct OpenScan {
+    meta: OpenMetadata,
+    epoch: Option<String>,
+    max_sequence: u64,
+    event_ids: HashSet<String>,
+    tail_truncated: bool,
+}
+
+fn recover_layout(root: &Path, node_id: &str) -> Result<RecoveryResult, SpoolError> {
+    let mut degraded = false;
+    // Once a persisted object is quarantined, its sequence high-water mark is
+    // no longer fully provable from the surviving files.  Do not continue the
+    // old epoch merely because the remaining scan happens to be below the
+    // cursor; start a fresh epoch and emit the documented state-reset gap.
+    let mut history_untrusted = false;
+    let mut recovery_gaps = VecDeque::new();
+    let mut maxima: HashMap<String, u64> = HashMap::new();
+    let mut sequence_ranges: Vec<(String, u64, u64)> = Vec::new();
+
+    // Finish or isolate interrupted seal directories before examining the
+    // high-water mark.  A complete temp batch can safely be promoted.
+    let sealed_root = root.join("sealed");
+    for path in list_hidden_dirs(&sealed_root)? {
+        match inspect_batch_dir(&path, node_id) {
+            Ok(info) => {
+                let final_dir = sealed_root.join(format!(
+                    "{}-{}-{}-{}",
+                    info.spool_epoch, info.first_spool_sequence, info.last_spool_sequence, info.batch_id
+                ));
+                if fs::rename(&path, &final_dir).is_ok() {
+                    sync_dir(&sealed_root)?;
+                } else {
+                    degraded = true;
+                    history_untrusted = true;
+                    let _ = quarantine_path(root, &path, "seal-incomplete");
+                    recovery_gaps.push_back(GapSpec {
+                        event_id: format!("{}{}", GAP_ID_PREFIX, random_hex_id()?),
+                        occurred_at_unix_ms: unix_millis()?,
+                        lost_spool_epoch: Some(info.spool_epoch),
+                        reason: wire::SpoolGapReason::SegmentCorruption,
+                        first_lost_spool_sequence: Some(info.first_spool_sequence),
+                        last_lost_spool_sequence: Some(info.last_spool_sequence),
+                        lost_events: Some(info.event_count),
+                        lost_bytes: Some(info.raw_bytes),
+                        lost_batch_id: Some(info.batch_id),
+                    });
+                }
+            }
+            Err(_) => {
+                degraded = true;
+                history_untrusted = true;
+                let hint = read_meta_hint(&path, node_id);
+                let _ = quarantine_path(root, &path, "seal-incomplete");
+                recovery_gaps.push_back(corruption_gap_spec(hint.as_ref())?);
+            }
+        }
+    }
+
+    for parent_name in ["sealed", "acked"] {
+        let parent = root.join(parent_name);
+        let paths = list_batch_dirs(&parent)?;
+        for path in paths {
+            match inspect_batch_dir(&path, node_id) {
+                Ok(info) => {
+                    maxima
+                        .entry(info.spool_epoch.clone())
+                        .and_modify(|value| *value = (*value).max(info.last_spool_sequence))
+                        .or_insert(info.last_spool_sequence);
+                    sequence_ranges.push((
+                        info.spool_epoch.clone(),
+                        info.first_spool_sequence,
+                        info.last_spool_sequence,
+                    ));
+                }
+                Err(_) => {
+                    degraded = true;
+                    history_untrusted = true;
+                    let hint = read_meta_hint(&path, node_id);
+                    let _ = quarantine_path(root, &path, "batch-corrupt");
+                    recovery_gaps.push_back(corruption_gap_spec(hint.as_ref())?);
+                }
+            }
+        }
+    }
+
+    let open_path = root.join("open/current.ndjson");
+    let open_is_symlink = fs::symlink_metadata(&open_path)
+        .map(|metadata| metadata.file_type().is_symlink())
+        .unwrap_or(false);
+    let open_bytes = match read_regular_file(&open_path) {
+        Ok(bytes) => bytes,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Vec::new(),
+        Err(_) if open_is_symlink => {
+            degraded = true;
+            history_untrusted = true;
+            let _ = quarantine_path(root, &open_path, "open-symlink");
+            recovery_gaps.push_back(corruption_gap_spec(None)?);
+            Vec::new()
+        }
+        Err(_) => {
+            // A regular open file that is too large, malformed, or otherwise
+            // unreadable is untrusted history. Isolate it and continue in a
+            // fresh epoch when possible; refusing to start would turn an
+            // audit-storage fault into a data-plane outage. If the rename
+            // itself fails, propagate that bounded I/O error instead of
+            // silently discarding the inode.
+            degraded = true;
+            history_untrusted = true;
+            quarantine_path(root, &open_path, "open-corrupt")?;
+            recovery_gaps.push_back(corruption_gap_spec(None)?);
+            Vec::new()
+        }
+    };
+    let open_scan = match scan_open_bytes(&open_bytes, node_id) {
+        Ok(value) => value,
+        Err(_) => {
+            degraded = true;
+            history_untrusted = true;
+            if !open_bytes.is_empty() {
+                let _ = quarantine_path(root, &open_path, "open-corrupt");
+            }
+            recovery_gaps.push_back(GapSpec {
+                event_id: format!("{}{}", GAP_ID_PREFIX, random_hex_id()?),
+                occurred_at_unix_ms: unix_millis()?,
+                lost_spool_epoch: None,
+                reason: wire::SpoolGapReason::SegmentCorruption,
+                first_lost_spool_sequence: None,
+                last_lost_spool_sequence: None,
+                lost_events: None,
+                lost_bytes: None,
+                lost_batch_id: None,
+            });
+            OpenScan {
+                meta: OpenMetadata::empty(),
+                epoch: None,
+                max_sequence: 0,
+                event_ids: HashSet::new(),
+                tail_truncated: false,
+            }
+        }
+    };
+    if let Some(epoch) = &open_scan.epoch {
+        maxima
+            .entry(epoch.clone())
+            .and_modify(|value| *value = (*value).max(open_scan.max_sequence))
+            .or_insert(open_scan.max_sequence);
+        if let (Some(first), Some(last)) = (open_scan.meta.first_sequence, open_scan.meta.last_sequence) {
+            sequence_ranges.push((epoch.clone(), first, last));
+        }
+    }
+    if open_scan.tail_truncated {
+        degraded = true;
+        let retained = open_bytes
+            .iter()
+            .rposition(|byte| *byte == b'\n')
+            .map_or(0, |index| index + 1);
+        truncate_open(&open_path, retained)?;
+        recovery_gaps.push_back(GapSpec {
+            event_id: format!("{}{}", GAP_ID_PREFIX, random_hex_id()?),
+            occurred_at_unix_ms: unix_millis()?,
+            lost_spool_epoch: open_scan.epoch.clone(),
+            reason: wire::SpoolGapReason::TailTruncation,
+            first_lost_spool_sequence: None,
+            last_lost_spool_sequence: None,
+            lost_events: None,
+            lost_bytes: None,
+            lost_batch_id: None,
+        });
+    }
+
+    let state_path = root.join("state.json");
+    let state = load_state(&state_path);
+    let mut force_new_epoch = false;
+    let (mut epoch, mut next_sequence, mut pending_state_reset) = match state {
+        Ok(Some(value)) if value.state_schema_version == STATE_SCHEMA_VERSION => (
+            value.spool_epoch,
+            value.next_spool_sequence.0,
+            value.pending_state_reset,
+        ),
+        Ok(Some(_)) | Err(_) | Ok(None) => {
+            degraded = true;
+            force_new_epoch = true;
+            (random_hex_id()?, 1, None)
+        }
+    };
+
+    let current_max = maxima.get(&epoch).copied().unwrap_or(0);
+    let open_epoch_mismatch = open_scan.epoch.as_deref().is_some_and(|value| value != epoch);
+
+    // A valid state cursor proves that deleted history may exist, but it
+    // cannot make two surviving objects claim the same sequence range.  Such
+    // overlap is evidence of a copy/rename or metadata corruption; abandon
+    // the epoch rather than exporting ambiguous `(epoch, sequence)` keys.
+    sequence_ranges.sort_by(|left, right| {
+        left.0
+            .cmp(&right.0)
+            .then_with(|| left.1.cmp(&right.1))
+            .then_with(|| left.2.cmp(&right.2))
+    });
+    if sequence_ranges.windows(2).any(|window| {
+        let left = &window[0];
+        let right = &window[1];
+        left.0 == right.0 && right.1 <= left.2
+    }) {
+        degraded = true;
+        history_untrusted = true;
+    }
+
+    // A pending state-reset is the one explicit crash window in which a
+    // cursor that is at-or-behind the scanned high-water mark may be repaired
+    // in place.  Evaluate this exception before the normal `next <= max`
+    // epoch-reset rule; otherwise a crash between the record fsync and the
+    // state fsync would unnecessarily create a second epoch and gap.
+    if history_untrusted {
+        force_new_epoch = true;
+    }
+    if !force_new_epoch {
+        if let Some(pending) = pending_state_reset.as_ref() {
+            let pending_found = (open_scan.event_ids.contains(&pending.gap_event_id)
+                && open_scan.epoch.as_deref() == Some(epoch.as_str()))
+                || event_id_exists_in_epoch(root, &pending.gap_event_id, &epoch)?;
+            if pending_found {
+                let scanned_max = maxima.get(&epoch).copied().unwrap_or(0);
+                match scanned_max.checked_add(1) {
+                    Some(repaired_next) => {
+                        next_sequence = next_sequence.max(repaired_next);
+                        pending_state_reset = None;
+                    }
+                    None => {
+                        // There is no representable sequence after a durable
+                        // u64::MAX record.  Start a fresh epoch rather than
+                        // risking wraparound or reusing the old cursor.
+                        force_new_epoch = true;
+                    }
+                }
+            } else if next_sequence == 0 || next_sequence <= current_max {
+                // Keep the fixed pending gap ID while advancing past records
+                // that were durable before the crash.  The first subsequent
+                // write will emit that gap before accepting a new event.
+                match current_max.checked_add(1) {
+                    Some(repaired_next) => next_sequence = repaired_next,
+                    None => force_new_epoch = true,
+                }
+            }
+        } else if next_sequence == 0 || next_sequence <= current_max {
+            force_new_epoch = true;
+        }
+        if open_epoch_mismatch {
+            force_new_epoch = true;
+        }
+    }
+
+    if force_new_epoch {
+        degraded = true;
+        if !open_bytes.is_empty() && open_path.exists() {
+            let _ = quarantine_path(root, &open_path, "state-reset");
+        }
+        let old_epoch = open_scan.epoch.clone();
+        epoch = random_hex_id()?;
+        next_sequence = 1;
+        pending_state_reset = Some(PendingStateReset {
+            gap_event_id: format!("{}{}", GAP_ID_PREFIX, random_hex_id()?),
+            occurred_at_unix_ms: unix_millis()?.into(),
+            lost_spool_epoch: old_epoch,
+            first_lost_spool_sequence: None,
+            last_lost_spool_sequence: None,
+        });
+        // Keep any independently discovered corruption gaps.  A state reset
+        // does not prove that those other quarantined records were retained.
+        persist_state(root, &epoch, next_sequence, pending_state_reset.clone())?;
+    } else {
+        // Persist a repaired cursor or cleared pending marker before accepting
+        // new records.  Rewriting an already-valid state is harmless and also
+        // covers the pending-but-gap-not-yet-written recovery case.
+        persist_state(root, &epoch, next_sequence, pending_state_reset.clone())?;
+    }
+
+    let mut recovered_open_meta = if force_new_epoch {
+        OpenMetadata::empty()
+    } else {
+        open_scan.meta
+    };
+    if !force_new_epoch {
+        // Preserve the segment's real age across a daemon restart so the
+        // configured max-age seal rule is not silently postponed.
+        if let Ok(modified) = fs::metadata(&open_path).and_then(|metadata| metadata.modified()) {
+            recovered_open_meta.opened_at = modified;
+        }
+    }
+
+    Ok(RecoveryResult {
+        epoch,
+        next_sequence,
+        degraded,
+        gap_degraded: pending_state_reset.is_some() || !recovery_gaps.is_empty(),
+        open_meta: recovered_open_meta,
+        pending_state_reset,
+        recovery_gaps,
+    })
+}
+
+fn load_state(path: &Path) -> Result<Option<wire::SpoolState>, SpoolError> {
+    let bytes = match read_regular_file(&path) {
+        Ok(value) => value,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error.into()),
+    };
+    wire::parse_spool_state(&bytes)
+        .map(Some)
+        .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))
+}
+
+fn inspect_batch_dir(path: &Path, node_id: &str) -> Result<BatchInfo, SpoolError> {
+    enforce_private_dir(path)?;
+    enforce_private_file(&path.join("meta.json"))?;
+    enforce_private_file(&path.join("segment.ndjson"))?;
+    let info = read_meta_hint(path, node_id)
+        .ok_or_else(|| SpoolError::InvalidState("batch metadata is missing or invalid".to_owned()))?;
+    let body = read_regular_file(&path.join("segment.ndjson"))?;
+    if body.len() as u64 != info.raw_bytes || digest_hex(&body) != info.body_sha256 || !body.ends_with(b"\n") {
+        return Err(SpoolError::InvalidState(
+            "batch body digest or framing mismatch".to_owned(),
+        ));
+    }
+    validate_segment_body(&body, &info, node_id)?;
+    Ok(info)
+}
+
+fn enforce_private_dir(path: &Path) -> Result<(), SpoolError> {
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW | libc::O_DIRECTORY)
+        .open(path)?;
+    if !file.metadata()?.is_dir() {
+        return Err(SpoolError::InvalidState(format!(
+            "spool batch is not a regular directory: {}",
+            path.display()
+        )));
+    }
+    file.set_permissions(fs::Permissions::from_mode(0o700))?;
+    // Keep the ownership check descriptor-bound.  Mode 0700 alone is not
+    // sufficient when the daemon runs with elevated privileges: a spool
+    // object pre-created by another account must not become trusted history.
+    validate_private_dir_fd(file.as_raw_fd())?;
+    Ok(())
+}
+
+fn enforce_private_file(path: &Path) -> Result<(), SpoolError> {
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+        .open(path)?;
+    if !file.metadata()?.is_file() {
+        return Err(SpoolError::InvalidState(format!(
+            "spool object is not a regular file: {}",
+            path.display()
+        )));
+    }
+    file.set_permissions(fs::Permissions::from_mode(0o600))?;
+    validate_private_file_fd(file.as_raw_fd())?;
+    Ok(())
+}
+
+fn read_meta_hint(path: &Path, node_id: &str) -> Option<BatchInfo> {
+    if fs::symlink_metadata(path).ok()?.file_type().is_symlink() {
+        return None;
+    }
+    let meta_bytes = read_regular_file(&path.join("meta.json")).ok()?;
+    let meta = wire::parse_spool_meta(&meta_bytes).ok()?;
+    if meta.node_id != node_id {
+        return None;
+    }
+    Some(BatchInfo {
+        node_id: meta.node_id,
+        spool_epoch: meta.spool_epoch,
+        batch_id: meta.batch_id,
+        first_spool_sequence: meta.first_spool_sequence.0,
+        last_spool_sequence: meta.last_spool_sequence.0,
+        event_count: meta.event_count.0,
+        raw_bytes: meta.raw_bytes.0,
+        body_sha256: meta.body_sha256,
+        first_received_at_unix_ms: meta.first_received_at_unix_ms.0,
+        last_received_at_unix_ms: meta.last_received_at_unix_ms.0,
+        path: path.to_path_buf(),
+    })
+}
+
+fn validate_segment_body(body: &[u8], info: &BatchInfo, node_id: &str) -> Result<(), SpoolError> {
+    let mut count = 0_u64;
+    let mut expected = info.first_spool_sequence;
+    let mut first_received = None;
+    let mut last_received = None;
+    for line in body.split_inclusive(|byte| *byte == b'\n') {
+        let record = wire::parse_spool_line(line).map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+        if record.spool_epoch != info.spool_epoch || record.spool_sequence.0 != expected {
+            return Err(SpoolError::InvalidState("batch sequence/epoch mismatch".to_owned()));
+        }
+        let event = parse_stored_event(record.event_bytes())?;
+        if stored_event_node_id(&event) != node_id || !stored_event_epoch_matches(&event, &record.spool_epoch) {
+            return Err(SpoolError::InvalidState("batch event node mismatch".to_owned()));
+        }
+        let received = record.received_at_unix_ms.0;
+        first_received.get_or_insert(received);
+        last_received = Some(received);
+        count = count.saturating_add(1);
+        expected = expected.checked_add(1).ok_or(SpoolError::SequenceExhausted)?;
+    }
+    if count != info.event_count
+        || count == 0
+        || expected.saturating_sub(1) != info.last_spool_sequence
+        || first_received != Some(info.first_received_at_unix_ms)
+        || last_received != Some(info.last_received_at_unix_ms)
+    {
+        return Err(SpoolError::InvalidState(
+            "batch metadata does not match body".to_owned(),
+        ));
+    }
+    Ok(())
+}
+
+fn scan_open_bytes(bytes: &[u8], node_id: &str) -> Result<OpenScan, SpoolError> {
+    if bytes.is_empty() {
+        return Ok(OpenScan {
+            meta: OpenMetadata::empty(),
+            epoch: None,
+            max_sequence: 0,
+            event_ids: HashSet::new(),
+            tail_truncated: false,
+        });
+    }
+    let last_lf = bytes.iter().rposition(|byte| *byte == b'\n');
+    let (complete, tail_truncated) = match last_lf {
+        Some(index) if index + 1 < bytes.len() => (&bytes[..=index], true),
+        Some(index) => (&bytes[..=index], false),
+        None => (&[][..], true),
+    };
+    if tail_truncated {
+        // The caller performs the actual truncation after this scan; this
+        // function remains side-effect free for batch validation tests.
+    }
+    let mut meta = OpenMetadata::empty();
+    let mut epoch = None;
+    let mut max_sequence = 0_u64;
+    let mut expected = None;
+    let mut event_ids = HashSet::new();
+    for line in complete.split_inclusive(|byte| *byte == b'\n') {
+        let record = wire::parse_spool_line(line).map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+        let record_epoch = record.spool_epoch.as_str();
+        if let Some(existing) = &epoch {
+            if existing != record_epoch {
+                return Err(SpoolError::InvalidState("open epoch changed".to_owned()));
+            }
+        } else {
+            epoch = Some(record_epoch.to_owned());
+        }
+        let sequence = record.spool_sequence.0;
+        if expected.is_some_and(|value| sequence != value) {
+            return Err(SpoolError::InvalidState("open sequence is not contiguous".to_owned()));
+        }
+        expected = Some(sequence.checked_add(1).ok_or(SpoolError::SequenceExhausted)?);
+        let event = parse_stored_event(record.event_bytes())?;
+        if stored_event_node_id(&event) != node_id || !stored_event_epoch_matches(&event, record_epoch) {
+            return Err(SpoolError::InvalidState("open event node mismatch".to_owned()));
+        }
+        event_ids.insert(event.event_id().to_owned());
+        max_sequence = max_sequence.max(sequence);
+        update_open_metadata(&mut meta, sequence, record.received_at_unix_ms.0, line.len() as u64);
+    }
+    Ok(OpenScan {
+        meta,
+        epoch,
+        max_sequence,
+        event_ids,
+        tail_truncated,
+    })
+}
+
+fn truncate_open(path: &Path, length: usize) -> Result<(), SpoolError> {
+    let file = OpenOptions::new()
+        .write(true)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+        .open(path)?;
+    file.set_len(length as u64)?;
+    file.sync_all()?;
+    if let Some(parent) = path.parent() {
+        sync_dir(parent)?;
+    }
+    Ok(())
+}
+
+fn wrapper_bytes(epoch: &str, sequence: u64, received: u64, event_raw: &[u8]) -> Result<Vec<u8>, SpoolError> {
+    let record = wire::SpoolRecord::from_event_bytes(epoch.to_owned(), sequence, received, event_raw)
+        .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+    record
+        .ndjson_line()
+        .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))
+}
+
+/// Parse an event already persisted in the spool.  Unlike the ingest parser,
+/// this deliberately accepts auditd-generated `spool_gap` records as well as
+/// producer access/diagnostic records.  Treating the internal variant as an
+/// ingest error would make recovery unable to find an existing gap ID and
+/// could generate duplicate state/eviction gaps after a restart.
+fn parse_stored_event(bytes: &[u8]) -> Result<wire::AuditRecord, SpoolError> {
+    wire::parse_canonical_record(bytes).map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))
+}
+
+fn body_contains_spool_gap(body: &[u8]) -> bool {
+    body.split_inclusive(|byte| *byte == b'\n').any(|line| {
+        wire::parse_spool_line(line)
+            .ok()
+            .and_then(|record| parse_stored_event(record.event_bytes()).ok())
+            .is_some_and(|event| matches!(event, wire::AuditRecord::SpoolGap(_)))
+    })
+}
+
+fn stored_event_node_id(event: &wire::AuditRecord) -> &str {
+    match event {
+        wire::AuditRecord::Access(value) => &value.node_id,
+        wire::AuditRecord::ProducerGap(value) => &value.node_id,
+        wire::AuditRecord::UdpWindowContention(value) => &value.node_id,
+        wire::AuditRecord::SpoolGap(value) => &value.node_id,
+    }
+}
+
+fn stored_event_epoch_matches(event: &wire::AuditRecord, wrapper_epoch: &str) -> bool {
+    match event {
+        // Access and producer diagnostics carry a runtime, not a spool epoch;
+        // the wrapper is the authority for those variants.
+        wire::AuditRecord::Access(_)
+        | wire::AuditRecord::ProducerGap(_)
+        | wire::AuditRecord::UdpWindowContention(_) => true,
+        wire::AuditRecord::SpoolGap(value) => value.spool_epoch == wrapper_epoch,
+    }
+}
+
+fn update_open_metadata(meta: &mut OpenMetadata, sequence: u64, received: u64, bytes: u64) {
+    meta.bytes = meta.bytes.saturating_add(bytes);
+    meta.event_count = meta.event_count.saturating_add(1);
+    meta.first_sequence.get_or_insert(sequence);
+    meta.last_sequence = Some(sequence);
+    meta.first_received_at.get_or_insert(received);
+    meta.last_received_at = Some(received);
+}
+
+fn list_batch_dirs(path: &Path) -> Result<Vec<PathBuf>, SpoolError> {
+    let mut result = Vec::new();
+    for entry in fs::read_dir(path)? {
+        let entry = entry?;
+        let file_name = entry.file_name();
+        let file_type = entry.file_type()?;
+        if !file_name.to_string_lossy().starts_with('.') && (file_type.is_dir() || file_type.is_symlink()) {
+            result.push(entry.path());
+        }
+    }
+    Ok(result)
+}
+
+fn list_hidden_dirs(path: &Path) -> Result<Vec<PathBuf>, SpoolError> {
+    let mut result = Vec::new();
+    for entry in fs::read_dir(path)? {
+        let entry = entry?;
+        if entry.file_type()?.is_dir() && entry.file_name().to_string_lossy().starts_with('.') {
+            result.push(entry.path());
+        }
+    }
+    Ok(result)
+}
+
+fn list_entries(path: &Path) -> Result<Vec<PathBuf>, SpoolError> {
+    let mut result = Vec::new();
+    for entry in fs::read_dir(path)? {
+        let entry = entry?;
+        result.push(entry.path());
+    }
+    Ok(result)
+}
+
+fn find_quarantine_entry(root: &Path, basename: &str) -> Option<PathBuf> {
+    let exact = root.join(basename);
+    if fs::symlink_metadata(&exact).is_ok() {
+        return Some(exact);
+    }
+    fs::read_dir(root)
+        .ok()?
+        .filter_map(Result::ok)
+        .map(|entry| entry.path())
+        .find(|path| {
+            path.file_name()
+                .and_then(|value| value.to_str())
+                .is_some_and(|name| name.starts_with(&format!("{basename}-")))
+        })
+}
+
+fn remove_path(path: &Path) -> io::Result<()> {
+    let metadata = fs::symlink_metadata(path)?;
+    if metadata.is_dir() {
+        fs::remove_dir_all(path)
+    } else {
+        fs::remove_file(path)
+    }
+}
+
+fn persist_state(
+    root: &Path,
+    epoch: &str,
+    next_sequence: u64,
+    pending_state_reset: Option<PendingStateReset>,
+) -> Result<(), SpoolError> {
+    let state = wire::SpoolState {
+        state_schema_version: STATE_SCHEMA_VERSION,
+        spool_epoch: epoch.to_owned(),
+        next_spool_sequence: next_sequence.into(),
+        pending_state_reset,
+    };
+    let bytes = state
+        .canonical_bytes()
+        .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+    write_atomic_file(&root.join("state.json"), &bytes, 0o600)
+}
+
+fn load_tombstones(root: &Path) -> Result<Vec<TombstoneEntry>, SpoolError> {
+    let path = root.join("tombstones.json");
+    let bytes = match read_regular_file(&path) {
+        Ok(value) => value,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(Vec::new()),
+        Err(error) => return Err(error.into()),
+    };
+    let ledger =
+        wire::parse_tombstone_ledger(&bytes).map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+    // Existing ledgers may predate the current startup path or have been
+    // restored with broader permissions.  The spool contract keeps every
+    // regular file private, so repair the mode before accepting the ledger.
+    // `read_regular_file` already opened this path with O_NOFOLLOW; reject a
+    // replacement symlink rather than chmodding an attacker-controlled target.
+    let metadata = fs::symlink_metadata(&path)?;
+    if metadata.file_type().is_symlink() || !metadata.is_file() {
+        return Err(SpoolError::InvalidState(
+            "tombstone ledger must be a regular file".to_owned(),
+        ));
+    }
+    set_file_mode(&path, 0o600)?;
+    let mut batches: HashSet<&str> = HashSet::new();
+    let mut gaps: HashSet<&str> = HashSet::new();
+    for entry in &ledger.entries {
+        if let Some(batch_id) = entry.batch_id()
+            && !batches.insert(batch_id)
+        {
+            return Err(SpoolError::InvalidState(
+                "tombstone ledger contains duplicate batch_id".to_owned(),
+            ));
+        }
+        if let Some(gap_id) = entry.gap_event_id()
+            && !gaps.insert(gap_id)
+        {
+            return Err(SpoolError::InvalidState(
+                "tombstone ledger contains duplicate gap_event_id".to_owned(),
+            ));
+        }
+    }
+    Ok(ledger.entries)
+}
+
+fn persist_tombstones(root: &Path, entries: &[TombstoneEntry]) -> Result<(), SpoolError> {
+    let ledger = wire::TombstoneLedger::new(entries.to_vec());
+    let bytes = ledger
+        .canonical_bytes()
+        .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+    write_atomic_file(&root.join("tombstones.json"), &bytes, 0o600)
+}
+
+fn ensure_dir(path: &Path, mode: u32) -> io::Result<()> {
+    // `create_dir_all` follows a symlink introduced below a missing component.
+    // Resolve each component relative to an already-open directory descriptor
+    // and use O_NOFOLLOW for the child. This keeps a concurrent pathname
+    // replacement from redirecting creation or chmod outside the spool tree.
+    if !path.is_absolute() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "spool directory path must be absolute",
+        ));
+    }
+
+    let root_fd = unsafe {
+        // SAFETY: the literal path and flags are valid for the Linux-only
+        // audit daemon; a successful descriptor is owned below.
+        libc::open(
+            b"/\0".as_ptr().cast(),
+            libc::O_RDONLY | libc::O_DIRECTORY | libc::O_CLOEXEC | libc::O_NOFOLLOW,
+        )
+    };
+    if root_fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut parent = unsafe {
+        // SAFETY: root_fd was returned by open above and is transferred to
+        // OwnedFd exactly once.
+        OwnedFd::from_raw_fd(root_fd)
+    };
+    let mut components = path.components().peekable();
+    while let Some(component) = components.next() {
+        let std::path::Component::Normal(name) = component else {
+            if matches!(component, std::path::Component::RootDir) {
+                continue;
+            }
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "spool directory path contains a non-canonical component",
+            ));
+        };
+        let child_name = CString::new(name.as_bytes())
+            .map_err(|_| io::Error::new(io::ErrorKind::InvalidInput, "spool directory component contains NUL"))?;
+        let mut created = false;
+        let child = loop {
+            let child_fd = unsafe {
+                // SAFETY: parent is a live directory descriptor and
+                // child_name is a NUL-terminated path component.
+                libc::openat(
+                    parent.as_raw_fd(),
+                    child_name.as_ptr(),
+                    libc::O_RDONLY | libc::O_DIRECTORY | libc::O_CLOEXEC | libc::O_NOFOLLOW,
+                )
+            };
+            if child_fd >= 0 {
+                break unsafe {
+                    // SAFETY: child_fd was returned by openat and is moved
+                    // into OwnedFd exactly once.
+                    OwnedFd::from_raw_fd(child_fd)
+                };
+            }
+            let error = io::Error::last_os_error();
+            if error.kind() != io::ErrorKind::NotFound {
+                return Err(error);
+            }
+            let result = unsafe {
+                // SAFETY: parent and child_name identify the requested child.
+                libc::mkdirat(parent.as_raw_fd(), child_name.as_ptr(), mode as libc::mode_t)
+            };
+            if result == 0 {
+                created = true;
+                continue;
+            }
+            let mkdir_error = io::Error::last_os_error();
+            if mkdir_error.kind() == io::ErrorKind::AlreadyExists {
+                // A concurrent creator won the race. Retry openat; if it
+                // installed a symlink, O_NOFOLLOW rejects it.
+                continue;
+            }
+            return Err(mkdir_error);
+        };
+
+        // Repair modes only on directories owned by this subsystem. Existing
+        // ancestors such as `/var` and `/tmp` are never rewritten.  The final
+        // component (and any component created by this call) must also remain
+        // owned by the daemon's effective UID/GID.  Checking the open
+        // descriptor avoids accepting a root-owned or group-swapped spool
+        // directory when the daemon itself happens to run as root.
+        if created || components.peek().is_none() {
+            let result = unsafe {
+                // SAFETY: child is an open directory descriptor obtained with
+                // O_NOFOLLOW, so fchmod cannot follow a replacement pathname.
+                libc::fchmod(child.as_raw_fd(), mode as libc::mode_t)
+            };
+            if result != 0 {
+                return Err(io::Error::last_os_error());
+            }
+            validate_private_dir_fd(child.as_raw_fd())?;
+        }
+        parent = child;
+    }
+    Ok(())
+}
+
+fn validate_private_dir_fd(fd: i32) -> io::Result<()> {
+    let mut stat = std::mem::MaybeUninit::<libc::stat>::zeroed();
+    // SAFETY: `fd` is an open directory descriptor owned by this function's
+    // caller and `stat` points to writable storage of the expected type.
+    let result = unsafe { libc::fstat(fd, stat.as_mut_ptr()) };
+    if result != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: fstat initialized `stat` on success.
+    let stat = unsafe { stat.assume_init() };
+    let mode = stat.st_mode as libc::mode_t;
+    if mode & libc::S_IFMT as libc::mode_t != libc::S_IFDIR as libc::mode_t {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "spool component is not a directory",
+        ));
+    }
+    // SAFETY: geteuid/getegid have no preconditions and do not mutate memory.
+    let euid = unsafe { libc::geteuid() };
+    let egid = unsafe { libc::getegid() };
+    if stat.st_uid != euid || stat.st_gid != egid {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "spool directory has an unexpected owner or group",
+        ));
+    }
+    Ok(())
+}
+
+fn validate_private_file_fd(fd: i32) -> io::Result<()> {
+    let mut stat = std::mem::MaybeUninit::<libc::stat>::zeroed();
+    // SAFETY: `fd` is an open regular-file descriptor owned by this function's
+    // caller and `stat` points to writable storage of the expected type.
+    let result = unsafe { libc::fstat(fd, stat.as_mut_ptr()) };
+    if result != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: fstat initialized `stat` on success.
+    let stat = unsafe { stat.assume_init() };
+    let mode = stat.st_mode as libc::mode_t;
+    if mode & libc::S_IFMT as libc::mode_t != libc::S_IFREG as libc::mode_t {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "spool object is not a regular file",
+        ));
+    }
+    // SAFETY: geteuid/getegid have no preconditions and do not mutate memory.
+    let euid = unsafe { libc::geteuid() };
+    let egid = unsafe { libc::getegid() };
+    if stat.st_uid != euid || stat.st_gid != egid {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "spool file has an unexpected owner or group",
+        ));
+    }
+    Ok(())
+}
+
+fn set_file_mode(path: &Path, mode: u32) -> io::Result<()> {
+    fs::set_permissions(path, fs::Permissions::from_mode(mode))
+}
+
+fn write_atomic_file(path: &Path, bytes: &[u8], mode: u32) -> Result<(), SpoolError> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| SpoolError::InvalidState("file has no parent".to_owned()))?;
+    let name = path
+        .file_name()
+        .and_then(|value| value.to_str())
+        .ok_or_else(|| SpoolError::InvalidState("invalid file name".to_owned()))?;
+    let temp = parent.join(format!(".{name}.tmp-{}-{}", std::process::id(), unix_nanos()));
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+        .mode(mode)
+        .open(&temp)?;
+    if let Err(error) = file.write_all(bytes).and_then(|_| file.sync_all()) {
+        let _ = fs::remove_file(&temp);
+        return Err(error.into());
+    }
+    drop(file);
+    if let Err(error) = fs::rename(&temp, path) {
+        let _ = fs::remove_file(&temp);
+        return Err(error.into());
+    }
+    // The renamed inode was created with the requested private mode.  Do not
+    // chmod the destination by pathname here: a privileged actor replacing
+    // the path between rename and chmod could make that operation follow a
+    // symlink outside the spool tree.
+    sync_dir(parent)?;
+    Ok(())
+}
+
+fn read_regular_file(path: &Path) -> io::Result<Vec<u8>> {
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+        .open(path)?;
+    let metadata = file.metadata()?;
+    if !metadata.is_file() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "spool object must be a regular file",
+        ));
+    }
+    // All spool files are sensitive plaintext.  Repair only the mode on the
+    // descriptor we opened, then reject an inode owned by another UID/GID.
+    file.set_permissions(fs::Permissions::from_mode(0o600))?;
+    validate_private_file_fd(file.as_raw_fd())?;
+    if metadata.len() > MAX_SPOOL_FILE_BYTES as u64 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "spool object exceeds the recovery read limit",
+        ));
+    }
+    // The metadata length is only a hint: a concurrent writer/replacement can
+    // grow the file after the stat.  Read one sentinel byte beyond the hard
+    // limit so the actual allocation and acceptance remain bounded.
+    let sentinel_limit = (MAX_SPOOL_FILE_BYTES as u64).saturating_add(1);
+    let capacity = usize::try_from(metadata.len())
+        .unwrap_or(MAX_SPOOL_FILE_BYTES)
+        .min(MAX_SPOOL_FILE_BYTES.saturating_add(1));
+    let mut bytes = Vec::with_capacity(capacity);
+    file.take(sentinel_limit).read_to_end(&mut bytes)?;
+    if bytes.len() > MAX_SPOOL_FILE_BYTES {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "spool object exceeds the recovery read limit",
+        ));
+    }
+    Ok(bytes)
+}
+
+fn quarantine_path(root: &Path, path: &Path, label: &str) -> Result<PathBuf, SpoolError> {
+    match fs::symlink_metadata(path) {
+        Ok(_) => {}
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {
+            return Ok(root.join("quarantine").join("missing"));
+        }
+        Err(error) => return Err(error.into()),
+    }
+    let original = path
+        .file_name()
+        .and_then(|value| value.to_str())
+        .ok_or_else(|| SpoolError::InvalidState("invalid path basename".to_owned()))?;
+    let target = root
+        .join("quarantine")
+        .join(format!("{label}-{}-{original}", unix_nanos()));
+    fs::rename(path, &target)?;
+    if let Some(parent) = path.parent() {
+        sync_dir(parent)?;
+    }
+    sync_dir(&root.join("quarantine"))?;
+    Ok(target)
+}
+
+fn sync_dir(path: &Path) -> io::Result<()> {
+    File::open(path)?.sync_all()
+}
+
+fn directory_size(path: &Path) -> io::Result<u64> {
+    let metadata = fs::symlink_metadata(path)?;
+    if metadata.is_file() {
+        return Ok(metadata.len());
+    }
+    if !metadata.is_dir() {
+        return Ok(0);
+    }
+    let mut total = 0_u64;
+    for entry in fs::read_dir(path)? {
+        total = total.saturating_add(directory_size(&entry?.path())?);
+    }
+    Ok(total)
+}
+
+fn free_space_ok(path: &Path, minimum: u64) -> bool {
+    let text = match path.to_str() {
+        Some(value) => std::ffi::CString::new(value).ok(),
+        None => None,
+    };
+    let Some(text) = text else { return false };
+    let mut stat = std::mem::MaybeUninit::<libc::statvfs>::uninit();
+    // SAFETY: the C string is NUL terminated and `stat` points to writable
+    // storage owned by this stack frame.
+    let result = unsafe { libc::statvfs(text.as_ptr(), stat.as_mut_ptr()) };
+    if result != 0 {
+        return false;
+    }
+    // SAFETY: statvfs initialized on a successful call.
+    let stat = unsafe { stat.assume_init() };
+    (stat.f_bavail as u128).saturating_mul(stat.f_frsize as u128) >= minimum as u128
+}
+
+fn acked_timestamp(path: &Path) -> Option<u64> {
+    path.file_name()
+        .and_then(|value| value.to_str())
+        .and_then(|value| value.split_once('-').map(|(prefix, _)| prefix))
+        .and_then(|value| value.parse::<u64>().ok())
+}
+
+fn path_age_key(path: &Path) -> u128 {
+    fs::metadata(path)
+        .and_then(|metadata| metadata.modified())
+        .ok()
+        .and_then(|time| time.duration_since(UNIX_EPOCH).ok())
+        .map(|duration| duration.as_nanos())
+        .unwrap_or(u128::MAX)
+}
+
+fn random_hex_id() -> Result<String, SpoolError> {
+    let mut bytes = [0_u8; 16];
+    let mut source = File::open("/dev/urandom")?;
+    source.read_exact(&mut bytes)?;
+    Ok(hex::encode(bytes))
+}
+
+fn digest_hex(bytes: &[u8]) -> String {
+    hex::encode(Sha256::digest(bytes))
+}
+
+fn unix_millis() -> Result<u64, SpoolError> {
+    let duration = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_err(|_| SpoolError::StorageUnavailable)?;
+    duration
+        .as_millis()
+        .try_into()
+        .map_err(|_| SpoolError::StorageUnavailable)
+}
+
+fn unix_nanos() -> u128 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|value| value.as_nanos())
+        .unwrap_or(0)
+}
+
+fn unix_seconds() -> Result<u64, SpoolError> {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|value| value.as_secs())
+        .map_err(|_| SpoolError::StorageUnavailable)
+}
+
+fn saturating_inc(value: u64) -> u64 {
+    value.saturating_add(1)
+}
+
+fn is_hex(value: &str, length: usize) -> bool {
+    value.len() == length
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+fn event_id_exists_in_epoch(root: &Path, event_id: &str, epoch: &str) -> Result<bool, SpoolError> {
+    let scan = |bytes: &[u8]| -> bool {
+        for line in bytes.split_inclusive(|byte| *byte == b'\n') {
+            if let Ok(record) = wire::parse_spool_line(line)
+                && record.spool_epoch == epoch
+                && parse_stored_event(record.event_bytes())
+                    .ok()
+                    .is_some_and(|event| event.event_id() == event_id)
+            {
+                return true;
+            }
+        }
+        false
+    };
+    let open = root.join("open/current.ndjson");
+    if let Ok(bytes) = read_regular_file(&open) {
+        if scan(&bytes) {
+            return Ok(true);
+        }
+    }
+    for parent_name in ["sealed", "acked"] {
+        for path in list_batch_dirs(&root.join(parent_name))? {
+            if fs::symlink_metadata(&path)
+                .map(|metadata| metadata.file_type().is_symlink())
+                .unwrap_or(false)
+            {
+                continue;
+            }
+            let Ok(body) = read_regular_file(&path.join("segment.ndjson")) else {
+                continue;
+            };
+            if scan(&body) {
+                return Ok(true);
+            }
+        }
+    }
+    Ok(false)
+}
+
+fn lock<'a, T>(mutex: &'a Mutex<T>) -> MutexGuard<'a, T> {
+    match mutex.lock() {
+        Ok(guard) => guard,
+        Err(poisoned) => poisoned.into_inner(),
+    }
+}
