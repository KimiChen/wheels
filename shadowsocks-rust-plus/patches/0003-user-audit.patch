+
+    #[test]
+    fn load_from_file_reaches_strict_parser_when_metadata_is_valid() {
+        // `load_from_file` layers two independent contracts: the §11 path/metadata
+        // gate, and the strict parser.  The gate walks *every* ancestor and
+        // rejects any that is group/other-writable, so a tempdir under a stock
+        // 1777 /tmp can never reach the parser no matter what mode the test sets
+        // on the directory it owns.  Assert each contract where it is reachable
+        // instead of depending on the ambient TMPDIR.
+        let dir = tempfile::tempdir().expect("tempdir");
+        let path = dir.path().join("auditd.json");
+        let json = serde_json::to_string(&AuditdConfig::default()).expect("serialize");
+
+        // 1. The metadata gate refuses before parsing, and says why.
+        fs::write(&path, format!("{json} {{}}")).expect("config");
+        fs::set_permissions(&path, fs::Permissions::from_mode(CONFIG_FILE_MODE)).expect("mode");
+        let error = AuditdConfig::load_from_file(&path).expect_err("metadata gate");
+        assert!(
+            matches!(error, ConfigError::InvalidPath(_)),
+            "expected the §11 path gate to refuse first, got {error:?}"
+        );
+
+        // 2. The strict parser itself rejects trailing data and unknown fields.
+        let error = parse_config_bytes(format!("{json} {{}}").as_bytes()).expect_err("trailing JSON");
+        assert!(matches!(error, ConfigError::Json(_) | ConfigError::Invalid(_)));
+
+        let mut unknown = json.trim_end_matches('}').to_owned();
+        unknown.push_str(",\"unknown\":true}");
+        let error = parse_config_bytes(unknown.as_bytes()).expect_err("unknown field");
+        assert!(matches!(error, ConfigError::Json(_) | ConfigError::Invalid(_)));
+    }
