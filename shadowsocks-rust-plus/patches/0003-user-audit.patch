+        let server = tokio::spawn(async move {
+            let (stream, _) = listener.accept().await.expect("accept");
+            let (mut reader, mut writer) = stream.into_split();
+            let _ = read_frame(&mut reader).await.expect("hello");
+            let hello_ack = serialize_canonical(&HelloAck::new()).expect("hello ack");
+            write_frame(&mut writer, &hello_ack).await.expect("write hello ack");
+            let event_bytes = read_frame(&mut reader).await.expect("event");
+            let record = parse_canonical_record(&event_bytes).expect("event");
+            let nack = EventNack::new(record.event_id(), EventNackCode::EventIdConflict);
+            let nack = serialize_canonical(&nack).expect("nack");
+            write_frame(&mut writer, &nack).await.expect("write nack");
