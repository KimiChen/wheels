+/* Convenience strict parsers for wire DTOs                                 */
+
+pub fn parse_hello(bytes: &[u8]) -> Result<Hello, ProtocolError> {
+    let value: Hello = parse_canonical(bytes)?;
+    value.validate()?;
+    Ok(value)
+}
+
+pub fn parse_hello_ack(bytes: &[u8]) -> Result<HelloAck, ProtocolError> {
+    let value: HelloAck = parse_canonical(bytes)?;
