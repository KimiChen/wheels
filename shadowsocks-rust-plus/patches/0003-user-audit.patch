+/// Long-lived audit daemon. The two socket servers share one spool and health state.
+pub struct AuditDaemon {
+    config: Arc<AuditdConfig>,
+    spool: Arc<Spool>,
+    // Keep the process-wide export lock from construction through the entire
+    // daemon lifetime.  In particular, Spool::open must never run while a
+    // second daemon is still able to initialize the same spool directory.
+    socket_lock: SocketLock,
+}
+
+impl AuditDaemon {
+    pub fn new(config: AuditdConfig) -> Result<Self, ConfigError> {
+        config.validate_runtime()?;
+        // Acquire before opening/recovering the spool.  Two daemons can
+        // otherwise race in Spool::open and mutate the same ledger before
+        // either one reaches ExportServer::new in run().
+        let socket_lock = SocketLock::acquire(&config.export_socket_path).map_err(ConfigError::Io)?;
+        socket_lock.verify().map_err(ConfigError::Io)?;
+        let config = Arc::new(config);
+        let spool = Arc::new(Spool::open(config.clone()).map_err(ConfigError::Spool)?);
+        Ok(Self {
+            config,
+            spool,
+            socket_lock,
+        })
+    }
+
+    pub fn config(&self) -> &AuditdConfig {
+        &self.config
+    }
+
+    pub fn spool(&self) -> Arc<Spool> {
+        self.spool.clone()
+    }
+
+    /// Run until SIGTERM/SIGINT or a socket task fails.
+    pub async fn run(self) -> io::Result<()> {
+        let Self {
+            config,
+            spool,
+            socket_lock,
+        } = self;
+        let (shutdown_tx, shutdown_rx) = watch::channel(false);
+        // The lock was acquired in AuditDaemon::new, before Spool::open.  Move
+        // that same guard into ExportServer so it remains held until the
+        // listener inode guard has cleaned up on shutdown.
+        let export = ExportServer::new_with_lock(config.clone(), spool.clone(), shutdown_rx.clone(), socket_lock)
+            .await
+            .map_err(io::Error::other)?;
+        let ingest = IngestServer::new(config.clone(), spool.clone(), shutdown_rx.clone())
+            .await
+            .map_err(io::Error::other)?;
+
+        let mut ingest_task = tokio::spawn(ingest.run());
+        let mut export_task = tokio::spawn(export.run());
+
+        let signal_result = async {
+            #[cfg(unix)]
+            {
+                let mut term = signal::unix::signal(signal::unix::SignalKind::terminate()).map_err(io::Error::other)?;
+                let mut interrupt =
+                    signal::unix::signal(signal::unix::SignalKind::interrupt()).map_err(io::Error::other)?;
+                select! {
+                    _ = term.recv() => Ok::<(), io::Error>(()),
+                    _ = interrupt.recv() => Ok::<(), io::Error>(()),
+                }
+            }
+            #[cfg(not(unix))]
+            {
+                signal::ctrl_c().await.map_err(io::Error::other)
+            }
+        };
+
+        select! {
+            result = signal_result => {
+                let _ = shutdown_tx.send(true);
+                let _ = ingest_task.await;
+                let _ = export_task.await;
+                result
+            }
+            result = &mut ingest_task => {
+                let _ = shutdown_tx.send(true);
+                let _ = export_task.await;
+                result.map_err(io::Error::other)?.map_err(io::Error::other)
+            }
+            result = &mut export_task => {
+                let _ = shutdown_tx.send(true);
+                let _ = ingest_task.await;
+                result.map_err(io::Error::other)?.map_err(io::Error::other)
+            }
+        }
+    }
+}
