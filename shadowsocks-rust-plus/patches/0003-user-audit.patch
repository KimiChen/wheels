+
+impl<'de> Deserialize<'de> for AuditRecord {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
+        D: Deserializer<'de>,
+    {
+        let value = Value::deserialize(deserializer)?;
+        record_from_value(value).map_err(de::Error::custom)
+    }
+}
+
+fn record_from_value(value: Value) -> Result<AuditRecord, ProtocolError> {
+    let object = value
+        .as_object()
+        .ok_or_else(|| invalid("record", "must be a JSON object"))?;
+    let event_type = object
+        .get("event_type")
+        .and_then(Value::as_str)
+        .ok_or_else(|| invalid("event_type", "must be present as a string"))?;
+    let record = match event_type {
+        "tcp_target_success" | "udp_target_success" => {
+            let is_udp = event_type == "udp_target_success";
+            // `Option<T>` in a derived serde struct treats an omitted member as
+            // `None`.  The wire contract distinguishes a required nullable
+            // member from an omitted member, so check presence before typed
+            // deserialization.  This also makes the variant field set
+            // explicit at the trust boundary.
+            require_keys(
+                object,
+                &[
+                    "schema_version",
+                    "record_type",
+                    "event_type",
+                    "event_id",
+                    "audit_sequence",
+                    "occurred_at_unix_ms",
+                    "runtime_monotonic_ms",
+                    "node_id",
+                    "runtime_id",
+                    "server_id",
+                    "server_generation",
+                    "identity_kind",
+                    "identity_name",
+                    "identity_generation",
+                    "transport",
+                    "target",
+                    "success_evidence",
+                ],
+            )?;
+            let target = object
+                .get("target")
+                .and_then(Value::as_object)
+                .ok_or_else(|| invalid("target", "must be a JSON object"))?;
+            require_keys(target, &["kind", "host", "normalized_host", "port", "remote_ip"])?;
+            if is_udp {
+                require_keys(object, &["association_id"])?;
+            }
+            if is_udp != object.contains_key("association_id") {
+                return Err(invalid(
+                    "association_id",
+                    if is_udp {
+                        "required on UDP events"
+                    } else {
+                        "forbidden on TCP events"
+                    },
+                ));
+            }
+            AuditRecord::Access(serde_json::from_value(value).map_err(|error| ProtocolError::Json(error.to_string()))?)
+        }
+        "producer_gap" => {
+            require_keys(
+                object,
+                &[
+                    "schema_version",
+                    "record_type",
+                    "event_type",
+                    "event_id",
+                    "audit_sequence",
+                    "occurred_at_unix_ms",
+                    "node_id",
+                    "runtime_id",
+                    "reason",
+                    "permanent_nack_code",
+                    "dropped_events",
+                    "first_dropped_sequence",
+                    "last_dropped_sequence",
+                    "first_seen_unix_ms",
+                    "last_seen_unix_ms",
+                ],
+            )?;
+            AuditRecord::ProducerGap(
+                serde_json::from_value(value).map_err(|error| ProtocolError::Json(error.to_string()))?,
+            )
+        }
+        "udp_window_contention" => {
+            require_keys(
+                object,
+                &[
+                    "schema_version",
+                    "record_type",
+                    "event_type",
+                    "event_id",
+                    "audit_sequence",
+                    "occurred_at_unix_ms",
+                    "node_id",
+                    "runtime_id",
+                    "skipped_successful_datagrams",
+                    "first_seen_unix_ms",
+                    "last_seen_unix_ms",
+                ],
+            )?;
+            AuditRecord::UdpWindowContention(
+                serde_json::from_value(value).map_err(|error| ProtocolError::Json(error.to_string()))?,
+            )
+        }
+        "spool_gap" => {
+            require_keys(
+                object,
+                &[
+                    "schema_version",
+                    "record_type",
+                    "event_type",
+                    "event_id",
+                    "occurred_at_unix_ms",
+                    "node_id",
+                    "spool_epoch",
+                    "lost_spool_epoch",
+                    "reason",
+                    "first_lost_spool_sequence",
+                    "last_lost_spool_sequence",
+                    "lost_events",
+                    "lost_bytes",
+                    "lost_batch_id",
+                ],
+            )?;
+            AuditRecord::SpoolGap(
+                serde_json::from_value(value).map_err(|error| ProtocolError::Json(error.to_string()))?,
+            )
+        }
+        other => return Err(ProtocolError::UnknownEventType(other.to_owned())),
+    };
+    record.validate()?;
+    Ok(record)
+}
+
+fn require_keys(object: &serde_json::Map<String, Value>, keys: &[&str]) -> Result<(), ProtocolError> {
+    for key in keys {
+        if !object.contains_key(*key) {
+            return Err(invalid(*key, "field is required"));
+        }
+    }
+    Ok(())
+}
+
+pub fn parse_record(bytes: &[u8]) -> Result<AuditRecord, ProtocolError> {
+    if bytes.is_empty() {
+        return Err(ProtocolError::Json("empty JSON payload".to_owned()));
+    }
+    if bytes.len() > MAX_EVENT_JSON_BYTES {
+        return Err(ProtocolError::FrameTooLarge {
+            actual: bytes.len(),
+            limit: MAX_EVENT_JSON_BYTES,
+        });
+    }
+    if bytes.iter().any(|byte| *byte == b'\r' || *byte == b'\n') {
+        return Err(ProtocolError::RawLineBreak);
+    }
+    check_duplicate_keys(bytes)?;
+    let value: Value = serde_json::from_slice(bytes).map_err(|error| ProtocolError::Json(error.to_string()))?;
+    record_from_value(value)
+}
+
+pub fn parse_canonical_record(bytes: &[u8]) -> Result<AuditRecord, ProtocolError> {
+    if bytes.len() > MAX_EVENT_JSON_BYTES {
+        return Err(ProtocolError::FrameTooLarge {
+            actual: bytes.len(),
+            limit: MAX_EVENT_JSON_BYTES,
+        });
+    }
+    if bytes.iter().any(|byte| *byte == b'\r' || *byte == b'\n') {
+        return Err(ProtocolError::RawLineBreak);
+    }
+    let record = parse_record(bytes)?;
+    if serialize_canonical_record(&record)? != bytes {
+        return Err(ProtocolError::NonCanonical);
+    }
+    Ok(record)
+}
+
+pub fn serialize_canonical_record(record: &AuditRecord) -> Result<Vec<u8>, ProtocolError> {
+    record.validate()?;
+    let bytes = serialize_canonical(record)?;
+    if bytes.len() > MAX_EVENT_JSON_BYTES {
+        return Err(ProtocolError::FrameTooLarge {
+            actual: bytes.len(),
+            limit: MAX_EVENT_JSON_BYTES,
+        });
+    }
+    Ok(bytes)
+}
+
+pub fn to_canonical_json(record: &AuditRecord) -> Result<Vec<u8>, ProtocolError> {
+    serialize_canonical_record(record)
+}
+
+/// Stable, short aliases used by producer/auditd integrations.
+pub fn serialize_event(record: &AuditRecord) -> Result<Vec<u8>, ProtocolError> {
+    serialize_canonical_record(record)
+}
+
+pub fn parse_event(bytes: &[u8]) -> Result<AuditRecord, ProtocolError> {
+    parse_canonical_record(bytes)
+}
+
+pub fn parse_canonical_event(bytes: &[u8]) -> Result<AuditRecord, ProtocolError> {
+    parse_canonical_record(bytes)
+}
+
+pub fn canonical_json(record: &AuditRecord) -> Result<String, ProtocolError> {
+    String::from_utf8(serialize_canonical_record(record)?)
+        .map_err(|_| invalid("record", "serializer returned non-UTF-8"))
+}
+
+/* ------------------------------------------------------------------------- */
+/* Spool wrapper and durable metadata DTOs                                   */
+
+/// One line in an auditd NDJSON segment.
+///
+/// The event is held as [`RawValue`] deliberately: reserializing a parsed
+/// `serde_json::Value` could change escaping or member order and would break
+/// the payload digest contract.  Call [`SpoolRecord::from_event_bytes`] when
+/// accepting producer bytes so the exact canonical event text is retained.
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SpoolRecord {
+    pub spool_schema_version: u8,
+    pub spool_epoch: String,
+    pub spool_sequence: DecimalU64,
+    pub received_at_unix_ms: DecimalU64,
+    pub event_payload_sha256: String,
+    pub event: Box<RawValue>,
+}
+
+impl PartialEq for SpoolRecord {
+    fn eq(&self, other: &Self) -> bool {
+        self.spool_schema_version == other.spool_schema_version
+            && self.spool_epoch == other.spool_epoch
+            && self.spool_sequence == other.spool_sequence
+            && self.received_at_unix_ms == other.received_at_unix_ms
+            && self.event_payload_sha256 == other.event_payload_sha256
+            && self.event.get() == other.event.get()
+    }
+}
+
+impl Eq for SpoolRecord {}
+
+impl SpoolRecord {
+    pub fn from_event(
+        spool_epoch: impl Into<String>,
+        spool_sequence: u64,
+        received_at_unix_ms: u64,
+        event: &AuditRecord,
+    ) -> Result<Self, ProtocolError> {
+        let bytes = serialize_canonical_record(event)?;
+        Self::from_event_bytes(spool_epoch, spool_sequence, received_at_unix_ms, &bytes)
+    }
+
+    pub fn from_event_bytes(
+        spool_epoch: impl Into<String>,
+        spool_sequence: u64,
+        received_at_unix_ms: u64,
+        event_bytes: &[u8],
+    ) -> Result<Self, ProtocolError> {
+        // Parse and re-serialize only for validation.  The original bytes are
+        // placed in RawValue below, preserving their exact representation.
+        parse_canonical_record(event_bytes)?;
+        let event_text = std::str::from_utf8(event_bytes).map_err(|_| invalid("event", "must be valid UTF-8 JSON"))?;
+        let event =
+            RawValue::from_string(event_text.to_owned()).map_err(|error| ProtocolError::Json(error.to_string()))?;
+        let record = Self {
+            spool_schema_version: 1,
+            spool_epoch: spool_epoch.into(),
+            spool_sequence: spool_sequence.into(),
+            received_at_unix_ms: received_at_unix_ms.into(),
+            event_payload_sha256: sha256_hex(event_bytes),
+            event,
+        };
+        record.validate()?;
+        Ok(record)
+    }
+
+    pub fn event_bytes(&self) -> &[u8] {
+        self.event.get().as_bytes()
+    }
+
+    pub fn event_record(&self) -> Result<AuditRecord, ProtocolError> {
+        parse_canonical_record(self.event_bytes())
+    }
+
+    pub fn validate(&self) -> Result<(), ProtocolError> {
+        if self.spool_schema_version != 1 {
+            return Err(invalid("spool_schema_version", "unsupported spool schema version"));
+        }
+        validate_lower_hex(&self.spool_epoch, 16, "spool_epoch")?;
+        if self.spool_sequence.0 == 0 {
+            return Err(invalid("spool_sequence", "must be positive"));
+        }
+        validate_lower_hex(&self.event_payload_sha256, 32, "event_payload_sha256")?;
+        let bytes = self.event_bytes();
+        if bytes.len() > MAX_EVENT_JSON_BYTES {
+            return Err(ProtocolError::FrameTooLarge {
+                actual: bytes.len(),
+                limit: MAX_EVENT_JSON_BYTES,
+            });
+        }
+        if sha256_hex(bytes) != self.event_payload_sha256 {
+            return Err(invalid("event_payload_sha256", "does not match raw event bytes"));
+        }
+        parse_canonical_record(bytes)?;
+        Ok(())
+    }
+
+    pub fn canonical_bytes(&self) -> Result<Vec<u8>, ProtocolError> {
+        self.validate()?;
+        let bytes = serialize_canonical(self)?;
+        if bytes.len() > MAX_SPOOL_RECORD_BYTES {
+            return Err(ProtocolError::FrameTooLarge {
+                actual: bytes.len(),
+                limit: MAX_SPOOL_RECORD_BYTES,
+            });
+        }
+        Ok(bytes)
+    }
+
+    pub fn ndjson_line(&self) -> Result<Vec<u8>, ProtocolError> {
+        let mut bytes = self.canonical_bytes()?;
+        bytes.push(b'\n');
+        Ok(bytes)
+    }
+}
+
+pub fn parse_spool_record(bytes: &[u8]) -> Result<SpoolRecord, ProtocolError> {
+    let value: SpoolRecord = parse_canonical(bytes)?;
+    value.validate()?;
+    Ok(value)
+}
+
+pub fn parse_spool_line(line: &[u8]) -> Result<SpoolRecord, ProtocolError> {
+    if line.last().copied() != Some(b'\n') {
+        return Err(ProtocolError::InvalidFrame("spool line must end with LF".to_owned()));
+    }
+    if line.len() == 1 {
+        return Err(ProtocolError::InvalidFrame("empty spool line".to_owned()));
+    }
+    parse_spool_record(&line[..line.len() - 1])
+}
+
+/// Sealed segment metadata (`meta.json`).
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SpoolMeta {
+    pub meta_schema_version: u8,
+    pub node_id: String,
+    pub spool_epoch: String,
+    pub batch_id: String,
+    pub first_spool_sequence: DecimalU64,
+    pub last_spool_sequence: DecimalU64,
+    pub event_count: DecimalU64,
+    pub raw_bytes: DecimalU64,
+    pub body_sha256: String,
+    pub first_received_at_unix_ms: DecimalU64,
+    pub last_received_at_unix_ms: DecimalU64,
+}
+
+pub type SegmentMetadata = SpoolMeta;
+pub type BatchMetadata = SpoolMeta;
+
+impl SpoolMeta {
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        node_id: impl Into<String>,
+        spool_epoch: impl Into<String>,
+        batch_id: impl Into<String>,
+        first_spool_sequence: u64,
+        last_spool_sequence: u64,
+        event_count: u64,
+        raw_bytes: u64,
+        body_sha256: impl Into<String>,
+        first_received_at_unix_ms: u64,
+        last_received_at_unix_ms: u64,
+    ) -> Self {
+        Self {
+            meta_schema_version: 1,
+            node_id: node_id.into(),
+            spool_epoch: spool_epoch.into(),
+            batch_id: batch_id.into(),
+            first_spool_sequence: first_spool_sequence.into(),
+            last_spool_sequence: last_spool_sequence.into(),
+            event_count: event_count.into(),
+            raw_bytes: raw_bytes.into(),
+            body_sha256: body_sha256.into(),
+            first_received_at_unix_ms: first_received_at_unix_ms.into(),
+            last_received_at_unix_ms: last_received_at_unix_ms.into(),
+        }
+    }
+
+    pub fn validate(&self) -> Result<(), ProtocolError> {
+        if self.meta_schema_version != 1 {
+            return Err(invalid("meta_schema_version", "unsupported metadata schema version"));
+        }
+        validate_identifier(&self.node_id, "node_id")?;
+        validate_lower_hex(&self.spool_epoch, 16, "spool_epoch")?;
+        validate_lower_hex(&self.batch_id, 16, "batch_id")?;
+        validate_lower_hex(&self.body_sha256, 32, "body_sha256")?;
+        if self.first_spool_sequence.0 == 0 || self.last_spool_sequence.0 < self.first_spool_sequence.0 {
+            return Err(invalid("spool sequence", "must satisfy 0 < first <= last"));
+        }
+        if self.event_count.0 == 0 {
+            return Err(invalid("event_count", "must be positive"));
+        }
+        let expected_count = self
+            .last_spool_sequence
+            .0
+            .checked_sub(self.first_spool_sequence.0)
+            .and_then(|value| value.checked_add(1))
+            .ok_or_else(|| invalid("event_count", "sequence range overflows u64"))?;
+        if self.event_count.0 != expected_count {
+            return Err(invalid(
+                "event_count",
+                "must equal last_spool_sequence - first_spool_sequence + 1",
+            ));
+        }
+        if self.raw_bytes.0 == 0 {
+            return Err(invalid("raw_bytes", "must be positive"));
+        }
+        if self.first_received_at_unix_ms.0 > self.last_received_at_unix_ms.0 {
+            return Err(invalid("received time", "first must not exceed last"));
+        }
+        Ok(())
+    }
+
+    pub fn canonical_bytes(&self) -> Result<Vec<u8>, ProtocolError> {
+        self.validate()?;
+        serialize_canonical(self)
+    }
+}
+
+pub fn parse_spool_meta(bytes: &[u8]) -> Result<SpoolMeta, ProtocolError> {
+    let value: SpoolMeta = parse_canonical(bytes)?;
+    value.validate()?;
+    Ok(value)
+}
+
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct StateReset {
+    pub gap_event_id: String,
+    pub occurred_at_unix_ms: DecimalU64,
+    pub lost_spool_epoch: Option<String>,
+    pub first_lost_spool_sequence: Option<DecimalU64>,
+    pub last_lost_spool_sequence: Option<DecimalU64>,
+}
+
+impl StateReset {
+    pub fn validate(&self) -> Result<(), ProtocolError> {
+        if !self.gap_event_id.starts_with("spool:") {
+            return Err(invalid("gap_event_id", "must start with `spool:`"));
+        }
+        validate_lower_hex(&self.gap_event_id[6..], 16, "gap_event_id")?;
+        if let Some(epoch) = &self.lost_spool_epoch {
+            validate_lower_hex(epoch, 16, "lost_spool_epoch")?;
+        }
+        if self.first_lost_spool_sequence.is_some() != self.last_lost_spool_sequence.is_some() {
+            return Err(invalid(
+                "lost sequence",
+                "first and last must both be present or both be null",
+            ));
+        }
+        if let (Some(first), Some(last)) = (self.first_lost_spool_sequence, self.last_lost_spool_sequence)
+            && (first.0 == 0 || last.0 < first.0)
+        {
+            return Err(invalid("lost sequence", "must satisfy 0 < first <= last"));
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SpoolState {
+    pub state_schema_version: u8,
+    pub spool_epoch: String,
+    pub next_spool_sequence: DecimalU64,
+    pub pending_state_reset: Option<StateReset>,
+}
+
+impl SpoolState {
+    pub fn validate(&self) -> Result<(), ProtocolError> {
+        if self.state_schema_version != 1 {
+            return Err(invalid("state_schema_version", "unsupported state schema version"));
+        }
+        validate_lower_hex(&self.spool_epoch, 16, "spool_epoch")?;
+        if self.next_spool_sequence.0 == 0 {
+            return Err(invalid("next_spool_sequence", "must be positive"));
+        }
+        if let Some(reset) = &self.pending_state_reset {
+            reset.validate()?;
+        }
+        Ok(())
+    }
+
+    pub fn canonical_bytes(&self) -> Result<Vec<u8>, ProtocolError> {
+        self.validate()?;
+        serialize_canonical(self)
+    }
+}
+
+pub fn parse_spool_state(bytes: &[u8]) -> Result<SpoolState, ProtocolError> {
+    // The pending reset object has nullable-but-required members.  Validate
+    // presence before serde turns omitted `Option`s into `None`.
+    check_duplicate_keys(bytes)?;
+    let raw: Value = serde_json::from_slice(bytes).map_err(|error| ProtocolError::Json(error.to_string()))?;
+    let object = raw
+        .as_object()
+        .ok_or_else(|| invalid("state", "must be a JSON object"))?;
+    require_keys(
+        object,
+        &[
+            "state_schema_version",
+            "spool_epoch",
+            "next_spool_sequence",
+            "pending_state_reset",
+        ],
+    )?;
+    if let Some(pending) = object.get("pending_state_reset")
+        && !pending.is_null()
+    {
+        let pending = pending
+            .as_object()
+            .ok_or_else(|| invalid("pending_state_reset", "must be an object or null"))?;
+        require_keys(
+            pending,
+            &[
+                "gap_event_id",
+                "occurred_at_unix_ms",
+                "lost_spool_epoch",
+                "first_lost_spool_sequence",
+                "last_lost_spool_sequence",
+            ],
+        )?;
+    }
+    let value: SpoolState = parse_canonical(bytes)?;
+    value.validate()?;
+    Ok(value)
+}
