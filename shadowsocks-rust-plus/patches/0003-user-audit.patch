+impl ProducerGap {
+    pub fn validate(&self) -> Result<(), ProtocolError> {
+        validate_schema(self.schema_version)?;
+        if self.record_type != "diagnostic" || self.event_type != "producer_gap" {
+            return Err(invalid("record_type/event_type", "invalid producer gap discriminator"));
+        }
+        validate_lower_hex(&self.runtime_id, 16, "runtime_id")?;
+        validate_identifier(&self.node_id, "node_id")?;
+        if self.audit_sequence.0 == 0 || self.dropped_events.0 == 0 {
+            return Err(invalid("producer_gap", "sequence and dropped_events must be positive"));
+        }
+        if self.event_id != format!("{}:{}", self.runtime_id, self.audit_sequence.0) {
+            return Err(invalid("event_id", "must equal runtime_id: audit_sequence"));
+        }
+        if self.first_seen_unix_ms.0 > self.last_seen_unix_ms.0 || self.last_seen_unix_ms.0 > self.occurred_at_unix_ms.0
+        {
+            return Err(invalid(
+                "producer_gap",
+                "first_seen <= last_seen <= occurred_at is required",
+            ));
+        }
+        match self.reason {
+            ProducerGapReason::PermanentNack => {
+                if self.permanent_nack_code.is_none() {
+                    return Err(invalid("permanent_nack_code", "required for permanent_nack"));
+                }
+            }
+            ProducerGapReason::QueueOverflow | ProducerGapReason::EncodeError => {
+                if self.permanent_nack_code.is_some() {
+                    return Err(invalid("permanent_nack_code", "must be null for this reason"));
+                }
+            }
+        }
+        if self.first_dropped_sequence.is_some() != self.last_dropped_sequence.is_some() {
+            return Err(invalid(
+                "first_dropped_sequence/last_dropped_sequence",
+                "must both be values or both be null",
+            ));
+        }
+        if let (Some(first), Some(last)) = (self.first_dropped_sequence, self.last_dropped_sequence)
+            && (first.0 == 0 || last.0 == 0 || first.0 > last.0)
+        {
+            return Err(invalid("dropped sequence", "must satisfy 0 < first <= last"));
+        }
+        Ok(())
+    }
+}
