+use tokio::sync::oneshot;
+
+use shadowsocks_audit_protocol::{
+    ACK_TIMEOUT_SECONDS, AccessEvent, AuditRecord, DecimalU64, EventNackCode, Hello, MAX_AUDIT_PAYLOAD_BYTES,
+    MAX_IN_FLIGHT, PRODUCER_DIAGNOSTIC_INTERVAL_SECONDS, PermanentNackCode, ProducerGap, ProducerGapReason,
+    SuccessEvidence, Target, TargetKind, Transport, UDP_COOLDOWN_SECONDS, UdpWindowContention, normalize_domain,
+    parse_canonical_record, parse_event_ack, parse_event_nack, parse_hello_ack, parse_hello_nack, serialize_canonical,
+    serialize_canonical_record,
+};
+
+use crate::config::{USER_AUDIT_UDP_WINDOW_SHARDS, UserAuditConfig};
+
+const CLOSED_BIT: u64 = 1u64 << 63;
+const ACTIVE_MASK: u64 = CLOSED_BIT - 1;
+const UDP_COOLDOWN: Duration = Duration::from_secs(UDP_COOLDOWN_SECONDS);
+const ACK_TIMEOUT: Duration = Duration::from_secs(ACK_TIMEOUT_SECONDS);
+const DIAGNOSTIC_INTERVAL: Duration = Duration::from_secs(PRODUCER_DIAGNOSTIC_INTERVAL_SECONDS);
+const INITIAL_RECONNECT_BACKOFF: Duration = Duration::from_millis(100);
+/// Bounded drain budget the supervisor keeps after the emitter is closed
+/// (section 7.3).  A shutdown failure is retried inside this window; only an
+/// exhausted budget drops the remaining queue and in-flight work.
+const SHUTDOWN_DRAIN_BUDGET: Duration = Duration::from_secs(2);
+/// Fixed retry spacing used while the shutdown budget is running.  Transport
+/// backoff would otherwise consume the whole budget after a single failure.
+const SHUTDOWN_RETRY_DELAY: Duration = Duration::from_millis(100);
+const MAX_RECONNECT_BACKOFF: Duration = Duration::from_secs(5);
+const MAX_RECONNECT_JITTER_PERCENT: u32 = 20;
+
+#[cfg(test)]
+thread_local! {
+    // A one-shot hook lets the saturation regression force a failed CAS after
+    // the closure has observed a value near u64::MAX without perturbing the
+    // production hot path or making the test scheduler-dependent.
+    static SATURATING_ADD_BEFORE_CAS: RefCell<Option<(Arc<Barrier>, Arc<Barrier>)>> = RefCell::new(None);
+}
+
+#[cfg(test)]
+struct IdleSessionWaitHook {
+    entered: oneshot::Sender<()>,
+    resume: oneshot::Receiver<()>,
+}
+
+/// Marker carried by the `io::Error` returned for a non-retryable hello NACK.
+/// The wire contract gives this class a fixed five-second self-heal interval,
+/// unlike transport and socket validation failures that use jittered backoff.
+#[derive(Debug)]
+struct StickyHelloNack;
+
+impl fmt::Display for StickyHelloNack {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("non-retryable auditd hello NACK")
+    }
+}
+
+impl std::error::Error for StickyHelloNack {}
+
+/// Add a small positive jitter to the supervisor's reconnect delay.  Five
+/// seconds is a hard cap on the *total* delay, including jitter.
+fn reconnect_delay(base: Duration) -> Duration {
+    let jitter_percent = rand::random_range(0..=MAX_RECONNECT_JITTER_PERCENT);
+    reconnect_delay_with_jitter(base, jitter_percent)
+}
+
+/// Deterministic form used by tests and kept separate from the RNG call above.
+fn reconnect_delay_with_jitter(base: Duration, jitter_percent: u32) -> Duration {
+    let base = base.min(MAX_RECONNECT_BACKOFF);
+    let jitter_percent = jitter_percent.min(MAX_RECONNECT_JITTER_PERCENT);
+    let base_nanos = base.as_nanos();
+    let jitter_nanos = base_nanos.saturating_mul(jitter_percent as u128) / 100;
+    let total_nanos = base_nanos.saturating_add(jitter_nanos);
+    let hard_cap = MAX_RECONNECT_BACKOFF.as_nanos();
+    Duration::from_nanos(total_nanos.min(hard_cap).min(u64::MAX as u128) as u64)
+}
+
+fn is_sticky_hello_nack(error: &io::Error) -> bool {
+    error
+        .get_ref()
+        .map(|cause| cause.is::<StickyHelloNack>())
+        .unwrap_or(false)
+}
+
+fn reconnect_delay_for_error(error: &io::Error, backoff: Duration) -> Duration {
+    if is_sticky_hello_nack(error) {
+        MAX_RECONNECT_BACKOFF
+    } else {
+        reconnect_delay(backoff)
+    }
+}
+
+#[cfg(test)]
+fn reconnect_delay_for_error_with_jitter(error: &io::Error, backoff: Duration, jitter_percent: u32) -> Duration {
+    if is_sticky_hello_nack(error) {
+        MAX_RECONNECT_BACKOFF
+    } else {
+        reconnect_delay_with_jitter(backoff, jitter_percent)
+    }
+}
