+        let socket_path = directory.path().join("ingest.sock");
+        let listener = UnixListener::bind(&socket_path).expect("listener");
+        let config = UserAuditConfig::new(&socket_path, test_auditd_user());
+        let emitter = AuditEmitter::new(runtime(), &config);
+        let (idle_wait_entered, idle_wait_resume) = emitter.install_idle_session_wait_hook();
+        let first = emitter.encode_pending(tcp_draft(&emitter, 31)).expect("first event");
+        emitter.increment_pending();
+        let mut state = SupervisorState::new();
+        state.pending.push_back(first);
+
+        let producer = tokio::spawn({
+            let emitter = emitter.clone();
+            async move { connect_and_send_session(&emitter, &mut state, true).await }
+        });
+        let server = tokio::spawn({
+            let emitter = emitter.clone();
+            async move {
+                let (stream, _) = listener.accept().await.expect("accept");
+                let (mut reader, mut writer) = stream.into_split();
+                let _ = read_frame(&mut reader).await.expect("hello");
+                let hello_ack = serialize_canonical(&HelloAck::new()).expect("hello ack");
+                write_frame(&mut writer, &hello_ack).await.expect("write hello ack");
+
+                let first = read_frame(&mut reader).await.expect("first event");
+                let first = parse_canonical_record(&first).expect("first record");
+                let ack = EventAck::new(first.event_id(), "0123456789abcdef0123456789abcdef", 1);
+                let ack = serialize_canonical(&ack).expect("first ack");
+                write_frame(&mut writer, &ack).await.expect("write first ack");
+
+                // Wait until the producer has registered its idle waiter. Then
+                // insert without a notification to model the exact state after
+                // drain has consumed the sole permit left by a relay push. The
+                // explicit queue recheck must still send this event promptly.
+                idle_wait_entered.await.expect("producer entered idle wait boundary");
+                emitter.queue.push(tcp_draft(&emitter, 32)).expect("queue has capacity");
+                idle_wait_resume.send(()).expect("resume producer queue recheck");
+                let second = tokio::time::timeout(Duration::from_secs(1), read_frame(&mut reader))
+                    .await
+                    .expect("idle session slept despite a queued event")
+                    .expect("second event");
+                let second = parse_canonical_record(&second).expect("second record");
+                assert_eq!(second.event_id(), "0123456789abcdef0123456789abcdef:32");
+                let ack = EventAck::new(second.event_id(), "0123456789abcdef0123456789abcdef", 2);
+                let ack = serialize_canonical(&ack).expect("second ack");
+                write_frame(&mut writer, &ack).await.expect("write second ack");
+                emitter.close_emitter();
+            }
+        });
+
+        tokio::time::timeout(Duration::from_secs(2), server)
+            .await
+            .expect("mock server timeout")
+            .expect("mock server task");
+        tokio::time::timeout(Duration::from_secs(2), producer)
+            .await
+            .expect("producer timeout")
+            .expect("producer task")
+            .expect("producer session");
+        assert!(emitter.queue.is_empty());
+        assert_eq!(emitter.pending_len(), 0);
+    }
