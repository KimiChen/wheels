+        // must NOT refresh `last_audit_attempt_at`: the window stays anchored
+        // on the last eligible attempt, not on the last successful send.
+        let inside = start + Duration::from_secs(UDP_COOLDOWN_SECONDS - 1);
+        assert!(
+            cache
+                .eligible_lazy(&server_id, association, host, 53, inside, build)
+                .expect("cache available")
+                .is_none()
