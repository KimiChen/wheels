+impl QuarantinePending {
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        gap_event_id: impl Into<String>,
+        quarantine_basename: impl Into<String>,
+        recorded_at_unix_ms: u64,
+        batch_id: Option<String>,
+        body_sha256: Option<String>,
+        spool_epoch: Option<String>,
+        first_spool_sequence: Option<u64>,
+        last_spool_sequence: Option<u64>,
+        event_count: Option<u64>,
+        raw_bytes: Option<u64>,
+    ) -> Self {
+        Self {
+            entry_type: "quarantine_pending".to_owned(),
+            gap_event_id: gap_event_id.into(),
+            quarantine_basename: quarantine_basename.into(),
+            reason: "quarantine_eviction".to_owned(),
+            recorded_at_unix_ms: recorded_at_unix_ms.into(),
+            batch_id,
+            body_sha256,
+            spool_epoch,
+            first_spool_sequence: first_spool_sequence.map(Into::into),
+            last_spool_sequence: last_spool_sequence.map(Into::into),
+            event_count: event_count.map(Into::into),
+            raw_bytes: raw_bytes.map(Into::into),
+        }
+    }
+
+    pub fn validate(&self) -> Result<(), ProtocolError> {
+        if self.entry_type != "quarantine_pending" || self.reason != "quarantine_eviction" {
+            return Err(invalid("tombstone", "invalid quarantine pending discriminator"));
+        }
+        validate_gap_id(&self.gap_event_id)?;
+        validate_basename(&self.quarantine_basename)?;
+        if let Some(value) = &self.batch_id {
+            validate_lower_hex(value, 16, "batch_id")?;
+        }
+        if let Some(value) = &self.body_sha256 {
+            validate_lower_hex(value, 32, "body_sha256")?;
+        }
+        if let Some(value) = &self.spool_epoch {
+            validate_lower_hex(value, 16, "spool_epoch")?;
+        }
+        if self.first_spool_sequence.is_some() != self.last_spool_sequence.is_some() {
+            return Err(invalid("spool sequence", "first and last must both be present or null"));
+        }
+        if let (Some(first), Some(last)) = (self.first_spool_sequence, self.last_spool_sequence) {
+            validate_sequence_range(first, last, "spool sequence")?;
+        }
+        if self.event_count.is_some_and(|value| value.0 == 0) || self.raw_bytes.is_some_and(|value| value.0 == 0) {
+            return Err(invalid(
+                "tombstone",
+                "event_count/raw_bytes must be positive when present",
+            ));
+        }
+        Ok(())
+    }
+}
