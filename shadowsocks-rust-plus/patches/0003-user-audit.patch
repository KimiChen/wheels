+
+/// Poll all children while retaining ownership of every handle. Remove the
+/// first handle whose output is consumed so shutdown cleanup cannot poll it a
+/// second time (Tokio JoinHandle rejects a second output poll).
+async fn wait_first(tasks: &mut Vec<ServerHandle>) -> io::Result<()> {
+    future::poll_fn(|cx| {
+        for index in 0..tasks.len() {
+            let result = {
+                let task = &mut tasks[index];
+                Pin::new(task).poll(cx)
+            };
+            if let Poll::Ready(result) = result {
+                // A JoinHandle's output is consumed by the first Ready poll.
+                // Remove that wrapper immediately so shutdown cleanup cannot
+                // poll the same handle a second time.
+                tasks.swap_remove(index);
+                return Poll::Ready(result);
+            }
+        }
+        Poll::Pending
+    })
+    .await
