+impl AuditEventDraft {
+    fn sequence(&self) -> u64 {
+        match self {
+            Self::Tcp { sequence, .. }
+            | Self::Udp { sequence, .. }
+            | Self::ProducerGap { sequence, .. }
+            | Self::UdpContention { sequence, .. } => *sequence,
+        }
+    }
+
+    fn occurred_at_unix_ms(&self) -> u64 {
+        match self {
+            Self::Tcp {
+                occurred_at_unix_ms, ..
+            }
+            | Self::Udp {
+                occurred_at_unix_ms, ..
+            }
+            | Self::ProducerGap {
+                occurred_at_unix_ms, ..
+            }
+            | Self::UdpContention {
+                occurred_at_unix_ms, ..
+            } => *occurred_at_unix_ms,
+        }
+    }
+
+    fn is_diagnostic(&self) -> bool {
+        matches!(self, Self::ProducerGap { .. } | Self::UdpContention { .. })
+    }
+
+    pub fn event_id(&self) -> String {
+        match self {
+            Self::Tcp { sequence, runtime, .. }
+            | Self::Udp { sequence, runtime, .. }
+            | Self::ProducerGap { sequence, runtime, .. }
+            | Self::UdpContention { sequence, runtime, .. } => format!("{}:{sequence}", runtime.runtime_id),
+        }
+    }
+
+    /// Serialize using the stable field order required by the v1 wire schema.
+    pub fn to_json(&self) -> Result<Vec<u8>, serde_json::Error> {
+        match self {
