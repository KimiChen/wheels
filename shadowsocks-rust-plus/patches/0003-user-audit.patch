+                None,
+                None,
+                None,
+                None,
+                None,
+                None,
+            ));
+            spool.add_tombstone_locked(&mut inner, pending).expect("pending ledger");
+        }
+        let open_path = dir.path().join("open/current.ndjson");
+        let before = fs::read(&open_path).expect("open segment");
+        let sealed_before = fs::read_dir(dir.path().join("sealed")).expect("sealed").count();
+        let markers_before = recovery_marker_count(dir.path());
+        let ledger_before = fs::read(dir.path().join("tombstones.json")).expect("tombstone ledger");
+
+        let mut inner = lock(&spool.inner);
+        inner.durability_uncertain = true;
+        let spec = GapSpec {
+            event_id: "spool:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab".to_owned(),
+            occurred_at_unix_ms: 2,
+            lost_spool_epoch: None,
+            reason: wire::SpoolGapReason::TailTruncation,
+            first_lost_spool_sequence: None,
+            last_lost_spool_sequence: None,
+            lost_events: None,
+            lost_bytes: None,
+            lost_batch_id: None,
+            source_fingerprint: None,
+        };
+        assert!(matches!(
+            spool.write_gap_locked(&mut inner, &spec),
+            Err(SpoolError::DurabilityUncertain)
+        ));
+        assert!(matches!(
+            spool.seal_locked(&mut inner),
+            Err(SpoolError::DurabilityUncertain)
+        ));
+        let sequence = inner.next_sequence;
+        let wrapper = wrapper_bytes(&inner.epoch, sequence, 2, &event(2)).expect("wrapper");
+        assert!(matches!(
+            spool.write_record_locked(&mut inner, &wrapper, sequence, 2),
+            Err(SpoolError::DurabilityUncertain)
+        ));
+        assert!(matches!(
+            spool.quarantine_batch_locked(&mut inner, &dir.path().join("sealed/absent"), "batch-corrupt"),
+            Err(SpoolError::DurabilityUncertain)
