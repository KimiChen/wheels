+        let error = io::Error::from_raw_os_error(libc::EMFILE);
+        let (sender, mut receiver) = tokio::sync::watch::channel(false);
+        let mut backoff = ACCEPT_BACKOFF_INITIAL;
+        let mut diagnostic = None;
+
+        let started = std::time::Instant::now();
+        assert!(wait_before_accept_retry("test", &error, &mut backoff, &mut diagnostic, &mut receiver).await);
+        assert!(started.elapsed() >= ACCEPT_BACKOFF_INITIAL, "retry must not spin");
+        assert_eq!(backoff, ACCEPT_BACKOFF_INITIAL * 2);
+        assert!(diagnostic.is_some(), "the first failure must be reported");
+
+        // Shutdown must interrupt the wait instead of serving again.
+        sender.send(true).expect("shutdown");
+        assert!(!wait_before_accept_retry("test", &error, &mut backoff, &mut diagnostic, &mut receiver).await);
+    }
