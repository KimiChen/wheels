+impl EventNack {
+    pub fn new(event_id: impl Into<String>, error_code: EventNackCode) -> Self {
+        Self {
+            protocol_version: PROTOCOL_VERSION,
+            frame_type: FrameType::EventNack,
+            event_id: event_id.into(),
+            retryable: error_code.retryable(),
+            error_code,
+        }
+    }
+
+    pub fn validate(&self) -> Result<(), ProtocolError> {
+        if self.protocol_version != PROTOCOL_VERSION || self.frame_type != FrameType::EventNack {
+            return Err(invalid("event_nack", "protocol_version/frame_type mismatch"));
+        }
+        if self.retryable != self.error_code.retryable() {
+            return Err(invalid("retryable", "does not match error_code"));
+        }
+        validate_event_id_shape(&self.event_id)
+    }
+}
+
+fn validate_event_id_shape(value: &str) -> Result<(), ProtocolError> {
+    if value.len() > 64 {
+        return Err(invalid("event_id", "must be at most 64 bytes"));
+    }
+    let (runtime, sequence) = value
+        .split_once(':')
+        .ok_or_else(|| invalid("event_id", "must be runtime_id:sequence"))?;
+    validate_lower_hex(runtime, 16, "event_id.runtime_id")?;
+    parse_decimal(sequence, false).map(|_| ())
+}
