@@ -0,0 +1,3349 @@
+//! Wire types and deterministic canonicalization for the node-local access audit.
+//!
+//! This crate deliberately contains no filesystem, socket, clock, or task code.  It
+//! is shared by the data-plane producer and `shadowsocks-auditd`; all values that
+//! cross either boundary are represented here so the two sides cannot silently
+//! choose different JSON or HMAC encodings.
+
+#![forbid(unsafe_code)]
+
+use hmac::{Hmac, Mac};
+use idna::domain_to_ascii_strict;
+use serde::{
+    Deserialize, Deserializer, Serialize, Serializer,
+    de::{self, DeserializeOwned, DeserializeSeed, MapAccess, SeqAccess, Visitor},
+};
+use serde_json::{Value, value::RawValue};
+use sha2::{Digest, Sha256};
+use std::{collections::HashSet, fmt, str::FromStr};
+use subtle::ConstantTimeEq;
+use thiserror::Error;
+
+pub const SCHEMA_VERSION: u8 = 1;
+pub const PROTOCOL_VERSION: u8 = 1;
+pub const MAX_EVENT_JSON_BYTES: usize = 8 * 1024;
+pub const MAX_INGEST_FRAME_BYTES: usize = 8 * 1024;
+pub const MAX_EVENT_BYTES: usize = MAX_EVENT_JSON_BYTES;
+pub const MAX_FRAME_BYTES: usize = MAX_INGEST_FRAME_BYTES;
+/// The wrapper adds only a bounded set of metadata fields around one event.
+/// Keep this exposed so auditd configuration can reject an undersized segment
+/// before opening it.
+pub const MAX_SPOOL_RECORD_BYTES: usize = MAX_EVENT_JSON_BYTES + 512;
+pub const UDP_DEDUP_WINDOW_SECONDS: u64 = 60;
+pub const UDP_AUDIT_SHARDS: usize = 64;
+pub const ACKED_RETENTION_SECONDS: u64 = 86_400;
+pub const INGEST_MAX_CONNECTIONS: usize = 4;
+pub const INGEST_DEADLINE_SECONDS: u64 = 2;
+pub const EXPORT_MAX_CONNECTIONS: usize = 4;
+pub const EXPORT_DEADLINE_SECONDS: u64 = 5;
+pub const PRODUCER_IN_FLIGHT_LIMIT: usize = 256;
+pub const PRODUCER_ACK_TIMEOUT_SECONDS: u64 = 3;
+pub const NONCE_CACHE_TTL_SECONDS: u64 = 600;
+pub const NONCE_CACHE_CAPACITY: usize = 4096;
+pub const EVENT_DEDUP_CAPACITY: usize = 65_536;
+pub const TOMBSTONE_CAPACITY: usize = 4096;
+pub const RECEIPT_RETENTION_SECONDS: u64 = 7 * 86_400;
+pub const HMAC_TIMESTAMP_SKEW_SECONDS: u64 = 300;
+pub const MAX_IDENTIFIER_BYTES: usize = 128;
+pub const MAX_DOMAIN_BYTES: usize = 255;
+
+// Readable aliases retained for integrations that use the terminology from
+// the implementation specification.
+pub const UDP_COOLDOWN_SECONDS: u64 = UDP_DEDUP_WINDOW_SECONDS;
+pub const UDP_WINDOW_SHARDS: usize = UDP_AUDIT_SHARDS;
+pub const MAX_IN_FLIGHT: usize = PRODUCER_IN_FLIGHT_LIMIT;
+pub const ACK_TIMEOUT_SECONDS: u64 = PRODUCER_ACK_TIMEOUT_SECONDS;
+
+/// Errors returned by strict protocol parsing and canonicalization.
+#[derive(Debug, Error, Clone, PartialEq, Eq)]
+pub enum ProtocolError {
+    #[error("invalid JSON: {0}")]
+    Json(String),
+    #[error("JSON contains a duplicate key: {0}")]
+    DuplicateKey(String),
+    #[error("JSON contains trailing data")]
+    TrailingData,
+    #[error("JSON is not canonical")]
+    NonCanonical,
+    #[error("raw CR/LF is not permitted in a canonical payload")]
+    RawLineBreak,
+    #[error("invalid field {field}: {reason}")]
+    InvalidField { field: String, reason: String },
+    #[error("unknown event type: {0}")]
+    UnknownEventType(String),
+    #[error("invalid frame: {0}")]
+    InvalidFrame(String),
+    #[error("frame payload is too large ({actual} bytes, limit {limit})")]
+    FrameTooLarge { actual: usize, limit: usize },
+    #[error("HMAC key must contain exactly 32 bytes")]
+    InvalidHmacKey,
+    #[error("HMAC value must be 64 lowercase hexadecimal characters")]
+    InvalidHmacValue,
+}
+
+fn invalid(field: impl Into<String>, reason: impl Into<String>) -> ProtocolError {
+    ProtocolError::InvalidField {
+        field: field.into(),
+        reason: reason.into(),
+    }
+}
+
+/* ------------------------------------------------------------------------- */
+/* Strict JSON helpers                                                       */
+
+/// A serde visitor used before typed deserialization.  `serde_json::Value`
+/// intentionally accepts duplicate object members; the wire contract does not.
+struct AnySeed;
+
+impl<'de> DeserializeSeed<'de> for AnySeed {
+    type Value = ();
+
+    fn deserialize<D>(self, deserializer: D) -> Result<Self::Value, D::Error>
+    where
+        D: Deserializer<'de>,
+    {
+        deserializer.deserialize_any(AnyVisitor)
+    }
+}
+
+struct AnyVisitor;
+
+impl<'de> Visitor<'de> for AnyVisitor {
+    type Value = ();
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("any JSON value")
+    }
+
+    fn visit_map<M>(self, mut map: M) -> Result<Self::Value, M::Error>
+    where
+        M: MapAccess<'de>,
+    {
+        let mut keys = HashSet::<String>::new();
+        while let Some(key) = map.next_key::<String>()? {
+            if !keys.insert(key.clone()) {
+                return Err(de::Error::custom(format!("duplicate key `{key}`")));
+            }
+            map.next_value_seed(AnySeed)?;
+        }
+        Ok(())
+    }
+
+    fn visit_seq<S>(self, mut sequence: S) -> Result<Self::Value, S::Error>
+    where
+        S: SeqAccess<'de>,
+    {
+        while sequence.next_element_seed(AnySeed)?.is_some() {}
+        Ok(())
+    }
+
+    fn visit_unit<E>(self) -> Result<Self::Value, E>
+    where
+        E: de::Error,
+    {
+        Ok(())
+    }
+
+    fn visit_bool<E>(self, _: bool) -> Result<Self::Value, E>
+    where
+        E: de::Error,
+    {
+        Ok(())
+    }
+
+    fn visit_i64<E>(self, _: i64) -> Result<Self::Value, E>
+    where
+        E: de::Error,
+    {
+        Ok(())
+    }
+
+    fn visit_u64<E>(self, _: u64) -> Result<Self::Value, E>
+    where
+        E: de::Error,
+    {
+        Ok(())
+    }
+
+    fn visit_f64<E>(self, _: f64) -> Result<Self::Value, E>
+    where
+        E: de::Error,
+    {
+        Ok(())
+    }
+
+    fn visit_str<E>(self, _: &str) -> Result<Self::Value, E>
+    where
+        E: de::Error,
+    {
+        Ok(())
+    }
+
+    fn visit_borrowed_str<E>(self, _: &'de str) -> Result<Self::Value, E>
+    where
+        E: de::Error,
+    {
+        Ok(())
+    }
+
+    fn visit_string<E>(self, _: String) -> Result<Self::Value, E>
+    where
+        E: de::Error,
+    {
+        Ok(())
+    }
+
+    fn visit_bytes<E>(self, _: &[u8]) -> Result<Self::Value, E>
+    where
+        E: de::Error,
+    {
+        Ok(())
+    }
+
+    fn visit_byte_buf<E>(self, _: Vec<u8>) -> Result<Self::Value, E>
+    where
+        E: de::Error,
+    {
+        Ok(())
+    }
+}
+
+fn check_duplicate_keys(bytes: &[u8]) -> Result<(), ProtocolError> {
+    let mut deserializer = serde_json::Deserializer::from_slice(bytes);
+    deserializer.deserialize_any(AnyVisitor).map_err(|error| {
+        let text = error.to_string();
+        if let Some(key) = text.strip_prefix("duplicate key `") {
+            ProtocolError::DuplicateKey(key.trim_end_matches('`').to_owned())
+        } else {
+            ProtocolError::Json(text)
+        }
+    })?;
+    deserializer.end().map_err(|error| {
+        if error.is_eof() {
+            ProtocolError::Json("unexpected end of JSON".to_owned())
+        } else {
+            ProtocolError::TrailingData
+        }
+    })
+}
+
+/// Parse one strict JSON value.  Unknown fields are handled by the target type's
+/// `deny_unknown_fields` declaration; this helper additionally rejects duplicate
+/// keys and trailing values.
+pub fn parse_json_exact<T: DeserializeOwned>(bytes: &[u8]) -> Result<T, ProtocolError> {
+    check_duplicate_keys(bytes)?;
+    serde_json::from_slice(bytes).map_err(|error| ProtocolError::Json(error.to_string()))
+}
+
+fn serialize_json<T: Serialize>(value: &T) -> Result<Vec<u8>, ProtocolError> {
+    serde_json::to_vec(value).map_err(|error| ProtocolError::Json(error.to_string()))
+}
+
+/// Serialize a value using serde's deterministic compact representation.
+pub fn serialize_canonical<T: Serialize>(value: &T) -> Result<Vec<u8>, ProtocolError> {
+    let bytes = serialize_json(value)?;
+    if bytes.iter().any(|byte| *byte == b'\r' || *byte == b'\n') {
+        return Err(ProtocolError::RawLineBreak);
+    }
+    Ok(bytes)
+}
+
+/// Parse JSON and require its bytes to be exactly the canonical representation.
+pub fn parse_canonical<T>(bytes: &[u8]) -> Result<T, ProtocolError>
+where
+    T: DeserializeOwned + Serialize,
+{
+    if bytes.iter().any(|byte| *byte == b'\r' || *byte == b'\n') {
+        return Err(ProtocolError::RawLineBreak);
+    }
+    let value: T = parse_json_exact(bytes)?;
+    if serialize_canonical(&value)? != bytes {
+        return Err(ProtocolError::NonCanonical);
+    }
+    Ok(value)
+}
+
+/* ------------------------------------------------------------------------- */
+/* Primitive wire values                                                     */
+
+/// A `u64` represented as a canonical decimal JSON string.
+#[derive(Clone, Copy, Debug, Default, Eq, Ord, PartialEq, PartialOrd, Hash)]
+pub struct DecimalU64(pub u64);
+
+impl DecimalU64 {
+    pub const fn new(value: u64) -> Self {
+        Self(value)
+    }
+
+    pub const fn get(self) -> u64 {
+        self.0
+    }
+}
+
+impl From<u64> for DecimalU64 {
+    fn from(value: u64) -> Self {
+        Self(value)
+    }
+}
+
+impl From<DecimalU64> for u64 {
+    fn from(value: DecimalU64) -> Self {
+        value.0
+    }
+}
+
+impl fmt::Display for DecimalU64 {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str(&self.0.to_string())
+    }
+}
+
+impl FromStr for DecimalU64 {
+    type Err = ProtocolError;
+
+    fn from_str(value: &str) -> Result<Self, Self::Err> {
+        parse_decimal(value, true).map(Self)
+    }
+}
+
+impl DecimalU64 {
+    pub const fn is_zero(self) -> bool {
+        self.0 == 0
+    }
+
+    pub const fn into_inner(self) -> u64 {
+        self.0
+    }
+}
+
+impl Serialize for DecimalU64 {
+    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
+    where
+        S: Serializer,
+    {
+        serializer.serialize_str(&self.0.to_string())
+    }
+}
+
+impl<'de> Deserialize<'de> for DecimalU64 {
+    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
+    where
+        D: Deserializer<'de>,
+    {
+        struct DecimalVisitor;
+
+        impl<'de> Visitor<'de> for DecimalVisitor {
+            type Value = DecimalU64;
+
+            fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+                formatter.write_str("a decimal u64 encoded as a JSON string")
+            }
+
+            fn visit_str<E>(self, value: &str) -> Result<Self::Value, E>
+            where
+                E: de::Error,
+            {
+                parse_decimal(value, true)
+                    .map(DecimalU64)
+                    .map_err(|error| E::custom(error.to_string()))
+            }
+
+            fn visit_borrowed_str<E>(self, value: &'de str) -> Result<Self::Value, E>
+            where
+                E: de::Error,
+            {
+                self.visit_str(value)
+            }
+
+            fn visit_string<E>(self, value: String) -> Result<Self::Value, E>
+            where
+                E: de::Error,
+            {
+                self.visit_str(&value)
+            }
+        }
+
+        deserializer.deserialize_str(DecimalVisitor)
+    }
+}
+
+pub type U64String = DecimalU64;
+
+fn parse_decimal(value: &str, allow_zero: bool) -> Result<u64, ProtocolError> {
+    if value.is_empty()
+        || !value.bytes().all(|byte| byte.is_ascii_digit())
+        || (value.len() > 1 && value.starts_with('0'))
+        || (!allow_zero && value == "0")
+    {
+        return Err(invalid("decimal", "must be an unprefixed decimal u64"));
+    }
+    value
+        .parse::<u64>()
+        .map_err(|_| invalid("decimal", "is outside the u64 range"))
+}
+
+pub fn parse_decimal_u64(value: &str) -> Result<u64, ProtocolError> {
+    parse_decimal(value, true)
+}
+
+pub fn parse_positive_decimal_u64(value: &str) -> Result<u64, ProtocolError> {
+    parse_decimal(value, false)
+}
+
+pub fn validate_identifier(value: &str, field: &str) -> Result<(), ProtocolError> {
+    if value.is_empty() {
+        return Err(invalid(field, "must not be empty"));
+    }
+    if value.len() > MAX_IDENTIFIER_BYTES {
+        return Err(invalid(field, "exceeds 128 UTF-8 bytes"));
+    }
+    if !value
+        .bytes()
+        .all(|byte| (0x21..=0x7e).contains(&byte) && !byte.is_ascii_whitespace())
+    {
+        return Err(invalid(field, "must contain only printable non-whitespace ASCII"));
+    }
+    Ok(())
+}
+
+pub fn validate_lower_hex(value: &str, bytes: usize, field: &str) -> Result<(), ProtocolError> {
+    let Some(expected_len) = bytes.checked_mul(2) else {
+        return Err(invalid(field, "requested hexadecimal length overflows usize"));
+    };
+    if value.len() != expected_len
+        || !value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        return Err(invalid(
+            field,
+            format!("must be exactly {expected_len} lowercase hexadecimal characters"),
+        ));
+    }
+    Ok(())
+}
+
+fn validate_schema(schema_version: u8) -> Result<(), ProtocolError> {
+    if schema_version != SCHEMA_VERSION {
+        return Err(invalid("schema_version", "unsupported schema version"));
+    }
+    Ok(())
+}
+
+fn validate_generation(value: u64, field: &str) -> Result<(), ProtocolError> {
+    if value != 1 {
+        return Err(invalid(field, "v1 generation must be 1"));
+    }
+    Ok(())
+}
+
+/* ------------------------------------------------------------------------- */
+/* Target and access records                                                 */
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum TargetKind {
+    Domain,
+    Ip,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Target {
+    pub kind: TargetKind,
+    pub host: String,
+    pub normalized_host: Option<String>,
+    pub port: u16,
+    pub remote_ip: String,
+}
+
+impl Target {
+    pub fn domain(host: impl Into<String>, port: u16, remote_ip: impl Into<String>) -> Result<Self, ProtocolError> {
+        let host = host.into();
+        let remote_ip = remote_ip.into();
+        let normalized_host = normalize_domain(&host).ok();
+        let target = Self {
+            kind: TargetKind::Domain,
+            host,
+            normalized_host,
+            port,
+            remote_ip,
+        };
+        target.validate()?;
+        Ok(target)
+    }
+
+    pub fn ip(ip: impl Into<String>, port: u16) -> Result<Self, ProtocolError> {
+        let ip = ip.into();
+        let canonical = IpAddrText::parse(&ip)?.to_string();
+        let target = Self {
+            kind: TargetKind::Ip,
+            host: canonical.clone(),
+            normalized_host: Some(canonical.clone()),
+            port,
+            remote_ip: canonical,
+        };
+        target.validate()?;
+        Ok(target)
+    }
+
+    pub fn validate(&self) -> Result<(), ProtocolError> {
+        if self.port == 0 {
+            return Err(invalid("target.port", "must be in 1..=65535"));
+        }
+        if self.host.is_empty() || self.host.len() > MAX_DOMAIN_BYTES {
+            return Err(invalid("target.host", "must be non-empty and at most 255 bytes"));
+        }
+        let remote = IpAddrText::parse(&self.remote_ip)
+            .map_err(|_| invalid("target.remote_ip", "must be a canonical IP address"))?;
+        if remote.to_string() != self.remote_ip {
+            return Err(invalid("target.remote_ip", "must use canonical IP text"));
+        }
+        match self.kind {
+            TargetKind::Domain => {
+                let expected = normalize_domain(&self.host).ok();
+                if self.normalized_host != expected {
+                    return Err(invalid(
+                        "target.normalized_host",
+                        "does not match UTS #46 non-transitional STD3 normalization",
+                    ));
+                }
+            }
+            TargetKind::Ip => {
+                let expected = IpAddrText::parse(&self.host)
+                    .map_err(|_| invalid("target.host", "must be a canonical IP address"))?;
+                if expected.to_string() != self.host || self.normalized_host.as_deref() != Some(self.host.as_str()) {
+                    return Err(invalid(
+                        "target",
+                        "IP host and normalized_host must use the same canonical IP text",
+                    ));
+                }
+                // `remote_ip` is the address actually passed to the socket.
+                // It can legitimately differ from an IPv4 target when the
+                // platform maps it to an IPv6 socket (and vice versa).
+            }
+        }
+        Ok(())
+    }
+}
+
+/// Small wrapper so target validation does not expose parsing implementation
+/// details in the public API.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+struct IpAddrText(std::net::IpAddr);
+
+impl IpAddrText {
+    fn parse(value: &str) -> Result<Self, ProtocolError> {
+        std::net::IpAddr::from_str(value)
+            .map(Self)
+            .map_err(|_| invalid("ip", "invalid IP address"))
+    }
+}
+
+impl fmt::Display for IpAddrText {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        self.0.fmt(formatter)
+    }
+}
+
+pub fn normalize_domain(host: &str) -> Result<String, ProtocolError> {
+    if host.is_empty() || host.len() > MAX_DOMAIN_BYTES {
+        return Err(invalid("target.host", "must be non-empty and at most 255 bytes"));
+    }
+    // IDNA's strict DNS-length check treats a root-label terminator as an
+    // invalid empty label.  The wire contract permits one terminal dot and
+    // removes it before applying UTS #46/STD3 normalization.
+    let input = host.strip_suffix('.').unwrap_or(host);
+    if input.is_empty() {
+        return Err(invalid("target.host", "must contain a non-empty label"));
+    }
+
+    if host.is_ascii() {
+        // ASCII names follow the wire rule literally: lower-case the spelling
+        // and remove one terminal dot.  Do not run STD3 here; Shadowsocks can
+        // carry useful ASCII pseudo-hosts such as `_service._tcp.example`.
+        if input.split('.').any(str::is_empty) {
+            return Err(invalid("target.host", "domain contains an empty label"));
+        }
+        return Ok(input.to_ascii_lowercase());
+    }
+
+    // Unicode names use UTS #46 non-transitional + STD3 conversion.  More
+    // than one terminal dot would have left a terminal dot in `input`; IDNA
+    // treats that as an empty label and normalization must fail.
+    let ascii = domain_to_ascii_strict(input)
+        .map_err(|_| invalid("target.host", "UTS #46/STD3 normalization failed"))?
+        .to_ascii_lowercase();
+    if ascii.ends_with('.') {
+        return Err(invalid("target.host", "domain contains an empty label"));
+    }
+    if ascii.is_empty() || ascii.len() > MAX_DOMAIN_BYTES {
+        return Err(invalid("target.normalized_host", "normalized domain is invalid"));
+    }
+    Ok(ascii)
+}
