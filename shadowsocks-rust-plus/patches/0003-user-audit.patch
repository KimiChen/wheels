new file mode 100644
index 0000000000000000000000000000000000000000..e91629beb465ae748cebb53a43eed9c62f03707d
--- /dev/null
+++ b/crates/shadowsocks-auditd/src/lib.rs
@@ -0,0 +1,223 @@
+#![cfg_attr(not(target_os = "linux"), allow(dead_code, unused_imports))]
+
+#[cfg(not(target_os = "linux"))]
+compile_error!("shadowsocks-auditd is supported on Linux only");
+
+mod config;
+mod export;
+mod ingest;
+mod protocol;
+mod spool;
+
+pub use config::{AuditdConfig, ConfigError, DEFAULT_CONFIG_PATH};
+pub use export::{ExportError, ExportServer};
+pub use ingest::{IngestError, IngestServer};
+pub use spool::{BatchInfo, EventAck, HealthSnapshot, Spool, SpoolError};
+
+use std::{io, sync::Arc};
+
+use tokio::{select, signal, sync::watch};
+
+async fn wait_for_durability_uncertain(mut receiver: watch::Receiver<bool>) {
+    if *receiver.borrow() {
+        return;
+    }
+    while receiver.changed().await.is_ok() {
+        if *receiver.borrow() {
+            return;
+        }
+    }
+}
+
+/// Long-lived audit daemon. The two socket servers share one spool and health state.
+pub struct AuditDaemon {
+    config: Arc<AuditdConfig>,
+    spool: Arc<Spool>,
+}
+
+impl AuditDaemon {
+    pub fn new(config: AuditdConfig) -> Result<Self, ConfigError> {
+        config.validate_runtime()?;
+        // Acquire the directory lock before opening/recovering the spool.
+        // The lock is bound to spool_dir, so different socket paths cannot
+        // allow two daemons to mutate the same ledger concurrently.
+        let spool_lock = Spool::acquire_lock(&config.spool_dir).map_err(ConfigError::Io)?;
+        let config = Arc::new(config);
+        let spool = Arc::new(Spool::open_with_lock(config.clone(), spool_lock).map_err(ConfigError::Spool)?);
+        Ok(Self { config, spool })
+    }
+
+    pub fn config(&self) -> &AuditdConfig {
+        &self.config
+    }
+
+    pub fn spool(&self) -> Arc<Spool> {
+        self.spool.clone()
+    }
+
+    /// Run until SIGTERM/SIGINT or a socket task fails.
+    pub async fn run(self) -> io::Result<()> {
+        let Self { config, spool } = self;
+        let (shutdown_tx, shutdown_rx) = watch::channel(false);
+        let export = ExportServer::new(config.clone(), spool.clone(), shutdown_rx.clone())
+            .await
+            .map_err(io::Error::other)?;
+        let ingest = IngestServer::new(config.clone(), spool.clone(), shutdown_rx.clone())
+            .await
+            .map_err(io::Error::other)?;
+
+        let mut ingest_task = tokio::spawn(ingest.run());
+        let mut export_task = tokio::spawn(export.run());
+        let durability_uncertain = wait_for_durability_uncertain(spool.durability_uncertain_receiver());
+
+        let signal_result = async {
+            #[cfg(unix)]
+            {
+                let mut term = signal::unix::signal(signal::unix::SignalKind::terminate()).map_err(io::Error::other)?;
+                let mut interrupt =
+                    signal::unix::signal(signal::unix::SignalKind::interrupt()).map_err(io::Error::other)?;
+                select! {
+                    _ = term.recv() => Ok::<(), io::Error>(()),
+                    _ = interrupt.recv() => Ok::<(), io::Error>(()),
+                }
+            }
+            #[cfg(not(unix))]
+            {
+                signal::ctrl_c().await.map_err(io::Error::other)
+            }
+        };
+
+        select! {
+            _ = durability_uncertain => {
+                let _ = shutdown_tx.send(true);
+                let _ = ingest_task.await;
+                let _ = export_task.await;
+                Err(io::Error::other(SpoolError::DurabilityUncertain))
+            }
+            result = signal_result => {
+                let _ = shutdown_tx.send(true);
+                let _ = ingest_task.await;
+                let _ = export_task.await;
+                result
+            }
+            result = &mut ingest_task => {
+                let _ = shutdown_tx.send(true);
+                let _ = export_task.await;
+                result.map_err(io::Error::other)?.map_err(io::Error::other)
+            }
+            result = &mut export_task => {
+                let _ = shutdown_tx.send(true);
+                let _ = ingest_task.await;
+                result.map_err(io::Error::other)?.map_err(io::Error::other)
+            }
+        }
+    }
+}
+
+fn parse_config_path<I>(args: I) -> Result<std::path::PathBuf, String>
+where
+    I: IntoIterator<Item = std::ffi::OsString>,
+{
+    let mut path = None;
+    let mut args = args.into_iter();
+    while let Some(arg) = args.next() {
+        if arg != "--config" {
+            return Err(format!("unknown argument: {}", arg.to_string_lossy()));
+        }
+        if path.is_some() {
+            return Err("duplicate --config".to_owned());
+        }
+        let value = args.next().ok_or_else(|| "--config requires a path".to_owned())?;
+        let value = value
+            .into_string()
+            .map_err(|_| "--config path must be valid UTF-8".to_owned())?;
+        if value.is_empty() {
+            return Err("--config path must not be empty".to_owned());
+        }
+        path = Some(std::path::PathBuf::from(value));
+    }
+    let path = path.unwrap_or_else(|| std::path::PathBuf::from(DEFAULT_CONFIG_PATH));
+    crate::config::validate_absolute_path(&path, "--config").map_err(|error| error.to_string())?;
+    Ok(path)
+}
+
+/// Entry point used by the root `shadowsocks-auditd` wrapper binary.
+pub fn cli_main() -> std::process::ExitCode {
+    let path = match parse_config_path(std::env::args_os().skip(1)) {
+        Ok(value) => value,
+        Err(error) => {
+            eprintln!("shadowsocks-auditd: {error}");
+            return std::process::ExitCode::from(2);
+        }
+    };
+    let config = match AuditdConfig::load_from_file(&path) {
+        Ok(value) => value,
+        Err(error) => {
+            eprintln!("shadowsocks-auditd: invalid configuration: {error}");
+            return std::process::ExitCode::from(78);
+        }
+    };
+    let runtime = match tokio::runtime::Builder::new_current_thread().enable_all().build() {
+        Ok(value) => value,
+        Err(error) => {
+            eprintln!("shadowsocks-auditd: runtime startup failed: {error}");
+            return std::process::ExitCode::from(1);
+        }
+    };
+    match runtime.block_on(async {
+        let daemon = AuditDaemon::new(config)?;
+        daemon.run().await.map_err(ConfigError::Io)
+    }) {
+        Ok(()) => std::process::ExitCode::SUCCESS,
+        Err(error) => {
+            eprintln!("shadowsocks-auditd: {error}");
+            std::process::ExitCode::from(1)
+        }
+    }
+}
+
+#[cfg(test)]
+mod cli_tests {
+    use super::parse_config_path;
+    use std::{ffi::OsString, os::unix::ffi::OsStringExt, path::PathBuf};
+
+    fn args(values: &[&str]) -> Vec<OsString> {
+        values.iter().map(OsString::from).collect()
+    }
+
+    #[test]
+    fn config_path_defaults_to_fixed_production_location() {
+        assert_eq!(
+            parse_config_path(Vec::<OsString>::new()).unwrap(),
+            PathBuf::from(super::DEFAULT_CONFIG_PATH)
+        );
+    }
+
+    #[test]
+    fn config_path_accepts_one_explicit_path() {
+        assert_eq!(
+            parse_config_path(args(&["--config", "/tmp/auditd.json"])).unwrap(),
+            PathBuf::from("/tmp/auditd.json")
+        );
+    }
+
+    #[test]
+    fn config_path_rejects_unknown_duplicate_missing_and_non_utf8() {
+        for value in [
+            args(&["--help"]),
+            args(&["--config", "/a", "--config", "/b"]),
+            args(&["--config"]),
+        ] {
+            assert!(parse_config_path(value).is_err());
+        }
+        let non_utf8 = vec![OsString::from("--config"), OsString::from_vec(vec![b'/', 0xff])];
+        assert!(parse_config_path(non_utf8).is_err());
+    }
+
+    #[test]
+    fn config_path_rejects_noncanonical_spellings() {
+        for path in ["relative.json", "/a/../b", "/a/./b", "/a//b", "/a/b/"] {
+            assert!(parse_config_path(args(&["--config", path])).is_err(), "{path}");
+        }
+    }
+}
