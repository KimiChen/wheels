+        let spool = Spool::open(config(dir.path())).expect("spool");
+        let first_gap = "spool:88888888888888888888888888888888";
+        let second_gap = "spool:99999999999999999999999999999999";
+        {
+            let mut inner = lock(&spool.inner);
+            for (gap_id, basename) in [(first_gap, "orphan-batch-a"), (second_gap, "orphan-batch-b")] {
+                let pending = TombstoneEntry::QuarantinePending(wire::QuarantinePending::new(
+                    gap_id, basename, 10, None, None, None, None, None, None, None,
+                ));
+                spool.add_tombstone_locked(&mut inner, pending).expect("pending ledger");
+            }
+            // rename succeeded, parent fsync failed: the cursor is
+            // commit-uncertain and the spool turns fatal in mid-call.
+            inner.faults.persist_state_after_commit = true;
+        }
