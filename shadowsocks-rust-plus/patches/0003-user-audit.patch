+/// Immutable process runtime metadata shared by every audited identity.
+#[derive(Debug)]
+pub struct AuditRuntimeMetadata {
+    pub node_id: Arc<str>,
+    pub runtime_id: Arc<str>,
+    pub started_at_unix_ms: u64,
+    pub runtime_started_at: Instant,
+}
+
+/// Immutable static server metadata.
+#[derive(Debug)]
+pub struct AuditServerMetadata {
+    pub server_id: Arc<str>,
+    pub server_generation: u64,
+}
+
+/// Immutable configured identity metadata.
+#[derive(Debug)]
+pub struct AuditIdentityMetadata {
+    pub identity_name: Arc<str>,
+    pub identity_generation: u64,
+}
+
+/// Typed, generation-checked identity handle held by relays.
+pub struct AuditIdentityHandle {
+    pub runtime: Arc<AuditRuntimeMetadata>,
+    pub server: Arc<AuditServerMetadata>,
+    pub identity: Arc<AuditIdentityMetadata>,
+    pub counters: Arc<UserTrafficCounters>,
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct AuditTargetDraft {
+    pub kind: String,
+    pub host: String,
+    pub normalized_host: Option<String>,
+    pub port: u16,
+    pub remote_ip: String,
+}
+
+impl AuditTargetDraft {
+    pub fn ip(target: IpAddr, remote: IpAddr) -> Self {
+        let text = target.to_string();
+        Self {
+            kind: "ip".to_owned(),
+            host: text.clone(),
+            normalized_host: Some(text),
+            port: 0,
+            remote_ip: remote.to_string(),
+        }
+    }
+
+    pub fn domain(host: &str, port: u16, remote: IpAddr) -> Self {
+        // Keep the original address header while applying exactly the same
+        // strict UTS #46/STD3 normalization used by the wire validator.  A
+        // normalization failure is represented by `null`; the original host
+        // remains available for diagnostics and never changes routing.
+        let normalized_host = normalize_domain(host).ok();
+        Self {
+            kind: "domain".to_owned(),
+            host: host.to_owned(),
+            normalized_host,
+            port,
+            remote_ip: remote.to_string(),
+        }
+    }
+
+    pub fn ip_with_port(target: IpAddr, port: u16, remote: IpAddr) -> Self {
+        let mut value = Self::ip(target, remote);
+        value.port = port;
+        value
+    }
+
+    fn key_host(&self) -> &str {
+        self.normalized_host.as_deref().unwrap_or(&self.host)
+    }
+}
