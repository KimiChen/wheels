+    /// §14.5 caps the ssserver RSS increase at 64 MiB and the UDP window cache
+    /// is by far the largest structure inside it.  Fill one shard to the
+    /// default per-shard capacity with three equivalent spellings per window
+    /// (the worst case the two alias slots allow) and hold the projected
+    /// whole-cache footprint inside the budget below.
+    #[test]
+    fn udp_cache_default_capacity_fits_window_memory_budget() {
+        const WINDOW_CACHE_BUDGET_BYTES: usize = 32 * 1024 * 1024;
+        use crate::config::{
+            USER_AUDIT_DEFAULT_MAX_UDP_TARGET_WINDOWS, USER_AUDIT_DEFAULT_MAX_UDP_TARGETS_PER_ASSOCIATION,
+        };
+
+        let per_association = USER_AUDIT_DEFAULT_MAX_UDP_TARGETS_PER_ASSOCIATION;
+        let per_shard = USER_AUDIT_DEFAULT_MAX_UDP_TARGET_WINDOWS / USER_AUDIT_UDP_WINDOW_SHARDS;
+        let cache = UdpAuditWindowCache::new(per_association, USER_AUDIT_DEFAULT_MAX_UDP_TARGET_WINDOWS);
+        let server_id: Arc<str> = Arc::from("ss-entry-01");
+        let now = Instant::now();
+        let mut association = [0u8; 16];
+        for index in 0..per_shard {
+            // Byte 7 selects the shard, so every window below lands in the
+            // same shard while byte 6 keeps the per-association limit honest.
+            association[6] = u8::try_from(index / per_association).expect("association lineage");
+            let spellings = [
+                format!("Host-{index}.targets.example.com"),
+                format!("hOST-{index}.targets.example.com"),
+                format!("HOST-{index}.TARGETS.example.com"),
+            ];
+            for spelling in &spellings {
+                cache
+                    .eligible_lazy(
+                        &server_id,
+                        association,
+                        UdpAuditHost::Domain(spelling.as_str()),
+                        443,
+                        now,
+                        || cache_target(spelling.as_str(), 443),
+                    )
+                    .expect("window cache");
+            }
+        }
+        let shard_index = UdpAuditWindowCache::shard_index(&association);
+        let filled = {
+            let shard = cache.shards[shard_index].lock().expect("shard");
+            assert_eq!(shard.by_key.len(), per_shard);
+            assert_eq!(shard.by_raw_key.len(), 2 * per_shard);
+            shard.footprint_bytes()
+        };
+        // Only one shard is populated; project the full cache from it.
+        let projected = filled * USER_AUDIT_UDP_WINDOW_SHARDS + cache.footprint_bytes() - filled;
+        assert!(
+            projected <= WINDOW_CACHE_BUDGET_BYTES,
+            "projected window cache footprint {projected} bytes exceeds the {WINDOW_CACHE_BUDGET_BYTES} byte budget"
+        );
+    }
