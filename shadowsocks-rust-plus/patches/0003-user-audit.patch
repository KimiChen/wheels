+pub fn encode_frame(payload: &[u8]) -> Result<Vec<u8>, ProtocolError> {
+    if payload.is_empty() {
+        return Err(ProtocolError::InvalidFrame("zero-length payload".to_owned()));
+    }
+    if payload.len() > MAX_INGEST_FRAME_BYTES {
+        return Err(ProtocolError::FrameTooLarge {
+            actual: payload.len(),
+            limit: MAX_INGEST_FRAME_BYTES,
+        });
+    }
+    let length = u32::try_from(payload.len()).map_err(|_| ProtocolError::FrameTooLarge {
+        actual: payload.len(),
+        limit: MAX_INGEST_FRAME_BYTES,
+    })?;
+    let mut output = Vec::with_capacity(4 + payload.len());
+    output.extend_from_slice(&length.to_be_bytes());
+    output.extend_from_slice(payload);
+    Ok(output)
+}
+
+/// Decode exactly one frame.  Use [`decode_frame_prefix`] for a stream buffer.
+pub fn decode_frame(input: &[u8]) -> Result<&[u8], ProtocolError> {
+    let (payload, consumed) =
+        decode_frame_prefix(input)?.ok_or_else(|| ProtocolError::InvalidFrame("incomplete frame".to_owned()))?;
+    if consumed != input.len() {
+        return Err(ProtocolError::InvalidFrame("trailing frame bytes".to_owned()));
+    }
+    Ok(payload)
+}
+
+pub fn decode_frame_prefix(input: &[u8]) -> Result<Option<(&[u8], usize)>, ProtocolError> {
+    if input.len() < 4 {
+        return Ok(None);
+    }
+    let length = u32::from_be_bytes([input[0], input[1], input[2], input[3]]) as usize;
+    if length == 0 {
+        return Err(ProtocolError::InvalidFrame("zero-length payload".to_owned()));
+    }
+    if length > MAX_INGEST_FRAME_BYTES {
+        return Err(ProtocolError::FrameTooLarge {
+            actual: length,
+            limit: MAX_INGEST_FRAME_BYTES,
+        });
+    }
+    let total = 4usize
+        .checked_add(length)
+        .ok_or_else(|| ProtocolError::InvalidFrame("length overflow".to_owned()))?;
+    if input.len() < total {
+        return Ok(None);
+    }
+    Ok(Some((&input[4..total], total)))
+}
+
+pub fn encode_json_frame<T: Serialize>(value: &T) -> Result<Vec<u8>, ProtocolError> {
+    encode_frame(&serialize_canonical(value)?)
+}
+
+pub fn decode_json_frame<T: DeserializeOwned + Serialize>(input: &[u8]) -> Result<T, ProtocolError> {
+    parse_canonical(decode_frame(input)?)
+}
+
+pub fn encode_ingest_frame(payload: &[u8]) -> Result<Vec<u8>, ProtocolError> {
+    encode_frame(payload)
+}
+
+pub fn decode_ingest_frame(input: &[u8]) -> Result<&[u8], ProtocolError> {
+    decode_frame(input)
+}
+
+pub fn decode_ingest_frame_prefix(input: &[u8]) -> Result<Option<(&[u8], usize)>, ProtocolError> {
+    decode_frame_prefix(input)
+}
