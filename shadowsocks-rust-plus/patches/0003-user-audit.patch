+//! Strict HTTP/1.1 export endpoint for the node-local audit spool.
+
+use std::{
+    collections::HashMap,
+    fs, io,
+    net::Ipv6Addr,
+    os::fd::AsRawFd,
+    os::unix::fs::{FileTypeExt, MetadataExt},
+    path::PathBuf,
+    str,
+    sync::{Arc, Mutex},
+    time::{Duration, SystemTime, UNIX_EPOCH},
+};
+
+use shadowsocks_audit_protocol as wire;
+use subtle::ConstantTimeEq;
+use thiserror::Error;
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    net::{UnixListener, UnixStream},
+    sync::{Semaphore, watch},
+    task::JoinSet,
+    time,
+};
+
+use crate::{
+    config::{AuditdConfig, MAX_EXPORT_CONNECTIONS, MAX_NONCES, NONCE_TTL_SECONDS, SocketLock, SocketRole},
+    spool::{AckOutcome, BatchLease, Spool, SpoolError},
+};
+
+const HTTP_DEADLINE: Duration = Duration::from_secs(5);
+const MAX_REQUEST_LINE: usize = 1024;
+const MAX_HEADER_BYTES: usize = 16 * 1024;
+const MAX_HEADERS: usize = 32;
+const MAX_BODY_BYTES: usize = 4096;
+
+#[derive(Debug, Error)]
+pub enum ExportError {
+    #[error("export socket I/O failed: {0}")]
+    Io(#[from] io::Error),
+    #[error("export protocol error: {0}")]
+    Protocol(String),
+    #[error("spool error: {0}")]
+    Spool(#[from] SpoolError),
+}
+
+#[derive(Clone, Default)]
+struct NonceCache {
+    inner: Arc<Mutex<HashMap<String, u64>>>,
+}
+
+enum NonceResult {
+    Inserted,
+    Replay,
+    Full,
+}
+
+impl NonceCache {
+    fn check_and_insert(&self, nonce: &str, now: u64) -> NonceResult {
+        let mut cache = match self.inner.lock() {
+            Ok(guard) => guard,
+            Err(poisoned) => poisoned.into_inner(),
+        };
+        let cutoff = now.saturating_sub(NONCE_TTL_SECONDS);
+        cache.retain(|_, seen| *seen >= cutoff);
+        if cache.contains_key(nonce) {
+            return NonceResult::Replay;
+        }
+        if cache.len() >= MAX_NONCES {
+            return NonceResult::Full;
+        }
+        cache.insert(nonce.to_owned(), now);
+        NonceResult::Inserted
+    }
+}
+
+pub struct ExportServer {
+    config: Arc<AuditdConfig>,
+    spool: Arc<Spool>,
+    shutdown: watch::Receiver<bool>,
+    key: [u8; 32],
+    nonces: NonceCache,
+    export_peer_uid: u32,
+    socket_path_guard: Option<SocketPathGuard>,
+    // Keep the lock field after the path guard so the bound inode is cleaned
+    // before the lock is released during Drop.
+    _socket_lock: SocketLock,
+}
+
+struct SocketPathGuard {
+    path: PathBuf,
+    device: u64,
+    inode: u64,
+}
+
+impl Drop for SocketPathGuard {
+    fn drop(&mut self) {
+        let Ok(metadata) = fs::symlink_metadata(&self.path) else {
+            return;
+        };
+        if metadata.file_type().is_socket() && metadata.dev() == self.device && metadata.ino() == self.inode {
+            let _ = fs::remove_file(&self.path);
+            if let Some(parent) = self.path.parent() {
+                let _ = fs::File::open(parent).and_then(|file| file.sync_all());
+            }
+        }
+    }
+}
+
+impl ExportServer {
+    pub async fn new(
+        config: Arc<AuditdConfig>,
+        spool: Arc<Spool>,
+        shutdown: watch::Receiver<bool>,
+    ) -> Result<Self, ExportError> {
+        config
+            .validate()
+            .map_err(|error| ExportError::Protocol(error.to_string()))?;
+        // Preserve the standalone constructor's validation-before-I/O
+        // behavior.  Callers using this API should not leave a lockfile
+        // behind merely because the configured peer account is invalid.
+        config
+            .export_peer_uid()
+            .map_err(|error| ExportError::Protocol(error.to_string()))?;
+        let socket_lock = SocketLock::acquire(&config.export_socket_path)?;
+        Self::new_with_lock(config, spool, shutdown, socket_lock).await
+    }
+
+    /// Construct an export server with a lock acquired by the daemon before
+    /// spool initialization.  Keeping this separate from the public
+    /// constructor preserves the standalone API while allowing
+    /// `AuditDaemon` to close the initialization race between two processes.
+    pub(crate) async fn new_with_lock(
+        config: Arc<AuditdConfig>,
+        spool: Arc<Spool>,
+        shutdown: watch::Receiver<bool>,
+        socket_lock: SocketLock,
+    ) -> Result<Self, ExportError> {
+        config
+            .validate()
+            .map_err(|error| ExportError::Protocol(error.to_string()))?;
+        let export_peer_uid = config
+            .export_peer_uid()
+            .map_err(|error| ExportError::Protocol(error.to_string()))?;
+        socket_lock.verify()?;
+        crate::config::prepare_socket_path_for(&config.export_socket_path, SocketRole::Export)?;
+        socket_lock.verify()?;
+        let key = config
+            .read_hmac_key()
+            .map_err(|error| ExportError::Protocol(error.to_string()))?;
+        Ok(Self {
+            config,
+            spool,
+            shutdown,
+            key,
+            nonces: NonceCache::default(),
+            export_peer_uid,
+            socket_path_guard: None,
+            _socket_lock: socket_lock,
+        })
+    }
+
+    pub async fn run(mut self) -> Result<(), ExportError> {
+        self._socket_lock.verify()?;
+        let listener = UnixListener::bind(&self.config.export_socket_path)?;
+        let metadata = fs::symlink_metadata(&self.config.export_socket_path)?;
+        self.socket_path_guard = Some(SocketPathGuard {
+            path: self.config.export_socket_path.clone(),
+            device: metadata.dev(),
+            inode: metadata.ino(),
+        });
+        crate::config::secure_bound_socket_for(&self.config.export_socket_path, SocketRole::Export)?;
+        crate::config::validate_bound_socket_for(&self.config.export_socket_path, SocketRole::Export)?;
+        let semaphore = Arc::new(Semaphore::new(MAX_EXPORT_CONNECTIONS));
+        let mut tasks = JoinSet::new();
+        let mut shutdown = self.shutdown;
+        let loop_result = loop {
+            // The lock pathname is expected to remain bound to the inode on
+            // which acquisition succeeded.  If it is replaced, stop serving
+            // rather than allowing a second daemon to operate on a different
+            // advisory-lock inode.
+            if let Err(error) = self._socket_lock.verify() {
+                break Err(ExportError::Io(error));
+            }
+            tokio::select! {
+                changed = shutdown.changed() => {
+                    if changed.is_err() || *shutdown.borrow() { break Ok(()); }
+                }
+                // Reap completed connection tasks during normal operation.
+                // Without this branch JoinSet retains one task result for
+                // every connection until daemon shutdown, despite the active
+                // connection semaphore being bounded.
+                joined = tasks.join_next(), if !tasks.is_empty() => {
+                    let _ = joined;
+                }
+                accepted = listener.accept() => {
+                    let (stream, _) = match accepted {
+                        Ok(value) => value,
+                        Err(error) => break Err(ExportError::Io(error)),
+                    };
+                    let permit = match semaphore.clone().try_acquire_owned() {
+                        Ok(value) => value,
+                        Err(_) => { drop(stream); continue; }
+                    };
+                    let config = self.config.clone();
+                    let spool = self.spool.clone();
+                    let key = self.key;
+                    let nonces = self.nonces.clone();
+                    let export_peer_uid = self.export_peer_uid;
+                    tasks.spawn(async move {
+                        let _permit = permit;
+                        let _ = handle_connection(stream, config, spool, key, nonces, export_peer_uid).await;
+                    });
+                }
+            }
+        };
+        // Close the listener before the path guard runs.  Do not remove the
+        // pathname by name here: a replacement inode must be left untouched;
+        // `SocketPathGuard` performs the captured-device/inode check in Drop.
+        drop(listener);
+        // Client handlers have their own five-second I/O deadline, but an
+        // idle connection is allowed to wait at a request boundary.  Abort
+        // handlers once the listener receives shutdown so the socket guard
+        // and lock are released promptly and daemon shutdown cannot be held
+        // hostage by an idle peer.
+        tasks.abort_all();
+        while tasks.join_next().await.is_some() {}
+        loop_result
+    }
+}
+
+#[derive(Debug, Clone)]
+struct HttpRequest {
+    method: String,
+    path: String,
+    headers: Vec<(String, String)>,
+    body: Vec<u8>,
+}
+
+#[derive(Debug, Clone)]
+struct AuthContext {
+    nonce: String,
+}
+
+#[derive(Debug, Clone, Copy)]
+struct AuthError {
+    status: u16,
+    code: &'static str,
+    signable: bool,
+}
+
+/// A request can fail strict HTTP parsing after its authentication headers have
+/// already been read.  Preserve that unambiguous prefix so the caller can
+/// still return the response MAC required by the export contract.  The
+/// embedded error is retained for diagnostics, while `partial` is deliberately
+/// limited to data parsed before the failure.
+#[derive(Debug)]
+struct RequestReadError {
+    _error: ExportError,
+    partial: Option<HttpRequest>,
+}
+
+impl RequestReadError {
+    fn protocol(message: impl Into<String>, partial: Option<HttpRequest>) -> Self {
+        Self {
+            _error: ExportError::Protocol(message.into()),
+            partial,
+        }
+    }
+
+    fn io(error: io::Error, partial: Option<HttpRequest>) -> Self {
+        Self {
+            _error: ExportError::Io(error),
+            partial,
+        }
+    }
+}
+
+async fn handle_connection(
+    mut stream: UnixStream,
+    config: Arc<AuditdConfig>,
+    spool: Arc<Spool>,
+    key: [u8; 32],
+    nonces: NonceCache,
+    expected_uid: u32,
+) -> Result<(), ExportError> {
+    let peer_ok = peer_uid(&stream).is_ok_and(|uid| uid == expected_uid);
+    if !peer_ok {
+        let response = unsigned_error_response(401, "unauthorized", &config.node_id);
+        let _ = time::timeout(HTTP_DEADLINE, write_response(&mut stream, &response)).await;
+        return Ok(());
+    }
+    let request = match time::timeout(HTTP_DEADLINE, read_request(&mut stream)).await {
+        Ok(Ok(value)) => value,
+        Ok(Err(error)) => {
+            // A malformed route, Host, or body framing can still carry valid
+            // node/nonce headers.  Sign that error response; malformed or
+            // ambiguous authentication material remains unsigned.
+            let response = error
+                .partial
+                .as_ref()
+                .filter(|request| request_is_signable(request))
+                .map(|request| signed_error_for_request(request, &config.node_id, &key, 400, "invalid_request"))
+                .unwrap_or_else(|| unsigned_error_response(400, "invalid_request", &config.node_id));
+            let _ = time::timeout(HTTP_DEADLINE, write_response(&mut stream, &response)).await;
+            return Ok(());
+        }
+        Err(_) => {
+            let response = unsigned_error_response(400, "invalid_request", &config.node_id);
+            let _ = time::timeout(HTTP_DEADLINE, write_response(&mut stream, &response)).await;
+            return Ok(());
+        }
+    };
+    let auth = match authenticate(&request, &config.node_id, &key, &nonces) {
+        Ok(value) => value,
+        Err(error) => {
+            let response = if error.signable {
+                signed_error_for_request(&request, &config.node_id, &key, error.status, error.code)
+            } else {
+                unsigned_error_response(error.status, error.code, &config.node_id)
+            };
+            let _ = time::timeout(HTTP_DEADLINE, write_response(&mut stream, &response)).await;
+            return Ok(());
+        }
+    };
+    let parts = match route_request(&request, &spool, config.export_max_response_bytes).await {
+        Ok(value) => value,
+        Err(RouteError::InvalidRequest) => ResponseParts::json(400, error_body("invalid_request")),
+        Err(RouteError::Spool(error)) => {
+            let (status, code) = map_route_error(error);
+            ResponseParts::json(status, error_body(code))
+        }
+        Err(RouteError::ResponseTooLarge) => ResponseParts::json(500, error_body("internal_error")),
+    };
+    let response = match build_wire_response(&parts, &config.node_id, &key, &auth.nonce) {
+        Ok(value) => value,
+        Err(_) => signed_error_for_request(&request, &config.node_id, &key, 500, "internal_error"),
+    };
+    let _ = time::timeout(HTTP_DEADLINE, write_response(&mut stream, &response)).await;
+    Ok(())
+}
+
+fn authenticate(
+    request: &HttpRequest,
+    expected_node: &str,
+    key: &[u8; 32],
+    nonces: &NonceCache,
+) -> Result<AuthContext, AuthError> {
+    let node = header(request, "x-shadowsocks-audit-node");
+    let timestamp = header(request, "x-shadowsocks-audit-timestamp");
+    let nonce = header(request, "x-shadowsocks-audit-nonce");
+    let digest = header(request, "x-shadowsocks-audit-content-sha256");
+    let authorization = header(request, "authorization");
+    let signable = request_is_signable(request);
+    let unauthorized = || AuthError {
+        status: 401,
+        code: "unauthorized",
+        signable,
+    };
+    let (Some(node), Some(timestamp), Some(nonce), Some(digest), Some(authorization)) =
+        (node, timestamp, nonce, digest, authorization)
+    else {
+        return Err(unauthorized());
+    };
+    if node != expected_node
+        || !is_canonical_decimal(timestamp)
+        || !is_lower_hex(nonce, 32)
+        || !is_lower_hex(digest, 64)
+        || !authorization.starts_with("Shadowsocks-Audit-HMAC-SHA256 ")
+    {
+        return Err(unauthorized());
+    }
+    let supplied = &authorization["Shadowsocks-Audit-HMAC-SHA256 ".len()..];
+    if !is_lower_hex(supplied, 64) {
+        return Err(unauthorized());
+    }
+    let timestamp_value = timestamp.parse::<u64>().map_err(|_| unauthorized())?;
+    let Some(now) = unix_seconds() else {
+        // An invalid local clock is an authentication failure.  Do not turn
+        // pre-epoch time into a synthetic timestamp that could pass skew.
+        return Err(unauthorized());
+    };
+    if timestamp_value.abs_diff(now) > wire::HMAC_TIMESTAMP_SKEW_SECONDS {
+        return Err(unauthorized());
+    }
+    let actual_digest = wire::sha256_hex(&request.body);
+    if !bool::from(actual_digest.as_bytes().ct_eq(digest.as_bytes())) {
+        return Err(unauthorized());
+    }
+    let valid = wire::verify_request_mac(
+        key,
+        supplied,
+        &request.method,
+        &request.path,
+        node,
+        timestamp_value,
+        nonce,
+        digest,
+    )
+    .map_err(|_| unauthorized())?;
+    if !valid {
+        return Err(unauthorized());
+    }
+    match nonces.check_and_insert(nonce, now) {
+        NonceResult::Inserted => Ok(AuthContext {
+            nonce: nonce.to_owned(),
+        }),
+        NonceResult::Replay => Err(AuthError {
+            status: 409,
+            code: "replayed_nonce",
+            signable: true,
+        }),
+        NonceResult::Full => Err(AuthError {
+            status: 429,
+            code: "rate_limited",
+            signable: true,
+        }),
+    }
+}
+
+#[derive(Debug)]
+enum RouteError {
+    InvalidRequest,
+    Spool(SpoolError),
+    ResponseTooLarge,
+}
+
+impl From<SpoolError> for RouteError {
+    fn from(error: SpoolError) -> Self {
+        Self::Spool(error)
+    }
+}
+
+async fn route_request(
+    request: &HttpRequest,
+    spool: &Spool,
+    max_response_bytes: u64,
+) -> Result<ResponseParts, RouteError> {
+    match (request.method.as_str(), request.path.as_str()) {
+        ("GET", "/v1/audit/healthz") => {
+            if !request.body.is_empty() {
+                return Err(RouteError::InvalidRequest);
+            }
+            let health = spool.health();
+            let status = if health.status == "ok" { 200 } else { 503 };
+            let body = wire::serialize_canonical(&wire_health(&health))
+                .map_err(|error| SpoolError::Protocol(crate::protocol::ProtocolError::from(error)))?;
+            Ok(ResponseParts::json(status, body))
+        }
+        ("POST", "/v1/audit/lease") => {
+            let request_body: wire::LeaseRequest =
+                wire::parse_canonical(&request.body).map_err(|_| RouteError::InvalidRequest)?;
+            request_body.validate().map_err(|_| RouteError::InvalidRequest)?;
+            match spool.lease()? {
+                None => Ok(ResponseParts::empty(204)),
+                Some(lease) => {
+                    if lease.body.len() as u64 > max_response_bytes {
+                        // A valid batch should fit because configuration keeps
+                        // export_max_response_bytes >= segment_max_bytes.  If
+                        // a legacy/configured spool violates that invariant,
+                        // isolate the batch before returning the fixed error;
+                        // otherwise every retry would re-lease the same poison
+                        // batch forever.
+                        let _ = spool.quarantine_oversized_lease(&lease.info.batch_id, max_response_bytes)?;
+                        return Err(RouteError::ResponseTooLarge);
+                    }
+                    Ok(ResponseParts::lease(lease))
+                }
+            }
+        }
+        ("POST", "/v1/audit/ack") => {
+            let request_body: wire::AckRequest =
+                wire::parse_canonical(&request.body).map_err(|_| RouteError::InvalidRequest)?;
+            request_body.validate().map_err(|_| RouteError::InvalidRequest)?;
+            match spool.ack(&request_body.batch_id, &request_body.body_sha256)? {
+                AckOutcome::Acked => Ok(ResponseParts::json(200, wire::canonical_ack_response())),
+                AckOutcome::Unknown => Err(RouteError::Spool(SpoolError::UnknownBatch)),
+                AckOutcome::Evicted => Err(RouteError::Spool(SpoolError::BatchEvicted)),
+                AckOutcome::DigestMismatch => Err(RouteError::Spool(SpoolError::DigestMismatch)),
+            }
+        }
+        _ => Err(RouteError::InvalidRequest),
+    }
+}
+
+fn wire_health(health: &crate::spool::HealthSnapshot) -> wire::HealthResponse {
+    wire::HealthResponse {
+        schema_version: 1,
+        node_id: health.node_id.clone(),
+        status: if health.status == "ok" {
+            wire::HealthStatus::Ok
+        } else {
+            wire::HealthStatus::Degraded
+        },
+        producer_connected: health.producer_connected,
+        producer_runtime_id: health.producer_runtime_id.clone(),
+        last_ingest_at_unix_ms: health.last_ingest_at_unix_ms.map(Into::into),
+        spool_epoch: health.spool_epoch.clone(),
+        spool_bytes: health.spool_bytes.into(),
+        max_spool_bytes: health.max_spool_bytes.into(),
+        sealed_batches: health.sealed_batches.into(),
+        oldest_unacked_at_unix_ms: health.oldest_unacked_at_unix_ms.map(Into::into),
+        stored_records: health.stored_records.into(),
+        storage_rejected_attempts: health.storage_rejected_attempts.into(),
+        evicted_unacked_records: health.evicted_unacked_records.into(),
+    }
+}
+
+#[derive(Debug)]
+struct ResponseParts {
+    status: u16,
+    content_type: Option<&'static str>,
+    body: Vec<u8>,
+    schema: Option<u8>,
+    lease_body_sha256: Option<String>,
+    batch_id: Option<String>,
+    spool_epoch: Option<String>,
+    first_sequence: Option<u64>,
+    last_sequence: Option<u64>,
+    event_count: Option<u64>,
+}
+
+impl ResponseParts {
+    fn json(status: u16, body: Vec<u8>) -> Self {
+        Self {
+            status,
+            content_type: Some("application/json"),
+            body,
+            schema: None,
+            lease_body_sha256: None,
+            batch_id: None,
+            spool_epoch: None,
+            first_sequence: None,
+            last_sequence: None,
+            event_count: None,
+        }
+    }
+
+    fn empty(status: u16) -> Self {
+        Self {
+            status,
+            content_type: None,
+            body: Vec::new(),
+            schema: None,
+            lease_body_sha256: None,
+            batch_id: None,
+            spool_epoch: None,
+            first_sequence: None,
+            last_sequence: None,
+            event_count: None,
+        }
+    }
+
+    fn lease(lease: BatchLease) -> Self {
+        let body_sha256 = wire::sha256_hex(&lease.body);
+        Self {
+            status: 200,
+            content_type: Some("application/x-ndjson"),
+            body: lease.body,
+            schema: Some(1),
+            lease_body_sha256: Some(body_sha256),
+            batch_id: Some(lease.info.batch_id),
+            spool_epoch: Some(lease.info.spool_epoch),
+            first_sequence: Some(lease.info.first_spool_sequence),
+            last_sequence: Some(lease.info.last_spool_sequence),
+            event_count: Some(lease.info.event_count),
+        }
+    }
+}
+
+#[derive(Debug)]
+struct WireResponse {
+    bytes: Vec<u8>,
+}
+
+fn signed_error_for_request(
+    request: &HttpRequest,
+    node: &str,
+    key: &[u8; 32],
+    status: u16,
+    code: &str,
+) -> WireResponse {
+    let body = error_body(code);
+    // The caller only uses this helper after nonce validation.  If the shared
+    // canonicalizer rejects an impossible value, return a deterministic
+    // unsigned response rather than panicking in the error path.
+    let nonce = header(request, "x-shadowsocks-audit-nonce").unwrap_or("");
+    build_wire_response(&ResponseParts::json(status, body), node, key, nonce)
+        .unwrap_or_else(|_| unsigned_error_response(status, code, node))
+}
+
+fn unsigned_error_response(status: u16, code: &str, node: &str) -> WireResponse {
+    let body = error_body(code);
+    let digest = wire::sha256_hex(&body);
+    let mut bytes = format!(
+        "HTTP/1.1 {status} {}\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\nCache-Control: no-store\r\nX-Shadowsocks-Audit-Node: {node}\r\nX-Shadowsocks-Audit-Response-SHA256: {digest}\r\n\r\n",
+        reason_phrase(status),
+        body.len()
+    )
+    .into_bytes();
+    bytes.extend_from_slice(&body);
+    WireResponse { bytes }
+}
+
+fn error_body(code: &str) -> Vec<u8> {
+    let value = wire::ErrorResponse {
+        schema_version: 1,
+        error_code: code.to_owned(),
+    };
+    wire::serialize_canonical(&value).unwrap_or_else(|_| {
+        // All call sites pass one of the fixed protocol codes; this fallback
+        // is only a last-resort allocation-free response for a future code.
+        format!(r#"{{"schema_version":1,"error_code":"{code}"}}"#).into_bytes()
+    })
+}
+
+fn build_wire_response(
+    parts: &ResponseParts,
+    node: &str,
+    key: &[u8; 32],
+    nonce: &str,
+) -> Result<WireResponse, ExportError> {
+    let body_digest = wire::sha256_hex(&parts.body);
+    let lease_metadata = parts.schema.is_some();
+    let canonical = wire::canonical_response(
+        nonce,
+        parts.status,
+        parts.content_type,
+        parts.schema,
+        parts.lease_body_sha256.as_deref(),
+        node,
+        parts.batch_id.as_deref(),
+        parts.spool_epoch.as_deref(),
+        parts.first_sequence,
+        parts.last_sequence,
+        parts.event_count,
+        &body_digest,
+    )
+    .map_err(|error| ExportError::Protocol(error.to_string()))?;
+    let mac = wire::hmac_sha256(key, &canonical).map_err(|error| ExportError::Protocol(error.to_string()))?;
+    let mac_hex = hex::encode(mac);
+    let mut bytes = format!("HTTP/1.1 {} {}\r\n", parts.status, reason_phrase(parts.status)).into_bytes();
+    if let Some(content_type) = parts.content_type {
+        bytes.extend_from_slice(format!("Content-Type: {content_type}\r\n").as_bytes());
+    }
+    if parts.status != 204 {
+        bytes.extend_from_slice(format!("Content-Length: {}\r\n", parts.body.len()).as_bytes());
+    }
+    bytes.extend_from_slice(b"Connection: close\r\nCache-Control: no-store\r\n");
+    bytes.extend_from_slice(format!("X-Shadowsocks-Audit-Node: {node}\r\n").as_bytes());
+    bytes.extend_from_slice(format!("X-Shadowsocks-Audit-Response-SHA256: {body_digest}\r\n").as_bytes());
+    bytes.extend_from_slice(format!("X-Shadowsocks-Audit-Response-MAC: {mac_hex}\r\n").as_bytes());
+    if lease_metadata {
+        bytes.extend_from_slice(b"X-Shadowsocks-Audit-Schema: 1\r\n");
+        if let Some(value) = &parts.lease_body_sha256 {
+            bytes.extend_from_slice(format!("X-Shadowsocks-Audit-Body-SHA256: {value}\r\n").as_bytes());
+        }
+        if let Some(value) = &parts.batch_id {
+            bytes.extend_from_slice(format!("X-Shadowsocks-Audit-Batch-Id: {value}\r\n").as_bytes());
+        }
+        if let Some(value) = &parts.spool_epoch {
+            bytes.extend_from_slice(format!("X-Shadowsocks-Audit-Spool-Epoch: {value}\r\n").as_bytes());
+        }
+        if let Some(value) = parts.first_sequence {
+            bytes.extend_from_slice(format!("X-Shadowsocks-Audit-First-Sequence: {value}\r\n").as_bytes());
+        }
+        if let Some(value) = parts.last_sequence {
+            bytes.extend_from_slice(format!("X-Shadowsocks-Audit-Last-Sequence: {value}\r\n").as_bytes());
+        }
+        if let Some(value) = parts.event_count {
+            bytes.extend_from_slice(format!("X-Shadowsocks-Audit-Event-Count: {value}\r\n").as_bytes());
+        }
+    }
+    bytes.extend_from_slice(b"\r\n");
+    bytes.extend_from_slice(&parts.body);
+    Ok(WireResponse { bytes })
+}
+
+async fn write_response(stream: &mut UnixStream, response: &WireResponse) -> io::Result<()> {
+    stream.write_all(&response.bytes).await
+}
+
+async fn read_request(stream: &mut UnixStream) -> Result<HttpRequest, RequestReadError> {
+    let mut bytes = Vec::with_capacity(4096);
+    let mut header_end = None;
+    let mut chunk = [0_u8; 1024];
+    while header_end.is_none() {
+        let read = stream
+            .read(&mut chunk)
+            .await
+            .map_err(|error| RequestReadError::io(error, request_hint_from_bytes(&bytes)))?;
+        if read == 0 {
+            return Err(RequestReadError::protocol(
+                "unexpected EOF",
+                request_hint_from_bytes(&bytes),
+            ));
+        }
+        bytes.extend_from_slice(&chunk[..read]);
+        header_end = bytes
+            .windows(4)
+            .position(|window| window == b"\r\n\r\n")
+            .map(|index| index + 4);
+        match header_end {
+            Some(end) if end > MAX_HEADER_BYTES => {
+                return Err(RequestReadError::protocol(
+                    "headers too large",
+                    request_hint_from_bytes(&bytes),
+                ));
+            }
+            None if bytes.len() > MAX_HEADER_BYTES => {
+                return Err(RequestReadError::protocol(
+                    "headers too large",
+                    request_hint_from_bytes(&bytes),
+                ));
+            }
+            _ => {}
+        }
+    }
+    let header_end = header_end
+        .ok_or_else(|| RequestReadError::protocol("header terminator missing", request_hint_from_bytes(&bytes)))?;
+    let header_bytes = &bytes[..header_end];
+    let text = str::from_utf8(header_bytes)
+        .map_err(|_| RequestReadError::protocol("headers are not UTF-8", request_hint_from_bytes(header_bytes)))?;
+    let mut lines = text.split("\r\n");
+    let request_line = lines
+        .next()
+        .ok_or_else(|| RequestReadError::protocol("request line missing", request_hint_from_bytes(header_bytes)))?;
+    if request_line.is_empty() || request_line.len() > MAX_REQUEST_LINE {
+        return Err(RequestReadError::protocol(
+            "invalid request line",
+            request_hint_from_bytes(header_bytes),
+        ));
+    }
+    let mut request_parts = request_line.split(' ');
+    let method = request_parts.next().unwrap_or("").to_owned();
+    let path = request_parts.next().unwrap_or("").to_owned();
+    let version = request_parts.next().unwrap_or("");
+    let request_line_valid =
+        request_parts.next().is_none() && version == "HTTP/1.1" && !method.is_empty() && !path.is_empty();
+    let mut headers = Vec::new();
+    let mut duplicate_security_header = false;
+    for line in lines {
+        if line.is_empty() {
+            break;
+        }
+        if line.bytes().any(|byte| byte < 0x20 || byte == 0x7f || byte == b'\t') {
+            if line_mentions_auth_hint(line) {
+                return Err(RequestReadError::protocol("invalid header characters", None));
+            }
+            return Err(RequestReadError::protocol(
+                "invalid header characters",
+                Some(HttpRequest {
+                    method: method.clone(),
+                    path: path.clone(),
+                    headers,
+                    body: Vec::new(),
+                }),
+            ));
+        }
+        let Some((name, value)) = line.split_once(':') else {
+            if line_mentions_auth_hint(line) {
+                return Err(RequestReadError::protocol("invalid header", None));
+            }
+            return Err(RequestReadError::protocol(
+                "invalid header",
+                Some(HttpRequest {
+                    method: method.clone(),
+                    path: path.clone(),
+                    headers,
+                    body: Vec::new(),
+                }),
+            ));
+        };
+        if name.is_empty()
+            || !name.bytes().all(is_token_byte)
+            || !value.starts_with(' ')
+            || value.len() == 1
+            || value[1..].starts_with([' ', '\t'])
+            || value.ends_with([' ', '\t'])
+        {
+            if is_auth_hint_name(name) {
+                return Err(RequestReadError::protocol("invalid header grammar", None));
+            }
+            return Err(RequestReadError::protocol(
+                "invalid header grammar",
+                Some(HttpRequest {
+                    method: method.clone(),
+                    path: path.clone(),
+                    headers,
+                    body: Vec::new(),
+                }),
+            ));
+        }
+        let lower = name.to_ascii_lowercase();
+        if is_security_header(&lower) && headers.iter().any(|(existing, _)| existing == &lower) {
+            // A duplicate node/nonce is ambiguous and cannot be used to sign
+            // an error response.  Other duplicate security fields still leave
+            // the node and nonce unambiguous; retain the complete parsed
+            // prefix so the contract can attach a response MAC to the fixed
+            // 400 error.  The request remains unroutable below.
+            if matches!(lower.as_str(), "x-shadowsocks-audit-node" | "x-shadowsocks-audit-nonce") {
+                return Err(RequestReadError::protocol("duplicate security header", None));
+            }
+            duplicate_security_header = true;
+        }
+        headers.push((lower, value[1..].to_owned()));
+        if headers.len() > MAX_HEADERS {
+            return Err(RequestReadError::protocol(
+                "too many headers",
+                Some(HttpRequest {
+                    method: method.clone(),
+                    path: path.clone(),
+                    headers,
+                    body: Vec::new(),
+                }),
+            ));
+        }
+    }
+    let request = HttpRequest {
+        method: method.clone(),
+        path: path.clone(),
+        headers,
+        body: Vec::new(),
+    };
+    if duplicate_security_header {
+        return Err(RequestReadError::protocol("duplicate security header", Some(request)));
+    }
+    if !request_line_valid
+        || !matches!(
+            (method.as_str(), path.as_str()),
+            ("GET", "/v1/audit/healthz") | ("POST", "/v1/audit/lease") | ("POST", "/v1/audit/ack")
+        )
+    {
+        return Err(RequestReadError::protocol(
+            "invalid request line or route",
+            Some(request),
+        ));
+    }
+    let host = header(&request, "host")
+        .ok_or_else(|| RequestReadError::protocol("Host is required", Some(request.clone())))?;
+    if !is_valid_host(host) {
+        return Err(RequestReadError::protocol("invalid Host", Some(request)));
+    }
+    if request
+        .headers
+        .iter()
+        .any(|(name, _)| name == "transfer-encoding" || name == "content-encoding")
+    {
+        return Err(RequestReadError::protocol(
+            "transfer/content encoding is forbidden",
+            Some(request),
+        ));
+    }
+    let is_get = method == "GET";
+    let length = match header(&request, "content-length") {
+        Some(value) if is_canonical_decimal(value) => value
+            .parse::<usize>()
+            .map_err(|_| RequestReadError::protocol("invalid Content-Length", Some(request.clone())))?,
+        Some(_) => return Err(RequestReadError::protocol("invalid Content-Length", Some(request))),
+        None if is_get => 0,
+        None => {
+            return Err(RequestReadError::protocol(
+                "POST requires Content-Length",
+                Some(request),
+            ));
+        }
+    };
+    if length > MAX_BODY_BYTES || (is_get && length != 0) {
+        return Err(RequestReadError::protocol("invalid body length", Some(request)));
+    }
+    if is_get {
+        if header(&request, "content-type").is_some() {
+            return Err(RequestReadError::protocol(
+                "GET must not have Content-Type",
+                Some(request),
+            ));
+        }
+    } else if header(&request, "content-type") != Some("application/json") {
+        return Err(RequestReadError::protocol(
+            "POST Content-Type must be application/json",
+            Some(request),
+        ));
+    }
+    let mut body = bytes[header_end..].to_vec();
+    if body.len() > length {
+        let mut partial = request;
+        partial.body = body;
+        return Err(RequestReadError::protocol("body has trailing bytes", Some(partial)));
+    }
+    while body.len() < length {
+        let read = stream
+            .read(&mut chunk)
+            .await
+            .map_err(|error| RequestReadError::io(error, Some(request.clone())))?;
+        if read == 0 {
+            return Err(RequestReadError::protocol("truncated body", Some(request.clone())));
+        }
+        body.extend_from_slice(&chunk[..read]);
+        if body.len() > length {
+            let mut partial = request.clone();
+            partial.body = body;
+            return Err(RequestReadError::protocol("body has trailing bytes", Some(partial)));
+        }
+    }
+    let mut request = request;
+    request.body = body;
+    Ok(request)
+}
+
+fn request_is_signable(request: &HttpRequest) -> bool {
+    header(request, "x-shadowsocks-audit-node").is_some_and(|value| wire::validate_identifier(value, "node_id").is_ok())
+        && header(request, "x-shadowsocks-audit-nonce").is_some_and(|value| is_lower_hex(value, 32))
+}
+
+/// Best-effort extraction of authentication hints from an incomplete header
+/// block. This is used only for choosing whether a fixed `400` response may
+/// carry a MAC; it never turns an incomplete request into a routable request.
+/// Invalid or duplicate node/nonce fields deliberately make the hint
+/// ambiguous and suppress signing.
+fn request_hint_from_bytes(bytes: &[u8]) -> Option<HttpRequest> {
+    let limit = bytes.len().min(MAX_HEADER_BYTES);
+    let mut header_bytes = &bytes[..limit];
+    if let Some(index) = header_bytes.windows(4).position(|window| window == b"\r\n\r\n") {
+        header_bytes = &header_bytes[..index + 4];
+    }
+    let text = str::from_utf8(header_bytes).ok()?;
+    let mut lines = text.split("\r\n");
+    let request_line = lines.next().unwrap_or("");
+    let mut request_parts = request_line.split(' ');
+    let method = request_parts.next().unwrap_or("").to_owned();
+    let path = request_parts.next().unwrap_or("").to_owned();
+    let mut headers = Vec::new();
+    let mut seen_node = false;
+    let mut seen_nonce = false;
+    for line in lines {
+        if line.is_empty() {
+            break;
+        }
+        let Some((name, value)) = line.split_once(':') else {
+            if line_mentions_auth_hint(line) {
+                return None;
+            }
+            continue;
+        };
+        let lower = name.to_ascii_lowercase();
+        let is_auth_hint = is_auth_hint_name(name);
+        let valid_grammar = !name.is_empty()
+            && name.bytes().all(is_token_byte)
+            && value.starts_with(' ')
+            && value.len() > 1
+            && !value[1..].starts_with([' ', '\t'])
+            && !value.ends_with([' ', '\t'])
+            && !value.bytes().any(|byte| byte < 0x20 || byte == 0x7f || byte == b'\t');
+        if !valid_grammar {
+            if is_auth_hint {
+                return None;
+            }
+            continue;
+        }
+        if is_auth_hint {
+            let duplicate = match lower.as_str() {
+                "x-shadowsocks-audit-node" => {
+                    let duplicate = seen_node;
+                    seen_node = true;
+                    duplicate
+                }
+                _ => {
+                    let duplicate = seen_nonce;
+                    seen_nonce = true;
+                    duplicate
+                }
+            };
+            if duplicate {
+                return None;
+            }
+        }
+        headers.push((lower, value[1..].to_owned()));
+    }
+    Some(HttpRequest {
+        method,
+        path,
+        headers,
+        body: Vec::new(),
+    })
+}
+
+fn is_auth_hint_name(name: &str) -> bool {
+    let name = name.trim_matches([' ', '\t']);
+    matches!(
+        name.to_ascii_lowercase().as_str(),
+        "x-shadowsocks-audit-node" | "x-shadowsocks-audit-nonce"
+    )
+}
+
+fn line_mentions_auth_hint(line: &str) -> bool {
+    let name = line.split_once(':').map_or(line, |(name, _)| name);
+    is_auth_hint_name(name)
+}
+
+fn header<'a>(request: &'a HttpRequest, name: &str) -> Option<&'a str> {
+    request
+        .headers
+        .iter()
+        .find(|(key, _)| key == name)
+        .map(|(_, value)| value.as_str())
+}
+
+fn is_security_header(name: &str) -> bool {
+    matches!(name, "host" | "content-length" | "content-type" | "authorization")
+        || name.starts_with("x-shadowsocks-audit-")
+}
+
+fn map_route_error(error: SpoolError) -> (u16, &'static str) {
+    match error {
+        SpoolError::UnknownBatch => (404, "unknown_batch"),
+        SpoolError::BatchEvicted => (410, "batch_evicted"),
+        SpoolError::DigestMismatch => (409, "digest_mismatch"),
+        SpoolError::InvalidState(_)
+        | SpoolError::Protocol(_)
+        | SpoolError::Json(_)
+        | SpoolError::Io(_)
+        | SpoolError::SequenceExhausted
+        | SpoolError::StorageUnavailable => (500, "internal_error"),
+    }
+}
+
+fn reason_phrase(status: u16) -> &'static str {
+    match status {
+        200 => "OK",
+        204 => "No Content",
+        400 => "Bad Request",
+        401 => "Unauthorized",
+        404 => "Not Found",
+        409 => "Conflict",
+        410 => "Gone",
+        429 => "Too Many Requests",
+        500 => "Internal Server Error",
+        503 => "Service Unavailable",
+        _ => "Error",
+    }
+}
+
+fn is_token_byte(byte: u8) -> bool {
+    matches!(byte, b'!'..=b'~')
+        && !matches!(
+            byte,
+            b'(' | b')'
+                | b'<'
+                | b'>'
+                | b'@'
+                | b','
+                | b';'
+                | b':'
+                | b'\\'
+                | b'"'
+                | b'/'
+                | b'['
+                | b']'
+                | b'?'
+                | b'='
+                | b'{'
+                | b'}'
+                | b' '
+        )
+}
+
+/// Validate the HTTP `Host` value as the URI `host` grammar without letting the
+/// value influence routing.  Bare IPv6 literals are rejected; IPv6 and
+/// IPvFuture literals must use brackets and may carry an optional decimal
+/// port.  The reg-name branch intentionally follows RFC 3986 rather than
+/// imposing DNS-label rules: Host is metadata only and is never resolved here.
+fn is_valid_host(host: &str) -> bool {
+    if host.is_empty() || host.len() > 255 || !host.is_ascii() {
+        return false;
+    }
+    if host.starts_with('[') {
+        let Some(close) = host.find(']') else {
+            return false;
+        };
+        if close <= 1 || !is_valid_ip_literal(&host[1..close]) {
+            return false;
+        }
+        let rest = &host[close + 1..];
+        return rest.is_empty() || rest.strip_prefix(':').is_some_and(is_valid_port);
+    }
+    if host.matches(':').count() > 1 || host.contains(['[', ']']) {
+        return false;
+    }
+    let (name, port) = match host.split_once(':') {
+        Some((name, port)) => (name, Some(port)),
+        None => (host, None),
+    };
+    is_valid_reg_name(name) && port.is_none_or(is_valid_port)
+}
+
+fn is_valid_port(port: &str) -> bool {
+    !port.is_empty()
+        && port.len() <= 5
+        && port.bytes().all(|byte| byte.is_ascii_digit())
+        && port.parse::<u32>().is_ok_and(|value| value <= u16::MAX as u32)
+}
+
+fn is_valid_ip_literal(value: &str) -> bool {
+    value.parse::<Ipv6Addr>().is_ok() || is_valid_ipvfuture(value)
+}
+
+fn is_valid_ipvfuture(value: &str) -> bool {
+    let bytes = value.as_bytes();
+    if bytes.len() < 4 || !matches!(bytes[0], b'v' | b'V') {
+        return false;
+    }
+    let Some(dot) = bytes[1..].iter().position(|byte| *byte == b'.').map(|index| index + 1) else {
+        return false;
+    };
+    if dot == 1 || !bytes[1..dot].iter().all(|byte| byte.is_ascii_hexdigit()) || dot + 1 == bytes.len() {
+        return false;
+    }
+    bytes[dot + 1..]
+        .iter()
+        .all(|byte| is_unreserved(*byte) || is_subdelim(*byte) || *byte == b':')
+}
+
+fn is_valid_reg_name(value: &str) -> bool {
+    let bytes = value.as_bytes();
+    if bytes.is_empty() {
+        return false;
+    }
+    let mut index = 0;
+    while index < bytes.len() {
+        let byte = bytes[index];
+        if is_unreserved(byte) || is_subdelim(byte) {
+            index += 1;
+            continue;
+        }
+        if byte == b'%'
+            && index + 2 < bytes.len()
+            && bytes[index + 1].is_ascii_hexdigit()
+            && bytes[index + 2].is_ascii_hexdigit()
+        {
+            index += 3;
+            continue;
+        }
+        return false;
+    }
+    true
+}
+
+fn is_unreserved(byte: u8) -> bool {
+    byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'.' | b'_' | b'~')
+}
+
+fn is_subdelim(byte: u8) -> bool {
+    matches!(
+        byte,
+        b'!' | b'$' | b'&' | b'\'' | b'(' | b')' | b'*' | b'+' | b',' | b';' | b'='
+    )
+}
+
+fn is_lower_hex(value: &str, length: usize) -> bool {
+    value.len() == length
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+fn is_canonical_decimal(value: &str) -> bool {
+    !value.is_empty() && (value == "0" || (!value.starts_with('0') && value.bytes().all(|byte| byte.is_ascii_digit())))
+}
+
+fn peer_uid(stream: &UnixStream) -> io::Result<u32> {
+    let fd = stream.as_raw_fd();
+    let mut credential = libc::ucred { pid: 0, uid: 0, gid: 0 };
+    let mut length = std::mem::size_of::<libc::ucred>() as libc::socklen_t;
+    // SAFETY: the pointers refer to writable local storage of the documented size.
+    let result = unsafe {
+        libc::getsockopt(
+            fd,
+            libc::SOL_SOCKET,
+            libc::SO_PEERCRED,
+            (&mut credential as *mut libc::ucred).cast(),
+            &mut length,
+        )
+    };
+    if result != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if usize::try_from(length).ok() != Some(std::mem::size_of::<libc::ucred>()) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "SO_PEERCRED returned an unexpected credential size",
+        ));
+    }
+    Ok(credential.uid)
+}
+
+fn unix_seconds() -> Option<u64> {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|value| value.as_secs())
+        .ok()
+}
+
