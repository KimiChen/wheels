+//! Non-blocking successful-target access auditing for the server data path.
+//!
+//! The relay only constructs a small draft and performs bounded atomic/cache
+//! operations.  Serialization, socket I/O and retries live in the single
+//! supervisor task below.
+
+use std::{
+    collections::{HashMap, VecDeque},
+    fmt, io,
+    net::IpAddr,
+    path::PathBuf,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, AtomicU8, AtomicU64, AtomicUsize, Ordering},
+    },
+    time::{Duration, Instant, SystemTime, UNIX_EPOCH},
+};
+
+#[cfg(target_os = "linux")]
+use std::{
+    ffi::CString,
+    fs,
+    os::{
+        fd::AsRawFd,
+        unix::fs::{FileTypeExt, MetadataExt},
+    },
+};
+
+use crossbeam_queue::ArrayQueue;
+use serde::Serialize;
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    net::{UnixStream, unix::OwnedReadHalf, unix::OwnedWriteHalf},
+    sync::Notify,
+    time,
+};
+
+use shadowsocks_audit_protocol::{
+    EventNackCode, Hello, PermanentNackCode, normalize_domain, parse_canonical_record, parse_event_ack,
+    parse_event_nack, parse_hello_ack, parse_hello_nack, serialize_canonical,
+};
+
+use crate::config::{USER_AUDIT_UDP_WINDOW_SHARDS, UserAuditConfig};
+
+use super::user_stats::UserTrafficCounters;
+
+const CLOSED_BIT: u64 = 1u64 << 63;
+const ACTIVE_MASK: u64 = CLOSED_BIT - 1;
+const UDP_COOLDOWN: Duration = Duration::from_secs(60);
+const MAX_IN_FLIGHT: usize = 256;
+const MAX_FRAME_BYTES: usize = 8 * 1024;
+const ACK_TIMEOUT: Duration = Duration::from_secs(3);
+const MAX_EVENT_BYTES: usize = 8 * 1024;
+const INITIAL_RECONNECT_BACKOFF: Duration = Duration::from_millis(100);
+const MAX_RECONNECT_BACKOFF: Duration = Duration::from_secs(5);
+const MAX_RECONNECT_JITTER_PERCENT: u32 = 20;
+
+/// Marker carried by the `io::Error` returned for a non-retryable hello NACK.
+/// The wire contract gives this class a fixed five-second self-heal interval,
+/// unlike transport and socket validation failures that use jittered backoff.
+#[derive(Debug)]
+struct StickyHelloNack;
+
+impl fmt::Display for StickyHelloNack {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("non-retryable auditd hello NACK")
+    }
+}
+
+impl std::error::Error for StickyHelloNack {}
+
+/// Add a small positive jitter to the supervisor's reconnect delay.  The
+/// exponential backoff has a five-second base cap; jitter is applied after
+/// that cap so independently restarting producers do not synchronize at the
+/// ceiling (the largest resulting delay is six seconds).
+fn reconnect_delay(base: Duration) -> Duration {
+    let jitter_percent = rand::random_range(0..=MAX_RECONNECT_JITTER_PERCENT);
+    reconnect_delay_with_jitter(base, jitter_percent)
+}
+
+/// Deterministic form used by tests and kept separate from the RNG call above.
+fn reconnect_delay_with_jitter(base: Duration, jitter_percent: u32) -> Duration {
+    let base = base.min(MAX_RECONNECT_BACKOFF);
+    let jitter_percent = jitter_percent.min(MAX_RECONNECT_JITTER_PERCENT);
+    let base_nanos = base.as_nanos();
+    let jitter_nanos = base_nanos.saturating_mul(jitter_percent as u128) / 100;
+    let total_nanos = base_nanos.saturating_add(jitter_nanos);
+    // `base` is capped at five seconds, so this conversion cannot overflow;
+    // retain the clamp as a defensive guard if the constants change later.
+    Duration::from_nanos(total_nanos.min(u64::MAX as u128) as u64)
+}
+
+fn is_sticky_hello_nack(error: &io::Error) -> bool {
+    error
+        .get_ref()
+        .map(|cause| cause.is::<StickyHelloNack>())
+        .unwrap_or(false)
+}
+
+fn reconnect_delay_for_error(error: &io::Error, backoff: Duration) -> Duration {
+    if is_sticky_hello_nack(error) {
+        MAX_RECONNECT_BACKOFF
+    } else {
+        reconnect_delay(backoff)
+    }
+}
+
+fn reconnect_delay_for_error_with_jitter(error: &io::Error, backoff: Duration, jitter_percent: u32) -> Duration {
+    if is_sticky_hello_nack(error) {
+        MAX_RECONNECT_BACKOFF
+    } else {
+        reconnect_delay_with_jitter(backoff, jitter_percent)
+    }
+}
