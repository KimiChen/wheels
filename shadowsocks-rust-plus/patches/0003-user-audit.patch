+        // Without the escalation the daemon keeps running and every later
+        // append fails with InvalidState forever, so systemd never restarts it.
+        let follow_up = spool.append(&event(2), 2).expect_err("no write after the fatal state");
+        assert!(matches!(follow_up, SpoolError::DurabilityUncertain), "{follow_up:?}");
+        let fatal = spool.durability_uncertain_receiver();
+        tokio::time::timeout(Duration::from_secs(1), crate::wait_for_durability_uncertain(fatal))
+            .await
+            .expect("daemon fatal watcher notification");
