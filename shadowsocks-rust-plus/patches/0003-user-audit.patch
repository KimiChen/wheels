+#[derive(Clone, Debug)]
+pub enum AuditEventDraft {
+    Tcp {
+        sequence: u64,
+        occurred_at_unix_ms: u64,
+        runtime_monotonic_ms: u64,
+        runtime: Arc<AuditRuntimeMetadata>,
+        server: Arc<AuditServerMetadata>,
+        identity: Arc<AuditIdentityMetadata>,
+        target: AuditTargetDraft,
+    },
+    Udp {
+        sequence: u64,
+        occurred_at_unix_ms: u64,
+        runtime_monotonic_ms: u64,
+        runtime: Arc<AuditRuntimeMetadata>,
+        server: Arc<AuditServerMetadata>,
+        identity: Arc<AuditIdentityMetadata>,
+        association_id: [u8; 16],
+        target: AuditTargetDraft,
+    },
+    ProducerGap {
+        sequence: u64,
+        occurred_at_unix_ms: u64,
+        runtime: Arc<AuditRuntimeMetadata>,
+        reason: String,
+        permanent_nack_code: Option<String>,
+        dropped_events: u64,
