+pub(crate) fn prepare_socket_path_for(path: &Path, role: SocketRole) -> io::Result<()> {
+    let expected_gid = socket_parent_gid_for(path, role)?;
+    remove_stale_socket(path, expected_gid)
+}
+
+/// Remove a stale socket only after a failed local connect and a second inode
+/// check.  An active listener, a replacement object, and all non-socket paths
+/// fail closed rather than being overwritten.
+fn remove_stale_socket(path: &Path, expected_gid: u32) -> io::Result<()> {
+    let metadata = match fs::symlink_metadata(path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(()),
+        Err(error) => return Err(error),
+    };
+    validate_socket_metadata(&metadata, expected_gid)?;
+
+    match StdUnixStream::connect(path) {
+        Ok(_) => {
+            return Err(io::Error::new(io::ErrorKind::AddrInUse, "socket is already active"));
+        }
+        Err(error)
+            if matches!(
+                error.kind(),
+                io::ErrorKind::ConnectionRefused
+                    | io::ErrorKind::NotFound
+                    | io::ErrorKind::ConnectionReset
+                    | io::ErrorKind::ConnectionAborted
+                    | io::ErrorKind::BrokenPipe
+            ) => {}
+        Err(error) => return Err(error),
+    }
+
+    let current = match fs::symlink_metadata(path) {
+        Ok(current) => current,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(()),
+        Err(error) => return Err(error),
+    };
+    if !current.file_type().is_socket() || current.dev() != metadata.dev() || current.ino() != metadata.ino() {
+        return Err(io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            "socket path changed while checking staleness",
+        ));
+    }
+    fs::remove_file(path)?;
+    if let Some(parent) = path.parent() {
+        sync_dir(parent)?;
+    }
+    Ok(())
+}
+
+/// Apply and verify the owner/group/mode contract immediately after bind.
+pub(crate) fn secure_bound_socket(path: &Path) -> io::Result<()> {
+    let expected_gid = socket_parent_gid(path)?;
+    secure_bound_socket_with_gid(path, expected_gid)
+}
+
+pub(crate) fn secure_bound_socket_for(path: &Path, role: SocketRole) -> io::Result<()> {
+    let expected_gid = socket_parent_gid_for(path, role)?;
+    secure_bound_socket_with_gid(path, expected_gid)
+}
+
+fn secure_bound_socket_with_gid(path: &Path, expected_gid: u32) -> io::Result<()> {
+    let cpath = CString::new(path.as_os_str().as_bytes())
+        .map_err(|_| io::Error::new(io::ErrorKind::InvalidInput, "socket path contains NUL"))?;
+    let raw_fd = unsafe { libc::open(cpath.as_ptr(), libc::O_CLOEXEC | libc::O_NOFOLLOW | libc::O_PATH) };
+    if raw_fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: raw_fd is an owned descriptor returned by open(2).
+    let file = unsafe { File::from_raw_fd(raw_fd) };
+    let opened = file.metadata()?;
+    validate_socket_metadata(&opened, expected_gid).or_else(|error| {
+        if !opened.file_type().is_socket() || opened.uid() != current_euid() {
+            Err(error)
+        } else {
+            Ok(())
+        }
+    })?;
+    let result = unsafe {
+        libc::fchownat(
+            file.as_raw_fd(),
+            std::ptr::null(),
+            u32::MAX,
+            expected_gid,
+            libc::AT_EMPTY_PATH,
+        )
+    };
+    if result != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let result = unsafe {
+        libc::fchmodat(
+            file.as_raw_fd(),
+            std::ptr::null(),
+            SOCKET_MODE as _,
+            libc::AT_EMPTY_PATH,
+        )
+    };
+    if result != 0 {
+        let descriptor = format!("/proc/self/fd/{}", file.as_raw_fd());
+        fs::set_permissions(&descriptor, fs::Permissions::from_mode(SOCKET_MODE))?;
+    }
+    let opened = file.metadata()?;
+    validate_socket_metadata(&opened, expected_gid)?;
+    let current = fs::symlink_metadata(path)?;
+    validate_socket_metadata(&current, expected_gid)?;
+    if current.dev() != opened.dev() || current.ino() != opened.ino() {
+        return Err(io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            "socket path changed while setting permissions",
+        ));
+    }
+    Ok(())
+}
+
+pub(crate) fn validate_bound_socket(path: &Path) -> io::Result<()> {
+    let expected_gid = socket_parent_gid(path)?;
+    let metadata = fs::symlink_metadata(path)?;
+    validate_socket_metadata(&metadata, expected_gid)
+}
+
+pub(crate) fn validate_bound_socket_for(path: &Path, role: SocketRole) -> io::Result<()> {
+    let expected_gid = socket_parent_gid_for(path, role)?;
+    let metadata = fs::symlink_metadata(path)?;
+    validate_socket_metadata(&metadata, expected_gid)
+}
+
+pub(crate) fn remove_socket_path(path: &Path) -> io::Result<()> {
+    let expected_gid = socket_parent_gid(path)?;
+    match fs::symlink_metadata(path) {
+        Ok(metadata) => {
+            validate_socket_metadata(&metadata, expected_gid)?;
+            fs::remove_file(path)
+        }
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(()),
+        Err(error) => Err(error),
+    }
+}
+
+fn validate_socket_metadata(metadata: &fs::Metadata, expected_gid: u32) -> io::Result<()> {
+    if metadata.file_type().is_symlink() || !metadata.file_type().is_socket() {
+        return Err(io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            "socket path is not a Unix socket",
+        ));
+    }
+    if metadata.uid() != current_euid() || metadata.gid() != expected_gid {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket inode has an unexpected owner or group",
+        ));
+    }
+    if metadata.permissions().mode() & 0o7777 != SOCKET_MODE {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket inode has an unexpected mode",
+        ));
+    }
+    Ok(())
+}
+
+fn current_euid() -> u32 {
+    // SAFETY: geteuid has no preconditions and does not mutate memory.
+    unsafe { libc::geteuid() }
+}
+
+fn current_egid() -> u32 {
+    // SAFETY: getegid has no preconditions and does not mutate memory.
+    unsafe { libc::getegid() }
+}
+
+pub fn decode_hmac_key(bytes: &[u8]) -> Result<[u8; 32], String> {
+    let raw = match bytes.strip_suffix(b"\n") {
+        Some(raw) => raw,
+        None => bytes,
+    };
+    if raw.len() != 64
+        || raw
+            .iter()
+            .any(|byte| !byte.is_ascii_hexdigit() || byte.is_ascii_uppercase())
+    {
+        return Err("HMAC key must be exactly 64 lowercase hexadecimal characters with an optional LF".to_owned());
+    }
+    let decoded = hex::decode(raw).map_err(|_| "HMAC key is not valid hexadecimal".to_owned())?;
+    let mut key = [0_u8; 32];
+    if decoded.len() != key.len() {
+        return Err("HMAC key must decode to 32 bytes".to_owned());
+    }
+    key.copy_from_slice(&decoded);
+    Ok(key)
+}
+
+fn resolve_uid(name: &str) -> Option<u32> {
+    let cname = CString::new(name).ok()?;
+    let mut entry = std::mem::MaybeUninit::<libc::passwd>::uninit();
+    let mut buffer = vec![0_u8; 16 * 1024];
+    let mut result = std::ptr::null_mut();
+    // SAFETY: all pointers refer to valid writable buffers for libc's reentrant API.
+    let rc = unsafe {
+        libc::getpwnam_r(
+            cname.as_ptr(),
+            entry.as_mut_ptr(),
+            buffer.as_mut_ptr().cast(),
+            buffer.len(),
+            &mut result,
+        )
+    };
+    if rc != 0 || result.is_null() {
+        return None;
+    }
+    // SAFETY: result points at the initialized entry above when rc == 0.
+    let entry = unsafe { entry.assume_init() };
+    Some(entry.pw_uid)
+}
+
+fn resolve_gid(name: &str) -> Option<u32> {
+    let cname = CString::new(name).ok()?;
+    let mut entry = std::mem::MaybeUninit::<libc::group>::uninit();
+    let mut buffer = vec![0_u8; 16 * 1024];
+    let mut result = std::ptr::null_mut();
+    // SAFETY: all pointers refer to valid writable buffers for libc's
+    // reentrant group lookup API.
+    let rc = unsafe {
+        libc::getgrnam_r(
+            cname.as_ptr(),
+            entry.as_mut_ptr(),
+            buffer.as_mut_ptr().cast(),
+            buffer.len(),
+            &mut result,
+        )
+    };
+    if rc != 0 || result.is_null() {
+        return None;
+    }
+    // SAFETY: result points at the initialized entry above when rc == 0.
+    let entry = unsafe { entry.assume_init() };
+    Some(entry.gr_gid)
+}
