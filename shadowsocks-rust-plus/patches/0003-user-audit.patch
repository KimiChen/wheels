+        // still carries the exact number of events it holds.
+        fs::write(sealed[0].join("segment.ndjson"), b"corrupt\n").expect("corrupt body");
+        assert!(spool.lease().expect("lease").is_none());
+        let isolated = list_entries(&dir.path().join("quarantine")).expect("quarantine");
+        assert_eq!(isolated.len(), 1);
+        assert_eq!(lock(&spool.inner).evicted_unacked_records, 0);
+
+        {
+            let mut inner = lock(&spool.inner);
+            spool
+                .evict_quarantine_locked(&mut inner, &isolated[0])
+                .expect("quarantine eviction");
+        }
+        assert_eq!(
+            lock(&spool.inner).evicted_unacked_records,
+            2,
+            "quarantine eviction drops unacknowledged events as well"
+        );
+
+        // A crash between the delete barrier and the gap write is finished by
+        // recovery, which loses exactly the same records.
+        let pending = wire::EvictionPending::new(
+            "b".repeat(32),
+            "c".repeat(64),
+            unix_millis().expect("clock"),
+            format!("{GAP_ID_PREFIX}{}", "d".repeat(32)),
+            "capacity_eviction",
+            "e".repeat(32),
+            4096,
+            4099,
+            4,
+            512,
