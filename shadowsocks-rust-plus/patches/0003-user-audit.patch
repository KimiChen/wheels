+    #[test]
+    fn receipt_retention_follows_the_protocol_constant() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        let spool = Spool::open(config(dir.path())).expect("spool");
+        let now = unix_millis().expect("clock");
+        let window = wire::RECEIPT_RETENTION_SECONDS.saturating_mul(1_000);
+        let kept = "a".repeat(32);
+        let aged = "c".repeat(32);
+        let mut inner = lock(&spool.inner);
+        spool
+            .add_tombstone_locked(
+                &mut inner,
+                TombstoneEntry::AckedReceipt(wire::AckedReceipt::new(
+                    kept.clone(),
+                    "b".repeat(64),
+                    now - window + 3_600_000,
+                )),
+            )
+            .expect("receipt inside the window");
+        spool
+            .add_tombstone_locked(
+                &mut inner,
+                TombstoneEntry::AckedReceipt(wire::AckedReceipt::new(
+                    aged.clone(),
+                    "d".repeat(64),
+                    now - window - 3_600_000,
+                )),
+            )
+            .expect("receipt outside the window");
+        spool.prune_receipts_locked(&mut inner).expect("prune");
+        let retained: Vec<_> = inner
+            .tombstones
+            .iter()
+            .filter_map(|entry| entry.batch_id().map(str::to_owned))
+            .collect();
+        assert!(
+            retained.contains(&kept),
+            "a receipt one hour inside RECEIPT_RETENTION_SECONDS must be retained"
+        );
+        assert!(
+            !retained.contains(&aged),
+            "a receipt one hour past RECEIPT_RETENTION_SECONDS must be pruned"
+        );
+    }
