+    }
+
+    #[test]
+    fn paths_reject_variants() {
+        for path in ["relative.sock", "/a/../b", "/a/./b", "/a//b", "/a/b/"] {
+            assert!(validate_absolute_path(Path::new(path), "x").is_err(), "{path}");
+        }
+        let nul = PathBuf::from(std::ffi::OsString::from_vec(b"/a/with\0nul".to_vec()));
+        assert!(validate_absolute_path(&nul, "x").is_err());
+    }
+
+    #[test]
+    fn segment_bound_includes_newline() {
+        let mut config = AuditdConfig::default();
+        config.segment_max_bytes = (wire::MAX_SPOOL_RECORD_BYTES as u64).saturating_add(1);
+        assert!(config.validate().is_ok());
+        config.segment_max_bytes = wire::MAX_SPOOL_RECORD_BYTES as u64;
+        assert!(config.validate().is_err());
+    }
+
+    #[test]
+    fn key_requires_lowercase_hex() {
+        let mut key = Vec::from([b'0'; 64]);
+        assert!(decode_hmac_key(&key).is_ok());
+        key[0] = b'A';
+        assert!(decode_hmac_key(&key).is_err());
+        let mut with_lf = Vec::from([b'0'; 64]);
+        with_lf.push(b'\n');
+        assert!(decode_hmac_key(&with_lf).is_ok());
+    }
+
+    #[test]
+    fn config_rejects_unknown_fields_and_trailing_json() {
+        let mut value = serde_json::to_value(AuditdConfig::default()).expect("test serialization");
+        value["unexpected"] = serde_json::Value::Bool(true);
+        assert!(serde_json::from_value::<AuditdConfig>(value).is_err());
+
+        let dir = tempfile::tempdir().expect("tempdir");
+        let path = dir.path().join("auditd.json");
+        let mut file = std::fs::File::create(&path).expect("file");
+        write!(
+            file,
+            "{} {{}}",
+            serde_json::to_string(&AuditdConfig::default()).expect("json")
+        )
+        .expect("write");
+        assert!(AuditdConfig::load_from_file(&path).is_err());
+    }
+
+    #[test]
+    fn socket_lock_excludes_second_holder_until_drop() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        let socket = dir.path().join("export.sock");
+        let first = SocketLock::acquire(&socket).expect("first lock");
+        let error = SocketLock::acquire(&socket).expect_err("second lock must fail");
+        assert_eq!(error.kind(), io::ErrorKind::AddrInUse);
+        drop(first);
+        let _third = SocketLock::acquire(&socket).expect("lock after drop");
+    }
+
+    #[test]
+    fn socket_lock_detects_path_inode_replacement() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        let socket = dir.path().join("export.sock");
+        let first = SocketLock::acquire(&socket).expect("first lock");
+        let replacement = dir.path().join("replacement");
+        fs::rename(socket_lock_path(&socket), &replacement).expect("move original lock");
+        OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(socket_lock_path(&socket))
+            .expect("replacement lock");
+        let error = first.verify().expect_err("replacement must be rejected");
+        assert_eq!(error.kind(), io::ErrorKind::AlreadyExists);
+    }
+
+    #[test]
+    fn stale_socket_is_removed_after_refused_connect() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        fs::set_permissions(dir.path(), fs::Permissions::from_mode(SOCKET_DIRECTORY_MODE))
+            .expect("socket directory mode");
+        let path = dir.path().join("export.sock");
+        let listener = UnixListener::bind(&path).expect("bind");
+        fs::set_permissions(&path, fs::Permissions::from_mode(SOCKET_MODE)).expect("socket mode");
+        let gid = current_egid();
+        drop(listener);
+        remove_stale_socket(&path, gid).expect("remove stale socket");
+        assert!(!path.exists());
+    }
+
+    #[test]
+    fn active_socket_is_preserved() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        fs::set_permissions(dir.path(), fs::Permissions::from_mode(SOCKET_DIRECTORY_MODE))
+            .expect("socket directory mode");
+        let path = dir.path().join("export.sock");
+        let _listener = UnixListener::bind(&path).expect("bind");
+        fs::set_permissions(&path, fs::Permissions::from_mode(SOCKET_MODE)).expect("socket mode");
+        let error = remove_stale_socket(&path, current_egid()).expect_err("active socket must remain");
+        assert_eq!(error.kind(), io::ErrorKind::AddrInUse);
+        assert!(path.exists());
+    }
+}
