+    #[test]
+    fn open_segment_epoch_mismatch_isolates_the_open_bytes_and_starts_a_new_epoch() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        let spool = Spool::open(config(dir.path())).expect("spool");
+        spool.append(&event(1), 1).expect("append");
+        let open_epoch = lock(&spool.inner).epoch.clone();
+        drop(spool);
+
+        // Only the cursor's epoch changes.  The scanned high-water mark stays
+        // below `next_spool_sequence`, so §9.4's open/state epoch mismatch is
+        // the single criterion that can force a reset here.
+        let cursor_epoch = "0123456789abcdef0123456789abcdef";
+        let state = String::from_utf8(fs::read(dir.path().join("state.json")).expect("state")).expect("utf8 state");
+        assert!(state.contains(&open_epoch));
+        fs::write(dir.path().join("state.json"), state.replace(&open_epoch, cursor_epoch)).expect("rewrite cursor");
+
+        let spool = Spool::open(config(dir.path())).expect("recover");
+        let recovered = lock(&spool.inner).epoch.clone();
+        assert_ne!(recovered, open_epoch, "an open segment from another epoch is untrusted");
+        assert_ne!(
+            recovered, cursor_epoch,
+            "the mismatching cursor epoch must not be continued"
+        );
+        assert!(
+            fs::read_dir(dir.path().join("quarantine"))
+                .expect("quarantine")
+                .filter_map(Result::ok)
+                .any(|entry| entry.file_name().to_string_lossy().starts_with("state-reset-")),
+            "the old open bytes must be isolated before the epoch changes"
+        );
+
+        let records = drain_records(&spool);
+        assert_eq!(records.len(), 1, "only the state-reset gap belongs to the new epoch");
+        let wire::AuditRecord::SpoolGap(gap) = &records[0] else {
+            panic!("expected a spool gap, got {:?}", records[0]);
+        };
+        assert_eq!(gap.reason, wire::SpoolGapReason::StateReset);
+        assert_eq!(gap.lost_spool_epoch.as_deref(), Some(open_epoch.as_str()));
+    }
