+/// Join all pending task handles, removing each one immediately after its
+/// output is consumed. This makes cancellation by the outer timeout safe.
+async fn join_ready_tasks(tasks: &mut Vec<ServerHandle>) {
+    future::poll_fn(|cx| {
+        let mut index = 0;
+        while index < tasks.len() {
+            let result = {
+                let task = &mut tasks[index];
+                Pin::new(task).poll(cx)
+            };
+            if let Poll::Ready(_result) = result {
+                tasks.swap_remove(index);
+            } else {
+                index += 1;
+            }
+        }
+        if tasks.is_empty() {
+            Poll::Ready(())
+        } else {
+            Poll::Pending
+        }
+    })
+    .await
+}
