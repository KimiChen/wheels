+pub struct IngestFrame {
+    pub payload: Vec<u8>,
+}
+
+impl IngestFrame {
+    pub fn new(payload: Vec<u8>) -> Result<Self, ProtocolError> {
+        if payload.is_empty() || payload.len() > MAX_INGEST_FRAME_BYTES {
+            return Err(ProtocolError::InvalidFrame(
+                "payload length outside 1..=8192".to_owned(),
+            ));
+        }
+        Ok(Self { payload })
+    }
+
+    pub fn encode(&self) -> Result<Vec<u8>, ProtocolError> {
+        encode_frame(&self.payload)
+    }
+
+    pub fn decode(input: &[u8]) -> Result<Self, ProtocolError> {
+        Self::new(decode_frame(input)?.to_vec())
+    }
+}
