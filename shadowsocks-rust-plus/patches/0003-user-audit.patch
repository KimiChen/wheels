+    fn recovered_quarantine_eviction_counts_lost_records() {
+        fn pending(gap_suffix: &str, basename: &str, events: u64) -> wire::QuarantinePending {
+            wire::QuarantinePending::new(
+                format!("{GAP_ID_PREFIX}{}", gap_suffix.repeat(32)),
+                basename.to_owned(),
+                unix_millis().expect("clock"),
+                Some("b".repeat(32)),
+                Some("c".repeat(64)),
+                Some("e".repeat(32)),
+                Some(4096),
+                Some(4096 + events - 1),
+                Some(events),
+                Some(512),
+            )
+        }
+
+        let dir = tempfile::tempdir().expect("tempdir");
+        let spool = Spool::open(config(dir.path())).expect("spool");
+        let mut inner = lock(&spool.inner);
+        assert_eq!(inner.evicted_unacked_records, 0);
+
+        // The quarantine object is already gone: the crash happened after the
+        // delete barrier, so recovery only has to finish the gap and the ledger.
+        let mut corruption = pending("d", "batch-corrupt-1-aaaa", 5);
+        corruption.reason = "segment_corruption".to_owned();
+        spool
+            .add_tombstone_locked(&mut inner, TombstoneEntry::QuarantinePending(corruption))
+            .expect("segment_corruption pending");
+        spool.reconcile_tombstones_locked(&mut inner).expect("reconcile");
+        assert_eq!(
+            inner.evicted_unacked_records, 0,
+            "isolating a damaged batch destroys nothing"
+        );
+
+        spool
+            .add_tombstone_locked(
+                &mut inner,
+                TombstoneEntry::QuarantinePending(pending("a", "batch-corrupt-2-bbbb", 3)),
+            )
+            .expect("quarantine_eviction pending");
+        spool.reconcile_tombstones_locked(&mut inner).expect("reconcile");
+        assert_eq!(
+            inner.evicted_unacked_records, 3,
+            "a recovery-completed quarantine eviction loses unacknowledged records"
+        );
+
+        // The acked-source rule from `evict_quarantine_locked` holds here too.
+        spool
+            .add_tombstone_locked(
