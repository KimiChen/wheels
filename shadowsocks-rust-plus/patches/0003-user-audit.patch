+    #[test]
+    fn ensure_dir_rejects_symlink_components() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        let outside = tempfile::tempdir().expect("outside tempdir");
+        let link = dir.path().join("link");
+        std::os::unix::fs::symlink(outside.path(), &link).expect("symlink");
+
+        let error = ensure_dir(&link.join("child"), 0o700).expect_err("symlink must be rejected");
+        // The refusal errno depends on the open flags, not on the guarantee:
+        // `O_NOFOLLOW` alone reports ELOOP, but combined with `O_DIRECTORY`
+        // Linux reports ENOTDIR for the same rejected symlink (macOS likewise).
+        // Accept either spelling; the security property is the assertion below.
+        assert!(
+            error.kind() == io::ErrorKind::PermissionDenied
+                || error.raw_os_error() == Some(libc::ELOOP)
+                || error.raw_os_error() == Some(libc::ENOTDIR),
+            "unexpected refusal: kind={:?} raw={:?}",
+            error.kind(),
+            error.raw_os_error()
+        );
+        assert!(!outside.path().join("child").exists());
+    }
