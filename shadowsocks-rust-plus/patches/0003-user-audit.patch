+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn dedup_cache_distinguishes_payload_conflicts() {
+        let mut cache = DedupCache::new();
+        let ack = EventAck {
+            event_id: "id".to_owned(),
+            spool_epoch: "0".repeat(32),
+            spool_sequence: 1,
+        };
+        cache.insert("id".to_owned(), "a".to_owned(), ack.clone());
+        assert!(matches!(cache.get("id", "a"), DedupLookup::Same(_)));
+        assert!(matches!(cache.get("id", "b"), DedupLookup::Conflict));
+    }
+
+    #[test]
+    fn dedup_cache_hits_do_not_consume_live_capacity() {
+        let mut cache = DedupCache::with_capacity(4);
+        for sequence in 0..4 {
+            let event_id = format!("id-{sequence}");
+            cache.insert(
+                event_id.clone(),
+                format!("digest-{sequence}"),
+                EventAck {
+                    event_id,
+                    spool_epoch: "0".repeat(32),
+                    spool_sequence: sequence + 1,
+                },
+            );
+        }
+
+        for _ in 0..32 {
+            assert!(matches!(cache.get("id-3", "digest-3"), DedupLookup::Same(_)));
+        }
+        assert_eq!(cache.entries.len(), 4);
+        for sequence in 0..4 {
+            assert!(matches!(
+                cache.get(&format!("id-{sequence}"), &format!("digest-{sequence}")),
+                DedupLookup::Same(_)
+            ));
+        }
+
+        cache.insert(
+            "id-4".to_owned(),
+            "digest-4".to_owned(),
+            EventAck {
+                event_id: "id-4".to_owned(),
+                spool_epoch: "0".repeat(32),
+                spool_sequence: 5,
+            },
+        );
+        assert_eq!(cache.entries.len(), 4);
+        assert!(matches!(cache.get("id-0", "digest-0"), DedupLookup::Missing));
+        assert!(matches!(cache.get("id-3", "digest-3"), DedupLookup::Same(_)));
+    }
+
+    fn insert_default_entry(cache: &mut DedupCache, sequence: usize) {
+        let event_id = format!("default-id-{sequence}");
+        cache.insert(
+            event_id.clone(),
+            format!("default-digest-{sequence}"),
+            EventAck {
+                event_id,
+                spool_epoch: "0".repeat(32),
+                spool_sequence: sequence as u64,
+            },
+        );
+    }
+
+    #[test]
+    fn default_dedup_capacity_keeps_recency_index_bounded() {
+        let started = std::time::Instant::now();
+        let mut cache = DedupCache::new();
+        for sequence in 0..MAX_DEDUP_ENTRIES {
+            insert_default_entry(&mut cache, sequence);
+        }
+        assert_eq!(cache.entries.len(), MAX_DEDUP_ENTRIES);
+
+        // §8.3 keeps the most recent MAX_DEDUP_ENTRIES events, so the recency
+        // index must hold exactly one slot per live entry after *every* touch
+        // - not only after some periodic compaction pass.  A replay storm is
+        // nothing but repeated hits, and it must not grow this index at all.
+        for round in 0..(MAX_DEDUP_ENTRIES * 2) {
+            assert!(matches!(
+                cache.get("default-id-0", "default-digest-0"),
+                DedupLookup::Same(_)
+            ));
+            assert_eq!(
+                cache.order.len(),
+                cache.entries.len(),
+                "touch {round} left a second recency slot behind"
+            );
+        }
+        assert_eq!(cache.entries.len(), MAX_DEDUP_ENTRIES);
+
+        // Recency, not insertion order, decides eviction: the touched entry
+        // outlives a further wave of inserts while the untouched oldest
+        // entries are the ones that age out.
+        for sequence in MAX_DEDUP_ENTRIES..(MAX_DEDUP_ENTRIES + 1024) {
+            insert_default_entry(&mut cache, sequence);
+        }
+        assert_eq!(cache.entries.len(), MAX_DEDUP_ENTRIES);
+        assert_eq!(cache.order.len(), MAX_DEDUP_ENTRIES);
+        assert!(matches!(
+            cache.get("default-id-0", "default-digest-0"),
+            DedupLookup::Same(_)
+        ));
+        assert!(matches!(
+            cache.get("default-id-1", "default-digest-1"),
+            DedupLookup::Missing
+        ));
+        let newest = MAX_DEDUP_ENTRIES + 1023;
+        assert!(matches!(
+            cache.get(&format!("default-id-{newest}"), &format!("default-digest-{newest}")),
+            DedupLookup::Same(_)
+        ));
+
+        // The real capacity has to stay observable under the default debug
+        // profile; a per-hit full scan of the index needed minutes here.
+        assert!(
+            started.elapsed() < Duration::from_secs(60),
+            "dedup cache at real capacity took {:?}",
+            started.elapsed()
+        );
+    }
+
+    #[tokio::test]
+    async fn ingest_frame_reader_rejects_out_of_range_lengths() {
+        // These are the framing bounds the producer connection actually goes
+        // through; the check lives in `read_frame_payload` and is shared by
+        // the hello reader and the per-event reader.
+        let oversize = u32::try_from(MAX_AUDIT_PAYLOAD_BYTES + 1).expect("ceiling fits in u32");
+
+        let (mut server, mut client) = UnixStream::pair().expect("socket pair");
+        client.write_all(&0_u32.to_be_bytes()).await.expect("write header");
+        drop(client);
+        let error = read_frame_boundary(&mut server)
+            .await
+            .expect_err("zero-length frame must be rejected");
+        assert!(
+            matches!(&error, IngestError::Protocol(message) if message == "invalid frame length"),
+            "unexpected error: {error}"
+        );
+
+        let (mut server, mut client) = UnixStream::pair().expect("socket pair");
+        client.write_all(&oversize.to_be_bytes()).await.expect("write header");
+        drop(client);
+        let error = read_frame_boundary(&mut server)
+            .await
+            .expect_err("oversize frame must be rejected on the header alone");
+        assert!(
+            matches!(&error, IngestError::Protocol(message) if message == "invalid frame length"),
+            "unexpected error: {error}"
+        );
+
+        let (mut server, mut client) = UnixStream::pair().expect("socket pair");
+        client.write_all(&oversize.to_be_bytes()).await.expect("write header");
+        drop(client);
+        let error = read_frame_initial(&mut server)
+            .await
+            .expect_err("oversize hello frame must be rejected");
+        assert!(
+            matches!(&error, IngestError::Protocol(message) if message == "invalid frame length"),
+            "unexpected error: {error}"
+        );
+    }
+
+    #[tokio::test]
+    async fn ingest_frame_round_trip_accepts_the_maximum_payload() {
+        let (mut server, mut client) = UnixStream::pair().expect("socket pair");
+        let payload = vec![b'x'; MAX_AUDIT_PAYLOAD_BYTES];
+        // Read and write concurrently: one maximum frame is larger than the
+        // socket buffer on some platforms.
+        let (written, received) = tokio::join!(write_frame(&mut client, &payload), read_frame_boundary(&mut server));
+        written.expect("write maximum frame");
+        assert_eq!(received.expect("read frame"), Some(payload));
+
+        // The responder refuses exactly the sizes the reader refuses, so an
+        // auditd reply can never sit outside the producer's frame contract.
+        // Assert the specific rejection: a size that merely stalls the socket
+        // until the deadline would not prove the bound is enforced.
+        for oversize in [Vec::new(), vec![0_u8; MAX_AUDIT_PAYLOAD_BYTES + 1]] {
+            let error = write_frame(&mut client, &oversize)
+                .await
+                .expect_err("out-of-range response must be refused");
+            assert!(
+                matches!(&error, IngestError::Protocol(message) if message == "response too large"),
+                "unexpected error: {error}"
+            );
+        }
+    }
+
+    #[test]
+    fn hello_version_outside_u8_range_gets_unsupported_version_nack() {
+        let raw = br#"{"protocol_version":256,"frame_type":"hello","node_id":"node","runtime_id":"0123456789abcdef0123456789abcdef"}"#;
+        assert_eq!(parse_hello(raw), Err(Some(wire::HelloErrorCode::UnsupportedVersion)));
+        let raw = br#"{"protocol_version":18446744073709551615,"frame_type":"hello","node_id":"node","runtime_id":"0123456789abcdef0123456789abcdef"}"#;
+        assert_eq!(parse_hello(raw), Err(Some(wire::HelloErrorCode::UnsupportedVersion)));
+    }
+}
