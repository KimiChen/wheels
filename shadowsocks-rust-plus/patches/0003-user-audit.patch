+    /// Every `spool_gap` record that survives in durable storage, so a test can
+    /// tell "the transaction was completed" from "a second copy was appended".
+    fn durable_gap_ids(root: &Path) -> Vec<String> {
+        let mut paths = vec![root.join("open/current.ndjson")];
+        for parent in ["sealed", "acked"] {
+            if let Ok(batches) = list_batch_dirs(&root.join(parent)) {
+                paths.extend(batches.into_iter().map(|batch| batch.join("segment.ndjson")));
+            }
+        }
+        let mut found = Vec::new();
+        for path in paths {
+            let Ok(body) = fs::read(&path) else { continue };
+            for_each_spool_gap(&body, |gap| found.push(gap.event_id));
+        }
+        found
+    }
