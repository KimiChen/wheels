+    pub last_lost_spool_sequence: Option<u64>,
+    pub lost_events: Option<u64>,
+    pub lost_bytes: Option<u64>,
+    pub lost_batch_id: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
