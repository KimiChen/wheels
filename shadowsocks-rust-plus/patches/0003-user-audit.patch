+/// TCP success tracker shared by the two direction writer wrappers.
+pub struct TcpSuccessTracker {
+    bits: AtomicU8,
+    emitted: AtomicBool,
+    emitter: Arc<AuditEmitter>,
+    identity: Arc<AuditIdentityHandle>,
+    target: Option<AuditTargetDraft>,
+}
+
+impl TcpSuccessTracker {
+    pub fn new(emitter: Arc<AuditEmitter>, identity: Arc<AuditIdentityHandle>, target: AuditTargetDraft) -> Arc<Self> {
+        Self::new_optional(emitter, identity, Some(target))
+    }
+
+    pub fn new_optional(
+        emitter: Arc<AuditEmitter>,
+        identity: Arc<AuditIdentityHandle>,
+        target: Option<AuditTargetDraft>,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            bits: AtomicU8::new(0),
+            emitted: AtomicBool::new(false),
+            emitter,
+            identity,
+            target,
+        })
+    }
+
+    pub fn positive_write(&self, uplink: bool) {
+        let bit = if uplink { 0b01 } else { 0b10 };
+        let previous = self.bits.fetch_or(bit, Ordering::AcqRel);
+        if previous & bit == 0 && previous | bit == 0b11 && !self.emitted.swap(true, Ordering::AcqRel) {
+            if let Some(target) = self.target.clone() {
+                self.emitter.try_emit_tcp(&self.identity, target);
+            } else {
+                self.emitter.record_tcp_encode_error();
+            }
+        }
+    }
+}
