+/// Process-wide bounded UDP cooldown cache.
+pub struct UdpAuditWindowCache {
+    shards: Vec<Mutex<AuditWindowShard>>,
+    per_association: usize,
+    per_shard: usize,
+    poison_resets: AtomicU64,
+}
+
+impl UdpAuditWindowCache {
+    pub fn new(per_association: usize, total_windows: usize) -> Arc<Self> {
+        let per_shard = total_windows / USER_AUDIT_UDP_WINDOW_SHARDS;
+        let shards = (0..USER_AUDIT_UDP_WINDOW_SHARDS)
+            .map(|_| Mutex::new(AuditWindowShard::default()))
+            .collect();
+        Arc::new(Self {
+            shards,
+            per_association,
+            per_shard,
+            poison_resets: AtomicU64::new(0),
+        })
+    }
+
+    fn shard_index(association_id: &[u8; 16]) -> usize {
+        let prefix = u64::from_be_bytes([
+            association_id[0],
+            association_id[1],
+            association_id[2],
+            association_id[3],
+            association_id[4],
+            association_id[5],
+            association_id[6],
+            association_id[7],
+        ]);
+        (prefix & (USER_AUDIT_UDP_WINDOW_SHARDS as u64 - 1)) as usize
+    }
+
+    /// Return true when this successful send is eligible for an access event.
+    pub fn eligible(
+        &self,
+        server_id: &Arc<str>,
+        association_id: [u8; 16],
+        target: &AuditTargetDraft,
+        now: Instant,
+    ) -> Result<bool, ()> {
+        let index = Self::shard_index(&association_id);
+        let lock = self.shards.get(index).ok_or(())?;
+        let mut shard = match lock.try_lock() {
+            Ok(guard) => guard,
+            Err(std::sync::TryLockError::WouldBlock) => return Err(()),
+            Err(std::sync::TryLockError::Poisoned(poisoned)) => {
+                let mut guard = poisoned.into_inner();
+                guard.entries.clear();
+                guard.association_counts.clear();
+                lock.clear_poison();
+                self.poison_resets
+                    .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {
+                        Some(value.saturating_add(1))
+                    })
+                    .ok();
+                guard
+            }
+        };
+
+        shard.tick = shard.tick.saturating_add(1);
+        let tick = shard.tick;
+        let position = shard.entries.iter().position(|entry| {
+            entry.server_id.as_ref() == server_id.as_ref()
+                && entry.association_id == association_id
+                && entry.kind == target.kind
+                && entry.host == target.key_host()
+                && entry.port == target.port
+        });
+        if let Some(position) = position {
+            let mut entry = match shard.entries.remove(position) {
+                Some(entry) => entry,
+                None => return Ok(false),
+            };
+            let eligible = now.duration_since(entry.last_attempt) >= UDP_COOLDOWN;
+            entry.last_used = tick;
+            if eligible {
+                entry.last_attempt = now;
+            }
+            shard.entries.push_back(entry);
+            return Ok(eligible);
+        }
+
+        let association_key = (server_id.to_string(), association_id);
+        let count = shard.association_counts.get(&association_key).copied().unwrap_or(0);
+        if count >= self.per_association {
+            if let Some((oldest, _)) = shard
+                .entries
+                .iter()
+                .enumerate()
+                .filter(|(_, entry)| {
+                    entry.server_id.as_ref() == server_id.as_ref() && entry.association_id == association_id
+                })
+                .min_by_key(|(_, entry)| entry.last_used)
+            {
+                if let Some(removed) = shard.entries.remove(oldest) {
+                    let key = (removed.server_id.to_string(), removed.association_id);
+                    if let Some(value) = shard.association_counts.get_mut(&key) {
+                        *value = value.saturating_sub(1);
+                        if *value == 0 {
+                            shard.association_counts.remove(&key);
+                        }
+                    }
+                }
+            }
+        }
+        while shard.entries.len() >= self.per_shard {
+            let Some(removed) = shard.entries.pop_front() else {
+                break;
+            };
+            let key = (removed.server_id.to_string(), removed.association_id);
+            if let Some(value) = shard.association_counts.get_mut(&key) {
+                *value = value.saturating_sub(1);
+                if *value == 0 {
+                    shard.association_counts.remove(&key);
+                }
+            }
+        }
+        shard.entries.push_back(UdpWindowEntry {
+            server_id: server_id.clone(),
+            association_id,
+            host: target.key_host().to_owned(),
+            kind: target.kind.clone(),
+            port: target.port,
+            last_attempt: now,
+            last_used: tick,
+        });
+        *shard.association_counts.entry(association_key).or_insert(0) += 1;
+        Ok(true)
+    }
+
+    #[cfg(test)]
+    pub fn lengths(&self) -> (usize, usize) {
+        self.shards.iter().fold((0, 0), |(entries, associations), shard| {
+            let guard = shard.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
+            (
+                entries + guard.entries.len(),
+                associations + guard.association_counts.len(),
+            )
+        })
+    }
+
+    /// Number of poisoned-shard recoveries.  This is a saturating health
+    /// counter; recovery itself never rejects the successfully sent packet.
+    pub fn poison_reset_count(&self) -> u64 {
+        self.poison_resets.load(Ordering::Acquire)
+    }
+}
+
+pub(crate) struct ObservationGuard {
+    emitter: Arc<AuditEmitter>,
+}
+
+impl Drop for ObservationGuard {
+    fn drop(&mut self) {
+        let mut current = self.emitter.lifecycle_state.load(Ordering::Acquire);
+        loop {
+            let active = current & ACTIVE_MASK;
+            let next = (current & CLOSED_BIT) | active.saturating_sub(1);
+            match self
+                .emitter
+                .lifecycle_state
+                .compare_exchange_weak(current, next, Ordering::AcqRel, Ordering::Acquire)
+            {
+                Ok(_) => {
+                    if active <= 1 {
+                        self.emitter.notify.notify_waiters();
+                    }
+                    break;
+                }
+                Err(actual) => current = actual,
+            }
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum DiagnosticBucket {
+    QueueOverflow,
+    EncodeError,
+    PermanentNack(PermanentNackCode),
+    Contention,
+}
+
+impl DiagnosticBucket {
+    fn bit(self) -> u8 {
+        match self {
+            Self::QueueOverflow => 1 << 0,
+            Self::EncodeError => 1 << 1,
+            Self::PermanentNack(PermanentNackCode::InvalidSchema) => 1 << 2,
+            Self::PermanentNack(PermanentNackCode::EventIdConflict) => 1 << 3,
+            Self::PermanentNack(PermanentNackCode::RuntimeMismatch) => 1 << 4,
+            Self::Contention => 1 << 5,
+        }
+    }
+
+    fn permanent_code(self) -> Option<PermanentNackCode> {
+        match self {
+            Self::PermanentNack(code) => Some(code),
+            _ => None,
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+enum PendingKind {
+    Access {
+        sequence: u64,
+        occurred_at_unix_ms: u64,
+    },
+    Diagnostic {
+        bucket: DiagnosticBucket,
+        snapshot: GapSnapshot,
+    },
+}
+
+#[derive(Clone, Debug)]
+struct PendingEvent {
+    bytes: Vec<u8>,
+    event_id: String,
+    kind: PendingKind,
+}
+
+#[derive(Debug)]
+struct DiagnosticCandidate {
+    draft: AuditEventDraft,
+    bucket: DiagnosticBucket,
+    snapshot: GapSnapshot,
+}
+
+/// Shared process-level emitter and its bounded producer state.
+pub struct AuditEmitter {
+    pub runtime: Arc<AuditRuntimeMetadata>,
+    pub queue: Arc<ArrayQueue<AuditEventDraft>>,
+    pub notify: Arc<Notify>,
+    pub udp_windows: Arc<UdpAuditWindowCache>,
+    ingest_socket_path: PathBuf,
+    /// UID resolved from `user_audit.auditd_user` at emitter startup.  Keep
+    /// the result immutable across reconnects so name-service changes cannot
+    /// broaden the accepted peer identity during a process lifetime.
+    auditd_uid: Option<u32>,
+    audit_sequence: AtomicU64,
+    lifecycle_state: AtomicU64,
+    queue_overflow: GapAccumulator,
+    encode_error: GapAccumulator,
+    contention: GapAccumulator,
+    permanent_nack: [GapAccumulator; 3],
+    diagnostic_inflight: AtomicU8,
+    pending_count: AtomicU64,
+    shutdown_skipped_observations: AtomicU64,
+    sequence_exhausted: AtomicBool,
+    diagnostics_frozen: AtomicBool,
+    diagnostic_retry_requested: AtomicBool,
+    /// Set once shutdown has closed the producer and the final diagnostic
+    /// snapshot must bypass the normal 60-second cadence.
+    diagnostic_shutdown_requested: AtomicBool,
+    invalid_ack: AtomicU64,
+    /// Number of encode-error observations for which the wall clock could not
+    /// be represented.  The corresponding gap keeps its sequence but uses an
+    /// unknown time marker until a later snapshot can attach a valid clock.
+    encode_error_time_unknown: AtomicU64,
+    /// Number of diagnostic snapshots that had no valid current or previously
+    /// observed wall time and therefore had to remain pending.
+    diagnostic_time_unknown: AtomicU64,
+    udp_contention_time_unknown: AtomicU64,
+    /// Diagnostics which became unreportable after the final freeze barrier.
+    /// This is deliberately separate from `shutdown_skipped_observations`:
+    /// the latter counts observations rejected by a closed emitter, while
+    /// this counter covers already-owned queue/in-flight work that could not
+    /// be persisted before shutdown.
+    shutdown_diagnostic_drops: AtomicU64,
+    supervisor_stopped: AtomicBool,
+}
+
+impl AuditEmitter {
+    pub fn new(runtime: Arc<AuditRuntimeMetadata>, config: &UserAuditConfig) -> Arc<Self> {
+        Arc::new(Self {
+            runtime,
+            queue: Arc::new(ArrayQueue::new(config.queue_capacity)),
+            notify: Arc::new(Notify::new()),
+            udp_windows: UdpAuditWindowCache::new(
+                config.max_udp_targets_per_association,
+                config.max_udp_target_windows,
+            ),
+            ingest_socket_path: config.ingest_socket_path.clone(),
+            auditd_uid: resolve_user_uid(&config.auditd_user),
+            audit_sequence: AtomicU64::new(0),
+            lifecycle_state: AtomicU64::new(0),
+            queue_overflow: GapAccumulator::default(),
+            encode_error: GapAccumulator::default(),
+            contention: GapAccumulator::default(),
+            permanent_nack: std::array::from_fn(|_| GapAccumulator::default()),
+            diagnostic_inflight: AtomicU8::new(0),
+            pending_count: AtomicU64::new(0),
+            shutdown_skipped_observations: AtomicU64::new(0),
+            sequence_exhausted: AtomicBool::new(false),
+            diagnostics_frozen: AtomicBool::new(false),
+            diagnostic_retry_requested: AtomicBool::new(false),
+            diagnostic_shutdown_requested: AtomicBool::new(false),
+            invalid_ack: AtomicU64::new(0),
+            encode_error_time_unknown: AtomicU64::new(0),
+            diagnostic_time_unknown: AtomicU64::new(0),
+            udp_contention_time_unknown: AtomicU64::new(0),
+            shutdown_diagnostic_drops: AtomicU64::new(0),
+            supervisor_stopped: AtomicBool::new(false),
+        })
+    }
+
+    pub(crate) fn begin_observation(self: &Arc<Self>) -> Option<ObservationGuard> {
+        let mut current = self.lifecycle_state.load(Ordering::Acquire);
+        loop {
+            if current & CLOSED_BIT != 0 || current & ACTIVE_MASK == ACTIVE_MASK {
+                self.shutdown_skipped_observations
+                    .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {
+                        Some(value.saturating_add(1))
+                    })
+                    .ok();
+                return None;
+            }
+            let next = current + 1;
+            match self
+                .lifecycle_state
+                .compare_exchange_weak(current, next, Ordering::AcqRel, Ordering::Acquire)
+            {
+                Ok(_) => return Some(ObservationGuard { emitter: self.clone() }),
+                Err(actual) => current = actual,
+            }
+        }
+    }
+
+    pub fn close_emitter(&self) {
+        self.lifecycle_state.fetch_or(CLOSED_BIT, Ordering::AcqRel);
+        self.notify.notify_waiters();
+    }
+
+    pub async fn drain(&self) {
+        loop {
+            // Register before rechecking all state so a producer update cannot
+            // fall between the check and the await (the classic Notify lost
+            // wakeup race).
+            let notified = self.notify.notified();
+            let state = self.lifecycle_state.load(Ordering::Acquire);
+            if state & ACTIVE_MASK != 0 {
+                notified.await;
+                continue;
+            }
+            // After close and the last guard release, relay hooks can no
+            // longer mutate diagnostics. Freeze this boundary before judging
+            // queue/in-flight state.
+            if state & CLOSED_BIT != 0 {
+                // Freeze producer-side accumulators only after the final
+                // observation guard has gone away.  Ask the still-running
+                // supervisor for one final, rate-limit-bypassing pass.
+                if !self.diagnostics_frozen.swap(true, Ordering::AcqRel) {
+                    self.diagnostic_shutdown_requested.store(true, Ordering::Release);
+                    self.notify.notify_waiters();
+                }
+            }
+            if self.is_drained() {
+                return;
+            }
+            notified.await;
+        }
+    }
+
+    fn is_drained(&self) -> bool {
+        let state = self.lifecycle_state.load(Ordering::Acquire);
+        let diagnostics_empty = self.diagnostics_empty() || self.sequence_exhausted.load(Ordering::Acquire);
+        // A drain before `close_emitter` must not report a final snapshot:
+        // relay hooks could still allocate new observations immediately after
+        // the empty-state check.  The closed bit is the one-way freeze barrier.
+        state & CLOSED_BIT != 0
+            && state & ACTIVE_MASK == 0
+            && self.queue.is_empty()
+            && self.pending_count.load(Ordering::Acquire) == 0
+            // A diagnostic snapshot is removed from its accumulator before the
+            // supervisor reserves the pending slot.  Keep drain open across
+            // that small hand-off window so shutdown cannot abort the
+            // supervisor while the snapshot is still in flight.
+            && self.diagnostic_inflight.load(Ordering::Acquire) == 0
+            && diagnostics_empty
+    }
+
+    fn diagnostics_empty(&self) -> bool {
+        !self.queue_overflow.is_nonempty()
+            && !self.encode_error.is_nonempty()
+            && !self.contention.is_nonempty()
+            && self.permanent_nack.iter().all(|value| !value.is_nonempty())
+    }
+
+    pub fn shutdown_skipped_observations(&self) -> u64 {
+        self.shutdown_skipped_observations.load(Ordering::Acquire)
+    }
+
+    pub fn take_shutdown_skipped_observations(&self) -> u64 {
+        self.shutdown_skipped_observations.swap(0, Ordering::AcqRel)
+    }
+
+    fn record_shutdown_diagnostic_drop(&self, count: u64) {
+        saturating_add_atomic(&self.shutdown_diagnostic_drops, count);
+    }
+
+    pub(crate) fn take_shutdown_diagnostic_drops(&self) -> u64 {
+        self.shutdown_diagnostic_drops.swap(0, Ordering::AcqRel)
+    }
+
+    pub fn invalid_ack_count(&self) -> u64 {
+        self.invalid_ack.load(Ordering::Acquire)
+    }
+
+    /// Number of access observations abandoned because their event time could
+    /// not be represented.  This is a health signal, not an on-wire event
+    /// count; the associated sequence remains in the bounded encode-error
+    /// accumulator whenever the producer is still open.
+    pub fn encode_error_time_unknown_count(&self) -> u64 {
+        self.encode_error_time_unknown.load(Ordering::Acquire)
+    }
+
+    /// Number of diagnostic snapshots delayed because neither a current wall
+    /// clock nor a previously recorded `last_seen` value was available.
+    pub fn diagnostic_time_unknown_count(&self) -> u64 {
+        self.diagnostic_time_unknown.load(Ordering::Acquire)
+    }
+
+    pub fn sequence_exhausted(&self) -> bool {
+        self.sequence_exhausted.load(Ordering::Acquire)
+    }
+
+    /// Number of successful UDP sends whose contention timestamp could not be
+    /// represented because the wall clock was before the Unix epoch or did not
+    /// fit in the wire's millisecond field.  Such sends are deliberately kept
+    /// out of the on-wire contention accumulator instead of inventing a zero
+    /// timestamp.
+    pub fn udp_contention_time_unknown_count(&self) -> u64 {
+        self.udp_contention_time_unknown.load(Ordering::Acquire)
+    }
+
+    /// Number of UDP audit-window shard poison recoveries observed by this
+    /// process.  Exposed as a health counter without affecting forwarding.
+    pub fn udp_window_poison_reset_count(&self) -> u64 {
+        self.udp_windows.poison_reset_count()
+    }
+
+    #[cfg(test)]
+    fn pending_len(&self) -> u64 {
+        self.pending_count.load(Ordering::Acquire)
+    }
+
+    fn increment_pending(&self) {
+        self.pending_count.fetch_add(1, Ordering::AcqRel);
+        self.notify.notify_waiters();
+    }
+
+    fn decrement_pending(&self) {
+        self.pending_count
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {
+                Some(value.saturating_sub(1))
+            })
+            .ok();
+        self.notify.notify_waiters();
+    }
+
+    fn next_sequence(&self) -> Option<u64> {
+        let mut current = self.audit_sequence.load(Ordering::Acquire);
+        loop {
+            if current == u64::MAX {
+                if !self.sequence_exhausted.swap(true, Ordering::AcqRel) {
+                    log::warn!("user audit sequence exhausted");
+                }
+                return None;
+            }
+            let next = current.saturating_add(1);
+            match self
+                .audit_sequence
+                .compare_exchange_weak(current, next, Ordering::AcqRel, Ordering::Acquire)
+            {
+                Ok(_) => return Some(next),
+                Err(actual) => current = actual,
+            }
+        }
+    }
+
+    fn now(&self) -> Result<(u64, u64), ()> {
+        let wall = SystemTime::now().duration_since(UNIX_EPOCH).map_err(|_| ())?;
+        let occurred = wall.as_millis().try_into().map_err(|_| ())?;
+        let monotonic = self
+            .runtime
+            .runtime_started_at
+            .elapsed()
+            .as_millis()
+            .try_into()
+            .map_err(|_| ())?;
+        Ok((occurred, monotonic))
+    }
+
+    pub fn try_emit_tcp(self: &Arc<Self>, identity: &Arc<AuditIdentityHandle>, target: AuditTargetDraft) {
+        let Some(_guard) = self.begin_observation() else { return };
+        let Some(sequence) = self.next_sequence() else { return };
+        let (occurred, monotonic) = match self.now() {
+            Ok(value) => value,
+            Err(_) => {
+                self.record_encode_error(sequence);
+                return;
+            }
+        };
+        let draft = AuditEventDraft::Tcp {
+            sequence,
+            occurred_at_unix_ms: occurred,
+            runtime_monotonic_ms: monotonic,
+            runtime: identity.runtime.clone(),
+            server: identity.server.clone(),
+            identity: identity.identity.clone(),
+            target,
+        };
+        self.try_push(draft);
+    }
+
+    pub fn try_emit_udp(
+        self: &Arc<Self>,
+        identity: &Arc<AuditIdentityHandle>,
+        association_id: [u8; 16],
+        target: AuditTargetDraft,
+    ) {
+        let Some(_guard) = self.begin_observation() else { return };
+        let now = Instant::now();
+        let eligible = match self
+            .udp_windows
+            .eligible(&identity.server.server_id, association_id, &target, now)
+        {
+            Ok(value) => value,
+            Err(()) => {
+                self.record_contention_now();
+                return;
+            }
+        };
+        if !eligible {
+            return;
+        }
+        let Some(sequence) = self.next_sequence() else { return };
+        let (occurred, monotonic) = match self.now() {
+            Ok(value) => value,
+            Err(_) => {
+                self.record_encode_error(sequence);
+                return;
+            }
+        };
+        self.try_push(AuditEventDraft::Udp {
+            sequence,
+            occurred_at_unix_ms: occurred,
+            runtime_monotonic_ms: monotonic,
+            runtime: identity.runtime.clone(),
+            server: identity.server.clone(),
+            identity: identity.identity.clone(),
+            association_id,
+            target,
+        });
+    }
+
+    /// Account for a TCP observation whose target could not be represented.
+    ///
+    /// This consumes one audit sequence and records an encode gap while leaving
+    /// the relay data path unaffected.
+    pub fn record_tcp_encode_error(self: &Arc<Self>) {
+        let Some(_guard) = self.begin_observation() else { return };
+        let Some(sequence) = self.next_sequence() else { return };
+        self.record_encode_error(sequence);
+    }
+
+    fn record_encode_error(&self, sequence: u64) {
+        let timestamp = wall_now();
+        if timestamp.is_none() {
+            self.encode_error_time_unknown
+                .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {
+                    Some(value.saturating_add(1))
+                })
+                .ok();
+        }
+        if self.diagnostics_frozen.load(Ordering::Acquire) {
+            // The observation already owns a guard, but the shutdown freeze
+            // crossed before its event could be encoded.  It cannot be
+            // reintroduced into an accumulator that drain has closed.
+            self.record_shutdown_diagnostic_drop(1);
+        } else {
+            // `0` is an internal unknown-time marker only.  It is converted to
+            // a valid reporting time before a diagnostic reaches the wire.
+            self.encode_error.add(1, Some(sequence), timestamp.unwrap_or(0));
+        }
+        self.notify.notify_one();
+    }
+
+    fn try_push(&self, draft: AuditEventDraft) {
+        if let Some(dropped) = self.queue.force_push(draft) {
+            // `force_push` returns the old draft that was evicted.  Record
+            // that draft's sequence/time, never the newly inserted event.
+            if !self.diagnostics_frozen.load(Ordering::Acquire) {
+                self.queue_overflow
+                    .add(1, Some(dropped.sequence()), dropped.occurred_at_unix_ms());
+            } else {
+                // The producer-side accumulators are frozen after the last
+                // observation guard has drained.  A supervisor-side
+                // force-push can still cross that barrier, so retain an
+                // aggregate shutdown diagnostic instead of silently losing
+                // the evicted event.
+                self.record_shutdown_diagnostic_drop(1);
+            }
+        }
+        self.notify.notify_one();
+    }
+
+    pub fn record_contention(self: &Arc<Self>) {
+        let Some(_guard) = self.begin_observation() else { return };
+        self.record_contention_now();
+    }
+
+    fn record_contention_at(&self, now: u64) {
+        if !self.diagnostics_frozen.load(Ordering::Acquire) {
+            self.contention.add(1, None, now);
+        }
+        self.notify.notify_one();
+    }
+
+    fn record_contention_now(&self) {
+        match wall_now() {
+            Some(now) => self.record_contention_at(now),
+            None => {
+                if !self.diagnostics_frozen.load(Ordering::Acquire) {
+                    self.udp_contention_time_unknown
+                        .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {
+                            Some(value.saturating_add(1))
+                        })
+                        .ok();
+                }
+                self.notify.notify_one();
+            }
+        }
+    }
+
+    pub fn spawn_supervisor(self: &Arc<Self>) -> tokio::task::JoinHandle<()> {
+        let emitter = self.clone();
+        tokio::spawn(async move {
+            run_supervisor(emitter.clone()).await;
+            emitter.supervisor_stopped.store(true, Ordering::Release);
+            emitter.notify.notify_waiters();
+        })
+    }
+
+    fn take_diagnostic(&self) -> Option<DiagnosticCandidate> {
+        self.take_diagnostic_excluding(0)
+    }
+
+    /// Take one pending diagnostic, optionally excluding buckets that have
+    /// already had their one shutdown-final attempt.  A diagnostic that gets a
+    /// permanent NACK is merged back into its accumulator; excluding that
+    /// bucket for the remainder of this final pass prevents a tight retry loop
+    /// while still allowing other buckets to make a final attempt.
+    fn take_diagnostic_excluding(&self, excluded: u8) -> Option<DiagnosticCandidate> {
+        if self.sequence_exhausted.load(Ordering::Acquire) {
+            return None;
+        }
+
+        // Diagnostics live outside the access queue.  A bucket is blocked
+        // while its current snapshot is in-flight, so continuously arriving
+        // diagnostics cannot create an unbounded feedback loop or starve
+        // access events.
+        let buckets = [
+            DiagnosticBucket::QueueOverflow,
+            DiagnosticBucket::EncodeError,
+            DiagnosticBucket::PermanentNack(PermanentNackCode::InvalidSchema),
+            DiagnosticBucket::PermanentNack(PermanentNackCode::EventIdConflict),
+            DiagnosticBucket::PermanentNack(PermanentNackCode::RuntimeMismatch),
+            DiagnosticBucket::Contention,
+        ];
+        for bucket in buckets {
+            let bit = bucket.bit();
+            if excluded & bit != 0 {
+                continue;
+            }
+            // Claim the bucket before taking its accumulator snapshot.  This
+            // closes the hand-off window in which `take()` has removed the
+            // snapshot but the pending/in-flight marker has not yet been
+            // published, which would otherwise let drain return early.
+            if self.diagnostic_inflight.fetch_or(bit, Ordering::AcqRel) & bit != 0 {
+                continue;
+            }
+            let Some(snapshot) = self.accumulator(bucket).take() else {
+                self.diagnostic_inflight.fetch_and(!bit, Ordering::AcqRel);
+                continue;
+            };
+            // A diagnostic must never put a fabricated zero timestamp on the
+            // wire.  If the current clock is unavailable, an existing
+            // last-seen value is a valid fallback; when both are unknown,
+            // restore the snapshot and retry on a later cadence.
+            let occurred = match (wall_now(), snapshot.last_time) {
+                (Some(current), last_seen) => current.max(last_seen),
+                (None, last_seen) if last_seen != 0 => last_seen,
+                (None, _) => {
+                    self.diagnostic_time_unknown
+                        .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {
+                            Some(value.saturating_add(1))
+                        })
+                        .ok();
+                    if self.diagnostics_frozen.load(Ordering::Acquire) {
+                        self.record_shutdown_diagnostic_drop(snapshot.count);
+                    } else {
+                        self.accumulator(bucket).merge(snapshot);
+                        // Tell the supervisor to defer the next attempt.  A
+                        // missing wall clock must not turn the diagnostic
+                        // path into a zero-delay retry loop.
+                        self.diagnostic_retry_requested.store(true, Ordering::Release);
+                    }
+                    self.diagnostic_inflight.fetch_and(!bit, Ordering::AcqRel);
+                    self.notify.notify_waiters();
+                    continue;
+                }
+            };
+            let (first_seen, last_seen) = diagnostic_bounds(snapshot, occurred);
+            let Some(sequence) = self.next_sequence() else {
+                if self.diagnostics_frozen.load(Ordering::Acquire) {
+                    self.record_shutdown_diagnostic_drop(snapshot.count);
+                } else {
+                    self.accumulator(bucket).merge(snapshot);
+                }
+                self.diagnostic_inflight.fetch_and(!bit, Ordering::AcqRel);
+                return None;
+            };
+            let draft = if let Some(code) = bucket.permanent_code() {
+                AuditEventDraft::ProducerGap {
+                    sequence,
+                    occurred_at_unix_ms: occurred,
+                    runtime: self.runtime.clone(),
+                    reason: "permanent_nack".to_owned(),
+                    permanent_nack_code: Some(permanent_nack_code_text(code).to_owned()),
+                    dropped_events: snapshot.count,
+                    first_dropped_sequence: snapshot.first,
+                    last_dropped_sequence: snapshot.last,
+                    first_seen_unix_ms: first_seen,
+                    last_seen_unix_ms: last_seen,
+                }
+            } else if bucket == DiagnosticBucket::Contention {
+                AuditEventDraft::UdpContention {
+                    sequence,
+                    occurred_at_unix_ms: occurred,
+                    runtime: self.runtime.clone(),
+                    skipped_successful_datagrams: snapshot.count,
+                    first_seen_unix_ms: first_seen,
+                    last_seen_unix_ms: last_seen,
+                }
+            } else {
+                let reason = if bucket == DiagnosticBucket::QueueOverflow {
+                    "queue_overflow"
+                } else {
+                    // The only remaining non-contention bucket is encode_error.
+                    "encode_error"
+                };
+                AuditEventDraft::ProducerGap {
+                    sequence,
+                    occurred_at_unix_ms: occurred,
+                    runtime: self.runtime.clone(),
+                    reason: reason.to_owned(),
+                    permanent_nack_code: None,
+                    dropped_events: snapshot.count,
+                    first_dropped_sequence: snapshot.first,
+                    last_dropped_sequence: snapshot.last,
+                    first_seen_unix_ms: first_seen,
+                    last_seen_unix_ms: last_seen,
+                }
+            };
+            return Some(DiagnosticCandidate {
+                draft,
+                bucket,
+                snapshot,
+            });
+        }
+        None
+    }
+
+    fn accumulator(&self, bucket: DiagnosticBucket) -> &GapAccumulator {
+        match bucket {
+            DiagnosticBucket::QueueOverflow => &self.queue_overflow,
+            DiagnosticBucket::EncodeError => &self.encode_error,
+            DiagnosticBucket::PermanentNack(PermanentNackCode::InvalidSchema) => &self.permanent_nack[0],
+            DiagnosticBucket::PermanentNack(PermanentNackCode::EventIdConflict) => &self.permanent_nack[1],
+            DiagnosticBucket::PermanentNack(PermanentNackCode::RuntimeMismatch) => &self.permanent_nack[2],
+            DiagnosticBucket::Contention => &self.contention,
+        }
+    }
+
+    fn requeue_diagnostic(&self, candidate: DiagnosticCandidate) {
+        if self.diagnostics_frozen.load(Ordering::Acquire) {
+            // The final drain pass has already crossed the producer freeze
+            // barrier.  Re-adding a failed snapshot here would make drain
+            // wait forever (and could recursively manufacture another gap).
+            self.record_shutdown_diagnostic_drop(candidate.snapshot.count);
+        } else {
+            self.accumulator(candidate.bucket).merge(candidate.snapshot);
+        }
+        self.diagnostic_inflight
+            .fetch_and(!candidate.bucket.bit(), Ordering::AcqRel);
+        self.notify.notify_waiters();
+    }
+
+    fn resolve_pending(&self, event: &PendingEvent, permanent_nack: Option<EventNackCode>) {
+        if let PendingKind::Diagnostic { bucket, snapshot } = &event.kind {
+            self.diagnostic_inflight.fetch_and(!bucket.bit(), Ordering::AcqRel);
+            if permanent_nack.is_some() {
+                // A diagnostic rejection is not itself an additional gap;
+                // preserve the original snapshot for a later retry.
+                if self.diagnostics_frozen.load(Ordering::Acquire) {
+                    self.record_shutdown_diagnostic_drop(snapshot.count);
+                } else {
+                    self.accumulator(*bucket).merge(*snapshot);
+                    self.diagnostic_retry_requested.store(true, Ordering::Release);
+                }
+            }
+        } else if let Some(bucket) = permanent_nack.and_then(permanent_bucket) {
+            if let PendingKind::Access {
+                sequence,
+                occurred_at_unix_ms,
+            } = event.kind
+            {
+                if self.diagnostics_frozen.load(Ordering::Acquire) {
+                    self.record_shutdown_diagnostic_drop(1);
+                } else {
+                    self.accumulator(bucket).add(1, Some(sequence), occurred_at_unix_ms);
+                }
+            }
+        }
+        self.decrement_pending();
+    }
+
+    fn encode_pending(&self, draft: AuditEventDraft) -> Result<PendingEvent, ()> {
+        let bytes = draft.to_json().map_err(|_| ())?;
+        if bytes.is_empty() || bytes.len() > MAX_EVENT_BYTES || draft.is_diagnostic() {
+            return Err(());
+        }
+        let record = parse_canonical_record(&bytes).map_err(|_| ())?;
+        let event_id = draft.event_id();
+        if record.event_id() != event_id {
+            return Err(());
+        }
+        Ok(PendingEvent {
+            bytes,
+            event_id,
+            kind: PendingKind::Access {
+                sequence: draft.sequence(),
+                occurred_at_unix_ms: draft.occurred_at_unix_ms(),
+            },
+        })
+    }
+
+    fn encode_candidate(&self, candidate: DiagnosticCandidate) -> Result<PendingEvent, DiagnosticCandidate> {
+        let bytes = match candidate.draft.to_json() {
+            Ok(bytes) if !bytes.is_empty() && bytes.len() <= MAX_EVENT_BYTES => bytes,
+            _ => return Err(candidate),
+        };
+        let record = match parse_canonical_record(&bytes) {
+            Ok(record) => record,
+            Err(_) => return Err(candidate),
+        };
+        let event_id = candidate.draft.event_id();
+        if record.event_id() != event_id {
+            return Err(candidate);
+        }
+        Ok(PendingEvent {
+            bytes,
+            event_id,
+            kind: PendingKind::Diagnostic {
+                bucket: candidate.bucket,
+                snapshot: candidate.snapshot,
+            },
+        })
+    }
+}
+
+fn permanent_bucket(code: EventNackCode) -> Option<DiagnosticBucket> {
+    match code {
+        EventNackCode::InvalidSchema => Some(DiagnosticBucket::PermanentNack(PermanentNackCode::InvalidSchema)),
+        EventNackCode::EventIdConflict => Some(DiagnosticBucket::PermanentNack(PermanentNackCode::EventIdConflict)),
+        EventNackCode::RuntimeMismatch => Some(DiagnosticBucket::PermanentNack(PermanentNackCode::RuntimeMismatch)),
+        EventNackCode::StorageUnavailable | EventNackCode::InternalError => None,
+    }
+}
+
+fn permanent_nack_code_text(code: PermanentNackCode) -> &'static str {
+    match code {
+        PermanentNackCode::InvalidSchema => "invalid_schema",
+        PermanentNackCode::EventIdConflict => "event_id_conflict",
+        PermanentNackCode::RuntimeMismatch => "runtime_mismatch",
+    }
+}
+
+fn wall_now() -> Option<u64> {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .ok()
+        .and_then(|value| value.as_millis().try_into().ok())
+}
+
+/// Convert an accumulator snapshot into the required inclusive time range.
+/// Zero is the internal marker for an unknown boundary; it must never escape
+/// as an invented wire timestamp.  An unknown first boundary is conservatively
+/// collapsed to the known last boundary, while a known boundary is clamped to
+/// `occurred` so clock rollback cannot violate `first <= last <= occurred`.
+fn diagnostic_bounds(snapshot: GapSnapshot, occurred: u64) -> (u64, u64) {
+    let last_seen = if snapshot.last_time == 0 {
+        occurred
+    } else {
+        snapshot.last_time.min(occurred)
+    };
+    let first_seen = if snapshot.first_time == 0 {
+        last_seen
+    } else {
+        snapshot.first_time.min(last_seen)
+    };
+    (first_seen, last_seen)
+}
+
+async fn run_supervisor(emitter: Arc<AuditEmitter>) {
+    let mut pending: VecDeque<PendingEvent> = VecDeque::new();
+    let mut backoff = INITIAL_RECONNECT_BACKOFF;
+    let mut diagnostic_retry_after = Instant::now();
+    let mut force_final_diagnostics = false;
+    // During shutdown each diagnostic bucket gets at most one bypass-cadence
+    // attempt.  A permanent NACK or encoding failure is requeued, but must not
+    // be retried in a tight loop while the outer two-second drain deadline is
+    // running.
+    let mut final_diagnostic_attempted = 0u8;
+    loop {
+        if emitter.diagnostic_retry_requested.swap(false, Ordering::AcqRel) {
+            // A rejected diagnostic is retried, but never more often than the
+            // wire-level 60-second diagnostic cadence.
+            diagnostic_retry_after = diagnostic_retry_after.max(Instant::now() + Duration::from_secs(60));
+        }
+        if emitter.diagnostic_shutdown_requested.swap(false, Ordering::AcqRel) {
+            force_final_diagnostics = true;
+            final_diagnostic_attempted = 0;
+        }
+        while pending.len() < MAX_IN_FLIGHT {
+            if force_final_diagnostics || Instant::now() >= diagnostic_retry_after {
+                let candidate = if force_final_diagnostics {
+                    emitter.take_diagnostic_excluding(final_diagnostic_attempted)
+                } else {
+                    emitter.take_diagnostic()
+                };
+                if let Some(candidate) = candidate {
+                    if force_final_diagnostics {
+                        final_diagnostic_attempted |= candidate.bucket.bit();
+                    }
+                    // Reserve the in-flight slot before doing synchronous
+                    // serialization so drain cannot observe a transiently
+                    // empty queue and return early.
+                    emitter.increment_pending();
+                    match emitter.encode_candidate(candidate) {
+                        Ok(event) => {
+                            pending.push_back(event);
+                            // Reserve the next ordinary snapshot window when
+                            // this diagnostic is first taken.  A shutdown
+                            // pass may continue through the other buckets,
+                            // but it must not create an unbounded retry loop.
+                            diagnostic_retry_after = Instant::now() + Duration::from_secs(60);
+                        }
+                        Err(candidate) => {
+                            emitter.requeue_diagnostic(candidate);
+                            emitter.decrement_pending();
+                            // Avoid a tight retry loop if a diagnostic draft
+                            // cannot be represented on the wire.
+                            diagnostic_retry_after = Instant::now() + Duration::from_secs(60);
+                        }
+                    }
+                    continue;
+                }
+                if force_final_diagnostics {
+                    // There is no currently representable diagnostic left in
+                    // this final pass.  Further diagnostics would require a
+                    // new producer observation, which is forbidden after
+                    // `drain` freezes the accumulators.
+                    force_final_diagnostics = false;
+                }
+            }
+            // Claim the pending slot before touching the queue.  Without this
+            // reservation, drain could observe an empty queue in the tiny
+            // pop-to-increment window and return while the draft is still
+            // being serialized.
+            emitter.increment_pending();
+            let Some(draft) = emitter.queue.pop() else {
+                emitter.decrement_pending();
+                break;
+            };
+            let sequence = draft.sequence();
+            let occurred = draft.occurred_at_unix_ms();
+            match emitter.encode_pending(draft) {
+                Ok(event) => {
+                    pending.push_back(event);
+                }
+                Err(()) => {
+                    // A popped draft is now irrevocably abandoned; retain its
+                    // sequence and event time in the encode-error bucket.  A
+                    // shutdown freeze is a one-way barrier, so this late
+                    // failure is counted locally instead of reintroducing a
+                    // diagnostic that drain can never flush.
+                    if emitter.diagnostics_frozen.load(Ordering::Acquire) {
+                        emitter.record_shutdown_diagnostic_drop(1);
+                    } else {
+                        emitter.encode_error.add(1, Some(sequence), occurred);
+                    }
+                    emitter.decrement_pending();
+                    emitter.notify.notify_one();
+                }
+            }
+        }
+
+        if pending.is_empty() {
+            let closed = emitter.lifecycle_state.load(Ordering::Acquire) & CLOSED_BIT != 0;
+            if closed
+                && emitter.lifecycle_state.load(Ordering::Acquire) & ACTIVE_MASK == 0
+                && emitter.queue.is_empty()
+                && (emitter.diagnostics_empty() || emitter.sequence_exhausted.load(Ordering::Acquire))
+                && emitter.pending_count.load(Ordering::Acquire) == 0
+            {
+                break;
+            }
+            // Register before the second check to avoid losing a notification
+            // published by a relay between the two operations.
+            let notified = emitter.notify.notified();
+            if !emitter.queue.is_empty() {
+                continue;
+            }
+            let diagnostics_pending =
+                !emitter.sequence_exhausted.load(Ordering::Acquire) && !emitter.diagnostics_empty();
+            let closed_with_active = emitter.lifecycle_state.load(Ordering::Acquire) & ACTIVE_MASK != 0;
+            if diagnostics_pending && Instant::now() >= diagnostic_retry_after {
+                continue;
+            }
+            if closed_with_active {
+                tokio::select! {
+                    _ = notified => {}
+                    _ = time::sleep(Duration::from_millis(100)) => {}
+                }
+                continue;
+            }
+            let wait_for_diagnostic = if diagnostics_pending {
+                diagnostic_retry_after.saturating_duration_since(Instant::now())
+            } else {
+                Duration::from_secs(60)
+            };
+            tokio::select! {
+                _ = notified => {}
+                _ = time::sleep(wait_for_diagnostic) => {}
+            }
+            continue;
+        }
+
+        match connect_and_send(&emitter, &mut pending).await {
+            Ok(()) => {
+                backoff = INITIAL_RECONNECT_BACKOFF;
+            }
+            Err(error) => {
+                let sticky_hello_nack = is_sticky_hello_nack(&error);
+                // Socket/UID validation failures are ordinary connection
+                // failures and follow the same exponential backoff as other
+                // transport errors. Only a parsed non-retryable hello NACK
+                // uses the fixed five-second self-heal interval.
+                let base_delay = backoff;
+                let delay = reconnect_delay_for_error(&error, backoff);
+                time::sleep(delay).await;
+                if !sticky_hello_nack && base_delay < MAX_RECONNECT_BACKOFF {
+                    backoff = (base_delay * 2).min(MAX_RECONNECT_BACKOFF);
+                }
+            }
+        }
+    }
+}
+
+async fn connect_and_send(emitter: &AuditEmitter, pending: &mut VecDeque<PendingEvent>) -> io::Result<()> {
+    #[cfg(target_os = "linux")]
+    let auditd_uid = emitter.auditd_uid.ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "configured auditd user could not be resolved",
+        )
+    })?;
+    #[cfg(target_os = "linux")]
+    validate_audit_socket_inode(&emitter.ingest_socket_path, auditd_uid)?;
+    let stream = time::timeout(ACK_TIMEOUT, UnixStream::connect(&emitter.ingest_socket_path))
+        .await
+        .map_err(|_| io::Error::new(io::ErrorKind::TimedOut, "audit socket connect timed out"))??;
+    #[cfg(target_os = "linux")]
+    {
+        // Re-check the pathname after connect to close the common unlink/
+        // replace race, then authenticate the connected peer itself.
+        validate_audit_socket_inode(&emitter.ingest_socket_path, auditd_uid)?;
+        let peer_uid = audit_peer_uid(&stream)?;
+        if peer_uid != auditd_uid {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "auditd peer UID does not match configured auditd user",
+            ));
+        }
+    }
+    let (mut reader, mut writer) = stream.into_split();
+    let hello = Hello::new(emitter.runtime.node_id.as_ref(), emitter.runtime.runtime_id.as_ref());
+    let hello_bytes = serialize_canonical(&hello).map_err(|error| io::Error::other(error.to_string()))?;
+    write_frame_with_deadline(&mut writer, &hello_bytes).await?;
+    let response = read_frame_with_deadline(&mut reader).await?;
+    if parse_hello_ack(&response).is_err() {
+        match parse_hello_nack(&response) {
+            Ok(nack) if nack.retryable => {
+                return Err(io::Error::new(
+                    io::ErrorKind::WouldBlock,
+                    "auditd producer hello is busy",
+                ));
+            }
+            Ok(_) => {
+                return Err(io::Error::new(io::ErrorKind::PermissionDenied, StickyHelloNack));
+            }
+            Err(_) => {
+                emitter.invalid_ack.fetch_add(1, Ordering::AcqRel);
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "invalid audit hello response",
+                ));
+            }
+        }
+    }
+    while let Some(event) = pending.front() {
+        write_frame_with_deadline(&mut writer, &event.bytes).await?;
+        let response = read_frame_with_deadline(&mut reader).await?;
+        if let Ok(ack) = parse_event_ack(&response) {
+            if ack.event_id != event.event_id {
+                emitter.invalid_ack.fetch_add(1, Ordering::AcqRel);
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "auditd ACK event ID mismatch",
+                ));
+            }
+            if let Some(resolved) = pending.pop_front() {
+                emitter.resolve_pending(&resolved, None);
+            }
+            continue;
+        }
+        if let Ok(nack) = parse_event_nack(&response) {
+            if nack.event_id != event.event_id {
+                emitter.invalid_ack.fetch_add(1, Ordering::AcqRel);
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "auditd NACK event ID mismatch",
+                ));
+            }
+            if nack.retryable {
+                // Preserve the front item and every following item exactly as
+                // queued; the supervisor will reconnect and replay them.
+                return Err(io::Error::new(io::ErrorKind::WouldBlock, "retryable audit NACK"));
+            }
+            if permanent_bucket(nack.error_code).is_none() {
+                emitter.invalid_ack.fetch_add(1, Ordering::AcqRel);
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "unsupported permanent audit NACK",
+                ));
+            }
+            if let Some(resolved) = pending.pop_front() {
+                emitter.resolve_pending(&resolved, Some(nack.error_code));
+            }
+            continue;
+        }
+
+        emitter.invalid_ack.fetch_add(1, Ordering::AcqRel);
+        return Err(io::Error::new(io::ErrorKind::InvalidData, "invalid audit ACK/NACK"));
+    }
+    Ok(())
+}
+
+/// Resolve the configured audit daemon account once when the process emitter
+/// is built.  A missing account is represented as `None`; the supervisor then
+/// treats every connection attempt as a degraded, retryable failure without
+/// touching the relay path.
+#[cfg(target_os = "linux")]
+fn resolve_user_uid(name: &str) -> Option<u32> {
+    let cname = CString::new(name).ok()?;
+    let mut entry = std::mem::MaybeUninit::<libc::passwd>::uninit();
+    let mut buffer = vec![0_u8; 16 * 1024];
+    let mut result = std::ptr::null_mut();
+    // SAFETY: pointers refer to valid storage for getpwnam_r's documented API.
+    let rc = unsafe {
+        libc::getpwnam_r(
+            cname.as_ptr(),
+            entry.as_mut_ptr(),
+            buffer.as_mut_ptr().cast(),
+            buffer.len(),
+            &mut result,
+        )
+    };
+    if rc != 0 || result.is_null() {
+        return None;
+    }
+    // SAFETY: a non-null result with rc == 0 indicates initialized storage.
+    Some(unsafe { entry.assume_init() }.pw_uid)
+}
+
+#[cfg(not(target_os = "linux"))]
+fn resolve_user_uid(_name: &str) -> Option<u32> {
+    None
+}
+
+#[cfg(target_os = "linux")]
+fn validate_audit_socket_inode(path: &std::path::Path, expected_uid: u32) -> io::Result<()> {
+    let metadata = fs::symlink_metadata(path)?;
+    if !metadata.file_type().is_socket() {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "audit ingest path is not a Unix socket",
+        ));
+    }
+    if metadata.uid() != expected_uid {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "audit ingest socket owner does not match configured auditd user",
+        ));
+    }
+    Ok(())
+}
+
+#[cfg(target_os = "linux")]
+fn audit_peer_uid(stream: &UnixStream) -> io::Result<u32> {
+    let fd = stream.as_raw_fd();
+    let mut credential = libc::ucred { pid: 0, uid: 0, gid: 0 };
+    let mut length = std::mem::size_of::<libc::ucred>() as libc::socklen_t;
+    // SAFETY: pointers refer to writable local storage of the documented size.
+    let result = unsafe {
+        libc::getsockopt(
+            fd,
+            libc::SOL_SOCKET,
+            libc::SO_PEERCRED,
+            (&mut credential as *mut libc::ucred).cast(),
+            &mut length,
+        )
+    };
+    if result != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if usize::try_from(length).ok() != Some(std::mem::size_of::<libc::ucred>()) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "SO_PEERCRED returned an unexpected credential size",
+        ));
+    }
+    Ok(credential.uid)
+}
+
+async fn write_frame(writer: &mut OwnedWriteHalf, payload: &[u8]) -> io::Result<()> {
+    if payload.is_empty() || payload.len() > MAX_FRAME_BYTES {
+        return Err(io::Error::new(io::ErrorKind::InvalidInput, "audit frame too large"));
+    }
+    let len =
+        u32::try_from(payload.len()).map_err(|_| io::Error::new(io::ErrorKind::InvalidInput, "audit frame length"))?;
+    writer.write_all(&len.to_be_bytes()).await?;
+    writer.write_all(payload).await
+}
+
+/// Apply the producer's per-frame write deadline.  The deadline covers the
+/// complete length prefix and payload, including partial writes; a timeout
+/// leaves the corresponding in-flight bytes untouched so the supervisor can
+/// reconnect and replay them verbatim.
+async fn write_frame_with_deadline(writer: &mut OwnedWriteHalf, payload: &[u8]) -> io::Result<()> {
+    time::timeout(ACK_TIMEOUT, write_frame(writer, payload))
+        .await
+        .map_err(|_| io::Error::new(io::ErrorKind::TimedOut, "audit frame write timed out"))??;
+    Ok(())
+}
+
+async fn read_frame(reader: &mut OwnedReadHalf) -> io::Result<Vec<u8>> {
+    let mut length = [0u8; 4];
+    reader.read_exact(&mut length).await?;
+    let len = u32::from_be_bytes(length) as usize;
+    if len == 0 || len > MAX_FRAME_BYTES {
+        return Err(io::Error::new(io::ErrorKind::InvalidData, "invalid audit frame length"));
+    }
+    let mut payload = vec![0u8; len];
+    reader.read_exact(&mut payload).await?;
+    Ok(payload)
+}
+
+/// Apply the producer's per-response read deadline.  This is deliberately
+/// separate from `read_frame`: tests and the auditd-side framing parser use
+/// the raw helper, while the producer must bound every hello/ACK response.
+async fn read_frame_with_deadline(reader: &mut OwnedReadHalf) -> io::Result<Vec<u8>> {
+    time::timeout(ACK_TIMEOUT, read_frame(reader))
+        .await
+        .map_err(|_| io::Error::new(io::ErrorKind::TimedOut, "audit frame read timed out"))?
+}
