+                    "queue_overflow" => ProducerGapReason::QueueOverflow,
+                    "encode_error" => ProducerGapReason::EncodeError,
+                    "permanent_nack" => ProducerGapReason::PermanentNack,
+                    _ => {
+                        return Err(shadowsocks_audit_protocol::ProtocolError::InvalidField {
+                            field: "reason".to_owned(),
+                            reason: "unknown producer gap reason".to_owned(),
+                        });
+                    }
+                };
+                let permanent_nack_code = permanent_nack_code
+                    .as_deref()
+                    .map(|code| match code {
+                        "invalid_schema" => Ok(PermanentNackCode::InvalidSchema),
+                        "event_id_conflict" => Ok(PermanentNackCode::EventIdConflict),
+                        "runtime_mismatch" => Ok(PermanentNackCode::RuntimeMismatch),
+                        _ => Err(shadowsocks_audit_protocol::ProtocolError::InvalidField {
+                            field: "permanent_nack_code".to_owned(),
+                            reason: "unknown permanent NACK code".to_owned(),
+                        }),
+                    })
+                    .transpose()?;
+                Ok(AuditRecord::ProducerGap(ProducerGap {
+                    schema_version: shadowsocks_audit_protocol::SCHEMA_VERSION,
+                    record_type: "diagnostic".to_owned(),
+                    event_type: "producer_gap".to_owned(),
+                    event_id: format!("{}:{sequence}", runtime.runtime_id),
+                    audit_sequence: DecimalU64::from(*sequence),
+                    occurred_at_unix_ms: DecimalU64::from(*occurred_at_unix_ms),
+                    node_id: runtime.node_id.to_string(),
+                    runtime_id: runtime.runtime_id.to_string(),
+                    reason,
+                    permanent_nack_code,
+                    dropped_events: DecimalU64::from(*dropped_events),
+                    first_dropped_sequence: first_dropped_sequence.map(|value| DecimalU64::from(value)),
+                    last_dropped_sequence: last_dropped_sequence.map(|value| DecimalU64::from(value)),
+                    first_seen_unix_ms: DecimalU64::from(*first_seen_unix_ms),
+                    last_seen_unix_ms: DecimalU64::from(*last_seen_unix_ms),
+                }))
+            }
+            Self::UdpContention {
+                sequence,
+                occurred_at_unix_ms,
+                runtime,
+                skipped_successful_datagrams,
+                first_seen_unix_ms,
+                last_seen_unix_ms,
+            } => Ok(AuditRecord::UdpWindowContention(UdpWindowContention {
+                schema_version: shadowsocks_audit_protocol::SCHEMA_VERSION,
+                record_type: "diagnostic".to_owned(),
+                event_type: "udp_window_contention".to_owned(),
+                event_id: format!("{}:{sequence}", runtime.runtime_id),
+                audit_sequence: DecimalU64::from(*sequence),
+                occurred_at_unix_ms: DecimalU64::from(*occurred_at_unix_ms),
+                node_id: runtime.node_id.to_string(),
+                runtime_id: runtime.runtime_id.to_string(),
+                skipped_successful_datagrams: DecimalU64::from(*skipped_successful_datagrams),
+                first_seen_unix_ms: DecimalU64::from(*first_seen_unix_ms),
+                last_seen_unix_ms: DecimalU64::from(*last_seen_unix_ms),
+            })),
+        }
+    }
+    /// Serialize using the protocol crate's sole canonical record serializer.
+    pub fn to_json(&self) -> Result<Vec<u8>, shadowsocks_audit_protocol::ProtocolError> {
+        serialize_canonical_record(&self.to_record()?)
+    }
+}
+
+fn encode_hex(bytes: &[u8; 16]) -> String {
+    let mut out = String::with_capacity(32);
+    for byte in bytes {
+        use std::fmt::Write as _;
+        let _ = write!(&mut out, "{byte:02x}");
+    }
+    out
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+struct GapSnapshot {
+    count: u64,
+    first: Option<u64>,
+    last: Option<u64>,
+    first_time: u64,
+    last_time: u64,
+}
+
+const GAP_FIRST_UNKNOWN: u8 = 1 << 0;
+const GAP_LAST_UNKNOWN: u8 = 1 << 1;
+const GAP_FIRST_TIME_UNKNOWN: u8 = 1 << 2;
+const GAP_LAST_TIME_UNKNOWN: u8 = 1 << 3;
+
+fn gap_unknown_mask(snapshot: GapSnapshot) -> u8 {
+    let mut mask = 0;
+    // The wire contract requires first/last sequence to be jointly present
+    // or jointly null.  Treat a partial input as unknown on both sides so a
+    // later merge cannot manufacture an invalid half-known range.
+    if snapshot.first.is_none() || snapshot.last.is_none() {
+        mask |= GAP_LAST_UNKNOWN;
+        mask |= GAP_FIRST_UNKNOWN;
+    }
+    if snapshot.first_time == 0 {
+        mask |= GAP_FIRST_TIME_UNKNOWN;
+    }
+    if snapshot.last_time == 0 {
+        mask |= GAP_LAST_TIME_UNKNOWN;
+    }
+    mask
+}
+
+/// A fixed set of tiny seqlock slots used by the relay-facing diagnostic
+/// accumulators.  A relay never waits for a mutex: it claims any currently
+/// free slot with one CAS and updates all fields while that slot is odd.  The
+/// supervisor takes each slot under the same seqlock and combines the stable
+/// snapshots, so count and boundary fields cannot be mixed across an `add`.
+const GAP_ACCUMULATOR_SLOTS: usize = 8;
+
+#[derive(Default)]
+struct GapSlot {
+    sequence: AtomicU64,
+    count: AtomicU64,
+    first: AtomicU64,
+    last: AtomicU64,
+    first_time: AtomicU64,
+    last_time: AtomicU64,
+    /// Each bit records a boundary that was unknown for at least one event in
+    /// this slot.  Keeping these bits beside the aggregate prevents a
+    /// diagnostic snapshot requeued after an encode/NACK failure from having
+    /// its `None`/zero fields treated as neutral by a later merge.
+    metadata_unknown: AtomicU8,
+}
+
+impl GapSlot {
+    fn try_merge(&self, snapshot: GapSnapshot) -> Option<bool> {
+        if snapshot.count == 0 {
+            return Some(false);
+        }
+        let version = self.sequence.load(Ordering::Acquire);
+        if version & 1 != 0 {
+            return None;
+        }
+        if self
+            .sequence
+            .compare_exchange(version, version.wrapping_add(1), Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            return None;
+        }
+
+        let previous_count = self.count.load(Ordering::Relaxed);
+        let count = previous_count.saturating_add(snapshot.count);
+        let saturated = count == u64::MAX;
+        self.count.store(count, Ordering::Relaxed);
+        let unknown = gap_unknown_mask(snapshot);
+        self.metadata_unknown.fetch_or(unknown, Ordering::Relaxed);
+        let known = self.metadata_unknown.load(Ordering::Relaxed);
+        if let Some(first) = snapshot.first
+            && known & GAP_FIRST_UNKNOWN == 0
+        {
+            let current = self.first.load(Ordering::Relaxed);
+            if current == 0 || first < current {
+                self.first.store(first, Ordering::Relaxed);
+            }
+        }
+        if let Some(last) = snapshot.last
+            && known & GAP_LAST_UNKNOWN == 0
+        {
+            let current = self.last.load(Ordering::Relaxed);
+            if last > current {
+                self.last.store(last, Ordering::Relaxed);
+            }
+        }
+        if snapshot.first_time != 0 && known & GAP_FIRST_TIME_UNKNOWN == 0 {
+            let current = self.first_time.load(Ordering::Relaxed);
+            if current == 0 || snapshot.first_time < current {
+                self.first_time.store(snapshot.first_time, Ordering::Relaxed);
+            }
+        }
+        if snapshot.last_time != 0
+            && known & GAP_LAST_TIME_UNKNOWN == 0
+            && snapshot.last_time > self.last_time.load(Ordering::Relaxed)
+        {
+            self.last_time.store(snapshot.last_time, Ordering::Relaxed);
+        }
+        self.sequence.store(version.wrapping_add(2), Ordering::Release);
+        Some(saturated)
+    }
+
+    /// Try to take a coherent slot snapshot without waiting.  A producer can
+    /// be pre-empted while it owns a slot; spinning in the supervisor would
+    /// turn that otherwise tiny critical section into an unbounded shutdown
+    /// wait.  The accumulator retries the slot on a later pass instead.
+    fn try_take(&self) -> Option<GapSnapshot> {
+        let version = self.sequence.load(Ordering::Acquire);
+        if version & 1 != 0 {
+            return None;
+        }
+        if self
+            .sequence
+            .compare_exchange(version, version.wrapping_add(1), Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            return None;
+        }
+        let count = self.count.swap(0, Ordering::Relaxed);
+        let first = self.first.swap(0, Ordering::Relaxed);
+        let last = self.last.swap(0, Ordering::Relaxed);
+        let first_time = self.first_time.swap(0, Ordering::Relaxed);
+        let last_time = self.last_time.swap(0, Ordering::Relaxed);
+        let unknown = self.metadata_unknown.swap(0, Ordering::Relaxed);
+        self.sequence.store(version.wrapping_add(2), Ordering::Release);
+        Some(GapSnapshot {
+            count,
+            first: if unknown & (GAP_FIRST_UNKNOWN | GAP_LAST_UNKNOWN) != 0 {
+                None
+            } else {
+                (first != 0).then_some(first)
+            },
+            last: if unknown & (GAP_FIRST_UNKNOWN | GAP_LAST_UNKNOWN) != 0 {
+                None
+            } else {
+                (last != 0).then_some(last)
+            },
+            first_time: if unknown & GAP_FIRST_TIME_UNKNOWN != 0 {
+                0
+            } else {
+                first_time
+            },
+            last_time: if unknown & GAP_LAST_TIME_UNKNOWN != 0 {
+                0
+            } else {
+                last_time
+            },
+        })
+    }
+
+    fn is_nonempty(&self) -> bool {
+        self.sequence.load(Ordering::Acquire) & 1 != 0 || self.count.load(Ordering::Acquire) != 0
+    }
+}
+
+/// A bounded escape hatch for the (very short) seqlock slots above.  Under
+/// normal load a merge always lands in one of the coherent slots.  If every
+/// slot is temporarily owned by another producer, waiting would violate the
+/// relay hot-path contract, so the merge is recorded here instead.  The
+/// fallback has its own tiny lock for coherent updates and a count-only
+/// overflow path for the case where even that lock is busy.  Losing boundary
+/// metadata in that pathological path is explicitly represented as unknown;
+/// the dropped count itself is retained (and saturates conservatively).
+#[derive(Default)]
+struct GapFallback {
+    lock: AtomicBool,
+    /// Count merged while the fallback lock was available.  Its boundary
+    /// fields below describe exactly this counter's aggregate.
+    count: AtomicU64,
+    /// Count merged while the fallback lock was busy.  Keep it separate from
+    /// `count`: a producer can update this path while `try_take` is swapping
+    /// the coherent fields, and a single sticky marker cannot identify which
+    /// side of that swap the count belongs to.
+    unknown_count: AtomicU64,
+    first: AtomicU64,
+    last: AtomicU64,
+    first_time: AtomicU64,
+    last_time: AtomicU64,
+    /// Unknown boundary bits for the lock-protected counter.  The separate
+    /// `unknown_count` below implies all four bits for its own count.
+    metadata_unknown: AtomicU8,
+}
+
+impl GapFallback {
+    fn merge(&self, snapshot: GapSnapshot) -> bool {
+        if snapshot.count == 0 {
+            return false;
+        }
+
+        if self
+            .lock
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .is_ok()
+        {
+            let saturated = self.merge_locked(snapshot);
+            self.lock.store(false, Ordering::Release);
+            return saturated;
+        }
+
+        // Do not wait for the fallback lock.  Keep this count separate from
+        // the coherent counter so a concurrent `try_take` cannot consume a
+        // metadata-unknown marker for the wrong side of its count swap.
+        saturating_add_atomic(&self.unknown_count, snapshot.count)
+    }
+
+    fn merge_locked(&self, snapshot: GapSnapshot) -> bool {
+        // The count-only overflow path may still update this atomic while the
+        // fallback lock is held.  Use the same CAS-based saturating addition
+        // here so that a stale load cannot overwrite that concurrent update.
+        let saturated = saturating_add_atomic(&self.count, snapshot.count);
+        let unknown = gap_unknown_mask(snapshot);
+        self.metadata_unknown.fetch_or(unknown, Ordering::Relaxed);
+        let known = self.metadata_unknown.load(Ordering::Relaxed);
+        if let Some(first) = snapshot.first
+            && known & GAP_FIRST_UNKNOWN == 0
+        {
+            let current = self.first.load(Ordering::Relaxed);
+            if current == 0 || first < current {
+                self.first.store(first, Ordering::Relaxed);
+            }
+        }
+        if let Some(last) = snapshot.last
+            && known & GAP_LAST_UNKNOWN == 0
+        {
+            let current = self.last.load(Ordering::Relaxed);
+            if last > current {
+                self.last.store(last, Ordering::Relaxed);
+            }
+        }
+        if snapshot.first_time != 0 && known & GAP_FIRST_TIME_UNKNOWN == 0 {
+            let current = self.first_time.load(Ordering::Relaxed);
+            if current == 0 || snapshot.first_time < current {
+                self.first_time.store(snapshot.first_time, Ordering::Relaxed);
+            }
+        }
+        if snapshot.last_time != 0
+            && known & GAP_LAST_TIME_UNKNOWN == 0
+            && snapshot.last_time > self.last_time.load(Ordering::Relaxed)
+        {
+            self.last_time.store(snapshot.last_time, Ordering::Relaxed);
+        }
+        saturated
+    }
+
+    fn try_take(&self) -> Option<GapSnapshot> {
+        if self
+            .lock
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            return None;
+        }
+        let count = self.count.swap(0, Ordering::Relaxed);
+        let first = self.first.swap(0, Ordering::Relaxed);
+        let last = self.last.swap(0, Ordering::Relaxed);
+        let first_time = self.first_time.swap(0, Ordering::Relaxed);
+        let last_time = self.last_time.swap(0, Ordering::Relaxed);
+        let metadata_unknown = self.metadata_unknown.swap(0, Ordering::Relaxed);
+        // `lock` also excludes coherent merges, while count-only producers
+        // use the independent atomic below.  Swapping it before releasing the
+        // lock gives this snapshot an exact count boundary: updates racing
+        // after the swap remain pending for the next take.
+        let unknown_count = self.unknown_count.swap(0, Ordering::Relaxed);
+        self.lock.store(false, Ordering::Release);
+
+        let count = count.saturating_add(unknown_count);
+        if unknown_count != 0 {
+            Some(GapSnapshot {
+                count,
+                first: None,
+                last: None,
+                first_time: 0,
+                last_time: 0,
+            })
+        } else {
+            Some(GapSnapshot {
+                count,
+                first: if metadata_unknown & (GAP_FIRST_UNKNOWN | GAP_LAST_UNKNOWN) != 0 {
+                    None
+                } else {
+                    (first != 0).then_some(first)
+                },
+                last: if metadata_unknown & (GAP_FIRST_UNKNOWN | GAP_LAST_UNKNOWN) != 0 {
+                    None
+                } else {
+                    (last != 0).then_some(last)
+                },
+                first_time: if metadata_unknown & GAP_FIRST_TIME_UNKNOWN != 0 {
+                    0
+                } else {
+                    first_time
+                },
+                last_time: if metadata_unknown & GAP_LAST_TIME_UNKNOWN != 0 {
+                    0
+                } else {
+                    last_time
+                },
+            })
+        }
+    }
+
+    fn is_nonempty(&self) -> bool {
+        self.lock.load(Ordering::Acquire)
+            || self.count.load(Ordering::Acquire) != 0
+            || self.unknown_count.load(Ordering::Acquire) != 0
+    }
+}
+
+/// Add without a retry budget so contention cannot fabricate saturation.
+/// Returns true when the resulting counter has honestly reached its cap.
+fn saturating_add_atomic(atom: &AtomicU64, amount: u64) -> bool {
+    let result = atom.fetch_update(Ordering::AcqRel, Ordering::Acquire, |current| {
+        let next = current.saturating_add(amount);
+
+        #[cfg(test)]
+        SATURATING_ADD_BEFORE_CAS.with(|hook| {
+            if let Some((entered, release)) = hook.borrow_mut().take() {
+                entered.wait();
+                release.wait();
+            }
+        });
+
+        Some(next)
+    });
+
+    // `fetch_update` may invoke the closure more than once after a failed
+    // CAS.  Derive saturation from the value that this invocation actually
+    // replaced, rather than retaining a flag from a speculative attempt that
+    // another thread may have invalidated (for example via a snapshot swap).
+    result.is_ok_and(|previous| previous.saturating_add(amount) == u64::MAX)
+}
+
+struct GapAccumulator {
+    slots: [GapSlot; GAP_ACCUMULATOR_SLOTS],
+    next_slot: AtomicUsize,
+    fallback: GapFallback,
+    saturated: AtomicBool,
+}
+
+impl Default for GapAccumulator {
+    fn default() -> Self {
+        Self {
+            slots: std::array::from_fn(|_| GapSlot::default()),
+            next_slot: AtomicUsize::new(0),
+            fallback: GapFallback::default(),
+            saturated: AtomicBool::new(false),
+        }
+    }
+}
+
+impl GapAccumulator {
+    fn add(&self, count: u64, sequence: Option<u64>, now: u64) {
+        self.merge(GapSnapshot {
+            count,
+            first: sequence,
+            last: sequence,
+            first_time: now,
+            last_time: now,
+        });
+    }
+
+    fn merge(&self, snapshot: GapSnapshot) {
+        if snapshot.count == 0 {
+            return;
+        }
+        let start = self.next_slot.fetch_add(1, Ordering::Relaxed) % GAP_ACCUMULATOR_SLOTS;
+        for offset in 0..GAP_ACCUMULATOR_SLOTS {
+            let index = (start + offset) % GAP_ACCUMULATOR_SLOTS;
+            if let Some(saturated) = self.slots[index].try_merge(snapshot) {
+                if saturated {
+                    self.saturated.store(true, Ordering::Release);
+                }
+                return;
+            }
+        }
+        // All primary slots are busy.  The fallback is deliberately one
+        // bounded call; it never spins or waits on the relay thread.
+        if self.fallback.merge(snapshot) {
+            self.saturated.store(true, Ordering::Release);
+        }
+    }
+
+    fn is_nonempty(&self) -> bool {
+        self.slots.iter().any(GapSlot::is_nonempty) || self.fallback.is_nonempty()
+    }
+
+    fn approximate_count(&self) -> u64 {
+        let mut total = self.fallback.count.load(Ordering::Acquire);
+        total = total.saturating_add(self.fallback.unknown_count.load(Ordering::Acquire));
+        for slot in &self.slots {
+            total = total.saturating_add(slot.count.load(Ordering::Acquire));
+        }
+        total
+    }
+
+    fn saturated(&self) -> bool {
+        self.saturated.load(Ordering::Acquire)
+    }
+
+    fn take(&self) -> Option<GapSnapshot> {
+        let mut combined = None;
+        for slot in &self.slots {
+            let Some(snapshot) = slot.try_take() else {
+                continue;
+            };
+            if snapshot.count == 0 {
+                continue;
+            }
+            combined = Some(match combined {
+                None => snapshot,
+                Some(current) => combine_gap_snapshots(current, snapshot),
+            });
+        }
+        if let Some(snapshot) = self.fallback.try_take()
+            && snapshot.count != 0
+        {
+            combined = Some(match combined {
+                None => snapshot,
+                Some(current) => combine_gap_snapshots(current, snapshot),
+            });
+        }
+        if combined.is_some_and(|snapshot| snapshot.count == u64::MAX) {
+            self.saturated.store(true, Ordering::Release);
+        }
+        combined
+    }
+}
+
+fn combine_gap_snapshots(left: GapSnapshot, right: GapSnapshot) -> GapSnapshot {
+    let sequence_unknown = left.first.is_none() || left.last.is_none() || right.first.is_none() || right.last.is_none();
+    let first = match (left.first, right.first) {
+        (Some(a), Some(b)) if !sequence_unknown => Some(a.min(b)),
+        _ => None,
+    };
+    let last = match (left.last, right.last) {
+        (Some(a), Some(b)) if !sequence_unknown => Some(a.max(b)),
+        _ => None,
+    };
+    GapSnapshot {
+        count: left.count.saturating_add(right.count),
+        first,
+        last,
+        first_time: match (left.first_time, right.first_time) {
+            (0, _) | (_, 0) => 0,
+            (a, b) => a.min(b),
+        },
+        last_time: match (left.last_time, right.last_time) {
+            (0, _) | (_, 0) => 0,
+            (a, b) => a.max(b),
+        },
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum UdpAuditHost<'a> {
+    Ip(IpAddr),
+    Domain(&'a str),
+}
+
+impl Hash for UdpAuditHost<'_> {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        match self {
+            Self::Ip(address) => {
+                0u8.hash(state);
+                address.hash(state);
+            }
+            Self::Domain(host) => {
+                1u8.hash(state);
+                host.hash(state);
+            }
+        }
+    }
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+enum UdpWindowHost {
+    Ip(IpAddr),
+    Domain(Arc<str>),
+}
+
+impl UdpWindowHost {
+    fn borrowed(&self) -> UdpAuditHost<'_> {
+        match self {
+            Self::Ip(address) => UdpAuditHost::Ip(*address),
+            Self::Domain(host) => UdpAuditHost::Domain(host),
+        }
+    }
+
+    fn from_borrowed(host: UdpAuditHost<'_>) -> Self {
+        match host {
+            UdpAuditHost::Ip(address) => Self::Ip(address),
+            UdpAuditHost::Domain(host) => Self::Domain(Arc::from(host)),
+        }
+    }
+}
+
+/// Borrowed view of one window key. Lookups, index rehashing and eviction all
+/// go through this type, so a window key is never materialized just to be
+/// stored a second time inside an index.
+#[derive(Clone, Copy)]
+struct UdpWindowLookup<'a> {
+    server_id: &'a Arc<str>,
+    association_id: [u8; 16],
+    host: UdpAuditHost<'a>,
+    port: u16,
+}
+
+impl<'a> UdpWindowLookup<'a> {
+    fn new(server_id: &'a Arc<str>, association_id: [u8; 16], host: UdpAuditHost<'a>, port: u16) -> Self {
+        Self {
+            server_id,
+            association_id,
+            host,
+            port,
+        }
+    }
+
+    /// Hash of the logical window key.  Entries and probes hash through this
+    /// single function, which is what lets the indexes store a slot reference
+    /// instead of a copy of the key.
+    fn hash_with(&self, hasher: &RandomState) -> u64 {
+        let mut state = hasher.build_hasher();
+        self.server_id.as_ref().hash(&mut state);
+        self.association_id.hash(&mut state);
+        self.host.hash(&mut state);
+        self.port.hash(&mut state);
+        state.finish()
+    }
+}
+
+#[derive(Clone, Debug, Eq, Hash, PartialEq)]
+struct UdpAssociationKey {
+    server_id: Arc<str>,
+    association_id: [u8; 16],
+}
+
+/// One index item for a cached alias spelling: the arena slot plus which of
+/// the entry's two alias hosts it describes.
+#[derive(Clone, Copy, Eq, PartialEq)]
+struct AliasRef {
+    slot: u32,
+    index: u8,
+}
+
+struct UdpWindowEntry {
+    /// Key material shared by the canonical spelling and every alias: an alias
+    /// only ever differs in the host, so server/association/port are stored
+    /// once per window instead of once per spelling.
+    server_id: Arc<str>,
+    association_id: [u8; 16],
+    port: u16,
+    host: UdpWindowHost,
+    /// The primary relay spelling and one replaceable alternate share the
+    /// canonical entry. Hits for those two cached spellings construct no owned
+    /// key, while further equivalent spellings replace only the alternate.
+    raw_hosts: [Option<UdpWindowHost>; 2],
+    last_attempt: Instant,
+    previous: Option<usize>,
+    next: Option<usize>,
+}
+
+impl UdpWindowEntry {
+    fn canonical_lookup(&self) -> UdpWindowLookup<'_> {
+        UdpWindowLookup::new(&self.server_id, self.association_id, self.host.borrowed(), self.port)
+    }
+
+    fn raw_lookup(&self, index: usize) -> Option<UdpWindowLookup<'_>> {
+        let host = self.raw_hosts.get(index)?.as_ref()?;
+        UdpWindowLookup::new(&self.server_id, self.association_id, host.borrowed(), self.port).into()
+    }
+
+    fn shares_association(&self, lookup: &UdpWindowLookup<'_>) -> bool {
+        self.server_id.as_ref() == lookup.server_id.as_ref()
+            && self.association_id == lookup.association_id
+            && self.port == lookup.port
+    }
+
+    fn matches(&self, lookup: &UdpWindowLookup<'_>) -> bool {
+        self.shares_association(lookup) && self.host.borrowed() == lookup.host
+    }
+
+    fn raw_matches(&self, index: usize, lookup: &UdpWindowLookup<'_>) -> bool {
+        self.shares_association(lookup)
+            && self
+                .raw_hosts
+                .get(index)
+                .and_then(Option::as_ref)
+                .is_some_and(|host| host.borrowed() == lookup.host)
+    }
+}
+
+struct AuditWindowShard {
+    // `by_key` makes the hot hit path O(1).  Entries themselves live in a
+    // bounded slot arena, linked in LRU order, so touching a key never scans
+    // the shard or allocates an unbounded history of queue nodes.  Both
+    // indexes hold only a reference into that arena and resolve the key
+    // material through it, so no window key is ever stored twice (§14.5).
+    entries: Vec<Option<UdpWindowEntry>>,
+    free_slots: Vec<usize>,
+    by_key: HashTable<u32>,
+    by_raw_key: HashTable<AliasRef>,
+    hasher: RandomState,
+    lru_head: Option<usize>,
+    lru_tail: Option<usize>,
+    association_counts: HashMap<UdpAssociationKey, usize>,
+}
+
+impl Default for AuditWindowShard {
+    fn default() -> Self {
+        Self {
+            entries: Vec::new(),
+            free_slots: Vec::new(),
+            by_key: HashTable::new(),
+            by_raw_key: HashTable::new(),
+            hasher: RandomState::new(),
+            lru_head: None,
+            lru_tail: None,
+            association_counts: HashMap::new(),
+        }
+    }
+}
+
+impl AuditWindowShard {
+    fn clear(&mut self) {
+        self.entries.clear();
+        self.free_slots.clear();
+        self.by_key.clear();
+        self.by_raw_key.clear();
+        self.lru_head = None;
+        self.lru_tail = None;
+        self.association_counts.clear();
+    }
+
+    fn detach(&mut self, slot: usize) {
+        let Some(entry) = self.entries.get(slot).and_then(Option::as_ref) else {
+            return;
+        };
+        let previous = entry.previous;
+        let next = entry.next;
+        if let Some(previous) = previous {
+            if let Some(entry) = self.entries.get_mut(previous).and_then(Option::as_mut) {
+                entry.next = next;
+            }
+        } else {
+            self.lru_head = next;
+        }
+        if let Some(next) = next {
+            if let Some(entry) = self.entries.get_mut(next).and_then(Option::as_mut) {
+                entry.previous = previous;
+            }
+        } else {
+            self.lru_tail = previous;
+        }
+        if let Some(entry) = self.entries.get_mut(slot).and_then(Option::as_mut) {
+            entry.previous = None;
+            entry.next = None;
+        }
+    }
+
+    fn attach_tail(&mut self, slot: usize) {
+        let previous = self.lru_tail;
+        if let Some(previous) = previous {
+            if let Some(entry) = self.entries.get_mut(previous).and_then(Option::as_mut) {
+                entry.next = Some(slot);
+            }
+        } else {
+            self.lru_head = Some(slot);
+        }
+        if let Some(entry) = self.entries.get_mut(slot).and_then(Option::as_mut) {
+            entry.previous = previous;
+            entry.next = None;
+        }
+        self.lru_tail = Some(slot);
+    }
+
+    fn touch(&mut self, slot: usize) {
+        if self.lru_tail == Some(slot) {
+            return;
+        }
+        self.detach(slot);
+        self.attach_tail(slot);
+    }
+
+    fn allocate_slot(&mut self) -> usize {
+        if let Some(slot) = self.free_slots.pop() {
+            slot
+        } else {
+            let slot = self.entries.len();
+            self.entries.push(None);
+            slot
+        }
+    }
+
+    fn entry(&self, slot: usize) -> Option<&UdpWindowEntry> {
+        self.entries.get(slot).and_then(Option::as_ref)
+    }
+
+    /// Slot holding the canonical spelling of `lookup`, if any.
+    fn find_canonical(&self, lookup: &UdpWindowLookup<'_>) -> Option<usize> {
+        let hash = lookup.hash_with(&self.hasher);
+        let slot = self.by_key.find(hash, |candidate| {
+            self.entry(*candidate as usize)
+                .is_some_and(|entry| entry.matches(lookup))
+        })?;
+        Some(*slot as usize)
+    }
+
+    /// Slot holding `lookup` as one of its cached alias spellings, if any.
+    fn find_alias(&self, lookup: &UdpWindowLookup<'_>) -> Option<usize> {
+        let hash = lookup.hash_with(&self.hasher);
+        let alias = self.by_raw_key.find(hash, |candidate| {
+            self.entry(candidate.slot as usize)
+                .is_some_and(|entry| entry.raw_matches(candidate.index as usize, lookup))
+        })?;
+        Some(alias.slot as usize)
+    }
+
+    fn canonical_hash_of(entries: &[Option<UdpWindowEntry>], hasher: &RandomState, slot: u32) -> u64 {
+        entries
+            .get(slot as usize)
+            .and_then(Option::as_ref)
+            .map(|entry| entry.canonical_lookup().hash_with(hasher))
+            .unwrap_or(0)
+    }
+
+    fn alias_hash_of(entries: &[Option<UdpWindowEntry>], hasher: &RandomState, alias: AliasRef) -> u64 {
+        entries
+            .get(alias.slot as usize)
+            .and_then(Option::as_ref)
+            .and_then(|entry| entry.raw_lookup(alias.index as usize))
+            .map(|lookup| lookup.hash_with(hasher))
+            .unwrap_or(0)
+    }
+
+    fn association_key(entry: &UdpWindowEntry) -> UdpAssociationKey {
+        UdpAssociationKey {
+            server_id: entry.server_id.clone(),
+            association_id: entry.association_id,
+        }
+    }
+
+    fn decrement_association(&mut self, entry: &UdpWindowEntry) {
+        let association = Self::association_key(entry);
+        if let Some(count) = self.association_counts.get_mut(&association) {
+            *count = count.saturating_sub(1);
+            if *count == 0 {
+                self.association_counts.remove(&association);
+            }
+        }
+    }
+
+    fn remove_slot(&mut self, slot: usize) -> Option<UdpWindowEntry> {
+        let slot_ref = u32::try_from(slot).ok()?;
+        self.detach(slot);
+        // The entry leaves the arena first: the index items are then removed
+        // by the exact (slot, alias) reference they were inserted under, so a
+        // hash collision between two spellings of the same window cannot leave
+        // one of them behind.
+        let removed = self.entries.get_mut(slot).and_then(Option::take)?;
+        self.free_slots.push(slot);
+        let canonical_hash = removed.canonical_lookup().hash_with(&self.hasher);
+        if let Ok(occupied) = self
+            .by_key
+            .find_entry(canonical_hash, |candidate| *candidate == slot_ref)
+        {
+            occupied.remove();
+        }
+        for index in 0..removed.raw_hosts.len() {
+            let Some(hash) = removed.raw_lookup(index).map(|lookup| lookup.hash_with(&self.hasher)) else {
+                continue;
+            };
+            if let Ok(occupied) = self.by_raw_key.find_entry(hash, |candidate| {
+                candidate.slot == slot_ref && usize::from(candidate.index) == index
+            }) {
+                occupied.remove();
+            }
+        }
+        self.decrement_association(&removed);
+        Some(removed)
+    }
+
+    /// Index the canonical spelling and the primary alias of a freshly filled
+    /// slot.
+    fn index_new_slot(&mut self, slot: usize) -> Result<(), ()> {
+        let slot_ref = u32::try_from(slot).map_err(|_| ())?;
+        let Self {
+            entries,
+            by_key,
+            by_raw_key,
+            hasher,
+            ..
+        } = self;
+        let entries = &*entries;
+        let hasher = &*hasher;
+        let entry = entries.get(slot).and_then(Option::as_ref).ok_or(())?;
+        let canonical_hash = entry.canonical_lookup().hash_with(hasher);
+        let raw_hash = entry.raw_lookup(0).ok_or(())?.hash_with(hasher);
+        by_key.insert_unique(canonical_hash, slot_ref, |candidate| {
+            Self::canonical_hash_of(entries, hasher, *candidate)
+        });
+        by_raw_key.insert_unique(
+            raw_hash,
+            AliasRef {
+                slot: slot_ref,
+                index: 0,
+            },
+            |candidate| Self::alias_hash_of(entries, hasher, *candidate),
+        );
+        Ok(())
+    }
+
+    fn add_raw_alias(&mut self, slot: usize, raw_host: UdpWindowHost) -> Result<(), ()> {
+        let slot_ref = u32::try_from(slot).map_err(|_| ())?;
+        let (index, replaced_hash) = {
+            let Self { entries, hasher, .. } = &mut *self;
+            let hasher = &*hasher;
+            let entry = entries.get_mut(slot).and_then(Option::as_mut).ok_or(())?;
+            if entry.raw_hosts.iter().flatten().any(|existing| *existing == raw_host) {
+                return Ok(());
+            }
+            let index = entry.raw_hosts.iter().position(Option::is_none).unwrap_or(1);
+            // Hash the alias that is about to be replaced while it is still
+            // reachable; its index item must leave with it.
+            let replaced_hash = entry.raw_lookup(index).map(|lookup| lookup.hash_with(hasher));
+            entry.raw_hosts[index] = Some(raw_host);
+            (index, replaced_hash)
+        };
+        if let Some(hash) = replaced_hash
+            && let Ok(occupied) = self.by_raw_key.find_entry(hash, |candidate| {
+                candidate.slot == slot_ref && usize::from(candidate.index) == index
+            })
+        {
+            occupied.remove();
+        }
+        let alias = AliasRef {
+            slot: slot_ref,
+            index: u8::try_from(index).map_err(|_| ())?,
+        };
+        let Self {
+            entries,
+            by_raw_key,
+            hasher,
+            ..
+        } = self;
+        let entries = &*entries;
+        let hasher = &*hasher;
+        let hash = Self::alias_hash_of(entries, hasher, alias);
+        by_raw_key.insert_unique(hash, alias, |candidate| {
+            Self::alias_hash_of(entries, hasher, *candidate)
+        });
+        Ok(())
+    }
+
+    /// Bytes this shard keeps resident: the slot arena, both index tables, the
+    /// association counters and every distinct host allocation.  Shared host
+    /// allocations are counted once, which is what §14.5 budgets.
+    #[cfg(test)]
+    fn footprint_bytes(&self) -> usize {
+        let mut bytes = self.entries.capacity() * size_of::<Option<UdpWindowEntry>>()
+            + self.free_slots.capacity() * size_of::<usize>()
+            + self.by_key.allocation_size()
+            + self.by_raw_key.allocation_size()
+            + self.association_counts.capacity() * (size_of::<(UdpAssociationKey, usize)>() + 1);
+        let mut counted: Vec<*const u8> = Vec::new();
+        for entry in self.entries.iter().flatten() {
+            for host in std::iter::once(&entry.host).chain(entry.raw_hosts.iter().flatten()) {
+                let UdpWindowHost::Domain(domain) = host else { continue };
+                let pointer = Arc::as_ptr(domain).cast::<u8>();
+                if counted.contains(&pointer) {
+                    continue;
+                }
+                counted.push(pointer);
+                // `Arc<str>`: strong and weak counters plus the string bytes.
+                bytes += 2 * size_of::<usize>() + domain.len();
+            }
+        }
+        bytes
+    }
+
+    fn oldest_for_association(&self, association: &UdpAssociationKey) -> Option<usize> {
+        let mut cursor = self.lru_head;
+        while let Some(slot) = cursor {
+            let entry = self.entries.get(slot).and_then(Option::as_ref)?;
+            if Self::association_key(entry) == *association {
+                return Some(slot);
+            }
+            cursor = entry.next;
+        }
+        None
+    }
+}
+
+/// Process-wide bounded UDP cooldown cache.
+pub struct UdpAuditWindowCache {
+    shards: Vec<Mutex<AuditWindowShard>>,
+    per_association: usize,
+    per_shard: usize,
+    poison_resets: AtomicU64,
+    #[cfg(test)]
+    lock_attempts: AtomicU64,
+    #[cfg(test)]
+    owned_key_constructions: AtomicU64,
+}
+
+impl UdpAuditWindowCache {
+    pub fn new(per_association: usize, total_windows: usize) -> Arc<Self> {
+        let per_shard = total_windows / USER_AUDIT_UDP_WINDOW_SHARDS;
+        let shards = (0..USER_AUDIT_UDP_WINDOW_SHARDS)
+            .map(|_| Mutex::new(AuditWindowShard::default()))
+            .collect();
+        Arc::new(Self {
+            shards,
+            per_association,
+            per_shard,
+            poison_resets: AtomicU64::new(0),
+            #[cfg(test)]
+            lock_attempts: AtomicU64::new(0),
+            #[cfg(test)]
+            owned_key_constructions: AtomicU64::new(0),
+        })
+    }
+
+    fn shard_index(association_id: &[u8; 16]) -> usize {
+        let prefix = u64::from_be_bytes([
+            association_id[0],
+            association_id[1],
+            association_id[2],
+            association_id[3],
+            association_id[4],
+            association_id[5],
+            association_id[6],
+            association_id[7],
+        ]);
+        (prefix & (USER_AUDIT_UDP_WINDOW_SHARDS as u64 - 1)) as usize
+    }
+
+    fn lock_shard(&self, association_id: &[u8; 16]) -> Result<std::sync::MutexGuard<'_, AuditWindowShard>, ()> {
+        #[cfg(test)]
+        self.lock_attempts.fetch_add(1, Ordering::Relaxed);
+        let index = Self::shard_index(association_id);
+        let lock = self.shards.get(index).ok_or(())?;
+        match lock.try_lock() {
+            Ok(guard) => Ok(guard),
+            Err(std::sync::TryLockError::WouldBlock) => Err(()),
+            Err(std::sync::TryLockError::Poisoned(poisoned)) => {
+                let mut guard = poisoned.into_inner();
+                guard.clear();
+                lock.clear_poison();
+                self.poison_resets
+                    .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {
+                        Some(value.saturating_add(1))
+                    })
+                    .ok();
+                Ok(guard)
+            }
+        }
+    }
+
+    /// Materialize the owned host of a key.  This is the only allocation on
+    /// the cache path, so the hit paths are counted against it in tests.
+    fn owned_host(&self, host: UdpAuditHost<'_>) -> UdpWindowHost {
+        #[cfg(test)]
+        self.owned_key_constructions.fetch_add(1, Ordering::Relaxed);
+        UdpWindowHost::from_borrowed(host)
+    }
+
+    fn refresh_existing(shard: &mut AuditWindowShard, slot: usize, now: Instant) -> Result<Option<bool>, ()> {
+        let Some(entry) = shard.entries.get_mut(slot).and_then(Option::as_mut) else {
+            // A stale map entry would indicate internal corruption. Clear the
+            // bounded cache and let this successful packet proceed as a fresh
+            // miss instead of panicking or suppressing it.
+            shard.clear();
+            return Ok(None);
+        };
+        let eligible = now.saturating_duration_since(entry.last_attempt) >= UDP_COOLDOWN;
+        if eligible {
+            entry.last_attempt = now;
+        }
+        shard.touch(slot);
+        Ok(Some(eligible))
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn insert_entry(
+        &self,
+        shard: &mut AuditWindowShard,
+        host: UdpWindowHost,
+        raw_host: UdpWindowHost,
+        association_id: [u8; 16],
+        server_id: &Arc<str>,
+        port: u16,
+        now: Instant,
+    ) -> Result<(), ()> {
+        let association_key = UdpAssociationKey {
+            server_id: server_id.clone(),
+            association_id,
+        };
+        let count = shard.association_counts.get(&association_key).copied().unwrap_or(0);
+        if count >= self.per_association {
+            if let Some(oldest) = shard.oldest_for_association(&association_key) {
+                let _ = shard.remove_slot(oldest);
+            }
+        }
+        while shard.by_key.len() >= self.per_shard {
+            let Some(oldest) = shard.lru_head else {
+                break;
+            };
+            let _ = shard.remove_slot(oldest);
+        }
+        let slot = shard.allocate_slot();
+        let entry = UdpWindowEntry {
+            server_id: server_id.clone(),
+            association_id,
+            port,
+            host,
+            raw_hosts: [Some(raw_host), None],
+            last_attempt: now,
+            previous: None,
+            next: None,
+        };
+        let Some(place) = shard.entries.get_mut(slot) else {
+            // `allocate_slot` always returns a valid index; retain a bounded
+            // error path if that invariant is ever changed.
+            return Err(());
+        };
+        *place = Some(entry);
+        shard.index_new_slot(slot)?;
+        shard.attach_tail(slot);
+        *shard.association_counts.entry(association_key).or_insert(0) += 1;
+        Ok(())
+    }
+
+    /// Return true when this successful send is eligible for an access event.
+    #[cfg(test)]
+    pub fn eligible(
+        &self,
+        server_id: &Arc<str>,
+        association_id: [u8; 16],
+        target: &AuditTargetDraft,
+        now: Instant,
+    ) -> Result<bool, ()> {
+        if self.per_shard == 0 || self.per_association == 0 {
+            return Err(());
+        }
+
+        let raw_host = target.audit_host(false);
+        let canonical_host = target.audit_host(true);
+        let raw_lookup = UdpWindowLookup::new(server_id, association_id, raw_host, target.port);
+        let canonical_lookup = UdpWindowLookup::new(server_id, association_id, canonical_host, target.port);
+        let mut shard = self.lock_shard(&association_id)?;
+        if let Some(slot) = shard.find_canonical(&canonical_lookup) {
+            if let Some(eligible) = Self::refresh_existing(&mut shard, slot, now)? {
+                return Ok(eligible);
+            }
+        }
+        // An eager caller may have supplied a target whose canonical key is
+        // absent but whose raw alias still points at an entry (for example
+        // after a normalization variant was observed).  Honor that alias
+        // before allocating a new slot.
+        if let Some(slot) = shard.find_alias(&raw_lookup) {
+            if let Some(eligible) = Self::refresh_existing(&mut shard, slot, now)? {
+                return Ok(eligible);
+            }
+        }
+        let owned_raw = self.owned_host(raw_host);
+        let owned_canonical = if raw_host == canonical_host {
+            owned_raw.clone()
+        } else {
+            self.owned_host(canonical_host)
+        };
+        self.insert_entry(
+            &mut shard,
+            owned_canonical,
+            owned_raw,
+            association_id,
+            server_id,
+            target.port,
+            now,
+        )?;
+        Ok(true)
+    }
+
+    /// Fast-path UDP cooldown check used by the relay. This function performs
+    /// exactly one non-blocking lock attempt per successful send. A borrowed
+    /// raw-key lookup happens first, so normal IP/domain cooldown hits neither
+    /// allocate nor normalize. The bounded canonical/alias path runs only for
+    /// a new spelling and still prevents case/Unicode-equivalent bypasses.
+    /// `Some(target)` means the send is eligible and returns the target built
+    /// for the event; `None` means the cooldown suppressed it. The closure is
+    /// evaluated at most once and only after the cache decision.
+    pub fn eligible_lazy<F>(
+        &self,
+        server_id: &Arc<str>,
+        association_id: [u8; 16],
+        host: UdpAuditHost<'_>,
+        port: u16,
+        now: Instant,
+        build_target: F,
+    ) -> Result<Option<AuditTargetDraft>, ()>
+    where
+        F: FnOnce() -> AuditTargetDraft,
+    {
+        if self.per_shard == 0 || self.per_association == 0 {
+            return Err(());
+        }
+        let raw_lookup = UdpWindowLookup::new(server_id, association_id, host, port);
+        let mut shard = self.lock_shard(&association_id)?;
+        if let Some(slot) = shard.find_alias(&raw_lookup) {
+            if let Some(eligible) = Self::refresh_existing(&mut shard, slot, now)? {
+                if !eligible {
+                    return Ok(None);
+                }
+                drop(shard);
+                return Ok(Some(build_target()));
+            }
+        }
+
+        // IDNA normalization allocates only after a borrowed raw miss. A
+        // failed normalization deliberately falls back to the raw spelling.
+        //
+        // Deliberate trade-off (m-91 -> m-151 -> m-171): normalization runs
+        // inside the shard critical section.  Doing it outside would require
+        // either a second `try_lock()` for the same datagram -- which §6.4
+        // forbids ("每个完整 UDP send 成功后只调用一次 try_lock()") -- or an
+        // unconditional owned allocation on every packet, which is what the
+        // alias cache exists to avoid.  §6.4 only bars serialization, queue
+        // and socket work from the critical section; UTS #46 mapping is
+        // CPU-only and bounded by the 255-byte domain limit.  The primary plus
+        // one alternate spelling therefore hit without normalizing at all, and
+        // only a third or later spelling pays for it under the lock.
+        let canonical_domain = match host {
+            UdpAuditHost::Ip(_) => None,
+            UdpAuditHost::Domain(raw) => Some(match normalize_domain(raw) {
+                Ok(normalized) => Cow::Owned(normalized),
+                Err(_) => Cow::Borrowed(raw),
+            }),
+        };
+        let canonical_host = match (host, canonical_domain.as_ref()) {
+            (UdpAuditHost::Domain(_), Some(canonical)) => UdpAuditHost::Domain(canonical.as_ref()),
+            (other, _) => other,
+        };
+        let canonical_lookup = UdpWindowLookup::new(server_id, association_id, canonical_host, port);
+        if let Some(slot) = shard.find_canonical(&canonical_lookup) {
+            if let Some(eligible) = Self::refresh_existing(&mut shard, slot, now)? {
+                // Cache one alternate spelling beside the primary. Hits for
+                // those two spellings construct no owned key; a later spelling
+                // replaces only the alternate so alias memory remains bounded.
+                let raw_host = self.owned_host(raw_lookup.host);
+                shard.add_raw_alias(slot, raw_host)?;
+                if !eligible {
+                    return Ok(None);
+                }
+                drop(shard);
+                return Ok(Some(build_target()));
+            }
+        }
+        let owned_raw = self.owned_host(host);
+        let owned_canonical = if canonical_host == host {
+            owned_raw.clone()
+        } else {
+            self.owned_host(canonical_host)
+        };
+        self.insert_entry(
+            &mut shard,
+            owned_canonical,
+            owned_raw,
+            association_id,
+            server_id,
+            port,
+            now,
+        )?;
+        drop(shard);
+        Ok(Some(build_target()))
+    }
+
+    #[cfg(test)]
+    pub fn lengths(&self) -> (usize, usize) {
+        self.shards.iter().fold((0, 0), |(entries, associations), shard| {
+            let guard = shard.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
+            (
+                entries + guard.by_key.len(),
+                associations + guard.association_counts.len(),
+            )
+        })
+    }
+
+    /// Resident bytes of the whole cache, summed over its shards.
+    #[cfg(test)]
+    fn footprint_bytes(&self) -> usize {
+        self.shards
+            .iter()
+            .map(|shard| {
+                let guard = shard.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
+                guard.footprint_bytes()
+            })
+            .sum()
+    }
+
+    #[cfg(test)]
+    fn lock_attempt_count(&self) -> u64 {
+        self.lock_attempts.load(Ordering::Relaxed)
+    }
+
+    #[cfg(test)]
+    fn owned_key_construction_count(&self) -> u64 {
+        self.owned_key_constructions.load(Ordering::Relaxed)
+    }
+
+    /// Number of poisoned-shard recoveries.  This is a saturating health
+    /// counter; recovery itself never rejects the successfully sent packet.
+    pub fn poison_reset_count(&self) -> u64 {
+        self.poison_resets.load(Ordering::Acquire)
+    }
+}
+
+pub(crate) struct ObservationGuard {
+    emitter: Arc<AuditEmitter>,
+}
+
+impl Drop for ObservationGuard {
+    fn drop(&mut self) {
+        let mut current = self.emitter.lifecycle_state.load(Ordering::Acquire);
+        loop {
+            let active = current & ACTIVE_MASK;
+            let next = (current & CLOSED_BIT) | active.saturating_sub(1);
+            match self
+                .emitter
+                .lifecycle_state
+                .compare_exchange_weak(current, next, Ordering::AcqRel, Ordering::Acquire)
+            {
+                Ok(_) => {
+                    // Only the shutdown drain waits for the active count to
+                    // reach zero, and it can only wait once the closed bit is
+                    // set.  Before that there is no waiter at all, so the
+                    // shared Notify (and its mutex) stays out of the relay hot
+                    // path: every successful datagram/stream lands here.
+                    if active <= 1 && next & CLOSED_BIT != 0 {
+                        self.emitter.notify.notify_waiters();
+                    }
+                    break;
+                }
+                Err(actual) => current = actual,
+            }
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum DiagnosticBucket {
+    QueueOverflow,
+    EncodeError,
+    PermanentNack(PermanentNackCode),
+    Contention,
+}
+
+impl DiagnosticBucket {
+    fn bit(self) -> u8 {
+        match self {
+            Self::QueueOverflow => 1 << 0,
+            Self::EncodeError => 1 << 1,
+            Self::PermanentNack(PermanentNackCode::InvalidSchema) => 1 << 2,
+            Self::PermanentNack(PermanentNackCode::EventIdConflict) => 1 << 3,
+            Self::PermanentNack(PermanentNackCode::RuntimeMismatch) => 1 << 4,
+            Self::Contention => 1 << 5,
+        }
+    }
+
+    fn permanent_code(self) -> Option<PermanentNackCode> {
+        match self {
+            Self::PermanentNack(code) => Some(code),
+            _ => None,
+        }
+    }
+
+    fn index(self) -> usize {
+        match self {
+            Self::QueueOverflow => 0,
+            Self::EncodeError => 1,
+            Self::PermanentNack(PermanentNackCode::InvalidSchema) => 2,
+            Self::PermanentNack(PermanentNackCode::EventIdConflict) => 3,
+            Self::PermanentNack(PermanentNackCode::RuntimeMismatch) => 4,
+            Self::Contention => 5,
+        }
+    }
+}
+
+const DIAGNOSTIC_BUCKETS: [DiagnosticBucket; 6] = [
+    DiagnosticBucket::QueueOverflow,
+    DiagnosticBucket::EncodeError,
+    DiagnosticBucket::PermanentNack(PermanentNackCode::InvalidSchema),
+    DiagnosticBucket::PermanentNack(PermanentNackCode::EventIdConflict),
+    DiagnosticBucket::PermanentNack(PermanentNackCode::RuntimeMismatch),
+    DiagnosticBucket::Contention,
+];
+
+struct SupervisorState {
+    pending: VecDeque<PendingEvent>,
+    backoff: Duration,
+    diagnostic_next_due: [Instant; DIAGNOSTIC_BUCKETS.len()],
+    /// Independent per-bucket 60 second stamp for the aggregate producer-gap
+    /// journald line.  `diagnostic_next_due` cannot be reused: producer-gap
+    /// snapshots are deliberately not rate limited on the wire.
+    gap_log_next_due: [Instant; DIAGNOSTIC_BUCKETS.len()],
+    diagnostic_cursor: usize,
+    force_final_diagnostics: bool,
+    final_diagnostic_attempted: u8,
+    #[cfg(test)]
+    gap_logs: u64,
+}
+
+impl SupervisorState {
+    fn new() -> Self {
+        Self {
+            pending: VecDeque::new(),
+            backoff: INITIAL_RECONNECT_BACKOFF,
+            diagnostic_next_due: [Instant::now(); DIAGNOSTIC_BUCKETS.len()],
+            gap_log_next_due: [Instant::now(); DIAGNOSTIC_BUCKETS.len()],
+            diagnostic_cursor: 0,
+            force_final_diagnostics: false,
+            final_diagnostic_attempted: 0,
+            #[cfg(test)]
+            gap_logs: 0,
+        }
+    }
+
+    fn mark_diagnostic_attempt(&mut self, bucket: DiagnosticBucket, now: Instant) {
+        // Contention snapshots are rate limited even when they succeed.  The
+        // other producer-gap buckets are emitted as soon as their accumulator
+        // becomes available; only a failed encode/permanent NACK schedules a
+        // 60-second retry (via `request_diagnostic_retry`).
+        if bucket == DiagnosticBucket::Contention {
+            self.diagnostic_next_due[bucket.index()] = deadline_after(now, DIAGNOSTIC_INTERVAL);
+        }
+        self.diagnostic_cursor = (bucket.index() + 1) % DIAGNOSTIC_BUCKETS.len();
+    }
+
+    fn next_diagnostic_wait(&self, emitter: &AuditEmitter, now: Instant) -> Duration {
+        let in_flight = emitter.diagnostic_inflight.load(Ordering::Acquire);
+        DIAGNOSTIC_BUCKETS
+            .iter()
+            .filter(|bucket| {
+                let bit = bucket.bit();
+                (!self.force_final_diagnostics || self.final_diagnostic_attempted & bit == 0)
+                    && in_flight & bit == 0
+                    // Empty buckets retain their initial `Instant::now()` due
+                    // value.  Excluding them is important: otherwise one
+                    // active 60-second contention retry makes the supervisor
+                    // wake every 10ms for the entire interval.
+                    && emitter.accumulator(**bucket).is_nonempty()
+            })
+            .map(|bucket| self.diagnostic_next_due[bucket.index()].saturating_duration_since(now))
+            .min()
+            .unwrap_or(DIAGNOSTIC_INTERVAL)
+    }
+}
+
+#[derive(Clone, Debug)]
+enum PendingKind {
+    Access {
+        sequence: u64,
+    },
+    Diagnostic {
+        bucket: DiagnosticBucket,
+        snapshot: GapSnapshot,
+    },
+}
+
+#[derive(Clone, Debug)]
+struct PendingEvent {
+    bytes: Vec<u8>,
+    event_id: String,
+    kind: PendingKind,
+}
+
+#[derive(Debug)]
+struct DiagnosticCandidate {
+    draft: AuditEventDraft,
+    bucket: DiagnosticBucket,
+    snapshot: GapSnapshot,
+}
