+    fn saturating_atomic_add_ignores_saturation_from_failed_cas() {
+        let counter = Arc::new(AtomicU64::new(u64::MAX - 1));
+        let entered = Arc::new(std::sync::Barrier::new(2));
+        let release = Arc::new(std::sync::Barrier::new(2));
+        let worker_counter = counter.clone();
+        let worker_entered = entered.clone();
+        let worker_release = release.clone();
+        let worker = std::thread::spawn(move || {
+            SATURATING_ADD_BEFORE_CAS.with(|hook| {
+                *hook.borrow_mut() = Some((worker_entered, worker_release));
+            });
+            saturating_add_atomic(&worker_counter, 1)
+        });
+
+        // Force the first closure invocation to compute MAX, then invalidate
+        // that compare-exchange before it can commit.  The retry succeeds at
+        // one and must not report the speculative MAX as durable saturation.
+        entered.wait();
+        counter.store(0, Ordering::Release);
+        release.wait();
+        let saturated = worker.join().expect("saturation worker");
+        assert!(!saturated);
+        assert_eq!(counter.load(Ordering::Acquire), 1);
