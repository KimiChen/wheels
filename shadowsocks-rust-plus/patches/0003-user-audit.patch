+#[derive(Clone, Debug)]
+pub struct AuditTargetDraft {
+    pub kind: String,
+    pub host: String,
+    pub normalized_host: Option<String>,
+    pub port: u16,
+    pub remote_ip: String,
+}
+
+impl AuditTargetDraft {
+    pub fn ip(target: IpAddr, remote: IpAddr) -> Self {
+        let text = target.to_string();
+        Self {
+            kind: "ip".to_owned(),
+            host: text.clone(),
+            normalized_host: Some(text),
+            port: 0,
+            remote_ip: remote.to_string(),
+        }
+    }
+
+    pub fn domain(host: &str, port: u16, remote: IpAddr) -> Self {
+        // Keep the original address header while applying exactly the same
+        // strict UTS #46/STD3 normalization used by the wire validator.  A
+        // normalization failure is represented by `null`; the original host
+        // remains available for diagnostics and never changes routing.
+        let normalized_host = normalize_domain(host).ok();
+        Self {
+            kind: "domain".to_owned(),
+            host: host.to_owned(),
+            normalized_host,
+            port,
+            remote_ip: remote.to_string(),
+        }
+    }
+
+    pub fn ip_with_port(target: IpAddr, port: u16, remote: IpAddr) -> Self {
+        let mut value = Self::ip(target, remote);
+        value.port = port;
+        value
+    }
+
+    #[cfg(test)]
+    fn key_host(&self) -> &str {
+        self.normalized_host.as_deref().unwrap_or(&self.host)
+    }
+
+    #[cfg(test)]
+    fn audit_host(&self, canonical: bool) -> UdpAuditHost<'_> {
+        if self.kind == "ip" {
+            if let Ok(address) = self.host.parse() {
+                return UdpAuditHost::Ip(address);
+            }
+        }
+        UdpAuditHost::Domain(if canonical { self.key_host() } else { &self.host })
+    }
+
+    fn to_wire_target(&self) -> Result<Target, shadowsocks_audit_protocol::ProtocolError> {
+        let kind = match self.kind.as_str() {
+            "domain" => TargetKind::Domain,
+            "ip" => TargetKind::Ip,
+            _ => {
+                return Err(shadowsocks_audit_protocol::ProtocolError::InvalidField {
+                    field: "target.kind".to_owned(),
+                    reason: "must be `domain` or `ip`".to_owned(),
+                });
+            }
+        };
+        let target = Target {
+            kind,
+            host: self.host.clone(),
+            normalized_host: self.normalized_host.clone(),
+            port: self.port,
+            remote_ip: self.remote_ip.clone(),
+        };
+        target.validate()?;
+        Ok(target)
+    }
+}
