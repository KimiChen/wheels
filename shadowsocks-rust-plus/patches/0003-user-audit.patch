+    #[tokio::test]
+    async fn unrepairable_seal_rollback_is_fatal_instead_of_wedging_every_write() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        let spool = Spool::open(config(dir.path())).expect("spool");
+        spool.append(&event(1), 1).expect("durable record");
+        {
+            let mut inner = lock(&spool.inner);
+            // The seal fails after current.ndjson was renamed away and the
+            // rollback fails as well, so `open_file` stays on the detached
+            // open/ directory descriptor while open_meta still has records.
+            inner.faults.seal_after_open_rename = true;
+            inner.faults.seal_rollback = true;
+        }
+
+        {
+            let mut inner = lock(&spool.inner);
+            let error = spool.seal_locked(&mut inner).expect_err("seal must fail");
+            assert!(matches!(error, SpoolError::DurabilityUncertain), "{error:?}");
+            assert!(
+                inner.durability_uncertain,
