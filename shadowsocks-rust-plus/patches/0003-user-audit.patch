+
+pub const DEFAULT_CONFIG_PATH: &str = "/etc/shadowsocks-audit/auditd.json";
+pub const DEFAULT_INGEST_SOCKET: &str = "/run/shadowsocks-audit/ingest/ingest.sock";
+pub const DEFAULT_EXPORT_SOCKET: &str = "/run/shadowsocks-audit/export/export.sock";
