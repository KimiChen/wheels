+pub fn request_mac_hex(
+    key: &[u8],
+    method: &str,
+    exact_path: &str,
+    node_id: &str,
+    timestamp: u64,
+    nonce: &str,
+    body_sha256: &str,
+) -> Result<String, ProtocolError> {
+    Ok(hex::encode(compute_request_mac(
+        key,
+        method,
+        exact_path,
+        node_id,
+        timestamp,
+        nonce,
+        body_sha256,
+    )?))
+}
