new file mode 100644
index 0000000000000000000000000000000000000000..154578ebf1a70784f742804eaea7147f2e6b9270
--- /dev/null
+++ b/fuzz/README.md
@@ -0,0 +1,12 @@
+# Audit protocol fuzz target
+
+The `audit_protocol` target exercises every public wire parser with arbitrary
+bytes. It is intentionally outside the production Cargo workspace:
+
+```text
+cargo fuzz run --manifest-path fuzz/Cargo.toml audit_protocol -- -max_total_time=60
+```
+
+The target must be run with the release profile and AddressSanitizer/UBSan
+enabled by the local cargo-fuzz toolchain. A CI job should retain the corpus
+and fail on any panic, sanitizer report, or non-zero target exit.
diff --git a/fuzz/fuzz_targets/audit_protocol.rs b/fuzz/fuzz_targets/audit_protocol.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e4e757101d27cd01b1277e88d389b7daae01d2f3
--- /dev/null
+++ b/fuzz/fuzz_targets/audit_protocol.rs
@@ -0,0 +1,34 @@
+#![no_main]
+
+use libfuzzer_sys::fuzz_target;
+use shadowsocks_audit_protocol as wire;
+
+// Keep every parser behind the same bounded input supplied by libFuzzer. The
+// protocol crate owns all size checks, so this target is also useful for
+// finding regressions in framing and recovery metadata parsers.
+fuzz_target!(|data: &[u8]| {
+    let _ = wire::parse_record(data);
+    let _ = wire::parse_canonical_record(data);
+    let _ = wire::parse_json_exact::<serde_json::Value>(data);
+    let _ = wire::parse_json_document::<serde_json::Value>(data);
+    let _ = wire::parse_spool_record(data);
+    let _ = wire::decode_frame(data);
+    let _ = wire::decode_frame_prefix(data);
+    let _ = wire::parse_spool_line(data);
+    let _ = wire::parse_spool_meta(data);
+    let _ = wire::parse_spool_state(data);
+    let _ = wire::parse_tombstone_ledger(data);
+    let _ = wire::parse_hello(data);
+    let _ = wire::parse_hello_ack(data);
+    let _ = wire::parse_hello_nack(data);
+    let _ = wire::parse_event_ack(data);
+    let _ = wire::parse_event_nack(data);
+    let _ = wire::parse_lease_request(data);
+    let _ = wire::parse_ack_request(data);
+    let _ = wire::parse_ack_response(data);
+    let _ = wire::parse_error_response(data);
+    let _ = wire::parse_health_response(data);
+    if let Ok(host) = std::str::from_utf8(data) {
+        let _ = wire::normalize_domain(host);
+    }
+});
