+/// Point-in-time producer health counters. These values stay local to the
+/// service process and are intentionally separate from wire diagnostics.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub(crate) struct AuditHealthSnapshot {
+    pub invalid_ack: u64,
+    /// Number of non-retryable hello NACKs observed during this runtime.
+    /// The count is cumulative and saturating; a successful hello ACK clears
+    /// only the associated sticky degraded state.
+    pub hello_nack_count: u64,
+    /// True while the producer has not yet recovered from the latest
+    /// non-retryable hello NACK.  This is deliberately separate from the
+    /// cumulative counter so health can recover without erasing evidence.
+    pub hello_nack_degraded: bool,
+    pub encode_error_time_unknown: u64,
+    pub diagnostic_time_unknown: u64,
+    pub udp_contention_time_unknown: u64,
+    /// Sticky health state set when the contention accumulator honestly reaches
+    /// its representable maximum. The corresponding wire count then means "at
+    /// least u64::MAX" rather than an exact value.
+    pub contention_saturated: bool,
+    /// Sticky saturation across all producer gap buckets. A saturated count
+    /// means the wire diagnostic is a lower bound even after its snapshot is
+    /// taken and cleared.
+    pub producer_gap_saturated: bool,
+    pub udp_window_poison_resets: u64,
+    pub diagnostic_encode_errors: u64,
+    pub diagnostic_permanent_nacks: u64,
+    pub sequence_exhausted_events: u64,
+    pub sequence_exhausted: bool,
+}
+
+/// Aggregate producer state captured by the root shutdown launcher after all
+/// data-plane tasks have joined.  The values are intentionally count-only: no
+/// event body, identity, target, or sequence details belong in journald.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub(crate) struct AuditShutdownPendingSnapshot {
+    pub queue: usize,
+    pub in_flight: u64,
+    pub diagnostic_inflight: u8,
+    pub diagnostics: [u64; DIAGNOSTIC_BUCKETS.len()],
+}
+
+impl AuditHealthSnapshot {
+    pub(crate) fn has_issue(self) -> bool {
+        self.invalid_ack != 0
+            || self.hello_nack_count != 0
+            || self.hello_nack_degraded
+            || self.encode_error_time_unknown != 0
+            || self.diagnostic_time_unknown != 0
+            || self.udp_contention_time_unknown != 0
+            || self.contention_saturated
+            || self.producer_gap_saturated
+            || self.udp_window_poison_resets != 0
+            || self.diagnostic_encode_errors != 0
+            || self.diagnostic_permanent_nacks != 0
+            || self.sequence_exhausted_events != 0
+            || self.sequence_exhausted
+    }
+}
