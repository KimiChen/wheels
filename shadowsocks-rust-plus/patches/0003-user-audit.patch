+    #[test]
+    fn pending_state_reset_repairs_the_cursor_without_a_second_epoch() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        let spool = Spool::open(config(dir.path())).expect("spool");
+        let epoch = lock(&spool.inner).epoch.clone();
+        let gap_id = "spool:cccccccccccccccccccccccccccccccc";
+        {
+            // Reproduce the one crash window §9.4 allows to be repaired in
+            // place: the reset gap is already durable while state.json still
+            // carries the pending marker.
+            let mut inner = lock(&spool.inner);
+            inner.pending_state_reset = Some(wire::StateReset {
+                gap_event_id: gap_id.to_owned(),
+                occurred_at_unix_ms: 1_u64.into(),
+                lost_spool_epoch: None,
+                first_lost_spool_sequence: None,
+                last_lost_spool_sequence: None,
+            });
+            let spec = GapSpec {
+                event_id: gap_id.to_owned(),
+                occurred_at_unix_ms: 1,
+                lost_spool_epoch: None,
+                reason: wire::SpoolGapReason::StateReset,
+                first_lost_spool_sequence: None,
+                last_lost_spool_sequence: None,
+                lost_events: None,
+                lost_bytes: None,
+                lost_batch_id: None,
+                source_fingerprint: None,
+            };
+            spool.write_gap_locked(&mut inner, &spec).expect("durable reset gap");
+        }
+        drop(spool);
+
+        // Rewind the cursor behind the durable record so the ordinary
+        // `next <= max` rule would demand another epoch.
+        let state_path = dir.path().join("state.json");
+        let state = String::from_utf8(fs::read(&state_path).expect("state")).expect("utf8 state");
+        let rewound = state.replace("\"next_spool_sequence\":\"2\"", "\"next_spool_sequence\":\"1\"");
+        assert_ne!(rewound, state, "the test needs the cursor to be rewound");
+        fs::write(&state_path, &rewound).expect("rewind cursor");
+
+        let spool = Spool::open(config(dir.path())).expect("recover");
+        let inner = lock(&spool.inner);
+        assert_eq!(
+            inner.epoch, epoch,
+            "a repairable pending reset must not create a second epoch"
+        );
+        assert_eq!(inner.next_sequence, 2, "the cursor is repaired past the durable record");
+        assert!(inner.pending_state_reset.is_none(), "the pending marker is cleared");
+        drop(inner);
+        assert_eq!(
+            fs::read_dir(dir.path().join("quarantine"))
+                .expect("quarantine")
+                .filter_map(Result::ok)
+                .count(),
+            0,
+            "no epoch change means the open segment stays in place"
+        );
+        let state = wire::parse_spool_state(&fs::read(&state_path).expect("state")).expect("canonical state");
+        assert_eq!(state.spool_epoch, epoch);
+        assert!(state.pending_state_reset.is_none());
+        assert_eq!(
+            drain_records(&spool)
+                .iter()
+                .filter(|record| matches!(
+                    record,
+                    wire::AuditRecord::SpoolGap(gap) if gap.reason == wire::SpoolGapReason::StateReset
+                ))
+                .count(),
+            1,
+            "the repaired reset must not be reported twice"
+        );
+    }
