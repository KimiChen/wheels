+        if self.tombstone_schema_version != 1 {
+            return Err(invalid("tombstone_schema_version", "unsupported schema version"));
+        }
+        if self.entries.len() > TOMBSTONE_CAPACITY {
+            return Err(invalid("entries", "ledger exceeds capacity"));
+        }
+        for entry in &self.entries {
+            entry.validate()?;
+        }
+        Ok(())
+    }
