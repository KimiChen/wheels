+/// Validate a socket directory against the fixed endpoint-specific access
+/// group from the packaging contract. The generic helper above is retained
+/// for low-level tests that exercise path safety without requiring the host's
+/// deployed audit groups; daemon startup always uses this role-aware variant.
+pub(crate) fn validate_socket_parent_for(path: &Path, field: &str, role: SocketRole) -> Result<(), ConfigError> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| ConfigError::InvalidPath(format!("{field} has no parent")))?;
+    let metadata = fs::symlink_metadata(parent)?;
+    if metadata.file_type().is_symlink() || !metadata.is_dir() {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent is not a real directory"
+        )));
+    }
+    if metadata.uid() != current_euid() {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent must be owned by the audit daemon"
+        )));
+    }
+    let expected_gid = resolve_gid(role.group_name())
+        .ok_or_else(|| ConfigError::Invalid(format!("required socket group {:?} does not exist", role.group_name())))?;
+    if metadata.gid() != expected_gid {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent must belong to group {:?}",
+            role.group_name()
+        )));
+    }
+    let mode = metadata.permissions().mode() & 0o7777;
+    if mode != SOCKET_DIRECTORY_MODE {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent must have mode {SOCKET_DIRECTORY_MODE:04o}"
+        )));
+    }
+    Ok(())
+}
+
+fn socket_parent_gid(path: &Path) -> io::Result<u32> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "socket path has no parent"))?;
+    let metadata = fs::symlink_metadata(parent)?;
+    if metadata.file_type().is_symlink() || !metadata.is_dir() {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket parent is not a real directory",
+        ));
+    }
+    if metadata.uid() != 0 && metadata.uid() != current_euid() {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket parent has an unexpected owner",
+        ));
+    }
+    if metadata.permissions().mode() & 0o7777 != SOCKET_DIRECTORY_MODE {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket parent has an unexpected mode",
+        ));
+    }
+    Ok(metadata.gid())
+}
+
+fn socket_parent_gid_for(path: &Path, role: SocketRole) -> io::Result<u32> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "socket path has no parent"))?;
+    let metadata = fs::symlink_metadata(parent)?;
+    if metadata.file_type().is_symlink() || !metadata.is_dir() {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket parent is not a real directory",
+        ));
+    }
+    if metadata.uid() != current_euid() {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket parent has an unexpected owner",
+        ));
+    }
+    if metadata.permissions().mode() & 0o7777 != SOCKET_DIRECTORY_MODE {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket parent has an unexpected mode",
+        ));
+    }
+    let expected_gid = resolve_gid(role.group_name()).ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::NotFound,
+            format!("required socket group {:?} does not exist", role.group_name()),
+        )
+    })?;
+    if metadata.gid() != expected_gid {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket parent has an unexpected endpoint group",
+        ));
+    }
+    Ok(expected_gid)
+}
