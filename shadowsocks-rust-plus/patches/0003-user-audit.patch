+/// Shared process-level emitter and its bounded producer state.
+pub struct AuditEmitter {
+    pub runtime: Arc<AuditRuntimeMetadata>,
+    pub queue: Arc<ArrayQueue<AuditEventDraft>>,
+    pub notify: Arc<Notify>,
+    /// Notification reserved for lifecycle shutdown.  `notify` is also fired
+    /// by every relay observation; using it to interrupt a sticky hello-NACK
+    /// backoff would turn the required fixed five-second retry into a busy
+    /// loop whenever traffic is flowing.
+    shutdown_notify: Arc<Notify>,
+    pub udp_windows: Arc<UdpAuditWindowCache>,
+    ingest_socket_path: PathBuf,
+    /// UID resolved from `user_audit.auditd_user` at emitter startup.  Keep
+    /// the result immutable across reconnects so name-service changes cannot
+    /// broaden the accepted peer identity during a process lifetime.
+    #[cfg(target_os = "linux")]
+    auditd_uid: Option<u32>,
+    audit_sequence: AtomicU64,
+    lifecycle_state: AtomicU64,
+    queue_overflow: GapAccumulator,
+    encode_error: GapAccumulator,
+    contention: GapAccumulator,
+    permanent_nack: [GapAccumulator; 3],
+    diagnostic_inflight: AtomicU8,
+    pending_count: AtomicU64,
+    shutdown_skipped_observations: AtomicU64,
+    sequence_exhausted: AtomicBool,
+    diagnostics_frozen: AtomicBool,
+    /// Bucket bits whose failed diagnostic needs a later (per-bucket) retry.
+    diagnostic_retry_buckets: AtomicU8,
+    /// Set once shutdown has closed the producer and the final diagnostic
+    /// snapshot must bypass the normal 60-second cadence.
+    diagnostic_shutdown_requested: AtomicBool,
+    invalid_ack: AtomicU64,
+    hello_nack_count: AtomicU64,
+    hello_nack_degraded: AtomicBool,
+    /// Number of encode-error observations for which the wall clock could not
+    /// be represented.  The corresponding gap keeps its sequence but uses an
+    /// unknown time marker until a later snapshot can attach a valid clock.
+    encode_error_time_unknown: AtomicU64,
+    /// Number of diagnostic snapshots that had no valid current or previously
+    /// observed wall time and therefore had to remain pending.
+    diagnostic_time_unknown: AtomicU64,
+    udp_contention_time_unknown: AtomicU64,
+    /// Diagnostics which became unreportable after the final freeze barrier.
+    /// This is deliberately separate from `shutdown_skipped_observations`:
+    /// the latter counts observations rejected by a closed emitter, while
+    /// this counter covers already-owned queue/in-flight work that could not
+    /// be persisted before shutdown.
+    shutdown_diagnostic_drops: AtomicU64,
+    /// Contention observations crossing the shutdown freeze. This must remain
+    /// distinct from producer events abandoned by queue/diagnostic handling.
+    shutdown_contention_drops: AtomicU64,
+    /// Producer diagnostic drafts that failed local encoding/validation.
+    diagnostic_encode_errors: AtomicU64,
+    /// Producer diagnostics rejected by a valid permanent NACK.
+    diagnostic_permanent_nacks: AtomicU64,
+    sequence_exhausted_events: AtomicU64,
+    /// A single caller owns the bounded drain attempt.  If an outer launcher
+    /// times out and drops that future, the runtime supervisor must not start a
+    /// second two-second drain and exceed the process shutdown budget.
+    drain_started: AtomicBool,
+    drain_completed: AtomicBool,
+    /// Original `count` of the diagnostic snapshot currently owned by the
+    /// supervisor, per bucket.  `take_diagnostic_round_robin` clears the
+    /// accumulator, so without this mirror a snapshot still held in-flight
+    /// when the bounded shutdown drain expires disappears from the final
+    /// aggregate journald and under-reports the abandoned events.
+    diagnostic_inflight_counts: [AtomicU64; DIAGNOSTIC_BUCKETS.len()],
+    /// Number of rate-limited runtime health lines written by the supervisor.
+    /// Only the wiring test reads it; production observability is journald.
+    #[cfg(test)]
+    health_logs: AtomicU64,
+    #[cfg(test)]
+    idle_session_wait_hook: Mutex<Option<IdleSessionWaitHook>>,
+}
+
+impl AuditEmitter {
+    pub fn new(runtime: Arc<AuditRuntimeMetadata>, config: &UserAuditConfig) -> Arc<Self> {
+        Arc::new(Self {
+            runtime,
+            queue: Arc::new(ArrayQueue::new(config.queue_capacity)),
+            notify: Arc::new(Notify::new()),
+            shutdown_notify: Arc::new(Notify::new()),
+            udp_windows: UdpAuditWindowCache::new(
+                config.max_udp_targets_per_association,
+                config.max_udp_target_windows,
+            ),
+            ingest_socket_path: config.ingest_socket_path.clone(),
+            #[cfg(target_os = "linux")]
+            auditd_uid: resolve_user_uid(&config.auditd_user),
+            audit_sequence: AtomicU64::new(0),
+            lifecycle_state: AtomicU64::new(0),
+            queue_overflow: GapAccumulator::default(),
+            encode_error: GapAccumulator::default(),
+            contention: GapAccumulator::default(),
+            permanent_nack: std::array::from_fn(|_| GapAccumulator::default()),
+            diagnostic_inflight: AtomicU8::new(0),
+            pending_count: AtomicU64::new(0),
+            shutdown_skipped_observations: AtomicU64::new(0),
+            sequence_exhausted: AtomicBool::new(false),
+            diagnostics_frozen: AtomicBool::new(false),
+            diagnostic_retry_buckets: AtomicU8::new(0),
+            diagnostic_shutdown_requested: AtomicBool::new(false),
+            invalid_ack: AtomicU64::new(0),
+            hello_nack_count: AtomicU64::new(0),
+            hello_nack_degraded: AtomicBool::new(false),
+            encode_error_time_unknown: AtomicU64::new(0),
+            diagnostic_time_unknown: AtomicU64::new(0),
+            udp_contention_time_unknown: AtomicU64::new(0),
+            shutdown_diagnostic_drops: AtomicU64::new(0),
+            shutdown_contention_drops: AtomicU64::new(0),
+            diagnostic_encode_errors: AtomicU64::new(0),
+            diagnostic_permanent_nacks: AtomicU64::new(0),
+            sequence_exhausted_events: AtomicU64::new(0),
+            drain_started: AtomicBool::new(false),
+            drain_completed: AtomicBool::new(false),
+            diagnostic_inflight_counts: std::array::from_fn(|_| AtomicU64::new(0)),
+            #[cfg(test)]
+            health_logs: AtomicU64::new(0),
+            #[cfg(test)]
+            idle_session_wait_hook: Mutex::new(None),
+        })
+    }
+
+    #[cfg(test)]
+    fn install_idle_session_wait_hook(&self) -> (oneshot::Receiver<()>, oneshot::Sender<()>) {
+        let (entered_tx, entered_rx) = oneshot::channel();
+        let (resume_tx, resume_rx) = oneshot::channel();
+        let mut hook = self
+            .idle_session_wait_hook
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        *hook = Some(IdleSessionWaitHook {
+            entered: entered_tx,
+            resume: resume_rx,
+        });
+        (entered_rx, resume_tx)
+    }
+
+    #[cfg(test)]
+    async fn synchronize_idle_session_wait_hook(&self) {
+        let hook = self
+            .idle_session_wait_hook
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner())
+            .take();
+        if let Some(hook) = hook {
+            let _ = hook.entered.send(());
+            let _ = hook.resume.await;
+        }
+    }
+
+    pub(crate) fn begin_observation(self: &Arc<Self>) -> Option<ObservationGuard> {
+        let mut current = self.lifecycle_state.load(Ordering::Acquire);
+        loop {
+            if current & CLOSED_BIT != 0 || current & ACTIVE_MASK == ACTIVE_MASK {
+                self.shutdown_skipped_observations
+                    .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {
+                        Some(value.saturating_add(1))
+                    })
+                    .ok();
+                return None;
+            }
+            let next = current + 1;
+            match self
+                .lifecycle_state
+                .compare_exchange_weak(current, next, Ordering::AcqRel, Ordering::Acquire)
+            {
+                Ok(_) => return Some(ObservationGuard { emitter: self.clone() }),
+                Err(actual) => current = actual,
+            }
+        }
+    }
+
+    pub fn close_emitter(&self) {
+        self.lifecycle_state.fetch_or(CLOSED_BIT, Ordering::AcqRel);
+        self.notify.notify_waiters();
+        // Exactly one supervisor consumes this lifecycle signal. `notify_one`
+        // retains a permit when close races a frame I/O/backoff boundary;
+        // `notify_waiters` would lose the signal when no waiter is registered.
+        self.shutdown_notify.notify_one();
+    }
+
+    pub async fn drain(&self) {
+        let mut owns_drain = false;
+        loop {
+            // Register before rechecking all state so a producer update cannot
+            // fall between the check and the await (the classic Notify lost
+            // wakeup race).
+            let notified = self.notify.notified();
+            let state = self.lifecycle_state.load(Ordering::Acquire);
+            if state & ACTIVE_MASK != 0 {
+                notified.await;
+                continue;
+            }
+            // After close and the last guard release, relay hooks can no
+            // longer mutate diagnostics. Freeze this boundary before judging
+            // queue/in-flight state.
+            if state & CLOSED_BIT != 0 {
+                // Only one task performs the potentially blocking drain.  A
+                // cancelled outer attempt is intentionally treated as a
+                // bounded best-effort failure; a later supervisor must not
+                // restart the same deadline and hold process shutdown open.
+                if !owns_drain {
+                    if self.drain_started.swap(true, Ordering::AcqRel) {
+                        return;
+                    }
+                    owns_drain = true;
+                }
+                // Freeze producer-side accumulators only after the final
+                // observation guard has gone away.  Ask the still-running
+                // supervisor for one final, rate-limit-bypassing pass.
+                if !self.diagnostics_frozen.swap(true, Ordering::AcqRel) {
+                    self.diagnostic_shutdown_requested.store(true, Ordering::Release);
+                    self.notify.notify_waiters();
+                }
+            }
+            if self.is_drained() {
+                self.drain_completed.store(true, Ordering::Release);
+                return;
+            }
+            notified.await;
+        }
+    }
+
+    pub(crate) fn drain_completed(&self) -> bool {
+        self.drain_completed.load(Ordering::Acquire)
+    }
+
+    fn is_drained(&self) -> bool {
+        let state = self.lifecycle_state.load(Ordering::Acquire);
+        // A drain before `close_emitter` must not report a final snapshot:
+        // relay hooks could still allocate new observations immediately after
+        // the empty-state check.  The closed bit is the one-way freeze barrier.
+        state & CLOSED_BIT != 0
+            && state & ACTIVE_MASK == 0
+            && self.queue.is_empty()
+            && self.pending_count.load(Ordering::Acquire) == 0
+            // A diagnostic snapshot is removed from its accumulator before the
+            // supervisor reserves the pending slot.  Keep drain open across
+            // that small hand-off window so shutdown cannot abort the
+            // supervisor while the snapshot is still in flight.
+            && self.diagnostic_inflight.load(Ordering::Acquire) == 0
+            // Read this last.  The supervisor merges rejected diagnostics back
+            // into their accumulator before decrementing `pending_count` and
+            // clearing the in-flight bit; evaluating it earlier creates a
+            // small TOCTOU window in which drain can return prematurely.
+            && (self.diagnostics_empty() || self.sequence_exhausted.load(Ordering::Acquire))
+    }
+
+    fn diagnostics_empty(&self) -> bool {
+        !self.queue_overflow.is_nonempty()
+            && !self.encode_error.is_nonempty()
+            && !self.contention.is_nonempty()
+            && self.permanent_nack.iter().all(|value| !value.is_nonempty())
+    }
+
+    pub fn take_shutdown_skipped_observations(&self) -> u64 {
+        self.shutdown_skipped_observations.swap(0, Ordering::AcqRel)
+    }
+
+    fn record_shutdown_diagnostic_drop(&self, count: u64) {
+        saturating_add_atomic(&self.shutdown_diagnostic_drops, count);
+    }
+
+    fn record_shutdown_contention_drop(&self, count: u64) {
+        saturating_add_atomic(&self.shutdown_contention_drops, count);
+    }
+
+    fn record_shutdown_bucket_drop(&self, bucket: DiagnosticBucket, count: u64) {
+        if bucket == DiagnosticBucket::Contention {
+            self.record_shutdown_contention_drop(count);
+        } else {
+            self.record_shutdown_diagnostic_drop(count);
+        }
+    }
+
+    fn request_diagnostic_retry(&self, bucket: DiagnosticBucket) {
+        self.diagnostic_retry_buckets.fetch_or(bucket.bit(), Ordering::AcqRel);
+        self.notify.notify_waiters();
+    }
+
+    pub(crate) fn take_shutdown_diagnostic_drops(&self) -> u64 {
+        self.shutdown_diagnostic_drops.swap(0, Ordering::AcqRel)
+    }
+
+    pub(crate) fn take_shutdown_contention_drops(&self) -> u64 {
+        self.shutdown_contention_drops.swap(0, Ordering::AcqRel)
+    }
+
+    /// Read all producer health counters without resetting them. The shutdown
+    /// path samples this after relay joins; other callers may use it for a
+    /// local health endpoint or periodic diagnostic reporter.
+    pub(crate) fn health_snapshot(&self) -> AuditHealthSnapshot {
+        AuditHealthSnapshot {
+            invalid_ack: self.invalid_ack.load(Ordering::Acquire),
+            hello_nack_count: self.hello_nack_count.load(Ordering::Acquire),
+            hello_nack_degraded: self.hello_nack_degraded.load(Ordering::Acquire),
+            encode_error_time_unknown: self.encode_error_time_unknown.load(Ordering::Acquire),
+            diagnostic_time_unknown: self.diagnostic_time_unknown.load(Ordering::Acquire),
+            udp_contention_time_unknown: self.udp_contention_time_unknown.load(Ordering::Acquire),
+            contention_saturated: self.contention.saturated(),
+            producer_gap_saturated: self.queue_overflow.saturated()
+                || self.encode_error.saturated()
+                || self.permanent_nack.iter().any(GapAccumulator::saturated),
+            udp_window_poison_resets: self.udp_windows.poison_reset_count(),
+            diagnostic_encode_errors: self.diagnostic_encode_errors.load(Ordering::Acquire),
+            diagnostic_permanent_nacks: self.diagnostic_permanent_nacks.load(Ordering::Acquire),
+            sequence_exhausted_events: self.sequence_exhausted_events.load(Ordering::Acquire),
+            sequence_exhausted: self.sequence_exhausted.load(Ordering::Acquire),
+        }
+    }
+
+    /// Return best-effort aggregate diagnostic counts for shutdown reporting.
+    /// This is intentionally non-destructive: a concurrent supervisor may still
+    /// own an in-flight snapshot while the outer drain deadline expires.
+    pub(crate) fn diagnostic_pending_counts(&self) -> [u64; 6] {
+        let accumulated = [
+            self.queue_overflow.approximate_count(),
+            self.encode_error.approximate_count(),
+            self.permanent_nack[0].approximate_count(),
+            self.permanent_nack[1].approximate_count(),
+            self.permanent_nack[2].approximate_count(),
+            self.contention.approximate_count(),
+        ];
+        // A snapshot owned by the supervisor has already left its accumulator.
+        // Add the mirrored count so an aborted or budget-expired shutdown still
+        // reports the events it gave up on.
+        let mut counts = accumulated;
+        for (count, mirrored) in counts.iter_mut().zip(self.diagnostic_inflight_counts.iter()) {
+            *count = count.saturating_add(mirrored.load(Ordering::Acquire));
+        }
+        counts
+    }
+
+    /// Capture queue, in-flight, and accumulator counts without taking
+    /// ownership of supervisor state.  This remains useful when the bounded
+    /// shutdown drain deadline expires while a connection is blocked.
+    pub(crate) fn shutdown_pending_snapshot(&self) -> AuditShutdownPendingSnapshot {
+        AuditShutdownPendingSnapshot {
+            queue: self.queue.len(),
+            in_flight: self.pending_count.load(Ordering::Acquire),
+            diagnostic_inflight: self.diagnostic_inflight.load(Ordering::Acquire),
+            diagnostics: self.diagnostic_pending_counts(),
+        }
+    }
+
+    /// Record a non-retryable hello NACK.  The cumulative count is retained
+    /// after recovery while the sticky flag remains set until a valid hello
+    /// ACK proves that the producer session has recovered.
+    fn record_hello_nack(&self) {
+        // A NACK received while the process is already closing belongs to the
+        // bounded shutdown attempt, not to normal runtime health. Do not let
+        // a failing socket fabricate a growing sticky count during teardown.
+        if self.lifecycle_state.load(Ordering::Acquire) & CLOSED_BIT != 0 {
+            return;
+        }
+        saturating_add_atomic(&self.hello_nack_count, 1);
+        self.hello_nack_degraded.store(true, Ordering::Release);
+    }
+
+    fn clear_hello_nack_degraded(&self) {
+        self.hello_nack_degraded.store(false, Ordering::Release);
+    }
+
+    #[cfg(test)]
+    fn hello_nack_health(&self) -> (u64, bool) {
+        (
+            self.hello_nack_count.load(Ordering::Acquire),
+            self.hello_nack_degraded.load(Ordering::Acquire),
+        )
+    }
+
+    #[cfg(test)]
+    fn pending_len(&self) -> u64 {
+        self.pending_count.load(Ordering::Acquire)
+    }
+
+    fn increment_pending(&self) {
+        self.pending_count.fetch_add(1, Ordering::AcqRel);
+        self.notify.notify_waiters();
+    }
+
+    fn decrement_pending(&self) {
+        self.pending_count
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {
+                Some(value.saturating_sub(1))
+            })
+            .ok();
+        self.notify.notify_waiters();
+    }
+
+    fn next_sequence(&self) -> Option<u64> {
+        let mut current = self.audit_sequence.load(Ordering::Acquire);
+        loop {
+            if current == u64::MAX {
+                self.sequence_exhausted_events
+                    .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {
+                        Some(value.saturating_add(1))
+                    })
+                    .ok();
+                if !self.sequence_exhausted.swap(true, Ordering::AcqRel) {
+                    log::warn!("user audit sequence exhausted");
+                }
+                return None;
+            }
+            let next = current.saturating_add(1);
+            match self
+                .audit_sequence
+                .compare_exchange_weak(current, next, Ordering::AcqRel, Ordering::Acquire)
+            {
+                Ok(_) => return Some(next),
+                Err(actual) => current = actual,
+            }
+        }
+    }
+
+    fn now(&self) -> Result<(u64, u64), ()> {
+        let wall = SystemTime::now().duration_since(UNIX_EPOCH).map_err(|_| ())?;
+        let occurred = wall.as_millis().try_into().map_err(|_| ())?;
+        let monotonic = self
+            .runtime
+            .runtime_started_at
+            .elapsed()
+            .as_millis()
+            .try_into()
+            .map_err(|_| ())?;
+        Ok((occurred, monotonic))
+    }
+
+    pub fn try_emit_tcp(self: &Arc<Self>, identity: &Arc<AuditIdentityHandle>, target: AuditTargetDraft) {
+        let Some(_guard) = self.begin_observation() else { return };
+        let Some(sequence) = self.next_sequence() else { return };
+        let (occurred, monotonic) = match self.now() {
+            Ok(value) => value,
+            Err(_) => {
+                self.record_encode_error(sequence);
+                return;
+            }
+        };
+        let draft = AuditEventDraft::Tcp {
+            sequence,
+            occurred_at_unix_ms: occurred,
+            runtime_monotonic_ms: monotonic,
+            runtime: identity.runtime.clone(),
+            server: identity.server.clone(),
+            identity: identity.identity.clone(),
+            target,
+        };
+        self.try_push(draft);
+    }
+
+    /// UDP variant for relays that can describe the raw target cheaply but do
+    /// not want to build/normalize the full target on a cooldown hit.  The
+    /// closure is evaluated only after the cache has decided that a target is
+    /// needed (a miss or an expired entry); the canonical second lookup inside
+    /// `eligible_lazy` still protects Unicode and case-equivalent domain
+    /// spellings from bypassing the window.
+    pub fn try_emit_udp_lazy<F>(
+        self: &Arc<Self>,
+        identity: &Arc<AuditIdentityHandle>,
+        association_id: [u8; 16],
+        host: UdpAuditHost<'_>,
+        port: u16,
+        build_target: F,
+    ) where
+        F: FnOnce() -> AuditTargetDraft,
+    {
+        let Some(_guard) = self.begin_observation() else { return };
+        let now = Instant::now();
+        let target = match self.udp_windows.eligible_lazy(
+            &identity.server.server_id,
+            association_id,
+            host,
+            port,
+            now,
+            build_target,
+        ) {
+            Ok(value) => value,
+            Err(()) => {
+                self.record_contention_now();
+                return;
+            }
+        };
+        let Some(target) = target else {
+            return;
+        };
+        let Some(sequence) = self.next_sequence() else { return };
+        let (occurred, monotonic) = match self.now() {
+            Ok(value) => value,
+            Err(_) => {
+                self.record_encode_error(sequence);
+                return;
+            }
+        };
+        self.try_push(AuditEventDraft::Udp {
+            sequence,
+            occurred_at_unix_ms: occurred,
+            runtime_monotonic_ms: monotonic,
+            runtime: identity.runtime.clone(),
+            server: identity.server.clone(),
+            identity: identity.identity.clone(),
+            association_id,
+            target,
+        });
+    }
+
+    /// Account for a TCP observation whose target could not be represented.
+    ///
+    /// This consumes one audit sequence and records an encode gap while leaving
+    /// the relay data path unaffected.
+    pub fn record_tcp_encode_error(self: &Arc<Self>) {
+        let Some(_guard) = self.begin_observation() else { return };
+        let Some(sequence) = self.next_sequence() else { return };
+        self.record_encode_error(sequence);
+    }
+
+    fn record_encode_error(&self, sequence: u64) {
+        let timestamp = self.gap_observation_time();
+        if self.diagnostics_frozen.load(Ordering::Acquire) {
+            // The observation already owns a guard, but the shutdown freeze
+            // crossed before its event could be encoded.  It cannot be
+            // reintroduced into an accumulator that drain has closed.
+            self.record_shutdown_diagnostic_drop(1);
+        } else {
+            // `0` is an internal unknown-time marker only.  It is converted to
+            // a valid reporting time before a diagnostic reaches the wire.
+            self.encode_error.add(1, Some(sequence), timestamp);
+        }
+        self.notify.notify_one();
+    }
+
+    fn gap_observation_time(&self) -> u64 {
+        self.gap_observation_time_from(wall_now())
+    }
+
+    fn gap_observation_time_from(&self, timestamp: Option<u64>) -> u64 {
+        match timestamp {
+            Some(value) => value,
+            None => {
+                saturating_add_atomic(&self.encode_error_time_unknown, 1);
+                0
+            }
+        }
+    }
+
+    fn try_push(&self, draft: AuditEventDraft) {
+        self.try_push_observed_at(draft, wall_now());
+    }
+
+    fn try_push_observed_at(&self, draft: AuditEventDraft, observed_at: Option<u64>) {
+        if let Some(dropped) = self.queue.force_push(draft) {
+            // `force_push` returns the old draft that was evicted.  Record
+            // that draft's sequence/time, never the newly inserted event.
+            if !self.diagnostics_frozen.load(Ordering::Acquire) {
+                // An unavailable wall clock is accounted like the other gap
+                // paths: count it in `encode_error_time_unknown` and keep `0`
+                // as the internal unknown-time marker.
+                let observed_at = self.gap_observation_time_from(observed_at);
+                self.queue_overflow.add(1, Some(dropped.sequence()), observed_at);
+            } else {
+                // The producer-side accumulators are frozen after the last
+                // observation guard has drained.  A supervisor-side
+                // force-push can still cross that barrier, so retain an
+                // aggregate shutdown diagnostic instead of silently losing
+                // the evicted event.
+                self.record_shutdown_diagnostic_drop(1);
+            }
+        }
+        self.notify.notify_one();
+    }
+
+    fn record_contention_at(&self, now: u64) {
+        if !self.diagnostics_frozen.load(Ordering::Acquire) {
+            self.contention.add(1, None, now);
+        } else {
+            // This send already owns an observation guard, so it is not
+            // counted by `begin_observation`'s shutdown-skipped counter. Keep
+            // the successful-send contention signal in its own bucket rather
+            // than folding it into generic diagnostic drops.
+            self.record_shutdown_contention_drop(1);
+        }
+        self.notify.notify_one();
+    }
+
+    fn record_contention_now(&self) {
+        match wall_now() {
+            Some(now) => self.record_contention_at(now),
+            None => {
+                if !self.diagnostics_frozen.load(Ordering::Acquire) {
+                    self.udp_contention_time_unknown
+                        .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {
+                            Some(value.saturating_add(1))
+                        })
+                        .ok();
+                } else {
+                    self.record_shutdown_contention_drop(1);
+                }
+                self.notify.notify_one();
+            }
+        }
+    }
+
+    pub fn spawn_supervisor(self: &Arc<Self>) -> tokio::task::JoinHandle<()> {
+        let emitter = self.clone();
+        tokio::spawn(async move { run_supervisor(emitter).await })
+    }
+
+    #[cfg(test)]
+    fn take_diagnostic(&self) -> Option<DiagnosticCandidate> {
+        self.take_diagnostic_excluding(0)
+    }
+
+    /// Take one pending diagnostic, optionally excluding buckets that have
+    /// already had their one shutdown-final attempt.  A diagnostic that gets a
+    /// permanent NACK is merged back into its accumulator; excluding that
+    /// bucket for the remainder of this final pass prevents a tight retry loop
+    /// while still allowing other buckets to make a final attempt.
+    #[cfg(test)]
+    fn take_diagnostic_excluding(&self, excluded: u8) -> Option<DiagnosticCandidate> {
+        self.take_diagnostic_round_robin(
+            excluded,
+            0,
+            Instant::now(),
+            &[Instant::now(); DIAGNOSTIC_BUCKETS.len()],
+            true,
+        )
+    }
+
+    fn take_diagnostic_round_robin(
+        &self,
+        excluded: u8,
+        start: usize,
+        now: Instant,
+        next_due: &[Instant; DIAGNOSTIC_BUCKETS.len()],
+        force: bool,
+    ) -> Option<DiagnosticCandidate> {
+        if self.sequence_exhausted.load(Ordering::Acquire) {
+            return None;
+        }
+
+        // Diagnostics live outside the access queue.  A bucket is blocked
+        // while its current snapshot is in-flight, so continuously arriving
+        // diagnostics cannot create an unbounded feedback loop or starve
+        // access events.
+        for offset in 0..DIAGNOSTIC_BUCKETS.len() {
+            let bucket = DIAGNOSTIC_BUCKETS[(start + offset) % DIAGNOSTIC_BUCKETS.len()];
+            let bit = bucket.bit();
+            if excluded & bit != 0 {
+                continue;
+            }
+            if !force && now < next_due[bucket.index()] {
+                continue;
+            }
+            // Claim the bucket before taking its accumulator snapshot.  This
+            // closes the hand-off window in which `take()` has removed the
+            // snapshot but the pending/in-flight marker has not yet been
+            // published, which would otherwise let drain return early.
+            if self.diagnostic_inflight.fetch_or(bit, Ordering::AcqRel) & bit != 0 {
+                continue;
+            }
+            let Some(snapshot) = self.accumulator(bucket).take() else {
+                self.diagnostic_inflight.fetch_and(!bit, Ordering::AcqRel);
+                continue;
+            };
+            // A diagnostic must never put a fabricated zero timestamp on the
+            // wire.  If the current clock is unavailable, an existing
+            // last-seen value is a valid fallback; when both are unknown,
+            // restore the snapshot and retry on a later cadence.
+            let occurred = match (wall_now(), snapshot.last_time) {
+                (Some(current), last_seen) => current.max(last_seen),
+                (None, last_seen) if last_seen != 0 => last_seen,
+                (None, _) => {
+                    self.diagnostic_time_unknown
+                        .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {
+                            Some(value.saturating_add(1))
+                        })
+                        .ok();
+                    if self.diagnostics_frozen.load(Ordering::Acquire) {
+                        self.record_shutdown_bucket_drop(bucket, snapshot.count);
+                    } else {
+                        self.accumulator(bucket).merge(snapshot);
+                        // Tell the supervisor to defer the next attempt.  A
+                        // missing wall clock must not turn the diagnostic
+                        // path into a zero-delay retry loop.
+                        self.request_diagnostic_retry(bucket);
+                    }
+                    self.diagnostic_inflight.fetch_and(!bit, Ordering::AcqRel);
+                    self.notify.notify_waiters();
+                    continue;
+                }
+            };
+            let (first_seen, last_seen) = diagnostic_bounds(snapshot, occurred);
+            let Some(sequence) = self.next_sequence() else {
+                if self.diagnostics_frozen.load(Ordering::Acquire) {
+                    self.record_shutdown_bucket_drop(bucket, snapshot.count);
+                } else {
+                    self.accumulator(bucket).merge(snapshot);
+                }
+                self.diagnostic_inflight.fetch_and(!bit, Ordering::AcqRel);
+                return None;
+            };
+            let draft = if let Some(code) = bucket.permanent_code() {
+                AuditEventDraft::ProducerGap {
+                    sequence,
+                    occurred_at_unix_ms: occurred,
+                    runtime: self.runtime.clone(),
+                    reason: "permanent_nack".to_owned(),
+                    permanent_nack_code: Some(permanent_nack_code_text(code).to_owned()),
+                    dropped_events: snapshot.count,
+                    first_dropped_sequence: snapshot.first,
+                    last_dropped_sequence: snapshot.last,
+                    first_seen_unix_ms: first_seen,
+                    last_seen_unix_ms: last_seen,
+                }
+            } else if bucket == DiagnosticBucket::Contention {
+                AuditEventDraft::UdpContention {
+                    sequence,
+                    occurred_at_unix_ms: occurred,
+                    runtime: self.runtime.clone(),
+                    skipped_successful_datagrams: snapshot.count,
+                    first_seen_unix_ms: first_seen,
+                    last_seen_unix_ms: last_seen,
+                }
+            } else {
+                let reason = if bucket == DiagnosticBucket::QueueOverflow {
+                    "queue_overflow"
+                } else {
+                    // The only remaining non-contention bucket is encode_error.
+                    "encode_error"
+                };
+                AuditEventDraft::ProducerGap {
+                    sequence,
+                    occurred_at_unix_ms: occurred,
+                    runtime: self.runtime.clone(),
+                    reason: reason.to_owned(),
+                    permanent_nack_code: None,
+                    dropped_events: snapshot.count,
+                    first_dropped_sequence: snapshot.first,
+                    last_dropped_sequence: snapshot.last,
+                    first_seen_unix_ms: first_seen,
+                    last_seen_unix_ms: last_seen,
+                }
+            };
+            // Publish the taken count before the candidate escapes: from here
+            // on the accumulator is empty, so only this mirror can account for
+            // the snapshot in a shutdown report.
+            self.diagnostic_inflight_counts[bucket.index()].store(snapshot.count, Ordering::Release);
+            return Some(DiagnosticCandidate {
+                draft,
+                bucket,
+                snapshot,
+            });
+        }
+        None
+    }
+
+    fn accumulator(&self, bucket: DiagnosticBucket) -> &GapAccumulator {
+        match bucket {
+            DiagnosticBucket::QueueOverflow => &self.queue_overflow,
+            DiagnosticBucket::EncodeError => &self.encode_error,
+            DiagnosticBucket::PermanentNack(PermanentNackCode::InvalidSchema) => &self.permanent_nack[0],
+            DiagnosticBucket::PermanentNack(PermanentNackCode::EventIdConflict) => &self.permanent_nack[1],
+            DiagnosticBucket::PermanentNack(PermanentNackCode::RuntimeMismatch) => &self.permanent_nack[2],
+            DiagnosticBucket::Contention => &self.contention,
+        }
+    }
+
+    fn requeue_diagnostic(&self, candidate: DiagnosticCandidate) {
+        if self.diagnostics_frozen.load(Ordering::Acquire) {
+            // The final drain pass has already crossed the producer freeze
+            // barrier.  Re-adding a failed snapshot here would make drain
+            // wait forever (and could recursively manufacture another gap).
+            self.record_shutdown_bucket_drop(candidate.bucket, candidate.snapshot.count);
+        } else {
+            self.accumulator(candidate.bucket).merge(candidate.snapshot);
+        }
+        self.diagnostic_inflight_counts[candidate.bucket.index()].store(0, Ordering::Release);
+        self.diagnostic_inflight
+            .fetch_and(!candidate.bucket.bit(), Ordering::AcqRel);
+        self.notify.notify_waiters();
+    }
+
+    fn resolve_pending(&self, event: &PendingEvent, permanent_nack: Option<EventNackCode>) {
+        if let PendingKind::Diagnostic { bucket, snapshot } = &event.kind {
+            self.diagnostic_inflight.fetch_and(!bucket.bit(), Ordering::AcqRel);
+            if permanent_nack.is_some() {
+                self.diagnostic_permanent_nacks
+                    .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {
+                        Some(value.saturating_add(1))
+                    })
+                    .ok();
+                // A diagnostic rejection is not itself an additional gap;
+                // preserve the original snapshot for a later retry.
+                if self.diagnostics_frozen.load(Ordering::Acquire) {
+                    self.record_shutdown_bucket_drop(*bucket, snapshot.count);
+                } else {
+                    self.accumulator(*bucket).merge(*snapshot);
+                    self.request_diagnostic_retry(*bucket);
+                }
+            }
+            // Release the shutdown mirror only after the snapshot has been
+            // returned to its accumulator or booked as a shutdown drop.
+            self.diagnostic_inflight_counts[bucket.index()].store(0, Ordering::Release);
+        } else if let Some(bucket) = permanent_nack.and_then(permanent_bucket) {
+            if let PendingKind::Access { sequence } = event.kind {
+                if self.diagnostics_frozen.load(Ordering::Acquire) {
+                    self.record_shutdown_diagnostic_drop(1);
+                } else {
+                    // first/last_seen describe when this permanent rejection
+                    // was observed, not when the original access occurred.
+                    let observed_at = self.gap_observation_time();
+                    self.accumulator(bucket).add(1, Some(sequence), observed_at);
+                }
+            }
+        }
+        self.decrement_pending();
+    }
+
+    fn encode_pending(&self, draft: AuditEventDraft) -> Result<PendingEvent, ()> {
+        let bytes = draft.to_json().map_err(|_| ())?;
+        if bytes.is_empty() || bytes.len() > MAX_AUDIT_PAYLOAD_BYTES || draft.is_diagnostic() {
+            return Err(());
+        }
+        let record = parse_canonical_record(&bytes).map_err(|_| ())?;
+        let event_id = draft.event_id();
+        if record.event_id() != event_id {
+            return Err(());
+        }
+        Ok(PendingEvent {
+            bytes,
+            event_id,
+            kind: PendingKind::Access {
+                sequence: draft.sequence(),
+            },
+        })
+    }
+
+    fn encode_candidate(&self, candidate: DiagnosticCandidate) -> Result<PendingEvent, DiagnosticCandidate> {
+        let bytes = match candidate.draft.to_json() {
+            Ok(bytes) if !bytes.is_empty() && bytes.len() <= MAX_AUDIT_PAYLOAD_BYTES => bytes,
+            _ => return Err(candidate),
+        };
+        let record = match parse_canonical_record(&bytes) {
+            Ok(record) => record,
+            Err(_) => return Err(candidate),
+        };
+        let event_id = candidate.draft.event_id();
+        if record.event_id() != event_id {
+            return Err(candidate);
+        }
+        Ok(PendingEvent {
+            bytes,
+            event_id,
+            kind: PendingKind::Diagnostic {
+                bucket: candidate.bucket,
+                snapshot: candidate.snapshot,
+            },
+        })
+    }
+}
+
+fn permanent_bucket(code: EventNackCode) -> Option<DiagnosticBucket> {
+    match code {
+        EventNackCode::InvalidSchema => Some(DiagnosticBucket::PermanentNack(PermanentNackCode::InvalidSchema)),
+        EventNackCode::EventIdConflict => Some(DiagnosticBucket::PermanentNack(PermanentNackCode::EventIdConflict)),
+        EventNackCode::RuntimeMismatch => Some(DiagnosticBucket::PermanentNack(PermanentNackCode::RuntimeMismatch)),
+        EventNackCode::StorageUnavailable | EventNackCode::InternalError => None,
+    }
+}
+
+fn permanent_nack_code_text(code: PermanentNackCode) -> &'static str {
+    match code {
+        PermanentNackCode::InvalidSchema => "invalid_schema",
+        PermanentNackCode::EventIdConflict => "event_id_conflict",
+        PermanentNackCode::RuntimeMismatch => "runtime_mismatch",
+    }
+}
+
+/// Initial value for a 60-second rate-limit stamp.  The first log line must
+/// be allowed immediately, but `Instant - Duration` panics when the monotonic
+/// clock has not been running for a whole interval yet (C-6).  Clamp to `now`
+/// instead of aborting the producer.
+fn rate_limit_stamp_before(now: Instant, interval: Duration) -> Instant {
+    now.checked_sub(interval).unwrap_or(now)
+}
+
+fn wall_now() -> Option<u64> {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .ok()
+        .and_then(|value| value.as_millis().try_into().ok())
+}
+
+/// Deadline arithmetic for the diagnostic cadence.  `Instant + Duration`
+/// panics on overflow; a rate-limit deadline must degrade to "due now" instead
+/// of aborting the producer.  This is the additive counterpart of the C-6
+/// `checked_sub` guard.
+fn deadline_after(now: Instant, interval: Duration) -> Instant {
+    now.checked_add(interval).unwrap_or(now)
+}
+
+/// Convert an accumulator snapshot into the required inclusive time range.
+/// Zero is the internal marker for an unknown boundary; it must never escape
+/// as an invented wire timestamp.  An unknown first boundary is conservatively
+/// collapsed to the known last boundary, while a known boundary is clamped to
+/// `occurred` so clock rollback cannot violate `first <= last <= occurred`.
+fn diagnostic_bounds(snapshot: GapSnapshot, occurred: u64) -> (u64, u64) {
+    let last_seen = if snapshot.last_time == 0 {
+        occurred
+    } else {
+        snapshot.last_time.min(occurred)
+    };
+    let first_seen = if snapshot.first_time == 0 {
+        last_seen
+    } else {
+        snapshot.first_time.min(last_seen)
+    };
+    (first_seen, last_seen)
+}
+
+fn fill_pending(emitter: &AuditEmitter, state: &mut SupervisorState) {
+    let now = Instant::now();
+    // A diagnostic can request a retry while this fill pass is already
+    // running (for example when its wall-clock timestamp is unavailable).
+    // Keep a local mask so the newly requeued bucket is not selected again in
+    // the same pass, which would otherwise become a bounded but wasteful
+    // tight loop while the access queue is being drained.
+    let mut retry_deadline_applied = 0u8;
+    let retry_bits = emitter.diagnostic_retry_buckets.swap(0, Ordering::AcqRel);
+    for bucket in DIAGNOSTIC_BUCKETS {
+        if retry_bits & bucket.bit() != 0 {
+            state.diagnostic_next_due[bucket.index()] =
+                state.diagnostic_next_due[bucket.index()].max(deadline_after(now, DIAGNOSTIC_INTERVAL));
+            retry_deadline_applied |= bucket.bit();
+        }
+    }
+    if emitter.diagnostic_shutdown_requested.swap(false, Ordering::AcqRel) {
+        state.force_final_diagnostics = true;
+        state.final_diagnostic_attempted = 0;
+    }
+
+    while state.pending.len() < MAX_IN_FLIGHT {
+        let now = Instant::now();
+        // Consume retry requests raised by the preceding candidate attempt.
+        // Do this before selecting the next candidate, but apply each bit at
+        // most once per fill pass so a long access queue cannot keep extending
+        // the same deadline.
+        // Atomically consume retry requests raised by the preceding attempt.
+        // Leaving the bits set would apply the same failure once here and once
+        // again at the start of the next fill pass, extending one 60-second
+        // retry into two intervals.
+        let retry_bits = emitter.diagnostic_retry_buckets.swap(0, Ordering::AcqRel);
+        for bucket in DIAGNOSTIC_BUCKETS {
+            let bit = bucket.bit();
+            if retry_bits & bit != 0 && retry_deadline_applied & bit == 0 {
+                state.diagnostic_next_due[bucket.index()] =
+                    state.diagnostic_next_due[bucket.index()].max(deadline_after(now, DIAGNOSTIC_INTERVAL));
+                retry_deadline_applied |= bit;
+            }
+        }
+        let candidate = if state.force_final_diagnostics {
+            emitter.take_diagnostic_round_robin(
+                state.final_diagnostic_attempted,
+                state.diagnostic_cursor,
+                now,
+                &state.diagnostic_next_due,
+                true,
+            )
+        } else {
+            emitter.take_diagnostic_round_robin(0, state.diagnostic_cursor, now, &state.diagnostic_next_due, false)
+        };
+        if let Some(candidate) = candidate {
+            state.mark_diagnostic_attempt(candidate.bucket, now);
+            if let AuditEventDraft::UdpContention {
+                skipped_successful_datagrams,
+                first_seen_unix_ms,
+                last_seen_unix_ms,
+                ..
+            } = &candidate.draft
+            {
+                // `mark_diagnostic_attempt` applies the same per-bucket
+                // 60-second cadence to this aggregate warning. Never include
+                // identity, target, association, event body, or credentials.
+                log::warn!(
+                    "user audit UDP window contention skipped_successful_datagrams={} first_seen_unix_ms={} last_seen_unix_ms={}",
+                    skipped_successful_datagrams,
+                    first_seen_unix_ms,
+                    last_seen_unix_ms,
+                );
+            }
+            if let AuditEventDraft::ProducerGap {
+                reason,
+                permanent_nack_code,
+                dropped_events,
+                first_seen_unix_ms,
+                last_seen_unix_ms,
+                ..
+            } = &candidate.draft
+                && state.gap_log_next_due[candidate.bucket.index()] <= now
+            {
+                // Sections 7.1/7.2 require health *and* a rate-limited
+                // aggregate journald line for every abandoned-event bucket, not
+                // only the wire diagnostic.  Counts, time range and error class
+                // only: never identity, target, event body or credentials.
+                state.gap_log_next_due[candidate.bucket.index()] = deadline_after(now, DIAGNOSTIC_INTERVAL);
+                #[cfg(test)]
+                {
+                    state.gap_logs += 1;
+                }
+                log::warn!(
+                    "user audit producer gap reason={} permanent_nack_code={} dropped_events={} first_seen_unix_ms={} last_seen_unix_ms={}",
+                    reason,
+                    permanent_nack_code.as_deref().unwrap_or("null"),
+                    dropped_events,
+                    first_seen_unix_ms,
+                    last_seen_unix_ms,
+                );
+            }
+            if state.force_final_diagnostics {
+                state.final_diagnostic_attempted |= candidate.bucket.bit();
+            }
+            emitter.increment_pending();
+            match emitter.encode_candidate(candidate) {
+                Ok(event) => state.pending.push_back(event),
+                Err(candidate) => {
+                    let bucket = candidate.bucket;
+                    emitter
+                        .diagnostic_encode_errors
+                        .fetch_update(Ordering::AcqRel, Ordering::Acquire, |value| {
+                            Some(value.saturating_add(1))
+                        })
+                        .ok();
+                    emitter.requeue_diagnostic(candidate);
+                    // `fill_pending` continues in the same pass after a
+                    // failed encode.  Publish the retry deadline directly so
+                    // that the just-requeued bucket cannot be selected again
+                    // in this pass before the atomic retry notification is
+                    // consumed at the next pass.
+                    state.diagnostic_next_due[bucket.index()] =
+                        state.diagnostic_next_due[bucket.index()].max(deadline_after(now, DIAGNOSTIC_INTERVAL));
+                    emitter.decrement_pending();
+                }
+            }
+            continue;
+        }
+
+        // Claim the pending slot before touching the queue. This closes the
+        // pop-to-encode hand-off window observed by drain().
+        emitter.increment_pending();
+        let Some(draft) = emitter.queue.pop() else {
+            emitter.decrement_pending();
+            break;
+        };
+        let sequence = draft.sequence();
+        match emitter.encode_pending(draft) {
+            Ok(event) => state.pending.push_back(event),
+            Err(()) => {
+                if emitter.diagnostics_frozen.load(Ordering::Acquire) {
+                    emitter.record_shutdown_diagnostic_drop(1);
+                } else {
+                    let observed_at = emitter.gap_observation_time();
+                    emitter.encode_error.add(1, Some(sequence), observed_at);
+                }
+                emitter.decrement_pending();
+                emitter.notify.notify_one();
+            }
+        }
+    }
+
+    // The final pass is complete once every bucket has either been attempted or
+    // is empty.  Requiring a bit for *all* buckets was unreachable (an empty
+    // bucket never produces a candidate), which kept the 10ms force-final
+    // polling cadence running for the whole drain window.
+    if state.force_final_diagnostics
+        && DIAGNOSTIC_BUCKETS.iter().all(|bucket| {
+            state.final_diagnostic_attempted & bucket.bit() != 0 || !emitter.accumulator(*bucket).is_nonempty()
+        })
+    {
+        state.force_final_diagnostics = false;
+    }
+}
+
+/// Expose the producer health counters at runtime.  Section 7.2 makes journald
+/// the local observability surface; sampling them only on the shutdown path
+/// leaves a degraded long-lived producer invisible for the whole process
+/// lifetime.  Counts only, at most one line per diagnostic interval.
+fn log_producer_health(emitter: &AuditEmitter, last_log: &mut Instant) {
+    if last_log.elapsed() < DIAGNOSTIC_INTERVAL {
+        return;
+    }
+    let health = emitter.health_snapshot();
+    if !health.has_issue() {
+        return;
+    }
+    *last_log = Instant::now();
+    #[cfg(test)]
+    emitter.health_logs.fetch_add(1, Ordering::Relaxed);
+    log::warn!(
+        "user audit producer health invalid_ack={} hello_nack_count={} hello_nack_degraded={} \
+         encode_error_time_unknown={} diagnostic_time_unknown={} udp_contention_time_unknown={} \
+         contention_saturated={} producer_gap_saturated={} udp_window_poison_resets={} \
+         diagnostic_encode_errors={} diagnostic_permanent_nacks={} sequence_exhausted_events={} \
+         sequence_exhausted={}",
+        health.invalid_ack,
+        health.hello_nack_count,
+        health.hello_nack_degraded,
+        health.encode_error_time_unknown,
+        health.diagnostic_time_unknown,
+        health.udp_contention_time_unknown,
+        health.contention_saturated,
+        health.producer_gap_saturated,
+        health.udp_window_poison_resets,
+        health.diagnostic_encode_errors,
+        health.diagnostic_permanent_nacks,
+        health.sequence_exhausted_events,
+        health.sequence_exhausted,
+    );
+}
+
+fn supervisor_drained(emitter: &AuditEmitter, state: &SupervisorState) -> bool {
+    let lifecycle = emitter.lifecycle_state.load(Ordering::Acquire);
+    lifecycle & CLOSED_BIT != 0
+        && lifecycle & ACTIVE_MASK == 0
+        && state.pending.is_empty()
+        && emitter.queue.is_empty()
+        && emitter.pending_count.load(Ordering::Acquire) == 0
+        && emitter.diagnostic_inflight.load(Ordering::Acquire) == 0
+        && (emitter.diagnostics_empty() || emitter.sequence_exhausted.load(Ordering::Acquire))
+}
+
+async fn run_supervisor(emitter: Arc<AuditEmitter>) {
+    let mut state = SupervisorState::new();
+    // First instant at which this supervisor observed the closed lifecycle
+    // bit.  The bounded shutdown drain budget is measured from there.
+    let mut shutdown_started: Option<Instant> = None;
+    let now = Instant::now();
+    let mut last_error_log = rate_limit_stamp_before(now, DIAGNOSTIC_INTERVAL);
+    let mut last_hello_nack_log = rate_limit_stamp_before(now, DIAGNOSTIC_INTERVAL);
+    let mut last_health_log = rate_limit_stamp_before(now, DIAGNOSTIC_INTERVAL);
+    loop {
+        log_producer_health(&emitter, &mut last_health_log);
+        fill_pending(&emitter, &mut state);
+        if supervisor_drained(&emitter, &state) {
+            break;
+        }
+
+        if state.pending.is_empty() {
+            let notified = emitter.notify.notified();
+            if !emitter.queue.is_empty() {
+                continue;
+            }
+            let diagnostics_pending =
+                !emitter.sequence_exhausted.load(Ordering::Acquire) && !emitter.diagnostics_empty();
+            let wait_for_diagnostic = if state.force_final_diagnostics {
+                Duration::from_millis(10)
+            } else if diagnostics_pending {
+                state
+                    .next_diagnostic_wait(&emitter, Instant::now())
+                    .max(Duration::from_millis(10))
+            } else {
+                DIAGNOSTIC_INTERVAL
+            };
+            tokio::select! {
+                _ = notified => {},
+                _ = time::sleep(wait_for_diagnostic) => {},
+            }
+            continue;
+        }
+
+        let error = match connect_and_send_session(&emitter, &mut state, true).await {
+            Ok(()) if supervisor_drained(&emitter, &state) => break,
+            Ok(()) => io::Error::new(
+                io::ErrorKind::UnexpectedEof,
+                "user audit ingest session ended unexpectedly",
+            ),
+            Err(error) => error,
+        };
+
+        let sticky = is_sticky_hello_nack(&error);
+        if sticky {
+            // A non-retryable hello NACK is a configuration/identity problem
+            // rather than a transient outage. Keep the producer alive, but
+            // expose the sticky degraded state and rate-limit its warning.
+            if last_hello_nack_log.elapsed() >= DIAGNOSTIC_INTERVAL {
+                log::warn!("user audit producer degraded after non-retryable hello NACK; retrying hello every 5s");
+                last_hello_nack_log = Instant::now();
+            }
+        } else if last_error_log.elapsed() >= DIAGNOSTIC_INTERVAL {
+            // This includes the defensive unexpected-Ok path above, giving it
+            // the same warning and reconnect behavior as an explicit error.
+            log::warn!("user audit ingest session unavailable: {error}");
+            last_error_log = Instant::now();
+        }
+
+        if emitter.lifecycle_state.load(Ordering::Acquire) & CLOSED_BIT != 0 {
+            // Section 7.3 grants a bounded two-second drain, not a single
+            // attempt: one retryable NACK during SIGTERM must not discard the
+            // queue together with the whole in-flight backlog.  Keep replaying
+            // the preserved bytes on a fixed short cadence until the budget is
+            // exhausted; only then drop what is left, which the final
+            // aggregate journald still accounts for.
+            let started = *shutdown_started.get_or_insert_with(Instant::now);
+            let remaining = SHUTDOWN_DRAIN_BUDGET.saturating_sub(started.elapsed());
+            if remaining.is_zero() {
+                break;
+            }
+            state.backoff = INITIAL_RECONNECT_BACKOFF;
+            time::sleep(SHUTDOWN_RETRY_DELAY.min(remaining)).await;
+            continue;
+        }
+
+        let base = state.backoff;
+        let delay = reconnect_delay_for_error(&error, base);
+        // Queue traffic must not bypass transport backoff. The dedicated
+        // lifecycle Notify retains the close permit across frame-I/O races.
+        let shutdown_notified = emitter.shutdown_notify.notified();
+        if emitter.lifecycle_state.load(Ordering::Acquire) & CLOSED_BIT == 0 {
+            tokio::select! {
+                _ = shutdown_notified => {},
+                _ = time::sleep(delay) => {},
+            }
+        }
+        if emitter.lifecycle_state.load(Ordering::Acquire) & CLOSED_BIT != 0 {
+            state.backoff = INITIAL_RECONNECT_BACKOFF;
+        } else if !sticky && base < MAX_RECONNECT_BACKOFF {
+            state.backoff = (base * 2).min(MAX_RECONNECT_BACKOFF);
+        }
+    }
+}
+
+/// Compatibility wrapper used by focused unit tests. Production supervision
+/// calls `connect_and_send_session` with `keep_alive=true`.
+#[cfg(test)]
+async fn connect_and_send(
+    emitter: &AuditEmitter,
+    pending: &mut VecDeque<PendingEvent>,
+    backoff: &mut Duration,
+) -> io::Result<()> {
+    let mut state = SupervisorState::new();
+    state.pending = std::mem::take(pending);
+    state.backoff = *backoff;
+    let result = connect_and_send_session(emitter, &mut state, false).await;
+    *pending = state.pending;
+    *backoff = state.backoff;
+    result
+}
+
+async fn connect_and_send_session(
+    emitter: &AuditEmitter,
+    state: &mut SupervisorState,
+    keep_alive: bool,
+) -> io::Result<()> {
+    #[cfg(target_os = "linux")]
+    let auditd_uid = emitter.auditd_uid.ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "configured auditd user could not be resolved",
+        )
+    })?;
+    #[cfg(target_os = "linux")]
+    validate_audit_socket_inode(&emitter.ingest_socket_path, auditd_uid)?;
+    let stream = time::timeout(ACK_TIMEOUT, UnixStream::connect(&emitter.ingest_socket_path))
+        .await
+        .map_err(|_| io::Error::new(io::ErrorKind::TimedOut, "audit socket connect timed out"))??;
+    #[cfg(target_os = "linux")]
+    {
+        // Re-check the pathname after connect to close the common unlink/
+        // replace race, then authenticate the connected peer itself.
+        validate_audit_socket_inode(&emitter.ingest_socket_path, auditd_uid)?;
+        let peer_uid = audit_peer_uid(&stream)?;
+        if peer_uid != auditd_uid {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "auditd peer UID does not match configured auditd user",
+            ));
+        }
+    }
+    let (mut reader, mut writer) = stream.into_split();
+    let hello = Hello::new(emitter.runtime.node_id.as_ref(), emitter.runtime.runtime_id.as_ref());
+    let hello_bytes = serialize_canonical(&hello).map_err(|error| io::Error::other(error.to_string()))?;
+    write_frame_with_deadline(&mut writer, &hello_bytes).await?;
+    let response = read_frame_with_deadline(&mut reader).await?;
+    if parse_hello_ack(&response).is_err() {
+        match parse_hello_nack(&response) {
+            Ok(nack) if nack.retryable => {
+                return Err(io::Error::new(
+                    io::ErrorKind::WouldBlock,
+                    "auditd producer hello is busy",
+                ));
+            }
+            Ok(_) => {
+                emitter.record_hello_nack();
+                return Err(io::Error::new(io::ErrorKind::PermissionDenied, StickyHelloNack));
+            }
+            Err(_) => {
+                saturating_add_atomic(&emitter.invalid_ack, 1);
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "invalid audit hello response",
+                ));
+            }
+        }
+    } else {
+        // A hello ACK recovers sticky identity/configuration health, but it is
+        // not evidence that auditd can durably accept the pending event. Only
+        // an event ACK resets reconnect backoff; otherwise a retryable NACK on
+        // every fresh session would remain a 10 Hz reconnect loop forever.
+        emitter.clear_hello_nack_degraded();
+    }
+    loop {
+        while let Some(event) = state.pending.front() {
+            write_frame_with_deadline(&mut writer, &event.bytes).await?;
+            let response = read_frame_with_deadline(&mut reader).await?;
+            if let Ok(ack) = parse_event_ack(&response) {
+                if ack.event_id != event.event_id {
+                    saturating_add_atomic(&emitter.invalid_ack, 1);
+                    return Err(io::Error::new(
+                        io::ErrorKind::InvalidData,
+                        "auditd ACK event ID mismatch",
+                    ));
+                }
+                if let Some(resolved) = state.pending.pop_front() {
+                    emitter.resolve_pending(&resolved, None);
+                }
+                // A valid ACK proves the session is healthy.  Reset immediately,
+                // even if a later frame in the same session fails.
+                state.backoff = INITIAL_RECONNECT_BACKOFF;
+                continue;
+            }
+            if let Ok(nack) = parse_event_nack(&response) {
+                if nack.event_id != event.event_id {
+                    saturating_add_atomic(&emitter.invalid_ack, 1);
+                    return Err(io::Error::new(
+                        io::ErrorKind::InvalidData,
+                        "auditd NACK event ID mismatch",
+                    ));
+                }
+                if nack.retryable {
+                    // Preserve the front item and every following item exactly
+                    // as queued; the supervisor will reconnect and replay them.
+                    return Err(io::Error::new(io::ErrorKind::WouldBlock, "retryable audit NACK"));
+                }
+                if permanent_bucket(nack.error_code).is_none() {
+                    saturating_add_atomic(&emitter.invalid_ack, 1);
+                    return Err(io::Error::new(
+                        io::ErrorKind::InvalidData,
+                        "unsupported permanent audit NACK",
+                    ));
+                }
+                if let Some(resolved) = state.pending.pop_front() {
+                    emitter.resolve_pending(&resolved, Some(nack.error_code));
+                }
+                // The auditd contract requires the daemon to close the
+                // connection after runtime-mismatch or event-id-conflict so
+                // the producer cannot continue sending on a session whose
+                // identity/dedup state is no longer trustworthy.  The popped
+                // event is already accounted for; all following in-flight
+                // bytes remain queued for replay on the next session.
+                if matches!(
+                    nack.error_code,
+                    EventNackCode::EventIdConflict | EventNackCode::RuntimeMismatch
+                ) {
+                    return Err(io::Error::new(
+                        io::ErrorKind::InvalidData,
+                        "auditd rejected event and closed the session",
+                    ));
+                }
+                continue;
+            }
+
+            saturating_add_atomic(&emitter.invalid_ack, 1);
+            return Err(io::Error::new(io::ErrorKind::InvalidData, "invalid audit ACK/NACK"));
+        }
+
+        if !keep_alive {
+            return Ok(());
+        }
+        if supervisor_drained(emitter, state) {
+            return Ok(());
+        }
+
+        // Refill before calculating an idle deadline. In particular, consume
+        // the shutdown-final diagnostic request now rather than sleeping on a
+        // stale per-bucket due time computed before close.
+        fill_pending(emitter, state);
+        if !state.pending.is_empty() {
+            continue;
+        }
+        if supervisor_drained(emitter, state) {
+            return Ok(());
+        }
+
+        // Register before rechecking shared queue and shutdown flags. This is
+        // the session-side half of the lost-wakeup contract: drain may consume
+        // an older Notify permit while a frame is in progress.
+        let notified = emitter.notify.notified();
+        #[cfg(test)]
+        emitter.synchronize_idle_session_wait_hook().await;
+        if !emitter.queue.is_empty() || emitter.diagnostic_shutdown_requested.load(Ordering::Acquire) {
+            continue;
+        }
+        let diagnostics_pending = !emitter.sequence_exhausted.load(Ordering::Acquire) && !emitter.diagnostics_empty();
+        let wait_for_diagnostic = if state.force_final_diagnostics {
+            Duration::from_millis(10)
+        } else if diagnostics_pending {
+            state
+                .next_diagnostic_wait(emitter, Instant::now())
+                .max(Duration::from_millis(10))
+        } else {
+            DIAGNOSTIC_INTERVAL
+        };
+        tokio::select! {
+            _ = notified => {},
+            _ = time::sleep(wait_for_diagnostic) => {},
+        }
+        fill_pending(emitter, state);
+    }
+}
