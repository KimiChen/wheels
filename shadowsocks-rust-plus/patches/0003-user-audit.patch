+        assert!(
+            matches!(
+                spool.reconcile_tombstones_locked(&mut inner),
+                Err(SpoolError::DurabilityUncertain)
+            ),
+            "a fatal barrier must not be swallowed as one unreadable reconcile candidate"
+        );
+        assert!(
+            matches!(
+                spool.cleanup_locked(&mut inner, 0),
+                Err(SpoolError::DurabilityUncertain)
+            ),
+            "a satisfied capacity check must not mask the fatal barrier"
+        );
+        drop(inner);
+
+        assert_eq!(
+            fs::read(&open_path).expect("open segment"),
+            before,
+            "no write may reach disk"
+        );
+        assert_eq!(
+            fs::read_dir(dir.path().join("sealed")).expect("sealed").count(),
+            sealed_before
+        );
+        assert_eq!(
+            recovery_marker_count(dir.path()),
+            markers_before,
+            "a rejected quarantine must not persist a new recovery marker"
+        );
+        assert_eq!(
+            fs::read(dir.path().join("tombstones.json")).expect("tombstone ledger"),
+            ledger_before,
+            "a rejected quarantine must not extend the tombstone ledger"
+        );
+    }
