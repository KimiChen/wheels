+/// A durable receipt for a batch that was ACKed by the collector.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct AckedReceipt {
+    pub entry_type: String,
+    pub batch_id: String,
+    pub body_sha256: String,
+    pub recorded_at_unix_ms: DecimalU64,
+    pub status: String,
+}
+
+impl AckedReceipt {
+    pub fn new(batch_id: impl Into<String>, body_sha256: impl Into<String>, recorded_at_unix_ms: u64) -> Self {
+        Self {
+            entry_type: "acked_receipt".to_owned(),
+            batch_id: batch_id.into(),
+            body_sha256: body_sha256.into(),
+            recorded_at_unix_ms: recorded_at_unix_ms.into(),
+            status: "acked".to_owned(),
+        }
+    }
+
+    pub fn validate(&self) -> Result<(), ProtocolError> {
+        if self.entry_type != "acked_receipt" || self.status != "acked" {
+            return Err(invalid("tombstone", "invalid acked receipt discriminator"));
+        }
+        TombstoneReceiptFields {
+            batch_id: self.batch_id.clone(),
+            body_sha256: self.body_sha256.clone(),
+            recorded_at_unix_ms: self.recorded_at_unix_ms,
+        }
+        .validate()
+    }
+}
+
+/// A pending eviction transaction.  It must remain in the ledger until the
+/// corresponding gap record has reached the durable spool.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct EvictionPending {
+    pub entry_type: String,
+    pub batch_id: String,
+    pub body_sha256: String,
+    pub recorded_at_unix_ms: DecimalU64,
+    pub status: String,
+    pub gap_event_id: String,
+    pub reason: String,
+    pub spool_epoch: String,
+    pub first_spool_sequence: DecimalU64,
+    pub last_spool_sequence: DecimalU64,
+    pub event_count: DecimalU64,
+    pub raw_bytes: DecimalU64,
+    pub gap_persisted: bool,
+}
+
+impl EvictionPending {
+    #[allow(clippy::too_many_arguments)]
+    pub fn new(
+        batch_id: impl Into<String>,
+        body_sha256: impl Into<String>,
+        recorded_at_unix_ms: u64,
+        gap_event_id: impl Into<String>,
+        reason: impl Into<String>,
+        spool_epoch: impl Into<String>,
+        first_spool_sequence: u64,
+        last_spool_sequence: u64,
+        event_count: u64,
+        raw_bytes: u64,
+    ) -> Self {
+        Self {
+            entry_type: "eviction_pending".to_owned(),
+            batch_id: batch_id.into(),
+            body_sha256: body_sha256.into(),
+            recorded_at_unix_ms: recorded_at_unix_ms.into(),
+            status: "evicted".to_owned(),
+            gap_event_id: gap_event_id.into(),
+            reason: reason.into(),
+            spool_epoch: spool_epoch.into(),
+            first_spool_sequence: first_spool_sequence.into(),
+            last_spool_sequence: last_spool_sequence.into(),
+            event_count: event_count.into(),
+            raw_bytes: raw_bytes.into(),
+            gap_persisted: false,
+        }
+    }
+
+    pub fn validate(&self) -> Result<(), ProtocolError> {
+        if self.entry_type != "eviction_pending"
+            || self.status != "evicted"
+            || self.gap_persisted
+            || !matches!(self.reason.as_str(), "capacity_eviction" | "min_free_eviction")
+        {
+            return Err(invalid("tombstone", "invalid eviction pending discriminator or state"));
+        }
+        AckedReceipt {
+            entry_type: "acked_receipt".to_owned(),
+            batch_id: self.batch_id.clone(),
+            body_sha256: self.body_sha256.clone(),
+            recorded_at_unix_ms: self.recorded_at_unix_ms,
+            status: "acked".to_owned(),
+        }
+        .validate()?;
+        validate_gap_id(&self.gap_event_id)?;
+        validate_lower_hex(&self.spool_epoch, 16, "spool_epoch")?;
+        validate_sequence_range(self.first_spool_sequence, self.last_spool_sequence, "spool sequence")?;
+        if self.event_count.0 == 0 || self.raw_bytes.0 == 0 {
+            return Err(invalid("tombstone", "event_count and raw_bytes must be positive"));
+        }
+        Ok(())
+    }
+}
+
+/// A receipt left after an eviction gap has been durably written.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct EvictedReceipt {
+    pub entry_type: String,
+    pub batch_id: String,
+    pub body_sha256: String,
+    pub recorded_at_unix_ms: DecimalU64,
+    pub status: String,
+    pub gap_persisted: bool,
+}
+
+impl EvictedReceipt {
+    pub fn from_pending(value: &EvictionPending) -> Self {
+        Self {
+            entry_type: "evicted_receipt".to_owned(),
+            batch_id: value.batch_id.clone(),
+            body_sha256: value.body_sha256.clone(),
+            recorded_at_unix_ms: value.recorded_at_unix_ms,
+            status: "evicted".to_owned(),
+            gap_persisted: true,
+        }
+    }
+
+    pub fn validate(&self) -> Result<(), ProtocolError> {
+        if self.entry_type != "evicted_receipt" || self.status != "evicted" || !self.gap_persisted {
+            return Err(invalid("tombstone", "invalid evicted receipt discriminator or state"));
+        }
+        AckedReceipt {
+            entry_type: "acked_receipt".to_owned(),
+            batch_id: self.batch_id.clone(),
+            body_sha256: self.body_sha256.clone(),
+            recorded_at_unix_ms: self.recorded_at_unix_ms,
+            status: "acked".to_owned(),
+        }
+        .validate()
+    }
+}
