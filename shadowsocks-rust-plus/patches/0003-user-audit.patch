+    /// m-173/M-44: once free space is below `min_free_bytes` for reasons the
+    /// spool cannot fix and every real object has been evicted, the open
+    /// segment holds nothing but the gap the previous cleanup wrote.  Sealing
+    /// and evicting that segment fabricates a fresh `min_free_eviction` gap on
+    /// every producer retry: it burns a spool sequence, adds a tombstone,
+    /// inflates `evicted_unacked_records`, and overwrites the real loss
+    /// evidence with self-referential records while the spool keeps growing on
+    /// an already full filesystem.  §9.5 step 6 requires the bounded rejection
+    /// instead, so cleanup must exit without producing a self-referential gap.
+    #[test]
+    fn min_free_cleanup_never_evicts_its_own_diagnostics() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        let starved = || {
+            Arc::new(AuditdConfig {
+                node_id: "node-test".to_owned(),
+                spool_dir: dir.path().to_owned(),
+                max_spool_bytes: 67_108_864,
+                // No amount of eviction can satisfy this watermark: the missing
+                // space belongs to something other than the spool.
+                min_free_bytes: u64::MAX,
+                ..AuditdConfig::default()
+            })
+        };
+        // One real batch reaches `sealed/` while capacity is still healthy.
+        {
+            let spool = Spool::open(config(dir.path())).expect("spool");
+            spool.append(&event(1), 1).expect("append");
+            spool.append(&event(2), 2).expect("append");
+            let mut inner = lock(&spool.inner);
+            spool.seal_locked(&mut inner).expect("seal");
+        }
+
+        let spool = Spool::open(starved()).expect("spool");
+        // The first retry evicts the only real object and records exactly one
+        // legitimate gap describing the two events it lost.
+        assert!(
+            matches!(spool.append(&event(3), 3), Err(SpoolError::StorageUnavailable)),
+            "§9.5 step 6: a rejected attempt must be retryable"
+        );
+        assert!(
+            list_batch_dirs(&dir.path().join("sealed")).expect("sealed").is_empty(),
+            "the real batch is the only evictable object"
+        );
+        assert_eq!(durable_gap_ids(dir.path()).len(), 1, "one evicted batch, one gap");
+        let (sequence, evicted_records, tombstones) = {
+            let inner = lock(&spool.inner);
+            (
+                inner.next_sequence,
+                inner.evicted_unacked_records,
+                inner.tombstones.len(),
+            )
+        };
+        assert_eq!(evicted_records, 2, "the evicted batch held two unacknowledged events");
+
+        // Every further retry finds nothing real to evict.  Nothing below may
+        // move, however many times the producer retries.
+        for attempt in 4..12_u64 {
+            assert!(
+                matches!(
+                    spool.append(&event(attempt), attempt),
+                    Err(SpoolError::StorageUnavailable)
+                ),
+                "attempt {attempt} must stay a bounded retryable rejection"
+            );
+            let inner = lock(&spool.inner);
+            assert_eq!(
+                inner.next_sequence, sequence,
+                "attempt {attempt} consumed a spool sequence for a self-referential gap"
+            );
+            assert_eq!(
+                inner.evicted_unacked_records, evicted_records,
+                "attempt {attempt} reported the loss of events that never existed"
+            );
+            assert_eq!(
+                inner.tombstones.len(),
+                tombstones,
+                "attempt {attempt} grew the bounded tombstone ledger without evicting anything"
+            );
+            drop(inner);
+            assert_eq!(
+                durable_gap_ids(dir.path()).len(),
+                1,
+                "attempt {attempt} manufactured a gap out of cleanup's own diagnostics"
+            );
+            assert!(
+                list_batch_dirs(&dir.path().join("sealed")).expect("sealed").is_empty(),
+                "attempt {attempt} sealed the gap-only open segment into an evictable batch"
+            );
+        }
+    }
