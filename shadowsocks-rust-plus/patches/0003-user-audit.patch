+        runtime: Arc<AuditRuntimeMetadata>,
+        reason: String,
+        permanent_nack_code: Option<String>,
+        dropped_events: u64,
+        first_dropped_sequence: Option<u64>,
+        last_dropped_sequence: Option<u64>,
+        first_seen_unix_ms: u64,
+        last_seen_unix_ms: u64,
+    },
+    UdpContention {
+        sequence: u64,
+        occurred_at_unix_ms: u64,
+        runtime: Arc<AuditRuntimeMetadata>,
+        skipped_successful_datagrams: u64,
+        first_seen_unix_ms: u64,
+        last_seen_unix_ms: u64,
+    },
+}
+
+impl AuditEventDraft {
+    fn sequence(&self) -> u64 {
+        match self {
+            Self::Tcp { sequence, .. }
+            | Self::Udp { sequence, .. }
+            | Self::ProducerGap { sequence, .. }
+            | Self::UdpContention { sequence, .. } => *sequence,
+        }
+    }
+
+    fn is_diagnostic(&self) -> bool {
+        matches!(self, Self::ProducerGap { .. } | Self::UdpContention { .. })
+    }
+
+    pub fn event_id(&self) -> String {
+        match self {
+            Self::Tcp { sequence, runtime, .. }
+            | Self::Udp { sequence, runtime, .. }
+            | Self::ProducerGap { sequence, runtime, .. }
+            | Self::UdpContention { sequence, runtime, .. } => format!("{}:{sequence}", runtime.runtime_id),
+        }
+    }
+
+    /// Convert this hot-path draft into the shared protocol DTO.
+    fn to_record(&self) -> Result<AuditRecord, shadowsocks_audit_protocol::ProtocolError> {
+        match self {
+            Self::Tcp {
+                sequence,
+                occurred_at_unix_ms,
+                runtime_monotonic_ms,
+                runtime,
+                server,
+                identity,
+                target,
+            } => Ok(AuditRecord::Access(AccessEvent {
+                schema_version: shadowsocks_audit_protocol::SCHEMA_VERSION,
+                record_type: "access".to_owned(),
+                event_type: "tcp_target_success".to_owned(),
+                event_id: format!("{}:{sequence}", runtime.runtime_id),
+                audit_sequence: DecimalU64::from(*sequence),
+                occurred_at_unix_ms: DecimalU64::from(*occurred_at_unix_ms),
+                runtime_monotonic_ms: DecimalU64::from(*runtime_monotonic_ms),
+                node_id: runtime.node_id.to_string(),
+                runtime_id: runtime.runtime_id.to_string(),
+                server_id: server.server_id.to_string(),
+                server_generation: server.server_generation,
+                identity_kind: "user".to_owned(),
+                identity_name: identity.identity_name.to_string(),
+                identity_generation: identity.identity_generation,
+                transport: Transport::Tcp,
+                association_id: None,
+                target: target.to_wire_target()?,
+                success_evidence: SuccessEvidence::TcpBidirectionalPayload,
+            })),
+            Self::Udp {
+                sequence,
+                occurred_at_unix_ms,
+                runtime_monotonic_ms,
+                runtime,
+                server,
+                identity,
+                association_id,
+                target,
+            } => Ok(AuditRecord::Access(AccessEvent {
+                schema_version: shadowsocks_audit_protocol::SCHEMA_VERSION,
+                record_type: "access".to_owned(),
+                event_type: "udp_target_success".to_owned(),
+                event_id: format!("{}:{sequence}", runtime.runtime_id),
+                audit_sequence: DecimalU64::from(*sequence),
+                occurred_at_unix_ms: DecimalU64::from(*occurred_at_unix_ms),
+                runtime_monotonic_ms: DecimalU64::from(*runtime_monotonic_ms),
+                node_id: runtime.node_id.to_string(),
+                runtime_id: runtime.runtime_id.to_string(),
+                server_id: server.server_id.to_string(),
+                server_generation: server.server_generation,
+                identity_kind: "user".to_owned(),
+                identity_name: identity.identity_name.to_string(),
+                identity_generation: identity.identity_generation,
+                transport: Transport::Udp,
+                association_id: Some(encode_hex(association_id)),
+                target: target.to_wire_target()?,
+                success_evidence: SuccessEvidence::UdpSendOk,
+            })),
+            Self::ProducerGap {
+                sequence,
+                occurred_at_unix_ms,
+                runtime,
+                reason,
+                permanent_nack_code,
+                dropped_events,
+                first_dropped_sequence,
+                last_dropped_sequence,
+                first_seen_unix_ms,
+                last_seen_unix_ms,
