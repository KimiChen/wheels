+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum TombstoneEntry {
+    AckedReceipt(AckedReceipt),
+    EvictionPending(EvictionPending),
+    EvictedReceipt(EvictedReceipt),
+    QuarantinePending(QuarantinePending),
+}
+
+impl TombstoneEntry {
+    pub fn entry_type(&self) -> &'static str {
+        match self {
+            Self::AckedReceipt(_) => "acked_receipt",
+            Self::EvictionPending(_) => "eviction_pending",
+            Self::EvictedReceipt(_) => "evicted_receipt",
+            Self::QuarantinePending(_) => "quarantine_pending",
+        }
+    }
+
+    pub fn is_pending(&self) -> bool {
+        matches!(self, Self::EvictionPending(_) | Self::QuarantinePending(_))
+    }
+
+    pub fn recorded_at_unix_ms(&self) -> u64 {
+        match self {
+            Self::AckedReceipt(value) => value.recorded_at_unix_ms.0,
+            Self::EvictionPending(value) => value.recorded_at_unix_ms.0,
+            Self::EvictedReceipt(value) => value.recorded_at_unix_ms.0,
+            Self::QuarantinePending(value) => value.recorded_at_unix_ms.0,
+        }
+    }
+
+    pub fn batch_id(&self) -> Option<&str> {
+        match self {
+            Self::AckedReceipt(value) => Some(&value.batch_id),
+            Self::EvictionPending(value) => Some(&value.batch_id),
+            Self::EvictedReceipt(value) => Some(&value.batch_id),
+            Self::QuarantinePending(value) => value.batch_id.as_deref(),
+        }
+    }
+
+    pub fn body_sha256(&self) -> Option<&str> {
+        match self {
+            Self::AckedReceipt(value) => Some(&value.body_sha256),
+            Self::EvictionPending(value) => Some(&value.body_sha256),
+            Self::EvictedReceipt(value) => Some(&value.body_sha256),
+            Self::QuarantinePending(value) => value.body_sha256.as_deref(),
+        }
+    }
+
+    pub fn gap_event_id(&self) -> Option<&str> {
+        match self {
+            Self::EvictionPending(value) => Some(&value.gap_event_id),
+            Self::QuarantinePending(value) => Some(&value.gap_event_id),
+            Self::AckedReceipt(_) | Self::EvictedReceipt(_) => None,
+        }
+    }
+
+    pub fn validate(&self) -> Result<(), ProtocolError> {
+        match self {
+            Self::AckedReceipt(value) => value.validate(),
+            Self::EvictionPending(value) => value.validate(),
+            Self::EvictedReceipt(value) => value.validate(),
+            Self::QuarantinePending(value) => value.validate(),
+        }
+    }
+}
