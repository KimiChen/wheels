+
+    #[test]
+    fn accept_backoff_escalates_up_to_a_bounded_ceiling() {
+        assert_eq!(
+            escalated_accept_backoff(ACCEPT_BACKOFF_INITIAL),
+            ACCEPT_BACKOFF_INITIAL * 2
+        );
+        let mut delay = ACCEPT_BACKOFF_INITIAL;
+        for _ in 0..16 {
+            delay = escalated_accept_backoff(delay);
+        }
+        assert_eq!(delay, ACCEPT_BACKOFF_MAX);
+        assert_eq!(escalated_accept_backoff(Duration::MAX), ACCEPT_BACKOFF_MAX);
+    }
