+    /// predates the fingerprint field and must not carry one.
+    pub fn schema_is_supported(&self) -> bool {
+        match self.marker_schema_version {
+            RECOVERY_GAP_MARKER_SCHEMA => true,
+            LEGACY_RECOVERY_GAP_MARKER_SCHEMA => self.source_fingerprint.is_none(),
+            _ => false,
