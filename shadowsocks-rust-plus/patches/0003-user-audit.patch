+    /// `m-229`：`m-227` 的核心改动是把无锁路径的 count 放进**独立**的
+    /// `unknown_count`，而不是旧设计的「sticky bool + 共用 count」。
+    ///
+    /// `fallback_unknown_count_keeps_metadata_unknown` 区分不了这两种实现——
+    /// 把无锁路径改回 `metadata_unknown.fetch_or(全部四位)` +
+    /// `saturating_add_atomic(&self.count, ..)`，它的六条断言逐条仍然成立，124 条
+    /// service 用例全绿。这一条直接观察计数落在哪个字段，以及依赖该字段的两个
+    /// 派生量：`approximate_count`（健康上报）与 `is_nonempty`（关机 drain 判空，
+    /// 少算就会把这批计数静默丢掉）。
+    #[test]
+    fn the_lock_free_fallback_count_lands_in_its_own_field() {
+        let fallback = GapFallback::default();
+        fallback.lock.store(true, Ordering::Release);
+        assert!(!fallback.merge(GapSnapshot {
+            count: 5,
+            first: Some(1),
+            last: Some(1),
+            first_time: 10,
+            last_time: 10,
+        }));
+        fallback.lock.store(false, Ordering::Release);
+
+        assert_eq!(
+            fallback.unknown_count.load(Ordering::Acquire),
+            5,
+            "the lock-free count must be kept apart from the coherent counter"
+        );
+        assert_eq!(
+            fallback.count.load(Ordering::Acquire),
+            0,
+            "the coherent counter describes only what the lock protected"
+        );
+        assert!(
+            fallback.is_nonempty(),
+            "shutdown drain must not treat a lock-free-only fallback as empty"
+        );
+
+        // Drive the fallback directly: `GapAccumulator::merge` prefers a free
+        // slot, and a slot's own count would mask a missing fallback term.
+        let accumulator = GapAccumulator::default();
+        accumulator.fallback.lock.store(true, Ordering::Release);
+        accumulator.fallback.merge(GapSnapshot {
+            count: 7,
+            first: Some(1),
