+fn tombstone_entry_from_value(value: Value) -> Result<TombstoneEntry, ProtocolError> {
+    let object = value
+        .as_object()
+        .ok_or_else(|| invalid("tombstone entry", "must be a JSON object"))?;
+    let entry_type = object
+        .get("entry_type")
+        .and_then(Value::as_str)
+        .ok_or_else(|| invalid("entry_type", "must be present as a string"))?;
+    let required = match entry_type {
+        "acked_receipt" => &["entry_type", "batch_id", "body_sha256", "recorded_at_unix_ms", "status"][..],
+        "eviction_pending" => &[
+            "entry_type",
+            "batch_id",
+            "body_sha256",
+            "recorded_at_unix_ms",
+            "status",
+            "gap_event_id",
+            "reason",
+            "spool_epoch",
+            "first_spool_sequence",
+            "last_spool_sequence",
+            "event_count",
+            "raw_bytes",
+            "gap_persisted",
+        ][..],
+        "evicted_receipt" => &[
+            "entry_type",
+            "batch_id",
+            "body_sha256",
+            "recorded_at_unix_ms",
+            "status",
+            "gap_persisted",
+        ][..],
+        "quarantine_pending" => &[
+            "entry_type",
+            "gap_event_id",
+            "quarantine_basename",
+            "reason",
+            "recorded_at_unix_ms",
+            "batch_id",
+            "body_sha256",
+            "spool_epoch",
+            "first_spool_sequence",
+            "last_spool_sequence",
+            "event_count",
+            "raw_bytes",
+        ][..],
+        other => return Err(invalid("entry_type", format!("unknown tombstone variant {other:?}"))),
+    };
+    require_keys(object, required)?;
+    let result = match entry_type {
+        "acked_receipt" => TombstoneEntry::AckedReceipt(
+            serde_json::from_value(value).map_err(|error| ProtocolError::Json(error.to_string()))?,
+        ),
+        "eviction_pending" => TombstoneEntry::EvictionPending(
+            serde_json::from_value(value).map_err(|error| ProtocolError::Json(error.to_string()))?,
+        ),
+        "evicted_receipt" => TombstoneEntry::EvictedReceipt(
+            serde_json::from_value(value).map_err(|error| ProtocolError::Json(error.to_string()))?,
+        ),
+        "quarantine_pending" => TombstoneEntry::QuarantinePending(
+            serde_json::from_value(value).map_err(|error| ProtocolError::Json(error.to_string()))?,
+        ),
+        _ => return Err(invalid("entry_type", "unknown tombstone variant")),
+    };
+    result.validate()?;
+    Ok(result)
+}
+
+fn validate_gap_id(value: &str) -> Result<(), ProtocolError> {
+    if !value.starts_with("spool:") {
+        return Err(invalid("gap_event_id", "must start with `spool:`"));
+    }
+    validate_lower_hex(&value[6..], 16, "gap_event_id")
+}
+
+fn validate_sequence_range(first: DecimalU64, last: DecimalU64, field: &str) -> Result<(), ProtocolError> {
+    if first.0 == 0 || last.0 < first.0 {
+        return Err(invalid(field, "must satisfy 0 < first <= last"));
+    }
+    Ok(())
+}
+
+fn validate_basename(value: &str) -> Result<(), ProtocolError> {
+    if value.is_empty()
+        || value.len() > 255
+        || value == "."
+        || value == ".."
+        || value.contains('/')
+        || value.contains('\\')
+        || !value.bytes().all(|byte| (0x21..=0x7e).contains(&byte))
+    {
+        return Err(invalid("quarantine_basename", "must be a safe relative basename"));
+    }
+    Ok(())
+}
