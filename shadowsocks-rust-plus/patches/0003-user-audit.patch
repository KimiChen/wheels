+pub const DEFAULT_HMAC_KEY: &str = "/etc/shadowsocks-audit/export-hmac";
+pub const SOCKET_GROUP_INGEST: &str = "shadowsocks-audit-ingest";
+pub const SOCKET_GROUP_EXPORT: &str = "shadowsocks-audit-export";
+
+// Wire-size limits live in the shared protocol crate.  Re-export aliases here
+// for auditd callers without introducing a second independently drifting value.
+pub use wire::MAX_EVENT_BYTES;
+pub use wire::{
+    ACKED_RETENTION_SECONDS, EVENT_DEDUP_CAPACITY as MAX_DEDUP_ENTRIES,
+    EXPORT_MAX_CONNECTIONS as MAX_EXPORT_CONNECTIONS, INGEST_MAX_CONNECTIONS as MAX_INGEST_CONNECTIONS,
+    NONCE_CACHE_CAPACITY as MAX_NONCES, NONCE_CACHE_TTL_SECONDS as NONCE_TTL_SECONDS,
+    TOMBSTONE_CAPACITY as MAX_TOMBSTONES,
+};
+
+pub const DEFAULT_MAX_SPOOL_BYTES: u64 = 5_368_709_120;
+pub const DEFAULT_MIN_FREE_BYTES: u64 = 1_073_741_824;
+pub const DEFAULT_SEGMENT_MAX_BYTES: u64 = 4_194_304;
+pub const DEFAULT_SEGMENT_MAX_AGE_SECONDS: u64 = 60;
+pub const DEFAULT_EXPORT_MAX_RESPONSE_BYTES: u64 = 8_388_608;
+
+const CONFIG_FILE_MODE: u32 = 0o640;
+const HMAC_KEY_FILE_MODE: u32 = 0o600;
+const PRIVATE_DIRECTORY_MODE: u32 = 0o700;
+const SOCKET_DIRECTORY_MODE: u32 = 0o750;
+pub(crate) const SOCKET_MODE: u32 = 0o660;
+const MAX_CONFIG_FILE_BYTES: u64 = 1024 * 1024;
+const MAX_HMAC_KEY_FILE_BYTES: u64 = 65;
+
+/// `accept(2)` can transiently fail when the process or kernel is out of file
+/// descriptors/buffers.  Those failures must not take down either listener;
+/// callers add a short async backoff before retrying.
+pub(crate) fn is_transient_accept_error(error: &io::Error) -> bool {
+    if matches!(
+        error.kind(),
+        io::ErrorKind::Interrupted
+            | io::ErrorKind::WouldBlock
+            | io::ErrorKind::ConnectionAborted
+            | io::ErrorKind::ConnectionReset
+    ) {
+        return true;
+    }
+    matches!(
+        error.raw_os_error(),
+        Some(libc::EMFILE | libc::ENFILE | libc::ENOBUFS | libc::ENOMEM)
+    )
+}
+
+/// Transient-accept backoff shared by both listeners.  A listener that hits
+/// descriptor or buffer exhaustion must neither spin nor stay at its first
+/// delay forever, so the delay doubles up to a bounded ceiling and is reset by
+/// the next successful accept.
+pub(crate) const ACCEPT_BACKOFF_INITIAL: Duration = Duration::from_millis(50);
+pub(crate) const ACCEPT_BACKOFF_MAX: Duration = Duration::from_secs(2);
+const ACCEPT_DIAGNOSTIC_INTERVAL: Duration = Duration::from_secs(60);
+
+pub(crate) fn escalated_accept_backoff(current: Duration) -> Duration {
+    current.saturating_mul(2).min(ACCEPT_BACKOFF_MAX)
+}
+
+/// Wait out one transient accept failure on either listener: emit a
+/// rate-limited diagnostic, sleep for the current backoff while remaining
+/// responsive to shutdown, then escalate that backoff.  Returns `false` when
+/// shutdown was observed, in which case the caller must stop serving instead
+/// of accepting again.
+pub(crate) async fn wait_before_accept_retry(
+    listener: &str,
+    error: &io::Error,
+    backoff: &mut Duration,
+    last_diagnostic: &mut Option<tokio::time::Instant>,
+    shutdown: &mut tokio::sync::watch::Receiver<bool>,
+) -> bool {
+    let now = tokio::time::Instant::now();
+    if last_diagnostic.is_none_or(|last| now.duration_since(last) >= ACCEPT_DIAGNOSTIC_INTERVAL) {
+        eprintln!(
+            "shadowsocks-auditd: {listener} accept temporarily unavailable: {error}; retrying in {} ms",
+            backoff.as_millis()
+        );
+        *last_diagnostic = Some(now);
+    }
+    let delay = tokio::time::sleep(*backoff);
+    tokio::pin!(delay);
+    let serving = tokio::select! {
+        _ = &mut delay => true,
+        changed = shutdown.changed() => changed.is_ok() && !*shutdown.borrow(),
+    };
+    *backoff = escalated_accept_backoff(*backoff);
+    serving
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum SocketRole {
+    Ingest,
+    Export,
+}
+
+impl SocketRole {
+    fn group_name(self) -> &'static str {
+        match self {
+            Self::Ingest => SOCKET_GROUP_INGEST,
+            Self::Export => SOCKET_GROUP_EXPORT,
+        }
+    }
+}
+
+/// Process-wide guard for a path-bound Unix socket.  The lock file is kept
+/// separate from the socket inode so it survives a stale-socket cleanup and
+/// can be held for the entire listener lifetime.
+#[derive(Debug)]
+pub(crate) struct SocketLock {
+    path: PathBuf,
+    device: u64,
+    inode: u64,
+    _file: File,
+}
+
+impl SocketLock {
+    pub(crate) fn acquire(socket_path: &Path) -> io::Result<Self> {
+        let lock_path = socket_lock_path(socket_path);
+        let file = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .mode(0o600)
+            .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+            .open(&lock_path)?;
+        let metadata = file.metadata()?;
+        if !metadata.is_file() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "socket lock path is not a regular file",
+            ));
+        }
+        if metadata.uid() != current_euid() {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "socket lock has an unexpected owner",
+            ));
+        }
+        // fchmod operates on the opened inode and cannot follow a pathname
+        // replacement.  This also repairs the mode when a lock file survived
+        // a previous daemon version.
+        let result = unsafe { libc::fchmod(file.as_raw_fd(), 0o600) };
+        if result != 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let result = unsafe { libc::flock(file.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) };
+        if result != 0 {
+            let error = io::Error::last_os_error();
+            if error.kind() == io::ErrorKind::WouldBlock
+                || error.raw_os_error() == Some(libc::EAGAIN)
+                || error.raw_os_error() == Some(libc::EWOULDBLOCK)
+            {
+                return Err(io::Error::new(
+                    io::ErrorKind::AddrInUse,
+                    "socket is locked by another process",
+                ));
+            }
+            return Err(error);
+        }
+        verify_open_file_path(&file, &lock_path, "socket lock")?;
+        let metadata = file.metadata()?;
+        validate_lock_metadata(&metadata)?;
+        Ok(Self {
+            path: lock_path,
+            device: metadata.dev(),
+            inode: metadata.ino(),
+            _file: file,
+        })
+    }
+
+    /// Verify that the pathname still resolves to the inode on which this
+    /// process acquired the advisory lock.  A lock file can be replaced by a
+    /// privileged actor after acquisition; treating that as a fatal listener
+    /// error prevents the daemon from continuing while another process owns a
+    /// different replacement inode.
+    pub(crate) fn verify(&self) -> io::Result<()> {
+        let current = fs::symlink_metadata(&self.path)?;
+        validate_lock_metadata(&current)?;
+        if current.dev() != self.device || current.ino() != self.inode {
+            return Err(io::Error::new(
+                io::ErrorKind::AlreadyExists,
+                "socket lock path changed after acquisition",
+            ));
+        }
+        // Keep the check descriptor-bound as well.  This catches an inode
+        // replacement that happened between the pathname check and this call.
+        verify_open_file_path(&self._file, &self.path, "socket lock")
+    }
+}
+
+fn validate_lock_metadata(metadata: &fs::Metadata) -> io::Result<()> {
+    if !metadata.is_file() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "socket lock path is not a regular file",
+        ));
+    }
+    if metadata.uid() != current_euid() || metadata.permissions().mode() & 0o7777 != 0o600 {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket lock has unexpected owner or mode",
+        ));
+    }
+    Ok(())
+}
+
+fn socket_lock_path(socket_path: &Path) -> PathBuf {
+    let mut value = socket_path.as_os_str().to_os_string();
+    value.push(".lock");
+    PathBuf::from(value)
+}
+
+fn sync_dir(path: &Path) -> io::Result<()> {
+    File::open(path)?.sync_all()
+}
+
+fn verify_open_file_path(file: &File, path: &Path, description: &str) -> io::Result<()> {
+    let opened = file.metadata()?;
+    let current = fs::symlink_metadata(path)?;
+    if !current.is_file() || current.dev() != opened.dev() || current.ino() != opened.ino() {
+        return Err(io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            format!("{description} path changed while acquiring its lock"),
+        ));
+    }
+    Ok(())
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct AuditdConfig {
+    pub schema_version: u32,
+    pub node_id: String,
+    pub producer_user: String,
+    pub export_peer_user: String,
+    pub ingest_socket_path: PathBuf,
+    pub export_socket_path: PathBuf,
+    pub spool_dir: PathBuf,
+    pub max_spool_bytes: u64,
+    pub min_free_bytes: u64,
+    pub segment_max_bytes: u64,
+    pub segment_max_age_seconds: u64,
+    pub export_max_response_bytes: u64,
+    pub export_hmac_key_file: PathBuf,
+}
+
+impl Default for AuditdConfig {
+    fn default() -> Self {
+        Self {
+            schema_version: 1,
+            node_id: "node-example-01".to_owned(),
+            producer_user: "shadowsocks".to_owned(),
+            export_peer_user: "audit-exporter".to_owned(),
+            ingest_socket_path: PathBuf::from(DEFAULT_INGEST_SOCKET),
+            export_socket_path: PathBuf::from(DEFAULT_EXPORT_SOCKET),
+            spool_dir: PathBuf::from(DEFAULT_SPOOL_DIR),
+            max_spool_bytes: DEFAULT_MAX_SPOOL_BYTES,
+            min_free_bytes: DEFAULT_MIN_FREE_BYTES,
+            segment_max_bytes: DEFAULT_SEGMENT_MAX_BYTES,
+            segment_max_age_seconds: DEFAULT_SEGMENT_MAX_AGE_SECONDS,
+            export_max_response_bytes: DEFAULT_EXPORT_MAX_RESPONSE_BYTES,
+            export_hmac_key_file: PathBuf::from(DEFAULT_HMAC_KEY),
+        }
+    }
+}
+
+#[derive(Debug, Error)]
+pub enum ConfigError {
+    #[error("configuration path is invalid: {0}")]
+    InvalidPath(String),
+    #[error("configuration file I/O failed: {0}")]
+    Io(#[from] io::Error),
+    #[error("configuration JSON is invalid: {0}")]
+    Json(#[from] serde_json::Error),
+    #[error("invalid configuration: {0}")]
+    Invalid(String),
+    #[error("spool initialization failed: {0}")]
+    Spool(#[source] crate::spool::SpoolError),
+}
+
+impl AuditdConfig {
+    pub fn load_from_file(path: &Path) -> Result<Self, ConfigError> {
+        validate_absolute_path(path, "config")?;
+        validate_existing_parent(path, "config")?;
+        validate_private_parent(path, "config")?;
+        // O_NOFOLLOW closes the final-component symlink gap left by validating
+        // the parent components. Ownership and mode are checked before parsing
+        // so CLI failures happen before any daemon socket or spool creation.
+        let mut file = open_nofollow(path)?;
+        validate_regular_file_metadata(
+            &file.metadata()?,
+            "config",
+            Some(0),
+            Some(current_egid()),
+            Some(CONFIG_FILE_MODE),
+        )
+        .map_err(ConfigError::InvalidPath)?;
+        if file.metadata()?.len() > MAX_CONFIG_FILE_BYTES {
+            return Err(ConfigError::Invalid("config file is too large".to_owned()));
+        }
+        // The size check above is only a snapshot.  Bound the actual read as
+        // well so a concurrent replacement/growth cannot turn config loading
+        // into an unbounded allocation.
+        let bytes = read_bounded(&mut file, MAX_CONFIG_FILE_BYTES as usize)?;
+        parse_config_bytes(&bytes)
+    }
+
+    /// Validate fields that do not require opening sockets or resolving users.
+    pub fn validate(&self) -> Result<(), ConfigError> {
+        if self.schema_version != 1 {
+            return Err(ConfigError::Invalid("schema_version must be 1".to_owned()));
+        }
+        validate_identifier(&self.node_id, "node_id")?;
+        if self.producer_user.is_empty() || self.export_peer_user.is_empty() {
+            return Err(ConfigError::Invalid("daemon user names must not be empty".to_owned()));
+        }
+        validate_identifier(&self.producer_user, "producer_user")?;
+        validate_identifier(&self.export_peer_user, "export_peer_user")?;
+        if self.producer_user == self.export_peer_user {
+            return Err(ConfigError::Invalid(
+                "producer_user and export_peer_user must differ".to_owned(),
+            ));
+        }
+        validate_absolute_path(&self.ingest_socket_path, "ingest_socket_path")?;
+        validate_absolute_path(&self.export_socket_path, "export_socket_path")?;
+        validate_absolute_path(&self.spool_dir, "spool_dir")?;
+        validate_absolute_path(&self.export_hmac_key_file, "export_hmac_key_file")?;
+        validate_socket_path_length(&self.ingest_socket_path, "ingest_socket_path")?;
+        validate_socket_path_length(&self.export_socket_path, "export_socket_path")?;
+        if self.ingest_socket_path == self.export_socket_path {
+            return Err(ConfigError::Invalid("ingest and export sockets must differ".to_owned()));
+        }
+        if self.spool_dir == self.ingest_socket_path
+            || self.spool_dir == self.export_socket_path
+            || self.spool_dir.starts_with(&self.ingest_socket_path)
+            || self.spool_dir.starts_with(&self.export_socket_path)
+            || self.ingest_socket_path.starts_with(&self.spool_dir)
+            || self.export_socket_path.starts_with(&self.spool_dir)
+        {
+            return Err(ConfigError::Invalid(
+                "spool_dir must not contain a socket path".to_owned(),
+            ));
+        }
+
+        bounded(
+            self.max_spool_bytes,
+            67_108_864,
+            DEFAULT_MAX_SPOOL_BYTES,
+            "max_spool_bytes",
+        )?;
+        bounded(
+            self.min_free_bytes,
+            268_435_456,
+            DEFAULT_MAX_SPOOL_BYTES,
+            "min_free_bytes",
+        )?;
+        let minimum_segment = minimum_segment_bytes(wire::MAX_SPOOL_RECORD_BYTES)?;
+        bounded(
+            self.segment_max_bytes,
+            minimum_segment,
+            DEFAULT_SEGMENT_MAX_BYTES,
+            "segment_max_bytes",
+        )?;
+        bounded(self.segment_max_age_seconds, 1, 3_600, "segment_max_age_seconds")?;
+        bounded(
+            self.export_max_response_bytes,
+            4_194_304,
+            DEFAULT_EXPORT_MAX_RESPONSE_BYTES,
+            "export_max_response_bytes",
+        )?;
+        if self.max_spool_bytes <= self.segment_max_bytes.saturating_mul(2) {
+            return Err(ConfigError::Invalid(
+                "max_spool_bytes must be greater than twice segment_max_bytes".to_owned(),
+            ));
+        }
+        if self.export_max_response_bytes < self.segment_max_bytes {
+            return Err(ConfigError::Invalid(
+                "export_max_response_bytes must be at least segment_max_bytes".to_owned(),
+            ));
+        }
+        Ok(())
+    }
+
+    /// Perform checks that require the daemon's local filesystem and account database.
+    pub fn validate_runtime(&self) -> Result<(), ConfigError> {
+        self.validate()?;
+        validate_existing_parent(&self.ingest_socket_path, "ingest_socket_path")?;
+        validate_existing_parent(&self.export_socket_path, "export_socket_path")?;
+        validate_existing_parent(&self.export_hmac_key_file, "export_hmac_key_file")?;
+        validate_socket_parent_for(&self.ingest_socket_path, "ingest_socket_path", SocketRole::Ingest)?;
+        validate_socket_parent_for(&self.export_socket_path, "export_socket_path", SocketRole::Export)?;
+        validate_private_parent(&self.export_hmac_key_file, "export_hmac_key_file")?;
+        let producer_uid = resolve_uid(&self.producer_user)
+            .ok_or_else(|| ConfigError::Invalid(format!("unknown producer_user {:?}", self.producer_user)))?;
+        let export_uid = resolve_uid(&self.export_peer_user)
+            .ok_or_else(|| ConfigError::Invalid(format!("unknown export_peer_user {:?}", self.export_peer_user)))?;
+        if producer_uid == export_uid {
+            return Err(ConfigError::Invalid(
+                "producer_user and export_peer_user must resolve to different UIDs".to_owned(),
+            ));
+        }
+        let _ = self.read_hmac_key()?;
+        validate_or_create_dir(&self.spool_dir)?;
+        validate_min_free_capacity(&self.spool_dir, self.min_free_bytes)?;
+        validate_existing_parent(&self.spool_dir.join("open/current.ndjson"), "spool_dir")?;
+        Ok(())
+    }
+
+    pub fn producer_uid(&self) -> Result<u32, ConfigError> {
+        resolve_uid(&self.producer_user)
+            .ok_or_else(|| ConfigError::Invalid(format!("unknown producer_user {:?}", self.producer_user)))
+    }
+
+    pub fn export_peer_uid(&self) -> Result<u32, ConfigError> {
+        resolve_uid(&self.export_peer_user)
+            .ok_or_else(|| ConfigError::Invalid(format!("unknown export_peer_user {:?}", self.export_peer_user)))
+    }
+
+    pub fn read_hmac_key(&self) -> Result<[u8; 32], ConfigError> {
+        let mut file = open_nofollow(&self.export_hmac_key_file)?;
+        validate_regular_file_metadata(
+            &file.metadata()?,
+            "export_hmac_key_file",
+            Some(current_euid()),
+            Some(current_egid()),
+            Some(HMAC_KEY_FILE_MODE),
+        )
+        .map_err(ConfigError::InvalidPath)?;
+        if file.metadata()?.len() > MAX_HMAC_KEY_FILE_BYTES {
+            return Err(ConfigError::Invalid("HMAC key file is too large".to_owned()));
+        }
+        let bytes = read_bounded(&mut file, MAX_HMAC_KEY_FILE_BYTES as usize)?;
+        decode_hmac_key(&bytes).map_err(ConfigError::Invalid)
+    }
+}
+
+/// Parse and validate one complete auditd configuration document.
+///
+/// Keeping this separate from pathname/ownership checks makes the JSON
+/// contract directly testable without manufacturing a root-owned production
+/// directory hierarchy.  File loading still calls this only after all
+/// descriptor-bound metadata checks have passed.
+fn parse_config_bytes(bytes: &[u8]) -> Result<AuditdConfig, ConfigError> {
+    if std::str::from_utf8(bytes).is_err() {
+        return Err(ConfigError::Invalid("config file must be UTF-8".to_owned()));
+    }
+    // Configuration is a regular JSON document rather than a wire frame:
+    // permit the leading/trailing whitespace emitted by editors while
+    // retaining duplicate-key and trailing-value rejection.
+    let config: AuditdConfig = wire::parse_json_document(bytes)
+        .map_err(|error| ConfigError::Invalid(format!("config JSON is invalid: {error}")))?;
+    config.validate()?;
+    Ok(config)
+}
+
+fn bounded(value: u64, min: u64, max: u64, name: &str) -> Result<(), ConfigError> {
+    if value < min || value > max {
+        return Err(ConfigError::Invalid(format!("{name} must be between {min} and {max}")));
+    }
+    Ok(())
+}
+
+fn minimum_segment_bytes(max_spool_record_bytes: usize) -> Result<u64, ConfigError> {
+    let protocol_minimum = max_spool_record_bytes
+        .checked_add(1)
+        .ok_or_else(|| ConfigError::Invalid("protocol spool record size overflow".to_owned()))?;
+    let protocol_minimum = u64::try_from(protocol_minimum)
+        .map_err(|_| ConfigError::Invalid("protocol spool record size exceeds u64".to_owned()))?;
+    // A segment must fit one complete newline-terminated wire record and must
+    // not be configured below the 16 KiB operational floor.
+    Ok(16_384u64.max(protocol_minimum))
+}
+
+pub fn validate_identifier(value: &str, field: &str) -> Result<(), ConfigError> {
+    if value.is_empty() || value.len() > 128 {
+        return Err(ConfigError::Invalid(format!("{field} must be 1..=128 bytes")));
+    }
+    if value.bytes().any(|byte| !(0x21..=0x7e).contains(&byte)) {
+        return Err(ConfigError::Invalid(format!(
+            "{field} must contain printable non-whitespace ASCII"
+        )));
+    }
+    Ok(())
+}
+
+pub fn validate_absolute_path(path: &Path, field: &str) -> Result<(), ConfigError> {
+    let text = path
+        .to_str()
+        .ok_or_else(|| ConfigError::InvalidPath(format!("{field} must be valid UTF-8")))?;
+    if !text.starts_with('/') || text.len() <= 1 {
+        return Err(ConfigError::InvalidPath(format!("{field} must be an absolute path")));
+    }
+    if path.as_os_str().as_bytes().contains(&0) {
+        return Err(ConfigError::InvalidPath(format!("{field} must not contain NUL")));
+    }
+    // Path::components() normalizes repeated separators and `.` components.
+    // Validate the original spelling first so non-canonical paths cannot pass
+    // before any filesystem object is opened or created.
+    for component in text[1..].split('/') {
+        if component.is_empty() {
+            return Err(ConfigError::InvalidPath(format!(
+                "{field} must not contain empty path components"
+            )));
+        }
+        if matches!(component, "." | "..") {
+            return Err(ConfigError::InvalidPath(format!(
+                "{field} must not contain '.' or '..' components"
+            )));
+        }
+    }
+    for component in path.components() {
+        match component {
+            Component::RootDir | Component::Normal(_) => {}
+            Component::CurDir | Component::ParentDir | Component::Prefix(_) => {
+                return Err(ConfigError::InvalidPath(format!(
+                    "{field} must not contain '.' or '..' components"
+                )));
+            }
+        }
+    }
+    Ok(())
+}
+
+fn validate_socket_path_length(path: &Path, field: &str) -> Result<(), ConfigError> {
+    // Linux pathname Unix sockets reserve one byte for the terminating NUL in
+    // `sockaddr_un.sun_path` (108 bytes total).
+    if path.as_os_str().as_bytes().len() >= 108 {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} exceeds the Linux Unix-socket pathname limit"
+        )));
+    }
+    Ok(())
+}
+
+pub fn validate_existing_parent(path: &Path, field: &str) -> Result<(), ConfigError> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| ConfigError::InvalidPath(format!("{field} has no parent")))?;
+    let mut current = PathBuf::from("/");
+    for component in parent.components() {
+        if matches!(component, Component::RootDir) {
+            continue;
+        }
+        let Component::Normal(name) = component else {
+            return Err(ConfigError::InvalidPath(format!("{field} has an invalid parent")));
+        };
+        current.push(name);
+        let metadata = match fs::symlink_metadata(&current) {
+            Ok(metadata) => metadata,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                // Missing parents are created by the relevant subsystem. Existing
+                // ancestors have still been checked for symlink and mode safety.
+                continue;
+            }
+            Err(error) => return Err(ConfigError::Io(error)),
+        };
+        if metadata.file_type().is_symlink() || !metadata.is_dir() {
+            return Err(ConfigError::InvalidPath(format!(
+                "{field} parent contains a symlink or non-directory"
+            )));
+        }
+        let mode = metadata.permissions().mode();
+        if mode & 0o022 != 0 {
+            return Err(ConfigError::InvalidPath(format!(
+                "{field} parent is writable by group or other"
+            )));
+        }
+        let owner = metadata.uid();
+        let euid = current_euid();
+        if owner != 0 && owner != euid {
+            return Err(ConfigError::InvalidPath(format!(
+                "{field} parent has an unrelated owner"
+            )));
+        }
+    }
+    Ok(())
+}
+
+fn validate_or_create_dir(path: &Path) -> Result<(), ConfigError> {
+    // Validate ancestors before creating the final directory. create_dir_all
+    // would otherwise follow a symlink introduced below an unchecked missing
+    // component.
+    validate_existing_parent(path, "spool_dir")?;
+    let metadata = match fs::symlink_metadata(path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {
+            fs::create_dir(path)?;
+            fs::set_permissions(path, fs::Permissions::from_mode(PRIVATE_DIRECTORY_MODE))?;
+            fs::symlink_metadata(path)?
+        }
+        Err(error) => return Err(ConfigError::Io(error)),
+    };
+    if metadata.file_type().is_symlink() || !metadata.is_dir() {
+        return Err(ConfigError::InvalidPath(
+            "spool_dir must be a real directory".to_owned(),
+        ));
+    }
+    if metadata.uid() != current_euid() {
+        return Err(ConfigError::InvalidPath("spool_dir has an unexpected owner".to_owned()));
+    }
+    if metadata.gid() != current_egid() {
+        return Err(ConfigError::InvalidPath("spool_dir has an unexpected group".to_owned()));
+    }
+    if metadata.permissions().mode() & 0o7777 != PRIVATE_DIRECTORY_MODE {
+        return Err(ConfigError::InvalidPath("spool_dir must have mode 0700".to_owned()));
+    }
+    Ok(())
+}
+
+/// `min_free_bytes` is a runtime cleanup watermark, but it must still be
+/// representable on the filesystem that contains the spool.  Check total
+/// capacity (rather than currently available space) so a temporarily full
+/// volume degrades health and triggers cleanup instead of making startup a
+/// configuration error.
+fn validate_min_free_capacity(path: &Path, minimum: u64) -> Result<(), ConfigError> {
+    let text = CString::new(path.as_os_str().as_bytes())
+        .map_err(|_| ConfigError::InvalidPath("spool_dir contains NUL".to_owned()))?;
+    let mut stat = std::mem::MaybeUninit::<libc::statvfs>::uninit();
+    // SAFETY: `text` is NUL terminated and `stat` points to writable storage
+    // owned by this stack frame.
+    let result = unsafe { libc::statvfs(text.as_ptr(), stat.as_mut_ptr()) };
+    if result != 0 {
+        return Err(ConfigError::Io(io::Error::last_os_error()));
+    }
+    // SAFETY: statvfs initialized `stat` on success.
+    let stat = unsafe { stat.assume_init() };
+    let total = (stat.f_blocks as u128)
+        .checked_mul(stat.f_frsize as u128)
+        .ok_or_else(|| ConfigError::Invalid("filesystem capacity overflows u128".to_owned()))?;
+    if u128::from(minimum) >= total {
+        return Err(ConfigError::Invalid(
+            "min_free_bytes must be less than the spool filesystem total capacity".to_owned(),
+        ));
+    }
+    Ok(())
+}
+
+fn validate_regular_file_metadata(
+    metadata: &fs::Metadata,
+    field: &str,
+    expected_uid: Option<u32>,
+    expected_gid: Option<u32>,
+    expected_mode: Option<u32>,
+) -> Result<(), String> {
+    if metadata.file_type().is_symlink() || !metadata.is_file() {
+        return Err(format!("{field} must be a regular, non-symlink file"));
+    }
+    if let Some(uid) = expected_uid
+        && metadata.uid() != uid
+    {
+        return Err(format!("{field} has an unexpected owner"));
+    }
+    if let Some(gid) = expected_gid
+        && metadata.gid() != gid
+    {
+        return Err(format!("{field} has an unexpected group"));
+    }
+    if let Some(mode) = expected_mode
+        && metadata.permissions().mode() & 0o7777 != mode
+    {
+        return Err(format!("{field} must have mode {mode:04o}"));
+    }
+    Ok(())
+}
+
+fn open_nofollow(path: &Path) -> io::Result<File> {
+    OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+        .open(path)
+}
+
+fn read_bounded(file: &mut File, limit: usize) -> io::Result<Vec<u8>> {
+    // Read one sentinel byte beyond the contract limit.  Callers can then
+    // distinguish an oversized file even when its metadata changed after the
+    // initial stat, without ever retaining more than limit + 1 bytes.
+    let sentinel_limit = limit
+        .checked_add(1)
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "read limit overflow"))?;
+    let mut bytes = Vec::with_capacity(sentinel_limit.min(4096));
+    file.take(sentinel_limit as u64).read_to_end(&mut bytes)?;
+    if bytes.len() > limit {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "file exceeds configured size limit",
+        ));
+    }
+    Ok(bytes)
+}
+
+fn validate_private_parent(path: &Path, field: &str) -> Result<(), ConfigError> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| ConfigError::InvalidPath(format!("{field} has no parent")))?;
+    let metadata = fs::symlink_metadata(parent)?;
+    if metadata.file_type().is_symlink() || !metadata.is_dir() {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent is not a real directory"
+        )));
+    }
+    if metadata.uid() != 0 {
+        return Err(ConfigError::InvalidPath(format!("{field} parent must be root-owned")));
+    }
+    if metadata.gid() != current_egid() {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent has an unexpected group"
+        )));
+    }
+    let mode = metadata.permissions().mode() & 0o7777;
+    if mode != SOCKET_DIRECTORY_MODE {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent must have mode {SOCKET_DIRECTORY_MODE:04o}"
+        )));
+    }
+    Ok(())
+}
+
+/// Validate a socket directory against the fixed endpoint-specific access
+/// group from the packaging contract.
+pub(crate) fn validate_socket_parent_for(path: &Path, field: &str, role: SocketRole) -> Result<(), ConfigError> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| ConfigError::InvalidPath(format!("{field} has no parent")))?;
+    let metadata = fs::symlink_metadata(parent)?;
+    if metadata.file_type().is_symlink() || !metadata.is_dir() {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent is not a real directory"
+        )));
+    }
+    if metadata.uid() != current_euid() {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent must be owned by the audit daemon"
+        )));
+    }
+    let expected_gid = resolve_gid(role.group_name())
+        .ok_or_else(|| ConfigError::Invalid(format!("required socket group {:?} does not exist", role.group_name())))?;
+    if metadata.gid() != expected_gid {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent must belong to group {:?}",
+            role.group_name()
+        )));
+    }
+    let mode = metadata.permissions().mode() & 0o7777;
+    if mode != SOCKET_DIRECTORY_MODE {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent must have mode {SOCKET_DIRECTORY_MODE:04o}"
+        )));
+    }
+    Ok(())
+}
+
+fn socket_parent_gid_for(path: &Path, role: SocketRole) -> io::Result<u32> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "socket path has no parent"))?;
+    let metadata = fs::symlink_metadata(parent)?;
+    if metadata.file_type().is_symlink() || !metadata.is_dir() {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket parent is not a real directory",
+        ));
+    }
+    if metadata.uid() != current_euid() {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket parent has an unexpected owner",
+        ));
+    }
+    if metadata.permissions().mode() & 0o7777 != SOCKET_DIRECTORY_MODE {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket parent has an unexpected mode",
+        ));
+    }
+    let expected_gid = resolve_gid(role.group_name()).ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::NotFound,
+            format!("required socket group {:?} does not exist", role.group_name()),
+        )
+    })?;
+    if metadata.gid() != expected_gid {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket parent has an unexpected endpoint group",
+        ));
+    }
+    Ok(expected_gid)
+}
+
+pub(crate) fn prepare_socket_path_for(path: &Path, role: SocketRole) -> io::Result<()> {
+    let expected_gid = socket_parent_gid_for(path, role)?;
+    remove_stale_socket(path, expected_gid)
+}
+
+/// Remove a stale socket only after a failed local connect and a second inode
+/// check.  An active listener, a replacement object, and all non-socket paths
+/// fail closed rather than being overwritten.
+fn remove_stale_socket(path: &Path, expected_gid: u32) -> io::Result<()> {
+    let metadata = match fs::symlink_metadata(path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(()),
+        Err(error) => return Err(error),
+    };
+    validate_socket_metadata(&metadata, expected_gid)?;
+
+    match StdUnixStream::connect(path) {
+        Ok(_) => {
+            return Err(io::Error::new(io::ErrorKind::AddrInUse, "socket is already active"));
+        }
+        Err(error)
+            if matches!(
+                error.kind(),
+                io::ErrorKind::ConnectionRefused
+                    | io::ErrorKind::NotFound
+                    | io::ErrorKind::ConnectionReset
+                    | io::ErrorKind::ConnectionAborted
+                    | io::ErrorKind::BrokenPipe
+            ) => {}
+        Err(error) => return Err(error),
+    }
+
+    let current = match fs::symlink_metadata(path) {
+        Ok(current) => current,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(()),
+        Err(error) => return Err(error),
+    };
+    if !current.file_type().is_socket() || current.dev() != metadata.dev() || current.ino() != metadata.ino() {
+        return Err(io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            "socket path changed while checking staleness",
+        ));
+    }
+    fs::remove_file(path)?;
+    if let Some(parent) = path.parent() {
+        sync_dir(parent)?;
+    }
+    Ok(())
+}
+
+/// Apply and verify the owner/group/mode contract immediately after bind.
+pub(crate) fn secure_bound_socket_for(path: &Path, role: SocketRole) -> io::Result<()> {
+    let expected_gid = socket_parent_gid_for(path, role)?;
+    secure_bound_socket_with_gid(path, expected_gid)
+}
+
+fn secure_bound_socket_with_gid(path: &Path, expected_gid: u32) -> io::Result<()> {
+    let cpath = CString::new(path.as_os_str().as_bytes())
+        .map_err(|_| io::Error::new(io::ErrorKind::InvalidInput, "socket path contains NUL"))?;
+    let raw_fd = unsafe { libc::open(cpath.as_ptr(), libc::O_CLOEXEC | libc::O_NOFOLLOW | libc::O_PATH) };
+    if raw_fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: raw_fd is an owned descriptor returned by open(2).
+    let file = unsafe { File::from_raw_fd(raw_fd) };
+    let opened = file.metadata()?;
+    validate_socket_metadata(&opened, expected_gid).or_else(|error| {
+        if !opened.file_type().is_socket() || opened.uid() != current_euid() {
+            Err(error)
+        } else {
+            Ok(())
+        }
+    })?;
+    // O_PATH descriptors cannot be passed to fchown(2), and fchownat(2) only
+    // accepts AT_EMPTY_PATH with an empty string, never a null pathname. Follow
+    // the procfs link for this already-verified descriptor so chmod/chown act
+    // on the fixed inode rather than a replaceable socket pathname.
+    let descriptor = format!("/proc/self/fd/{}", file.as_raw_fd());
+    let descriptor_c = CString::new(descriptor.as_bytes())
+        .map_err(|_| io::Error::new(io::ErrorKind::InvalidInput, "socket descriptor path contains NUL"))?;
+    let result = unsafe { libc::chown(descriptor_c.as_ptr(), u32::MAX, expected_gid) };
+    if result != 0 {
+        let error = io::Error::last_os_error();
+        return Err(io::Error::new(
+            error.kind(),
+            format!("failed to set socket group through /proc/self/fd; procfs must be mounted and accessible: {error}"),
+        ));
+    }
+    fs::set_permissions(&descriptor, fs::Permissions::from_mode(SOCKET_MODE)).map_err(|error| {
+        io::Error::new(
+            error.kind(),
+            format!("failed to set socket mode through /proc/self/fd; procfs must be mounted and accessible: {error}"),
+        )
+    })?;
+    let opened = file.metadata()?;
+    validate_socket_metadata(&opened, expected_gid)?;
+    let current = fs::symlink_metadata(path)?;
+    validate_socket_metadata(&current, expected_gid)?;
+    if current.dev() != opened.dev() || current.ino() != opened.ino() {
+        return Err(io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            "socket path changed while setting permissions",
+        ));
+    }
+    Ok(())
+}
+
+pub(crate) fn validate_bound_socket_for(path: &Path, role: SocketRole) -> io::Result<()> {
+    let expected_gid = socket_parent_gid_for(path, role)?;
+    let metadata = fs::symlink_metadata(path)?;
+    validate_socket_metadata(&metadata, expected_gid)
+}
+
+fn validate_socket_metadata(metadata: &fs::Metadata, expected_gid: u32) -> io::Result<()> {
+    if metadata.file_type().is_symlink() || !metadata.file_type().is_socket() {
+        return Err(io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            "socket path is not a Unix socket",
+        ));
+    }
+    if metadata.uid() != current_euid() || metadata.gid() != expected_gid {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket inode has an unexpected owner or group",
+        ));
+    }
+    if metadata.permissions().mode() & 0o7777 != SOCKET_MODE {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket inode has an unexpected mode",
+        ));
+    }
+    Ok(())
+}
+
+fn current_euid() -> u32 {
+    // SAFETY: geteuid has no preconditions and does not mutate memory.
+    unsafe { libc::geteuid() }
+}
+
+fn current_egid() -> u32 {
+    // SAFETY: getegid has no preconditions and does not mutate memory.
+    unsafe { libc::getegid() }
+}
+
+pub fn decode_hmac_key(bytes: &[u8]) -> Result<[u8; 32], String> {
+    let raw = match bytes.strip_suffix(b"\n") {
+        Some(raw) => raw,
+        None => bytes,
+    };
+    if raw.len() != 64
+        || raw
+            .iter()
+            .any(|byte| !byte.is_ascii_hexdigit() || byte.is_ascii_uppercase())
+    {
+        return Err("HMAC key must be exactly 64 lowercase hexadecimal characters with an optional LF".to_owned());
+    }
+    let decoded = hex::decode(raw).map_err(|_| "HMAC key is not valid hexadecimal".to_owned())?;
+    let mut key = [0_u8; 32];
+    if decoded.len() != key.len() {
+        return Err("HMAC key must decode to 32 bytes".to_owned());
+    }
+    key.copy_from_slice(&decoded);
+    Ok(key)
+}
+
+fn resolve_uid(name: &str) -> Option<u32> {
+    let cname = CString::new(name).ok()?;
+    let mut entry = std::mem::MaybeUninit::<libc::passwd>::uninit();
+    let mut buffer = vec![0_u8; 16 * 1024];
+    let mut result = std::ptr::null_mut();
+    // SAFETY: all pointers refer to valid writable buffers for libc's reentrant API.
+    let rc = unsafe {
+        libc::getpwnam_r(
+            cname.as_ptr(),
+            entry.as_mut_ptr(),
+            buffer.as_mut_ptr().cast(),
+            buffer.len(),
+            &mut result,
+        )
+    };
+    if rc != 0 || result.is_null() {
+        return None;
+    }
+    // SAFETY: result points at the initialized entry above when rc == 0.
+    let entry = unsafe { entry.assume_init() };
+    Some(entry.pw_uid)
+}
+
+fn resolve_gid(name: &str) -> Option<u32> {
+    let cname = CString::new(name).ok()?;
+    let mut entry = std::mem::MaybeUninit::<libc::group>::uninit();
+    let mut buffer = vec![0_u8; 16 * 1024];
+    let mut result = std::ptr::null_mut();
+    // SAFETY: all pointers refer to valid writable buffers for libc's
+    // reentrant group lookup API.
+    let rc = unsafe {
+        libc::getgrnam_r(
+            cname.as_ptr(),
+            entry.as_mut_ptr(),
+            buffer.as_mut_ptr().cast(),
+            buffer.len(),
+            &mut result,
+        )
+    };
+    if rc != 0 || result.is_null() {
+        return None;
+    }
+    // SAFETY: result points at the initialized entry above when rc == 0.
+    let entry = unsafe { entry.assume_init() };
+    Some(entry.gr_gid)
+}
