+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+struct GapSnapshot {
+    count: u64,
+    first: Option<u64>,
+    last: Option<u64>,
+    first_time: u64,
+    last_time: u64,
+}
+
+/// A fixed set of tiny seqlock slots used by the relay-facing diagnostic
+/// accumulators.  A relay never waits for a mutex: it claims any currently
+/// free slot with one CAS and updates all fields while that slot is odd.  The
+/// supervisor takes each slot under the same seqlock and combines the stable
+/// snapshots, so count and boundary fields cannot be mixed across an `add`.
+const GAP_ACCUMULATOR_SLOTS: usize = 8;
+
+#[derive(Default)]
+struct GapSlot {
+    sequence: AtomicU64,
+    count: AtomicU64,
+    first: AtomicU64,
+    last: AtomicU64,
+    first_time: AtomicU64,
+    last_time: AtomicU64,
+}
+
+impl GapSlot {
+    fn try_merge(&self, snapshot: GapSnapshot) -> bool {
+        if snapshot.count == 0 {
+            return true;
+        }
+        let version = self.sequence.load(Ordering::Acquire);
+        if version & 1 != 0 {
+            return false;
+        }
+        if self
+            .sequence
+            .compare_exchange(version, version.wrapping_add(1), Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            return false;
+        }
+
+        let count = self.count.load(Ordering::Relaxed).saturating_add(snapshot.count);
+        self.count.store(count, Ordering::Relaxed);
+        if let Some(first) = snapshot.first {
+            let current = self.first.load(Ordering::Relaxed);
+            if current == 0 || first < current {
+                self.first.store(first, Ordering::Relaxed);
+            }
+        }
+        if let Some(last) = snapshot.last {
+            let current = self.last.load(Ordering::Relaxed);
+            if last > current {
+                self.last.store(last, Ordering::Relaxed);
+            }
+        }
+        if snapshot.first_time != 0 {
+            let current = self.first_time.load(Ordering::Relaxed);
+            if current == 0 || snapshot.first_time < current {
+                self.first_time.store(snapshot.first_time, Ordering::Relaxed);
+            }
+        }
+        if snapshot.last_time > self.last_time.load(Ordering::Relaxed) {
+            self.last_time.store(snapshot.last_time, Ordering::Relaxed);
+        }
+        self.sequence.store(version.wrapping_add(2), Ordering::Release);
+        true
+    }
+
+    /// Try to take a coherent slot snapshot without waiting.  A producer can
+    /// be pre-empted while it owns a slot; spinning in the supervisor would
+    /// turn that otherwise tiny critical section into an unbounded shutdown
+    /// wait.  The accumulator retries the slot on a later pass instead.
+    fn try_take(&self) -> Option<GapSnapshot> {
+        let version = self.sequence.load(Ordering::Acquire);
+        if version & 1 != 0 {
+            return None;
+        }
+        if self
+            .sequence
+            .compare_exchange(version, version.wrapping_add(1), Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            return None;
+        }
+        let snapshot = GapSnapshot {
+            count: self.count.swap(0, Ordering::Relaxed),
+            first: match self.first.swap(0, Ordering::Relaxed) {
+                0 => None,
+                value => Some(value),
+            },
+            last: match self.last.swap(0, Ordering::Relaxed) {
+                0 => None,
+                value => Some(value),
+            },
+            first_time: self.first_time.swap(0, Ordering::Relaxed),
+            last_time: self.last_time.swap(0, Ordering::Relaxed),
+        };
+        self.sequence.store(version.wrapping_add(2), Ordering::Release);
+        Some(snapshot)
+    }
+
+    fn is_nonempty(&self) -> bool {
+        self.sequence.load(Ordering::Acquire) & 1 != 0 || self.count.load(Ordering::Acquire) != 0
+    }
+}
+
+/// A bounded escape hatch for the (very short) seqlock slots above.  Under
+/// normal load a merge always lands in one of the coherent slots.  If every
+/// slot is temporarily owned by another producer, waiting would violate the
+/// relay hot-path contract, so the merge is recorded here instead.  The
+/// fallback has its own tiny lock for coherent updates and a count-only
+/// overflow path for the case where even that lock is busy.  Losing boundary
+/// metadata in that pathological path is explicitly represented as unknown;
+/// the dropped count itself is retained (and saturates conservatively).
+#[derive(Default)]
+struct GapFallback {
+    lock: AtomicBool,
+    count: AtomicU64,
+    first: AtomicU64,
+    last: AtomicU64,
+    first_time: AtomicU64,
+    last_time: AtomicU64,
+    metadata_unknown: AtomicBool,
+}
+
+const GAP_FALLBACK_CAS_ATTEMPTS: usize = 4;
+
+impl GapFallback {
+    fn merge(&self, snapshot: GapSnapshot) {
+        if snapshot.count == 0 {
+            return;
+        }
+
+        if self
+            .lock
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .is_ok()
+        {
+            self.merge_locked(snapshot);
+            self.lock.store(false, Ordering::Release);
+            return;
+        }
+
+        // Do not wait for the fallback lock.  A count-only merge is still a
+        // useful and honest diagnostic: sequence/time boundaries are nullable
+        // when concurrent gaps cannot be determined precisely.
+        self.metadata_unknown.store(true, Ordering::Release);
+        saturating_add_atomic(&self.count, snapshot.count);
+    }
+
+    fn merge_locked(&self, snapshot: GapSnapshot) {
+        // The count-only overflow path may still update this atomic while the
+        // fallback lock is held.  Use the same CAS-based saturating addition
+        // here so that a stale load cannot overwrite that concurrent update.
+        saturating_add_atomic(&self.count, snapshot.count);
+        if let Some(first) = snapshot.first {
+            let current = self.first.load(Ordering::Relaxed);
+            if current == 0 || first < current {
+                self.first.store(first, Ordering::Relaxed);
+            }
+        }
+        if let Some(last) = snapshot.last {
+            let current = self.last.load(Ordering::Relaxed);
+            if last > current {
+                self.last.store(last, Ordering::Relaxed);
+            }
+        }
+        if snapshot.first_time != 0 {
+            let current = self.first_time.load(Ordering::Relaxed);
+            if current == 0 || snapshot.first_time < current {
+                self.first_time.store(snapshot.first_time, Ordering::Relaxed);
+            }
+        }
+        if snapshot.last_time > self.last_time.load(Ordering::Relaxed) {
+            self.last_time.store(snapshot.last_time, Ordering::Relaxed);
+        }
+    }
+
+    fn try_take(&self) -> Option<GapSnapshot> {
+        if self
+            .lock
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            return None;
+        }
+        let snapshot = GapSnapshot {
+            count: self.count.swap(0, Ordering::Relaxed),
+            first: match self.first.swap(0, Ordering::Relaxed) {
+                0 => None,
+                value => Some(value),
+            },
+            last: match self.last.swap(0, Ordering::Relaxed) {
+                0 => None,
+                value => Some(value),
+            },
+            first_time: self.first_time.swap(0, Ordering::Relaxed),
+            last_time: self.last_time.swap(0, Ordering::Relaxed),
+        };
+        let metadata_unknown = self.metadata_unknown.swap(false, Ordering::AcqRel);
+        self.lock.store(false, Ordering::Release);
+
+        if metadata_unknown {
+            Some(GapSnapshot {
+                count: snapshot.count,
+                first: None,
+                last: None,
+                first_time: 0,
+                last_time: 0,
+            })
+        } else {
+            Some(snapshot)
+        }
+    }
+
+    fn is_nonempty(&self) -> bool {
+        self.lock.load(Ordering::Acquire)
+            || self.count.load(Ordering::Acquire) != 0
+            || self.metadata_unknown.load(Ordering::Acquire)
+    }
+}
+
+/// Saturating atomic addition with a fixed retry budget.  If contention lasts
+/// beyond that budget, publishing `u64::MAX` is conservative: the wire
+/// contract defines that value as "at least this many" rather than allowing a
+/// wrapped or under-counted diagnostic.
+fn saturating_add_atomic(atom: &AtomicU64, amount: u64) {
+    if amount == 0 {
+        return;
+    }
+    let mut current = atom.load(Ordering::Acquire);
+    for _ in 0..GAP_FALLBACK_CAS_ATTEMPTS {
+        if current == u64::MAX {
+            return;
+        }
+        let next = current.checked_add(amount).unwrap_or(u64::MAX);
+        match atom.compare_exchange_weak(current, next, Ordering::AcqRel, Ordering::Acquire) {
+            Ok(_) => return,
+            Err(actual) => current = actual,
+        }
+    }
+    atom.store(u64::MAX, Ordering::Release);
+}
+
+struct GapAccumulator {
+    slots: [GapSlot; GAP_ACCUMULATOR_SLOTS],
+    next_slot: AtomicUsize,
+    fallback: GapFallback,
+}
+
+impl Default for GapAccumulator {
+    fn default() -> Self {
+        Self {
+            slots: std::array::from_fn(|_| GapSlot::default()),
+            next_slot: AtomicUsize::new(0),
+            fallback: GapFallback::default(),
+        }
+    }
+}
+
+impl GapAccumulator {
+    fn add(&self, count: u64, sequence: Option<u64>, now: u64) {
+        self.merge(GapSnapshot {
+            count,
+            first: sequence,
+            last: sequence,
+            first_time: now,
+            last_time: now,
+        });
+    }
+
+    fn merge(&self, snapshot: GapSnapshot) {
+        if snapshot.count == 0 {
+            return;
+        }
+        let start = self.next_slot.fetch_add(1, Ordering::Relaxed) % GAP_ACCUMULATOR_SLOTS;
+        for offset in 0..GAP_ACCUMULATOR_SLOTS {
+            let index = (start + offset) % GAP_ACCUMULATOR_SLOTS;
+            if self.slots[index].try_merge(snapshot) {
+                return;
+            }
+        }
+        // All primary slots are busy.  The fallback is deliberately one
+        // bounded call; it never spins or waits on the relay thread.
+        self.fallback.merge(snapshot);
+    }
+
+    fn is_nonempty(&self) -> bool {
+        self.slots.iter().any(GapSlot::is_nonempty) || self.fallback.is_nonempty()
+    }
+
+    fn take(&self) -> Option<GapSnapshot> {
+        let mut combined = None;
+        for slot in &self.slots {
+            let Some(snapshot) = slot.try_take() else {
+                continue;
+            };
+            if snapshot.count == 0 {
+                continue;
+            }
+            combined = Some(match combined {
+                None => snapshot,
+                Some(current) => combine_gap_snapshots(current, snapshot),
+            });
+        }
+        if let Some(snapshot) = self.fallback.try_take()
+            && snapshot.count != 0
+        {
+            combined = Some(match combined {
+                None => snapshot,
+                Some(current) => combine_gap_snapshots(current, snapshot),
+            });
+        }
+        combined
+    }
+}
+
+fn combine_gap_snapshots(left: GapSnapshot, right: GapSnapshot) -> GapSnapshot {
+    GapSnapshot {
+        count: left.count.saturating_add(right.count),
+        first: match (left.first, right.first) {
+            (None, value) | (value, None) => value,
+            (Some(a), Some(b)) => Some(a.min(b)),
+        },
+        last: match (left.last, right.last) {
+            (None, value) | (value, None) => value,
+            (Some(a), Some(b)) => Some(a.max(b)),
+        },
+        first_time: min_nonzero(left.first_time, right.first_time),
+        last_time: left.last_time.max(right.last_time),
+    }
+}
+
+fn min_nonzero(left: u64, right: u64) -> u64 {
+    match (left, right) {
+        (0, value) | (value, 0) => value,
+        (a, b) => a.min(b),
+    }
+}
