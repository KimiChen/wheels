+async fn stop_data_tasks(tasks: &mut Vec<ServerHandle>, data_shutdowns: &[DataShutdownHandle]) {
+    for shutdown in data_shutdowns {
+        shutdown.stop_accepting();
+    }
+
+    // Server::run owns and joins its listener/plugin/manager children after
+    // observing this stop signal.  Auxiliary tasks (notably the statistics
+    // exporter) may not have a data-shutdown hook, so retain a bounded abort
+    // fallback rather than waiting forever on one such task.
+    if tokio::time::timeout(Duration::from_secs(1), join_ready_tasks(tasks))
+        .await
+        .is_err()
+    {
+        // `join_ready_tasks` removes every handle as soon as its output is
+        // consumed. After the timeout only unconsumed handles remain, so this
+        // abort fallback cannot poll a completed JoinHandle twice.
+        for task in tasks.iter() {
+            task.0.abort();
+        }
+        join_ready_tasks(tasks).await;
+    }
+
+    for shutdown in data_shutdowns {
+        let _ = tokio::time::timeout(Duration::from_secs(1), shutdown.terminate_and_join()).await;
+    }
