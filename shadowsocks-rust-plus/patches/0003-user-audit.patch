+        // Shutdown path: the last guard released after close is exactly the
+        // transition drain() is waiting for.
+        let guard = emitter.begin_observation().expect("observation guard");
+        emitter.close_emitter();
+        let notified = emitter.notify.notified();
+        tokio::pin!(notified);
+        notified.as_mut().enable();
+        drop(guard);
+        tokio::time::timeout(Duration::from_millis(500), &mut notified)
+            .await
+            .expect("the final guard release must wake drain");
