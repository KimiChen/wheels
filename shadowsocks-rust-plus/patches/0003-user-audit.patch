+        let error = spool.append(&event(1), 1).expect_err("a fatal barrier must not ACK");
+        assert!(matches!(error, SpoolError::DurabilityUncertain), "{error:?}");
+        assert!(
+            lock(&spool.inner).durability_uncertain,
+            "the fatal state must be sticky"
