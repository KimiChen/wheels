+    /// An aggregate-ledger rename can succeed before its parent-directory
+    /// fsync reports an error.  Every tombstone mutation must retain the
+    /// in-memory post-transition state and stop the daemon, otherwise a later
+    /// request can overwrite the newer on-disk ledger with the rolled-back
+    /// view.  Exercise all mutation entry points that can persist the ledger.
+    #[test]
+    fn tombstone_after_rename_failure_keeps_post_commit_state() {
+        // add_tombstone_locked
+        {
+            let dir = tempfile::tempdir().expect("tempdir");
+            let spool = Spool::open(config(dir.path())).expect("spool");
+            let entry = TombstoneEntry::AckedReceipt(wire::AckedReceipt::new(
+                "a".repeat(32),
+                "b".repeat(64),
+                1,
+            ));
+            let mut inner = lock(&spool.inner);
+            inner.faults.persist_tombstones_after_commit = true;
+            let error = spool
+                .add_tombstone_locked(&mut inner, entry.clone())
+                .expect_err("post-rename ledger failure");
+            assert!(matches!(error, SpoolError::DurabilityUncertain));
+            assert_eq!(inner.tombstones, vec![entry.clone()]);
+            drop(inner);
+            assert_eq!(load_tombstones(dir.path()).expect("ledger"), vec![entry]);
+        }
+
+        // prune_receipts_locked
+        {
+            let dir = tempfile::tempdir().expect("tempdir");
+            let spool = Spool::open(config(dir.path())).expect("spool");
+            let entry = TombstoneEntry::AckedReceipt(wire::AckedReceipt::new(
+                "c".repeat(32),
+                "d".repeat(64),
+                1,
+            ));
+            {
+                let mut inner = lock(&spool.inner);
+                spool
+                    .add_tombstone_locked(&mut inner, entry)
+                    .expect("initial ledger");
+                inner.faults.persist_tombstones_after_commit = true;
+                let error = spool
+                    .prune_receipts_locked(&mut inner)
+                    .expect_err("post-rename ledger failure");
+                assert!(matches!(error, SpoolError::DurabilityUncertain));
+                assert!(inner.tombstones.is_empty(), "retain the committed prune");
+            }
+            assert!(load_tombstones(dir.path()).expect("ledger").is_empty());
+        }
+
+        // remove_tombstone_locked
+        {
+            let dir = tempfile::tempdir().expect("tempdir");
+            let spool = Spool::open(config(dir.path())).expect("spool");
+            let pending = eviction_pending_for_test(
+                "spool:11111111111111111111111111111111",
+                "e".repeat(32).as_str(),
+            );
+            let mut inner = lock(&spool.inner);
+            spool
+                .add_tombstone_locked(&mut inner, pending)
+                .expect("initial ledger");
+            inner.faults.persist_tombstones_after_commit = true;
+            let error = spool
+                .remove_tombstone_locked(&mut inner, 0)
+                .expect_err("post-rename ledger failure");
+            assert!(matches!(error, SpoolError::DurabilityUncertain));
+            assert!(inner.tombstones.is_empty(), "retain the committed removal");
+            drop(inner);
+            assert!(load_tombstones(dir.path()).expect("ledger").is_empty());
+        }
+
+        // replace_tombstone_locked
+        {
+            let dir = tempfile::tempdir().expect("tempdir");
+            let spool = Spool::open(config(dir.path())).expect("spool");
+            let pending = match eviction_pending_for_test(
+                "spool:22222222222222222222222222222222",
+                "f".repeat(32).as_str(),
+            ) {
+                TombstoneEntry::EvictionPending(value) => value,
+                _ => unreachable!("test helper must build an eviction pending entry"),
+            };
+            let replacement = TombstoneEntry::EvictedReceipt(wire::EvictedReceipt::from_pending(&pending));
+            let mut inner = lock(&spool.inner);
+            spool
+                .add_tombstone_locked(&mut inner, TombstoneEntry::EvictionPending(pending.clone()))
+                .expect("initial ledger");
+            inner.faults.persist_tombstones_after_commit = true;
+            let error = spool
+                .replace_tombstone_locked(&mut inner, 0, Some(replacement.clone()))
+                .expect_err("post-rename ledger failure");
+            assert!(matches!(error, SpoolError::DurabilityUncertain));
+            assert_eq!(inner.tombstones, vec![replacement.clone()]);
+            drop(inner);
+            assert_eq!(load_tombstones(dir.path()).expect("ledger"), vec![replacement]);
+        }
+    }
