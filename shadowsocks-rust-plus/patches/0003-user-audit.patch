+    pub dropped_events: DecimalU64,
+    pub first_dropped_sequence: Option<DecimalU64>,
+    pub last_dropped_sequence: Option<DecimalU64>,
+    pub first_seen_unix_ms: DecimalU64,
+    pub last_seen_unix_ms: DecimalU64,
