+/* ------------------------------------------------------------------------- */
+/* SHA-256 and HMAC canonicalization                                        */
+
+pub fn sha256_digest(bytes: &[u8]) -> [u8; 32] {
+    let digest = Sha256::digest(bytes);
+    let mut output = [0u8; 32];
+    output.copy_from_slice(&digest);
+    output
+}
+
+pub fn sha256_hex(bytes: &[u8]) -> String {
+    hex::encode(sha256_digest(bytes))
+}
+
+pub fn event_payload_sha256(bytes: &[u8]) -> String {
+    sha256_hex(bytes)
+}
+
+fn validate_digest(value: &str, field: &str) -> Result<(), ProtocolError> {
+    validate_lower_hex(value, 32, field)
+}
+
+fn validate_no_line_break(value: &str, field: &str) -> Result<(), ProtocolError> {
+    if value.contains(['\r', '\n']) {
+        return Err(invalid(field, "must not contain CR/LF"));
+    }
+    Ok(())
+}
+
+fn validate_timestamp_text(value: &str) -> Result<u64, ProtocolError> {
+    parse_decimal(value, true).map_err(|_| invalid("timestamp", "must be canonical decimal"))
+}
+
+fn validate_http_token(value: &str, field: &str) -> Result<(), ProtocolError> {
+    if value.is_empty()
+        || !value.bytes().all(|byte| {
+            byte.is_ascii_alphanumeric()
+                || matches!(
+                    byte,
+                    b'!' | b'#'
+                        | b'$'
+                        | b'%'
+                        | b'&'
+                        | b'\''
+                        | b'*'
+                        | b'+'
+                        | b'-'
+                        | b'.'
+                        | b'^'
+                        | b'_'
+                        | b'`'
+                        | b'|'
+                        | b'~'
+                )
+        })
+    {
+        return Err(invalid(field, "must be an HTTP token"));
+    }
+    Ok(())
+}
+
+fn validate_origin_path(value: &str) -> Result<(), ProtocolError> {
+    if value.is_empty() || !value.starts_with('/') {
+        return Err(invalid("path", "must be an origin-form path"));
+    }
+    if !value.bytes().all(|byte| (0x21..=0x7e).contains(&byte))
+        || value.bytes().any(|byte| matches!(byte, b'?' | b'#' | b'%' | b'\\'))
+    {
+        return Err(invalid("path", "contains a forbidden origin-form character"));
+    }
+    Ok(())
+}
+
+pub fn canonical_request(
+    method: &str,
+    exact_path: &str,
+    node_id: &str,
+    timestamp: u64,
+    nonce: &str,
+    body_sha256: &str,
+) -> Result<Vec<u8>, ProtocolError> {
+    validate_http_token(method, "method")?;
+    validate_origin_path(exact_path)?;
+    validate_identifier(node_id, "node_id")?;
+    validate_lower_hex(nonce, 16, "nonce")?;
+    validate_digest(body_sha256, "body_sha256")?;
+    let text = format!("SHADOWSOCKS-AUDIT-V1\n{method}\n{exact_path}\n{node_id}\n{timestamp}\n{nonce}\n{body_sha256}");
+    Ok(text.into_bytes())
+}
+
+pub fn canonical_request_from_strings(
+    method: &str,
+    exact_path: &str,
+    node_id: &str,
+    timestamp: &str,
+    nonce: &str,
+    body_sha256: &str,
+) -> Result<Vec<u8>, ProtocolError> {
+    let parsed = validate_timestamp_text(timestamp)?;
+    // Requiring the input spelling to survive the integer round-trip rejects
+    // leading zeroes and other alternate representations.
+    if parsed.to_string() != timestamp {
+        return Err(invalid("timestamp", "must not contain leading zeroes"));
+    }
+    canonical_request(method, exact_path, node_id, parsed, nonce, body_sha256)
+}
+
+#[allow(clippy::too_many_arguments)]
+pub fn canonical_response(
+    request_nonce: &str,
+    http_status: u16,
+    content_type: Option<&str>,
+    audit_schema: Option<u8>,
+    lease_body_sha256: Option<&str>,
+    node_id: &str,
+    batch_id: Option<&str>,
+    spool_epoch: Option<&str>,
+    first_sequence: Option<u64>,
+    last_sequence: Option<u64>,
+    event_count: Option<u64>,
+    response_body_sha256: &str,
+) -> Result<Vec<u8>, ProtocolError> {
+    if !(100..=599).contains(&http_status) {
+        return Err(invalid("http_status", "must be an HTTP status code"));
+    }
+    validate_lower_hex(request_nonce, 16, "request_nonce")?;
+    validate_identifier(node_id, "node_id")?;
+    validate_digest(response_body_sha256, "response_body_sha256")?;
+    if let Some(value) = content_type {
+        validate_no_line_break(value, "content_type")?;
+    }
+    if let Some(value) = lease_body_sha256 {
+        validate_digest(value, "lease_body_sha256")?;
+    }
+    if let Some(value) = batch_id {
+        validate_lower_hex(value, 16, "batch_id")?;
+    }
+    if let Some(value) = spool_epoch {
+        validate_lower_hex(value, 16, "spool_epoch")?;
+    }
+    if first_sequence.is_some() != last_sequence.is_some() {
+        return Err(invalid("sequence", "first and last must be supplied together"));
+    }
+    if let (Some(first), Some(last)) = (first_sequence, last_sequence)
+        && (first == 0 || last < first)
+    {
+        return Err(invalid("sequence", "must satisfy 0 < first <= last"));
+    }
+    let lease_fields = [
+        audit_schema.is_some(),
+        lease_body_sha256.is_some(),
+        batch_id.is_some(),
+        spool_epoch.is_some(),
+        first_sequence.is_some(),
+        last_sequence.is_some(),
+        event_count.is_some(),
+    ];
+    let all_lease_fields = lease_fields.iter().all(|present| *present);
+    let no_lease_fields = lease_fields.iter().all(|present| !*present);
+    if !all_lease_fields && !no_lease_fields {
+        return Err(invalid(
+            "lease metadata",
+            "all lease fields are required together or all must be empty",
+        ));
+    }
+    if let Some(schema) = audit_schema {
+        validate_schema(schema)?;
+        if http_status != 200 {
+            return Err(invalid("lease metadata", "metadata is only valid on a 200 lease"));
+        }
+        if content_type != Some("application/x-ndjson") {
+            return Err(invalid("content_type", "a 200 lease must use application/x-ndjson"));
+        }
+        if lease_body_sha256 != Some(response_body_sha256) {
+            return Err(invalid(
+                "lease_body_sha256",
+                "must equal response_body_sha256 for a lease",
+            ));
+        }
+        if event_count == Some(0) {
+            return Err(invalid("event_count", "must be positive"));
+        }
+        if let (Some(first), Some(last), Some(count)) = (first_sequence, last_sequence, event_count) {
+            let expected_count = last
+                .checked_sub(first)
+                .and_then(|value| value.checked_add(1))
+                .ok_or_else(|| invalid("event_count", "sequence range is too large"))?;
+            if count != expected_count {
+                return Err(invalid("event_count", "must equal last_sequence - first_sequence + 1"));
+            }
+        }
+    }
+    let field = |value: Option<String>| value.unwrap_or_default();
+    let text = format!(
+        "SHADOWSOCKS-AUDIT-RESPONSE-V1\n{}\n{}\n{}\n{}\n{}\n{}\n{}\n{}\n{}\n{}\n{}\n{}",
+        request_nonce,
+        http_status,
+        field(content_type.map(str::to_owned)),
+        field(audit_schema.map(|value| value.to_string())),
+        field(lease_body_sha256.map(str::to_owned)),
+        node_id,
+        field(batch_id.map(str::to_owned)),
+        field(spool_epoch.map(str::to_owned)),
+        field(first_sequence.map(|value| value.to_string())),
+        field(last_sequence.map(|value| value.to_string())),
+        field(event_count.map(|value| value.to_string())),
+        response_body_sha256,
+    );
+    Ok(text.into_bytes())
+}
+
+pub fn hmac_sha256(key: &[u8], message: &[u8]) -> Result<[u8; 32], ProtocolError> {
+    if key.len() != 32 {
+        return Err(ProtocolError::InvalidHmacKey);
+    }
+    let mut mac = Hmac::<Sha256>::new_from_slice(key).map_err(|_| ProtocolError::InvalidHmacKey)?;
+    mac.update(message);
+    let bytes = mac.finalize().into_bytes();
+    let mut output = [0u8; 32];
+    output.copy_from_slice(&bytes);
+    Ok(output)
+}
+
+pub fn compute_request_mac(
+    key: &[u8],
+    method: &str,
+    exact_path: &str,
+    node_id: &str,
+    timestamp: u64,
+    nonce: &str,
+    body_sha256: &str,
+) -> Result<[u8; 32], ProtocolError> {
+    hmac_sha256(
+        key,
+        &canonical_request(method, exact_path, node_id, timestamp, nonce, body_sha256)?,
+    )
+}
+
+pub fn request_mac_hex(
+    key: &[u8],
+    method: &str,
+    exact_path: &str,
+    node_id: &str,
+    timestamp: u64,
+    nonce: &str,
+    body_sha256: &str,
+) -> Result<String, ProtocolError> {
+    Ok(hex::encode(compute_request_mac(
+        key,
+        method,
+        exact_path,
+        node_id,
+        timestamp,
+        nonce,
+        body_sha256,
+    )?))
+}
+
+#[allow(clippy::too_many_arguments)]
+pub fn verify_request_mac(
+    key: &[u8],
+    expected_hex: &str,
+    method: &str,
+    exact_path: &str,
+    node_id: &str,
+    timestamp: u64,
+    nonce: &str,
+    body_sha256: &str,
+) -> Result<bool, ProtocolError> {
+    let expected = decode_hmac_hex(expected_hex)?;
+    let actual = compute_request_mac(key, method, exact_path, node_id, timestamp, nonce, body_sha256)?;
+    Ok(actual.ct_eq(&expected).into())
+}
+
+#[allow(clippy::too_many_arguments)]
+pub fn compute_response_mac(
+    key: &[u8],
+    request_nonce: &str,
+    http_status: u16,
+    content_type: Option<&str>,
+    audit_schema: Option<u8>,
+    lease_body_sha256: Option<&str>,
+    node_id: &str,
+    batch_id: Option<&str>,
+    spool_epoch: Option<&str>,
+    first_sequence: Option<u64>,
+    last_sequence: Option<u64>,
+    event_count: Option<u64>,
+    response_body_sha256: &str,
+) -> Result<[u8; 32], ProtocolError> {
+    hmac_sha256(
+        key,
+        &canonical_response(
+            request_nonce,
+            http_status,
+            content_type,
+            audit_schema,
+            lease_body_sha256,
+            node_id,
+            batch_id,
+            spool_epoch,
+            first_sequence,
+            last_sequence,
+            event_count,
+            response_body_sha256,
+        )?,
+    )
+}
+
+#[allow(clippy::too_many_arguments)]
+pub fn response_mac_hex(
+    key: &[u8],
+    request_nonce: &str,
+    http_status: u16,
+    content_type: Option<&str>,
+    audit_schema: Option<u8>,
+    lease_body_sha256: Option<&str>,
+    node_id: &str,
+    batch_id: Option<&str>,
+    spool_epoch: Option<&str>,
+    first_sequence: Option<u64>,
+    last_sequence: Option<u64>,
+    event_count: Option<u64>,
+    response_body_sha256: &str,
+) -> Result<String, ProtocolError> {
+    Ok(hex::encode(compute_response_mac(
+        key,
+        request_nonce,
+        http_status,
+        content_type,
+        audit_schema,
+        lease_body_sha256,
+        node_id,
+        batch_id,
+        spool_epoch,
+        first_sequence,
+        last_sequence,
+        event_count,
+        response_body_sha256,
+    )?))
+}
+
+/// Verify a response MAC using the same canonical fields used by
+/// [`compute_response_mac`].  The hexadecimal value is validated before the
+/// constant-time comparison is performed.
+#[allow(clippy::too_many_arguments)]
+pub fn verify_response_mac(
+    key: &[u8],
+    expected_hex: &str,
+    request_nonce: &str,
+    http_status: u16,
+    content_type: Option<&str>,
+    audit_schema: Option<u8>,
+    lease_body_sha256: Option<&str>,
+    node_id: &str,
+    batch_id: Option<&str>,
+    spool_epoch: Option<&str>,
+    first_sequence: Option<u64>,
+    last_sequence: Option<u64>,
+    event_count: Option<u64>,
+    response_body_sha256: &str,
+) -> Result<bool, ProtocolError> {
+    let expected = decode_hmac_hex(expected_hex)?;
+    let actual = compute_response_mac(
+        key,
+        request_nonce,
+        http_status,
+        content_type,
+        audit_schema,
+        lease_body_sha256,
+        node_id,
+        batch_id,
+        spool_epoch,
+        first_sequence,
+        last_sequence,
+        event_count,
+        response_body_sha256,
+    )?;
+    Ok(actual.ct_eq(&expected).into())
+}
+
+fn decode_hmac_hex(value: &str) -> Result<[u8; 32], ProtocolError> {
+    validate_lower_hex(value, 32, "hmac")?;
+    let decoded = hex::decode(value).map_err(|_| ProtocolError::InvalidHmacValue)?;
+    let mut output = [0u8; 32];
+    output.copy_from_slice(&decoded);
+    Ok(output)
+}
+
+pub fn parse_hmac_hex(value: &str) -> Result<[u8; 32], ProtocolError> {
+    decode_hmac_hex(value)
+}
