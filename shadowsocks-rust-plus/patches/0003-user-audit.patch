+//! Unix-stream ingest endpoint used by the ssserver producer.
+
+use std::{
+    collections::{HashMap, VecDeque},
+    fs, io,
+    os::fd::AsRawFd,
+    os::unix::fs::{FileTypeExt, MetadataExt},
+    path::PathBuf,
+    sync::{Arc, Mutex},
+    time::{Duration, SystemTime, UNIX_EPOCH},
+};
+
+use serde_json::Value;
+use shadowsocks_audit_protocol as wire;
+use thiserror::Error;
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    net::{UnixListener, UnixStream},
+    sync::{Semaphore, watch},
+    task::JoinSet,
+    time,
+};
+
+use crate::{
+    config::{AuditdConfig, MAX_DEDUP_ENTRIES, MAX_FRAME_BYTES, MAX_INGEST_CONNECTIONS, SocketRole},
+    protocol,
+    spool::{EventAck, Spool, SpoolError},
+};
+
+const IO_DEADLINE: Duration = Duration::from_secs(2);
+
+#[derive(Debug, Error)]
+pub enum IngestError {
+    #[error("ingest socket I/O failed: {0}")]
+    Io(#[from] io::Error),
+    #[error("ingest protocol error: {0}")]
+    Protocol(String),
+    #[error("spool error: {0}")]
+    Spool(#[from] SpoolError),
+}
+
+#[derive(Clone)]
+struct ProducerState {
+    active: Arc<std::sync::atomic::AtomicBool>,
+    dedup: Arc<Mutex<DedupCache>>,
+}
+
+/// Owns the single completed producer hello.  The guard makes every return
+/// path (including protocol/serialization errors) release the slot so a new
+/// runtime is not permanently locked out after a failed connection.
+struct ProducerLease {
+    active: Arc<std::sync::atomic::AtomicBool>,
+    spool: Arc<Spool>,
+}
+
+/// Bind the cleanup operation to the exact inode created by this listener.
+/// A pathname-only unlink at shutdown could otherwise remove a replacement
+/// socket created by another process after this listener was bound.
+struct SocketPathGuard {
+    path: PathBuf,
+    device: u64,
+    inode: u64,
+}
+
+impl Drop for SocketPathGuard {
+    fn drop(&mut self) {
+        let Ok(metadata) = fs::symlink_metadata(&self.path) else {
+            return;
+        };
+        if metadata.file_type().is_socket() && metadata.dev() == self.device && metadata.ino() == self.inode {
+            let _ = fs::remove_file(&self.path);
+            if let Some(parent) = self.path.parent() {
+                let _ = fs::File::open(parent).and_then(|file| file.sync_all());
+            }
+        }
+    }
+}
+
+impl ProducerLease {
+    fn new(producer: &ProducerState, spool: Arc<Spool>) -> Self {
+        Self {
+            active: producer.active.clone(),
+            spool,
+        }
+    }
+}
+
+impl Drop for ProducerLease {
+    fn drop(&mut self) {
+        // Clear health state while the slot is still held.  Releasing the
+        // atomic first would let a new hello race in and then be overwritten
+        // by this connection's final `connected = false` update.
+        self.spool.set_producer_state(false, None, None);
+        self.active.store(false, std::sync::atomic::Ordering::Release);
+    }
+}
+
+struct DedupCache {
+    entries: HashMap<String, (String, EventAck)>,
+    order: VecDeque<String>,
+}
+
+enum DedupLookup {
+    Same(EventAck),
+    Conflict,
+    Missing,
+}
+
+impl DedupCache {
+    fn new() -> Self {
+        Self {
+            entries: HashMap::new(),
+            order: VecDeque::new(),
+        }
+    }
+
+    fn get(&mut self, event_id: &str, digest: &str) -> DedupLookup {
+        let result = match self.entries.get(event_id) {
+            Some((known, ack)) if known == digest => DedupLookup::Same(ack.clone()),
+            Some(_) => DedupLookup::Conflict,
+            None => DedupLookup::Missing,
+        };
+        // This is an LRU, not a FIFO.  A replayed event remains hot for the
+        // lifetime of the daemon, while a quiet event eventually ages out.
+        if !matches!(result, DedupLookup::Missing)
+            && let Some(position) = self.order.iter().position(|value| value == event_id)
+            && let Some(value) = self.order.remove(position)
+        {
+            self.order.push_back(value);
+        }
+        result
+    }
+
+    fn insert(&mut self, event_id: String, digest: String, ack: EventAck) {
+        if let Some(position) = self.order.iter().position(|value| value == &event_id) {
+            let _ = self.order.remove(position);
+        }
+        self.order.push_back(event_id.clone());
+        self.entries.insert(event_id, (digest, ack));
+        while self.order.len() > MAX_DEDUP_ENTRIES {
+            let Some(old) = self.order.pop_front() else { break };
+            self.entries.remove(&old);
+        }
+    }
+}
+
+pub struct IngestServer {
+    config: Arc<AuditdConfig>,
+    spool: Arc<Spool>,
+    shutdown: watch::Receiver<bool>,
+    producer: ProducerState,
+    producer_uid: u32,
+}
+
+impl IngestServer {
+    pub async fn new(
+        config: Arc<AuditdConfig>,
+        spool: Arc<Spool>,
+        shutdown: watch::Receiver<bool>,
+    ) -> Result<Self, IngestError> {
+        config
+            .validate()
+            .map_err(|error| IngestError::Protocol(error.to_string()))?;
+        let producer_uid = config
+            .producer_uid()
+            .map_err(|error| IngestError::Protocol(error.to_string()))?;
+        crate::config::prepare_socket_path_for(&config.ingest_socket_path, SocketRole::Ingest)?;
+        Ok(Self {
+            config,
+            spool,
+            shutdown,
+            producer: ProducerState {
+                active: Arc::new(std::sync::atomic::AtomicBool::new(false)),
+                dedup: Arc::new(Mutex::new(DedupCache::new())),
+            },
+            producer_uid,
+        })
+    }
+
+    pub async fn run(self) -> Result<(), IngestError> {
+        let listener = UnixListener::bind(&self.config.ingest_socket_path)?;
+        let metadata = fs::symlink_metadata(&self.config.ingest_socket_path)?;
+        let socket_path_guard = SocketPathGuard {
+            path: self.config.ingest_socket_path.clone(),
+            device: metadata.dev(),
+            inode: metadata.ino(),
+        };
+        crate::config::secure_bound_socket_for(&self.config.ingest_socket_path, SocketRole::Ingest)?;
+        crate::config::validate_bound_socket_for(&self.config.ingest_socket_path, SocketRole::Ingest)?;
+        let semaphore = Arc::new(Semaphore::new(MAX_INGEST_CONNECTIONS));
+        let mut tasks = JoinSet::new();
+        let mut shutdown = self.shutdown;
+        let loop_result = loop {
+            tokio::select! {
+                // Reap completed connection tasks during normal operation as
+                // well as at shutdown.  Without this branch JoinSet retains
+                // every finished `Result`, so a producer reconnect/churn
+                // pattern would grow the task result list without bound even
+                // though the semaphore limits concurrently active sockets.
+                joined = tasks.join_next(), if !tasks.is_empty() => {
+                    let _ = joined;
+                }
+                changed = shutdown.changed() => {
+                    if changed.is_err() || *shutdown.borrow() { break Ok(()); }
+                }
+                accepted = listener.accept() => {
+                    let (stream, _) = match accepted {
+                        Ok(value) => value,
+                        Err(error) => break Err(IngestError::Io(error)),
+                    };
+                    let permit = match semaphore.clone().try_acquire_owned() {
+                        Ok(value) => value,
+                        Err(_) => { drop(stream); continue; }
+                    };
+                    let config = self.config.clone();
+                    let spool = self.spool.clone();
+                    let producer = self.producer.clone();
+                    let producer_uid = self.producer_uid;
+                    tasks.spawn(async move {
+                        let _permit = permit;
+                        let _ = handle_connection(stream, config, spool, producer, producer_uid).await;
+                    });
+                }
+            }
+        };
+        // A producer is allowed to remain idle indefinitely at a frame
+        // boundary.  Once the listener receives shutdown, waiting for those
+        // tasks naturally would therefore prevent auditd from ever exiting.
+        // Abort and join every connection before removing the socket so no
+        // task can continue touching spool state after shutdown returns.
+        tasks.abort_all();
+        while tasks.join_next().await.is_some() {}
+        // Close the listener before dropping the inode guard.  The guard only
+        // unlinks the exact inode captured after bind, so a replacement path
+        // is left untouched even if an external process raced with shutdown.
+        drop(listener);
+        drop(socket_path_guard);
+        self.spool.set_producer_state(false, None, None);
+        loop_result
+    }
+}
+
+async fn handle_connection(
+    mut stream: UnixStream,
+    config: Arc<AuditdConfig>,
+    spool: Arc<Spool>,
+    producer: ProducerState,
+    expected_uid: u32,
+) -> Result<(), IngestError> {
+    // Read and validate the hello before applying the peer-UID result.  A
+    // complete, otherwise-valid hello from the wrong local account receives
+    // the specified `unauthorized_peer` NACK; malformed frames are still
+    // closed without a response.
+    let peer = peer_uid(&stream)?;
+    let hello_frame = time::timeout(IO_DEADLINE, read_frame_initial(&mut stream))
+        .await
+        .map_err(|_| IngestError::Protocol("hello timeout".to_owned()))??;
+    let hello = match parse_hello(&hello_frame) {
+        Ok(value) => value,
+        Err(code) => {
+            // A complete JSON hello with a known shape may receive a NACK;
+            // malformed framing/JSON is simply closed per the wire contract.
+            if let Some(code) = code {
+                let _ = write_frame(&mut stream, &hello_nack(code)).await;
+            }
+            return Ok(());
+        }
+    };
+    if peer != expected_uid {
+        let _ = write_frame(&mut stream, &hello_nack(wire::HelloErrorCode::UnauthorizedPeer)).await;
+        return Ok(());
+    }
+    if hello.node_id != config.node_id {
+        let _ = write_frame(&mut stream, &hello_nack(wire::HelloErrorCode::NodeMismatch)).await;
+        return Ok(());
+    }
+    if producer
+        .active
+        .compare_exchange(
+            false,
+            true,
+            std::sync::atomic::Ordering::AcqRel,
+            std::sync::atomic::Ordering::Acquire,
+        )
+        .is_err()
+    {
+        let _ = write_frame(&mut stream, &hello_nack(wire::HelloErrorCode::ProducerBusy)).await;
+        return Ok(());
+    }
+    let _producer_lease = ProducerLease::new(&producer, spool.clone());
+    spool.set_producer_state(true, Some(hello.runtime_id.clone()), unix_millis());
+    let ack =
+        wire::serialize_canonical(&wire::HelloAck::new()).map_err(|error| IngestError::Protocol(error.to_string()))?;
+    if write_frame(&mut stream, &ack).await.is_err() {
+        // Let `ProducerLease` release the slot.  Keeping all cleanup in the
+        // guard preserves the ordering of health-state reset before the slot
+        // becomes available to a replacement producer.
+        return Ok(());
+    }
+
+    loop {
+        let frame = match read_frame_boundary(&mut stream).await {
+            Ok(Some(value)) => value,
+            Ok(None) | Err(_) => break,
+        };
+        let info = match protocol::parse_event(&frame) {
+            Ok(value) => value,
+            Err(_) => {
+                let event_id = extract_event_id(&frame);
+                let Some(event_id) = event_id else { break };
+                let nack = wire::EventNack::new(event_id, wire::EventNackCode::InvalidSchema);
+                if write_frame(&mut stream, &serialize_wire(&nack)?).await.is_err() {
+                    break;
+                }
+                continue;
+            }
+        };
+        if info.node_id != hello.node_id || info.runtime_id != hello.runtime_id {
+            let nack = wire::EventNack::new(info.event_id, wire::EventNackCode::RuntimeMismatch);
+            let _ = write_frame(&mut stream, &serialize_wire(&nack)?).await;
+            break;
+        }
+        let digest = wire::sha256_hex(&frame);
+        let lookup = {
+            let mut cache = match producer.dedup.lock() {
+                Ok(value) => value,
+                Err(poisoned) => poisoned.into_inner(),
+            };
+            cache.get(&info.event_id, &digest)
+        };
+        match lookup {
+            DedupLookup::Same(value) => {
+                if write_frame(&mut stream, &serialize_event_ack(&value)?).await.is_err() {
+                    break;
+                }
+                continue;
+            }
+            DedupLookup::Conflict => {
+                let nack = wire::EventNack::new(info.event_id, wire::EventNackCode::EventIdConflict);
+                let _ = write_frame(&mut stream, &serialize_wire(&nack)?).await;
+                break;
+            }
+            DedupLookup::Missing => {}
+        }
+        let received_at_unix_ms = match unix_millis() {
+            Some(value) => value,
+            None => {
+                // A spool record requires a real node wall-clock value.  Do
+                // not encode a synthetic zero when the clock is before the
+                // Unix epoch or the millisecond conversion overflows; the
+                // producer keeps the in-flight event and retries later.
+                let nack = wire::EventNack::new(info.event_id, wire::EventNackCode::StorageUnavailable);
+                let _ = write_frame(&mut stream, &serialize_wire(&nack)?).await;
+                break;
+            }
+        };
+        let stored = match spool.append(&frame, received_at_unix_ms) {
+            Ok(value) => value,
+            Err(SpoolError::StorageUnavailable) => {
+                let nack = wire::EventNack::new(info.event_id, wire::EventNackCode::StorageUnavailable);
+                let _ = write_frame(&mut stream, &serialize_wire(&nack)?).await;
+                break;
+            }
+            Err(SpoolError::SequenceExhausted) => {
+                let nack = wire::EventNack::new(info.event_id, wire::EventNackCode::InternalError);
+                let _ = write_frame(&mut stream, &serialize_wire(&nack)?).await;
+                break;
+            }
+            // `parse_event` above has already established the producer event
+            // schema.  Any protocol/JSON/state error from append therefore
+            // indicates an auditd-side inconsistency, not a permanent event
+            // defect.  Keep the producer bytes retryable and reconnect rather
+            // than acknowledging a false permanent NACK.
+            Err(SpoolError::Protocol(_) | SpoolError::Json(_) | SpoolError::InvalidState(_)) => {
+                let nack = wire::EventNack::new(info.event_id, wire::EventNackCode::InternalError);
+                let _ = write_frame(&mut stream, &serialize_wire(&nack)?).await;
+                break;
+            }
+            Err(SpoolError::Io(error)) => return Err(error.into()),
+            Err(SpoolError::UnknownBatch | SpoolError::BatchEvicted | SpoolError::DigestMismatch) => {
+                let nack = wire::EventNack::new(info.event_id, wire::EventNackCode::InternalError);
+                let _ = write_frame(&mut stream, &serialize_wire(&nack)?).await;
+                break;
+            }
+        };
+        {
+            let mut cache = match producer.dedup.lock() {
+                Ok(value) => value,
+                Err(poisoned) => poisoned.into_inner(),
+            };
+            cache.insert(info.event_id.clone(), digest, stored.clone());
+        }
+        if write_frame(&mut stream, &serialize_event_ack(&stored)?).await.is_err() {
+            break;
+        }
+        spool.set_producer_state(true, Some(hello.runtime_id.clone()), unix_millis());
+    }
+    Ok(())
+}
+
+fn serialize_wire<T: serde::Serialize>(value: &T) -> Result<Vec<u8>, IngestError> {
+    wire::serialize_canonical(value).map_err(|error| IngestError::Protocol(error.to_string()))
+}
+
+fn serialize_event_ack(ack: &EventAck) -> Result<Vec<u8>, IngestError> {
+    serialize_wire(&wire::EventAck::new(
+        &ack.event_id,
+        &ack.spool_epoch,
+        ack.spool_sequence,
+    ))
+}
+
+fn parse_hello(raw: &[u8]) -> Result<wire::Hello, Option<wire::HelloErrorCode>> {
+    // First establish that this is one complete JSON object.  A framing or
+    // parser failure is silently closed; once an object has parsed, all shape
+    // and field failures are represented by the protocol's invalid_hello NACK.
+    let object = match wire::parse_json_exact::<Value>(raw) {
+        Ok(Value::Object(object)) => object,
+        Ok(_) | Err(_) => return Err(None),
+    };
+    const HELLO_KEYS: &[&str] = &["protocol_version", "frame_type", "node_id", "runtime_id"];
+    if object.len() != HELLO_KEYS.len() || HELLO_KEYS.iter().any(|key| !object.contains_key(*key)) {
+        return Err(Some(wire::HelloErrorCode::InvalidHello));
+    }
+    let version = object.get("protocol_version").and_then(Value::as_u64);
+    let frame_type = object.get("frame_type").and_then(Value::as_str);
+    let node_id = object.get("node_id").and_then(Value::as_str);
+    let runtime_id = object.get("runtime_id").and_then(Value::as_str);
+    if version.is_none() || frame_type.is_none() || node_id.is_none() || runtime_id.is_none() {
+        return Err(Some(wire::HelloErrorCode::InvalidHello));
+    }
+    if frame_type != Some("hello")
+        || node_id.is_none_or(|value| wire::validate_identifier(value, "node_id").is_err())
+        || runtime_id.is_none_or(|value| wire::validate_lower_hex(value, 16, "runtime_id").is_err())
+    {
+        return Err(Some(wire::HelloErrorCode::InvalidHello));
+    }
+    if version != Some(wire::PROTOCOL_VERSION as u64) {
+        return Err(Some(wire::HelloErrorCode::UnsupportedVersion));
+    }
+    let (Some(version), Some(node_id), Some(runtime_id)) = (version, node_id, runtime_id) else {
+        // Keep this branch defensive if the extraction above changes.  A
+        // malformed hello is closed without a NACK, and never panics.
+        return Err(None);
+    };
+    let Ok(protocol_version) = u8::try_from(version) else {
+        return Err(None);
+    };
+    let hello = wire::Hello {
+        protocol_version,
+        frame_type: wire::FrameType::Hello,
+        node_id: node_id.to_owned(),
+        runtime_id: runtime_id.to_owned(),
+    };
+    if hello.validate().is_err() {
+        return Err(Some(wire::HelloErrorCode::InvalidHello));
+    }
+    match wire::serialize_canonical(&hello) {
+        Ok(canonical) if canonical == raw => Ok(hello),
+        Ok(_) | Err(_) => Err(Some(wire::HelloErrorCode::InvalidHello)),
+    }
+}
+
+fn hello_nack(code: wire::HelloErrorCode) -> Vec<u8> {
+    let value = wire::HelloNack::new(code);
+    wire::serialize_canonical(&value).unwrap_or_else(|_| b"{}".to_vec())
+}
+
+fn extract_event_id(raw: &[u8]) -> Option<String> {
+    let value = wire::parse_json_exact::<Value>(raw).ok()?;
+    let event_id = value.get("event_id")?.as_str()?.to_owned();
+    // Only return an ID that is syntactically safe to echo in an event NACK.
+    let (runtime, sequence) = event_id.split_once(':')?;
+    if wire::validate_lower_hex(runtime, 16, "event_id.runtime_id").is_err()
+        || wire::parse_positive_decimal_u64(sequence).is_err()
+        || event_id.len() > 64
+    {
+        return None;
+    }
+    Some(event_id)
+}
+
+async fn read_frame_initial(stream: &mut UnixStream) -> Result<Vec<u8>, IngestError> {
+    time::timeout(IO_DEADLINE, async {
+        let mut header = [0_u8; 4];
+        stream.read_exact(&mut header).await?;
+        read_frame_payload(stream, header).await
+    })
+    .await
+    .map_err(|_| IngestError::Protocol("hello timeout".to_owned()))?
+}
+
+async fn read_frame_boundary(stream: &mut UnixStream) -> Result<Option<Vec<u8>>, IngestError> {
+    let mut first = [0_u8; 1];
+    let count = stream.read(&mut first).await?;
+    if count == 0 {
+        return Ok(None);
+    }
+    let mut header = [0_u8; 4];
+    header[0] = first[0];
+    let payload = time::timeout(IO_DEADLINE, async {
+        stream.read_exact(&mut header[1..]).await?;
+        read_frame_payload(stream, header).await
+    })
+    .await
+    .map_err(|_| IngestError::Protocol("partial frame timeout".to_owned()))??;
+    Ok(Some(payload))
+}
+
+async fn read_frame_payload(stream: &mut UnixStream, header: [u8; 4]) -> Result<Vec<u8>, IngestError> {
+    let length = u32::from_be_bytes(header) as usize;
+    if length == 0 || length > MAX_FRAME_BYTES {
+        return Err(IngestError::Protocol("invalid frame length".to_owned()));
+    }
+    let mut payload = vec![0_u8; length];
+    stream.read_exact(&mut payload).await?;
+    Ok(payload)
+}
+
+async fn write_frame(stream: &mut UnixStream, payload: &[u8]) -> Result<(), IngestError> {
+    if payload.is_empty() || payload.len() > MAX_FRAME_BYTES {
+        return Err(IngestError::Protocol("response too large".to_owned()));
+    }
+    let length = u32::try_from(payload.len()).map_err(|_| IngestError::Protocol("response too large".to_owned()))?;
+    let mut frame = Vec::with_capacity(4 + payload.len());
+    frame.extend_from_slice(&length.to_be_bytes());
+    frame.extend_from_slice(payload);
+    time::timeout(IO_DEADLINE, stream.write_all(&frame))
+        .await
+        .map_err(|_| IngestError::Protocol("response timeout".to_owned()))??;
+    Ok(())
+}
+
+fn peer_uid(stream: &UnixStream) -> io::Result<u32> {
+    let fd = stream.as_raw_fd();
+    let mut credential = libc::ucred { pid: 0, uid: 0, gid: 0 };
+    let mut length = std::mem::size_of::<libc::ucred>() as libc::socklen_t;
+    // SAFETY: pointers refer to writable local storage of the documented size.
+    let result = unsafe {
+        libc::getsockopt(
+            fd,
+            libc::SOL_SOCKET,
+            libc::SO_PEERCRED,
+            (&mut credential as *mut libc::ucred).cast(),
+            &mut length,
+        )
+    };
+    if result != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if usize::try_from(length).ok() != Some(std::mem::size_of::<libc::ucred>()) {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "SO_PEERCRED returned an unexpected credential size",
+        ));
+    }
+    Ok(credential.uid)
+}
+
+fn unix_millis() -> Option<u64> {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .ok()
+        .and_then(|value| value.as_millis().try_into().ok())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn dedup_cache_distinguishes_payload_conflicts() {
+        let mut cache = DedupCache::new();
+        let ack = EventAck {
+            event_id: "id".to_owned(),
+            spool_epoch: "0".repeat(32),
+            spool_sequence: 1,
+        };
+        cache.insert("id".to_owned(), "a".to_owned(), ack.clone());
+        assert!(matches!(cache.get("id", "a"), DedupLookup::Same(_)));
+        assert!(matches!(cache.get("id", "b"), DedupLookup::Conflict));
+    }
+}
