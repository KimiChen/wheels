+async fn wait_first_children(tasks: &mut Vec<ServerHandle>) -> io::Result<()> {
+    future::poll_fn(|cx| {
+        for index in 0..tasks.len() {
+            let result = {
+                let task = &mut tasks[index];
+                Pin::new(task).poll(cx)
+            };
+            if let Poll::Ready(result) = result {
+                // The first Ready poll consumes the JoinHandle output. Remove
+                // it before cleanup joins the remaining children.
+                tasks.swap_remove(index);
+                return Poll::Ready(result);
+            }
         }
+        Poll::Pending
+    })
