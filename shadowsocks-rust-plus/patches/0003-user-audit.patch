@@ -0,0 +1,9515 @@
+//! Durable, node-local audit spool.
+//!
+//! The spool is deliberately synchronous.  Ingest and export perform their
+//! small file operations behind this mutex, which gives the durability barrier
+//! a single ordering and keeps ACK/lease state deterministic.
+
+use std::{
+    collections::{HashMap, HashSet, VecDeque},
+    ffi::CString,
+    fs::{self, File, OpenOptions},
+    io::{self, Read, Write},
+    os::{
+        fd::{AsRawFd, FromRawFd, OwnedFd},
+        unix::{
+            ffi::OsStrExt,
+            fs::{MetadataExt, OpenOptionsExt, PermissionsExt},
+        },
+    },
+    path::{Path, PathBuf},
+    sync::{Arc, Mutex, MutexGuard},
+    time::{Duration, Instant, SystemTime, UNIX_EPOCH},
+};
+
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use shadowsocks_audit_protocol as wire;
+use thiserror::Error;
+use tokio::sync::watch;
+
+use crate::{
+    config::{ACKED_RETENTION_SECONDS, AuditdConfig, DEFAULT_EXPORT_MAX_RESPONSE_BYTES, MAX_TOMBSTONES},
+    protocol::{self, ProtocolError},
+};
+
+const STATE_SCHEMA_VERSION: u8 = 1;
+const GAP_ID_PREFIX: &str = "spool:";
+const PRODUCER_DISCONNECT_GRACE: Duration = Duration::from_secs(5);
+const RETENTION_SWEEP_INTERVAL: Duration = Duration::from_secs(60);
+const INDEX_REBUILD_RETRY_INTERVAL: Duration = Duration::from_secs(60);
+const MAX_CLEANUP_ITERATIONS: usize = MAX_TOMBSTONES;
+const RECOVERY_GAP_MARKER_PREFIX: &str = ".recovery-gap-";
+const ORPHAN_OPEN_SOURCE_PREFIX: &str = "orphan-open:";
+// Recovery gaps derived from a damaged spool object are bound to that exact
+// object.  Without such a binding two independent damaged objects whose
+// metadata is unreadable both produce an all-null gap and collapse into a
+// single event ID, hiding every loss but the first.
+const RECOVERY_SOURCE_PREFIX: &str = "recovery-source:";
+// Pending eviction/quarantine transactions get their own private marker in
+// addition to the aggregate tombstone ledger.  The ledger is intentionally a
+// compact, replace-in-place document; a crash while replacing it must not be
+// able to erase the one piece of information needed to finish a destructive
+// operation (the fixed gap ID and its receipt fields).
+const TOMBSTONE_PENDING_MARKER_SCHEMA: u8 = 1;
+const TOMBSTONE_PENDING_MARKER_PREFIX: &str = ".tombstone-pending-";
+// A segment is configured at most 4 MiB and the export contract permits up to
+// 8 MiB for a legacy segment that was written before the current limits were
+// applied.  Never let recovery turn an attacker-controlled regular file into
+// an unbounded allocation.  Files larger than this are treated as corrupt and
+// quarantined by the caller.
+const MAX_SPOOL_FILE_BYTES: usize = DEFAULT_EXPORT_MAX_RESPONSE_BYTES as usize;
+
+#[derive(Debug, Error)]
+pub enum SpoolError {
+    #[error("spool I/O failed: {0}")]
+    Io(#[from] io::Error),
+    #[error("spool JSON failed: {0}")]
+    Json(#[from] serde_json::Error),
+    #[error("spool protocol error: {0}")]
+    Protocol(#[from] ProtocolError),
+    #[error("spool is temporarily unavailable")]
+    StorageUnavailable,
+    #[error("spool durability is uncertain; daemon restart is required")]
+    DurabilityUncertain,
+    #[error("spool sequence exhausted")]
+    SequenceExhausted,
+    #[error("batch body digest mismatch")]
+    DigestMismatch,
+    #[error("unknown batch")]
+    UnknownBatch,
+    #[error("batch was evicted")]
+    BatchEvicted,
+    #[error("invalid spool state: {0}")]
+    InvalidState(String),
+}
+
+type PendingStateReset = wire::StateReset;
+type TombstoneEntry = wire::TombstoneEntry;
+
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub struct EventAck {
+    pub event_id: String,
+    pub spool_epoch: String,
+    pub spool_sequence: u64,
+}
+
+#[derive(Debug, Clone)]
+pub struct BatchInfo {
+    pub node_id: String,
+    pub spool_epoch: String,
+    pub batch_id: String,
+    pub first_spool_sequence: u64,
+    pub last_spool_sequence: u64,
+    pub event_count: u64,
+    pub raw_bytes: u64,
+    pub body_sha256: String,
+    pub first_received_at_unix_ms: u64,
+    pub last_received_at_unix_ms: u64,
+    pub path: PathBuf,
+}
+
+#[derive(Debug, Clone)]
+pub struct BatchLease {
+    pub info: BatchInfo,
+    pub body: Vec<u8>,
+}
+
+#[derive(Debug, Clone, Copy, Eq, PartialEq)]
+pub enum AckOutcome {
+    Acked,
+    Unknown,
+    Evicted,
+    DigestMismatch,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct HealthSnapshot {
+    pub schema_version: u32,
+    pub node_id: String,
+    pub status: String,
+    pub producer_connected: bool,
+    pub producer_runtime_id: Option<String>,
+    pub last_ingest_at_unix_ms: Option<u64>,
+    pub spool_epoch: String,
+    pub spool_bytes: u64,
+    pub max_spool_bytes: u64,
+    pub sealed_batches: u64,
+    pub oldest_unacked_at_unix_ms: Option<u64>,
+    pub stored_records: u64,
+    pub storage_rejected_attempts: u64,
+    pub evicted_unacked_records: u64,
+}
+
+#[derive(Debug, Clone)]
+struct OpenMetadata {
+    bytes: u64,
+    first_sequence: Option<u64>,
+    last_sequence: Option<u64>,
+    event_count: u64,
+    first_received_at: Option<u64>,
+    last_received_at: Option<u64>,
+    opened_at: SystemTime,
+    contains_spool_gap: bool,
+}
+
+impl OpenMetadata {
+    fn empty() -> Self {
+        Self {
+            bytes: 0,
+            first_sequence: None,
+            last_sequence: None,
+            event_count: 0,
+            first_received_at: None,
+            last_received_at: None,
+            opened_at: SystemTime::now(),
+            contains_spool_gap: false,
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+struct GapSpec {
+    event_id: String,
+    occurred_at_unix_ms: u64,
+    lost_spool_epoch: Option<String>,
+    reason: wire::SpoolGapReason,
+    first_lost_spool_sequence: Option<u64>,
+    last_lost_spool_sequence: Option<u64>,
+    lost_events: Option<u64>,
+    lost_bytes: Option<u64>,
+    lost_batch_id: Option<String>,
+    // Private recovery identity. This is persisted only in the marker and is
+    // deliberately omitted from the exported spool_gap schema.
+    source_fingerprint: Option<String>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct TombstonePendingMarker {
+    marker_schema_version: u8,
+    entry: TombstoneEntry,
+}
+
+impl TombstonePendingMarker {
+    fn new(entry: TombstoneEntry) -> Result<Self, SpoolError> {
+        if !entry.is_pending() {
+            return Err(SpoolError::InvalidState(
+                "tombstone pending marker requires a pending entry".to_owned(),
+            ));
+        }
+        entry
+            .validate()
+            .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+        Ok(Self {
+            marker_schema_version: TOMBSTONE_PENDING_MARKER_SCHEMA,
+            entry,
+        })
+    }
+
+    fn into_entry(self) -> Result<TombstoneEntry, SpoolError> {
+        if self.marker_schema_version != TOMBSTONE_PENDING_MARKER_SCHEMA {
+            return Err(SpoolError::InvalidState(
+                "unsupported tombstone pending marker schema".to_owned(),
+            ));
+        }
+        if !self.entry.is_pending() {
+            return Err(SpoolError::InvalidState(
+                "tombstone pending marker contains a non-pending entry".to_owned(),
+            ));
+        }
+        self.entry
+            .validate()
+            .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+        Ok(self.entry)
+    }
+}
+
+/// Build the on-disk marker for a recovery intent.  The schema itself lives
+/// in the protocol crate so both stacks agree on the exact bytes.
+fn recovery_gap_marker_from_spec(spec: &GapSpec) -> wire::RecoveryGapMarker {
+    wire::RecoveryGapMarker {
+        marker_schema_version: wire::RECOVERY_GAP_MARKER_SCHEMA,
+        event_id: spec.event_id.clone(),
+        occurred_at_unix_ms: spec.occurred_at_unix_ms,
+        lost_spool_epoch: spec.lost_spool_epoch.clone(),
+        reason: spec.reason,
+        first_lost_spool_sequence: spec.first_lost_spool_sequence,
+        last_lost_spool_sequence: spec.last_lost_spool_sequence,
+        lost_events: spec.lost_events,
+        lost_bytes: spec.lost_bytes,
+        lost_batch_id: spec.lost_batch_id.clone(),
+        source_fingerprint: spec.source_fingerprint.clone(),
+    }
+}
+
+/// Convert a parsed marker back into a recovery intent.  Schema acceptance is
+/// the protocol crate's rule; the identity and payload rules stay here because
+/// they guard this daemon's cursor.
+fn recovery_gap_spec_from_marker(marker: wire::RecoveryGapMarker) -> Result<GapSpec, SpoolError> {
+    if !marker.schema_is_supported() {
+        return Err(SpoolError::InvalidState(
+            "unsupported recovery gap marker schema".to_owned(),
+        ));
+    }
+    validate_gap_identity(
+        &marker.event_id,
+        marker.lost_spool_epoch.as_deref(),
+        marker.first_lost_spool_sequence,
+        marker.last_lost_spool_sequence,
+        marker.lost_events,
+        marker.lost_bytes,
+        marker.lost_batch_id.as_deref(),
+    )?;
+    let spec = GapSpec {
+        event_id: marker.event_id,
+        occurred_at_unix_ms: marker.occurred_at_unix_ms,
+        lost_spool_epoch: marker.lost_spool_epoch,
+        reason: marker.reason,
+        first_lost_spool_sequence: marker.first_lost_spool_sequence,
+        last_lost_spool_sequence: marker.last_lost_spool_sequence,
+        lost_events: marker.lost_events,
+        lost_bytes: marker.lost_bytes,
+        lost_batch_id: marker.lost_batch_id,
+        source_fingerprint: marker.source_fingerprint,
+    };
+    validate_gap_spec(&spec)?;
+    Ok(spec)
+}
+
+/// Validate the identity-bearing fields copied into a recovery marker before
+/// it is allowed to influence the spool cursor.  Markers are private files,
+/// but they are still crash-recovery input and must not be able to introduce
+/// path traversal, sequence wraparound, or malformed wire gap records.
+fn validate_gap_identity(
+    event_id: &str,
+    lost_spool_epoch: Option<&str>,
+    first_lost_spool_sequence: Option<u64>,
+    last_lost_spool_sequence: Option<u64>,
+    lost_events: Option<u64>,
+    lost_bytes: Option<u64>,
+    lost_batch_id: Option<&str>,
+) -> Result<(), SpoolError> {
+    let valid_gap_id = event_id
+        .strip_prefix(GAP_ID_PREFIX)
+        .is_some_and(|suffix| is_hex(suffix, 32));
+    if !valid_gap_id {
+        return Err(SpoolError::InvalidState(
+            "recovery gap event_id must be spool:<32 lowercase hex>".to_owned(),
+        ));
+    }
+    if lost_spool_epoch.is_some_and(|value| !is_hex(value, 32)) {
+        return Err(SpoolError::InvalidState(
+            "recovery gap lost_spool_epoch is not a valid epoch".to_owned(),
+        ));
+    }
+    if lost_batch_id.is_some_and(|value| !is_hex(value, 32)) {
+        return Err(SpoolError::InvalidState(
+            "recovery gap lost_batch_id is not a valid batch ID".to_owned(),
+        ));
+    }
+    if first_lost_spool_sequence.is_some() != last_lost_spool_sequence.is_some() {
+        return Err(SpoolError::InvalidState(
+            "recovery gap sequence bounds must be paired".to_owned(),
+        ));
+    }
+    if let (Some(first), Some(last)) = (first_lost_spool_sequence, last_lost_spool_sequence)
+        && (first == 0 || last == 0 || first > last)
+    {
+        return Err(SpoolError::InvalidState(
+            "recovery gap sequence bounds are invalid".to_owned(),
+        ));
+    }
+    if lost_events.is_some_and(|value| value == 0) {
+        return Err(SpoolError::InvalidState(
+            "recovery gap lost_events must be positive".to_owned(),
+        ));
+    }
+    if lost_bytes.is_some_and(|value| value == 0) {
+        return Err(SpoolError::InvalidState(
+            "recovery gap lost_bytes must be positive".to_owned(),
+        ));
+    }
+    Ok(())
+}
+
+fn validate_gap_spec(spec: &GapSpec) -> Result<(), SpoolError> {
+    validate_gap_identity(
+        &spec.event_id,
+        spec.lost_spool_epoch.as_deref(),
+        spec.first_lost_spool_sequence,
+        spec.last_lost_spool_sequence,
+        spec.lost_events,
+        spec.lost_bytes,
+        spec.lost_batch_id.as_deref(),
+    )?;
+    if let Some(fingerprint) = spec.source_fingerprint.as_deref() {
+        let valid = fingerprint
+            .strip_prefix(ORPHAN_OPEN_SOURCE_PREFIX)
+            .or_else(|| fingerprint.strip_prefix(RECOVERY_SOURCE_PREFIX))
+            .is_some_and(|suffix| is_hex(suffix, 64));
+        if !valid {
+            return Err(SpoolError::InvalidState(
+                "recovery gap source fingerprint is invalid".to_owned(),
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn recovery_gap_marker_path(root: &Path, event_id: &str) -> Result<PathBuf, SpoolError> {
+    validate_gap_identity(event_id, None, None, None, None, None, None)?;
+    let suffix = &event_id[GAP_ID_PREFIX.len()..];
+    Ok(root.join(format!("{RECOVERY_GAP_MARKER_PREFIX}{suffix}.json")))
+}
+
+fn tombstone_pending_marker_path(root: &Path, entry: &TombstoneEntry) -> Result<PathBuf, SpoolError> {
+    let event_id = entry
+        .gap_event_id()
+        .ok_or_else(|| SpoolError::InvalidState("pending tombstone has no gap_event_id".to_owned()))?;
+    validate_gap_identity(event_id, None, None, None, None, None, None)?;
+    let suffix = &event_id[GAP_ID_PREFIX.len()..];
+    Ok(root.join(format!("{TOMBSTONE_PENDING_MARKER_PREFIX}{suffix}.json")))
+}
+
+fn tombstone_pending_marker_path_for_id(root: &Path, event_id: &str) -> Result<PathBuf, SpoolError> {
+    validate_gap_identity(event_id, None, None, None, None, None, None)?;
+    let suffix = &event_id[GAP_ID_PREFIX.len()..];
+    Ok(root.join(format!("{TOMBSTONE_PENDING_MARKER_PREFIX}{suffix}.json")))
+}
+
+/// Persist a private copy of a pending destructive transaction.  This marker
+/// is written before the aggregate tombstone ledger and before any rename or
+/// removal.  It is deliberately idempotent so retries after a crash retain
+/// the original gap ID and receipt metadata.
+fn persist_tombstone_pending_marker(root: &Path, entry: &TombstoneEntry) -> Result<(), SpoolError> {
+    let marker = TombstonePendingMarker::new(entry.clone())?;
+    let path = tombstone_pending_marker_path(root, entry)?;
+    if fs::symlink_metadata(&path).is_ok() {
+        let bytes = read_regular_file(&path)?;
+        let existing = wire::parse_canonical::<TombstonePendingMarker>(&bytes)
+            .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?
+            .into_entry()?;
+        if existing == *entry {
+            return Ok(());
+        }
+        return Err(SpoolError::InvalidState(
+            "tombstone pending marker has a conflicting identity".to_owned(),
+        ));
+    }
+    let bytes = wire::serialize_canonical(&marker).map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+    write_atomic_file(&path, &bytes, 0o600)
+}
+
+fn remove_tombstone_pending_marker(root: &Path, event_id: &str) -> Result<bool, SpoolError> {
+    let path = tombstone_pending_marker_path_for_id(root, event_id)?;
+    let metadata = match fs::symlink_metadata(&path) {
+        Ok(value) => value,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(false),
+        Err(error) => return Err(error.into()),
+    };
+    if metadata.file_type().is_symlink() || !metadata.is_file() {
+        return Err(SpoolError::InvalidState(
+            "tombstone pending marker is not a regular file".to_owned(),
+        ));
+    }
+    fs::remove_file(&path)?;
+    sync_dir(root)?;
+    Ok(true)
+}
+
+fn load_tombstone_pending_markers(root: &Path) -> Result<(Vec<TombstoneEntry>, bool, u64), SpoolError> {
+    let mut paths = Vec::new();
+    let mut degraded = false;
+    let mut storage_rejected_attempts = 0_u64;
+    for entry in fs::read_dir(root)? {
+        let entry = match entry {
+            Ok(value) => value,
+            Err(_) => {
+                degraded = true;
+                storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+                continue;
+            }
+        };
+        let name = entry.file_name();
+        let name = name.to_string_lossy();
+        // Collect every entry using the marker prefix, including malformed
+        // extensions.  Filtering to `*.json` here would silently ignore a
+        // torn/renamed marker and leave its transaction unaccounted for.
+        if name.starts_with(TOMBSTONE_PENDING_MARKER_PREFIX) {
+            paths.push(entry.path());
+        }
+    }
+    paths.sort();
+    let mut entries = Vec::new();
+    for path in paths {
+        let valid_name = path
+            .file_name()
+            .and_then(|value| value.to_str())
+            .and_then(|name| name.strip_prefix(TOMBSTONE_PENDING_MARKER_PREFIX))
+            .and_then(|name| name.strip_suffix(".json"))
+            .is_some_and(|suffix| is_hex(suffix, 32));
+        if !valid_name {
+            degraded = true;
+            storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+            // A malformed private marker cannot describe a safe transaction.
+            // Keep it in place for operator recovery.  Moving/removing it here
+            // could erase the only durable proof when the aggregate ledger is
+            // torn at the same time.
+            continue;
+        }
+        let parsed = read_regular_file(&path).map_err(SpoolError::Io).and_then(|bytes| {
+            wire::parse_canonical::<TombstonePendingMarker>(&bytes)
+                .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?
+                .into_entry()
+        });
+        let event_id = path
+            .file_name()
+            .and_then(|value| value.to_str())
+            .and_then(|name| name.strip_prefix(TOMBSTONE_PENDING_MARKER_PREFIX))
+            .and_then(|name| name.strip_suffix(".json"))
+            .map(|suffix| format!("{GAP_ID_PREFIX}{suffix}"));
+        let entry = match parsed {
+            Ok(value) if value.gap_event_id() == event_id.as_deref() => value,
+            _ => {
+                degraded = true;
+                storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+                // Preserve the marker until a valid ledger/gap transaction can
+                // be reconstructed.  The normal reconcile path will retry
+                // the read and never perform a destructive operation based on
+                // this unknown entry.
+                continue;
+            }
+        };
+        if entries
+            .iter()
+            .any(|existing: &TombstoneEntry| existing.gap_event_id() == entry.gap_event_id())
+        {
+            degraded = true;
+            storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+            // Keep duplicate marker files on disk as evidence; only the first
+            // validated entry is admitted to the in-memory ledger.
+            continue;
+        }
+        entries.push(entry);
+    }
+    Ok((entries, degraded, storage_rejected_attempts))
+}
+
+/// Persist one recovery intent using the same fsync + atomic rename barrier as
+/// state/tombstone files.  Reusing an identical marker is idempotent; a
+/// conflicting marker with the same stable ID is treated as corruption.
+fn persist_recovery_gap_marker(root: &Path, spec: &GapSpec) -> Result<(), SpoolError> {
+    validate_gap_spec(spec)?;
+    let path = recovery_gap_marker_path(root, &spec.event_id)?;
+    if fs::symlink_metadata(&path).is_ok() {
+        let existing = read_regular_file(&path).map_err(SpoolError::Io).and_then(|bytes| {
+            let marker = wire::parse_canonical::<wire::RecoveryGapMarker>(&bytes)
+                .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+            recovery_gap_spec_from_marker(marker)
+        })?;
+        if existing.event_id == spec.event_id && existing.same_payload(spec) {
+            return Ok(());
+        }
+        return Err(SpoolError::InvalidState(
+            "recovery gap marker has a conflicting identity".to_owned(),
+        ));
+    }
+    let marker = recovery_gap_marker_from_spec(spec);
+    let bytes = wire::serialize_canonical(&marker).map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+    write_atomic_file(&path, &bytes, 0o600)
+}
+
+fn load_recovery_gap_marker(root: &Path, event_id: &str) -> Result<Option<GapSpec>, SpoolError> {
+    let path = recovery_gap_marker_path(root, event_id)?;
+    let bytes = match read_regular_file(&path) {
+        Ok(value) => value,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error.into()),
+    };
+    let marker = wire::parse_canonical::<wire::RecoveryGapMarker>(&bytes)
+        .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+    let spec = recovery_gap_spec_from_marker(marker)?;
+    if spec.event_id != event_id {
+        return Err(SpoolError::InvalidState(
+            "recovery gap marker filename does not match event_id".to_owned(),
+        ));
+    }
+    Ok(Some(spec))
+}
+
+impl GapSpec {
+    fn same_payload(&self, other: &Self) -> bool {
+        self.event_id == other.event_id
+            && self.occurred_at_unix_ms == other.occurred_at_unix_ms
+            && self.lost_spool_epoch == other.lost_spool_epoch
+            && self.reason == other.reason
+            && self.first_lost_spool_sequence == other.first_lost_spool_sequence
+            && self.last_lost_spool_sequence == other.last_lost_spool_sequence
+            && self.lost_events == other.lost_events
+            && self.lost_bytes == other.lost_bytes
+            && self.lost_batch_id == other.lost_batch_id
+            && self.source_fingerprint == other.source_fingerprint
+    }
+}
+
+fn remove_recovery_gap_marker(root: &Path, event_id: &str) -> Result<bool, SpoolError> {
+    let path = recovery_gap_marker_path(root, event_id)?;
+    let metadata = match fs::symlink_metadata(&path) {
+        Ok(value) => value,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(false),
+        Err(error) => return Err(error.into()),
+    };
+    if metadata.file_type().is_symlink() || !metadata.is_file() {
+        return Err(SpoolError::InvalidState(
+            "recovery gap marker is not a regular file".to_owned(),
+        ));
+    }
+    fs::remove_file(&path)?;
+    sync_dir(root)?;
+    Ok(true)
+}
+
+fn remove_recovery_gap_marker_locked(root: &Path, inner: &mut SpoolInner, event_id: &str) -> Result<(), SpoolError> {
+    let path = recovery_gap_marker_path(root, event_id)?;
+    // Do not unlink a marker when its size cannot be established.  The byte
+    // index is part of the capacity contract; treating an unreadable inode as
+    // zero would make a successful removal silently under-count the spool.
+    let before = match file_len(&path) {
+        Ok(value) => value,
+        Err(error) => {
+            inner.spool_bytes_known = false;
+            return Err(error.into());
+        }
+    };
+    #[cfg(test)]
+    if before != 0 && std::mem::take(&mut inner.faults.recovery_marker_remove_sync) {
+        fs::remove_file(&path)?;
+        inner.spool_bytes_known = false;
+        return Err(io::Error::other("injected recovery marker directory sync failure").into());
+    }
+    match remove_recovery_gap_marker(root, event_id) {
+        Ok(true) => Spool::adjust_spool_bytes(inner, -i128::from(before)),
+        Ok(false) => {}
+        Err(error) => {
+            // remove_file may already have succeeded before the parent fsync
+            // failed. Force a full measurement instead of permanently counting
+            // a marker pathname that is no longer present.
+            inner.spool_bytes_known = false;
+            return Err(error);
+        }
+    }
+    Ok(())
+}
+
+/// Load durable intents left by a crash.  A malformed marker with a valid
+/// filename is converted into a conservative, null-detail corruption gap so
+/// one bad private file cannot prevent the daemon from starting forever.
+fn load_recovery_gap_markers(root: &Path) -> Result<(VecDeque<GapSpec>, bool, u64), SpoolError> {
+    let mut paths = Vec::new();
+    let mut degraded = false;
+    let mut storage_rejected_attempts = 0_u64;
+    for entry in fs::read_dir(root)? {
+        // A directory iterator can yield an error after successfully
+        // returning earlier entries (for example when an entry is removed or
+        // permissions change concurrently).  Keep the scan bounded and make
+        // the uncertainty visible instead of silently dropping a marker.
+        let entry = match entry {
+            Ok(value) => value,
+            Err(_) => {
+                degraded = true;
+                storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+                continue;
+            }
+        };
+        let name = entry.file_name();
+        let name = name.to_string_lossy();
+        // As with pending tombstones, inspect every prefixed entry so a
+        // malformed filename contributes a bounded rejection count instead of
+        // disappearing from recovery input.
+        if name.starts_with(RECOVERY_GAP_MARKER_PREFIX) {
+            paths.push(entry.path());
+        }
+    }
+    paths.sort();
+
+    let mut seen = HashSet::new();
+    let mut result = VecDeque::new();
+    for path in paths {
+        let Some(event_id) = path
+            .file_name()
+            .and_then(|value| value.to_str())
+            .and_then(|name| name.strip_prefix(RECOVERY_GAP_MARKER_PREFIX))
+            .and_then(|name| name.strip_suffix(".json"))
+            .filter(|suffix| is_hex(suffix, 32))
+            .map(|suffix| format!("{GAP_ID_PREFIX}{suffix}"))
+        else {
+            degraded = true;
+            storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+            // There is no safe event ID to attach to a malformed filename.
+            // Retain the marker for operator recovery; removing it here would
+            // turn an unclassified durable intent into an unreported loss.
+            continue;
+        };
+
+        // O_NOFOLLOW intentionally rejects links.  Treat unreadable,
+        // malformed, and identity-mismatched markers as conservative
+        // corruption gaps, but leave the original inode in place until the
+        // corresponding gap is durable and the marker can be unlinked.
+        let parsed = read_regular_file(&path).map_err(SpoolError::Io).and_then(|bytes| {
+            let marker = wire::parse_canonical::<wire::RecoveryGapMarker>(&bytes)
+                .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+            recovery_gap_spec_from_marker(marker)
+        });
+        let spec = match parsed {
+            Ok(spec) if spec.event_id == event_id => spec,
+            Ok(_) | Err(_) => {
+                degraded = true;
+                storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+                GapSpec {
+                    event_id: event_id.clone(),
+                    occurred_at_unix_ms: unix_millis().unwrap_or(0),
+                    lost_spool_epoch: None,
+                    reason: wire::SpoolGapReason::SegmentCorruption,
+                    first_lost_spool_sequence: None,
+                    last_lost_spool_sequence: None,
+                    lost_events: None,
+                    lost_bytes: None,
+                    lost_batch_id: None,
+                    source_fingerprint: None,
+                }
+            }
+        };
+        if seen.insert(spec.event_id.clone()) {
+            result.push_back(spec);
+        } else {
+            degraded = true;
+            storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+        }
+    }
+    Ok((result, degraded, storage_rejected_attempts))
+}
+
+fn enqueue_recovery_gap(
+    root: &Path,
+    queue: &mut VecDeque<GapSpec>,
+    spec: GapSpec,
+    degraded: &mut bool,
+) -> Result<(), SpoolError> {
+    if let Err(error) = persist_recovery_gap_marker(root, &spec) {
+        // Never perform the corresponding destructive rename/truncation when
+        // the intent barrier did not reach stable storage.  Returning the
+        // error leaves the source object untouched so a later daemon start
+        // can retry without silently losing an unreported gap.
+        *degraded = true;
+        return Err(error);
+    }
+    if !queue.iter().any(|existing| existing.event_id == spec.event_id) {
+        queue.push_back(spec);
+    }
+    Ok(())
+}
+
+/// Attempt to isolate a recovery object without making an I/O failure
+/// disappear.  Recovery can continue with the source object in place (the
+/// durable gap/marker remains retryable), but the failure must keep health
+/// degraded and contribute to the bounded storage-rejection counter.
+/// Whether a `quarantine/` basename records an already-acknowledged source.
+///
+/// `quarantine_path` writes `{label}-{nanos}-{original}`, so the label survives
+/// restarts along with the object itself.
+fn quarantine_source_is_acked(basename: &str) -> bool {
+    basename.starts_with(&format!("{QUARANTINE_LABEL_ACKED}-"))
+}
+
+/// Resolve ACK provenance for a pending quarantine transaction.  Newer
+/// quarantine names carry the source label, while older names used
+/// `batch-corrupt` for both `sealed/` and `acked/`.  A matching durable ACK
+/// receipt is a conservative compatibility signal for those legacy names.
+fn quarantine_pending_source_is_acked(inner: &SpoolInner, pending: &wire::QuarantinePending) -> bool {
+    if quarantine_source_is_acked(&pending.quarantine_basename) {
+        return true;
+    }
+    let (Some(batch_id), Some(body_sha256)) = (pending.batch_id.as_deref(), pending.body_sha256.as_deref()) else {
+        return false;
+    };
+    inner.tombstones.iter().any(|entry| {
+        matches!(
+            entry,
+            TombstoneEntry::AckedReceipt(receipt)
+                if receipt.batch_id.as_str() == batch_id && receipt.body_sha256.as_str() == body_sha256
+        )
+    })
+}
+
+fn quarantine_recovery_path(
+    root: &Path,
+    path: &Path,
+    label: &str,
+    degraded: &mut bool,
+    storage_rejected_attempts: &mut u64,
+) {
+    if quarantine_path(root, path, label).is_err() {
+        *degraded = true;
+        *storage_rejected_attempts = saturating_inc(*storage_rejected_attempts);
+    }
+}
+
+fn corruption_gap_spec(hint: Option<&BatchInfo>, source_fingerprint: Option<String>) -> Result<GapSpec, SpoolError> {
+    Ok(GapSpec {
+        event_id: format!("{}{}", GAP_ID_PREFIX, random_hex_id()?),
+        occurred_at_unix_ms: unix_millis()?,
+        lost_spool_epoch: hint.map(|value| value.spool_epoch.clone()),
+        reason: wire::SpoolGapReason::SegmentCorruption,
+        first_lost_spool_sequence: hint.map(|value| value.first_spool_sequence),
+        last_lost_spool_sequence: hint.map(|value| value.last_spool_sequence),
+        lost_events: hint.map(|value| value.event_count),
+        lost_bytes: hint.map(|value| value.raw_bytes),
+        lost_batch_id: hint.map(|value| value.batch_id.clone()),
+        source_fingerprint,
+    })
+}
+
+/// Identify the damaged object a recovery gap was derived from.  The relative
+/// pathname keeps two distinct objects apart even when neither of them yields
+/// readable batch metadata, and the inode identity additionally prevents a
+/// later object created at the same pathname from inheriting a stale gap ID.
+/// `None` (a path outside the spool root) deliberately forces a fresh random
+/// gap ID: an unidentifiable source must never be treated as "the same one".
+fn recovery_source_fingerprint(node_id: &str, root: &Path, path: &Path) -> Option<String> {
+    let relative = path.strip_prefix(root).ok()?;
+    let mut hasher = Sha256::new();
+    hasher.update(b"shadowsocks-auditd/recovery-source/v1\0");
+    hasher.update(node_id.as_bytes());
+    hasher.update([0]);
+    hasher.update(relative.as_os_str().as_bytes());
+    hasher.update([0]);
+    match fs::symlink_metadata(path) {
+        Ok(metadata) => {
+            hasher.update([1]);
+            hasher.update(metadata.dev().to_be_bytes());
+            hasher.update(metadata.ino().to_be_bytes());
+            hasher.update(metadata.len().to_be_bytes());
+            hasher.update(metadata.mtime().to_be_bytes());
+            hasher.update(metadata.mtime_nsec().to_be_bytes());
+        }
+        Err(_) => hasher.update([0]),
+    }
+    Some(format!("{RECOVERY_SOURCE_PREFIX}{}", hex::encode(hasher.finalize())))
+}
+
+fn orphan_open_source_fingerprint(node_id: &str, metadata: &fs::Metadata) -> String {
+    let mut hasher = Sha256::new();
+    hasher.update(b"shadowsocks-auditd/orphan-open-source/v1\0");
+    hasher.update(node_id.as_bytes());
+    hasher.update([0]);
+    hasher.update(metadata.dev().to_be_bytes());
+    hasher.update(metadata.ino().to_be_bytes());
+    hasher.update(metadata.len().to_be_bytes());
+    hasher.update(metadata.mtime().to_be_bytes());
+    hasher.update(metadata.mtime_nsec().to_be_bytes());
+    format!("{ORPHAN_OPEN_SOURCE_PREFIX}{}", hex::encode(hasher.finalize()))
+}
+
+fn orphan_open_gap_spec(node_id: &str, epoch: &str, metadata: &fs::Metadata) -> GapSpec {
+    // A retry after a marker-directory fsync error must reuse the same event
+    // ID. Bind it to the orphan inode and its stable metadata rather than
+    // drawing another random value on every in-process attempt.
+    let mut hasher = Sha256::new();
+    hasher.update(b"shadowsocks-auditd/orphan-open-gap/v1\0");
+    hasher.update(node_id.as_bytes());
+    hasher.update([0]);
+    hasher.update(epoch.as_bytes());
+    hasher.update(metadata.dev().to_be_bytes());
+    hasher.update(metadata.ino().to_be_bytes());
+    hasher.update(metadata.len().to_be_bytes());
+    hasher.update(metadata.mtime().to_be_bytes());
+    hasher.update(metadata.mtime_nsec().to_be_bytes());
+    let digest = hasher.finalize();
+    let gap_id: String = hex::encode(digest).chars().take(32).collect();
+
+    let occurred_at_unix_ms = u64::try_from(metadata.mtime())
+        .unwrap_or(0)
+        .saturating_mul(1_000)
+        .saturating_add(u64::try_from(metadata.mtime_nsec()).unwrap_or(0) / 1_000_000);
+    GapSpec {
+        event_id: format!("{GAP_ID_PREFIX}{gap_id}"),
+        occurred_at_unix_ms,
+        // The replacement path is not represented by `open_meta`, so its
+        // bytes cannot be trusted to belong to the current epoch.
+        lost_spool_epoch: None,
+        reason: wire::SpoolGapReason::SegmentCorruption,
+        first_lost_spool_sequence: None,
+        last_lost_spool_sequence: None,
+        lost_events: None,
+        lost_bytes: Some(metadata.len()),
+        lost_batch_id: None,
+        source_fingerprint: Some(orphan_open_source_fingerprint(node_id, metadata)),
+    }
+}
+
+fn orphan_open_gap_for_metadata(queue: &VecDeque<GapSpec>, node_id: &str, metadata: &fs::Metadata) -> Option<GapSpec> {
+    let source_fingerprint = orphan_open_source_fingerprint(node_id, metadata);
+    queue
+        .iter()
+        .find(|spec| spec.source_fingerprint.as_deref() == Some(source_fingerprint.as_str()))
+        .cloned()
+}
+
+fn corruption_gap_spec_or_existing(
+    queue: &VecDeque<GapSpec>,
+    hint: Option<&BatchInfo>,
+    source_fingerprint: Option<String>,
+) -> Result<GapSpec, SpoolError> {
+    // Reuse is bound to the source object, never to the (frequently absent)
+    // batch details.  Matching `None == None` made every unreadable object
+    // adopt the first null-detail gap ID, so N damaged objects produced one
+    // gap and N-1 losses disappeared without evidence.
+    if let Some(fingerprint) = source_fingerprint.as_deref()
+        && let Some(existing) = queue.iter().find(|spec| {
+            spec.reason == wire::SpoolGapReason::SegmentCorruption
+                && spec.source_fingerprint.as_deref() == Some(fingerprint)
+        })
+    {
+        // A marker may have survived before the source rename. Reuse its
+        // stable ID and payload instead of creating a second gap on restart.
+        return Ok(existing.clone());
+    }
+    corruption_gap_spec(hint, source_fingerprint)
+}
+
+fn tail_truncation_gap_spec_or_existing(
+    queue: &VecDeque<GapSpec>,
+    lost_spool_epoch: Option<&str>,
+    source_fingerprint: Option<String>,
+) -> Result<GapSpec, SpoolError> {
+    if let Some(fingerprint) = source_fingerprint.as_deref()
+        && let Some(existing) = queue.iter().find(|spec| {
+            spec.reason == wire::SpoolGapReason::TailTruncation
+                && spec.source_fingerprint.as_deref() == Some(fingerprint)
+        })
+    {
+        return Ok(existing.clone());
+    }
+    Ok(GapSpec {
+        event_id: format!("{}{}", GAP_ID_PREFIX, random_hex_id()?),
+        occurred_at_unix_ms: unix_millis()?,
+        lost_spool_epoch: lost_spool_epoch.map(str::to_owned),
+        reason: wire::SpoolGapReason::TailTruncation,
+        first_lost_spool_sequence: None,
+        last_lost_spool_sequence: None,
+        lost_events: None,
+        lost_bytes: None,
+        lost_batch_id: None,
+        source_fingerprint,
+    })
+}
+
+#[derive(Debug)]
+struct RecoveryResult {
+    epoch: String,
+    next_sequence: u64,
+    degraded: bool,
+    gap_degraded: bool,
+    storage_rejected_attempts: u64,
+    open_meta: OpenMetadata,
+    pending_state_reset: Option<PendingStateReset>,
+    recovery_gaps: VecDeque<GapSpec>,
+}
+
+#[derive(Debug)]
+struct SpoolInner {
+    epoch: String,
+    next_sequence: u64,
+    open_file: File,
+    open_meta: OpenMetadata,
+    leased_batch: Option<String>,
+    degraded: bool,
+    // `degraded` records the current health state; this flag identifies the
+    // recoverable portion caused by an unacknowledged spool gap.  It lets a
+    // successful ACK restore `ok` without erasing unrelated counters.
+    gap_degraded: bool,
+    non_gap_degraded: bool,
+    producer_connected: bool,
+    producer_disconnected_at: Option<Instant>,
+    producer_runtime_id: Option<String>,
+    last_ingest_at_unix_ms: Option<u64>,
+    storage_rejected_attempts: u64,
+    evicted_unacked_records: u64,
+    pending_state_reset: Option<PendingStateReset>,
+    recovery_gaps: VecDeque<GapSpec>,
+    tombstones: Vec<TombstoneEntry>,
+    // These values are initialized by one recovery scan at startup and then
+    // maintained by the mutation paths.  Capacity/health requests must not
+    // recursively walk an ever-growing spool while holding this mutex.
+    spool_bytes: u64,
+    spool_bytes_known: bool,
+    stored_records: u64,
+    sealed_batches: u64,
+    oldest_unacked_at_unix_ms: Option<u64>,
+    unacked_gap_batches: HashSet<String>,
+    sealed_received_at: HashMap<String, u64>,
+    sealed_paths: HashMap<String, PathBuf>,
+    integrity_queue: VecDeque<String>,
+    durable_gap_reasons: HashMap<String, wire::SpoolGapReason>,
+    /// Gap IDs whose private marker could not be unlinked after its ledger
+    /// transition committed.  Retried on every reconcile so a stale marker
+    /// does not have to wait for the next startup.
+    pending_marker_cleanup: HashSet<String>,
+    durability_uncertain: bool,
+    last_spool_measurement: Instant,
+    last_retention_sweep: Instant,
+    #[cfg(test)]
+    faults: TestFaults,
+}
+
+/// Quarantine basename labels.  The label is the only piece of provenance that
+/// survives a restart -- `quarantine/` objects carry no other record of which
+/// directory they came from -- so eviction accounting reads it back from the
+/// basename rather than from the in-memory ledger.
+const QUARANTINE_LABEL_UNACKED: &str = "batch-corrupt";
+const QUARANTINE_LABEL_ACKED: &str = "acked-corrupt";
+
+#[cfg(test)]
+thread_local! {
+    /// Startup-only fault: `Spool::open` has no `SpoolInner` yet, so the salvage
+    /// path cannot use the ordinary `TestFaults` switches.
+    static SALVAGE_PERSIST_AFTER_RENAME: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    /// Startup-only fault: make the stale-marker unlink fail so the branch that
+    /// must *not* replay the marker into the ledger is actually exercised.
+    static STARTUP_MARKER_UNLINK_FAILS: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+#[cfg(test)]
+#[derive(Debug, Default)]
+struct TestFaults {
+    partial_write: bool,
+    sync_data: bool,
+    persist_state: bool,
+    persist_state_after_commit: bool,
+    persist_state_accounting: bool,
+    recovery_marker_accounting: bool,
+    tombstone_pending_marker_accounting: bool,
+    rollback: bool,
+    recovery_marker: bool,
+    orphan_after_marker: bool,
+    orphan_after_rename: bool,
+    orphan_new_open_sync: bool,
+    recovery_marker_remove_sync: bool,
+    seal_after_open_rename: bool,
+    seal_rollback: bool,
+    persist_tombstones: bool,
+    // Report an error after the aggregate ledger rename has completed.  This
+    // models a parent-directory fsync failure and must not trigger an in-memory
+    // rollback of the already-visible ledger transition.
+    persist_tombstones_after_commit: bool,
+    persist_tombstones_accounting: bool,
+    marker_cleanup: bool,
+    // Skip one aggregate-ledger write, then fail the next one.  This models
+    // the pending-marker write succeeding while the later ledger removal
+    // fails, which is the retry window for quarantine eviction accounting.
+    persist_tombstones_skip: bool,
+}
+
+/// The aggregate tombstone ledger is the commit point for a pending
+/// destructive transaction. Marker cleanup is a second, best-effort barrier:
+/// it must still be reported to the caller, but an error there must not make
+/// callers forget accounting for a ledger transition that is already durable.
+#[derive(Debug)]
+/// A committed ledger transition, plus whatever went wrong cleaning up its
+/// private marker afterwards.  `#[must_use]` is load-bearing: the whole point
+/// of splitting commit from cleanup is that the cleanup error stays reportable,
+/// and a call site that drops the value would silently undo that.
+#[must_use = "the marker cleanup error must be surfaced with `finish()`"]
+struct TombstoneCommit {
+    marker_cleanup_error: Option<SpoolError>,
+}
+
+impl TombstoneCommit {
+    fn finish(self) -> Result<(), SpoolError> {
+        match self.marker_cleanup_error {
+            Some(error) => Err(error),
+            None => Ok(()),
+        }
+    }
+}
+
+pub struct Spool {
+    config: Arc<AuditdConfig>,
+    root: PathBuf,
+    // Advisory lock held for the full lifetime of this spool.  Binding the
+    // lock to spool_dir (rather than an export socket path) prevents two
+    // daemons configured with different sockets from mutating one ledger.
+    spool_lock: SpoolLock,
+    inner: Mutex<SpoolInner>,
+    durability_uncertain_tx: watch::Sender<bool>,
+}
+
+impl Spool {
+    pub(crate) fn acquire_lock(root: &Path) -> io::Result<SpoolLock> {
+        acquire_spool_lock(root)
+    }
+
+    pub(crate) fn durability_uncertain_receiver(&self) -> watch::Receiver<bool> {
+        self.durability_uncertain_tx.subscribe()
+    }
+
+    pub fn open(config: Arc<AuditdConfig>) -> Result<Self, SpoolError> {
+        let root = config.spool_dir.clone();
+        ensure_dir(&root, 0o700)?;
+        let spool_lock = acquire_spool_lock(&root)?;
+        Self::open_with_lock(config, spool_lock)
+    }
+
+    /// Open a spool after its directory lock has already been acquired.
+    /// AuditDaemon uses this to establish the lock before any recovery or
+    /// other spool initialization can run.
+    pub(crate) fn open_with_lock(config: Arc<AuditdConfig>, spool_lock: SpoolLock) -> Result<Self, SpoolError> {
+        let root = config.spool_dir.clone();
+        ensure_dir(&root, 0o700)?;
+        for name in ["open", "sealed", "acked", "quarantine"] {
+            ensure_dir(&root.join(name), 0o700)?;
+        }
+        cleanup_root_temps(&root)?;
+
+        let recovery = recover_layout(&root, &config.node_id)?;
+        // `recover_layout` promotes or quarantines complete interrupted seal
+        // directories.  Any remaining known temp files are from an atomic
+        // metadata write that crashed before its rename; remove those files
+        // now, before building the incremental byte index.  Never delete a
+        // temp directory that still contains a segment: it remains recovery
+        // input and is intentionally counted until a later retry resolves it.
+        cleanup_recovered_temp_files(&root)?;
+        let open_path = root.join("open/current.ndjson");
+        if recovery.pending_state_reset.is_some()
+            && fs::symlink_metadata(&open_path)
+                .map(|metadata| metadata.file_type().is_symlink() || (metadata.is_file() && metadata.len() > 0))
+                .unwrap_or(false)
+        {
+            // `recover_layout` normally moves the old open inode away when a
+            // new epoch is required.  Refuse to append after a failed move:
+            // doing so would place the new state-reset gap behind untrusted
+            // bytes.  A retryable startup error is safer than silently
+            // exporting a mixed-epoch segment.
+            quarantine_path(&root, &open_path, "state-reset")?;
+        }
+        let open_file = OpenOptions::new()
+            .create(true)
+            .read(true)
+            .append(true)
+            .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+            .mode(0o600)
+            .open(&open_path)?;
+        set_file_mode(&open_path, 0o600)?;
+
+        let mut degraded = recovery.degraded;
+        let mut storage_rejected_attempts = recovery.storage_rejected_attempts;
+        // A recovery rejection (malformed state/marker, unreadable directory,
+        // or failed quarantine) is independent of the eventual gap ACK. Keep
+        // that bit sticky so an ACK cannot make the spool look healthy while
+        // the underlying storage evidence is still unavailable.
+        let mut non_gap_degraded =
+            recovery.storage_rejected_attempts > 0 || (recovery.degraded && !recovery.gap_degraded);
+        let mut tombstones = match load_tombstones(&root) {
+            Ok(value) => value,
+            Err(_) => {
+                degraded = true;
+                non_gap_degraded = true;
+                storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+                let salvaged = match salvage_tombstones(&root) {
+                    Ok(value) => value,
+                    Err(_) => {
+                        storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+                        Vec::new()
+                    }
+                };
+                if quarantine_path(&root, &root.join("tombstones.json"), "tombstones-corrupt").is_err() {
+                    // Keep the corrupt ledger in place when it cannot be
+                    // isolated; replacing it would erase the only artifact
+                    // available for operator salvage.
+                    storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+                } else if !salvaged.is_empty() {
+                    #[cfg(test)]
+                    let salvage_result = if SALVAGE_PERSIST_AFTER_RENAME.with(std::cell::Cell::take) {
+                        Err(AtomicWriteError::AfterRename(
+                            io::Error::other("injected salvage failure after durable commit").into(),
+                        ))
+                    } else {
+                        persist_tombstones(&root, &salvaged)
+                    };
+                    #[cfg(not(test))]
+                    let salvage_result = persist_tombstones(&root, &salvaged);
+                    match salvage_result {
+                        Ok(()) => {}
+                        Err(AtomicWriteError::BeforeRename(_)) => {
+                            storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+                        }
+                        Err(AtomicWriteError::AfterRename(_)) => {
+                            // The replacement ledger is already visible, but
+                            // its parent-directory sync did not complete.  A
+                            // partially acknowledged startup cannot safely
+                            // continue: refuse service and let the supervisor
+                            // retry recovery after the storage is repaired.
+                            return Err(SpoolError::DurabilityUncertain);
+                        }
+                    }
+                }
+                salvaged
+            }
+        };
+        // Pending destructive operations are mirrored in private per-gap
+        // markers.  Merge those markers after loading the aggregate ledger so
+        // a torn/corrupt tombstones.json cannot make a deleted batch's gap
+        // unrecoverable.  A marker may legitimately outlive a resolved
+        // receipt by one crash window.  If its fixed gap is already durable,
+        // remove that stale marker immediately; otherwise retain it for
+        // reconcile even when the aggregate ledger was lost.
+        match load_tombstone_pending_markers(&root) {
+            Ok((markers, marker_degraded, marker_rejections)) => {
+                if marker_degraded {
+                    degraded = true;
+                    non_gap_degraded = true;
+                }
+                if marker_rejections != 0 {
+                    storage_rejected_attempts = storage_rejected_attempts.saturating_add(marker_rejections);
+                }
+                for marker in markers {
+                    let gap_id = marker.gap_event_id().map(str::to_owned);
+                    // A failed scan must never be interpreted as proof that a
+                    // fixed gap is absent: doing so could append a duplicate
+                    // diagnostic with the same ID after a crash.  Keep the
+                    // marker for the normal retry path and expose the storage
+                    // failure through the bounded health counter.
+                    let gap_already_durable = match gap_id.as_deref() {
+                        Some(event_id) => match event_id_exists_in_epoch(&root, event_id, &recovery.epoch) {
+                            Ok(value) => value,
+                            Err(_) => {
+                                degraded = true;
+                                non_gap_degraded = true;
+                                storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+                                false
+                            }
+                        },
+                        None => false,
+                    };
+                    if let Some(existing) = tombstones
+                        .iter()
+                        .find(|entry| entry.gap_event_id() == marker.gap_event_id())
+                    {
+                        if existing != &marker {
+                            if gap_already_durable {
+                                // A resolved receipt may be left behind when
+                                // the process stopped after replacing the
+                                // pending entry but before unlinking its
+                                // private marker.  The receipt and durable
+                                // gap are authoritative; discard only the
+                                // stale marker instead of resurrecting a
+                                // second pending transaction.
+                                if let Some(event_id) = gap_id.as_deref()
+                                    && remove_tombstone_pending_marker(&root, event_id).is_err()
+                                {
+                                    degraded = true;
+                                    non_gap_degraded = true;
+                                    storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+                                }
+                            } else {
+                                degraded = true;
+                                non_gap_degraded = true;
+                                storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+                            }
+                        }
+                    } else if gap_already_durable {
+                        #[cfg(test)]
+                        let unlink_failed = STARTUP_MARKER_UNLINK_FAILS.with(std::cell::Cell::get)
+                            || gap_id
+                                .as_deref()
+                                .is_some_and(|event_id| remove_tombstone_pending_marker(&root, event_id).is_err());
+                        #[cfg(not(test))]
+                        let unlink_failed = gap_id
+                            .as_deref()
+                            .is_some_and(|event_id| remove_tombstone_pending_marker(&root, event_id).is_err());
+                        if unlink_failed {
+                            // The fixed gap proves that this transaction is
+                            // already resolved. Keep only the private marker
+                            // on disk for a later startup retry; re-inserting
+                            // it into the aggregate ledger would replay the
+                            // destructive operation and its health accounting.
+                            degraded = true;
+                            non_gap_degraded = true;
+                            storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+                        }
+                    } else {
+                        tombstones.push(marker);
+                    }
+                }
+            }
+            Err(_) => {
+                degraded = true;
+                non_gap_degraded = true;
+                storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+            }
+        }
+        let (durability_uncertain_tx, _) = watch::channel(false);
+        let spool = Self {
+            config,
+            root,
+            spool_lock,
+            inner: Mutex::new(SpoolInner {
+                epoch: recovery.epoch,
+                next_sequence: recovery.next_sequence,
+                open_file,
+                open_meta: recovery.open_meta,
+                leased_batch: None,
+                degraded,
+                gap_degraded: recovery.gap_degraded,
+                non_gap_degraded,
+                producer_connected: false,
+                producer_disconnected_at: None,
+                producer_runtime_id: None,
+                last_ingest_at_unix_ms: None,
+                storage_rejected_attempts,
+                evicted_unacked_records: 0,
+                pending_state_reset: recovery.pending_state_reset,
+                recovery_gaps: recovery.recovery_gaps,
+                tombstones,
+                spool_bytes: 0,
+                spool_bytes_known: false,
+                stored_records: 0,
+                sealed_batches: 0,
+                oldest_unacked_at_unix_ms: None,
+                unacked_gap_batches: HashSet::new(),
+                sealed_received_at: HashMap::new(),
+                sealed_paths: HashMap::new(),
+                integrity_queue: VecDeque::new(),
+                durable_gap_reasons: HashMap::new(),
+                pending_marker_cleanup: HashSet::new(),
+                durability_uncertain: false,
+                last_spool_measurement: Instant::now()
+                    .checked_sub(INDEX_REBUILD_RETRY_INTERVAL)
+                    .unwrap_or_else(Instant::now),
+                last_retention_sweep: Instant::now()
+                    .checked_sub(RETENTION_SWEEP_INTERVAL)
+                    .unwrap_or_else(Instant::now),
+                #[cfg(test)]
+                faults: TestFaults::default(),
+            }),
+            durability_uncertain_tx,
+        };
+
+        // Complete any transaction that was durable before a previous crash.
+        // A failure leaves the pending entry in place; the next open can retry
+        // it without inventing a second gap ID.
+        {
+            let mut inner = lock(&spool.inner);
+            // Build durable gap indexes before any startup flush can consult
+            // them for idempotency.
+            spool.rebuild_runtime_indexes_locked(&mut inner);
+            // A pending state reset owns the first sequence in its new epoch,
+            // so materialize it before eviction/recovery diagnostics.
+            // Do not let another gap consume a sequence when this barrier is
+            // still pending.  In particular, a failed state.json sync after
+            // the reset record was written must leave that record as the
+            // first writable record on the next retry.
+            let reset_ready = match spool.flush_state_reset_locked(&mut inner) {
+                Ok(()) => true,
+                Err(_) => {
+                    inner.degraded = true;
+                    inner.non_gap_degraded = true;
+                    inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                    false
+                }
+            };
+            if reset_ready {
+                if spool.reconcile_tombstones_locked(&mut inner).is_err() {
+                    inner.degraded = true;
+                    inner.non_gap_degraded = true;
+                    inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                }
+                // A crash may have completed sealed -> acked and both
+                // directory fsyncs, but stopped before the receipt ledger
+                // barrier.  Rebuild receipts while the acked directory still
+                // exists so a later cleanup cannot erase the ACK proof.
+                if spool.rebuild_acked_receipts_locked(&mut inner).is_err() {
+                    inner.degraded = true;
+                    inner.non_gap_degraded = true;
+                    inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                }
+                if spool.flush_recovery_gaps_locked(&mut inner).is_err() {
+                    inner.degraded = true;
+                    inner.non_gap_degraded = true;
+                    inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                }
+            }
+            // Recovery intentionally performs the expensive tree walk once.
+            // All subsequent health/capacity calls use these indexes.
+            spool.rebuild_runtime_indexes_locked(&mut inner);
+        }
+        Ok(spool)
+    }
+
+    pub fn root(&self) -> &Path {
+        &self.root
+    }
+
+    pub fn set_producer_state(&self, connected: bool, runtime_id: Option<String>, at_unix_ms: Option<u64>) {
+        let mut inner = lock(&self.inner);
+
+        if connected {
+            inner.producer_disconnected_at = None;
+        } else if inner.producer_connected && inner.producer_disconnected_at.is_none() {
+            inner.producer_disconnected_at = Some(Instant::now());
+        }
+        inner.producer_connected = connected;
+        inner.producer_runtime_id = runtime_id;
+        if connected {
+            // Replace the timestamp with the latest valid observation.  A
+            // missing value is intentional (clock unavailable or only a
+            // hello was received) and must not inherit another runtime's
+            // wall-clock value.
+            inner.last_ingest_at_unix_ms = at_unix_ms;
+        } else {
+            // A disconnected producer has no current runtime or last-ingest
+            // timestamp in the health contract.  Do not retain the previous
+            // runtime's timestamp after a disconnect notification.
+            inner.last_ingest_at_unix_ms = None;
+        }
+    }
+
+    /// Append one already-canonical producer event and return its durable
+    /// spool position.  No sequence is consumed when the capacity barrier
+    /// cannot be completed.
+    pub fn append(&self, event_raw: &[u8], received_at_unix_ms: u64) -> Result<EventAck, SpoolError> {
+        let info = protocol::parse_event(event_raw)?;
+        self.append_parsed(event_raw, &info.record, &info.event_id, received_at_unix_ms)
+    }
+
+    /// Append an event that has already passed the shared canonical parser.
+    /// Ingest uses this entry point so the same frame is not parsed a second
+    /// time merely to construct the spool wrapper. `event_raw` remains an
+    /// explicit argument to keep the ownership boundary clear and to permit a
+    /// future raw-payload digest check without changing the public `append`
+    /// API.
+    pub(crate) fn append_parsed(
+        &self,
+        _event_raw: &[u8],
+        event: &wire::AuditRecord,
+        event_id: &str,
+        received_at_unix_ms: u64,
+    ) -> Result<EventAck, SpoolError> {
+        let mut inner = lock(&self.inner);
+        Self::reject_if_durability_uncertain(&mut inner)?;
+        if let Err(error) = self.spool_lock.verify() {
+            mark_storage_rejection(&mut inner, true);
+            return Err(error.into());
+        }
+        self.maybe_sweep_acked_locked(&mut inner);
+
+        if let Err(error) = self.flush_state_reset_locked(&mut inner) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            return Err(error);
+        }
+        if let Err(error) = self.reconcile_tombstones_locked(&mut inner) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            return Err(error);
+        }
+        if let Err(error) = self.flush_recovery_gaps_locked(&mut inner) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            return Err(error);
+        }
+
+        // Capacity cleanup can itself emit durable `spool_gap` records (for
+        // example while evicting an unacked batch or quarantine entry).  Such
+        // records consume sequence numbers, so construct the producer wrapper
+        // only after the cleanup barrier has settled, and rebuild it whenever
+        // the cursor moved underneath us.
+        let (sequence, wrapper) = loop {
+            let sequence = inner.next_sequence;
+            if sequence == u64::MAX {
+                inner.degraded = true;
+                return Err(SpoolError::SequenceExhausted);
+            }
+            let wrapper = wrapper_bytes_from_record(&inner.epoch, sequence, received_at_unix_ms, event)?;
+            let wrapper_len = wrapper.len() as u64;
+            if wrapper_len > self.config.segment_max_bytes {
+                inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                inner.degraded = true;
+                return Err(SpoolError::StorageUnavailable);
+            }
+            if inner.open_meta.bytes > 0
+                && inner.open_meta.bytes.saturating_add(wrapper_len) > self.config.segment_max_bytes
+            {
+                if let Err(error) = self.seal_locked(&mut inner) {
+                    inner.degraded = true;
+                    inner.non_gap_degraded = true;
+                    return Err(error);
+                }
+                continue;
+            }
+            if let Err(error) = self.ensure_capacity_locked(&mut inner, wrapper_len) {
+                inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                inner.degraded = true;
+                inner.non_gap_degraded = true;
+                return Err(error);
+            }
+            // Eviction/quarantine recovery may have written one or more gap
+            // records while checking capacity.  Never write the producer event
+            // with the stale sequence captured before that work.
+            if inner.next_sequence != sequence {
+                continue;
+            }
+            break (sequence, wrapper);
+        };
+        if let Err(error) = self.write_record_locked(&mut inner, &wrapper, sequence, received_at_unix_ms) {
+            // A record is acknowledged only after both the open-file sync and
+            // state cursor persistence.  Surface any barrier failure as a
+            // degraded storage condition and keep the producer-side retry
+            // contract intact.
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            if matches!(&error, SpoolError::Io(_) | SpoolError::StorageUnavailable) {
+                inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            }
+            return Err(error);
+        }
+        let should_seal = inner.open_meta.bytes >= self.config.segment_max_bytes
+            || (inner.open_meta.event_count > 0
+                && inner.open_meta.opened_at.elapsed().unwrap_or_default()
+                    >= Duration::from_secs(self.config.segment_max_age_seconds));
+        if should_seal {
+            if let Err(error) = self.seal_locked(&mut inner) {
+                // The record and its next-sequence cursor were already durable
+                // before this best-effort seal.  Returning the error would make
+                // the producer retry and append the same event a second time.
+                // Keep the durable ACK contract, mark health degraded, and let
+                // the next lease/append retry sealing.
+                inner.degraded = true;
+                inner.non_gap_degraded = true;
+                let _ = error;
+            }
+        }
+        Ok(EventAck {
+            event_id: event_id.to_owned(),
+            spool_epoch: inner.epoch.clone(),
+            spool_sequence: sequence,
+        })
+    }
+
+    /// Return the oldest sealed batch.  A non-empty open segment is sealed at
+    /// lease time so a quiet producer does not strand durable records forever.
+    pub fn lease(&self) -> Result<Option<BatchLease>, SpoolError> {
+        let mut inner = lock(&self.inner);
+        Self::reject_if_durability_uncertain(&mut inner)?;
+        if let Err(error) = self.spool_lock.verify() {
+            mark_storage_rejection(&mut inner, true);
+            return Err(error.into());
+        }
+        self.maybe_sweep_acked_locked(&mut inner);
+        if let Err(error) = self.flush_state_reset_locked(&mut inner) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            return Err(error);
+        }
+        if let Err(error) = self.reconcile_tombstones_locked(&mut inner) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            return Err(error);
+        }
+        if let Err(error) = self.flush_recovery_gaps_locked(&mut inner) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            return Err(error);
+        }
+        if inner.open_meta.event_count > 0 {
+            if let Err(error) = self.seal_locked(&mut inner) {
+                inner.degraded = true;
+                inner.non_gap_degraded = true;
+                inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                return Err(error);
+            }
+        }
+        if let Some(batch_id) = inner.leased_batch.clone() {
+            let existing = match self.find_batch_with_digest(&self.root.join("sealed"), &batch_id) {
+                Ok(value) => value,
+                Err(error) => {
+                    mark_storage_rejection(&mut inner, true);
+                    return Err(error);
+                }
+            };
+            if let Some((path, _)) = existing {
+                match self.read_batch(&path, false) {
+                    Ok(Some(lease)) => return Ok(Some(lease)),
+                    Ok(None) | Err(_) => {
+                        // A leased batch may have been damaged between two
+                        // lease calls.  Isolate it before looking for another
+                        // batch; silently skipping it would hide a spool gap.
+                        inner.degraded = true;
+                        mark_storage_rejection(&mut inner, true);
+                        if let Err(error) = self.quarantine_batch_locked(&mut inner, &path, QUARANTINE_LABEL_UNACKED) {
+                            mark_storage_rejection(&mut inner, true);
+                            return Err(error);
+                        }
+                    }
+                }
+            }
+            inner.leased_batch = None;
+        }
+
+        // Directory names start with a random epoch, so lexical path order is
+        // not a valid "oldest" order (and decimal sequence strings do not sort
+        // numerically either).  Read the trusted metadata first and sort by
+        // receive time, sequence, epoch, then batch ID for deterministic FIFO
+        // leasing across epochs.
+        let mut candidates = Vec::new();
+        let paths = match list_batch_dirs(&self.root.join("sealed")) {
+            Ok(value) => value,
+            Err(error) => {
+                mark_storage_rejection(&mut inner, true);
+                return Err(error);
+            }
+        };
+        for path in paths {
+            let info = match self.read_meta(&path) {
+                Ok(value) => value,
+                Err(error) => {
+                    mark_storage_rejection(&mut inner, true);
+                    return Err(error);
+                }
+            };
+            let Some(info) = info else {
+                mark_storage_rejection(&mut inner, true);
+                if let Err(error) = self.quarantine_batch_locked(&mut inner, &path, QUARANTINE_LABEL_UNACKED) {
+                    mark_storage_rejection(&mut inner, true);
+                    return Err(error);
+                }
+                continue;
+            };
+            candidates.push((path, info));
+        }
+        candidates.sort_by(|(_, left), (_, right)| {
+            (
+                left.first_received_at_unix_ms,
+                left.first_spool_sequence,
+                &left.spool_epoch,
+                &left.batch_id,
+            )
+                .cmp(&(
+                    right.first_received_at_unix_ms,
+                    right.first_spool_sequence,
+                    &right.spool_epoch,
+                    &right.batch_id,
+                ))
+        });
+        for (path, _) in candidates {
+            match self.read_batch(&path, false) {
+                Ok(Some(lease)) => {
+                    inner.leased_batch = Some(lease.info.batch_id.clone());
+                    return Ok(Some(lease));
+                }
+                Ok(None) | Err(_) => {
+                    inner.degraded = true;
+                    mark_storage_rejection(&mut inner, true);
+                    if let Err(error) = self.quarantine_batch_locked(&mut inner, &path, QUARANTINE_LABEL_UNACKED) {
+                        mark_storage_rejection(&mut inner, true);
+                        return Err(error);
+                    }
+                }
+            }
+        }
+        Ok(None)
+    }
+
+    /// Isolate a leased batch that cannot be represented by the export
+    /// response limit.  The lease is cleared only when it still refers to the
+    /// supplied batch, so a late response from an older request cannot release
+    /// a newer lease.  Quarantining rather than merely clearing the marker is
+    /// important: otherwise every subsequent lease call would select the same
+    /// poison batch again.
+    pub fn quarantine_oversized_lease(&self, batch_id: &str, max_bytes: u64) -> Result<bool, SpoolError> {
+        let mut inner = lock(&self.inner);
+        Self::reject_if_durability_uncertain(&mut inner)?;
+        if let Err(error) = self.spool_lock.verify() {
+            mark_storage_rejection(&mut inner, true);
+            return Err(error.into());
+        }
+        if inner.leased_batch.as_deref() != Some(batch_id) {
+            return Ok(false);
+        }
+        let existing = match self.find_batch_with_digest(&self.root.join("sealed"), batch_id) {
+            Ok(value) => value,
+            Err(error) => {
+                mark_storage_rejection(&mut inner, true);
+                return Err(error);
+            }
+        };
+        let Some((path, _)) = existing else {
+            inner.leased_batch = None;
+            return Ok(false);
+        };
+        let oversized = match self.read_batch(&path, false) {
+            Ok(Some(lease)) => lease.body.len() as u64 > max_bytes,
+            Ok(None) => true,
+            Err(error) => {
+                // Clear the in-memory marker even when the quarantine barrier
+                // itself fails.  Leaving it set would make a transient disk
+                // error pin this batch forever; a later lease can retry the
+                // recovery path after the daemon reports degraded health.
+                inner.leased_batch = None;
+                mark_storage_rejection(&mut inner, true);
+                return Err(error);
+            }
+        };
+        if !oversized {
+            return Ok(false);
+        }
+        inner.degraded = true;
+        let quarantine_result = self.quarantine_batch_locked(&mut inner, &path, "batch-too-large");
+        inner.leased_batch = None;
+        if quarantine_result.is_err() {
+            mark_storage_rejection(&mut inner, true);
+        }
+        quarantine_result.map(|()| true)
+    }
+
+    /// ACK a batch by ID and body digest.  Both the first ACK and retries are
+    /// backed by a durable receipt; an acked directory can rebuild a receipt
+    /// after a crash between the rename and ledger write.
+    pub fn ack(&self, batch_id: &str, body_sha256: &str) -> Result<AckOutcome, SpoolError> {
+        if !is_hex(batch_id, 32) || !is_hex(body_sha256, 64) {
+            return Ok(AckOutcome::Unknown);
+        }
+        let mut inner = lock(&self.inner);
+        Self::reject_if_durability_uncertain(&mut inner)?;
+        if let Err(error) = self.spool_lock.verify() {
+            mark_storage_rejection(&mut inner, true);
+            return Err(error.into());
+        }
+        self.maybe_sweep_acked_locked(&mut inner);
+        if let Err(error) = self.flush_state_reset_locked(&mut inner) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            return Err(error);
+        }
+        if let Err(error) = self.reconcile_tombstones_locked(&mut inner) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            return Err(error);
+        }
+        if let Err(error) = self.flush_recovery_gaps_locked(&mut inner) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            return Err(error);
+        }
+        if let Err(error) = self.prune_receipts_locked(&mut inner) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            return Err(error);
+        }
+
+        if let Some(entry) = inner.tombstones.iter().find(|entry| entry.batch_id() == Some(batch_id)) {
+            match entry {
+                TombstoneEntry::AckedReceipt(value) => {
+                    let outcome = if value.body_sha256 == body_sha256 {
+                        AckOutcome::Acked
+                    } else {
+                        AckOutcome::DigestMismatch
+                    };
+                    if outcome == AckOutcome::Acked {
+                        self.refresh_degraded_after_ack_locked(&mut inner);
+                    }
+                    return Ok(outcome);
+                }
+                TombstoneEntry::EvictedReceipt(value) => {
+                    return Ok(if value.body_sha256 == body_sha256 {
+                        AckOutcome::Evicted
+                    } else {
+                        AckOutcome::DigestMismatch
+                    });
+                }
+                TombstoneEntry::EvictionPending(_) | TombstoneEntry::QuarantinePending(_) => {
+                    return Ok(AckOutcome::Unknown);
+                }
+            }
+        }
+
+        let acked_match = match self.find_batch_with_digest(&self.root.join("acked"), batch_id) {
+            Ok(value) => value,
+            Err(error) => {
+                mark_storage_rejection(&mut inner, true);
+                return Err(error);
+            }
+        };
+        if let Some((path, info)) = acked_match {
+            if info.body_sha256 != body_sha256 {
+                return Ok(AckOutcome::DigestMismatch);
+            }
+            // ACKed batches were validated before the durable move (and again
+            // during startup recovery).  The receipt makes duplicate ACKs a
+            // metadata-only hot path; re-reading and hashing the whole body
+            // here would make every collector retry proportional to spool
+            // size.
+            let receipt = TombstoneEntry::AckedReceipt(wire::AckedReceipt::new(
+                info.batch_id.clone(),
+                info.body_sha256.clone(),
+                match unix_millis() {
+                    Ok(value) => value,
+                    Err(error) => {
+                        mark_storage_rejection(&mut inner, true);
+                        return Err(error);
+                    }
+                },
+            ));
+            if let Err(error) = self.add_receipt_locked(&mut inner, receipt) {
+                mark_storage_rejection(&mut inner, true);
+                return Err(error);
+            }
+            let _ = path;
+            self.refresh_degraded_after_ack_locked(&mut inner);
+            return Ok(AckOutcome::Acked);
+        }
+
+        let sealed_match = match self.find_batch_with_digest(&self.root.join("sealed"), batch_id) {
+            Ok(value) => value,
+            Err(error) => {
+                mark_storage_rejection(&mut inner, true);
+                return Err(error);
+            }
+        };
+        let Some((path, info)) = sealed_match else {
+            if inner
+                .tombstones
+                .iter()
+                .any(|entry| matches!(entry, TombstoneEntry::EvictedReceipt(value) if value.batch_id == batch_id))
+            {
+                return Ok(AckOutcome::Evicted);
+            }
+            return Ok(AckOutcome::Unknown);
+        };
+        if info.body_sha256 != body_sha256 {
+            return Ok(AckOutcome::DigestMismatch);
+        }
+        match self.read_batch(&path, false) {
+            Ok(Some(_)) => {}
+            Ok(None) => {
+                mark_storage_rejection(&mut inner, true);
+                return Err(SpoolError::StorageUnavailable);
+            }
+            Err(error) => {
+                mark_storage_rejection(&mut inner, true);
+                return Err(error);
+            }
+        }
+        let name = path
+            .file_name()
+            .and_then(|value| value.to_str())
+            .ok_or_else(|| SpoolError::InvalidState("invalid batch directory name".to_owned()));
+        let name = match name {
+            Ok(value) => value,
+            Err(error) => {
+                mark_storage_rejection(&mut inner, true);
+                return Err(error);
+            }
+        };
+        let timestamp = match unix_seconds() {
+            Ok(value) => value,
+            Err(error) => {
+                mark_storage_rejection(&mut inner, true);
+                return Err(error);
+            }
+        };
+        let target = self.root.join("acked").join(format!("{}-{}", timestamp, name));
+        if let Err(error) = fs::rename(&path, &target) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            return Err(error.into());
+        }
+        if let Err(error) = sync_dir(&self.root.join("sealed")) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            return Err(error.into());
+        }
+        if let Err(error) = sync_dir(&self.root.join("acked")) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            return Err(error.into());
+        }
+
+        Self::remove_sealed_index(&mut inner, &info);
+
+        // The receipt is the recovery proof that allows a later capacity
+        // cleanup to remove this acked directory.  Persist it only after the
+        // cross-directory move and both directory fsync barriers.  If this
+        // write fails, the moved batch remains available for a retry and the
+        // next ACK/recovery pass rebuilds the receipt from its metadata.
+        let recorded_at = match unix_millis() {
+            Ok(value) => value,
+            Err(error) => {
+                mark_storage_rejection(&mut inner, true);
+                return Err(error);
+            }
+        };
+        let receipt = TombstoneEntry::AckedReceipt(wire::AckedReceipt::new(
+            info.batch_id.clone(),
+            info.body_sha256.clone(),
+            recorded_at,
+        ));
+        if let Err(error) = self.add_receipt_locked(&mut inner, receipt) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            return Err(error);
+        }
+        if inner.leased_batch.as_deref() == Some(batch_id) {
+            inner.leased_batch = None;
+        }
+        self.refresh_degraded_after_ack_locked(&mut inner);
+        Ok(AckOutcome::Acked)
+    }
+
+    /// Clear the recoverable degraded marker once every unacknowledged
+    /// `spool_gap` has been acknowledged.  Historical counters remain intact;
+    /// malformed batches, pending transactions, and unreadable files keep the
+    /// daemon degraded conservatively.
+    fn refresh_degraded_after_ack_locked(&self, inner: &mut SpoolInner) {
+        if !inner.gap_degraded || inner.pending_state_reset.is_some() || !inner.recovery_gaps.is_empty() {
+            return;
+        }
+        // Any recorded storage rejection is independent evidence of a
+        // degraded condition. Do not let an ACK for a gap clear it silently.
+        if inner.non_gap_degraded {
+            return;
+        }
+        if !inner.unacked_gap_batches.is_empty() || inner.open_meta.contains_spool_gap {
+            return;
+        }
+        inner.gap_degraded = false;
+        inner.degraded = false;
+    }
+
+    /// §10.1 lists an undisposed quarantine object as a degraded condition.
+    /// Its bytes and its events are still lost, so neither a gap ACK nor a
+    /// restart may reset the reported status while the isolated object is
+    /// still on disk.
+    fn quarantine_outstanding(&self) -> bool {
+        match fs::read_dir(self.root.join("quarantine")) {
+            Ok(mut entries) => entries.next().is_some(),
+            Err(error) if error.kind() == io::ErrorKind::NotFound => false,
+            // An unreadable quarantine directory is degraded evidence itself.
+            Err(_) => true,
+        }
+    }
+
+    pub fn health(&self) -> HealthSnapshot {
+        let mut inner = lock(&self.inner);
+        if self.spool_lock.verify().is_err() {
+            mark_storage_rejection(&mut inner, true);
+        }
+        // Once a write barrier is ambiguous, even health polling must remain
+        // read-only. The daemon-level fatal watcher will terminate the process
+        // and startup recovery will resolve the on-disk state.
+        if !inner.durability_uncertain {
+            self.check_one_sealed_integrity_locked(&mut inner);
+        }
+        let spool_bytes = inner.spool_bytes;
+        let status = if inner.degraded
+            || inner.gap_degraded
+            || !inner.spool_bytes_known
+            // A saturated counter is itself an explicit signal that the
+            // daemon observed more failures than it can represent exactly.
+            // Keep health degraded even if an older call site forgot to set
+            // the sticky flag when it reached the saturation point.
+            || inner.storage_rejected_attempts == u64::MAX
+            || inner.evicted_unacked_records == u64::MAX
+            || inner.stored_records == u64::MAX
+            || inner.sealed_batches == u64::MAX
+            || spool_bytes >= self.config.max_spool_bytes
+            || self.quarantine_outstanding()
+            || !free_space_ok(&self.root, self.config.min_free_bytes)
+            || inner
+                .producer_disconnected_at
+                .is_some_and(|at| at.elapsed() >= PRODUCER_DISCONNECT_GRACE)
+        {
+            "degraded"
+        } else {
+            "ok"
+        };
+        HealthSnapshot {
+            schema_version: 1,
+            node_id: self.config.node_id.clone(),
+            status: status.to_owned(),
+            producer_connected: inner.producer_connected,
+            producer_runtime_id: inner.producer_runtime_id.clone(),
+            last_ingest_at_unix_ms: inner.last_ingest_at_unix_ms,
+            spool_epoch: inner.epoch.clone(),
+            spool_bytes,
+            max_spool_bytes: self.config.max_spool_bytes,
+            sealed_batches: inner.sealed_batches,
+            oldest_unacked_at_unix_ms: inner.oldest_unacked_at_unix_ms,
+            stored_records: inner.stored_records,
+            storage_rejected_attempts: inner.storage_rejected_attempts,
+            evicted_unacked_records: inner.evicted_unacked_records,
+        }
+    }
+
+    /// Build the in-memory accounting index once during startup.  Recovery
+    /// already validates every trusted batch, so this scan is deliberately
+    /// kept off the request hot paths.  Later mutations adjust the counters
+    /// with local file-size deltas.
+    fn rebuild_runtime_indexes_locked(&self, inner: &mut SpoolInner) {
+        inner.last_spool_measurement = Instant::now();
+        match directory_size_status(&self.root) {
+            Ok((bytes, skipped_objects)) => {
+                inner.spool_bytes = bytes;
+                inner.spool_bytes_known = true;
+                if skipped_objects {
+                    mark_storage_rejection(inner, true);
+                }
+            }
+            Err(_) => {
+                // An unknown size must fail closed for capacity decisions and
+                // be visible to operators. Preserve the last estimate for
+                // health output, but keep capacity decisions disabled until a
+                // later bounded remeasurement succeeds.
+                inner.spool_bytes_known = false;
+                mark_storage_rejection(inner, true);
+            }
+        }
+        inner.stored_records = inner.open_meta.event_count;
+        inner.sealed_batches = 0;
+        inner.oldest_unacked_at_unix_ms = None;
+        inner.unacked_gap_batches.clear();
+        inner.sealed_received_at.clear();
+        inner.sealed_paths.clear();
+        inner.integrity_queue.clear();
+        inner.durable_gap_reasons.clear();
+        inner.open_meta.contains_spool_gap = match read_regular_file(&self.root.join("open/current.ndjson")) {
+            Ok(body) => {
+                collect_spool_gap_reasons(&body, &mut inner.durable_gap_reasons);
+                body_contains_spool_gap(&body)
+            }
+            Err(error) if error.kind() == io::ErrorKind::NotFound => false,
+            Err(_) => {
+                mark_storage_rejection(inner, true);
+                false
+            }
+        };
+        for parent_name in ["sealed", "acked"] {
+            let paths = match list_batch_dirs(&self.root.join(parent_name)) {
+                Ok(value) => value,
+                Err(_) => {
+                    mark_storage_rejection(inner, true);
+                    continue;
+                }
+            };
+            for path in paths {
+                let info = match self.read_meta(&path) {
+                    Ok(value) => value,
+                    Err(_) => {
+                        mark_storage_rejection(inner, true);
+                        continue;
+                    }
+                };
+                let Some(info) = info else {
+                    mark_storage_rejection(inner, true);
+                    continue;
+                };
+                inner.stored_records = inner.stored_records.saturating_add(info.event_count);
+                if parent_name == "sealed" {
+                    inner.sealed_batches = inner.sealed_batches.saturating_add(1);
+                    inner
+                        .sealed_received_at
+                        .insert(info.batch_id.clone(), info.first_received_at_unix_ms);
+                    inner.sealed_paths.insert(info.batch_id.clone(), path.clone());
+                    inner.integrity_queue.push_back(info.batch_id.clone());
+                    inner.oldest_unacked_at_unix_ms = Some(
+                        inner
+                            .oldest_unacked_at_unix_ms
+                            .map_or(info.first_received_at_unix_ms, |old| {
+                                old.min(info.first_received_at_unix_ms)
+                            }),
+                    );
+                }
+                match read_regular_file(&path.join("segment.ndjson")) {
+                    Ok(body) => {
+                        collect_spool_gap_reasons(&body, &mut inner.durable_gap_reasons);
+                        if parent_name == "sealed" && body_contains_spool_gap(&body) {
+                            inner.unacked_gap_batches.insert(info.batch_id);
+                        }
+                    }
+                    Err(_) => {
+                        mark_storage_rejection(inner, true);
+                    }
+                }
+            }
+        }
+        if inner.open_meta.contains_spool_gap || !inner.unacked_gap_batches.is_empty() {
+            inner.gap_degraded = true;
+        }
+    }
+
+    fn refresh_spool_bytes_locked(&self, inner: &mut SpoolInner) -> Result<(), SpoolError> {
+        inner.last_spool_measurement = Instant::now();
+        match directory_size_status(&self.root) {
+            Ok((bytes, skipped_objects)) => {
+                inner.spool_bytes = bytes;
+                inner.spool_bytes_known = true;
+                if skipped_objects {
+                    mark_storage_rejection(inner, true);
+                }
+                Ok(())
+            }
+            Err(error) => {
+                inner.spool_bytes_known = false;
+                mark_storage_rejection(inner, true);
+                Err(error.into())
+            }
+        }
+    }
+
+    fn open_contains_non_gap_locked(&self, inner: &SpoolInner) -> Result<bool, SpoolError> {
+        if inner.open_meta.event_count == 0 {
+            return Ok(false);
+        }
+        let body = read_regular_file(&self.root.join("open/current.ndjson"))?;
+        Ok(body
+            .split_inclusive(|byte| *byte == b'\n')
+            .any(|line| !line_is_spool_gap(line)))
+    }
+
+    fn check_one_sealed_integrity_locked(&self, inner: &mut SpoolInner) {
+        while let Some(batch_id) = inner.integrity_queue.pop_front() {
+            let Some(path) = inner.sealed_paths.get(&batch_id).cloned() else {
+                continue;
+            };
+            match self.read_batch(&path, false) {
+                Ok(Some(_)) => inner.integrity_queue.push_back(batch_id),
+                Ok(None)
+                | Err(SpoolError::Json(_))
+                | Err(SpoolError::Protocol(_))
+                | Err(SpoolError::InvalidState(_)) => {
+                    inner.degraded = true;
+                    mark_storage_rejection(inner, true);
+                    if self.quarantine_batch_locked(inner, &path, QUARANTINE_LABEL_UNACKED).is_err() {
+                        inner.integrity_queue.push_back(batch_id);
+                    }
+                }
+                Err(SpoolError::Io(_)) | Err(SpoolError::StorageUnavailable) | Err(SpoolError::DurabilityUncertain) => {
+                    mark_storage_rejection(inner, true);
+                    inner.integrity_queue.push_back(batch_id);
+                }
+                Err(_) => {
+                    inner.degraded = true;
+                    mark_storage_rejection(inner, true);
+                    if self.quarantine_batch_locked(inner, &path, QUARANTINE_LABEL_UNACKED).is_err() {
+                        inner.integrity_queue.push_back(batch_id);
+                    }
+                }
+            }
+            break;
+        }
+    }
+
+    fn maybe_sweep_acked_locked(&self, inner: &mut SpoolInner) {
+        if inner.last_retention_sweep.elapsed() < RETENTION_SWEEP_INTERVAL {
+            return;
+        }
+        inner.last_retention_sweep = Instant::now();
+        match unix_seconds() {
+            Ok(now) => {
+                if self
+                    .remove_aged_acked_locked(inner, now.saturating_sub(ACKED_RETENTION_SECONDS))
+                    .is_err()
+                {
+                    mark_storage_rejection(inner, true);
+                }
+            }
+            Err(_) => mark_storage_rejection(inner, true),
+        }
+        // Sealed-batch integrity must not depend on a controller health poll:
+        // advance the same bounded one-batch check from the periodic sweep.
+        // Once a write barrier is ambiguous every path stays read-only.
+        if !inner.durability_uncertain {
+            self.check_one_sealed_integrity_locked(inner);
+        }
+    }
+
+    fn adjust_spool_bytes(inner: &mut SpoolInner, delta: i128) {
+        if delta >= 0 {
+            inner.spool_bytes = inner.spool_bytes.saturating_add(delta as u64);
+        } else {
+            inner.spool_bytes = inner.spool_bytes.saturating_sub((-delta) as u64);
+        }
+    }
+
+    fn update_path_size(inner: &mut SpoolInner, path: &Path, before: u64) -> io::Result<()> {
+        let after = file_len(path)?;
+        Self::adjust_spool_bytes(inner, i128::from(after) - i128::from(before));
+        Ok(())
+    }
+
+    fn remove_tree_tracked(inner: &mut SpoolInner, path: &Path) -> io::Result<u64> {
+        // Removing a tree whose size cannot be measured would leave the
+        // incremental spool byte counter unverifiable.  Fail before the
+        // destructive operation and let the caller record degraded health.
+        let bytes = directory_size(path)?;
+        remove_path(path)?;
+        Self::adjust_spool_bytes(inner, -i128::from(bytes));
+        Ok(bytes)
+    }
+
+    fn remove_sealed_index(inner: &mut SpoolInner, info: &BatchInfo) {
+        inner.sealed_batches = inner.sealed_batches.saturating_sub(1);
+        inner.unacked_gap_batches.remove(&info.batch_id);
+        inner.sealed_received_at.remove(&info.batch_id);
+        inner.sealed_paths.remove(&info.batch_id);
+        inner.oldest_unacked_at_unix_ms = inner.sealed_received_at.values().copied().min();
+    }
+
+    fn find_batch_with_digest(&self, root: &Path, batch_id: &str) -> Result<Option<(PathBuf, BatchInfo)>, SpoolError> {
+        for path in list_batch_dirs(root)? {
+            let Some(info) = self.read_meta(&path)? else { continue };
+            if info.batch_id == batch_id {
+                return Ok(Some((path, info)));
+            }
+        }
+        Ok(None)
+    }
+
+    /// Find a sealed object associated with a pending eviction even when its
+    /// metadata no longer parses.  Batch directory names end in the random
+    /// batch ID, so this bounded fallback lets recovery quarantine a corrupt
+    /// object instead of leaving it indefinitely in the export set.
+    fn find_batch_path_by_id(&self, root: &Path, batch_id: &str) -> Result<Option<PathBuf>, SpoolError> {
+        let suffix = format!("-{batch_id}");
+        for path in list_batch_dirs(root)? {
+            let name_matches = path
+                .file_name()
+                .and_then(|value| value.to_str())
+                .is_some_and(|name| name.ends_with(&suffix));
+            let metadata_matches = !name_matches
+                && read_meta_hint(&path, &self.config.node_id).is_some_and(|info| info.batch_id == batch_id);
+            if name_matches || metadata_matches {
+                return Ok(Some(path));
+            }
+        }
+        Ok(None)
+    }
+
+    fn read_batch(&self, path: &Path, _acked: bool) -> Result<Option<BatchLease>, SpoolError> {
+        let Some(info) = self.read_meta(path)? else {
+            return Ok(None);
+        };
+        let body = read_regular_file(&path.join("segment.ndjson"))?;
+        if body.len() as u64 != info.raw_bytes || digest_hex(&body) != info.body_sha256 || !body.ends_with(b"\n") {
+            return Ok(None);
+        }
+        validate_segment_body(&body, &info, &self.config.node_id)?;
+        Ok(Some(BatchLease { info, body }))
+    }
+
+    fn read_meta(&self, path: &Path) -> Result<Option<BatchInfo>, SpoolError> {
+        if fs::symlink_metadata(path)
+            .map(|metadata| metadata.file_type().is_symlink())
+            .unwrap_or(false)
+        {
+            return Ok(None);
+        }
+        let bytes = match read_regular_file(&path.join("meta.json")) {
+            Ok(value) => value,
+            Err(error)
+                if error.kind() == io::ErrorKind::NotFound
+                    || error.kind() == io::ErrorKind::InvalidData
+                    || error.raw_os_error() == Some(libc::ELOOP) =>
+            {
+                return Ok(None);
+            }
+            Err(error) => return Err(error.into()),
+        };
+        let meta = match wire::parse_spool_meta(&bytes) {
+            Ok(value) => value,
+            Err(_) => return Ok(None),
+        };
+        if meta.node_id != self.config.node_id {
+            return Ok(None);
+        }
+        let info = BatchInfo {
+            node_id: meta.node_id,
+            spool_epoch: meta.spool_epoch,
+            batch_id: meta.batch_id,
+            first_spool_sequence: meta.first_spool_sequence.0,
+            last_spool_sequence: meta.last_spool_sequence.0,
+            event_count: meta.event_count.0,
+            raw_bytes: meta.raw_bytes.0,
+            body_sha256: meta.body_sha256,
+            first_received_at_unix_ms: meta.first_received_at_unix_ms.0,
+            last_received_at_unix_ms: meta.last_received_at_unix_ms.0,
+            path: path.to_path_buf(),
+        };
+        if info.first_spool_sequence == 0
+            || info.last_spool_sequence < info.first_spool_sequence
+            || info.event_count == 0
+            || info.last_received_at_unix_ms < info.first_received_at_unix_ms
+        {
+            return Ok(None);
+        }
+        Ok(Some(info))
+    }
+
+    /// Move a malformed sealed/acked object out of the export set and queue a
+    /// durable corruption gap.  Metadata is copied only when the strict meta
+    /// document itself is valid; body corruption must not erase trustworthy
+    /// batch/range evidence from the diagnostic record.
+    fn quarantine_batch_locked(&self, inner: &mut SpoolInner, path: &Path, label: &str) -> Result<(), SpoolError> {
+        // The fatal state is a precondition of every write, not only of the
+        // public entry points: `mark_durability_uncertain_locked` can fire in
+        // the middle of a call, and anything written afterwards would carry an
+        // unproven `(spool_epoch, spool_sequence)`.
+        Self::reject_if_durability_uncertain(inner)?;
+        let hint = read_meta_hint(path, &self.config.node_id);
+        inner.gap_degraded = true;
+        // Persist a transaction marker before moving the damaged object.  The
+        // marker carries the fixed gap ID and survives a crash between the
+        // rename and gap write; recovery then completes the same transaction
+        // rather than inventing a second gap. A pending state-reset owns the
+        // first sequence in a fresh epoch, so defer this operation until that
+        // barrier has completed.
+        if inner.pending_state_reset.is_some() {
+            return Err(SpoolError::StorageUnavailable);
+        }
+        let basename = path
+            .file_name()
+            .and_then(|value| value.to_str())
+            .ok_or_else(|| SpoolError::InvalidState("invalid quarantine basename".to_owned()))?
+            .to_owned();
+        // Reuse an outstanding quarantine transaction when a prior attempt
+        // stopped before its rename.  Generating a fresh gap ID here would
+        // leave two pending entries for the same poison object after a retry.
+        let existing_pending = inner.tombstones.iter().find_map(|entry| {
+            let TombstoneEntry::QuarantinePending(value) = entry else {
+                return None;
+            };
+            let same_basename = value.quarantine_basename == basename;
+            let same_batch = hint
+                .as_ref()
+                .and_then(|info| value.batch_id.as_deref().map(|batch| batch == info.batch_id))
+                .unwrap_or(false);
+            (same_basename || same_batch).then(|| value.clone())
+        });
+        let gap = if let Some(pending) = existing_pending.as_ref() {
+            match load_recovery_gap_marker(&self.root, &pending.gap_event_id) {
+                Ok(Some(spec)) => spec,
+                Ok(None) => GapSpec {
+                    event_id: pending.gap_event_id.clone(),
+                    occurred_at_unix_ms: pending.recorded_at_unix_ms.0,
+                    lost_spool_epoch: pending.spool_epoch.clone(),
+                    reason: wire::SpoolGapReason::SegmentCorruption,
+                    first_lost_spool_sequence: pending.first_spool_sequence.map(|value| value.0),
+                    last_lost_spool_sequence: pending.last_spool_sequence.map(|value| value.0),
+                    lost_events: pending.event_count.map(|value| value.0),
+                    lost_bytes: pending.raw_bytes.map(|value| value.0),
+                    lost_batch_id: pending.batch_id.clone(),
+                    source_fingerprint: None,
+                },
+                Err(error) => {
+                    // The marker carries the fixed transaction identity. Do
+                    // not rename the source or manufacture a fallback gap
+                    // while its contents are unreadable; the pending
+                    // ledger/marker remains retryable for a later operation.
+                    mark_storage_rejection(inner, true);
+                    return Err(error);
+                }
+            }
+        } else {
+            corruption_gap_spec(hint.as_ref(), None)?
+        };
+        let pending = existing_pending.unwrap_or_else(|| {
+            let mut pending = wire::QuarantinePending::new(
+                gap.event_id.clone(),
+                basename.clone(),
+                gap.occurred_at_unix_ms,
+                hint.as_ref().map(|value| value.batch_id.clone()),
+                hint.as_ref().map(|value| value.body_sha256.clone()),
+                hint.as_ref().map(|value| value.spool_epoch.clone()),
+                hint.as_ref().map(|value| value.first_spool_sequence),
+                hint.as_ref().map(|value| value.last_spool_sequence),
+                hint.as_ref().map(|value| value.event_count),
+                hint.as_ref().map(|value| value.raw_bytes),
+            );
+            pending.reason = "segment_corruption".to_owned();
+            pending
+        });
+        // Persist the exact gap intent before either the tombstone or the
+        // destructive rename.  This closes both crash windows: a restart can
+        // reuse the same ID even if it stops before the pending ledger entry
+        // is written, and it can finish the gap after the source is moved.
+        if let Err(error) = self.persist_recovery_gap_marker_locked(inner, &gap) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            return Err(error);
+        }
+        if let Err(error) = self.add_tombstone_locked(inner, TombstoneEntry::QuarantinePending(pending.clone())) {
+            // No object has moved yet.  Best-effort removal avoids replaying a
+            // false loss gap on the next operation; if unlink itself fails,
+            // retaining the marker is the conservative crash-safe outcome.
+            let _ = remove_recovery_gap_marker_locked(&self.root, inner, &gap.event_id);
+            return Err(error);
+        }
+        let target = match quarantine_path(&self.root, path, label) {
+            Ok(target) => target,
+            Err(error) => {
+                // rename(2) may already have removed the trusted source before
+                // a following directory fsync failed. Rebuild the exceptional
+                // indexes so health never retains a ghost sealed batch.
+                if !path.exists() {
+                    self.rebuild_runtime_indexes_locked(inner);
+                }
+                return Err(error);
+            }
+        };
+        // The source batch left sealed/ before the gap write. Keep the health
+        // index aligned even if the subsequent diagnostic append hits ENOSPC;
+        // the durable pending marker will make that gap retryable.
+        let from_trusted_dir = path
+            .parent()
+            .is_some_and(|parent| parent.ends_with("sealed") || parent.ends_with("acked"));
+        if let Some(info) = hint.as_ref() {
+            if path.parent().is_some_and(|parent| parent.ends_with("sealed")) {
+                Self::remove_sealed_index(inner, info);
+            }
+            // `stored_records` covers both sealed and acked directories.  A
+            // corrupt ACKed batch is still counted by the startup metadata
+            // scan until this quarantine transaction removes it from the
+            // trusted set.
+            if from_trusted_dir {
+                inner.stored_records = inner.stored_records.saturating_sub(info.event_count);
+            }
+        } else if from_trusted_dir {
+            // An unparsable meta.json is the main quarantine trigger, so the
+            // index update must never be gated on the hint.  Without this the
+            // sealed indexes and `stored_records` keep a ghost entry for an
+            // object that no longer exists: `oldest_unacked_at_unix_ms` never
+            // returns to null (§10.1) and the next integrity sweep publishes a
+            // second, empty `segment_corruption` gap for the vanished batch.
+            // Recovery remeasures the same way when a moved source carries no
+            // trustworthy metadata.
+            self.rebuild_runtime_indexes_locked(inner);
+        }
+        // The source/target directory barriers are part of quarantine_path.
+        // Now the fixed gap can be written even when ordinary capacity is at
+        // the limit: it is the durable accounting for the bytes just isolated.
+        if let Err(error) = self.write_gap_locked(inner, &gap) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            return Err(error);
+        }
+        if let Err(error) = remove_recovery_gap_marker_locked(&self.root, inner, &gap.event_id) {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            return Err(error);
+        }
+        if let Some(index) = inner.tombstones.iter().position(|entry| {
+            matches!(entry, TombstoneEntry::QuarantinePending(value) if value.gap_event_id == pending.gap_event_id)
+        }) {
+            self.remove_tombstone_locked(inner, index)?.finish()?;
+        }
+        // A rename does not change total bytes, but it does change the
+        // trusted record indexes when the source was a sealed batch.
+        let _ = target;
+        Ok(())
+    }
+
+    fn write_record_locked(
+        &self,
+        inner: &mut SpoolInner,
+        wrapper: &[u8],
+        sequence: u64,
+        received_at_unix_ms: u64,
+    ) -> Result<(), SpoolError> {
+        // See `quarantine_batch_locked`: a barrier that became fatal earlier in
+        // this same call must stop the write here, before the producer event
+        // can be persisted and acknowledged.
+        Self::reject_if_durability_uncertain(inner)?;
+        self.ensure_open_file_bound(inner)?;
+        let old_len = inner.open_file.metadata()?.len();
+        let old_meta = inner.open_meta.clone();
+        let old_next_sequence = inner.next_sequence;
+        if let Err(error) = Self::write_and_sync_open_locked(inner, wrapper) {
+            if self.rollback_open_record_locked(inner, old_len).is_err() {
+                return Err(self.mark_durability_uncertain_locked(inner));
+            }
+            inner.open_meta = old_meta;
+            inner.next_sequence = old_next_sequence;
+            return Err(error.into());
+        }
+        // `write_all` may have appended only a prefix before failing; the
+        // rollback above restores the pre-write length.  Account the bytes
+        // only after the complete write+sync barrier succeeds.
+        Self::adjust_spool_bytes(inner, i128::from(wrapper.len() as u64));
+        inner.stored_records = inner.stored_records.saturating_add(1);
+        // An empty open segment has no age.  Start the max-age timer at the
+        // first durable record rather than at daemon start (or the previous
+        // seal), otherwise a quiet node seals its first later event
+        // immediately after a long idle period.
+        if inner.open_meta.event_count == 0 {
+            inner.open_meta.opened_at = SystemTime::now();
+        }
+        update_open_metadata(
+            &mut inner.open_meta,
+            sequence,
+            received_at_unix_ms,
+            wrapper.len() as u64,
+        );
+        inner.open_meta.contains_spool_gap |= line_is_spool_gap(wrapper);
+        let next = sequence.checked_add(1).ok_or(SpoolError::SequenceExhausted)?;
+        inner.next_sequence = next;
+        if let Err(error) = self.persist_state_locked(inner, inner.pending_state_reset.clone()) {
+            match error {
+                AtomicWriteError::BeforeRename(error) => {
+                    let rollback = self.rollback_open_record_locked(inner, old_len);
+                    if rollback.is_ok() {
+                        Self::adjust_spool_bytes(inner, -i128::from(wrapper.len() as u64));
+                        inner.stored_records = inner.stored_records.saturating_sub(1);
+                        inner.open_meta = old_meta;
+                        inner.next_sequence = old_next_sequence;
+                    } else {
+                        return Err(self.mark_durability_uncertain_locked(inner));
+                    }
+                    return Err(error);
+                }
+                AtomicWriteError::AfterRename(_) => {
+                    // The new state cursor is already visible and may become
+                    // durable despite the reported error. Keep the matching
+                    // open record and advanced in-memory cursor intact; a
+                    // rollback here could leave a silent sequence hole or let
+                    // this process reuse a cursor already committed to disk.
+                    return Err(self.mark_durability_uncertain_locked(inner));
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn write_and_sync_open_locked(inner: &mut SpoolInner, wrapper: &[u8]) -> io::Result<()> {
+        #[cfg(test)]
+        if std::mem::take(&mut inner.faults.partial_write) {
+            let partial = wrapper.len().div_ceil(2).min(wrapper.len());
+            inner.open_file.write_all(wrapper.get(..partial).unwrap_or(wrapper))?;
+            return Err(io::Error::other("injected partial open-segment write"));
+        }
+
+        inner.open_file.write_all(wrapper)?;
+        #[cfg(test)]
+        if std::mem::take(&mut inner.faults.sync_data) {
+            return Err(io::Error::other("injected open-segment sync failure"));
+        }
+        inner.open_file.sync_data()
+    }
+
+    fn rollback_open_record_locked(&self, inner: &mut SpoolInner, old_len: u64) -> io::Result<()> {
+        #[cfg(test)]
+        if std::mem::take(&mut inner.faults.rollback) {
+            return Err(io::Error::other("injected open-segment rollback failure"));
+        }
+        rollback_open_record(&self.root, &mut inner.open_file, old_len)
+    }
+
+    fn mark_durability_uncertain_locked(&self, inner: &mut SpoolInner) -> SpoolError {
+        if !inner.durability_uncertain {
+            inner.durability_uncertain = true;
+            inner.spool_bytes_known = false;
+            mark_storage_rejection(inner, true);
+            self.durability_uncertain_tx.send_replace(true);
+        }
+        SpoolError::DurabilityUncertain
+    }
+
+    fn reject_if_durability_uncertain(inner: &mut SpoolInner) -> Result<(), SpoolError> {
+        if inner.durability_uncertain {
+            // Every caller-visible rejection is part of the cumulative health
+            // contract, even during the short interval before daemon shutdown.
+            mark_storage_rejection(inner, true);
+            return Err(SpoolError::DurabilityUncertain);
+        }
+        Ok(())
+    }
+
+    fn persist_state_locked(
+        &self,
+        inner: &mut SpoolInner,
+        pending_state_reset: Option<PendingStateReset>,
+    ) -> Result<(), AtomicWriteError> {
+        #[cfg(test)]
+        if std::mem::take(&mut inner.faults.persist_state) {
+            return Err(AtomicWriteError::BeforeRename(
+                io::Error::other("injected state persistence failure").into(),
+            ));
+        }
+        let path = self.root.join("state.json");
+        let before = file_len(&path).map_err(|error| AtomicWriteError::BeforeRename(error.into()))?;
+        let result = persist_state_atomic(&self.root, &inner.epoch, inner.next_sequence, pending_state_reset);
+        #[cfg(test)]
+        let result = if result.is_ok() && std::mem::take(&mut inner.faults.persist_state_after_commit) {
+            Err(AtomicWriteError::AfterRename(
+                io::Error::other("injected state failure after durable commit").into(),
+            ))
+        } else {
+            result
+        };
+
+        // Once rename has succeeded, the caller must not roll back the
+        // corresponding open record: state.json may already contain the
+        // advanced cursor.
+        if result.is_ok() || matches!(&result, Err(AtomicWriteError::AfterRename(_))) {
+            #[cfg(test)]
+            let accounting = if std::mem::take(&mut inner.faults.persist_state_accounting) {
+                Err(io::Error::other("injected state path-size accounting failure"))
+            } else {
+                Spool::update_path_size(inner, &path, before)
+            };
+            #[cfg(not(test))]
+            let accounting = Spool::update_path_size(inner, &path, before);
+            if accounting.is_err() {
+                // A post-commit accounting read says nothing about the write
+                // barrier that already ran.  When the barrier succeeded the
+                // state on disk is exactly what memory holds; only the
+                // incremental byte index is now untrustworthy, and clearing
+                // `spool_bytes_known` forces a full measurement before the
+                // next capacity decision.  Escalating to `DurabilityUncertain`
+                // would stop the daemon over an accounting read on the
+                // per-record write path.  `OPERATIONS.md` scopes the
+                // fail-closed exit to a write barrier whose *outcome* cannot
+                // be determined; this is not that.  When the barrier itself
+                // returned `AfterRename`, that original error is what
+                // escalates below.
+                inner.spool_bytes_known = false;
+                mark_storage_rejection(inner, true);
+            }
+        }
+        result
+    }
+
+    fn ensure_open_file_bound(&self, inner: &mut SpoolInner) -> Result<(), SpoolError> {
+        let path = self.root.join("open/current.ndjson");
+        let opened = inner.open_file.metadata()?;
+        let current = fs::symlink_metadata(&path);
+        let descriptor_is_bound = current
+            .as_ref()
+            .is_ok_and(|value| value.is_file() && value.dev() == opened.dev() && value.ino() == opened.ino())
+            && opened.len() == inner.open_meta.bytes;
+        if descriptor_is_bound {
+            if !inner.spool_bytes_known {
+                self.refresh_spool_bytes_locked(inner)?;
+            }
+            return Ok(());
+        }
+        if inner.open_meta.event_count > 0 || inner.open_meta.bytes > 0 {
+            return Err(SpoolError::InvalidState(
+                "open segment descriptor/path/metadata mismatch".to_owned(),
+            ));
+        }
+        let file = OpenOptions::new()
+            .create(true)
+            .read(true)
+            .append(true)
+            .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+            .mode(0o600)
+            .open(&path)?;
+        set_file_mode(&path, 0o600)?;
+        file.sync_all()?;
+        sync_dir(&self.root.join("open"))?;
+        let file_metadata = file.metadata()?;
+        if file_metadata.len() != 0 {
+            let spec = orphan_open_gap_spec(&self.config.node_id, &inner.epoch, &file_metadata);
+            let orphan = self
+                .root
+                .join("quarantine")
+                .join(format!("orphan-open-{}", random_hex_id()?));
+
+            #[cfg(test)]
+            if std::mem::take(&mut inner.faults.recovery_marker) {
+                return Err(io::Error::other("injected recovery marker failure").into());
+            }
+            // The fixed marker is the recovery proof for every crash window
+            // below. Never move the only copy of ambiguous bytes before this
+            // intent and its parent-directory barrier are durable.
+            self.persist_recovery_gap_marker_locked(inner, &spec)?;
+            if !inner
+                .recovery_gaps
+                .iter()
+                .any(|queued| queued.event_id == spec.event_id)
+            {
+                inner.recovery_gaps.push_back(spec.clone());
+            }
+            inner.spool_bytes_known = false;
+            #[cfg(test)]
+            if std::mem::take(&mut inner.faults.orphan_after_marker) {
+                return Err(io::Error::other("injected failure after orphan marker").into());
+            }
+
+            fs::rename(&path, &orphan)?;
+            sync_dir(&self.root.join("open"))?;
+            sync_dir(&self.root.join("quarantine"))?;
+            #[cfg(test)]
+            if std::mem::take(&mut inner.faults.orphan_after_rename) {
+                return Err(io::Error::other("injected failure after orphan rename").into());
+            }
+
+            inner.degraded = true;
+            inner.gap_degraded = true;
+            inner.non_gap_degraded = true;
+            let new_file = OpenOptions::new()
+                .create_new(true)
+                .read(true)
+                .append(true)
+                .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+                .mode(0o600)
+                .open(&path)?;
+            new_file.set_permissions(fs::Permissions::from_mode(0o600))?;
+            #[cfg(test)]
+            if std::mem::take(&mut inner.faults.orphan_new_open_sync) {
+                return Err(io::Error::other("injected replacement open sync failure").into());
+            }
+            new_file.sync_all()?;
+            sync_dir(&self.root.join("open"))?;
+            inner.open_meta = OpenMetadata::empty();
+            inner.open_file = new_file;
+            // The rename retains every byte under quarantine, so incremental
+            // accounting would be easy to get wrong after any intermediate
+            // failure. Re-measure once before admitting another mutation.
+            self.refresh_spool_bytes_locked(inner)?;
+            // Do not recursively flush the queue from inside the gap writer's
+            // own inode-binding check. Returning one retryable failure makes
+            // the next top-level mutation durably write this fixed gap first;
+            // otherwise an outer write_gap call could append the same ID again
+            // after an inner flush completed it.
+            return Err(SpoolError::StorageUnavailable);
+        }
+        // Rebind before the fallible measurement so no later retry can write
+        // through the old descriptor after the pathname was moved.
+        inner.open_file = file;
+        if !inner.spool_bytes_known {
+            self.refresh_spool_bytes_locked(inner)?;
+        }
+        Ok(())
+    }
+
+    fn flush_state_reset_locked(&self, inner: &mut SpoolInner) -> Result<(), SpoolError> {
+        let Some(pending) = inner.pending_state_reset.clone() else {
+            return Ok(());
+        };
+        inner.gap_degraded = true;
+        // If recovery already found the fixed gap, only the state transition is
+        // needed.  Otherwise write that exact event before clearing pending.
+        if !inner.durable_gap_reasons.contains_key(&pending.gap_event_id) {
+            let spec = GapSpec {
+                event_id: pending.gap_event_id.clone(),
+                occurred_at_unix_ms: pending.occurred_at_unix_ms.0,
+                lost_spool_epoch: pending.lost_spool_epoch.clone(),
+                reason: wire::SpoolGapReason::StateReset,
+                first_lost_spool_sequence: pending.first_lost_spool_sequence.map(|v| v.0),
+                last_lost_spool_sequence: pending.last_lost_spool_sequence.map(|v| v.0),
+                lost_events: None,
+                lost_bytes: None,
+                lost_batch_id: None,
+                source_fingerprint: None,
+            };
+            self.write_gap_locked(inner, &spec)?;
+        }
+        // Keep the marker in memory until the clearing state write itself is
+        // durable.  If that second barrier fails, a retry must rediscover the
+        // same gap ID rather than accepting ordinary records with an
+        // unproven cursor.
+        inner.pending_state_reset = None;
+        if let Err(error) = self.persist_state_locked(inner, None) {
+            return match error {
+                AtomicWriteError::BeforeRename(error) => {
+                    inner.pending_state_reset = Some(pending);
+                    Err(error)
+                }
+                AtomicWriteError::AfterRename(_) => Err(self.mark_durability_uncertain_locked(inner)),
+            };
+        }
+        Ok(())
+    }
+
+    fn discard_recovery_gap_locked(&self, inner: &mut SpoolInner, event_id: &str) -> Result<(), SpoolError> {
+        remove_recovery_gap_marker_locked(&self.root, inner, event_id)?;
+        inner.recovery_gaps.retain(|spec| spec.event_id != event_id);
+        Ok(())
+    }
+
+    fn flush_recovery_gaps_locked(&self, inner: &mut SpoolInner) -> Result<(), SpoolError> {
+        while let Some(spec) = inner.recovery_gaps.front().cloned() {
+            if inner.durable_gap_reasons.contains_key(&spec.event_id) {
+                // The gap may have reached a durable segment just before a
+                // crash (or in another epoch).  Keep the queue head until the
+                // private intent marker is removed successfully; otherwise a
+                // failed unlink would make every restart rediscover it.
+                remove_recovery_gap_marker_locked(&self.root, inner, &spec.event_id)?;
+                inner.recovery_gaps.pop_front();
+                continue;
+            }
+            self.write_gap_locked(inner, &spec)?;
+            // A marker is an intent, not a wire record.  Remove it only after
+            // the gap's open-segment and cursor barriers have completed.
+            // Leaving the queue head in place on unlink failure makes the
+            // operation retryable without generating a second event ID.
+            remove_recovery_gap_marker_locked(&self.root, inner, &spec.event_id)?;
+            inner.recovery_gaps.pop_front();
+        }
+        if !inner.spool_bytes_known {
+            self.refresh_spool_bytes_locked(inner)?;
+        }
+        Ok(())
+    }
+
+    fn write_gap_locked(&self, inner: &mut SpoolInner, spec: &GapSpec) -> Result<(), SpoolError> {
+        validate_gap_spec(spec)?;
+        if inner.durable_gap_reasons.contains_key(&spec.event_id) {
+            return Ok(());
+        }
+        let gap = wire::SpoolGap {
+            schema_version: wire::SCHEMA_VERSION,
+            record_type: "diagnostic".to_owned(),
+            event_type: "spool_gap".to_owned(),
+            event_id: spec.event_id.clone(),
+            occurred_at_unix_ms: spec.occurred_at_unix_ms.into(),
+            node_id: self.config.node_id.clone(),
+            spool_epoch: inner.epoch.clone(),
+            lost_spool_epoch: spec.lost_spool_epoch.clone(),
+            reason: spec.reason,
+            first_lost_spool_sequence: spec.first_lost_spool_sequence.map(Into::into),
+            last_lost_spool_sequence: spec.last_lost_spool_sequence.map(Into::into),
+            lost_events: spec.lost_events.map(Into::into),
+            lost_bytes: spec.lost_bytes.map(Into::into),
+            lost_batch_id: spec.lost_batch_id.clone(),
+        };
+        let bytes = wire::serialize_canonical_record(&wire::AuditRecord::SpoolGap(gap))
+            .map_err(ProtocolError::from)
+            .map_err(SpoolError::Protocol)?;
+        let sequence = inner.next_sequence;
+        if sequence == u64::MAX {
+            return Err(SpoolError::SequenceExhausted);
+        }
+        let wrapper = wrapper_bytes(&inner.epoch, sequence, spec.occurred_at_unix_ms, &bytes)?;
+        if wrapper.len() as u64 > self.config.segment_max_bytes {
+            return Err(SpoolError::StorageUnavailable);
+        }
+        if inner.open_meta.bytes > 0
+            && inner.open_meta.bytes.saturating_add(wrapper.len() as u64) > self.config.segment_max_bytes
+        {
+            self.seal_locked(inner)?;
+        }
+        // Diagnostic gaps are the durable evidence of capacity/quarantine
+        // loss. They must remain writable after the cleanup transaction has
+        // already moved the lost object, even when ordinary capacity
+        // watermarks are still exceeded. Segment-size and real filesystem I/O
+        // barriers above continue to apply.
+        self.write_record_locked(inner, &wrapper, sequence, spec.occurred_at_unix_ms)?;
+        inner.durable_gap_reasons.insert(spec.event_id.clone(), spec.reason);
+        if inner.open_meta.bytes >= self.config.segment_max_bytes {
+            self.seal_locked(inner)?;
+        }
+        Ok(())
+    }
+
+    fn capacity_ok(&self, inner: &SpoolInner, additional: u64) -> bool {
+        let size_ok = inner.spool_bytes_known
+            && inner
+                .spool_bytes
+                .checked_add(additional)
+                .is_some_and(|size| size <= self.config.max_spool_bytes);
+        size_ok && free_space_ok(&self.root, self.config.min_free_bytes)
+    }
+
+    fn ensure_capacity_locked(&self, inner: &mut SpoolInner, additional: u64) -> Result<(), SpoolError> {
+        if !inner.spool_bytes_known {
+            self.refresh_spool_bytes_locked(inner)?;
+        }
+        if self.capacity_ok(inner, additional) {
+            return Ok(());
+        }
+        self.cleanup_locked(inner, additional)?;
+        if self.capacity_ok(inner, additional) {
+            Ok(())
+        } else {
+            Err(SpoolError::StorageUnavailable)
+        }
+    }
+
+    /// Bytes a cleanup candidate actually handed back to the filesystem.  A
+    /// rename into `quarantine/` frees nothing, and a candidate whose durable
+    /// gap costs more than it releases is not progress either.  The caller
+    /// sums these per-candidate amounts so one such write cannot cancel out
+    /// the bytes the other candidates released in the same iteration.
+    fn released_bytes(inner: &SpoolInner, start_bytes: u64) -> u64 {
+        start_bytes.saturating_sub(inner.spool_bytes)
+    }
+
+    fn cleanup_locked(&self, inner: &mut SpoolInner, additional: u64) -> Result<(), SpoolError> {
+        let now_seconds = match unix_seconds() {
+            Ok(value) => value,
+            Err(error) => {
+                mark_storage_rejection(inner, true);
+                return Err(error);
+            }
+        };
+        // A failed seal can leave private atomic-write objects outside the
+        // normal batch candidate list. Reconcile only on this exceptional
+        // capacity path; ordinary append/health calls retain the incremental
+        // index and do not walk the spool tree.
+        let mut first_error = match self.recover_runtime_temp_objects_locked(inner) {
+            Ok(()) => None,
+            Err(error) => {
+                inner.degraded = true;
+                inner.non_gap_degraded = true;
+                inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                Some(error)
+            }
+        };
+        let aged_error = self
+            .remove_aged_acked_locked(inner, now_seconds.saturating_sub(ACKED_RETENTION_SECONDS))
+            .err();
+        if first_error.is_none() {
+            first_error = aged_error;
+        }
+        // Seal the active producer segment at most once per cleanup call. Any
+        // gaps created by the eviction work below remain open and can never
+        // feed a seal -> evict -> gap cycle in this same critical section.
+        let open_has_non_gap = match self.open_contains_non_gap_locked(inner) {
+            Ok(value) => value,
+            Err(error) => {
+                first_error.get_or_insert(error);
+                false
+            }
+        };
+        if !self.capacity_ok(inner, additional) && open_has_non_gap {
+            if let Err(error) = self.seal_locked(inner) {
+                first_error.get_or_insert(error);
+                inner.degraded = true;
+                inner.non_gap_degraded = true;
+                inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+            }
+        }
+        let mut iterations = 0_usize;
+        while !self.capacity_ok(inner, additional) {
+            if iterations >= MAX_CLEANUP_ITERATIONS {
+                break;
+            }
+            iterations += 1;
+            // Track what this iteration really released.  Comparing the
+            // iteration's start and end totals charges every candidate with
+            // the corruption gap another candidate had to write, which made
+            // the §24 scenario (one corrupt acked batch plus two healthy
+            // sealed batches) need a second cleanup call before capacity
+            // recovered.
+            let mut iteration_released = 0_u64;
+            let mut progressed = false;
+            let mut paths = match list_batch_dirs(&self.root.join("acked")) {
+                Ok(value) => value,
+                Err(error) => {
+                    mark_storage_rejection(inner, true);
+                    return Err(first_error.unwrap_or_else(|| error.into()));
+                }
+            };
+            paths.sort_by(|left, right| {
+                acked_timestamp(left)
+                    .unwrap_or(u64::MAX)
+                    .cmp(&acked_timestamp(right).unwrap_or(u64::MAX))
+                    .then_with(|| left.cmp(right))
+            });
+            for path in paths {
+                let candidate_start_bytes = inner.spool_bytes;
+                let info = match self.read_meta(&path) {
+                    Ok(value) => value,
+                    Err(error) => {
+                        mark_storage_rejection(inner, true);
+                        first_error.get_or_insert(error);
+                        continue;
+                    }
+                };
+                let Some(info) = info else {
+                    inner.degraded = true;
+                    if let Err(error) = self.quarantine_batch_locked(inner, &path, QUARANTINE_LABEL_ACKED) {
+                        first_error.get_or_insert(error);
+                        inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                    }
+                    let freed = Self::released_bytes(inner, candidate_start_bytes);
+                    iteration_released = iteration_released.saturating_add(freed);
+                    progressed = freed > 0;
+                    // Mirror the quarantine/sealed branches: reaching the
+                    // capacity target is progress for this iteration.  Leaving
+                    // `progressed` false here made a break on `capacity_ok`
+                    // fall through to the quarantine loop and evict one more
+                    // isolated object that nothing required.
+                    if progressed || self.capacity_ok(inner, additional) {
+                        progressed = true;
+                        break;
+                    }
+                    continue;
+                };
+                // ACK receipts are the durable proof needed for retention
+                // cleanup. Do not re-hash every acknowledged body while the
+                // global spool lock is held; corruption is detected on
+                // recovery/lease paths and the receipt remains authoritative.
+                if let Err(error) = self.ensure_receipt_for_batch_locked(inner, &info) {
+                    first_error.get_or_insert(error);
+                    inner.degraded = true;
+                    inner.non_gap_degraded = true;
+                    inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                    continue;
+                }
+                match Self::remove_tree_tracked(inner, &path) {
+                    Ok(_) => {
+                        inner.stored_records = inner.stored_records.saturating_sub(info.event_count);
+                        iteration_released =
+                            iteration_released.saturating_add(Self::released_bytes(inner, candidate_start_bytes));
+                        progressed = true;
+                        if let Err(error) = sync_dir(&self.root.join("acked")) {
+                            first_error.get_or_insert(error.into());
+                            mark_storage_rejection(inner, true);
+                        }
+                    }
+                    Err(error) => {
+                        first_error.get_or_insert(error.into());
+                        inner.degraded = true;
+                        inner.non_gap_degraded = true;
+                        inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                    }
+                }
+                if progressed || self.capacity_ok(inner, additional) || inner.spool_bytes < candidate_start_bytes {
+                    progressed = true;
+                    break;
+                }
+            }
+            if progressed {
+                if self.capacity_ok(inner, additional) {
+                    break;
+                }
+                if iteration_released == 0 {
+                    break;
+                }
+                continue;
+            }
+            let mut quarantine = match list_entries(&self.root.join("quarantine")) {
+                Ok(value) => value,
+                Err(error) => {
+                    mark_storage_rejection(inner, true);
+                    return Err(first_error.unwrap_or_else(|| error.into()));
+                }
+            };
+            quarantine.sort_by(|left, right| {
+                path_age_key(left)
+                    .cmp(&path_age_key(right))
+                    .then_with(|| left.cmp(right))
+            });
+            for path in quarantine {
+                let candidate_start_bytes = inner.spool_bytes;
+                if let Err(error) = self.evict_quarantine_locked(inner, &path) {
+                    first_error.get_or_insert(error);
+                    inner.degraded = true;
+                    inner.non_gap_degraded = true;
+                    inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                }
+                let freed = Self::released_bytes(inner, candidate_start_bytes);
+                iteration_released = iteration_released.saturating_add(freed);
+                progressed = freed > 0;
+                if progressed || self.capacity_ok(inner, additional) {
+                    progressed = true;
+                    break;
+                }
+            }
+            if progressed {
+                if self.capacity_ok(inner, additional) {
+                    break;
+                }
+                if iteration_released == 0 {
+                    break;
+                }
+                continue;
+            }
+            let mut sealed = Vec::new();
+            let sealed_paths = match list_batch_dirs(&self.root.join("sealed")) {
+                Ok(value) => value,
+                Err(error) => {
+                    mark_storage_rejection(inner, true);
+                    return Err(first_error.unwrap_or_else(|| error.into()));
+                }
+            };
+            for path in sealed_paths {
+                let key = match self.read_meta(&path) {
+                    Ok(value) => value.map(|info| {
+                        (
+                            info.first_received_at_unix_ms,
+                            info.first_spool_sequence,
+                            info.spool_epoch,
+                            info.batch_id,
+                        )
+                    }),
+                    Err(error) => {
+                        mark_storage_rejection(inner, true);
+                        first_error.get_or_insert(error);
+                        None
+                    }
+                };
+                sealed.push((key, path));
+            }
+            sealed.sort_by(|(left_key, left_path), (right_key, right_path)| {
+                left_key.cmp(right_key).then_with(|| left_path.cmp(right_path))
+            });
+            for (_, path) in sealed {
+                let candidate_start_bytes = inner.spool_bytes;
+                if let Err(error) = self.evict_sealed_locked(inner, &path) {
+                    first_error.get_or_insert(error);
+                    inner.degraded = true;
+                    inner.non_gap_degraded = true;
+                    inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                }
+                let freed = Self::released_bytes(inner, candidate_start_bytes);
+                iteration_released = iteration_released.saturating_add(freed);
+                progressed = freed > 0;
+                if progressed || self.capacity_ok(inner, additional) {
+                    progressed = true;
+                    break;
+                }
+            }
+            if progressed {
+                if self.capacity_ok(inner, additional) {
+                    break;
+                }
+                if iteration_released == 0 {
+                    break;
+                }
+                continue;
+            }
+            break;
+        }
+        if inner.durability_uncertain {
+            // Freeing capacity does not repair an ambiguous write barrier; the
+            // caller must never proceed to the producer record after one.
+            inner.degraded = true;
+            return Err(SpoolError::DurabilityUncertain);
+        }
+        if self.capacity_ok(inner, additional) {
+            if first_error.is_some() {
+                inner.degraded = true;
+            }
+            Ok(())
+        } else {
+            Err(first_error.unwrap_or(SpoolError::StorageUnavailable))
+        }
+    }
+
+    /// Reclaim or finish seal temporaries that are invisible to
+    /// `list_batch_dirs`.  A complete temporary batch is promoted only after
+    /// its metadata, body digest, framing and sequence range all validate.
+    /// A segment-bearing object that cannot be validated is retained as
+    /// recovery evidence and keeps health degraded; deleting it here would
+    /// silently lose events merely because the daemon is under pressure.
+    fn recover_runtime_temp_objects_locked(&self, inner: &mut SpoolInner) -> Result<(), SpoolError> {
+        let removed_bytes = match cleanup_recovered_temp_files(&self.root) {
+            Ok(bytes) => bytes,
+            Err(error) => {
+                // The cleanup helper can fail after unlinking an earlier temp
+                // object. A fresh measurement is the only safe accounting
+                // result when the partial byte total was not returned.
+                self.rebuild_runtime_indexes_locked(inner);
+                return Err(error.into());
+            }
+        };
+        if removed_bytes != 0 {
+            Self::adjust_spool_bytes(inner, -i128::from(removed_bytes));
+        }
+        let sealed_root = self.root.join("sealed");
+        let mut changed = removed_bytes != 0;
+        let mut promoted_open_range = false;
+        let hidden_paths = match list_hidden_dirs(&sealed_root) {
+            Ok(paths) => paths,
+            Err(error) => {
+                if changed {
+                    self.rebuild_runtime_indexes_locked(inner);
+                }
+                return Err(error);
+            }
+        };
+        for path in hidden_paths {
+            let Some(name) = path.file_name().and_then(|value| value.to_str()) else {
+                continue;
+            };
+            if !name.starts_with(".tmp-") {
+                continue;
+            }
+            let segment = path.join("segment.ndjson");
+            match fs::symlink_metadata(&segment) {
+                Ok(metadata) if metadata.is_file() => {}
+                Ok(_) => {
+                    // A non-regular segment is not safe to inspect or remove.
+                    inner.degraded = true;
+                    inner.non_gap_degraded = true;
+                    continue;
+                }
+                Err(error) if error.kind() == io::ErrorKind::NotFound => continue,
+                Err(error) => {
+                    if changed {
+                        self.rebuild_runtime_indexes_locked(inner);
+                    }
+                    return Err(error.into());
+                }
+            }
+            let info = match inspect_batch_dir(&path, &self.config.node_id) {
+                Ok(value) => value,
+                Err(_) => {
+                    // Keep potentially durable bytes for startup recovery.
+                    // They remain counted by directory_size and therefore
+                    // cannot make the logical budget look healthier than the
+                    // filesystem actually is.
+                    inner.degraded = true;
+                    inner.non_gap_degraded = true;
+                    continue;
+                }
+            };
+            let final_dir = sealed_root.join(format!(
+                "{}-{}-{}-{}",
+                info.spool_epoch, info.first_spool_sequence, info.last_spool_sequence, info.batch_id
+            ));
+            match fs::symlink_metadata(&final_dir) {
+                Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                    if let Err(error) = fs::rename(&path, &final_dir) {
+                        if changed {
+                            self.rebuild_runtime_indexes_locked(inner);
+                        }
+                        return Err(error.into());
+                    }
+                    changed = true;
+                    promoted_open_range |= inner.open_meta.first_sequence == Some(info.first_spool_sequence)
+                        && inner.open_meta.last_sequence == Some(info.last_spool_sequence)
+                        && inner.open_meta.event_count == info.event_count;
+                    if let Err(error) = sync_dir(&sealed_root) {
+                        self.rebuild_runtime_indexes_locked(inner);
+                        return Err(error.into());
+                    }
+                }
+                Ok(metadata) if metadata.is_dir() => {
+                    // If a previous attempt completed the promotion but left
+                    // the source name behind, remove only an identical copy.
+                    let duplicate = inspect_batch_dir(&final_dir, &self.config.node_id)
+                        .ok()
+                        .is_some_and(|existing| {
+                            existing.batch_id == info.batch_id
+                                && existing.body_sha256 == info.body_sha256
+                                && existing.raw_bytes == info.raw_bytes
+                        });
+                    if duplicate {
+                        let bytes = match directory_size(&path) {
+                            Ok(bytes) => bytes,
+                            Err(error) => {
+                                if changed {
+                                    self.rebuild_runtime_indexes_locked(inner);
+                                }
+                                return Err(error.into());
+                            }
+                        };
+                        if let Err(error) = remove_path(&path) {
+                            if changed {
+                                self.rebuild_runtime_indexes_locked(inner);
+                            }
+                            return Err(error.into());
+                        }
+                        Self::adjust_spool_bytes(inner, -i128::from(bytes));
+                        changed = true;
+                        promoted_open_range |= inner.open_meta.first_sequence == Some(info.first_spool_sequence)
+                            && inner.open_meta.last_sequence == Some(info.last_spool_sequence)
+                            && inner.open_meta.event_count == info.event_count;
+                        if let Err(error) = sync_dir(&sealed_root) {
+                            self.rebuild_runtime_indexes_locked(inner);
+                            return Err(error.into());
+                        }
+                    } else {
+                        inner.degraded = true;
+                        inner.non_gap_degraded = true;
+                    }
+                }
+                Ok(_) => {
+                    inner.degraded = true;
+                    inner.non_gap_degraded = true;
+                }
+                Err(error) => {
+                    if changed {
+                        self.rebuild_runtime_indexes_locked(inner);
+                    }
+                    return Err(error.into());
+                }
+            }
+        }
+        if promoted_open_range {
+            // The failed seal may have detached `inner.open_file` from the
+            // pathname while the complete batch was being promoted.  Its
+            // records now live in sealed/, so the writable view is empty.
+            inner.open_meta = OpenMetadata::empty();
+        }
+        if changed {
+            let binding_result = self.ensure_open_file_bound(inner);
+            // Promotion changes which objects are trusted sealed batches;
+            // refresh the exceptional path's counters once after all renames.
+            self.rebuild_runtime_indexes_locked(inner);
+            binding_result?;
+        }
+        Ok(())
+    }
+
+    /// Remove expired ACKed batches only after a durable receipt exists for
+    /// each one.  A crash can leave an ACKed directory behind before its
+    /// receipt barrier completes; deleting such a directory would make a
+    /// later duplicate ACK indistinguishable from an unknown batch.
+    fn remove_aged_acked_locked(&self, inner: &mut SpoolInner, cutoff_seconds: u64) -> Result<(), SpoolError> {
+        let mut candidates = Vec::new();
+        let paths = match list_batch_dirs(&self.root.join("acked")) {
+            Ok(value) => value,
+            Err(error) => {
+                mark_storage_rejection(inner, true);
+                return Err(error);
+            }
+        };
+        for path in paths {
+            let Some(timestamp) = acked_timestamp(&path) else {
+                // Unknown names are retained conservatively.  They can still
+                // be considered by the regular capacity path, which will
+                // quarantine a malformed object instead of silently deleting
+                // it.
+                continue;
+            };
+            if timestamp < cutoff_seconds {
+                candidates.push((timestamp, path));
+            }
+        }
+        candidates.sort_by(|(left_time, left_path), (right_time, right_path)| {
+            left_time.cmp(right_time).then_with(|| left_path.cmp(right_path))
+        });
+        let mut first_error = None;
+        for (_, path) in candidates {
+            let info = match self.read_meta(&path) {
+                Ok(value) => value,
+                Err(error) => {
+                    mark_storage_rejection(inner, true);
+                    first_error.get_or_insert(error);
+                    continue;
+                }
+            };
+            let Some(info) = info else {
+                inner.degraded = true;
+                if let Err(error) = self.quarantine_batch_locked(inner, &path, QUARANTINE_LABEL_ACKED) {
+                    first_error.get_or_insert(error);
+                    inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                }
+                continue;
+            };
+            // The ACK receipt is already durable; retention need only inspect
+            // strict metadata and the receipt, not stream/hash the body again.
+            // This call is the receipt durability barrier.  On failure we do
+            // not remove the directory and propagate the retryable storage
+            // error to the append path.
+            if let Err(error) = self.ensure_receipt_for_batch_locked(inner, &info) {
+                first_error.get_or_insert(error);
+                inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                continue;
+            }
+            match Self::remove_tree_tracked(inner, &path) {
+                Ok(_) => {
+                    inner.stored_records = inner.stored_records.saturating_sub(info.event_count);
+                    if let Err(error) = sync_dir(&self.root.join("acked")) {
+                        first_error.get_or_insert(error.into());
+                        mark_storage_rejection(inner, true);
+                    }
+                }
+                Err(error) => {
+                    first_error.get_or_insert(error.into());
+                    inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+                }
+            }
+        }
+        if let Some(error) = first_error {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+            Err(error)
+        } else {
+            Ok(())
+        }
+    }
+
+    /// `durable_gap_reasons` answers one question: has the fixed gap of an
+    /// outstanding transaction already reached durable storage?  Once no
+    /// pending tombstone, queued recovery gap or pending state reset refers to
+    /// an event ID, nothing can consult its entry again - freshly generated
+    /// gap IDs are random and never collide - so drop it instead of growing
+    /// the index for the whole process lifetime and relying on the next
+    /// startup rebuild to clear it.
+    fn prune_durable_gap_reasons_locked(inner: &mut SpoolInner) {
+        if inner.durable_gap_reasons.is_empty() {
+            return;
+        }
+        let mut referenced: HashSet<String> = HashSet::new();
+        for entry in &inner.tombstones {
+            if let Some(event_id) = entry.gap_event_id() {
+                referenced.insert(event_id.to_owned());
+            }
+        }
+        for spec in &inner.recovery_gaps {
+            referenced.insert(spec.event_id.clone());
+        }
+        if let Some(pending) = inner.pending_state_reset.as_ref() {
+            referenced.insert(pending.gap_event_id.clone());
+        }
+        inner
+            .durable_gap_reasons
+            .retain(|event_id, _| referenced.contains(event_id));
+    }
+
+    fn prune_receipts_locked(&self, inner: &mut SpoolInner) -> Result<(), SpoolError> {
+        // §5.4 defines a single receipt retention window.  Bind the ledger to
+        // the protocol crate's constant instead of keeping a second definition
+        // of the same contract value in this file.
+        let cutoff = unix_seconds()?
+            .saturating_sub(wire::RECEIPT_RETENTION_SECONDS)
+            .saturating_mul(1_000);
+        let old = inner.tombstones.clone();
+        inner
+            .tombstones
+            .retain(|entry| entry.is_pending() || entry.recorded_at_unix_ms() >= cutoff);
+        while inner.tombstones.len() > MAX_TOMBSTONES {
+            let Some((index, _)) = inner
+                .tombstones
+                .iter()
+                .enumerate()
+                .filter(|(_, entry)| !entry.is_pending())
+                .min_by_key(|(_, entry)| entry.recorded_at_unix_ms())
+            else {
+                break;
+            };
+            inner.tombstones.remove(index);
+        }
+        if inner.tombstones != old {
+            match self.persist_tombstones_locked(inner) {
+                Ok(()) => {}
+                Err(AtomicWriteError::BeforeRename(error)) => {
+                    inner.tombstones = old;
+                    return Err(error);
+                }
+                Err(AtomicWriteError::AfterRename(_)) => {
+                    return Err(self.mark_durability_uncertain_locked(inner));
+                }
+            }
+        }
+        Self::prune_durable_gap_reasons_locked(inner);
+        Ok(())
+    }
+
+    fn add_tombstone_locked(&self, inner: &mut SpoolInner, entry: TombstoneEntry) -> Result<(), SpoolError> {
+        self.prune_receipts_locked(inner)?;
+        // Persist a descriptor-independent intent before replacing the
+        // aggregate ledger.  Callers perform destructive rename/remove only
+        // after this function returns, so a marker left by a failed ledger
+        // write is safe to replay during recovery.
+        if entry.is_pending() {
+            self.persist_tombstone_pending_marker_locked(inner, &entry)?;
+        }
+        for existing in &inner.tombstones {
+            // A quarantine batch-id is only a hint and must not conflict with
+            // an ACK/eviction receipt for the same underlying batch. Identity
+            // is scoped to the tombstone variant.
+            let same_batch = existing.entry_type() == entry.entry_type()
+                && existing.batch_id().is_some()
+                && entry.batch_id().is_some()
+                && existing.batch_id() == entry.batch_id();
+            let same_gap = existing.gap_event_id().is_some()
+                && entry.gap_event_id().is_some()
+                && existing.gap_event_id() == entry.gap_event_id();
+            if same_batch || same_gap {
+                if existing == &entry {
+                    return Ok(());
+                }
+                return Err(SpoolError::InvalidState(
+                    "tombstone contains a conflicting duplicate identity".to_owned(),
+                ));
+            }
+        }
+        let old = inner.tombstones.clone();
+        if inner.tombstones.len() >= MAX_TOMBSTONES {
+            let Some((index, _)) = inner
+                .tombstones
+                .iter()
+                .enumerate()
+                .filter(|(_, item)| !item.is_pending())
+                .min_by_key(|(_, item)| item.recorded_at_unix_ms())
+            else {
+                return Err(SpoolError::StorageUnavailable);
+            };
+            inner.tombstones.remove(index);
+        }
+        inner.tombstones.push(entry);
+        match self.persist_tombstones_locked(inner) {
+            Ok(()) => {}
+            Err(AtomicWriteError::BeforeRename(error)) => {
+                inner.tombstones = old;
+                return Err(error);
+            }
+            Err(AtomicWriteError::AfterRename(_)) => {
+                return Err(self.mark_durability_uncertain_locked(inner));
+            }
+        }
+        Ok(())
+    }
+
+    fn remove_tombstone_locked(&self, inner: &mut SpoolInner, index: usize) -> Result<TombstoneCommit, SpoolError> {
+        if index >= inner.tombstones.len() {
+            return Err(SpoolError::InvalidState("tombstone index is out of bounds".to_owned()));
+        }
+        let old = inner.tombstones.clone();
+        let removed = inner.tombstones[index].clone();
+        inner.tombstones.remove(index);
+        match self.persist_tombstones_locked(inner) {
+            Ok(()) => {}
+            Err(AtomicWriteError::BeforeRename(error)) => {
+                inner.tombstones = old;
+                return Err(error);
+            }
+            Err(AtomicWriteError::AfterRename(_)) => {
+                return Err(self.mark_durability_uncertain_locked(inner));
+            }
+        }
+        let marker_cleanup_error = removed
+            .gap_event_id()
+            .and_then(|gap_id| self.remove_tombstone_pending_marker_locked(inner, gap_id).err());
+        Ok(TombstoneCommit { marker_cleanup_error })
+    }
+
+    fn replace_tombstone_locked(
+        &self,
+        inner: &mut SpoolInner,
+        index: usize,
+        replacement: Option<TombstoneEntry>,
+    ) -> Result<TombstoneCommit, SpoolError> {
+        if index >= inner.tombstones.len() {
+            return Err(SpoolError::InvalidState("tombstone index is out of bounds".to_owned()));
+        }
+        let old = inner.tombstones.clone();
+        let replaced = inner.tombstones[index].clone();
+        if let Some(value) = replacement {
+            inner.tombstones[index] = value;
+        } else {
+            inner.tombstones.remove(index);
+        }
+        match self.persist_tombstones_locked(inner) {
+            Ok(()) => {}
+            Err(AtomicWriteError::BeforeRename(error)) => {
+                inner.tombstones = old;
+                return Err(error);
+            }
+            Err(AtomicWriteError::AfterRename(_)) => {
+                return Err(self.mark_durability_uncertain_locked(inner));
+            }
+        }
+        let marker_cleanup_error = replaced
+            .gap_event_id()
+            .and_then(|gap_id| self.remove_tombstone_pending_marker_locked(inner, gap_id).err());
+        Ok(TombstoneCommit { marker_cleanup_error })
+    }
+
+    fn add_receipt_locked(&self, inner: &mut SpoolInner, entry: TombstoneEntry) -> Result<(), SpoolError> {
+        self.add_tombstone_locked(inner, entry)
+    }
+
+    fn persist_tombstones_locked(&self, inner: &mut SpoolInner) -> Result<(), AtomicWriteError> {
+        #[cfg(test)]
+        if !std::mem::take(&mut inner.faults.persist_tombstones_skip)
+            && std::mem::take(&mut inner.faults.persist_tombstones)
+        {
+            return Err(AtomicWriteError::BeforeRename(
+                io::Error::other("injected tombstone persistence failure").into(),
+            ));
+        }
+        let path = self.root.join("tombstones.json");
+        let before = file_len(&path).map_err(|error| AtomicWriteError::BeforeRename(error.into()))?;
+        let result = persist_tombstones(&self.root, &inner.tombstones);
+        #[cfg(test)]
+        let result = if result.is_ok() && std::mem::take(&mut inner.faults.persist_tombstones_after_commit) {
+            Err(AtomicWriteError::AfterRename(
+                io::Error::other("injected tombstone failure after durable commit").into(),
+            ))
+        } else {
+            result
+        };
+        if result.is_ok() || matches!(&result, Err(AtomicWriteError::AfterRename(_))) {
+            #[cfg(test)]
+            let accounting = if std::mem::take(&mut inner.faults.persist_tombstones_accounting) {
+                Err(io::Error::other("injected tombstone path-size accounting failure"))
+            } else {
+                Self::update_path_size(inner, &path, before)
+            };
+            #[cfg(not(test))]
+            let accounting = Self::update_path_size(inner, &path, before);
+            if accounting.is_err() {
+                // Measuring the file afterwards says nothing about the write
+                // barrier that already ran.  When the barrier succeeded the
+                // ledger on disk is exactly what memory holds; only the
+                // incremental byte index is now untrustworthy, and clearing
+                // `spool_bytes_known` forces a full measurement before the next
+                // capacity decision.  Escalating this to `DurabilityUncertain`
+                // would stop the daemon over an accounting read -- and
+                // `tombstones.json` is rewritten on every ACK and every
+                // eviction, so that exposure is far larger than `state.json`'s.
+                // `OPERATIONS.md` scopes the fail-closed exit to a write barrier
+                // whose *outcome* cannot be determined; this is not that.
+                inner.spool_bytes_known = false;
+                mark_storage_rejection(inner, true);
+            }
+        }
+        result
+    }
+
+    fn persist_recovery_gap_marker_locked(&self, inner: &mut SpoolInner, spec: &GapSpec) -> Result<(), SpoolError> {
+        let path = recovery_gap_marker_path(&self.root, &spec.event_id)?;
+        let before = file_len(&path)?;
+        let result = persist_recovery_gap_marker(&self.root, spec);
+        #[cfg(test)]
+        let accounting = if std::mem::take(&mut inner.faults.recovery_marker_accounting) {
+            Err(io::Error::other(
+                "injected recovery marker path-size accounting failure",
+            ))
+        } else {
+            Self::update_path_size(inner, &path, before)
+        };
+        #[cfg(not(test))]
+        let accounting = Self::update_path_size(inner, &path, before);
+        if let Err(error) = accounting {
+            // The marker may already be on disk with a size that cannot be
+            // established.  Leaving the incremental index "known" would keep a
+            // permanent offset, so force a full re-measurement exactly as the
+            // marker removal path does.
+            inner.spool_bytes_known = false;
+            mark_storage_rejection(inner, true);
+            return Err(error.into());
+        }
+        result
+    }
+
+    fn persist_tombstone_pending_marker_locked(
+        &self,
+        inner: &mut SpoolInner,
+        entry: &TombstoneEntry,
+    ) -> Result<(), SpoolError> {
+        let path = tombstone_pending_marker_path(&self.root, entry)?;
+        let before = file_len(&path)?;
+        let result = persist_tombstone_pending_marker(&self.root, entry);
+        #[cfg(test)]
+        let accounting = if std::mem::take(&mut inner.faults.tombstone_pending_marker_accounting) {
+            Err(io::Error::other(
+                "injected tombstone pending marker path-size accounting failure",
+            ))
+        } else {
+            Self::update_path_size(inner, &path, before)
+        };
+        #[cfg(not(test))]
+        let accounting = Self::update_path_size(inner, &path, before);
+        if let Err(error) = accounting {
+            // The marker may already be on disk with a size that cannot be
+            // established.  Leaving the incremental index "known" would keep a
+            // permanent offset, exactly as its sibling writer
+            // `persist_recovery_gap_marker_locked` and its own removal
+            // counterpart both note; force a full re-measurement instead.
+            inner.spool_bytes_known = false;
+            mark_storage_rejection(inner, true);
+            return Err(error.into());
+        }
+        result
+    }
+
+    fn remove_tombstone_pending_marker_locked(&self, inner: &mut SpoolInner, event_id: &str) -> Result<(), SpoolError> {
+        let path = match tombstone_pending_marker_path_for_id(&self.root, event_id) {
+            Ok(path) => path,
+            Err(error) => {
+                inner.spool_bytes_known = false;
+                mark_storage_rejection(inner, true);
+                return Err(error);
+            }
+        };
+        let before = match file_len(&path) {
+            Ok(value) => value,
+            Err(error) => {
+                // The ledger transition may already be durable, but the
+                // marker's size is no longer trustworthy.  Force a full
+                // measurement before allowing another capacity decision.
+                inner.spool_bytes_known = false;
+                mark_storage_rejection(inner, true);
+                return Err(error.into());
+            }
+        };
+        #[cfg(test)]
+        let outcome = if std::mem::take(&mut inner.faults.marker_cleanup) {
+            Err(io::Error::other("injected marker cleanup failure").into())
+        } else {
+            remove_tombstone_pending_marker(&self.root, event_id)
+        };
+        #[cfg(not(test))]
+        let outcome = remove_tombstone_pending_marker(&self.root, event_id);
+        match outcome {
+            Ok(true) => {
+                Self::adjust_spool_bytes(inner, -i128::from(before));
+                inner.pending_marker_cleanup.remove(event_id);
+            }
+            Ok(false) => {
+                inner.pending_marker_cleanup.remove(event_id);
+            }
+            Err(error) => {
+                // Retry on the next reconcile rather than waiting for a restart.
+                // A marker that outlives its resolved transaction long enough for
+                // the gap it names to age out of the spool gets resurrected as a
+                // pending entry at startup, and reconcile then rewrites the same
+                // fixed gap ID -- a duplicate the collector reports as a payload
+                // conflict.  Bounded by the ledger's own entry cap.
+                if inner.pending_marker_cleanup.len() < MAX_TOMBSTONES {
+                    inner.pending_marker_cleanup.insert(event_id.to_owned());
+                }
+                // `remove_file` can succeed before the parent directory fsync
+                // fails.  In either case the incremental byte index cannot be
+                // trusted until the next full scan.
+                inner.spool_bytes_known = false;
+                mark_storage_rejection(inner, true);
+                return Err(error);
+            }
+        }
+        Ok(())
+    }
+
+    fn rebuild_acked_receipts_locked(&self, inner: &mut SpoolInner) -> Result<(), SpoolError> {
+        let mut first_error = None;
+        let paths = match list_batch_dirs(&self.root.join("acked")) {
+            Ok(value) => value,
+            Err(error) => {
+                mark_storage_rejection(inner, true);
+                return Err(error);
+            }
+        };
+        for path in paths {
+            let info = match self.read_meta(&path) {
+                Ok(value) => value,
+                Err(error) => {
+                    mark_storage_rejection(inner, true);
+                    first_error.get_or_insert(error);
+                    continue;
+                }
+            };
+            let Some(info) = info else {
+                mark_storage_rejection(inner, true);
+                continue;
+            };
+            match self.read_batch(&path, true) {
+                Ok(Some(_)) => {}
+                Ok(None) => {
+                    mark_storage_rejection(inner, true);
+                    continue;
+                }
+                Err(error) => {
+                    mark_storage_rejection(inner, true);
+                    first_error.get_or_insert(error);
+                    continue;
+                }
+            }
+            if let Err(error) = self.ensure_receipt_for_batch_locked(inner, &info) {
+                // A full ledger containing only pending transactions must
+                // never cause an ACKed batch to be deleted.  Keep scanning so
+                // healthy batches can still rebuild their receipts, then
+                // report the storage barrier failure to the caller.
+                first_error.get_or_insert(error);
+                mark_storage_rejection(inner, true);
+            }
+        }
+        if let Some(error) = first_error {
+            Err(error)
+        } else {
+            Ok(())
+        }
+    }
+
+    fn ensure_receipt_for_batch_locked(&self, inner: &mut SpoolInner, info: &BatchInfo) -> Result<(), SpoolError> {
+        for entry in &inner.tombstones {
+            match entry {
+                TombstoneEntry::AckedReceipt(value) if value.batch_id == info.batch_id => {
+                    if value.body_sha256 == info.body_sha256 {
+                        return Ok(());
+                    }
+                    return Err(SpoolError::DigestMismatch);
+                }
+                TombstoneEntry::EvictedReceipt(value) if value.batch_id == info.batch_id => {
+                    // An acked directory and an evicted receipt for the same
+                    // batch are mutually exclusive.  Refuse to delete or
+                    // acknowledge it until recovery resolves the inconsistency.
+                    return Err(SpoolError::InvalidState(
+                        "acked batch has an evicted receipt".to_owned(),
+                    ));
+                }
+                _ => {}
+            }
+        }
+        self.add_receipt_locked(
+            inner,
+            TombstoneEntry::AckedReceipt(wire::AckedReceipt::new(
+                info.batch_id.clone(),
+                info.body_sha256.clone(),
+                unix_millis()?,
+            )),
+        )
+    }
+
+    /// Every destructive path that drops unacknowledged events feeds the same
+    /// health counter.  Sealed eviction, quarantine eviction and the recovery
+    /// completion of a crashed eviction all lose records the collector never
+    /// received; counting only one of them under-reports the loss in health.
+    fn add_evicted_unacked_records(inner: &mut SpoolInner, records: u64) {
+        let (value, overflowed) = inner.evicted_unacked_records.overflowing_add(records);
+        inner.evicted_unacked_records = if overflowed { u64::MAX } else { value };
+        if overflowed {
+            inner.degraded = true;
+            inner.non_gap_degraded = true;
+        }
+    }
+
+    fn evict_sealed_locked(&self, inner: &mut SpoolInner, path: &Path) -> Result<(), SpoolError> {
+        let lease = match self.read_batch(path, false) {
+            Ok(Some(value)) => value,
+            Ok(None) | Err(_) => {
+                mark_storage_rejection(inner, true);
+                self.quarantine_batch_locked(inner, path, QUARANTINE_LABEL_UNACKED)?;
+                return Ok(());
+            }
+        };
+        let info = lease.info;
+        // A sealed batch evicted before delivery takes its durable `spool_gap`
+        // records with it, so those IDs must leave the durable index: §9.5
+        // allows the same gap ID to be written again while it is not durable.
+        // Entries for batches that were acked and later removed by retention
+        // are deliberately kept, because rewriting a delivered gap ID would
+        // duplicate it at the collector.
+        forget_durable_gap_reasons(&lease.body, &mut inner.durable_gap_reasons);
+        let gap_event_id = format!("{}{}", GAP_ID_PREFIX, random_hex_id()?);
+        let pending = wire::EvictionPending::new(
+            info.batch_id.clone(),
+            info.body_sha256.clone(),
+            unix_millis()?,
+            gap_event_id.clone(),
+            if free_space_ok(&self.root, self.config.min_free_bytes) {
+                "capacity_eviction"
+            } else {
+                "min_free_eviction"
+            },
+            info.spool_epoch.clone(),
+            info.first_spool_sequence,
+            info.last_spool_sequence,
+            info.event_count,
+            info.raw_bytes,
+        );
+        self.add_tombstone_locked(inner, TombstoneEntry::EvictionPending(pending.clone()))?;
+        Self::remove_tree_tracked(inner, path)?;
+        Self::remove_sealed_index(inner, &info);
+        inner.stored_records = inner.stored_records.saturating_sub(info.event_count);
+        if inner.leased_batch.as_deref() == Some(info.batch_id.as_str()) {
+            // The collector may still ACK this ID after the leased batch was
+            // evicted; the durable evicted receipt below will turn that into
+            // the specified 410 response instead of leaving a stale lease.
+            inner.leased_batch = None;
+        }
+        sync_dir(&self.root.join("sealed"))?;
+        let spec = GapSpec {
+            event_id: gap_event_id,
+            occurred_at_unix_ms: unix_millis()?,
+            lost_spool_epoch: Some(info.spool_epoch),
+            reason: if pending.reason == "min_free_eviction" {
+                wire::SpoolGapReason::MinFreeEviction
+            } else {
+                wire::SpoolGapReason::CapacityEviction
+            },
+            first_lost_spool_sequence: Some(info.first_spool_sequence),
+            last_lost_spool_sequence: Some(info.last_spool_sequence),
+            lost_events: Some(info.event_count),
+            lost_bytes: Some(info.raw_bytes),
+            lost_batch_id: Some(info.batch_id.clone()),
+            source_fingerprint: None,
+        };
+        inner.gap_degraded = true;
+        if let Err(error) = self.write_gap_locked(inner, &spec) {
+            inner.degraded = true;
+            return Err(error);
+        }
+        let replacement = TombstoneEntry::EvictedReceipt(wire::EvictedReceipt::from_pending(&pending));
+        if let Some(index) = inner.tombstones.iter().position(|entry| {
+            matches!(entry, TombstoneEntry::EvictionPending(value) if value.gap_event_id == pending.gap_event_id)
+        }) {
+            let commit = self.replace_tombstone_locked(inner, index, Some(replacement))?;
+            // Count only after the pending -> receipt ledger transition has
+            // committed, but before reporting a marker cleanup error.
+            Self::add_evicted_unacked_records(inner, info.event_count);
+            commit.finish()?;
+            return Ok(());
+        }
+        Self::add_evicted_unacked_records(inner, info.event_count);
+        Ok(())
+    }
+
+    fn evict_quarantine_locked(&self, inner: &mut SpoolInner, path: &Path) -> Result<(), SpoolError> {
+        let basename = path
+            .file_name()
+            .and_then(|value| value.to_str())
+            .ok_or_else(|| SpoolError::InvalidState("invalid quarantine basename".to_owned()))?
+            .to_owned();
+        let hint = read_meta_hint(path, &self.config.node_id);
+        let gap_event_id = format!("{}{}", GAP_ID_PREFIX, random_hex_id()?);
+        let pending = wire::QuarantinePending::new(
+            gap_event_id.clone(),
+            basename,
+            unix_millis()?,
+            hint.as_ref().map(|value| value.batch_id.clone()),
+            hint.as_ref().map(|value| value.body_sha256.clone()),
+            hint.as_ref().map(|value| value.spool_epoch.clone()),
+            hint.as_ref().map(|value| value.first_spool_sequence),
+            hint.as_ref().map(|value| value.last_spool_sequence),
+            hint.as_ref().map(|value| value.event_count),
+            hint.as_ref().map(|value| value.raw_bytes),
+        );
+        self.add_tombstone_locked(inner, TombstoneEntry::QuarantinePending(pending.clone()))?;
+        // The pending marker is durable, but the quarantine object must not be
+        // removed until its full size is known.  Otherwise a directory scan
+        // error would make the incremental byte index under-count the spool
+        // and could allow an unsafe subsequent append.
+        let (removed_bytes, skipped_objects) = directory_size_status(path)?;
+        if skipped_objects {
+            mark_storage_rejection(inner, true);
+        }
+        remove_path(path)?;
+        Self::adjust_spool_bytes(inner, -i128::from(removed_bytes));
+        sync_dir(&self.root.join("quarantine"))?;
+        let spec = GapSpec {
+            event_id: gap_event_id,
+            occurred_at_unix_ms: unix_millis()?,
+            // `read_meta_hint` only returns strict, node-matching metadata;
+            // preserve every field that remains trustworthy even though the
+            // quarantined body itself was not exportable.  Recovery follows
+            // the same rule when replaying a durable quarantine_pending entry.
+            lost_spool_epoch: pending.spool_epoch.clone(),
+            reason: wire::SpoolGapReason::QuarantineEviction,
+            first_lost_spool_sequence: pending.first_spool_sequence.map(|value| value.0),
+            last_lost_spool_sequence: pending.last_spool_sequence.map(|value| value.0),
+            lost_events: pending.event_count.map(|value| value.0),
+            lost_bytes: pending.raw_bytes.map(|value| value.0),
+            lost_batch_id: pending.batch_id.clone(),
+            source_fingerprint: None,
+        };
+        inner.gap_degraded = true;
+        self.write_gap_locked(inner, &spec)?;
+        // An object isolated out of `sealed/` held unacknowledged events, so its
+        // destruction is a real loss and health must account for it exactly like
+        // a sealed eviction.  An object isolated out of `acked/` must not be:
+        // the collector already holds those events, and `event_count` is the
+        // batch total, not an undelivered count.  The gap still reports the
+        // destroyed range -- §9.5 defines `lost_events` as what the corrupt
+        // object's metadata says it held -- but `evicted_unacked_records` is
+        // named for undelivered records and drives loss alerting.
+        if let Some(index) = inner.tombstones.iter().position(|entry| {
+            matches!(entry, TombstoneEntry::QuarantinePending(value) if value.gap_event_id == pending.gap_event_id)
+        }) {
+            let commit = self.remove_tombstone_locked(inner, index)?;
+            // The object and its gap are already durable.  Count only after
+            // the pending ledger entry is durably removed, so a retry after a
+            // pre-commit ledger failure cannot charge the same loss twice.
+            if !quarantine_pending_source_is_acked(inner, &pending) {
+                Self::add_evicted_unacked_records(inner, spec.lost_events.unwrap_or(0));
+            }
+            commit.finish()?;
+            return Ok(());
+        }
+        // This should be unreachable because the pending entry is created
+        // above, but preserve the historical accounting fallback if a caller
+        // supplies an already-compacted ledger.
+        if !quarantine_pending_source_is_acked(inner, &pending) {
+            Self::add_evicted_unacked_records(inner, spec.lost_events.unwrap_or(0));
+        }
+        Ok(())
+    }
+
+    /// Retry marker unlinks that failed after their ledger transition committed.
+    ///
+    /// Leaving them for the next startup is what makes `m-233` reachable: a
+    /// marker whose transaction is long resolved gets resurrected as a pending
+    /// entry once the gap it names has aged out of the spool, and reconcile then
+    /// rewrites the same fixed gap ID.  Retrying here bounds the exposure to one
+    /// reconcile interval instead of one restart.  A retry that fails again is
+    /// simply kept for the next pass; the error was already reported when the
+    /// transition committed.
+    fn retry_pending_marker_cleanup_locked(&self, inner: &mut SpoolInner) {
+        if inner.pending_marker_cleanup.is_empty() {
+            return;
+        }
+        let pending: Vec<String> = inner.pending_marker_cleanup.iter().cloned().collect();
+        for event_id in pending {
+            if inner
+                .tombstones
+                .iter()
+                .any(|entry| entry.gap_event_id() == Some(event_id.as_str()))
+            {
+                // The transaction is live again (a marker replayed into the
+                // ledger); its own path owns the cleanup.
+                inner.pending_marker_cleanup.remove(&event_id);
+                continue;
+            }
+            let _ = self.remove_tombstone_pending_marker_locked(inner, &event_id);
+        }
+    }
+
+    fn reconcile_tombstones_locked(&self, inner: &mut SpoolInner) -> Result<(), SpoolError> {
+        self.prune_receipts_locked(inner)?;
+        self.retry_pending_marker_cleanup_locked(inner);
+        let mut index = 0;
+        while index < inner.tombstones.len() {
+            let entry = inner.tombstones[index].clone();
+            let result = (|| -> Result<bool, SpoolError> {
+                match entry {
+                    TombstoneEntry::EvictionPending(pending) => {
+                        inner.gap_degraded = true;
+                        // Locate the batch even when its metadata is malformed.
+                        // `find_batch_with_digest` intentionally ignores such an
+                        // object; leaving it in `sealed/` would make a pending
+                        // eviction appear complete while the corrupt bytes stay
+                        // eligible for export and capacity scans.
+                        if let Some(path) = self.find_batch_path_by_id(&self.root.join("sealed"), &pending.batch_id)? {
+                            match self.read_batch(&path, false) {
+                                Ok(Some(_)) => {
+                                    // The crash happened before the delete
+                                    // barrier; retaining the complete batch is
+                                    // safer than claiming it was evicted.  Drop
+                                    // only the pending transaction marker.
+                                    self.remove_tombstone_locked(inner, index)?.finish()?;
+                                    return Ok(false);
+                                }
+                                Ok(None) | Err(_) => {
+                                    // The fixed eviction gap already describes
+                                    // this batch.  Quarantine the malformed copy
+                                    // directly instead of creating a second,
+                                    // unrelated corruption gap.
+                                    inner.degraded = true;
+                                    let result = quarantine_path(&self.root, &path, QUARANTINE_LABEL_UNACKED);
+                                    if result.is_ok() || !path.exists() {
+                                        self.rebuild_runtime_indexes_locked(inner);
+                                    }
+                                    result?;
+                                }
+                            }
+                        }
+                        let spec = GapSpec {
+                            event_id: pending.gap_event_id.clone(),
+                            occurred_at_unix_ms: pending.recorded_at_unix_ms.0,
+                            lost_spool_epoch: Some(pending.spool_epoch.clone()),
+                            reason: if pending.reason == "min_free_eviction" {
+                                wire::SpoolGapReason::MinFreeEviction
+                            } else {
+                                wire::SpoolGapReason::CapacityEviction
+                            },
+                            first_lost_spool_sequence: Some(pending.first_spool_sequence.0),
+                            last_lost_spool_sequence: Some(pending.last_spool_sequence.0),
+                            lost_events: Some(pending.event_count.0),
+                            lost_bytes: Some(pending.raw_bytes.0),
+                            lost_batch_id: Some(pending.batch_id.clone()),
+                            source_fingerprint: None,
+                        };
+                        if !inner.durable_gap_reasons.contains_key(&pending.gap_event_id) {
+                            self.write_gap_locked(inner, &spec)?;
+                        }
+                        let commit = self.replace_tombstone_locked(
+                            inner,
+                            index,
+                            Some(TombstoneEntry::EvictedReceipt(wire::EvictedReceipt::from_pending(
+                                &pending,
+                            ))),
+                        )?;
+                        // Finishing a crashed eviction loses the same records the
+                        // in-process path would have counted -- but only account
+                        // for them once the durable pending -> evicted transition
+                        // has actually committed.  `replace_tombstone_locked`
+                        // rolls the in-memory entry back when `tombstones.json`
+                        // cannot be written, so counting first would let every
+                        // retry of a recoverable storage failure add the same
+                        // batch again.  `evict_sealed_locked` already orders it
+                        // this way.
+                        Self::add_evicted_unacked_records(inner, pending.event_count.0);
+                        commit.finish()?;
+                        Ok(true)
+                    }
+                    TombstoneEntry::QuarantinePending(pending) => {
+                        inner.gap_degraded = true;
+                        // A pending quarantine means the source was known to be
+                        // unusable. If a crash happened before its rename, retry
+                        // that rename rather than dropping the marker and leaving
+                        // a poison batch in sealed/ or acked/.
+                        let source_path = if let Some(batch_id) = pending.batch_id.as_deref() {
+                            self.find_batch_path_by_id(&self.root.join("sealed"), batch_id)?
+                                .or(self.find_batch_path_by_id(&self.root.join("acked"), batch_id)?)
+                        } else {
+                            find_path_with_basename(&self.root.join("sealed"), &pending.quarantine_basename)?.or(
+                                find_path_with_basename(&self.root.join("acked"), &pending.quarantine_basename)?,
+                            )
+                        };
+                        let marker_spec = if let Some(spec) = inner
+                            .recovery_gaps
+                            .iter()
+                            .find(|spec| spec.event_id == pending.gap_event_id)
+                            .cloned()
+                        {
+                            Some(spec)
+                        } else {
+                            match load_recovery_gap_marker(&self.root, &pending.gap_event_id) {
+                                Ok(value) => value,
+                                Err(error) => {
+                                    // A pending transaction must not be
+                                    // completed from an untrusted fallback when
+                                    // its fixed recovery marker cannot be read.
+                                    // Keep both source and marker untouched for a
+                                    // later retry and expose the storage fault.
+                                    mark_storage_rejection(inner, true);
+                                    return Err(error);
+                                }
+                            }
+                        };
+                        // Current ledgers carry the transaction meaning directly.
+                        // For an older pending entry whose reason was hard-coded,
+                        // the private marker or startup-built durable-gap index is
+                        // a one-time migration discriminator.
+                        let durable_reason = inner.durable_gap_reasons.get(&pending.gap_event_id).copied();
+                        let is_corruption_quarantine = pending.reason == "segment_corruption"
+                            || marker_spec
+                                .as_ref()
+                                .is_some_and(|spec| spec.reason != wire::SpoolGapReason::QuarantineEviction)
+                            || durable_reason.is_some_and(|reason| reason != wire::SpoolGapReason::QuarantineEviction);
+                        if let Some(path) = source_path {
+                            let source_parent = path.parent().map(Path::to_path_buf);
+                            let source_hint = read_meta_hint(&path, &self.config.node_id);
+                            // A crash can leave the source in its trusted
+                            // directory after the pending marker/ledger have
+                            // been persisted. Preserve that provenance in the
+                            // quarantine basename; otherwise an ACKed batch is
+                            // later charged as undelivered loss.
+                            let label = if source_parent.as_deref().is_some_and(|parent| parent.ends_with("acked")) {
+                                QUARANTINE_LABEL_ACKED
+                            } else {
+                                QUARANTINE_LABEL_UNACKED
+                            };
+                            let result = quarantine_path(&self.root, &path, label);
+                            if result.is_err() && !path.exists() {
+                                self.rebuild_runtime_indexes_locked(inner);
+                            }
+                            result?;
+                            if let Some(info) = source_hint.as_ref() {
+                                if source_parent
+                                    .as_deref()
+                                    .is_some_and(|parent| parent.ends_with("sealed"))
+                                {
+                                    Self::remove_sealed_index(inner, info);
+                                }
+                                if source_parent
+                                    .as_deref()
+                                    .is_some_and(|parent| parent.ends_with("sealed") || parent.ends_with("acked"))
+                                {
+                                    inner.stored_records = inner.stored_records.saturating_sub(info.event_count);
+                                }
+                            } else {
+                                self.rebuild_runtime_indexes_locked(inner);
+                            }
+                        }
+                        if !is_corruption_quarantine {
+                            if let Some(path) =
+                                find_quarantine_entry(&self.root.join("quarantine"), &pending.quarantine_basename)?
+                            {
+                                // The crash happened before the quarantine object
+                                // was removed. Complete that part of the eviction
+                                // transaction now; retain the fixed pending marker
+                                // until the gap is durable.
+                                // Keep the pending transaction intact when the
+                                // quarantine tree cannot be measured.  Deleting
+                                // with an unknown size would make capacity
+                                // accounting optimistic and lose the retryable
+                                // recovery proof.
+                                let (bytes, skipped_objects) = directory_size_status(&path)?;
+                                if skipped_objects {
+                                    mark_storage_rejection(inner, true);
+                                }
+                                remove_path(&path)?;
+                                Self::adjust_spool_bytes(inner, -i128::from(bytes));
+                                sync_dir(&self.root.join("quarantine"))?;
+                            }
+                        }
+                        let spec = marker_spec.unwrap_or_else(|| GapSpec {
+                            event_id: pending.gap_event_id.clone(),
+                            occurred_at_unix_ms: pending.recorded_at_unix_ms.0,
+                            lost_spool_epoch: pending.spool_epoch.clone(),
+                            reason: if is_corruption_quarantine {
+                                wire::SpoolGapReason::SegmentCorruption
+                            } else {
+                                wire::SpoolGapReason::QuarantineEviction
+                            },
+                            first_lost_spool_sequence: pending.first_spool_sequence.map(|v| v.0),
+                            last_lost_spool_sequence: pending.last_spool_sequence.map(|v| v.0),
+                            lost_events: pending.event_count.map(|v| v.0),
+                            lost_bytes: pending.raw_bytes.map(|v| v.0),
+                            lost_batch_id: pending.batch_id.clone(),
+                            source_fingerprint: None,
+                        });
+                        if durable_reason.is_none() && !inner.durable_gap_reasons.contains_key(&pending.gap_event_id) {
+                            self.write_gap_locked(inner, &spec)?;
+                        }
+                        self.discard_recovery_gap_locked(inner, &pending.gap_event_id)?;
+                        let commit = self.remove_tombstone_locked(inner, index)?;
+                        // Finishing a crashed quarantine eviction destroys the same
+                        // records `evict_quarantine_locked` would have accounted for,
+                        // so this leg must count them too -- it is the same durable
+                        // transaction, resumed.  Only the eviction leg: a
+                        // `segment_corruption` pending merely moved a damaged batch
+                        // into `quarantine/`, the object is still on disk and the
+                        // in-process path does not count that either.  The
+                        // already-acknowledged source rule from
+                        // `evict_quarantine_locked` applies here unchanged.
+                        if !is_corruption_quarantine && !quarantine_pending_source_is_acked(inner, &pending) {
+                            Self::add_evicted_unacked_records(inner, spec.lost_events.unwrap_or(0));
+                        }
+                        commit.finish()?;
+                        Ok(false)
+                    }
+                    TombstoneEntry::AckedReceipt(_) | TombstoneEntry::EvictedReceipt(_) => Ok(true),
+                }
+            })();
+            match result {
+                Ok(true) => index += 1,
+                Ok(false) => {}
+                Err(SpoolError::DurabilityUncertain) => {
+                    // A fatal write barrier is not a per-candidate fault.
+                    // Swallowing it into `Ok(())` let the caller keep writing
+                    // and ACK a producer event after the sticky state was set.
+                    return Err(SpoolError::DurabilityUncertain);
+                }
+                Err(_) => {
+                    // A single permanently unreadable candidate must not
+                    // prevent unrelated receipts/pending transactions from
+                    // reconciling, nor wedge every service request forever.
+                    // Retain the entry for a later retry and expose the fault.
+                    mark_storage_rejection(inner, true);
+                    index += 1;
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn seal_locked(&self, inner: &mut SpoolInner) -> Result<(), SpoolError> {
+        Self::reject_if_durability_uncertain(inner)?;
+        if inner.open_meta.event_count == 0 {
+            return Ok(());
+        }
+        inner.open_file.sync_all()?;
+        let batch_id = random_hex_id()?;
+        let first = inner
+            .open_meta
+            .first_sequence
+            .ok_or_else(|| SpoolError::InvalidState("open metadata missing first sequence".to_owned()))?;
+        let last = inner
+            .open_meta
+            .last_sequence
+            .ok_or_else(|| SpoolError::InvalidState("open metadata missing last sequence".to_owned()))?;
+        let sealed_root = self.root.join("sealed");
+        let tmp = sealed_root.join(format!(".tmp-{batch_id}"));
+        let final_dir = sealed_root.join(format!("{}-{}-{}-{}", inner.epoch, first, last, batch_id));
+        let open_path = self.root.join("open/current.ndjson");
+        let segment_path = tmp.join("segment.ndjson");
+        // Prepared before any rename so every recovery error can detach the
+        // writable descriptor from the segment inode. A directory descriptor
+        // is intentionally unusable by `write_record_locked`.
+        let detached_guard = File::open(self.root.join("open"))?;
+        #[cfg(test)]
+        let fail_after_open_rename = std::mem::take(&mut inner.faults.seal_after_open_rename);
+        let mut moved_open = false;
+        let operation = (|| -> Result<(File, u64), SpoolError> {
+            ensure_dir(&tmp, 0o700)?;
+            fs::rename(&open_path, &segment_path)?;
+            moved_open = true;
+            #[cfg(test)]
+            if fail_after_open_rename {
+                return Err(io::Error::other("injected seal failure after the open rename").into());
+            }
+            sync_dir(&self.root.join("open"))?;
+            sync_dir(&tmp)?;
+            let body = read_regular_file(&segment_path)?;
+            let meta =
+                wire::SpoolMeta::new(
+                    self.config.node_id.clone(),
+                    inner.epoch.clone(),
+                    batch_id.clone(),
+                    first,
+                    last,
+                    inner.open_meta.event_count,
+                    body.len() as u64,
+                    digest_hex(&body),
+                    inner.open_meta.first_received_at.ok_or_else(|| {
+                        SpoolError::InvalidState("open metadata missing first receive time".to_owned())
+                    })?,
+                    inner.open_meta.last_received_at.ok_or_else(|| {
+                        SpoolError::InvalidState("open metadata missing last receive time".to_owned())
+                    })?,
+                );
+            let meta_bytes = meta
+                .canonical_bytes()
+                .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+            let meta_len = meta_bytes.len() as u64;
+            write_atomic_file(&tmp.join("meta.json"), &meta_bytes, 0o600)?;
+            sync_dir(&tmp)?;
+            fs::rename(&tmp, &final_dir)?;
+            sync_dir(&sealed_root)?;
+            let new_file = OpenOptions::new()
+                .create(true)
+                .read(true)
+                .append(true)
+                .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+                .mode(0o600)
+                .open(&open_path)?;
+            set_file_mode(&open_path, 0o600)?;
+            new_file.sync_all()?;
+            sync_dir(&self.root.join("open"))?;
+            Ok((new_file, meta_len))
+        })();
+        match operation {
+            Ok((new_file, meta_len)) => {
+                // `meta_len` comes from the exact canonical bytes that were
+                // written.  Avoid a second pathname stat here: a concurrent
+                // replacement must not turn a completed seal into a falsely
+                // successful zero-byte accounting update.
+                Self::adjust_spool_bytes(inner, i128::from(meta_len));
+                inner.sealed_batches = inner.sealed_batches.saturating_add(1);
+                if let Some(received) = inner.open_meta.first_received_at {
+                    inner.sealed_received_at.insert(batch_id.clone(), received);
+                    inner.oldest_unacked_at_unix_ms = Some(
+                        inner
+                            .oldest_unacked_at_unix_ms
+                            .map_or(received, |old| old.min(received)),
+                    );
+                }
+                inner.sealed_paths.insert(batch_id.clone(), final_dir.clone());
+                inner.integrity_queue.push_back(batch_id.clone());
+                let contains_gap = inner.open_meta.contains_spool_gap;
+                inner.open_file = new_file;
+                inner.open_meta = OpenMetadata::empty();
+                if contains_gap {
+                    inner.unacked_gap_batches.insert(batch_id);
+                }
+                Ok(())
+            }
+            Err(error) => {
+                // Once current.ndjson has been renamed, the old descriptor in
+                // `inner.open_file` points at the segment inode.  Repair that
+                // invariant before returning the I/O error: callers may retry
+                // a seal, and must never append into a temporary or sealed
+                // directory through the stale descriptor.
+                let recovery_result = self.recover_seal_failure(
+                    inner,
+                    &open_path,
+                    &segment_path,
+                    &tmp,
+                    &final_dir,
+                    moved_open,
+                    detached_guard,
+                );
+                // A pre-rename failure has not changed any indexed record and
+                // must not trigger a full spool scan on every subsequent
+                // append. Rebuild immediately only when recovery established
+                // a completed/lost open transition. Persistent exceptional
+                // failures are otherwise rate-limited to one scan per minute.
+                let open_transitioned = moved_open && inner.open_meta.event_count == 0;
+                if open_transitioned
+                    || (recovery_result.is_err()
+                        && inner.last_spool_measurement.elapsed() >= INDEX_REBUILD_RETRY_INTERVAL)
+                {
+                    self.rebuild_runtime_indexes_locked(inner);
+                } else if recovery_result.is_err() {
+                    inner.spool_bytes_known = false;
+                }
+                // Repair the descriptor/path invariant before treating the
+                // original seal error as the result.  If recovery failed too,
+                // surface that stronger error and keep the spool degraded.
+                if let Err(recovery_error) = recovery_result {
+                    inner.degraded = true;
+                    inner.non_gap_degraded = true;
+                    // Recovery can return before the writable descriptor was
+                    // rebound to current.ndjson.  The detached `open/`
+                    // directory descriptor plus non-empty open metadata is not
+                    // repairable in process: `ensure_open_file_bound` then
+                    // rejects every later write with `InvalidState` forever and
+                    // the daemon never exits.  Escalate to the sticky fatal
+                    // state so the supervisor restarts and crash recovery runs.
+                    if Self::open_descriptor_is_unrepairable(inner, &open_path) {
+                        let _ = recovery_error;
+                        return Err(self.mark_durability_uncertain_locked(inner));
+                    }
+                    return Err(recovery_error);
+                }
+                Err(error)
+            }
+        }
+    }
+
+    /// Report whether a later `ensure_open_file_bound` can still repair the
+    /// writable open-segment descriptor.  This mirrors that function's own
+    /// binding rule: an empty open view is always repairable by reopening the
+    /// pathname, while a descriptor that no longer names current.ndjson while
+    /// `open_meta` still describes records is a permanent write failure.
+    fn open_descriptor_is_unrepairable(inner: &SpoolInner, open_path: &Path) -> bool {
+        if inner.open_meta.event_count == 0 && inner.open_meta.bytes == 0 {
+            return false;
+        }
+        let Ok(opened) = inner.open_file.metadata() else {
+            return true;
+        };
+        let bound = fs::symlink_metadata(open_path)
+            .is_ok_and(|current| current.is_file() && current.dev() == opened.dev() && current.ino() == opened.ino())
+            && opened.len() == inner.open_meta.bytes;
+        !bound
+    }
+
+    fn recover_seal_failure(
+        &self,
+        inner: &mut SpoolInner,
+        open_path: &Path,
+        segment_path: &Path,
+        tmp: &Path,
+        final_dir: &Path,
+        moved_open: bool,
+        detached_guard: File,
+    ) -> Result<(), SpoolError> {
+        if !moved_open {
+            // No rename succeeded, so the original descriptor still points at
+            // current.ndjson.  Keep the metadata and inode intact; the caller
+            // can retry the operation after reporting the original error.
+            return Ok(());
+        }
+        // Drop the descriptor that used to name current.ndjson before any
+        // fallible repair. If a later open/fsync/rename fails, subsequent
+        // appends encounter a descriptor/path mismatch instead of appending
+        // acknowledged bytes into an already sealed batch.
+        inner.open_file = detached_guard;
+        #[cfg(test)]
+        if std::mem::take(&mut inner.faults.seal_rollback) {
+            return Err(io::Error::other("injected seal rollback failure").into());
+        }
+        // A pathname at `final_dir` is not enough evidence that the rename
+        // completed: a pre-existing file (or a malicious symlink) can make
+        // the rename fail while still satisfying `metadata(...).is_ok()`.  A
+        // complete, node-owned batch with the expected ID is the durable
+        // completion marker.
+        let final_complete = match fs::symlink_metadata(final_dir) {
+            Ok(metadata) if metadata.is_dir() => match inspect_batch_dir(final_dir, &self.config.node_id) {
+                Ok(info) => final_dir
+                    .file_name()
+                    .and_then(|name| name.to_str())
+                    .is_some_and(|name| name.ends_with(&format!("-{}", info.batch_id))),
+                // A malformed final directory is not a completed seal.  It
+                // remains recovery input and is handled by the rollback path.
+                Err(_) => false,
+            },
+            Ok(_) => false,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => false,
+            Err(error) => return Err(error.into()),
+        };
+        if final_complete {
+            // The batch rename completed.  The original records are now
+            // durable in sealed/, so establish a fresh writable open inode.
+            // Clear the old metadata before any fallible open/fsync operation;
+            // if that operation fails, a later rebuild must not count the
+            // sealed records together with the old open view.
+            inner.open_meta = OpenMetadata::empty();
+            let file = OpenOptions::new()
+                .create(true)
+                .read(true)
+                .append(true)
+                .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+                .mode(0o600)
+                .open(open_path)?;
+            set_file_mode(open_path, 0o600)?;
+            file.sync_all()?;
+            sync_dir(&self.root.join("open"))?;
+            inner.open_file = file;
+            return Ok(());
+        }
+
+        // The final rename did not complete.  Put the segment back in its
+        // original location when possible, then remove the incomplete temp
+        // directory.  This preserves the in-memory metadata and lets the
+        // caller retry the seal without losing the open records.
+        let segment_exists = match fs::symlink_metadata(segment_path) {
+            Ok(_) => true,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => false,
+            Err(error) => return Err(error.into()),
+        };
+        let open_exists = match fs::symlink_metadata(open_path) {
+            Ok(_) => true,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => false,
+            Err(error) => return Err(error.into()),
+        };
+        if segment_exists && !open_exists {
+            fs::rename(segment_path, open_path)?;
+            // Persist removal of the segment entry in the temporary source
+            // directory as well as creation of current.ndjson. Without this
+            // barrier a crash can resurrect an orphaned temp batch.
+            sync_dir(tmp)?;
+            sync_dir(tmp.parent().unwrap_or_else(|| Path::new(".")))?;
+            sync_dir(open_path.parent().unwrap_or_else(|| Path::new(".")))?;
+        }
+        if open_exists || segment_exists {
+            let tmp_exists = match fs::symlink_metadata(tmp) {
+                Ok(_) => true,
+                Err(error) if error.kind() == io::ErrorKind::NotFound => false,
+                Err(error) => return Err(error.into()),
+            };
+            let cleanup_error = if tmp_exists {
+                fs::remove_dir_all(tmp).err()
+            } else {
+                None
+            };
+            let sync_error = tmp.parent().and_then(|parent| sync_dir(parent).err());
+            let file = OpenOptions::new()
+                .read(true)
+                .append(true)
+                .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+                .open(open_path)?;
+            set_file_mode(open_path, 0o600)?;
+            inner.open_file = file;
+            if let Some(error) = cleanup_error.or(sync_error) {
+                // The descriptor is already rebound safely; report the
+                // orphan cleanup failure so the caller keeps degraded health
+                // and retries on a later operation.
+                return Err(error.into());
+            }
+            return Ok(());
+        }
+
+        // If rollback itself could not find the inode, leave the temp object
+        // for crash recovery and create an empty open file only when the
+        // filesystem permits it.  The caller marks the spool degraded; the
+        // preserved temp object will be quarantined or promoted on restart.
+        let file = OpenOptions::new()
+            .create(true)
+            .read(true)
+            .append(true)
+            .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+            .mode(0o600)
+            .open(open_path)?;
+        set_file_mode(open_path, 0o600)?;
+        file.sync_all()?;
+        sync_dir(open_path.parent().unwrap_or_else(|| Path::new(".")))?;
+        inner.open_file = file;
+        inner.open_meta = OpenMetadata::empty();
+        Ok(())
+    }
+}
+
+#[derive(Debug)]
+struct OpenScan {
+    meta: OpenMetadata,
+    epoch: Option<String>,
+    max_sequence: u64,
+    event_ids: HashSet<String>,
+    tail_truncated: bool,
+}
+
+fn recover_layout(root: &Path, node_id: &str) -> Result<RecoveryResult, SpoolError> {
+    let mut degraded = false;
+    // Once a persisted object is quarantined, its sequence high-water mark is
+    // no longer fully provable from the surviving files.  Do not continue the
+    // old epoch merely because the remaining scan happens to be below the
+    // cursor; start a fresh epoch and emit the documented state-reset gap.
+    let mut history_untrusted = false;
+    let (mut recovery_gaps, marker_degraded, mut storage_rejected_attempts) = load_recovery_gap_markers(root)?;
+    if marker_degraded {
+        degraded = true;
+    }
+    let mut maxima: HashMap<String, u64> = HashMap::new();
+    let mut sequence_ranges: Vec<(String, u64, u64)> = Vec::new();
+    // Every recovery gap below describes one concrete damaged object.  Binding
+    // the gap to that object keeps two independent losses apart even when
+    // neither object yields a readable batch hint.
+    let source_fingerprint = |path: &Path| recovery_source_fingerprint(node_id, root, path);
+
+    // Finish or isolate interrupted seal directories before examining the
+    // high-water mark.  A complete temp batch can safely be promoted.
+    let sealed_root = root.join("sealed");
+    for path in list_hidden_dirs(&sealed_root)? {
+        // A crash before the open inode was renamed leaves an empty
+        // `.tmp-<batch-id>` directory. It carries no event bytes and must not
+        // become a synthetic corruption gap or consume capacity forever.
+        if path
+            .file_name()
+            .and_then(|value| value.to_str())
+            .is_some_and(|name| name.starts_with(".tmp-"))
+        {
+            let segment_missing = match fs::symlink_metadata(path.join("segment.ndjson")) {
+                Ok(_) => false,
+                Err(error) if error.kind() == io::ErrorKind::NotFound => true,
+                Err(_) => {
+                    // An unreadable segment is not evidence of an empty temp
+                    // directory. Preserve the object for a later retry and
+                    // expose the uncertainty instead of recursively deleting
+                    // potentially durable event bytes.
+                    degraded = true;
+                    storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+                    false
+                }
+            };
+            if segment_missing {
+                remove_path(&path)?;
+                sync_dir(&sealed_root)?;
+                continue;
+            }
+        }
+        match inspect_batch_dir(&path, node_id) {
+            Ok(info) => {
+                let final_dir = sealed_root.join(format!(
+                    "{}-{}-{}-{}",
+                    info.spool_epoch, info.first_spool_sequence, info.last_spool_sequence, info.batch_id
+                ));
+                if fs::rename(&path, &final_dir).is_ok() {
+                    sync_dir(&sealed_root)?;
+                } else {
+                    degraded = true;
+                    history_untrusted = true;
+                    let spec = corruption_gap_spec_or_existing(&recovery_gaps, Some(&info), source_fingerprint(&path))?;
+                    enqueue_recovery_gap(root, &mut recovery_gaps, spec, &mut degraded)?;
+                    quarantine_recovery_path(
+                        root,
+                        &path,
+                        "seal-incomplete",
+                        &mut degraded,
+                        &mut storage_rejected_attempts,
+                    );
+                }
+            }
+            Err(_) => {
+                degraded = true;
+                history_untrusted = true;
+                let hint = read_meta_hint(&path, node_id);
+                let spec = corruption_gap_spec_or_existing(&recovery_gaps, hint.as_ref(), source_fingerprint(&path))?;
+                enqueue_recovery_gap(root, &mut recovery_gaps, spec, &mut degraded)?;
+                quarantine_recovery_path(
+                    root,
+                    &path,
+                    "seal-incomplete",
+                    &mut degraded,
+                    &mut storage_rejected_attempts,
+                );
+            }
+        }
+    }
+
+    for parent_name in ["sealed", "acked"] {
+        let parent = root.join(parent_name);
+        let paths = list_batch_dirs(&parent)?;
+        for path in paths {
+            match inspect_batch_dir(&path, node_id) {
+                Ok(info) => {
+                    maxima
+                        .entry(info.spool_epoch.clone())
+                        .and_modify(|value| *value = (*value).max(info.last_spool_sequence))
+                        .or_insert(info.last_spool_sequence);
+                    sequence_ranges.push((
+                        info.spool_epoch.clone(),
+                        info.first_spool_sequence,
+                        info.last_spool_sequence,
+                    ));
+                }
+                Err(_) => {
+                    degraded = true;
+                    history_untrusted = true;
+                    let hint = read_meta_hint(&path, node_id);
+                    let spec =
+                        corruption_gap_spec_or_existing(&recovery_gaps, hint.as_ref(), source_fingerprint(&path))?;
+                    enqueue_recovery_gap(root, &mut recovery_gaps, spec, &mut degraded)?;
+                    // Unlike the in-process quarantine paths, this one isolates on
+                    // any `inspect_batch_dir` failure -- a readable meta.json with a
+                    // corrupt body included -- so an object from `acked/` arrives in
+                    // quarantine with its event count intact.  Record the source in
+                    // the label or the later eviction cannot tell delivered events
+                    // from lost ones.
+                    let label = if parent_name == "acked" {
+                        QUARANTINE_LABEL_ACKED
+                    } else {
+                        QUARANTINE_LABEL_UNACKED
+                    };
+                    quarantine_recovery_path(root, &path, label, &mut degraded, &mut storage_rejected_attempts);
+                }
+            }
+        }
+    }
+
+    let open_path = root.join("open/current.ndjson");
+    let open_metadata = match fs::symlink_metadata(&open_path) {
+        Ok(metadata) => Some(metadata),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => None,
+        Err(_) => {
+            // The subsequent read will fail as well, but record the metadata
+            // uncertainty explicitly instead of silently treating it as a
+            // normal regular-file corruption.
+            degraded = true;
+            storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+            None
+        }
+    };
+    let open_is_symlink = open_metadata
+        .as_ref()
+        .is_some_and(|metadata| metadata.file_type().is_symlink());
+    let pending_orphan_gap = open_metadata
+        .as_ref()
+        .filter(|metadata| metadata.is_file() && metadata.len() != 0)
+        .and_then(|metadata| orphan_open_gap_for_metadata(&recovery_gaps, node_id, metadata));
+    let open_bytes = if pending_orphan_gap.is_some() {
+        // A source-bound marker proves this exact inode was classified before
+        // a previous crash. Finish that transaction without letting an
+        // unrelated generic corruption marker claim the object.
+        degraded = true;
+        quarantine_recovery_path(
+            root,
+            &open_path,
+            "orphan-open",
+            &mut degraded,
+            &mut storage_rejected_attempts,
+        );
+        Vec::new()
+    } else {
+        match read_regular_file(&open_path) {
+            Ok(bytes) => bytes,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => Vec::new(),
+            Err(_) if open_is_symlink => {
+                degraded = true;
+                history_untrusted = true;
+                let spec = corruption_gap_spec_or_existing(&recovery_gaps, None, source_fingerprint(&open_path))?;
+                enqueue_recovery_gap(root, &mut recovery_gaps, spec, &mut degraded)?;
+                quarantine_recovery_path(
+                    root,
+                    &open_path,
+                    "open-symlink",
+                    &mut degraded,
+                    &mut storage_rejected_attempts,
+                );
+                Vec::new()
+            }
+            Err(_) => {
+                // A regular open file that is too large, malformed, or otherwise
+                // unreadable is untrusted history. Isolate it and continue in a
+                // fresh epoch when possible; refusing to start would turn an
+                // audit-storage fault into a data-plane outage. If the rename
+                // itself fails, propagate that bounded I/O error instead of
+                // silently discarding the inode.
+                degraded = true;
+                history_untrusted = true;
+                let spec = corruption_gap_spec_or_existing(&recovery_gaps, None, source_fingerprint(&open_path))?;
+                enqueue_recovery_gap(root, &mut recovery_gaps, spec, &mut degraded)?;
+                quarantine_recovery_path(
+                    root,
+                    &open_path,
+                    "open-corrupt",
+                    &mut degraded,
+                    &mut storage_rejected_attempts,
+                );
+                Vec::new()
+            }
+        }
+    };
+    let open_scan = match scan_open_bytes(&open_bytes, node_id) {
+        Ok(value) => value,
+        Err(_) => {
+            degraded = true;
+            history_untrusted = true;
+            let spec = corruption_gap_spec_or_existing(&recovery_gaps, None, source_fingerprint(&open_path))?;
+            enqueue_recovery_gap(root, &mut recovery_gaps, spec, &mut degraded)?;
+            if !open_bytes.is_empty() {
+                quarantine_recovery_path(
+                    root,
+                    &open_path,
+                    "open-corrupt",
+                    &mut degraded,
+                    &mut storage_rejected_attempts,
+                );
+            }
+            OpenScan {
+                meta: OpenMetadata::empty(),
+                epoch: None,
+                max_sequence: 0,
+                event_ids: HashSet::new(),
+                tail_truncated: false,
+            }
+        }
+    };
+    if let Some(epoch) = &open_scan.epoch {
+        maxima
+            .entry(epoch.clone())
+            .and_modify(|value| *value = (*value).max(open_scan.max_sequence))
+            .or_insert(open_scan.max_sequence);
+        if let (Some(first), Some(last)) = (open_scan.meta.first_sequence, open_scan.meta.last_sequence) {
+            sequence_ranges.push((epoch.clone(), first, last));
+        }
+    }
+    if open_scan.tail_truncated {
+        degraded = true;
+        let retained = open_bytes
+            .iter()
+            .rposition(|byte| *byte == b'\n')
+            .map_or(0, |index| index + 1);
+        let spec = tail_truncation_gap_spec_or_existing(
+            &recovery_gaps,
+            open_scan.epoch.as_deref(),
+            source_fingerprint(&open_path),
+        )?;
+        enqueue_recovery_gap(root, &mut recovery_gaps, spec, &mut degraded)?;
+        truncate_open(&open_path, retained)?;
+    }
+
+    let state_path = root.join("state.json");
+    let state = load_state(&state_path);
+    let state_missing = matches!(&state, Ok(None));
+    let mut force_new_epoch = false;
+    let (mut epoch, mut next_sequence, mut pending_state_reset) = match state {
+        Ok(Some(value)) if value.state_schema_version == STATE_SCHEMA_VERSION => (
+            value.spool_epoch,
+            value.next_spool_sequence.0,
+            value.pending_state_reset,
+        ),
+        Ok(Some(_)) | Err(_) => {
+            degraded = true;
+            // A malformed or unreadable cursor forces a conservative epoch
+            // reset. Keep the recovery cause visible in the bounded
+            // health counter; otherwise a reset caused by storage corruption
+            // would look indistinguishable from a clean initialization.
+            storage_rejected_attempts = saturating_inc(storage_rejected_attempts);
+            force_new_epoch = true;
+            (random_hex_id()?, 1, None)
+        }
+        Ok(None) => {
+            // A brand-new spool has no cursor yet.  This is normal
+            // initialization, not a rejected storage operation; the later
+            // empty-spool branch clears the transient degraded bit without
+            // manufacturing a reset gap or health counter entry.
+            degraded = true;
+            force_new_epoch = true;
+            (random_hex_id()?, 1, None)
+        }
+    };
+
+    let current_max = maxima.get(&epoch).copied().unwrap_or(0);
+    let open_epoch_mismatch = open_scan.epoch.as_deref().is_some_and(|value| value != epoch);
+
+    // A valid state cursor proves that deleted history may exist, but it
+    // cannot make two surviving objects claim the same sequence range.  Such
+    // overlap is evidence of a copy/rename or metadata corruption; abandon
+    // the epoch rather than exporting ambiguous `(epoch, sequence)` keys.
+    sequence_ranges.sort_by(|left, right| {
+        left.0
+            .cmp(&right.0)
+            .then_with(|| left.1.cmp(&right.1))
+            .then_with(|| left.2.cmp(&right.2))
+    });
+    if sequence_ranges.windows(2).any(|window| {
+        let left = &window[0];
+        let right = &window[1];
+        left.0 == right.0 && right.1 <= left.2
+    }) {
+        degraded = true;
+        history_untrusted = true;
+    }
+
+    // A pending state-reset is the one explicit crash window in which a
+    // cursor that is at-or-behind the scanned high-water mark may be repaired
+    // in place.  Evaluate this exception before the normal `next <= max`
+    // epoch-reset rule; otherwise a crash between the record fsync and the
+    // state fsync would unnecessarily create a second epoch and gap.
+    if history_untrusted {
+        force_new_epoch = true;
+    }
+    // A brand-new spool has no lost history to explain.  Do not manufacture a
+    // state-reset gap merely because state.json has not been created yet; the
+    // first durable append will establish the cursor normally.
+    if state_missing
+        && !history_untrusted
+        && open_bytes.is_empty()
+        && maxima.is_empty()
+        && list_batch_dirs(&root.join("sealed")).map_or(true, |paths| paths.is_empty())
+        && list_batch_dirs(&root.join("acked")).map_or(true, |paths| paths.is_empty())
+        && list_entries(&root.join("quarantine")).map_or(true, |paths| paths.is_empty())
+        && recovery_gaps.is_empty()
+    {
+        force_new_epoch = false;
+        // Clear only the synthetic "state missing" initialization marker.
+        // Earlier recovery/storage failures remain visible on an otherwise
+        // empty node and must not be erased by this branch.
+        degraded = storage_rejected_attempts != 0;
+    }
+    if !force_new_epoch {
+        if let Some(pending) = pending_state_reset.as_ref() {
+            let pending_found = (open_scan.event_ids.contains(&pending.gap_event_id)
+                && open_scan.epoch.as_deref() == Some(epoch.as_str()))
+                || event_id_exists_in_epoch(root, &pending.gap_event_id, &epoch)?;
+            if pending_found {
+                let scanned_max = maxima.get(&epoch).copied().unwrap_or(0);
+                match scanned_max.checked_add(1) {
+                    Some(repaired_next) => {
+                        next_sequence = next_sequence.max(repaired_next);
+                        pending_state_reset = None;
+                    }
+                    None => {
+                        // There is no representable sequence after a durable
+                        // u64::MAX record.  Start a fresh epoch rather than
+                        // risking wraparound or reusing the old cursor.
+                        force_new_epoch = true;
+                    }
+                }
+            } else if next_sequence == 0 || next_sequence <= current_max {
+                // Keep the fixed pending gap ID while advancing past records
+                // that were durable before the crash.  The first subsequent
+                // write will emit that gap before accepting a new event.
+                match current_max.checked_add(1) {
+                    Some(repaired_next) => next_sequence = repaired_next,
+                    None => force_new_epoch = true,
+                }
+            }
+        } else if next_sequence == 0 || next_sequence <= current_max {
+            force_new_epoch = true;
+        }
+        if open_epoch_mismatch {
+            force_new_epoch = true;
+        }
+    }
+
+    if force_new_epoch {
+        degraded = true;
+        if !open_bytes.is_empty() && open_path.exists() {
+            quarantine_recovery_path(
+                root,
+                &open_path,
+                "state-reset",
+                &mut degraded,
+                &mut storage_rejected_attempts,
+            );
+        }
+        let old_epoch = open_scan.epoch.clone();
+        epoch = random_hex_id()?;
+        next_sequence = 1;
+        pending_state_reset = Some(PendingStateReset {
+            gap_event_id: format!("{}{}", GAP_ID_PREFIX, random_hex_id()?),
+            occurred_at_unix_ms: unix_millis()?.into(),
+            lost_spool_epoch: old_epoch,
+            first_lost_spool_sequence: None,
+            last_lost_spool_sequence: None,
+        });
+        // Keep any independently discovered corruption gaps.  A state reset
+        // does not prove that those other quarantined records were retained.
+        persist_state(root, &epoch, next_sequence, pending_state_reset.clone())?;
+    } else {
+        // Persist a repaired cursor or cleared pending marker before accepting
+        // new records.  Rewriting an already-valid state is harmless and also
+        // covers the pending-but-gap-not-yet-written recovery case.
+        persist_state(root, &epoch, next_sequence, pending_state_reset.clone())?;
+    }
+
+    let mut recovered_open_meta = if force_new_epoch {
+        OpenMetadata::empty()
+    } else {
+        open_scan.meta
+    };
+    if !force_new_epoch {
+        // Preserve the segment's real age across a daemon restart so the
+        // configured max-age seal rule is not silently postponed.
+        if let Ok(modified) = fs::metadata(&open_path).and_then(|metadata| metadata.modified()) {
+            recovered_open_meta.opened_at = modified;
+        }
+    }
+
+    Ok(RecoveryResult {
+        epoch,
+        next_sequence,
+        degraded,
+        gap_degraded: pending_state_reset.is_some() || !recovery_gaps.is_empty(),
+        storage_rejected_attempts,
+        open_meta: recovered_open_meta,
+        pending_state_reset,
+        recovery_gaps,
+    })
+}
+
+fn load_state(path: &Path) -> Result<Option<wire::SpoolState>, SpoolError> {
+    let bytes = match read_regular_file(&path) {
+        Ok(value) => value,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error.into()),
+    };
+    wire::parse_spool_state(&bytes)
+        .map(Some)
+        .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))
+}
+
+fn inspect_batch_dir(path: &Path, node_id: &str) -> Result<BatchInfo, SpoolError> {
+    enforce_private_dir(path)?;
+    enforce_private_file(&path.join("meta.json"))?;
+    enforce_private_file(&path.join("segment.ndjson"))?;
+    let info = read_meta_hint(path, node_id)
+        .ok_or_else(|| SpoolError::InvalidState("batch metadata is missing or invalid".to_owned()))?;
+    let body = read_regular_file(&path.join("segment.ndjson"))?;
+    if body.len() as u64 != info.raw_bytes || digest_hex(&body) != info.body_sha256 || !body.ends_with(b"\n") {
+        return Err(SpoolError::InvalidState(
+            "batch body digest or framing mismatch".to_owned(),
+        ));
+    }
+    validate_segment_body(&body, &info, node_id)?;
+    Ok(info)
+}
+
+fn enforce_private_dir(path: &Path) -> Result<(), SpoolError> {
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW | libc::O_DIRECTORY)
+        .open(path)?;
+    if !file.metadata()?.is_dir() {
+        return Err(SpoolError::InvalidState(format!(
+            "spool batch is not a regular directory: {}",
+            path.display()
+        )));
+    }
+    file.set_permissions(fs::Permissions::from_mode(0o700))?;
+    // Keep the ownership check descriptor-bound.  Mode 0700 alone is not
+    // sufficient when the daemon runs with elevated privileges: a spool
+    // object pre-created by another account must not become trusted history.
+    validate_private_dir_fd(file.as_raw_fd())?;
+    Ok(())
+}
+
+fn enforce_private_file(path: &Path) -> Result<(), SpoolError> {
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+        .open(path)?;
+    if !file.metadata()?.is_file() {
+        return Err(SpoolError::InvalidState(format!(
+            "spool object is not a regular file: {}",
+            path.display()
+        )));
+    }
+    file.set_permissions(fs::Permissions::from_mode(0o600))?;
+    validate_private_file_fd(file.as_raw_fd())?;
+    Ok(())
+}
+
+fn read_meta_hint(path: &Path, node_id: &str) -> Option<BatchInfo> {
+    if fs::symlink_metadata(path).ok()?.file_type().is_symlink() {
+        return None;
+    }
+    let meta_bytes = read_regular_file(&path.join("meta.json")).ok()?;
+    let meta = wire::parse_spool_meta(&meta_bytes).ok()?;
+    if meta.node_id != node_id {
+        return None;
+    }
+    Some(BatchInfo {
+        node_id: meta.node_id,
+        spool_epoch: meta.spool_epoch,
+        batch_id: meta.batch_id,
+        first_spool_sequence: meta.first_spool_sequence.0,
+        last_spool_sequence: meta.last_spool_sequence.0,
+        event_count: meta.event_count.0,
+        raw_bytes: meta.raw_bytes.0,
+        body_sha256: meta.body_sha256,
+        first_received_at_unix_ms: meta.first_received_at_unix_ms.0,
+        last_received_at_unix_ms: meta.last_received_at_unix_ms.0,
+        path: path.to_path_buf(),
+    })
+}
+
+fn validate_segment_body(body: &[u8], info: &BatchInfo, node_id: &str) -> Result<(), SpoolError> {
+    let mut count = 0_u64;
+    let mut expected = info.first_spool_sequence;
+    let mut first_received: Option<u64> = None;
+    let mut last_received: Option<u64> = None;
+    for line in body.split_inclusive(|byte| *byte == b'\n') {
+        let record = wire::parse_spool_line(line).map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+        if record.spool_epoch != info.spool_epoch || record.spool_sequence.0 != expected {
+            return Err(SpoolError::InvalidState("batch sequence/epoch mismatch".to_owned()));
+        }
+        let event = parse_stored_event(record.event_bytes())?;
+        if stored_event_node_id(&event) != node_id || !stored_event_epoch_matches(&event, &record.spool_epoch) {
+            return Err(SpoolError::InvalidState("batch event node mismatch".to_owned()));
+        }
+        let received = record.received_at_unix_ms.0;
+        first_received = Some(first_received.map_or(received, |first| first.min(received)));
+        last_received = Some(last_received.map_or(received, |last| last.max(received)));
+        count = count.saturating_add(1);
+        expected = expected.checked_add(1).ok_or(SpoolError::SequenceExhausted)?;
+    }
+    if count != info.event_count
+        || count == 0
+        || expected.saturating_sub(1) != info.last_spool_sequence
+        || first_received != Some(info.first_received_at_unix_ms)
+        || last_received != Some(info.last_received_at_unix_ms)
+    {
+        return Err(SpoolError::InvalidState(
+            "batch metadata does not match body".to_owned(),
+        ));
+    }
+    Ok(())
+}
+
+fn scan_open_bytes(bytes: &[u8], node_id: &str) -> Result<OpenScan, SpoolError> {
+    if bytes.is_empty() {
+        return Ok(OpenScan {
+            meta: OpenMetadata::empty(),
+            epoch: None,
+            max_sequence: 0,
+            event_ids: HashSet::new(),
+            tail_truncated: false,
+        });
+    }
+    let last_lf = bytes.iter().rposition(|byte| *byte == b'\n');
+    let (complete, tail_truncated) = match last_lf {
+        Some(index) if index + 1 < bytes.len() => (&bytes[..=index], true),
+        Some(index) => (&bytes[..=index], false),
+        None => (&[][..], true),
+    };
+    if tail_truncated {
+        // The caller performs the actual truncation after this scan; this
+        // function remains side-effect free for batch validation tests.
+    }
+    let mut meta = OpenMetadata::empty();
+    let mut epoch = None;
+    let mut max_sequence = 0_u64;
+    let mut expected = None;
+    let mut event_ids = HashSet::new();
+    for line in complete.split_inclusive(|byte| *byte == b'\n') {
+        let record = wire::parse_spool_line(line).map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+        let record_epoch = record.spool_epoch.as_str();
+        if let Some(existing) = &epoch {
+            if existing != record_epoch {
+                return Err(SpoolError::InvalidState("open epoch changed".to_owned()));
+            }
+        } else {
+            epoch = Some(record_epoch.to_owned());
+        }
+        let sequence = record.spool_sequence.0;
+        if expected.is_some_and(|value| sequence != value) {
+            return Err(SpoolError::InvalidState("open sequence is not contiguous".to_owned()));
+        }
+        expected = Some(sequence.checked_add(1).ok_or(SpoolError::SequenceExhausted)?);
+        let event = parse_stored_event(record.event_bytes())?;
+        if stored_event_node_id(&event) != node_id || !stored_event_epoch_matches(&event, record_epoch) {
+            return Err(SpoolError::InvalidState("open event node mismatch".to_owned()));
+        }
+        event_ids.insert(event.event_id().to_owned());
+        max_sequence = max_sequence.max(sequence);
+        update_open_metadata(&mut meta, sequence, record.received_at_unix_ms.0, line.len() as u64);
+        meta.contains_spool_gap |= line_is_spool_gap(line);
+    }
+    Ok(OpenScan {
+        meta,
+        epoch,
+        max_sequence,
+        event_ids,
+        tail_truncated,
+    })
+}
+
+fn truncate_open(path: &Path, length: usize) -> Result<(), SpoolError> {
+    let file = OpenOptions::new()
+        .write(true)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+        .open(path)?;
+    file.set_len(length as u64)?;
+    file.sync_all()?;
+    if let Some(parent) = path.parent() {
+        sync_dir(parent)?;
+    }
+    Ok(())
+}
+
+fn wrapper_bytes_from_record(
+    epoch: &str,
+    sequence: u64,
+    received: u64,
+    event: &wire::AuditRecord,
+) -> Result<Vec<u8>, SpoolError> {
+    let record = wire::SpoolRecord::from_event_record(epoch.to_owned(), sequence, received, event)
+        .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+    // `from_event_record` has already validated the typed event and wrapper
+    // envelope. Serialize directly here so `ndjson_line()` does not parse the
+    // event a second time through its defensive public validation path.
+    let mut bytes =
+        wire::serialize_canonical(&record).map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+    bytes.push(b'\n');
+    Ok(bytes)
+}
+
+fn wrapper_bytes(epoch: &str, sequence: u64, received: u64, event_raw: &[u8]) -> Result<Vec<u8>, SpoolError> {
+    let record = wire::SpoolRecord::from_event_bytes(epoch.to_owned(), sequence, received, event_raw)
+        .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+    record
+        .ndjson_line()
+        .map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))
+}
+
+/// Parse an event already persisted in the spool.  Unlike the ingest parser,
+/// this deliberately accepts auditd-generated `spool_gap` records as well as
+/// producer access/diagnostic records.  Treating the internal variant as an
+/// ingest error would make recovery unable to find an existing gap ID and
+/// could generate duplicate state/eviction gaps after a restart.
+fn parse_stored_event(bytes: &[u8]) -> Result<wire::AuditRecord, SpoolError> {
+    wire::parse_canonical_record(bytes).map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))
+}
+
+fn body_contains_spool_gap(body: &[u8]) -> bool {
+    body.split_inclusive(|byte| *byte == b'\n').any(|line| {
+        wire::parse_spool_line(line)
+            .ok()
+            .and_then(|record| parse_stored_event(record.event_bytes()).ok())
+            .is_some_and(|event| matches!(event, wire::AuditRecord::SpoolGap(_)))
+    })
+}
+
+fn collect_spool_gap_reasons(body: &[u8], gaps: &mut HashMap<String, wire::SpoolGapReason>) {
+    for_each_spool_gap(body, |gap| {
+        gaps.insert(gap.event_id, gap.reason);
+    });
+}
+
+/// Drop the gap IDs carried by a segment body from the durable index.  The
+/// index answers "is this gap already durable"; a segment that no longer
+/// exists cannot keep answering yes.
+fn forget_durable_gap_reasons(body: &[u8], gaps: &mut HashMap<String, wire::SpoolGapReason>) {
+    for_each_spool_gap(body, |gap| {
+        gaps.remove(&gap.event_id);
+    });
+}
+
+fn for_each_spool_gap(body: &[u8], mut visit: impl FnMut(wire::SpoolGap)) {
+    for line in body.split_inclusive(|byte| *byte == b'\n') {
+        let Some(wire::AuditRecord::SpoolGap(gap)) = wire::parse_spool_line(line)
+            .ok()
+            .and_then(|record| parse_stored_event(record.event_bytes()).ok())
+        else {
+            continue;
+        };
+        visit(gap);
+    }
+}
+
+fn stored_event_node_id(event: &wire::AuditRecord) -> &str {
+    match event {
+        wire::AuditRecord::Access(value) => &value.node_id,
+        wire::AuditRecord::ProducerGap(value) => &value.node_id,
+        wire::AuditRecord::UdpWindowContention(value) => &value.node_id,
+        wire::AuditRecord::SpoolGap(value) => &value.node_id,
+    }
+}
+
+fn stored_event_epoch_matches(event: &wire::AuditRecord, wrapper_epoch: &str) -> bool {
+    match event {
+        // Access and producer diagnostics carry a runtime, not a spool epoch;
+        // the wrapper is the authority for those variants.
+        wire::AuditRecord::Access(_)
+        | wire::AuditRecord::ProducerGap(_)
+        | wire::AuditRecord::UdpWindowContention(_) => true,
+        wire::AuditRecord::SpoolGap(value) => value.spool_epoch == wrapper_epoch,
+    }
+}
+
+fn update_open_metadata(meta: &mut OpenMetadata, sequence: u64, received: u64, bytes: u64) {
+    meta.bytes = meta.bytes.saturating_add(bytes);
+    meta.event_count = meta.event_count.saturating_add(1);
+    meta.first_sequence.get_or_insert(sequence);
+    meta.last_sequence = Some(sequence);
+    meta.first_received_at = Some(meta.first_received_at.map_or(received, |first| first.min(received)));
+    meta.last_received_at = Some(meta.last_received_at.map_or(received, |last| last.max(received)));
+}
+
+fn line_is_spool_gap(line: &[u8]) -> bool {
+    wire::parse_spool_line(line)
+        .ok()
+        .and_then(|record| parse_stored_event(record.event_bytes()).ok())
+        .is_some_and(|event| matches!(event, wire::AuditRecord::SpoolGap(_)))
+}
+
+fn list_batch_dirs(path: &Path) -> Result<Vec<PathBuf>, SpoolError> {
+    let mut result = Vec::new();
+    for entry in fs::read_dir(path)? {
+        let entry = entry?;
+        let file_name = entry.file_name();
+        let file_type = entry.file_type()?;
+        if !file_name.to_string_lossy().starts_with('.') && (file_type.is_dir() || file_type.is_symlink()) {
+            result.push(entry.path());
+        }
+    }
+    Ok(result)
+}
+
+fn list_hidden_dirs(path: &Path) -> Result<Vec<PathBuf>, SpoolError> {
+    let mut result = Vec::new();
+    for entry in fs::read_dir(path)? {
+        let entry = entry?;
+        if entry.file_type()?.is_dir() && entry.file_name().to_string_lossy().starts_with('.') {
+            result.push(entry.path());
+        }
+    }
+    Ok(result)
+}
+
+fn list_entries(path: &Path) -> Result<Vec<PathBuf>, SpoolError> {
+    let mut result = Vec::new();
+    for entry in fs::read_dir(path)? {
+        let entry = entry?;
+        result.push(entry.path());
+    }
+    Ok(result)
+}
+
+fn find_quarantine_entry(root: &Path, basename: &str) -> Result<Option<PathBuf>, SpoolError> {
+    let exact = root.join(basename);
+    match fs::symlink_metadata(&exact) {
+        Ok(_) => return Ok(Some(exact)),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+        Err(error) => return Err(error.into()),
+    }
+    let suffix = format!("-{basename}");
+    let entries = match fs::read_dir(root) {
+        Ok(value) => value,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error.into()),
+    };
+    for entry in entries {
+        let entry = entry?;
+        let path = entry.path();
+        let matches = path
+            .file_name()
+                .and_then(|value| value.to_str())
+                // `quarantine_path` prefixes the source basename with a
+                // reason and timestamp (for example
+                // `batch-corrupt-<nanos>-<source>`).  Pending markers store
+                // the source basename, so recovery must match that suffix as
+                // well as the legacy basename-first form.
+                .is_some_and(|name| {
+                    name.starts_with(&format!("{basename}-")) || name.ends_with(&suffix)
+                });
+        if matches {
+            return Ok(Some(path));
+        }
+    }
+    Ok(None)
+}
+
+fn find_path_with_basename(root: &Path, basename: &str) -> Result<Option<PathBuf>, SpoolError> {
+    let exact = root.join(basename);
+    match fs::symlink_metadata(&exact) {
+        Ok(_) => Ok(Some(exact)),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(None),
+        Err(error) => Err(error.into()),
+    }
+}
+
+fn remove_path(path: &Path) -> io::Result<()> {
+    let metadata = fs::symlink_metadata(path)?;
+    if metadata.is_dir() {
+        fs::remove_dir_all(path)
+    } else {
+        fs::remove_file(path)
+    }
+}
+
+fn persist_state(
+    root: &Path,
+    epoch: &str,
+    next_sequence: u64,
+    pending_state_reset: Option<PendingStateReset>,
+) -> Result<(), SpoolError> {
+    persist_state_atomic(root, epoch, next_sequence, pending_state_reset).map_err(AtomicWriteError::into_spool_error)
+}
+
+fn persist_state_atomic(
+    root: &Path,
+    epoch: &str,
+    next_sequence: u64,
+    pending_state_reset: Option<PendingStateReset>,
+) -> Result<(), AtomicWriteError> {
+    let state = wire::SpoolState {
+        state_schema_version: STATE_SCHEMA_VERSION,
+        spool_epoch: epoch.to_owned(),
+        next_spool_sequence: next_sequence.into(),
+        pending_state_reset,
+    };
+    let bytes = state
+        .canonical_bytes()
+        .map_err(|error| AtomicWriteError::BeforeRename(SpoolError::Protocol(ProtocolError::from(error))))?;
+    write_atomic_file_staged(&root.join("state.json"), &bytes, 0o600)
+}
+
+fn load_tombstones(root: &Path) -> Result<Vec<TombstoneEntry>, SpoolError> {
+    let path = root.join("tombstones.json");
+    let bytes = match read_regular_file(&path) {
+        Ok(value) => value,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(Vec::new()),
+        Err(error) => return Err(error.into()),
+    };
+    let ledger =
+        wire::parse_tombstone_ledger(&bytes).map_err(|error| SpoolError::Protocol(ProtocolError::from(error)))?;
+    // Existing ledgers may predate the current startup path or have been
+    // restored with broader permissions.  The spool contract keeps every
+    // regular file private, so repair the mode before accepting the ledger.
+    // `read_regular_file` already opened this path with O_NOFOLLOW; reject a
+    // replacement symlink rather than chmodding an attacker-controlled target.
+    let metadata = fs::symlink_metadata(&path)?;
+    if metadata.file_type().is_symlink() || !metadata.is_file() {
+        return Err(SpoolError::InvalidState(
+            "tombstone ledger must be a regular file".to_owned(),
+        ));
+    }
+    set_file_mode(&path, 0o600)?;
+    let mut batches: HashSet<(&str, &str)> = HashSet::new();
+    let mut gaps: HashSet<&str> = HashSet::new();
+    for entry in &ledger.entries {
+        if let Some(batch_id) = entry.batch_id()
+            && !batches.insert((entry.entry_type(), batch_id))
+        {
+            return Err(SpoolError::InvalidState(
+                "tombstone ledger contains duplicate batch_id".to_owned(),
+            ));
+        }
+        if let Some(gap_id) = entry.gap_event_id()
+            && !gaps.insert(gap_id)
+        {
+            return Err(SpoolError::InvalidState(
+                "tombstone ledger contains duplicate gap_event_id".to_owned(),
+            ));
+        }
+    }
+    Ok(ledger.entries)
+}
+
+/// Recover independently valid ledger entries after a torn/non-canonical
+/// tombstone write. Pending transactions are retained when their own object
+/// validates, while malformed entries are discarded conservatively and the
+/// spool remains degraded so operators can inspect the quarantined original.
+fn salvage_tombstones(root: &Path) -> Result<Vec<TombstoneEntry>, SpoolError> {
+    let bytes = read_regular_file(&root.join("tombstones.json"))?;
+    let value: serde_json::Value = serde_json::from_slice(&bytes).map_err(|error| SpoolError::Json(error))?;
+    let entries = value
+        .get("entries")
+        .and_then(serde_json::Value::as_array)
+        .ok_or_else(|| SpoolError::InvalidState("tombstone entries are not an array".to_owned()))?;
+    let mut recovered = Vec::new();
+    for value in entries {
+        let Ok(entry) = serde_json::from_value::<TombstoneEntry>(value.clone()) else {
+            continue;
+        };
+        if entry.validate().is_err() {
+            continue;
+        }
+        let duplicate_batch = entry.batch_id().is_some_and(|batch_id| {
+            recovered.iter().any(|existing: &TombstoneEntry| {
+                existing.entry_type() == entry.entry_type() && existing.batch_id() == Some(batch_id)
+            })
+        });
+        let duplicate_gap = entry
+            .gap_event_id()
+            .is_some_and(|gap_id| recovered.iter().any(|existing| existing.gap_event_id() == Some(gap_id)));
+        if !duplicate_batch && !duplicate_gap {
+            recovered.push(entry);
+        }
+    }
+    Ok(recovered)
+}
+
+fn persist_tombstones(root: &Path, entries: &[TombstoneEntry]) -> Result<(), AtomicWriteError> {
+    let ledger = wire::TombstoneLedger::new(entries.to_vec());
+    let bytes = ledger
+        .canonical_bytes()
+        .map_err(|error| AtomicWriteError::BeforeRename(SpoolError::Protocol(ProtocolError::from(error))))?;
+    write_atomic_file_staged(&root.join("tombstones.json"), &bytes, 0o600)
+}
+
+fn ensure_dir(path: &Path, mode: u32) -> io::Result<()> {
+    // `create_dir_all` follows a symlink introduced below a missing component.
+    // Resolve each component relative to an already-open directory descriptor
+    // and use O_NOFOLLOW for the child. This keeps a concurrent pathname
+    // replacement from redirecting creation or chmod outside the spool tree.
+    if !path.is_absolute() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "spool directory path must be absolute",
+        ));
+    }
+
+    let root_fd = unsafe {
+        // SAFETY: the literal path and flags are valid for the Linux-only
+        // audit daemon; a successful descriptor is owned below.
+        libc::open(
+            b"/\0".as_ptr().cast(),
+            libc::O_RDONLY | libc::O_DIRECTORY | libc::O_CLOEXEC | libc::O_NOFOLLOW,
+        )
+    };
+    if root_fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut parent = unsafe {
+        // SAFETY: root_fd was returned by open above and is transferred to
+        // OwnedFd exactly once.
+        OwnedFd::from_raw_fd(root_fd)
+    };
+    let mut components = path.components().peekable();
+    while let Some(component) = components.next() {
+        let std::path::Component::Normal(name) = component else {
+            if matches!(component, std::path::Component::RootDir) {
+                continue;
+            }
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "spool directory path contains a non-canonical component",
+            ));
+        };
+        let child_name = CString::new(name.as_bytes())
+            .map_err(|_| io::Error::new(io::ErrorKind::InvalidInput, "spool directory component contains NUL"))?;
+        let mut created = false;
+        let child = loop {
+            let child_fd = unsafe {
+                // SAFETY: parent is a live directory descriptor and
+                // child_name is a NUL-terminated path component.
+                libc::openat(
+                    parent.as_raw_fd(),
+                    child_name.as_ptr(),
+                    libc::O_RDONLY | libc::O_DIRECTORY | libc::O_CLOEXEC | libc::O_NOFOLLOW,
+                )
+            };
+            if child_fd >= 0 {
+                break unsafe {
+                    // SAFETY: child_fd was returned by openat and is moved
+                    // into OwnedFd exactly once.
+                    OwnedFd::from_raw_fd(child_fd)
+                };
+            }
+            let error = io::Error::last_os_error();
+            if error.kind() != io::ErrorKind::NotFound {
+                return Err(error);
+            }
+            let result = unsafe {
+                // SAFETY: parent and child_name identify the requested child.
+                libc::mkdirat(parent.as_raw_fd(), child_name.as_ptr(), mode as libc::mode_t)
+            };
+            if result == 0 {
+                created = true;
+                continue;
+            }
+            let mkdir_error = io::Error::last_os_error();
+            if mkdir_error.kind() == io::ErrorKind::AlreadyExists {
+                // A concurrent creator won the race. Retry openat; if it
+                // installed a symlink, O_NOFOLLOW rejects it.
+                continue;
+            }
+            return Err(mkdir_error);
+        };
+
+        // Repair modes only on directories owned by this subsystem. Existing
+        // ancestors such as `/var` and `/tmp` are never rewritten.  The final
+        // component (and any component created by this call) must also remain
+        // owned by the daemon's effective UID/GID.  Checking the open
+        // descriptor avoids accepting a root-owned or group-swapped spool
+        // directory when the daemon itself happens to run as root.
+        if created || components.peek().is_none() {
+            let result = unsafe {
+                // SAFETY: child is an open directory descriptor obtained with
+                // O_NOFOLLOW, so fchmod cannot follow a replacement pathname.
+                libc::fchmod(child.as_raw_fd(), mode as libc::mode_t)
+            };
+            if result != 0 {
+                return Err(io::Error::last_os_error());
+            }
+            validate_private_dir_fd(child.as_raw_fd())?;
+        }
+        parent = child;
+    }
+    Ok(())
+}
+
+fn validate_private_dir_fd(fd: i32) -> io::Result<()> {
+    let mut stat = std::mem::MaybeUninit::<libc::stat>::zeroed();
+    // SAFETY: `fd` is an open directory descriptor owned by this function's
+    // caller and `stat` points to writable storage of the expected type.
+    let result = unsafe { libc::fstat(fd, stat.as_mut_ptr()) };
+    if result != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: fstat initialized `stat` on success.
+    let stat = unsafe { stat.assume_init() };
+    let mode = stat.st_mode as libc::mode_t;
+    if mode & libc::S_IFMT as libc::mode_t != libc::S_IFDIR as libc::mode_t {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "spool component is not a directory",
+        ));
+    }
+    // SAFETY: geteuid/getegid have no preconditions and do not mutate memory.
+    let euid = unsafe { libc::geteuid() };
+    let egid = unsafe { libc::getegid() };
+    if stat.st_uid != euid || stat.st_gid != egid {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "spool directory has an unexpected owner or group",
+        ));
+    }
+    Ok(())
+}
+
+fn validate_private_file_fd(fd: i32) -> io::Result<()> {
+    let mut stat = std::mem::MaybeUninit::<libc::stat>::zeroed();
+    // SAFETY: `fd` is an open regular-file descriptor owned by this function's
+    // caller and `stat` points to writable storage of the expected type.
+    let result = unsafe { libc::fstat(fd, stat.as_mut_ptr()) };
+    if result != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: fstat initialized `stat` on success.
+    let stat = unsafe { stat.assume_init() };
+    let mode = stat.st_mode as libc::mode_t;
+    if mode & libc::S_IFMT as libc::mode_t != libc::S_IFREG as libc::mode_t {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "spool object is not a regular file",
+        ));
+    }
+    // SAFETY: geteuid/getegid have no preconditions and do not mutate memory.
+    let euid = unsafe { libc::geteuid() };
+    let egid = unsafe { libc::getegid() };
+    if stat.st_uid != euid || stat.st_gid != egid {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "spool file has an unexpected owner or group",
+        ));
+    }
+    Ok(())
+}
+
+fn set_file_mode(path: &Path, mode: u32) -> io::Result<()> {
+    fs::set_permissions(path, fs::Permissions::from_mode(mode))
+}
+
+#[derive(Debug)]
+enum AtomicWriteError {
+    BeforeRename(SpoolError),
+    AfterRename(SpoolError),
+}
+
+impl AtomicWriteError {
+    fn into_spool_error(self) -> SpoolError {
+        match self {
+            Self::BeforeRename(error) | Self::AfterRename(error) => error,
+        }
+    }
+}
+
+fn write_atomic_file(path: &Path, bytes: &[u8], mode: u32) -> Result<(), SpoolError> {
+    write_atomic_file_staged(path, bytes, mode).map_err(AtomicWriteError::into_spool_error)
+}
+
+fn write_atomic_file_staged(path: &Path, bytes: &[u8], mode: u32) -> Result<(), AtomicWriteError> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| AtomicWriteError::BeforeRename(SpoolError::InvalidState("file has no parent".to_owned())))?;
+    let name = path
+        .file_name()
+        .and_then(|value| value.to_str())
+        .ok_or_else(|| AtomicWriteError::BeforeRename(SpoolError::InvalidState("invalid file name".to_owned())))?;
+    let temp = parent.join(format!(".{name}.tmp-{}-{}", std::process::id(), unix_nanos()));
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+        .mode(mode)
+        .open(&temp)
+        .map_err(|error| AtomicWriteError::BeforeRename(error.into()))?;
+    if let Err(error) = file.write_all(bytes).and_then(|_| file.sync_all()) {
+        let _ = fs::remove_file(&temp);
+        return Err(AtomicWriteError::BeforeRename(error.into()));
+    }
+    drop(file);
+    if let Err(error) = fs::rename(&temp, path) {
+        let _ = fs::remove_file(&temp);
+        return Err(AtomicWriteError::BeforeRename(error.into()));
+    }
+    // The renamed inode was created with the requested private mode.  Do not
+    // chmod the destination by pathname here: a privileged actor replacing
+    // the path between rename and chmod could make that operation follow a
+    // symlink outside the spool tree.
+    sync_dir(parent).map_err(|error| AtomicWriteError::AfterRename(error.into()))
+}
+
+fn read_regular_file(path: &Path) -> io::Result<Vec<u8>> {
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+        .open(path)?;
+    let metadata = file.metadata()?;
+    if !metadata.is_file() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "spool object must be a regular file",
+        ));
+    }
+    // All spool files are sensitive plaintext.  Repair only the mode on the
+    // descriptor we opened, then reject an inode owned by another UID/GID.
+    file.set_permissions(fs::Permissions::from_mode(0o600))?;
+    validate_private_file_fd(file.as_raw_fd())?;
+    if metadata.len() > MAX_SPOOL_FILE_BYTES as u64 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "spool object exceeds the recovery read limit",
+        ));
+    }
+    // The metadata length is only a hint: a concurrent writer/replacement can
+    // grow the file after the stat.  Read one sentinel byte beyond the hard
+    // limit so the actual allocation and acceptance remain bounded.
+    let sentinel_limit = (MAX_SPOOL_FILE_BYTES as u64).saturating_add(1);
+    let capacity = usize::try_from(metadata.len())
+        .unwrap_or(MAX_SPOOL_FILE_BYTES)
+        .min(MAX_SPOOL_FILE_BYTES.saturating_add(1));
+    let mut bytes = Vec::with_capacity(capacity);
+    file.take(sentinel_limit).read_to_end(&mut bytes)?;
+    if bytes.len() > MAX_SPOOL_FILE_BYTES {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "spool object exceeds the recovery read limit",
+        ));
+    }
+    Ok(bytes)
+}
+
+fn quarantine_path(root: &Path, path: &Path, label: &str) -> Result<PathBuf, SpoolError> {
+    match fs::symlink_metadata(path) {
+        Ok(_) => {}
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {
+            return Ok(root.join("quarantine").join("missing"));
+        }
+        Err(error) => return Err(error.into()),
+    }
+    let original = path
+        .file_name()
+        .and_then(|value| value.to_str())
+        .ok_or_else(|| SpoolError::InvalidState("invalid path basename".to_owned()))?;
+    let target = root
+        .join("quarantine")
+        .join(format!("{label}-{}-{original}", unix_nanos()));
+    fs::rename(path, &target)?;
+    if let Some(parent) = path.parent() {
+        sync_dir(parent)?;
+    }
+    sync_dir(&root.join("quarantine"))?;
+    Ok(target)
+}
+
+fn sync_dir(path: &Path) -> io::Result<()> {
+    File::open(path)?.sync_all()
+}
+
+pub(crate) struct SpoolLock {
+    path: PathBuf,
+    device: u64,
+    inode: u64,
+    file: File,
+}
+
+impl SpoolLock {
+    fn verify(&self) -> io::Result<()> {
+        let opened = self.file.metadata()?;
+        let current = fs::symlink_metadata(&self.path)?;
+        if !opened.is_file()
+            || !current.is_file()
+            || opened.dev() != self.device
+            || opened.ino() != self.inode
+            || current.dev() != self.device
+            || current.ino() != self.inode
+        {
+            return Err(io::Error::new(
+                io::ErrorKind::AlreadyExists,
+                "spool lock path no longer names the locked inode",
+            ));
+        }
+        Ok(())
+    }
+}
+
+fn acquire_spool_lock(root: &Path) -> io::Result<SpoolLock> {
+    let path = root.join(".lock");
+    let root_metadata = fs::symlink_metadata(root)?;
+    let file = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+        .mode(0o600)
+        .open(&path)?;
+    let metadata = file.metadata()?;
+    if !metadata.is_file() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "spool lock path is not a regular file",
+        ));
+    }
+    if metadata.uid() != root_metadata.uid() || metadata.gid() != root_metadata.gid() {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "spool lock has an unexpected owner",
+        ));
+    }
+    let result = unsafe { libc::fchmod(file.as_raw_fd(), 0o600) };
+    if result != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let result = unsafe { libc::flock(file.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) };
+    if result != 0 {
+        let error = io::Error::last_os_error();
+        if error.kind() == io::ErrorKind::WouldBlock
+            || error.raw_os_error() == Some(libc::EAGAIN)
+            || error.raw_os_error() == Some(libc::EWOULDBLOCK)
+        {
+            return Err(io::Error::new(
+                io::ErrorKind::AddrInUse,
+                "spool is locked by another process",
+            ));
+        }
+        return Err(error);
+    }
+    // Refuse a pathname replacement between open and lock acquisition. The
+    // descriptor remains authoritative for the advisory lock itself.
+    let opened = file.metadata()?;
+    let current = fs::symlink_metadata(&path)?;
+    if !current.is_file() || current.dev() != opened.dev() || current.ino() != opened.ino() {
+        return Err(io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            "spool lock path changed while acquiring lock",
+        ));
+    }
+    Ok(SpoolLock {
+        path,
+        device: opened.dev(),
+        inode: opened.ino(),
+        file,
+    })
+}
+
+fn cleanup_root_temps(root: &Path) -> io::Result<()> {
+    let mut removed = false;
+    for entry in fs::read_dir(root)? {
+        let entry = entry?;
+        let name = entry.file_name();
+        let name = name.to_string_lossy();
+        // `write_atomic_file` prefixes the temporary name with a dot.  Marker
+        // destinations already begin with a dot, so their generated names
+        // have two leading dots (for example
+        // `..recovery-gap-<id>.json.tmp-...`).  Accept both forms to clean up
+        // files left by older writers as well as the current writer; never
+        // match a live marker, which does not contain `.tmp-`.
+        if !(name.starts_with(".state.json.tmp-")
+            || name.starts_with(".tombstones.json.tmp-")
+            || (name.starts_with(".tombstone-pending-") && name.contains(".json.tmp-"))
+            || (name.starts_with("..tombstone-pending-") && name.contains(".json.tmp-"))
+            || (name.starts_with(RECOVERY_GAP_MARKER_PREFIX) && name.contains(".json.tmp-"))
+            || (name.starts_with("..recovery-gap-") && name.contains(".json.tmp-")))
+        {
+            continue;
+        }
+        remove_path(&entry.path())?;
+        removed = true;
+    }
+    if removed {
+        sync_dir(root)?;
+    }
+    Ok(())
+}
+
+/// Remove only abandoned atomic-write files after recovery has had a chance to
+/// inspect interrupted seal directories.  A temp file is never an exported
+/// record and retaining an unbounded collection of such files would consume
+/// the same capacity budget as real data without appearing in any cleanup
+/// candidate list.  Directory entries whose name denotes an interrupted seal
+/// are left alone when they contain `segment.ndjson`; those bytes still need a
+/// corruption gap or promotion decision on the next recovery pass.
+fn cleanup_recovered_temp_files(root: &Path) -> io::Result<u64> {
+    let mut removed_bytes = 0_u64;
+    let mut changed = false;
+    let sealed_root = root.join("sealed");
+    let directories = [
+        root.to_path_buf(),
+        root.join("open"),
+        sealed_root.clone(),
+        root.join("acked"),
+        root.join("quarantine"),
+    ];
+    for directory in &directories {
+        let entries = match fs::read_dir(&directory) {
+            Ok(value) => value,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => continue,
+            Err(error) => return Err(error),
+        };
+        for entry in entries {
+            let entry = entry?;
+            let name = entry.file_name();
+            let name = name.to_string_lossy();
+            let entry_path = entry.path();
+            let metadata = fs::symlink_metadata(&entry_path)?;
+            if metadata.file_type().is_symlink() {
+                continue;
+            }
+            if metadata.is_dir() {
+                // `seal_locked` uses `.tmp-<batch-id>` as its only hidden
+                // directory name.  Once recovery has inspected the directory,
+                // an empty/metadata-only orphan cannot contain an event and
+                // is safe to remove.  Keep any directory that still has a
+                // segment entry: it remains recovery input if a prior
+                // quarantine/promotion barrier was interrupted.
+                if directory == &sealed_root && name.starts_with(".tmp-") {
+                    let segment = entry_path.join("segment.ndjson");
+                    match fs::symlink_metadata(&segment) {
+                        Ok(_) => {}
+                        Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                            let bytes = directory_size(&entry_path)?;
+                            remove_path(&entry_path)?;
+                            removed_bytes = removed_bytes.saturating_add(bytes);
+                            changed = true;
+                        }
+                        Err(error) => {
+                            // Do not interpret an unreadable child as an
+                            // empty interrupted seal.  Returning the error
+                            // leaves all bytes untouched for recovery/retry.
+                            return Err(error);
+                        }
+                    }
+                }
+                continue;
+            }
+            let is_atomic_temp = name.contains(".tmp-") && (name.starts_with('.') || name.starts_with(".."));
+            if !is_atomic_temp || !metadata.is_file() {
+                continue;
+            }
+            let bytes = metadata.len();
+            fs::remove_file(entry_path)?;
+            removed_bytes = removed_bytes.saturating_add(bytes);
+            changed = true;
+        }
+    }
+    if changed {
+        for directory in &directories {
+            match sync_dir(directory) {
+                Ok(()) => {}
+                Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+                Err(error) => return Err(error),
+            }
+        }
+    }
+    Ok(removed_bytes)
+}
+
+fn rollback_open_record(root: &Path, file: &mut File, old_len: u64) -> io::Result<()> {
+    file.set_len(old_len)?;
+    file.sync_data()?;
+    sync_dir(&root.join("open"))
+}
+
+fn directory_size_status(path: &Path) -> io::Result<(u64, bool)> {
+    let metadata = fs::symlink_metadata(path)?;
+    // `symlink_metadata` deliberately does not follow links.  A link (or any
+    // device/FIFO/socket) has no trustworthy recursive byte size for the
+    // spool capacity contract.  Returning zero here would let a destructive
+    // cleanup proceed while under-counting bytes that remain in the tree.
+    if metadata.file_type().is_file() {
+        return Ok((metadata.len(), false));
+    }
+    if !metadata.file_type().is_dir() {
+        return Ok((0, true));
+    }
+    let mut total = 0_u64;
+    let mut skipped_objects = false;
+    for entry in fs::read_dir(path)? {
+        let (bytes, skipped) = directory_size_status(&entry?.path())?;
+        total = total.saturating_add(bytes);
+        skipped_objects |= skipped;
+    }
+    Ok((total, skipped_objects))
+}
+
+fn directory_size(path: &Path) -> io::Result<u64> {
+    directory_size_status(path).map(|(bytes, _)| bytes)
+}
+
+fn free_space_ok(path: &Path, minimum: u64) -> bool {
+    let text = match path.to_str() {
+        Some(value) => std::ffi::CString::new(value).ok(),
+        None => None,
+    };
+    let Some(text) = text else { return false };
+    let mut stat = std::mem::MaybeUninit::<libc::statvfs>::uninit();
+    // SAFETY: the C string is NUL terminated and `stat` points to writable
+    // storage owned by this stack frame.
+    let result = unsafe { libc::statvfs(text.as_ptr(), stat.as_mut_ptr()) };
+    if result != 0 {
+        return false;
+    }
+    // SAFETY: statvfs initialized on a successful call.
+    let stat = unsafe { stat.assume_init() };
+    (stat.f_bavail as u128).saturating_mul(stat.f_frsize as u128) >= minimum as u128
+}
+
+fn acked_timestamp(path: &Path) -> Option<u64> {
+    path.file_name()
+        .and_then(|value| value.to_str())
+        .and_then(|value| value.split_once('-').map(|(prefix, _)| prefix))
+        .and_then(|value| value.parse::<u64>().ok())
+}
+
+fn path_age_key(path: &Path) -> u128 {
+    // Never follow a quarantine symlink while ordering destructive candidates.
+    // Its target may be outside the spool, and its timestamp is not a
+    // trustworthy age for capacity policy anyway.
+    fs::symlink_metadata(path)
+        .and_then(|metadata| metadata.modified())
+        .ok()
+        .and_then(|time| time.duration_since(UNIX_EPOCH).ok())
+        .map(|duration| duration.as_nanos())
+        .unwrap_or(u128::MAX)
+}
+
+fn random_hex_id() -> Result<String, SpoolError> {
+    let mut bytes = [0_u8; 16];
+    let mut source = File::open("/dev/urandom")?;
+    source.read_exact(&mut bytes)?;
+    Ok(hex::encode(bytes))
+}
+
+fn digest_hex(bytes: &[u8]) -> String {
+    hex::encode(Sha256::digest(bytes))
+}
+
+fn unix_millis() -> Result<u64, SpoolError> {
+    let duration = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_err(|_| SpoolError::StorageUnavailable)?;
+    duration
+        .as_millis()
+        .try_into()
+        .map_err(|_| SpoolError::StorageUnavailable)
+}
+
+fn unix_nanos() -> u128 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|value| value.as_nanos())
+        .unwrap_or(0)
+}
+
+fn unix_seconds() -> Result<u64, SpoolError> {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|value| value.as_secs())
+        .map_err(|_| SpoolError::StorageUnavailable)
+}
+
+fn file_len(path: &Path) -> io::Result<u64> {
+    match fs::symlink_metadata(path) {
+        Ok(metadata) if metadata.is_file() => Ok(metadata.len()),
+        Ok(_) => Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "spool accounting path is not a regular file",
+        )),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(0),
+        Err(error) => Err(error),
+    }
+}
+
+fn saturating_inc(value: u64) -> u64 {
+    value.saturating_add(1)
+}
+
+fn mark_storage_rejection(inner: &mut SpoolInner, non_gap: bool) {
+    inner.storage_rejected_attempts = saturating_inc(inner.storage_rejected_attempts);
+    inner.degraded = true;
+    if non_gap {
+        inner.non_gap_degraded = true;
+    }
+}
+
+fn is_hex(value: &str, length: usize) -> bool {
+    value.len() == length
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+}
+
+// Event IDs are node-wide, not epoch-scoped. Keep the historical helper name
+// because callers also pass the current epoch when constructing a gap, but
+// scan all surviving epochs so a fixed pending gap ID is never duplicated
+// after a state reset.
+fn event_id_exists_in_epoch(root: &Path, event_id: &str, _epoch: &str) -> Result<bool, SpoolError> {
+    let scan = |bytes: &[u8]| -> bool {
+        for line in bytes.split_inclusive(|byte| *byte == b'\n') {
+            if let Ok(record) = wire::parse_spool_line(line)
+                && parse_stored_event(record.event_bytes())
+                    .ok()
+                    .is_some_and(|event| event.event_id() == event_id)
+            {
+                return true;
+            }
+        }
+        false
+    };
+    let open = root.join("open/current.ndjson");
+    match read_regular_file(&open) {
+        Ok(bytes) => {
+            if scan(&bytes) {
+                return Ok(true);
+            }
+        }
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+        Err(error) => return Err(error.into()),
+    }
+    for parent_name in ["sealed", "acked"] {
+        for path in list_batch_dirs(&root.join(parent_name))? {
+            let metadata = match fs::symlink_metadata(&path) {
+                Ok(value) => value,
+                Err(error) if error.kind() == io::ErrorKind::NotFound => continue,
+                Err(error) => return Err(error.into()),
+            };
+            if metadata.file_type().is_symlink() {
+                continue;
+            }
+            match read_regular_file(&path.join("segment.ndjson")) {
+                Ok(body) => {
+                    if scan(&body) {
+                        return Ok(true);
+                    }
+                }
+                Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+                Err(error) => return Err(error.into()),
+            }
+        }
+    }
+    Ok(false)
+}
+
+fn lock<'a, T>(mutex: &'a Mutex<T>) -> MutexGuard<'a, T> {
+    match mutex.lock() {
+        Ok(guard) => guard,
+        Err(poisoned) => poisoned.into_inner(),
+    }
+}
