+/// The common fields retained for an ACK or eviction receipt.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct TombstoneReceiptFields {
+    pub batch_id: String,
+    pub body_sha256: String,
+    pub recorded_at_unix_ms: DecimalU64,
+}
+
+impl TombstoneReceiptFields {
+    fn validate(&self) -> Result<(), ProtocolError> {
+        validate_lower_hex(&self.batch_id, 16, "batch_id")?;
+        validate_lower_hex(&self.body_sha256, 32, "body_sha256")?;
+        Ok(())
+    }
+}
