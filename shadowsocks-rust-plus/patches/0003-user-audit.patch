+                        "server shutdown failed with {err}"
+                    ))),
+                    Err(_) => Err(ShadowsocksError::ServerAborted(format!(
+                        "server shutdown timed out after {:?} (audit drain completed: {drain_completed})",
+                        shutdown_started.elapsed()
+                    ))),
+                }
+            }
         }
     };
 
