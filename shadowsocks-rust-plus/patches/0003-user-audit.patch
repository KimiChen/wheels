+pub struct LeaseMetadata {
+    pub batch_id: String,
+    pub spool_epoch: String,
+    pub first_sequence: DecimalU64,
+    pub last_sequence: DecimalU64,
+    pub event_count: DecimalU64,
+    pub body_sha256: String,
+}
+
+impl LeaseMetadata {
+    pub fn validate(&self) -> Result<(), ProtocolError> {
+        validate_lower_hex(&self.batch_id, 16, "batch_id")?;
+        validate_lower_hex(&self.spool_epoch, 16, "spool_epoch")?;
+        validate_lower_hex(&self.body_sha256, 32, "body_sha256")?;
+        if self.first_sequence.0 == 0 || self.last_sequence.0 < self.first_sequence.0 {
+            return Err(invalid("sequence", "must satisfy 0 < first <= last"));
+        }
+        if self.event_count.0 == 0 {
+            return Err(invalid("event_count", "must be positive"));
+        }
+        let expected_count = self
+            .last_sequence
+            .0
+            .checked_sub(self.first_sequence.0)
+            .and_then(|value| value.checked_add(1))
+            .ok_or_else(|| invalid("event_count", "sequence range is too large"))?;
+        if self.event_count.0 != expected_count {
+            return Err(invalid("event_count", "must equal last_sequence - first_sequence + 1"));
+        }
+        Ok(())
+    }
+}
