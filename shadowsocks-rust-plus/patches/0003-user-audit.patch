+        // Exactly one cooldown after the eligible attempt the next access event
+        // is due.  A sliding window would push it out by another 59 seconds.
+        let due = start + UDP_COOLDOWN;
+        assert!(
+            cache
+                .eligible_lazy(&server_id, association, host, 53, due, build)
+                .expect("cache available")
+                .is_some()
+        );
