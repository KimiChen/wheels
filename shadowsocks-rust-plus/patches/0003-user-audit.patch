+    #[test]
+    fn recovery_gap_marker_rejects_unknown_and_unsupported_schemas() {
+        let vectors = golden_vectors();
+        let canonical = vectors["recovery_gap_markers"]["legacy_schema_1"]["canonical"]
+            .as_str()
+            .unwrap()
+            .to_owned();
+        // Unknown members and non-canonical member order are both refused.
+        let extended = canonical.replace(
+            "\"marker_schema_version\":1",
+            "\"marker_schema_version\":1,\"unexpected\":true",
+        );
+        assert!(parse_canonical::<RecoveryGapMarker>(extended.as_bytes()).is_err());
+        // A schema 1 marker predates the fingerprint field.
+        let fingerprinted = canonical.replace(
+            "\"lost_batch_id\":null",
+            "\"lost_batch_id\":null,\"source_fingerprint\":\"orphan-open:00\"",
+        );
+        let marker = parse_canonical::<RecoveryGapMarker>(fingerprinted.as_bytes()).expect("canonical bytes");
+        assert!(!marker.schema_is_supported());
+        let mut future = parse_canonical::<RecoveryGapMarker>(canonical.as_bytes()).expect("legacy marker");
+        future.marker_schema_version = RECOVERY_GAP_MARKER_SCHEMA + 1;
+        assert!(!future.schema_is_supported());
+    }
