+        {
+            let mut inner = lock(&spool.inner);
+            spool
+                .add_tombstone_locked(&mut inner, TombstoneEntry::EvictionPending(pending))
+                .expect("pending eviction");
+            spool.reconcile_tombstones_locked(&mut inner).expect("reconcile");
+        }
