+            let record = parse_canonical_record(&event_bytes).expect("access event");
+            let nack = EventNack::new(record.event_id(), EventNackCode::StorageUnavailable);
+            let nack = serialize_canonical(&nack).expect("nack");
+            write_frame(&mut writer, &nack).await.expect("write nack");
