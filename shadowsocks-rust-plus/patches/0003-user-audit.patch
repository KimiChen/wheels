+
+/// Process-wide guard for a path-bound Unix socket.  The lock file is kept
+/// separate from the socket inode so it survives a stale-socket cleanup and
+/// can be held for the entire listener lifetime.
+#[derive(Debug)]
+pub(crate) struct SocketLock {
+    path: PathBuf,
+    device: u64,
+    inode: u64,
+    _file: File,
+}
+
+impl SocketLock {
+    pub(crate) fn acquire(socket_path: &Path) -> io::Result<Self> {
+        let lock_path = socket_lock_path(socket_path);
+        let file = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .mode(0o600)
+            .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+            .open(&lock_path)?;
+        let metadata = file.metadata()?;
+        if !metadata.is_file() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "socket lock path is not a regular file",
+            ));
+        }
+        if metadata.uid() != current_euid() {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "socket lock has an unexpected owner",
+            ));
+        }
+        // fchmod operates on the opened inode and cannot follow a pathname
+        // replacement.  This also repairs the mode when a lock file survived
+        // a previous daemon version.
+        let result = unsafe { libc::fchmod(file.as_raw_fd(), 0o600) };
+        if result != 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let result = unsafe { libc::flock(file.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) };
+        if result != 0 {
+            let error = io::Error::last_os_error();
+            if error.kind() == io::ErrorKind::WouldBlock
+                || error.raw_os_error() == Some(libc::EAGAIN)
+                || error.raw_os_error() == Some(libc::EWOULDBLOCK)
+            {
+                return Err(io::Error::new(
+                    io::ErrorKind::AddrInUse,
+                    "socket is locked by another process",
+                ));
+            }
+            return Err(error);
+        }
+        verify_open_file_path(&file, &lock_path, "socket lock")?;
+        let metadata = file.metadata()?;
+        validate_lock_metadata(&metadata)?;
+        Ok(Self {
+            path: lock_path,
+            device: metadata.dev(),
+            inode: metadata.ino(),
+            _file: file,
+        })
+    }
+
+    /// Verify that the pathname still resolves to the inode on which this
+    /// process acquired the advisory lock.  A lock file can be replaced by a
+    /// privileged actor after acquisition; treating that as a fatal listener
+    /// error prevents the daemon from continuing while another process owns a
+    /// different replacement inode.
+    pub(crate) fn verify(&self) -> io::Result<()> {
+        let current = fs::symlink_metadata(&self.path)?;
+        validate_lock_metadata(&current)?;
+        if current.dev() != self.device || current.ino() != self.inode {
+            return Err(io::Error::new(
+                io::ErrorKind::AlreadyExists,
+                "socket lock path changed after acquisition",
+            ));
+        }
+        // Keep the check descriptor-bound as well.  This catches an inode
+        // replacement that happened between the pathname check and this call.
+        verify_open_file_path(&self._file, &self.path, "socket lock")
+    }
+}
+
+fn validate_lock_metadata(metadata: &fs::Metadata) -> io::Result<()> {
+    if !metadata.is_file() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "socket lock path is not a regular file",
+        ));
+    }
+    if metadata.uid() != current_euid() || metadata.permissions().mode() & 0o7777 != 0o600 {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "socket lock has unexpected owner or mode",
+        ));
+    }
+    Ok(())
+}
+
+fn socket_lock_path(socket_path: &Path) -> PathBuf {
+    let mut value = socket_path.as_os_str().to_os_string();
+    value.push(".lock");
+    PathBuf::from(value)
+}
+
+fn sync_dir(path: &Path) -> io::Result<()> {
+    File::open(path)?.sync_all()
+}
+
+fn verify_open_file_path(file: &File, path: &Path, description: &str) -> io::Result<()> {
+    let opened = file.metadata()?;
+    let current = fs::symlink_metadata(path)?;
+    if !current.is_file() || current.dev() != opened.dev() || current.ino() != opened.ino() {
+        return Err(io::Error::new(
+            io::ErrorKind::AlreadyExists,
+            format!("{description} path changed while acquiring its lock"),
+        ));
+    }
+    Ok(())
+}
