+/// Validate an audit ingest socket path while allowing its not-yet-created
+/// parent tail. The audit daemon normally creates runtime socket directories
+/// through systemd/tmpfiles, but a valid producer configuration must also be
+/// able to start while that daemon is temporarily absent. Existing ancestors
+/// are checked with the same trust rules as the statistics socket helper; the
+/// producer additionally authenticates the final socket inode and peer UID at
+/// every connection attempt.
+#[cfg(all(feature = "user-audit", target_os = "linux"))]
+pub(crate) fn canonical_user_audit_socket_path(path: &Path, allow_root_pre_drop_owner: bool) -> io::Result<PathBuf> {
+    use std::{
+        fs,
+        os::unix::{
+            ffi::OsStrExt,
+            fs::{MetadataExt, PermissionsExt},
+        },
+        path::Component,
+    };
+
+    let text = path
+        .to_str()
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "audit socket path must be valid UTF-8"))?;
+    if !text.starts_with('/')
+        || text.len() <= 1
+        || text.ends_with('/')
+        || text.contains("//")
+        || path.as_os_str().as_bytes().contains(&0)
+        || path.file_name().is_none()
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "audit socket path must be an absolute canonical path with a file name",
+        ));
+    }
+
+    let Some(parent) = path.parent() else {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "audit socket path has no parent",
+        ));
+    };
+    let mut current = PathBuf::from("/");
+    // SAFETY: geteuid has no preconditions and does not mutate process state.
+    let effective_uid = unsafe { libc::geteuid() };
+    let relax_owner = allow_root_pre_drop_owner && effective_uid == 0;
+    let mut missing_tail = false;
+
+    for component in parent.components() {
+        match component {
+            Component::RootDir => continue,
+            Component::Normal(name) => current.push(name),
+            _ => {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidInput,
+                    "audit socket path must use canonical components",
+                ));
+            }
+        }
+        if missing_tail {
+            continue;
+        }
+
+        let metadata = match fs::symlink_metadata(&current) {
+            Ok(metadata) => metadata,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                missing_tail = true;
+                continue;
+            }
+            Err(error) => return Err(error),
+        };
+        if metadata.file_type().is_symlink() || !metadata.is_dir() {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "audit socket path ancestors must be real directories, not symbolic links",
+            ));
+        }
+
+        let owner = metadata.uid();
+        if !relax_owner && owner != 0 && owner != effective_uid {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "audit socket path ancestors must be owned by root or the effective user",
+            ));
+        }
+        let mode = metadata.permissions().mode();
+        let root_owned_sticky_ancestor = current != parent && owner == 0 && mode & 0o1000 != 0;
+        if mode & 0o022 != 0 && !root_owned_sticky_ancestor {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "audit socket path ancestors must not be writable by group or other",
+            ));
+        }
+    }
+
+    if !missing_tail {
+        let canonical_parent = fs::canonicalize(parent)?;
+        if canonical_parent != parent {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "audit socket path must not contain symbolic-link ancestors",
+            ));
+        }
+        let Some(file_name) = path.file_name() else {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "audit socket path must include a file name",
+            ));
+        };
+        return Ok(canonical_parent.join(file_name));
+    }
+
+    // No canonicalize() is possible while the parent tail is absent. The
+    // lexical form has already been checked for dot/empty components; runtime
+    // connect checks the final inode and SO_PEERCRED before any frame is sent.
+    Ok(path.to_owned())
 }
 
