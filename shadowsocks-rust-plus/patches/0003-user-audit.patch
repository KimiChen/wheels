+    pub recorded_at_unix_ms: DecimalU64,
+}
+
+impl TombstoneReceiptFields {
+    fn validate(&self) -> Result<(), ProtocolError> {
+        validate_lower_hex(&self.batch_id, 16, "batch_id")?;
+        validate_lower_hex(&self.body_sha256, 32, "body_sha256")?;
