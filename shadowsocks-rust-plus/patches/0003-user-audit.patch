index 0000000000000000000000000000000000000000..4a4ba0194459f0c5876e9b00dc1380249ba5eae9
--- /dev/null
+++ b/crates/shadowsocks-audit-protocol/Cargo.toml
@@ -0,0 +1,17 @@
+[package]
+name = "shadowsocks-audit-protocol"
+version = "1.24.0"
+edition = "2024"
+rust-version = "1.88"
+license = "MIT"
+description = "Strict wire types and canonicalization for shadowsocks-rust-plus access audit"
+
+[dependencies]
+hex = "0.4"
+hmac = "0.12"
+idna = "1.0"
+serde = { version = "1.0", features = ["derive"] }
+serde_json = { version = "1.0", features = ["raw_value"] }
+sha2 = "0.10"
+subtle = "2.6"
+thiserror = "2.0"
