+}
+
+impl AuditdConfig {
+    pub fn load_from_file(path: &Path) -> Result<Self, ConfigError> {
+        validate_absolute_path(path, "config")?;
+        validate_existing_parent(path, "config")?;
+        validate_private_parent(path, "config")?;
+        // O_NOFOLLOW closes the final-component symlink gap left by validating
+        // the parent components. Ownership and mode are checked before parsing
+        // so CLI failures happen before any daemon socket or spool creation.
+        let mut file = open_nofollow(path)?;
+        validate_regular_file_metadata(
+            &file.metadata()?,
+            "config",
+            Some(0),
+            Some(current_egid()),
+            Some(CONFIG_FILE_MODE),
+        )
+        .map_err(ConfigError::InvalidPath)?;
+        if file.metadata()?.len() > MAX_CONFIG_FILE_BYTES {
+            return Err(ConfigError::Invalid("config file is too large".to_owned()));
+        }
+        // The size check above is only a snapshot.  Bound the actual read as
+        // well so a concurrent replacement/growth cannot turn config loading
+        // into an unbounded allocation.
+        let bytes = read_bounded(&mut file, MAX_CONFIG_FILE_BYTES as usize)?;
+        if std::str::from_utf8(&bytes).is_err() {
+            return Err(ConfigError::Invalid("config file must be UTF-8".to_owned()));
+        }
+        let config: Self = wire::parse_json_exact(&bytes)
+            .map_err(|error| ConfigError::Invalid(format!("config JSON is invalid: {error}")))?;
+        config.validate()?;
+        Ok(config)
+    }
+
+    /// Validate fields that do not require opening sockets or resolving users.
+    pub fn validate(&self) -> Result<(), ConfigError> {
+        if self.schema_version != 1 {
+            return Err(ConfigError::Invalid("schema_version must be 1".to_owned()));
+        }
+        validate_identifier(&self.node_id, "node_id")?;
+        if self.producer_user.is_empty() || self.export_peer_user.is_empty() {
+            return Err(ConfigError::Invalid("daemon user names must not be empty".to_owned()));
+        }
+        validate_identifier(&self.producer_user, "producer_user")?;
+        validate_identifier(&self.export_peer_user, "export_peer_user")?;
+        if self.producer_user == self.export_peer_user {
+            return Err(ConfigError::Invalid(
+                "producer_user and export_peer_user must differ".to_owned(),
+            ));
+        }
+        validate_absolute_path(&self.ingest_socket_path, "ingest_socket_path")?;
+        validate_absolute_path(&self.export_socket_path, "export_socket_path")?;
+        validate_absolute_path(&self.spool_dir, "spool_dir")?;
+        validate_absolute_path(&self.export_hmac_key_file, "export_hmac_key_file")?;
+        validate_socket_path_length(&self.ingest_socket_path, "ingest_socket_path")?;
+        validate_socket_path_length(&self.export_socket_path, "export_socket_path")?;
+        if self.ingest_socket_path == self.export_socket_path {
+            return Err(ConfigError::Invalid("ingest and export sockets must differ".to_owned()));
+        }
+        if self.spool_dir == self.ingest_socket_path
+            || self.spool_dir == self.export_socket_path
+            || self.spool_dir.starts_with(&self.ingest_socket_path)
+            || self.spool_dir.starts_with(&self.export_socket_path)
+            || self.ingest_socket_path.starts_with(&self.spool_dir)
+            || self.export_socket_path.starts_with(&self.spool_dir)
+        {
+            return Err(ConfigError::Invalid(
+                "spool_dir must not contain a socket path".to_owned(),
+            ));
+        }
+
+        bounded(
+            self.max_spool_bytes,
+            67_108_864,
+            DEFAULT_MAX_SPOOL_BYTES,
+            "max_spool_bytes",
+        )?;
+        bounded(
+            self.min_free_bytes,
+            268_435_456,
+            DEFAULT_MAX_SPOOL_BYTES,
+            "min_free_bytes",
+        )?;
+        bounded(
+            self.segment_max_bytes,
+            16_384,
+            DEFAULT_SEGMENT_MAX_BYTES,
+            "segment_max_bytes",
+        )?;
+        bounded(self.segment_max_age_seconds, 1, 3_600, "segment_max_age_seconds")?;
+        bounded(
+            self.group_commit_max_events,
+            1,
+            DEFAULT_GROUP_COMMIT_EVENTS,
+            "group_commit_max_events",
+        )?;
+        bounded(
+            self.group_commit_max_delay_ms,
+            1,
+            DEFAULT_GROUP_COMMIT_DELAY_MS,
+            "group_commit_max_delay_ms",
+        )?;
+        bounded(
+            self.export_max_response_bytes,
+            4_194_304,
+            DEFAULT_EXPORT_MAX_RESPONSE_BYTES,
+            "export_max_response_bytes",
+        )?;
+        if self.max_spool_bytes <= self.segment_max_bytes.saturating_mul(2) {
+            return Err(ConfigError::Invalid(
+                "max_spool_bytes must be greater than twice segment_max_bytes".to_owned(),
+            ));
+        }
+        if self.export_max_response_bytes < self.segment_max_bytes {
+            return Err(ConfigError::Invalid(
+                "export_max_response_bytes must be at least segment_max_bytes".to_owned(),
+            ));
+        }
+        let minimum_segment = wire::MAX_SPOOL_RECORD_BYTES
+            .checked_add(1)
+            .ok_or_else(|| ConfigError::Invalid("protocol spool record size overflow".to_owned()))?;
+        if usize::try_from(self.segment_max_bytes).unwrap_or(usize::MAX) < minimum_segment {
+            return Err(ConfigError::Invalid(format!(
+                "segment_max_bytes must be at least {minimum_segment} bytes"
+            )));
+        }
+        Ok(())
+    }
+
+    /// Perform checks that require the daemon's local filesystem and account database.
+    pub fn validate_runtime(&self) -> Result<(), ConfigError> {
+        self.validate()?;
+        validate_existing_parent(&self.ingest_socket_path, "ingest_socket_path")?;
+        validate_existing_parent(&self.export_socket_path, "export_socket_path")?;
+        validate_existing_parent(&self.export_hmac_key_file, "export_hmac_key_file")?;
+        validate_socket_parent_for(&self.ingest_socket_path, "ingest_socket_path", SocketRole::Ingest)?;
+        validate_socket_parent_for(&self.export_socket_path, "export_socket_path", SocketRole::Export)?;
+        validate_private_parent(&self.export_hmac_key_file, "export_hmac_key_file")?;
+        let producer_uid = resolve_uid(&self.producer_user)
+            .ok_or_else(|| ConfigError::Invalid(format!("unknown producer_user {:?}", self.producer_user)))?;
+        let export_uid = resolve_uid(&self.export_peer_user)
+            .ok_or_else(|| ConfigError::Invalid(format!("unknown export_peer_user {:?}", self.export_peer_user)))?;
+        if producer_uid == export_uid {
+            return Err(ConfigError::Invalid(
+                "producer_user and export_peer_user must resolve to different UIDs".to_owned(),
+            ));
+        }
+        let _ = self.read_hmac_key()?;
+        validate_or_create_dir(&self.spool_dir)?;
+        validate_existing_parent(&self.spool_dir.join("open/current.ndjson"), "spool_dir")?;
+        check_free_space(&self.spool_dir, self.min_free_bytes)?;
+        Ok(())
+    }
+
+    pub fn producer_uid(&self) -> Result<u32, ConfigError> {
+        resolve_uid(&self.producer_user)
+            .ok_or_else(|| ConfigError::Invalid(format!("unknown producer_user {:?}", self.producer_user)))
+    }
+
+    pub fn export_peer_uid(&self) -> Result<u32, ConfigError> {
+        resolve_uid(&self.export_peer_user)
+            .ok_or_else(|| ConfigError::Invalid(format!("unknown export_peer_user {:?}", self.export_peer_user)))
+    }
+
+    pub fn read_hmac_key(&self) -> Result<[u8; 32], ConfigError> {
+        let mut file = open_nofollow(&self.export_hmac_key_file)?;
+        validate_regular_file_metadata(
+            &file.metadata()?,
+            "export_hmac_key_file",
+            Some(current_euid()),
+            Some(current_egid()),
+            Some(HMAC_KEY_FILE_MODE),
+        )
+        .map_err(ConfigError::InvalidPath)?;
+        if file.metadata()?.len() > MAX_HMAC_KEY_FILE_BYTES {
+            return Err(ConfigError::Invalid("HMAC key file is too large".to_owned()));
+        }
+        let bytes = read_bounded(&mut file, MAX_HMAC_KEY_FILE_BYTES as usize)?;
+        decode_hmac_key(&bytes).map_err(ConfigError::Invalid)
+    }
+}
+
+fn bounded(value: u64, min: u64, max: u64, name: &str) -> Result<(), ConfigError> {
+    if value < min || value > max {
+        return Err(ConfigError::Invalid(format!("{name} must be between {min} and {max}")));
+    }
+    Ok(())
+}
+
+pub fn validate_identifier(value: &str, field: &str) -> Result<(), ConfigError> {
+    if value.is_empty() || value.len() > 128 {
+        return Err(ConfigError::Invalid(format!("{field} must be 1..=128 bytes")));
+    }
+    if value.bytes().any(|byte| !(0x21..=0x7e).contains(&byte)) {
+        return Err(ConfigError::Invalid(format!(
+            "{field} must contain printable non-whitespace ASCII"
+        )));
+    }
+    Ok(())
+}
+
+pub fn validate_absolute_path(path: &Path, field: &str) -> Result<(), ConfigError> {
+    let text = path
+        .to_str()
+        .ok_or_else(|| ConfigError::InvalidPath(format!("{field} must be valid UTF-8")))?;
+    if !text.starts_with('/') || text.len() <= 1 {
+        return Err(ConfigError::InvalidPath(format!("{field} must be an absolute path")));
+    }
+    if path.as_os_str().as_bytes().contains(&0) {
+        return Err(ConfigError::InvalidPath(format!("{field} must not contain NUL")));
+    }
+    // Path::components() intentionally collapses repeated separators, so inspect
+    // the wire spelling as well to reject empty components and trailing '/'.
+    if text.ends_with('/') || text.contains("//") {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} must not contain empty path components"
+        )));
+    }
+    for component in path.components() {
+        match component {
+            Component::RootDir | Component::Normal(_) => {}
+            Component::CurDir | Component::ParentDir | Component::Prefix(_) => {
+                return Err(ConfigError::InvalidPath(format!(
+                    "{field} must not contain '.' or '..' components"
+                )));
+            }
+        }
+    }
+    Ok(())
+}
+
+fn validate_socket_path_length(path: &Path, field: &str) -> Result<(), ConfigError> {
+    // Linux pathname Unix sockets reserve one byte for the terminating NUL in
+    // `sockaddr_un.sun_path` (108 bytes total).
+    if path.as_os_str().as_bytes().len() >= 108 {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} exceeds the Linux Unix-socket pathname limit"
+        )));
+    }
+    Ok(())
+}
+
+pub fn validate_existing_parent(path: &Path, field: &str) -> Result<(), ConfigError> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| ConfigError::InvalidPath(format!("{field} has no parent")))?;
+    let mut current = PathBuf::from("/");
+    for component in parent.components() {
+        if matches!(component, Component::RootDir) {
+            continue;
+        }
+        let Component::Normal(name) = component else {
+            return Err(ConfigError::InvalidPath(format!("{field} has an invalid parent")));
+        };
+        current.push(name);
+        let metadata = match fs::symlink_metadata(&current) {
+            Ok(metadata) => metadata,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => {
+                // Missing parents are created by the relevant subsystem. Existing
+                // ancestors have still been checked for symlink and mode safety.
+                continue;
+            }
+            Err(error) => return Err(ConfigError::Io(error)),
+        };
+        if metadata.file_type().is_symlink() || !metadata.is_dir() {
+            return Err(ConfigError::InvalidPath(format!(
+                "{field} parent contains a symlink or non-directory"
+            )));
+        }
+        let mode = metadata.permissions().mode();
+        if mode & 0o022 != 0 {
+            return Err(ConfigError::InvalidPath(format!(
+                "{field} parent is writable by group or other"
+            )));
+        }
+        let owner = metadata.uid();
+        let euid = current_euid();
+        if owner != 0 && owner != euid {
+            return Err(ConfigError::InvalidPath(format!(
+                "{field} parent has an unrelated owner"
+            )));
+        }
+    }
+    Ok(())
+}
+
+fn validate_or_create_dir(path: &Path) -> Result<(), ConfigError> {
+    // Validate ancestors before creating the final directory. create_dir_all
+    // would otherwise follow a symlink introduced below an unchecked missing
+    // component.
+    validate_existing_parent(path, "spool_dir")?;
+    let metadata = match fs::symlink_metadata(path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {
+            fs::create_dir(path)?;
+            fs::set_permissions(path, fs::Permissions::from_mode(PRIVATE_DIRECTORY_MODE))?;
+            fs::symlink_metadata(path)?
+        }
+        Err(error) => return Err(ConfigError::Io(error)),
+    };
+    if metadata.file_type().is_symlink() || !metadata.is_dir() {
+        return Err(ConfigError::InvalidPath(
+            "spool_dir must be a real directory".to_owned(),
+        ));
+    }
+    if metadata.uid() != current_euid() {
+        return Err(ConfigError::InvalidPath("spool_dir has an unexpected owner".to_owned()));
+    }
+    if metadata.gid() != current_egid() {
+        return Err(ConfigError::InvalidPath("spool_dir has an unexpected group".to_owned()));
+    }
+    if metadata.permissions().mode() & 0o7777 != PRIVATE_DIRECTORY_MODE {
+        return Err(ConfigError::InvalidPath("spool_dir must have mode 0700".to_owned()));
+    }
+    Ok(())
+}
+
+fn check_free_space(path: &Path, minimum: u64) -> Result<(), ConfigError> {
+    let cpath = CString::new(path.as_os_str().as_bytes())
+        .map_err(|_| ConfigError::InvalidPath("spool_dir contains NUL".to_owned()))?;
+    let mut stat = std::mem::MaybeUninit::<libc::statvfs>::uninit();
+    // SAFETY: cpath is NUL-terminated and stat points to writable storage.
+    let result = unsafe { libc::statvfs(cpath.as_ptr(), stat.as_mut_ptr()) };
+    if result != 0 {
+        return Err(ConfigError::Io(io::Error::last_os_error()));
+    }
+    // SAFETY: statvfs initialized on success.
+    let stat = unsafe { stat.assume_init() };
+    let block_size = stat.f_frsize as u128;
+    let available = (stat.f_bavail as u128).saturating_mul(block_size);
+    let total = (stat.f_blocks as u128).saturating_mul(block_size);
+    if total == 0 || minimum as u128 >= total {
+        return Err(ConfigError::Invalid(format!(
+            "min_free_bytes must be less than spool filesystem capacity ({total} bytes)"
+        )));
+    }
+    if available < minimum as u128 {
+        return Err(ConfigError::Invalid(format!(
+            "spool filesystem has less than {minimum} free bytes"
+        )));
+    }
+    Ok(())
+}
+
+fn validate_regular_file_metadata(
+    metadata: &fs::Metadata,
+    field: &str,
+    expected_uid: Option<u32>,
+    expected_gid: Option<u32>,
+    expected_mode: Option<u32>,
+) -> Result<(), String> {
+    if metadata.file_type().is_symlink() || !metadata.is_file() {
+        return Err(format!("{field} must be a regular, non-symlink file"));
+    }
+    if let Some(uid) = expected_uid
+        && metadata.uid() != uid
+    {
+        return Err(format!("{field} has an unexpected owner"));
+    }
+    if let Some(gid) = expected_gid
+        && metadata.gid() != gid
+    {
+        return Err(format!("{field} has an unexpected group"));
+    }
+    if let Some(mode) = expected_mode
+        && metadata.permissions().mode() & 0o7777 != mode
+    {
+        return Err(format!("{field} must have mode {mode:04o}"));
+    }
+    Ok(())
+}
+
+fn open_nofollow(path: &Path) -> io::Result<File> {
+    OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+        .open(path)
+}
+
+fn read_bounded(file: &mut File, limit: usize) -> io::Result<Vec<u8>> {
+    // Read one sentinel byte beyond the contract limit.  Callers can then
+    // distinguish an oversized file even when its metadata changed after the
+    // initial stat, without ever retaining more than limit + 1 bytes.
+    let sentinel_limit = limit
+        .checked_add(1)
+        .ok_or_else(|| io::Error::new(io::ErrorKind::InvalidInput, "read limit overflow"))?;
+    let mut bytes = Vec::with_capacity(sentinel_limit.min(4096));
+    file.take(sentinel_limit as u64).read_to_end(&mut bytes)?;
+    if bytes.len() > limit {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "file exceeds configured size limit",
+        ));
+    }
+    Ok(bytes)
+}
+
+fn validate_private_parent(path: &Path, field: &str) -> Result<(), ConfigError> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| ConfigError::InvalidPath(format!("{field} has no parent")))?;
+    let metadata = fs::symlink_metadata(parent)?;
+    if metadata.file_type().is_symlink() || !metadata.is_dir() {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent is not a real directory"
+        )));
+    }
+    if metadata.uid() != 0 {
+        return Err(ConfigError::InvalidPath(format!("{field} parent must be root-owned")));
+    }
+    if metadata.gid() != current_egid() {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent has an unexpected group"
+        )));
+    }
+    let mode = metadata.permissions().mode() & 0o7777;
+    if mode != SOCKET_DIRECTORY_MODE {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent must have mode {SOCKET_DIRECTORY_MODE:04o}"
+        )));
+    }
+    Ok(())
+}
+
+pub(crate) fn validate_socket_parent(path: &Path, field: &str) -> Result<(), ConfigError> {
+    let parent = path
+        .parent()
+        .ok_or_else(|| ConfigError::InvalidPath(format!("{field} has no parent")))?;
+    let metadata = fs::symlink_metadata(parent)?;
+    if metadata.file_type().is_symlink() || !metadata.is_dir() {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent is not a real directory"
+        )));
+    }
+    if metadata.uid() != 0 && metadata.uid() != current_euid() {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent has an unexpected owner"
+        )));
+    }
+    let mode = metadata.permissions().mode() & 0o7777;
+    if mode != SOCKET_DIRECTORY_MODE {
+        return Err(ConfigError::InvalidPath(format!(
+            "{field} parent must have mode {SOCKET_DIRECTORY_MODE:04o}"
+        )));
+    }
+    Ok(())
+}
