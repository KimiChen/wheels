+/// Resolve the configured audit daemon account during configuration
+/// validation.  Name-service state is intentionally checked before any
+/// listener or emitter is created; reconnect-time peer authentication still
+/// performs the independent UID/inode checks required by the wire contract.
+#[cfg(all(feature = "user-audit", target_os = "linux"))]
+fn resolve_user_audit_uid(name: &str) -> Option<u32> {
+    let cname = CString::new(name).ok()?;
+    let mut entry = MaybeUninit::<libc::passwd>::uninit();
+    let mut buffer = vec![0_u8; 16 * 1024];
+    let mut result = std::ptr::null_mut();
+    // SAFETY: all pointers reference writable storage for getpwnam_r and the
+    // C string remains alive for the duration of the call.
+    let rc = unsafe {
+        libc::getpwnam_r(
+            cname.as_ptr(),
+            entry.as_mut_ptr(),
+            buffer.as_mut_ptr().cast(),
+            buffer.len(),
+            &mut result,
+        )
+    };
+    if rc != 0 || result.is_null() {
+        return None;
+    }
+    // SAFETY: POSIX specifies that a successful non-null result initializes
+    // the passwd structure supplied by the caller.
+    Some(unsafe { entry.assume_init() }.pw_uid)
 }
 
