+/// A pending transaction for removing an entry from `quarantine/`.
+#[derive(Clone, Debug, Eq, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct QuarantinePending {
+    pub entry_type: String,
+    pub gap_event_id: String,
+    pub quarantine_basename: String,
+    pub reason: String,
+    pub recorded_at_unix_ms: DecimalU64,
+    pub batch_id: Option<String>,
+    pub body_sha256: Option<String>,
+    pub spool_epoch: Option<String>,
+    pub first_spool_sequence: Option<DecimalU64>,
+    pub last_spool_sequence: Option<DecimalU64>,
+    pub event_count: Option<DecimalU64>,
+    pub raw_bytes: Option<DecimalU64>,
+}
