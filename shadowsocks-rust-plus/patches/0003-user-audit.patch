+    #[test]
+    fn overlapping_sealed_sequence_ranges_abandon_the_epoch() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        let spool = Spool::open(config(dir.path())).expect("spool");
+        spool.append(&event(1), 1).expect("append");
+        let sealed = spool.lease().expect("lease").expect("sealed batch").info.path.clone();
+        let epoch = lock(&spool.inner).epoch.clone();
+        drop(spool);
+
+        // A second surviving object claiming the same (epoch, sequence) range
+        // is evidence of a copy or rename: the epoch can no longer produce
+        // unambiguous export keys and must be abandoned.
+        let duplicate = dir
+            .path()
+            .join("sealed")
+            .join(format!("{epoch}-1-1-{}", "f".repeat(32)));
+        fs::create_dir(&duplicate).expect("duplicate batch dir");
+        fs::set_permissions(&duplicate, fs::Permissions::from_mode(0o700)).expect("dir mode");
+        for name in ["meta.json", "segment.ndjson"] {
+            fs::copy(sealed.join(name), duplicate.join(name)).expect("copy batch object");
+            fs::set_permissions(duplicate.join(name), fs::Permissions::from_mode(0o600)).expect("file mode");
+        }
+
+        let spool = Spool::open(config(dir.path())).expect("recover");
+        let inner = lock(&spool.inner);
+        assert_ne!(inner.epoch, epoch, "ambiguous sequence ranges must abandon the epoch");
+        assert!(
+            inner
+                .durable_gap_reasons
+                .values()
+                .any(|reason| *reason == wire::SpoolGapReason::StateReset),
+            "an abandoned epoch owes the collector a state_reset gap"
+        );
+    }
