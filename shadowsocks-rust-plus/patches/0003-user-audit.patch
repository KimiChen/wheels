+    fn every_write_operation_rejects_after_the_fatal_barrier() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        let spool = Spool::open(config(dir.path())).expect("spool");
+        spool.append(&event(1), 1).expect("durable record");
+        {
