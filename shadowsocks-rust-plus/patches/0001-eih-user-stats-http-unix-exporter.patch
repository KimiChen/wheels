+//! EIH per-user traffic statistics and local read-only exporter.
+
+use std::{
+    collections::BTreeMap,
+    fmt::Write as _,
+    io::{self, Write},
+    sync::{
+        Arc, Mutex, RwLock, Weak,
+        atomic::{AtomicBool, Ordering},
+    },
+    time::{SystemTime, UNIX_EPOCH},
+};
+
+use rand::Rng;
+use portable_atomic::AtomicU64;
+use serde::{Deserialize, Serialize};
+use thiserror::Error;
+
+/// Exported snapshot schema version.
+pub const USER_STATS_SCHEMA_VERSION: u32 = 1;
+
+/// Four-direction application payload counters for one authenticated EIH user.
+pub struct UserTrafficCounters {
+    tcp_uplink_bytes: AtomicU64,
+    tcp_downlink_bytes: AtomicU64,
+    udp_uplink_bytes: AtomicU64,
+    udp_downlink_bytes: AtomicU64,
+    overflowed: Arc<AtomicBool>,
+}
+
+impl Default for UserTrafficCounters {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl UserTrafficCounters {
+    /// Create standalone counters.
+    pub fn new() -> Self {
+        Self::with_overflow_flag(Arc::new(AtomicBool::new(false)))
+    }
+
+    fn with_overflow_flag(overflowed: Arc<AtomicBool>) -> Self {
+        Self {
+            tcp_uplink_bytes: AtomicU64::new(0),
+            tcp_downlink_bytes: AtomicU64::new(0),
+            udp_uplink_bytes: AtomicU64::new(0),
+            udp_downlink_bytes: AtomicU64::new(0),
+            overflowed,
+        }
+    }
+
+    fn saturating_add_u64(&self, counter: &AtomicU64, amount: u64) {
+        let mut current = counter.load(Ordering::Relaxed);
+        loop {
+            let (next, overflowed) = current.overflowing_add(amount);
+            let next = if overflowed { u64::MAX } else { next };
+            if overflowed {
+                // Publish unhealthy state before making the saturated counter visible.
+                self.overflowed.store(true, Ordering::Release);
+            }
+            let success_ordering = if overflowed { Ordering::Release } else { Ordering::Relaxed };
+            match counter.compare_exchange_weak(current, next, success_ordering, Ordering::Relaxed) {
+                Ok(..) => {
+                    return;
+                }
+                Err(actual) => current = actual,
+            }
+        }
+    }
+
+    /// Add successfully forwarded TCP uplink application payload bytes.
+    pub fn add_tcp_uplink(&self, amount: usize) {
+        self.saturating_add_u64(&self.tcp_uplink_bytes, u64::try_from(amount).unwrap_or(u64::MAX));
+    }
+
+    /// Add successfully forwarded TCP downlink application payload bytes.
+    pub fn add_tcp_downlink(&self, amount: usize) {
+        self.saturating_add_u64(&self.tcp_downlink_bytes, u64::try_from(amount).unwrap_or(u64::MAX));
+    }
+
+    /// Add successfully forwarded UDP uplink application payload bytes.
+    pub fn add_udp_uplink(&self, amount: usize) {
+        self.saturating_add_u64(&self.udp_uplink_bytes, u64::try_from(amount).unwrap_or(u64::MAX));
+    }
+
+    /// Add successfully forwarded UDP downlink application payload bytes.
+    pub fn add_udp_downlink(&self, amount: usize) {
+        self.saturating_add_u64(&self.udp_downlink_bytes, u64::try_from(amount).unwrap_or(u64::MAX));
+    }
+
+    /// Whether an attempted addition exceeded `u64::MAX`.
+    #[cfg(test)]
+    pub fn overflowed(&self) -> bool {
+        self.overflowed.load(Ordering::Relaxed)
+    }
+
+    fn snapshot(&self) -> CounterSnapshot {
+        CounterSnapshot {
+            tcp_uplink_bytes: self.tcp_uplink_bytes.load(Ordering::Acquire),
+            tcp_downlink_bytes: self.tcp_downlink_bytes.load(Ordering::Acquire),
+            udp_uplink_bytes: self.udp_uplink_bytes.load(Ordering::Acquire),
+            udp_downlink_bytes: self.udp_downlink_bytes.load(Ordering::Acquire),
+        }
+    }
+}
+
+struct UserRecord {
+    name: String,
+    generation: u64,
+    active: AtomicBool,
+    counters: Arc<UserTrafficCounters>,
+}
+
+#[derive(Default)]
+struct ServerUsers {
+    records: BTreeMap<(String, u64), Arc<UserRecord>>,
+    active: BTreeMap<String, u64>,
+}
+
+struct ServerRecord {
+    server_id: String,
+    listen: RwLock<String>,
+    generation: u64,
+    current_lifecycle: AtomicU64,
+    active: AtomicBool,
+    users: RwLock<ServerUsers>,
+}
+
+#[derive(Default)]
+struct RegistryState {
+    servers: BTreeMap<(String, u64), Arc<ServerRecord>>,
+    /// Current internal lifecycle token for each active logical server.
+    active_servers: BTreeMap<String, u64>,
+    next_server_lifecycle: BTreeMap<String, u64>,
+    server_records: usize,
+    identity_records: usize,
+}
+
+/// Errors returned by registry lifecycle operations.
+#[derive(Debug, Error)]
+pub enum UserStatsRegistryError {
+    /// A server with this ID is already active.
+    #[error("server {0:?} is already active")]
+    ServerAlreadyActive(String),
+    /// This server lifecycle handle is no longer current.
+    #[error("server lifecycle is no longer active")]
+    ServerInactive,
+    /// An internal lifecycle token cannot advance without wrapping.
+    #[error("user statistics lifecycle token exhausted")]
+    GenerationExhausted,
+    /// The configured identity-record limit was reached.
+    #[error("user statistics identity limit {0} reached")]
+    IdentityLimitReached(usize),
+    /// The configured logical-server-record limit was reached.
+    #[error("user statistics server limit {0} reached")]
+    ServerLimitReached(usize),
+    /// The server handle no longer belongs to a live registry.
+    #[error("user statistics registry is no longer available")]
+    RegistryUnavailable,
+}
+
+/// Process-lifetime registry and snapshot metadata.
+pub struct UserStatsRegistry {
+    node_id: String,
+    runtime_id: String,
+    started_at_unix_ms: u64,
+    sequence: AtomicU64,
+    sequence_overflowed: AtomicBool,
+    counter_overflowed: Arc<AtomicBool>,
+    max_identities: usize,
+    max_server_records: usize,
+    snapshot_gate: Mutex<()>,
+    state: RwLock<RegistryState>,
+}
+
+impl UserStatsRegistry {
+    /// Create a registry for one process runtime.
+    ///
+    /// `max_identities` independently bounds stable user names and stable
+    /// server IDs, so the total number of exported records is at most twice
+    /// this value without reducing the configured user capacity.
+    pub fn new<N>(node_id: N, max_identities: usize) -> io::Result<Arc<Self>>
+    where
+        N: Into<String>,
+    {
+        let started_at_unix_ms = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map_err(|err| io::Error::other(format!("system clock is before Unix epoch: {err}")))?
+            .as_millis()
+            .try_into()
+            .map_err(|_| io::Error::other("system time does not fit into u64 milliseconds"))?;
+
+        let mut random = [0u8; 16];
+        rand::rng().fill(&mut random);
+        let mut runtime_id = String::with_capacity(32);
+        for byte in random {
+            write!(&mut runtime_id, "{byte:02x}").expect("writing to String cannot fail");
+        }
+
+        Ok(Arc::new(Self {
+            node_id: node_id.into(),
+            runtime_id,
+            started_at_unix_ms,
+            sequence: AtomicU64::new(0),
+            sequence_overflowed: AtomicBool::new(false),
+            counter_overflowed: Arc::new(AtomicBool::new(false)),
+            max_identities,
+            // Bound logical server IDs independently with the configured user
+            // identity limit. This preserves the existing maximum-user
+            // contract while making server record growth explicit and finite.
+            max_server_records: max_identities,
+            snapshot_gate: Mutex::new(()),
+            state: RwLock::new(RegistryState::default()),
+        }))
+    }
+
+    /// Register or reactivate a stable logical service identity.
+    pub fn register_server<I, L>(
+        self: &Arc<Self>,
+        server_id: I,
+        listen: L,
+    ) -> Result<Arc<ServerStatsHandle>, UserStatsRegistryError>
+    where
+        I: Into<String>,
+        L: Into<String>,
+    {
+        let server_id = server_id.into();
+        let listen = listen.into();
+        let mut state = self.state.write().unwrap_or_else(|poisoned| poisoned.into_inner());
+        if state.active_servers.contains_key(&server_id) {
+            return Err(UserStatsRegistryError::ServerAlreadyActive(server_id));
+        }
+
+        let stable_key = (server_id.clone(), 1);
+        let stable_record = state.servers.get(&stable_key).cloned();
+        if stable_record.is_none() && state.server_records >= self.max_server_records {
+            log::error!(
+                "user statistics logical server limit {} reached while registering {:?}",
+                self.max_server_records,
+                server_id
+            );
+            return Err(UserStatsRegistryError::ServerLimitReached(self.max_server_records));
+        }
+
+        let lifecycle = state.next_server_lifecycle.get(&server_id).copied().unwrap_or(0);
+        let lifecycle = lifecycle
+            .checked_add(1)
+            .ok_or(UserStatsRegistryError::GenerationExhausted)?;
+        state.next_server_lifecycle.insert(server_id.clone(), lifecycle);
+
+        // Stable IDs are logical billing identities. Reusing their exported
+        // generation and cumulative counters keeps the registry bounded and
+        // prevents an already observed lineage from disappearing. The private
+        // lifecycle token still distinguishes stale runtime handles.
+        let record = match stable_record {
+            Some(record) => {
+                *record.listen.write().unwrap_or_else(|poisoned| poisoned.into_inner()) = listen;
+                record.current_lifecycle.store(lifecycle, Ordering::Release);
+                record.active.store(true, Ordering::Relaxed);
+                let mut users = record.users.write().unwrap_or_else(|poisoned| poisoned.into_inner());
+                for user in users.records.values() {
+                    user.active.store(false, Ordering::Relaxed);
+                }
+                users.active.clear();
+                drop(users);
+                record
+            }
+            None => {
+                let record = Arc::new(ServerRecord {
+                    server_id: server_id.clone(),
+                    listen: RwLock::new(listen),
+                    generation: 1,
+                    current_lifecycle: AtomicU64::new(lifecycle),
+                    active: AtomicBool::new(true),
+                    users: RwLock::new(ServerUsers::default()),
+                });
+                state.servers.insert(stable_key, record.clone());
+                state.server_records += 1;
+                record
+            }
+        };
+        state.active_servers.insert(server_id, lifecycle);
+
+        Ok(Arc::new(ServerStatsHandle {
+            registry: Arc::downgrade(self),
+            record,
+            lifecycle,
+        }))
+    }
+
+    /// Mark a server generation and all its current users inactive, retaining totals.
+    pub fn deactivate_server(&self, server: &ServerStatsHandle) -> bool {
+        let Some(registry) = server.registry.upgrade() else {
+            return false;
+        };
+        if !std::ptr::eq(self, registry.as_ref()) {
+            return false;
+        }
+        let mut state = self.state.write().unwrap_or_else(|poisoned| poisoned.into_inner());
+        let is_current = state
+            .active_servers
+            .get(&server.record.server_id)
+            .is_some_and(|lifecycle| *lifecycle == server.lifecycle);
+        if !is_current {
+            return false;
+        }
+
+        state.active_servers.remove(&server.record.server_id);
+        server.record.active.store(false, Ordering::Relaxed);
+        server.record.current_lifecycle.store(0, Ordering::Release);
+        let mut users = server
+            .record
+            .users
+            .write()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        for user in users.records.values() {
+            user.active.store(false, Ordering::Relaxed);
+        }
+        users.active.clear();
+        true
+    }
+
+    fn register_user(
+        &self,
+        server: &Arc<ServerRecord>,
+        lifecycle: u64,
+        name: String,
+    ) -> Result<Arc<UserTrafficCounters>, UserStatsRegistryError> {
+        let mut state = self.state.write().unwrap_or_else(|poisoned| poisoned.into_inner());
+        if !server.active.load(Ordering::Relaxed)
+            || !state
+                .active_servers
+                .get(&server.server_id)
+                .is_some_and(|active_lifecycle| *active_lifecycle == lifecycle)
+        {
+            return Err(UserStatsRegistryError::ServerInactive);
+        }
+        let mut users = server.users.write().unwrap_or_else(|poisoned| poisoned.into_inner());
+
+        if let Some(generation) = users.active.get(&name)
+            && let Some(record) = users.records.get(&(name.clone(), *generation))
+        {
+            return Ok(record.counters.clone());
+        }
+        if let Some(record) = users.records.get(&(name.clone(), 1)).cloned() {
+            record.active.store(true, Ordering::Relaxed);
+            users.active.insert(name, record.generation);
+            return Ok(record.counters.clone());
+        }
+        if state.identity_records >= self.max_identities {
+            log::error!(
+                "user statistics logical identity limit {} reached while registering {:?} on server {:?}",
+                self.max_identities,
+                name,
+                server.server_id
+            );
+            return Err(UserStatsRegistryError::IdentityLimitReached(self.max_identities));
+        }
+
+        let counters = Arc::new(UserTrafficCounters::with_overflow_flag(self.counter_overflowed.clone()));
+        let record = Arc::new(UserRecord {
+            name: name.clone(),
+            generation: 1,
+            active: AtomicBool::new(true),
+            counters: counters.clone(),
+        });
+        users.records.insert((name.clone(), 1), record);
+        users.active.insert(name, 1);
+        state.identity_records += 1;
+        Ok(counters)
+    }
+
+    fn next_sequence(&self) -> u64 {
+        let mut current = self.sequence.load(Ordering::Relaxed);
+        loop {
+            let next = current.saturating_add(1);
+            if current == u64::MAX {
+                self.sequence_overflowed.store(true, Ordering::Release);
+            }
+            let success_ordering = if current == u64::MAX {
+                Ordering::Release
+            } else {
+                Ordering::Relaxed
+            };
+            match self
+                .sequence
+                .compare_exchange_weak(current, next, success_ordering, Ordering::Relaxed)
+            {
+                Ok(..) => return next,
+                Err(actual) => current = actual,
+            }
+        }
+    }
+
+    fn health_snapshot(&self) -> UserStatsHealthSnapshot {
+        UserStatsHealthSnapshot {
+            counter_overflow: self.counter_overflowed.load(Ordering::Acquire),
+            sequence_overflow: self.sequence_overflowed.load(Ordering::Acquire),
+        }
+    }
+
+    #[cfg(unix)]
+    fn is_healthy(&self) -> bool {
+        let health = self.health_snapshot();
+        !health.counter_overflow && !health.sequence_overflow
+    }
+
+    /// Build a stable, key-sorted snapshot without serializing under registry locks.
+    pub fn snapshot(&self) -> UserStatsSnapshot {
+        let _snapshot_guard = self
+            .snapshot_gate
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        let sequence = self.next_sequence();
+        let state = self.state.read().unwrap_or_else(|poisoned| poisoned.into_inner());
+        let mut servers = Vec::with_capacity(state.servers.len());
+
+        for record in state.servers.values() {
+            let users = record.users.read().unwrap_or_else(|poisoned| poisoned.into_inner());
+            let users = users
+                .records
+                .values()
+                .map(|user| {
+                    let counters = user.counters.snapshot();
+                    UserStatsSnapshotEntry {
+                        identity_kind: UserStatsIdentityKind::User,
+                        name: user.name.clone(),
+                        generation: user.generation,
+                        active: user.active.load(Ordering::Relaxed),
+                        tcp_uplink_bytes: counters.tcp_uplink_bytes,
+                        tcp_downlink_bytes: counters.tcp_downlink_bytes,
+                        udp_uplink_bytes: counters.udp_uplink_bytes,
+                        udp_downlink_bytes: counters.udp_downlink_bytes,
+                    }
+                })
+                .collect();
+            servers.push(ServerStatsSnapshot {
+                server_id: record.server_id.clone(),
+                listen: record
+                    .listen
+                    .read()
+                    .unwrap_or_else(|poisoned| poisoned.into_inner())
+                    .clone(),
+                generation: record.generation,
+                active: record.active.load(Ordering::Relaxed),
+                users,
+            });
+        }
+        drop(state);
+
+        UserStatsSnapshot {
+            schema_version: USER_STATS_SCHEMA_VERSION,
+            node_id: self.node_id.clone(),
+            runtime_id: self.runtime_id.clone(),
+            started_at_unix_ms: self.started_at_unix_ms,
+            sequence,
+            health: self.health_snapshot(),
+            servers,
+        }
+    }
+
+    /// Serialize a snapshot and newline without exceeding `max_bytes`.
+    pub fn serialize_snapshot_limited(&self, max_bytes: usize) -> Result<Vec<u8>, SnapshotSerializeError> {
+        let snapshot = self.snapshot();
+        let mut writer = LimitedWriter::new(max_bytes);
+        if let Err(err) = serde_json::to_writer(&mut writer, &snapshot) {
+            if writer.limit_exceeded {
+                return Err(SnapshotSerializeError::ResponseTooLarge(max_bytes));
+            }
+            return Err(SnapshotSerializeError::Json(err));
+        }
+        writer
+            .write_all(b"\n")
+            .map_err(|_| SnapshotSerializeError::ResponseTooLarge(max_bytes))?;
+        Ok(writer.into_inner())
+    }
+}
+
+/// Handle for one activation of a stable logical server identity.
+pub struct ServerStatsHandle {
+    registry: Weak<UserStatsRegistry>,
+    record: Arc<ServerRecord>,
+    lifecycle: u64,
+}
+
+impl ServerStatsHandle {
+    /// Register, reactivate, or retrieve a stable logical user identity.
+    pub fn register_user<N>(&self, name: N) -> Result<Arc<UserTrafficCounters>, UserStatsRegistryError>
+    where
+        N: Into<String>,
+    {
+        let registry = self
+            .registry
+            .upgrade()
+            .ok_or(UserStatsRegistryError::RegistryUnavailable)?;
+        registry.register_user(&self.record, self.lifecycle, name.into())
+    }
+
+    /// Retrieve the active user's counter handle.
+    pub fn user_stats_counter(&self, name: &str) -> Option<Arc<UserTrafficCounters>> {
+        let registry = self.registry.upgrade()?;
+        // Keep the lifecycle state stable until the user lookup has finished.
+        // Lifecycle writers take `state` before `users`, so taking the same
+        // order here both linearizes stale-handle rejection and avoids a lock
+        // inversion with deactivate/reactivate operations.
+        let state = registry
+            .state
+            .read()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        if !self.record.active.load(Ordering::Relaxed)
+            || self.record.current_lifecycle.load(Ordering::Acquire) != self.lifecycle
+            || !state
+                .active_servers
+                .get(&self.record.server_id)
+                .is_some_and(|lifecycle| *lifecycle == self.lifecycle)
+        {
+            return None;
+        }
+        let users = self
+            .record
+            .users
+            .read()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        let generation = users.active.get(name)?;
+        users
+            .records
+            .get(&(name.to_owned(), *generation))
+            .map(|user| user.counters.clone())
+    }
+
+    /// Mark the logical user inactive, retaining cumulative totals.
+    #[cfg(test)]
+    pub fn deactivate_user(&self, name: &str) -> bool {
+        let Some(registry) = self.registry.upgrade() else {
+            return false;
+        };
+        // Match the registry-wide `state -> users` lock order and prevent a
+        // server reactivation from crossing the lifecycle check below.
+        let state = registry
+            .state
+            .read()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        if !self.record.active.load(Ordering::Relaxed)
+            || self.record.current_lifecycle.load(Ordering::Acquire) != self.lifecycle
+            || !state
+                .active_servers
+                .get(&self.record.server_id)
+                .is_some_and(|lifecycle| *lifecycle == self.lifecycle)
+        {
+            return false;
+        }
+        let mut users = self
+            .record
+            .users
+            .write()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        let Some(generation) = users.active.remove(name) else {
+            return false;
+        };
+        if let Some(user) = users.records.get(&(name.to_owned(), generation)) {
+            user.active.store(false, Ordering::Relaxed);
+        }
+        true
+    }
+}
+
+impl Drop for ServerStatsHandle {
+    fn drop(&mut self) {
+        if let Some(registry) = self.registry.upgrade() {
+            registry.deactivate_server(self);
+        }
+    }
+}
