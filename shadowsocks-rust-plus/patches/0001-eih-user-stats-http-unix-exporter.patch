+    #[cfg(all(feature = "user-stats", unix))]
+    pub(crate) fn check_user_stats_integrity(&self, stats: &UserStatsConfig) -> Result<(), Error> {
+        use std::collections::HashSet;
+        use shadowsocks::config::method_support_eih;
+
+        fn invalid(desc: &'static str, detail: Option<String>) -> Error {
+            Error::new(ErrorKind::Invalid, desc, detail)
+        }
+
+        fn check_identifier(value: &str, field: &'static str) -> Result<(), Error> {
+            if value.is_empty()
+                || value.len() > USER_STATS_MAX_IDENTIFIER_BYTES
+                || !value.bytes().all(|byte| byte.is_ascii_graphic())
+            {
+                return Err(invalid(
+                    "user statistics identifier is invalid",
+                    Some(format!(
+                        "`{field}` must be non-empty, at most {USER_STATS_MAX_IDENTIFIER_BYTES} bytes, and contain only printable non-whitespace ASCII characters"
+                    )),
+                ));
+            }
+            Ok(())
+        }
+
+        check_identifier(&stats.node_id, "user_stats.node_id")?;
+
+        // A root launcher may drop privileges after this check. The exporter
+        // repeats the full owner walk with the final effective UID before bind.
+        if let Err(err) = canonical_user_stats_socket_path(&stats.socket_path, true) {
+            let description = if err.kind() == io::ErrorKind::PermissionDenied {
+                "untrusted `user_stats.socket_path` parent directory"
+            } else {
+                "invalid `user_stats.socket_path` parent directory"
+            };
+            return Err(invalid(description, Some(err.to_string())));
+        }
+
+        if !matches!(stats.socket_mode, 0o600 | 0o660) {
+            return Err(invalid(
+                "invalid `user_stats.socket_mode`",
+                Some("mode must be either \"0600\" or \"0660\"".to_owned()),
+            ));
+        }
+
+        for (field, value) in [
+            ("read_timeout_ms", stats.read_timeout),
+            ("write_timeout_ms", stats.write_timeout),
+        ] {
+            if value.is_zero() || value > USER_STATS_MAX_IO_TIMEOUT {
+                return Err(invalid(
+                    "invalid user statistics timeout",
+                    Some(format!(
+                        "`user_stats.{field}` must be between 1 and {} milliseconds",
+                        USER_STATS_MAX_IO_TIMEOUT.as_millis()
+                    )),
+                ));
+            }
+        }
+
+        if stats.max_request_bytes < USER_STATS_MIN_REQUEST_BYTES
+            || stats.max_request_bytes > USER_STATS_MAX_REQUEST_BYTES
+        {
+            return Err(invalid(
+                "invalid `user_stats.max_request_bytes`",
+                Some(format!(
+                    "must be between {USER_STATS_MIN_REQUEST_BYTES} and {USER_STATS_MAX_REQUEST_BYTES}"
+                )),
+            ));
+        }
