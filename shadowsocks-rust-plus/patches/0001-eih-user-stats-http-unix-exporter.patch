+/// Maximum external identifier length in UTF-8 bytes.
+pub const USER_STATS_MAX_IDENTIFIER_BYTES: usize = 128;
+
+/// Validate and anchor a user-statistics socket path without following symbolic
+/// links controlled by a different trust domain.
+#[cfg(all(feature = "user-stats", unix))]
+pub(crate) fn canonical_user_stats_socket_path(
+    path: &Path,
+    allow_root_pre_drop_owner: bool,
+) -> io::Result<PathBuf> {
+    use std::{
+        fs,
+        os::unix::fs::{MetadataExt, PermissionsExt},
+        path::Component,
+    };
+
+    if !path.is_absolute() || path.file_name().is_none() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "user statistics socket path must be absolute and include a file name",
+        ));
+    }
+
+    let parent = path.parent().expect("absolute socket path has a parent");
+    let mut current = PathBuf::from("/");
+    // SAFETY: `geteuid` has no preconditions and does not mutate process state.
+    let effective_uid = unsafe { libc::geteuid() };
+    let relax_owner = allow_root_pre_drop_owner && effective_uid == 0;
+
+    for component in parent.components() {
+        match component {
+            Component::RootDir => continue,
+            Component::Normal(name) => current.push(name),
+            _ => {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidInput,
+                    "user statistics socket path must use canonical components",
+                ));
+            }
+        }
+
+        let metadata = fs::symlink_metadata(&current)?;
+        if metadata.file_type().is_symlink() || !metadata.is_dir() {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "user statistics socket path ancestors must be real directories, not symbolic links",
+            ));
+        }
+
+        let owner = metadata.uid();
+        if !relax_owner && owner != 0 && owner != effective_uid {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "user statistics socket path ancestors must be owned by root or the effective user",
+            ));
+        }
+
+        let mode = metadata.permissions().mode();
+        let writable_by_others = mode & 0o022 != 0;
+        let root_owned_sticky_ancestor = current != parent && owner == 0 && mode & 0o1000 != 0;
+        if writable_by_others && !root_owned_sticky_ancestor {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "only root-owned sticky ancestors may be group/other writable; the socket parent must not be",
+            ));
+        }
+    }
+
+    let canonical_parent = fs::canonicalize(parent)?;
+    if canonical_parent != parent {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "user statistics socket path must be canonical and contain no symbolic-link ancestors",
+        ));
+    }
+
+    Ok(canonical_parent.join(path.file_name().expect("checked socket file name")))
+}
