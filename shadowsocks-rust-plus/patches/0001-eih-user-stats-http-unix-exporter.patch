+    static UMASK_LOCK: Mutex<()> = Mutex::new(());
+
+    struct UmaskGuard(libc::mode_t);
+
+    impl UmaskGuard {
+        fn restrictive() -> Self {
+            // 0077 keeps concurrently created directories traversable by their
+            // owner while preventing group/other access to the new socket.
+            // SAFETY: The old process umask is restored by Drop without crossing an await.
+            Self(unsafe { libc::umask(0o077) })
+        }
+    }
+
+    impl Drop for UmaskGuard {
+        fn drop(&mut self) {
+            // SAFETY: Restores the value returned by the matching `umask` call.
+            unsafe {
+                libc::umask(self.0);
+            }
+        }
+    }
