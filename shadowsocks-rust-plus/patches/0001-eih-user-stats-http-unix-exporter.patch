+    /// Local Unix stream snapshot exporter.
+    pub struct UserStatsExporter {
+        listener: UnixListener,
+        registry: Arc<UserStatsRegistry>,
+        config: UserStatsConfig,
+        _socket_path_guard: SocketPathGuard,
+        // Declared after the path guard so the socket inode is cleaned before the lock is released.
+        _socket_lock: SocketLock,
+        #[cfg(test)]
+        inject_accept_failure: bool,
+        #[cfg(test)]
+        busy_response_hook: Option<BusyResponseTestHook>,
+    }
+
+    #[cfg(test)]
+    #[derive(Clone)]
+    struct BusyResponseTestHook {
+        entered: tokio::sync::mpsc::UnboundedSender<()>,
+        release: Arc<Semaphore>,
+    }
+
+    impl UserStatsExporter {
+        /// Safely bind the configured filesystem socket.
+        pub fn bind(mut config: UserStatsConfig, registry: Arc<UserStatsRegistry>) -> io::Result<Self> {
+            config.socket_path = canonical_user_stats_socket_path(&config.socket_path, false)?;
+            let socket_lock = SocketLock::acquire(&config.socket_path)?;
+            remove_stale_socket(&config.socket_path)?;
+
+            let listener = {
+                let _umask_lock = UMASK_LOCK.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
+                let _umask_guard = UmaskGuard::restrictive();
+                std::os::unix::net::UnixListener::bind(&config.socket_path)?
+            };
+
+            let metadata = fs::symlink_metadata(&config.socket_path)?;
+            let socket_path_guard = SocketPathGuard {
+                path: config.socket_path.clone(),
+                device: metadata.dev(),
+                inode: metadata.ino(),
+            };
+            set_socket_permissions_nofollow(&config.socket_path, &metadata, config.socket_mode)?;
+            listener.set_nonblocking(true)?;
+            let listener = UnixListener::from_std(listener)?;
+
+            Ok(Self {
+                listener,
+                registry,
+                config,
+                _socket_path_guard: socket_path_guard,
+                _socket_lock: socket_lock,
+                #[cfg(test)]
+                inject_accept_failure: false,
+                #[cfg(test)]
+                busy_response_hook: None,
+            })
+        }
+
+        #[cfg(test)]
+        pub(super) fn inject_persistent_accept_failure(&mut self) {
+            self.inject_accept_failure = true;
+        }
+
+        #[cfg(test)]
+        pub(super) fn block_busy_responses(&mut self) -> (tokio::sync::mpsc::UnboundedReceiver<()>, Arc<Semaphore>) {
+            let (entered, entered_rx) = tokio::sync::mpsc::unbounded_channel();
+            let release = Arc::new(Semaphore::new(0));
+            self.busy_response_hook = Some(BusyResponseTestHook {
+                entered,
+                release: release.clone(),
+            });
+            (entered_rx, release)
+        }
+
+        /// Serve requests until the owning task is cancelled.
+        pub async fn run(self) -> io::Result<()> {
+            info!(
+                "user statistics exporter listening on {}",
+                self.config.socket_path.display()
+            );
+            let semaphore = Arc::new(Semaphore::new(self.config.max_concurrent_clients));
+            let busy_response_semaphore = Arc::new(Semaphore::new(MAX_BUSY_RESPONSE_WORKERS));
+            let mut workers = JoinSet::new();
+            let mut consecutive_accept_errors = 0usize;
+
+            loop {
+                while let Some(result) = workers.try_join_next() {
+                    match result {
+                        Ok(Ok(())) => {}
+                        Ok(Err(err)) => warn!("user statistics exporter client failed: {err}"),
+                        Err(err) => error!("user statistics exporter client task failed: {err}"),
+                    }
+                }
+
+                #[cfg(test)]
+                let accept_result = if self.inject_accept_failure {
+                    Err(io::Error::other("injected persistent accept failure"))
+                } else {
+                    self.listener.accept().await
+                };
+                #[cfg(not(test))]
+                let accept_result = self.listener.accept().await;
+
+                let (stream, _) = match accept_result {
+                    Ok(connection) => {
+                        consecutive_accept_errors = 0;
+                        connection
+                    }
+                    Err(err) => {
+                        consecutive_accept_errors = consecutive_accept_errors.saturating_add(1);
+                        if consecutive_accept_errors >= MAX_CONSECUTIVE_ACCEPT_ERRORS {
+                            return Err(io::Error::new(
+                                err.kind(),
+                                format!(
+                                    "user statistics exporter accept failed {consecutive_accept_errors} consecutive times: {err}"
+                                ),
+                            ));
+                        }
+                        error!(
+                            "user statistics exporter accept failed ({consecutive_accept_errors}/{MAX_CONSECUTIVE_ACCEPT_ERRORS}): {err}"
+                        );
+                        time::sleep(ACCEPT_ERROR_RETRY_DELAY).await;
+                        continue;
+                    }
+                };
+
+                let permit = match semaphore.clone().try_acquire_owned() {
+                    Ok(permit) => permit,
+                    Err(..) => {
+                        let busy_permit = match busy_response_semaphore.clone().try_acquire_owned() {
+                            Ok(permit) => permit,
+                            Err(..) => continue,
+                        };
+                        // Never await client-controlled I/O on the accept loop.
+                        // Busy-response tasks do not consume client permits and
+                        // are separately bounded in count and lifetime.
+                        let timeout = self.config.write_timeout.min(BUSY_RESPONSE_WRITE_TIMEOUT);
+                        #[cfg(test)]
+                        let hook = self.busy_response_hook.clone();
+                        workers.spawn(async move {
+                            let _busy_permit = busy_permit;
+                            #[cfg(test)]
+                            if let Some(hook) = hook {
+                                let _ = hook.entered.send(());
+                                let permit = hook.release.acquire_owned().await;
+                                if let Ok(permit) = permit {
+                                    permit.forget();
+                                }
+                            }
+                            let mut stream = stream;
+                            let _ = time::timeout(
+                                timeout,
+                                write_direct_json(&mut stream, timeout, StatusCode::TOO_MANY_REQUESTS, ERROR_BUSY),
+                            )
+                            .await;
+                            Ok(())
+                        });
+                        continue;
+                    }
+                };
+                let registry = self.registry.clone();
+                let config = self.config.clone();
+                workers.spawn(async move { handle_client(stream, permit, registry, config).await });
+            }
+        }
+    }
+
+    fn remove_stale_socket(path: &Path) -> io::Result<()> {
+        let metadata = match fs::symlink_metadata(path) {
+            Ok(metadata) => metadata,
+            Err(err) if err.kind() == io::ErrorKind::NotFound => return Ok(()),
+            Err(err) => return Err(err),
+        };
+        if !metadata.file_type().is_socket() {
+            return Err(io::Error::new(
+                io::ErrorKind::AlreadyExists,
+                "refusing to replace a non-socket user statistics path",
+            ));
+        }
+
+        let probe = Socket::new(Domain::UNIX, Type::STREAM, None)?;
+        probe.set_nonblocking(true)?;
+        let address = SockAddr::unix(path)?;
+        match probe.connect(&address) {
+            Ok(..) => {
+                return Err(io::Error::new(
+                    io::ErrorKind::AddrInUse,
+                    "user statistics socket is already active",
+                ));
+            }
+            Err(err) if err.kind() == io::ErrorKind::WouldBlock || err.raw_os_error() == Some(libc::EINPROGRESS) => {
+                return Err(io::Error::new(
+                    io::ErrorKind::AddrInUse,
+                    "user statistics socket may still be active",
+                ));
+            }
+            Err(err) if matches!(err.kind(), io::ErrorKind::ConnectionRefused | io::ErrorKind::NotFound) => {}
+            Err(err) => return Err(err),
+        }
+
+        let current = match fs::symlink_metadata(path) {
+            Ok(current) => current,
+            Err(err) if err.kind() == io::ErrorKind::NotFound => return Ok(()),
+            Err(err) => return Err(err),
+        };
+        if !current.file_type().is_socket() || current.dev() != metadata.dev() || current.ino() != metadata.ino() {
+            return Err(io::Error::new(
+                io::ErrorKind::AlreadyExists,
+                "user statistics socket path changed while checking staleness",
+            ));
+        }
+        fs::remove_file(path)
+    }
+
+    enum ReadHeadError {
+        Invalid,
+        TooLarge,
+        UnsupportedVersion,
+    }
+
+    async fn read_request_head(stream: &mut UnixStream, max_bytes: usize) -> Result<Vec<u8>, ReadHeadError> {
+        let mut bytes = Vec::with_capacity(max_bytes.min(1_024));
+        let mut buffer = [0u8; 1_024];
+
+        loop {
+            if let Some(position) = bytes.windows(4).position(|window| window == b"\r\n\r\n") {
+                let head_len = position + 4;
+                if head_len > max_bytes {
+                    return Err(ReadHeadError::TooLarge);
+                }
+                if bytes.len() != head_len {
+                    // No request body or pipelined request is accepted, even if it
+                    // arrived in the same kernel read as the request metadata.
+                    return Err(ReadHeadError::Invalid);
+                }
+                return Ok(bytes);
+            }
+
+            if bytes.len() > max_bytes {
+                return Err(ReadHeadError::TooLarge);
+            }
+
+            let remaining = max_bytes.saturating_add(1).saturating_sub(bytes.len());
+            if remaining == 0 {
+                return Err(ReadHeadError::TooLarge);
+            }
+            let read_len = remaining.min(buffer.len());
+            let count = stream
+                .read(&mut buffer[..read_len])
+                .await
+                .map_err(|_| ReadHeadError::Invalid)?;
+            if count == 0 {
+                return Err(ReadHeadError::Invalid);
+            }
+            bytes.extend_from_slice(&buffer[..count]);
+        }
+    }
+
+    fn prevalidate_request_head(head: &[u8]) -> Result<(), ReadHeadError> {
+        let request_line_end = head
+            .windows(2)
+            .position(|window| window == b"\r\n")
+            .ok_or(ReadHeadError::Invalid)?;
+        let mut request_line = head[..request_line_end].split(|byte| *byte == b' ');
+        let method = request_line.next().filter(|field| !field.is_empty());
+        let target = request_line.next().filter(|field| !field.is_empty());
+        let version = request_line.next().filter(|field| !field.is_empty());
+        if method.is_none() || target.is_none() || version.is_none() || request_line.next().is_some() {
+            return Err(ReadHeadError::Invalid);
+        }
+
+        let version = version.expect("checked above");
+        let Some(numeric_version) = version.strip_prefix(b"HTTP/") else {
+            return Err(ReadHeadError::Invalid);
+        };
+        let mut version_parts = numeric_version.split(|byte| *byte == b'.');
+        let major = version_parts.next().filter(|part| !part.is_empty());
+        let minor = version_parts.next().filter(|part| !part.is_empty());
+        if major.is_none()
+            || minor.is_none()
+            || version_parts.next().is_some()
+            || !major.expect("checked above").iter().all(u8::is_ascii_digit)
+            || !minor.expect("checked above").iter().all(u8::is_ascii_digit)
+        {
+            return Err(ReadHeadError::Invalid);
+        }
+        if version != b"HTTP/1.1" {
+            return Err(ReadHeadError::UnsupportedVersion);
+        }
+
+        let mut headers = [httparse::EMPTY_HEADER; MAX_HTTP_HEADERS];
+        let mut request = httparse::Request::new(&mut headers);
+        let parsed = match request.parse(head) {
+            Ok(parsed) => parsed,
+            Err(httparse::Error::TooManyHeaders) => return Err(ReadHeadError::TooLarge),
+            Err(..) => return Err(ReadHeadError::Invalid),
+        };
+        if !matches!(parsed, httparse::Status::Complete(consumed) if consumed == head.len()) {
+            return Err(ReadHeadError::Invalid);
+        }
+
+        let method = request.method.ok_or(ReadHeadError::Invalid)?;
+        Method::from_bytes(method.as_bytes()).map_err(|_| ReadHeadError::Invalid)?;
+        let target = request.path.ok_or(ReadHeadError::Invalid)?;
+        let target = target.parse::<Uri>().map_err(|_| ReadHeadError::Invalid)?;
+        if target.scheme().is_some()
+            || target.authority().is_some()
+            || target.query().is_some()
+            || !target.path().starts_with('/')
+        {
+            return Err(ReadHeadError::Invalid);
+        }
+        if request.version != Some(1) {
+            return Err(ReadHeadError::Invalid);
+        }
+
+        let mut host_seen = false;
+        for header in request.headers.iter() {
+            if header.name.eq_ignore_ascii_case(HOST.as_str()) {
+                if host_seen {
+                    return Err(ReadHeadError::Invalid);
+                }
+                let host = std::str::from_utf8(header.value).map_err(|_| ReadHeadError::Invalid)?;
+                if !valid_host_value(host) {
+                    return Err(ReadHeadError::Invalid);
+                }
+                host_seen = true;
+            } else if header.name.eq_ignore_ascii_case(CONTENT_LENGTH.as_str())
+                || header.name.eq_ignore_ascii_case(TRANSFER_ENCODING.as_str())
+                || header.name.eq_ignore_ascii_case(UPGRADE.as_str())
+            {
+                return Err(ReadHeadError::Invalid);
+            }
+        }
+        if !host_seen {
+            return Err(ReadHeadError::Invalid);
+        }
+        Ok(())
+    }
