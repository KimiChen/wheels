+    #[cfg(unix)]
+    struct TestResponse {
+        status: u16,
+        headers: BTreeMap<String, String>,
+        body: Vec<u8>,
+    }
+
+    #[cfg(unix)]
+    fn split_response(response: Vec<u8>) -> TestResponse {
+        let head_end = response
+            .windows(4)
+            .position(|window| window == b"\r\n\r\n")
+            .expect("HTTP response header terminator")
+            + 4;
+        let head = std::str::from_utf8(&response[..head_end - 4]).unwrap();
+        let mut lines = head.split("\r\n");
+        let status = lines
+            .next()
+            .unwrap()
+            .split_ascii_whitespace()
+            .nth(1)
+            .unwrap()
+            .parse()
+            .unwrap();
+        let headers = lines
+            .map(|line| {
+                let (name, value) = line.split_once(':').unwrap();
+                (name.to_ascii_lowercase(), value.trim().to_owned())
+            })
+            .collect::<BTreeMap<_, _>>();
+        let body = response[head_end..].to_vec();
+        TestResponse { status, headers, body }
+    }
+
+    #[cfg(unix)]
+    fn parse_response(response: Vec<u8>) -> TestResponse {
+        let response = split_response(response);
+        assert_eq!(
+            response.headers.get("content-type").map(String::as_str),
+            Some("application/json")
+        );
+        assert_eq!(
+            response.headers.get("cache-control").map(String::as_str),
+            Some("no-store")
+        );
+        assert_eq!(
+            response.headers.get("connection").map(String::as_str),
+            Some("close")
+        );
+        assert!(!response.headers.contains_key("transfer-encoding"));
+        assert_eq!(
+            response.headers["content-length"].parse::<usize>().unwrap(),
+            response.body.len()
+        );
+        assert_eq!(response.body.last(), Some(&b'\n'));
+        response
+    }
+
+    #[cfg(unix)]
+    async fn raw_request(path: &Path, body: &[u8]) -> Vec<u8> {
+        let mut stream = UnixStream::connect(path).await.unwrap();
+        stream.write_all(body).await.unwrap();
+        let mut response = Vec::new();
+        tokio::time::timeout(Duration::from_secs(2), stream.read_to_end(&mut response))
+            .await
+            .unwrap()
+            .unwrap();
+        response
+    }
+
+    #[cfg(unix)]
+    async fn request(path: &Path, body: &[u8]) -> TestResponse {
+        parse_response(raw_request(path, body).await)
+    }
