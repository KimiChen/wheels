+
+fn serialize_socket_mode<S>(mode: &u32, serializer: S) -> Result<S::Ok, S::Error>
+where
+    S: serde::Serializer,
+{
+    serializer.serialize_str(&format!("{mode:04o}"))
+}
+
+fn deserialize_socket_mode<'de, D>(deserializer: D) -> Result<u32, D::Error>
+where
+    D: serde::Deserializer<'de>,
+{
+    let mode = String::deserialize(deserializer)?;
+    match mode.as_str() {
+        "0600" => Ok(0o600),
+        "0660" => Ok(0o660),
+        _ => Err(serde::de::Error::custom(
+            "socket mode must be exactly \"0600\" or \"0660\"",
+        )),
+    }
+}
