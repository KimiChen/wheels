+
+    fn control_for_user(session_id: u64, name: &str) -> UdpSocketControlData {
+        let key: [u8; 32] = rand::random();
+        let mut control = UdpSocketControlData::default();
+        control.client_session_id = session_id;
+        control.user = Some(Arc::new(ServerUser::new(name, Bytes::copy_from_slice(&key))));
+        control
+    }
+
+    #[test]
+    fn user_stats_rejection_logs_are_limited_per_peer() {
+        let mut limiter = UserStatsRejectionLogLimiter::new();
+        let peer_a = "127.0.0.1:10001".parse().unwrap();
+        let peer_a_other_port = "127.0.0.1:20002".parse().unwrap();
+        let peer_b = "127.0.0.2:10002".parse().unwrap();
+
+        assert!(limiter.should_log(peer_a));
+        assert!(!limiter.should_log(peer_a));
+        assert!(!limiter.should_log(peer_a_other_port));
+        assert!(limiter.should_log(peer_b));
+        assert!(!limiter.should_log(peer_b));
+    }
+
+    #[test]
+    fn session_key_separates_authenticated_users() {
+        let user_a = control_for_user(7, "user-a");
+        let user_b = control_for_user(7, "user-b");
+
+        assert_ne!(
+            SessionKey::from_control(&user_a, true).unwrap(),
+            SessionKey::from_control(&user_b, true).unwrap()
+        );
+        assert_eq!(
+            SessionKey::from_control(&user_a, true).unwrap(),
+            SessionKey::from_control(&user_a, true).unwrap()
+        );
+    }
+
+    #[test]
+    fn session_key_uses_upstream_semantics_when_stats_are_disabled() {
+        let user_a = control_for_user(7, "user-a");
+        let user_b = control_for_user(7, "user-b");
+
+        assert_eq!(
+            SessionKey::from_control(&user_a, false).unwrap(),
+            SessionKey::from_control(&user_b, false).unwrap()
+        );
+    }
+
+    #[test]
