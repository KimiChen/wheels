+
+/// Records only the application payload bytes accepted by successful writes.
+///
+/// Wrapping writers instead of using the final copy totals preserves partial
+/// progress when a later read or write fails.
+#[cfg(feature = "user-stats")]
+struct TcpTrafficStream<S> {
+    inner: S,
+    counters: Arc<UserTrafficCounters>,
+    direction: TcpTrafficDirection,
+}
+
+#[cfg(feature = "user-stats")]
+impl<S> TcpTrafficStream<S> {
+    fn new(inner: S, counters: Arc<UserTrafficCounters>, direction: TcpTrafficDirection) -> Self {
+        Self {
+            inner,
+            counters,
+            direction,
+        }
+    }
+
+    fn record_write(&self, amount: usize) {
+        match self.direction {
+            TcpTrafficDirection::Uplink => self.counters.add_tcp_uplink(amount),
+            TcpTrafficDirection::Downlink => self.counters.add_tcp_downlink(amount),
+        }
+    }
+}
