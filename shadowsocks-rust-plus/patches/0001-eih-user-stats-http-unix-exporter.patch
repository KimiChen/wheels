+        Arc<super::super::user_stats::ServerStatsHandle>,
+        Arc<UserTrafficCounters>,
+    ) {
+        let registry = UserStatsRegistry::new("test-node", 8).unwrap();
+        let server = registry.register_server("test-server", "127.0.0.1:0").unwrap();
+        let counters = server.register_user("test-user").unwrap();
+        (registry, server, counters)
+    }
+
+    #[tokio::test]
+    async fn records_successful_partial_write_before_error() {
+        let (registry, _server, counters) = registered_counters();
+        let mut stream = TcpTrafficStream::new(PartialThenError { writable: 3 }, counters, TcpTrafficDirection::Uplink);
+
+        let err = stream.write_all(b"six123").await.unwrap_err();
+        assert_eq!(err.kind(), ErrorKind::BrokenPipe);
+
+        let snapshot = registry.snapshot();
+        let user = &snapshot.servers[0].users[0];
+        assert_eq!(user.tcp_uplink_bytes, 3);
+        assert_eq!(user.tcp_downlink_bytes, 0);
+    }
+
+    #[tokio::test]
+    async fn records_write_and_vectored_write_in_the_selected_direction() {
+        let (registry, _server, counters) = registered_counters();
+        let mut uplink = TcpTrafficStream::new(tokio::io::sink(), counters.clone(), TcpTrafficDirection::Uplink);
+        let mut downlink = TcpTrafficStream::new(tokio::io::sink(), counters, TcpTrafficDirection::Downlink);
