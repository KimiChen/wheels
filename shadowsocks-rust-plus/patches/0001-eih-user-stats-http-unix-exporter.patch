+
+    fn run_while_users_are_write_locked<T, F>(
+        registry: &Arc<UserStatsRegistry>,
+        record: &Arc<ServerRecord>,
+        operation: F,
+    ) -> T
+    where
+        T: Send + 'static,
+        F: FnOnce() -> T + Send + 'static,
+    {
+        let users = record
+            .users
+            .write()
+            .unwrap_or_else(|poisoned| poisoned.into_inner());
+        let (started_tx, started_rx) = std::sync::mpsc::channel();
+        let (result_tx, result_rx) = std::sync::mpsc::channel();
+        let worker = std::thread::spawn(move || {
+            started_tx.send(()).unwrap();
+            assert!(result_tx.send(operation()).is_ok());
+        });
+        started_rx.recv().unwrap();
+
+        // A correctly ordered operation acquires the registry state read lock
+        // before it waits for the user lock held above. The old implementation
+        // skipped the state lock, so try_write kept succeeding until timeout.
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(1);
+        let mut state_reader_observed = false;
+        while std::time::Instant::now() < deadline {
+            match registry.state.try_write() {
+                Ok(state) => drop(state),
+                Err(std::sync::TryLockError::WouldBlock) => {
+                    state_reader_observed = true;
+                    break;
+                }
+                Err(std::sync::TryLockError::Poisoned(poisoned)) => drop(poisoned.into_inner()),
+            }
+            std::thread::yield_now();
+        }
+
+        drop(users);
+        let result = result_rx
+            .recv_timeout(std::time::Duration::from_secs(1))
+            .expect("user operation must finish after the users lock is released");
+        worker.join().unwrap();
+        assert!(
+            state_reader_observed,
+            "user operation must hold registry state while waiting for the users lock"
+        );
+        result
+    }
