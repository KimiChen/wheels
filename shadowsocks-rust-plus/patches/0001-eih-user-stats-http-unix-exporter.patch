+        let mut exporter = UserStatsExporter::bind(config, registry).unwrap();
+        let (mut busy_responses_entered, release_busy_responses) = exporter.block_busy_responses();
+        let task = tokio::spawn(exporter.run());
+
+        let mut active = UnixStream::connect(&path).await.unwrap();
