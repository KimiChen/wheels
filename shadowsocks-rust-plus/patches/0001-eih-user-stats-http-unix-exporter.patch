+
+    fn metadata_matches(metadata: &fs::Metadata, expected: &fs::Metadata) -> bool {
+        metadata.dev() == expected.dev() && metadata.ino() == expected.ino()
+    }
+
+    fn verify_open_file_path(file: &fs::File, path: &Path, description: &str) -> io::Result<()> {
+        let file_metadata = file.metadata()?;
+        let path_metadata = fs::symlink_metadata(path)?;
+        if !path_metadata.is_file() || !metadata_matches(&file_metadata, &path_metadata) {
+            return Err(io::Error::new(
+                io::ErrorKind::AlreadyExists,
+                format!("{description} path changed while acquiring its lock"),
+            ));
+        }
+        Ok(())
+    }
+
+    fn verify_socket_metadata(metadata: &fs::Metadata, expected: &fs::Metadata) -> io::Result<()> {
+        if !metadata.file_type().is_socket() || !metadata_matches(metadata, expected) {
+            return Err(io::Error::new(
+                io::ErrorKind::AlreadyExists,
+                "user statistics socket path changed while setting permissions",
+            ));
+        }
+        Ok(())
+    }
+
+    fn verify_socket_mode(metadata: &fs::Metadata, mode: u32) -> io::Result<()> {
+        if metadata.permissions().mode() & 0o777 != mode {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "user statistics socket permissions did not match the requested mode",
+            ));
+        }
+        Ok(())
+    }
+
+    #[cfg(any(target_os = "linux", target_os = "android"))]
+    fn set_socket_permissions_nofollow(path: &Path, expected: &fs::Metadata, mode: u32) -> io::Result<()> {
+        // Linux did not provide fchmodat2(2) until kernel 6.5, and glibc did
+        // not emulate fchmodat(..., AT_SYMLINK_NOFOLLOW) until 2.32. Open the
+        // already-bound socket with O_PATH instead, verify the fixed inode,
+        // and deliberately follow only its procfs descriptor link for chmod.
+        // `OpenOptions` derives an access mode and can discard O_PATH for the
+        // x86_64-musl release target, turning this into O_RDONLY and making
+        // opening a bound Unix socket fail with ENXIO. Call open(2) directly
+        // so the kernel receives the exact path-only flags.
+        let path_bytes = CString::new(path.as_os_str().as_bytes()).map_err(|_| {
+            io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "user statistics socket path contains a NUL byte",
+            )
+        })?;
+        // SAFETY: `path_bytes` is NUL-terminated and remains alive for the call;
+        // O_PATH neither reads the socket nor requires a variadic mode argument.
+        let raw_fd = unsafe { libc::open(path_bytes.as_ptr(), libc::O_CLOEXEC | libc::O_NOFOLLOW | libc::O_PATH) };
+        if raw_fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        // SAFETY: open(2) returned one owned descriptor, transferred exactly once.
+        let socket = unsafe { fs::File::from_raw_fd(raw_fd) };
+        let opened = socket.metadata()?;
+        verify_socket_metadata(&opened, expected)?;
+
+        let descriptor_path = PathBuf::from(format!("/proc/self/fd/{}", socket.as_raw_fd()));
+        fs::set_permissions(&descriptor_path, fs::Permissions::from_mode(mode)).map_err(|err| {
+            io::Error::new(
+                err.kind(),
+                format!(
+                    "failed to set user statistics socket permissions through /proc/self/fd; procfs must be mounted and accessible: {err}"
+                ),
+            )
+        })?;
+
+        // Validate both the fixed descriptor and the pathname after chmod.
+        // A concurrent pathname replacement is rejected without ever chmodding
+        // the replacement object.
+        let opened = socket.metadata()?;
+        verify_socket_metadata(&opened, expected)?;
+        verify_socket_mode(&opened, mode)?;
+        let current = fs::symlink_metadata(path)?;
+        verify_socket_metadata(&current, expected)?;
+        verify_socket_mode(&current, mode)
+    }
+
+    #[cfg(not(any(target_os = "linux", target_os = "android")))]
+    fn set_socket_permissions_nofollow(path: &Path, expected: &fs::Metadata, mode: u32) -> io::Result<()> {
+        let path_bytes = CString::new(path.as_os_str().as_bytes()).map_err(|_| {
+            io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "user statistics socket path contains a NUL byte",
+            )
+        })?;
+
+        // `chmod(2)` follows a path swapped to a symbolic link. Request
+        // no-follow semantics from the platform and then revalidate that the
+        // pathname still names the socket inode created above.
+        // SAFETY: `path_bytes` is NUL-terminated and remains alive for the call.
+        let result = unsafe {
+            libc::fchmodat(
+                libc::AT_FDCWD,
+                path_bytes.as_ptr(),
+                mode as libc::mode_t,
+                libc::AT_SYMLINK_NOFOLLOW,
+            )
+        };
+        if result != 0 {
+            return Err(io::Error::last_os_error());
+        }
+
+        let current = fs::symlink_metadata(path)?;
+        verify_socket_metadata(&current, expected)?;
+        verify_socket_mode(&current, mode)
+    }
+
+    impl SocketLock {
+        fn acquire(socket_path: &Path) -> io::Result<Self> {
+            let mut lock_path = socket_path.as_os_str().to_os_string();
+            lock_path.push(".lock");
+            let lock_path = PathBuf::from(lock_path);
+            let file = fs::OpenOptions::new()
+                .read(true)
+                .write(true)
+                .create(true)
+                .mode(0o600)
+                .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW)
+                .open(&lock_path)?;
+            let metadata = file.metadata()?;
+            if !metadata.is_file() {
+                return Err(io::Error::new(
+                    io::ErrorKind::InvalidData,
+                    "user statistics socket lock path is not a regular file",
+                ));
+            }
+            file.set_permissions(fs::Permissions::from_mode(0o600))?;
+
+            // SAFETY: `file` owns a valid descriptor; `flock` does not retain the pointer state.
+            let result = unsafe { libc::flock(file.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) };
+            if result != 0 {
+                let err = io::Error::last_os_error();
+                let raw_os_error = err.raw_os_error();
+                if err.kind() == io::ErrorKind::WouldBlock
+                    || raw_os_error == Some(libc::EAGAIN)
+                    || raw_os_error == Some(libc::EWOULDBLOCK)
+                {
+                    return Err(io::Error::new(
+                        io::ErrorKind::AddrInUse,
+                        "user statistics socket is locked by another process",
+                    ));
+                }
+                return Err(err);
+            }
+
+            // A writer of the parent directory can replace the pathname
+            // between open(2) and flock(2). Re-resolve it after the lock is
+            // held and reject a lock on a now-unlinked inode.
+            verify_open_file_path(&file, &lock_path, "user statistics socket lock")?;
+
+            Ok(Self { _file: file })
+        }
+    }
+
+    impl Drop for SocketPathGuard {
+        fn drop(&mut self) {
+            let Ok(metadata) = fs::symlink_metadata(&self.path) else {
+                return;
+            };
+            if metadata.file_type().is_socket() && metadata.dev() == self.device && metadata.ino() == self.inode {
+                let _ = fs::remove_file(&self.path);
+            }
+        }
+    }
