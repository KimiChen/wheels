+            Ok(Err(err)) => return Err(err),
+            Err(..) => {
+                timeout_fut(timeout, remote_stream.write(&[])).await?;
+                trace!(
+                    "tcp tunnel {} -> {} sent TFO connect without data",
+                    peer_addr, target_addr
+                );
+            }
+        }
+    }
+
+    debug!(
+        "established tcp tunnel {} <-> {} with {:?}",
+        peer_addr, target_addr, connect_opts
