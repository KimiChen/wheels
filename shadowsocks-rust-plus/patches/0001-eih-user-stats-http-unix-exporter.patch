+        uplink.write_all(b"uplink").await.unwrap();
+        let bufs = [io::IoSlice::new(b"down"), io::IoSlice::new(b"link")];
+        let vectored_written = downlink.write_vectored(&bufs).await.unwrap();
+        assert_eq!(vectored_written, 4);
+
+        let snapshot = registry.snapshot();
