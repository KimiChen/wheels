+/// Read-only EIH per-user traffic statistics exporter configuration.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct UserStatsConfig {
+    /// Stable identifier for this data-plane node.
+    pub node_id: String,
+    /// Unix stream socket path.
+    pub socket_path: PathBuf,
+    /// Unix socket permission bits.
+    pub socket_mode: u32,
+    /// Maximum time spent reading one request.
+    pub read_timeout: Duration,
+    /// Maximum time spent writing one response.
+    pub write_timeout: Duration,
+    /// Maximum request size in bytes.
+    pub max_request_bytes: usize,
+    /// Maximum response size in bytes.
+    pub max_response_bytes: usize,
+    /// Maximum number of identities registered in this process.
+    pub max_identities: usize,
+    /// Maximum number of concurrent exporter clients.
+    pub max_concurrent_clients: usize,
+}
+
+impl UserStatsConfig {
+    /// Create a configuration with safe defaults.
+    pub fn new<N, P>(node_id: N, socket_path: P) -> Self
+    where
+        N: Into<String>,
+        P: Into<PathBuf>,
+    {
+        Self {
+            node_id: node_id.into(),
+            socket_path: socket_path.into(),
+            socket_mode: USER_STATS_DEFAULT_SOCKET_MODE,
+            read_timeout: USER_STATS_DEFAULT_READ_TIMEOUT,
+            write_timeout: USER_STATS_DEFAULT_WRITE_TIMEOUT,
+            max_request_bytes: USER_STATS_DEFAULT_MAX_REQUEST_BYTES,
+            max_response_bytes: USER_STATS_DEFAULT_MAX_RESPONSE_BYTES,
+            max_identities: USER_STATS_DEFAULT_MAX_IDENTITIES,
+            max_concurrent_clients: USER_STATS_DEFAULT_MAX_CONCURRENT_CLIENTS,
+        }
+    }
+}
