@@ -0,0 +1,261 @@
+#![cfg(all(feature = "aead-cipher-2022", feature = "user-stats"))]
+
+use std::{
+    io,
+    pin::Pin,
+    task::{Context as TaskContext, Poll},
+};
+
+use base64::{Engine as _, engine::general_purpose::STANDARD as BASE64_STANDARD};
+use futures::future::poll_fn;
+use rand::RngCore;
+use shadowsocks::{
+    ProxyClientStream, ServerConfig,
+    config::{ServerType, ServerUser, ServerUserManager},
+    context::Context,
+    crypto::CipherKind,
+    relay::{
+        socks5::Address,
+        tcprelay::{
+            ProxyServerStream,
+            crypto_io::{CryptoRead, CryptoStream, CryptoWrite, StreamType},
+        },
+    },
+};
+use tokio::io::{AsyncRead, AsyncReadExt, AsyncWrite, AsyncWriteExt, ReadBuf, duplex};
+
+const METHOD: CipherKind = CipherKind::AEAD2022_BLAKE3_AES_128_GCM;
+const PAYLOAD: &[u8] = b"authenticated payload";
+
+struct CorruptingStream<S> {
+    inner: S,
+    read_offset: usize,
+    corrupt_at: usize,
+}
+
+impl<S> CorruptingStream<S> {
+    fn new(inner: S, corrupt_at: usize) -> Self {
+        Self {
+            inner,
+            read_offset: 0,
+            corrupt_at,
+        }
+    }
+}
+
+impl<S: AsyncRead + Unpin> AsyncRead for CorruptingStream<S> {
+    fn poll_read(self: Pin<&mut Self>, cx: &mut TaskContext<'_>, buf: &mut ReadBuf<'_>) -> Poll<io::Result<()>> {
+        let this = self.get_mut();
+        let filled_before = buf.filled().len();
+        match Pin::new(&mut this.inner).poll_read(cx, buf) {
+            Poll::Ready(Ok(())) => {
+                let received = &mut buf.filled_mut()[filled_before..];
+                if (this.read_offset..this.read_offset + received.len()).contains(&this.corrupt_at) {
+                    received[this.corrupt_at - this.read_offset] ^= 0x01;
+                }
+                this.read_offset += received.len();
+                Poll::Ready(Ok(()))
+            }
+            other => other,
+        }
+    }
+}
+
+impl<S: AsyncWrite + Unpin> AsyncWrite for CorruptingStream<S> {
+    fn poll_write(self: Pin<&mut Self>, cx: &mut TaskContext<'_>, buf: &[u8]) -> Poll<io::Result<usize>> {
+        Pin::new(&mut self.get_mut().inner).poll_write(cx, buf)
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, cx: &mut TaskContext<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().inner).poll_flush(cx)
+    }
+
+    fn poll_shutdown(self: Pin<&mut Self>, cx: &mut TaskContext<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().inner).poll_shutdown(cx)
+    }
+}
+
+struct TestKeys {
+    ipsk: String,
+    user_1: String,
+    user_2: String,
+    unknown_user: String,
+}
+
+impl TestKeys {
+    fn random() -> Self {
+        Self {
+            ipsk: random_key(),
+            user_1: random_key(),
+            user_2: random_key(),
+            unknown_user: random_key(),
+        }
+    }
+}
+
+fn random_key() -> String {
+    let mut key = [0u8; 16];
+    rand::rng().fill_bytes(&mut key);
+    BASE64_STANDARD.encode(key)
+}
+
+fn server_config(keys: &TestKeys) -> ServerConfig {
+    let mut users = ServerUserManager::new();
+    users.add_user(ServerUser::with_encoded_key("user-1", &keys.user_1).unwrap());
+    users.add_user(ServerUser::with_encoded_key("user-2", &keys.user_2).unwrap());
+
+    let mut config = ServerConfig::new(("127.0.0.1", 8388), &keys.ipsk, METHOD).unwrap();
+    config.set_user_manager(users);
+    config
+}
+
+fn client_config(ipsk: &str, user_key: &str) -> ServerConfig {
+    ServerConfig::new(("127.0.0.1", 8388), format!("{ipsk}:{user_key}"), METHOD).unwrap()
+}
+
+async fn authenticate_user(config: &ServerConfig, ipsk: &str, user_key: &str, expected_name: &str) {
+    let (client_io, server_io) = duplex(4096);
+    let client_context = Context::new_shared(ServerType::Local);
+    let server_context = Context::new_shared(ServerType::Server);
+    let target = Address::from(("example.com".to_owned(), 443));
+
+    let client_config = client_config(ipsk, user_key);
+    let mut client = ProxyClientStream::from_stream(client_context, client_io, &client_config, target.clone());
+    let mut server = ProxyServerStream::from_stream_with_user_manager(
+        server_context,
+        server_io,
+        METHOD,
+        config.key(),
+        config.clone_user_manager(),
+    );
+
+    client.write_all(PAYLOAD).await.unwrap();
+    assert!(server.authenticated_user().is_none());
+
+    let received_target = server.handshake().await.unwrap();
+    assert_eq!(received_target, target);
+    assert_eq!(server.authenticated_user().unwrap().name(), expected_name);
+
+    let mut received_payload = vec![0; PAYLOAD.len()];
+    server.read_exact(&mut received_payload).await.unwrap();
+    assert_eq!(received_payload, PAYLOAD);
+}
+
+#[tokio::test]
+async fn exposes_each_authenticated_eih_user_after_handshake() {
+    let keys = TestKeys::random();
+    let config = server_config(&keys);
+    authenticate_user(&config, &keys.ipsk, &keys.user_1, "user-1").await;
+    authenticate_user(&config, &keys.ipsk, &keys.user_2, "user-2").await;
+}
+
+#[tokio::test]
+async fn unknown_eih_user_is_never_exposed() {
+    let keys = TestKeys::random();
+    let config = server_config(&keys);
+    let (client_io, server_io) = duplex(4096);
+    let client_context = Context::new_shared(ServerType::Local);
+    let server_context = Context::new_shared(ServerType::Server);
+    let client_config = client_config(&keys.ipsk, &keys.unknown_user);
+
+    let mut client = ProxyClientStream::from_stream(
+        client_context,
+        client_io,
+        &client_config,
+        Address::from(("example.com".to_owned(), 443)),
+    );
+    let mut server = ProxyServerStream::from_stream_with_user_manager(
+        server_context,
+        server_io,
+        METHOD,
+        config.key(),
+        config.clone_user_manager(),
+    );
+
+    client.write_all(PAYLOAD).await.unwrap();
+    assert!(server.handshake().await.is_err());
+    assert!(server.authenticated_user().is_none());
+}
+
+#[tokio::test]
+async fn authenticated_user_remains_hidden_when_request_header_is_invalid() {
+    let keys = TestKeys::random();
+    let config = server_config(&keys);
+    let client_config = client_config(&keys.ipsk, &keys.user_1);
+    let (client_io, server_io) = duplex(4096);
+    let client_context = Context::new_shared(ServerType::Local);
+    let server_context = Context::new_shared(ServerType::Server);
+
+    let mut client = CryptoStream::from_stream_with_identity(
+        &client_context,
+        client_io,
+        StreamType::Client,
+        METHOD,
+        client_config.key(),
+        client_config.identity_keys(),
+        None,
+    );
+    let mut server = ProxyServerStream::from_stream_with_user_manager(
+        server_context,
+        server_io,
+        METHOD,
+        config.key(),
+        config.clone_user_manager(),
+    );
+
+    let invalid_request_header = [0xff, 0x00, 0x00];
+    let written = poll_fn(|cx| Pin::new(&mut client).poll_write_encrypted(cx, &invalid_request_header))
+        .await
+        .unwrap();
+    assert_eq!(written, invalid_request_header.len());
+
+    assert!(server.handshake().await.is_err());
+    assert!(server.authenticated_user().is_none());
+}
+
+#[tokio::test]
+async fn aead_header_authentication_failure_does_not_commit_user() {
+    let keys = TestKeys::random();
+    let config = server_config(&keys);
+    let client_config = client_config(&keys.ipsk, &keys.user_1);
+    let (client_io, server_io) = duplex(4096);
+    let client_context = Context::new_shared(ServerType::Local);
+    let server_context = Context::new_shared(ServerType::Server);
+
+    let mut client = CryptoStream::from_stream_with_identity(
+        &client_context,
+        client_io,
+        StreamType::Client,
+        METHOD,
+        client_config.key(),
+        client_config.identity_keys(),
+        None,
+    );
+    // Preserve the salt and EIH so user lookup succeeds, then corrupt the first
+    // authenticated header byte. The reader must discard its local user candidate.
+    let corrupt_at = METHOD.salt_len() + 16;
+    let server_io = CorruptingStream::new(server_io, corrupt_at);
+    let mut server = CryptoStream::from_stream_with_identity(
+        &server_context,
+        server_io,
+        StreamType::Server,
+        METHOD,
+        config.key(),
+        &[],
+        config.clone_user_manager(),
+    );
+
+    let written = poll_fn(|cx| Pin::new(&mut client).poll_write_encrypted(cx, PAYLOAD))
+        .await
+        .unwrap();
+    assert_eq!(written, PAYLOAD.len());
+
+    let mut output = [0u8; 64];
+    let result = poll_fn(|cx| {
+        let mut read_buf = ReadBuf::new(&mut output);
+        Pin::new(&mut server).poll_read_decrypted(cx, &server_context, &mut read_buf)
+    })
+    .await;
+    assert!(result.is_err());
+    assert!(server.authenticated_user().is_none());
+}
