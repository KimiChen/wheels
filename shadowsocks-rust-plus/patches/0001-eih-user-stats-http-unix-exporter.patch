+        tokio::time::timeout(
+            Duration::from_secs(1),
+            hanging_busy_client.read_to_end(&mut hanging_response),
+        )
+        .await
+        .unwrap()
+        .unwrap();
+        let hanging_response = parse_response(hanging_response);
+        assert_eq!(hanging_response.status, 429);
+        assert_eq!(hanging_response.body, exporter::ERROR_BUSY);
+
+        let mut second_response = Vec::new();
+        tokio::time::timeout(
+            Duration::from_secs(1),
+            second_busy_client.read_to_end(&mut second_response),
+        )
+        .await
+        .unwrap()
+        .unwrap();
