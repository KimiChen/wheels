+
+    impl PrefixedStream {
+        fn new(head: Vec<u8>, stream: UnixStream) -> Self {
+            Self {
+                head,
+                position: 0,
+                stream,
+            }
+        }
+    }
+
+    impl AsyncRead for PrefixedStream {
+        fn poll_read(self: Pin<&mut Self>, cx: &mut Context<'_>, buffer: &mut ReadBuf<'_>) -> Poll<io::Result<()>> {
+            let this = self.get_mut();
+            if this.position < this.head.len() {
+                let available = &this.head[this.position..];
+                let count = available.len().min(buffer.remaining());
+                buffer.put_slice(&available[..count]);
+                this.position += count;
+                return Poll::Ready(Ok(()));
+            }
+            Pin::new(&mut this.stream).poll_read(cx, buffer)
+        }
+    }
+
+    impl AsyncWrite for PrefixedStream {
+        fn poll_write(self: Pin<&mut Self>, cx: &mut Context<'_>, bytes: &[u8]) -> Poll<io::Result<usize>> {
+            Pin::new(&mut self.get_mut().stream).poll_write(cx, bytes)
+        }
+
+        fn poll_flush(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Pin::new(&mut self.get_mut().stream).poll_flush(cx)
+        }
+
+        fn poll_shutdown(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+            Pin::new(&mut self.get_mut().stream).poll_shutdown(cx)
+        }
+
+        fn is_write_vectored(&self) -> bool {
+            self.stream.is_write_vectored()
+        }
+
+        fn poll_write_vectored(
+            self: Pin<&mut Self>,
+            cx: &mut Context<'_>,
+            buffers: &[io::IoSlice<'_>],
+        ) -> Poll<io::Result<usize>> {
+            Pin::new(&mut self.get_mut().stream).poll_write_vectored(cx, buffers)
+        }
+    }
+
+    type HttpResponse = Response<Full<Bytes>>;
+
+    fn json_response(status: StatusCode, body: Bytes) -> HttpResponse {
+        let content_length = body.len().to_string();
+        let mut response = Response::new(Full::new(body));
+        *response.status_mut() = status;
+        let headers = response.headers_mut();
+        headers.insert(CONTENT_TYPE, http::HeaderValue::from_static("application/json"));
+        headers.insert(CACHE_CONTROL, http::HeaderValue::from_static("no-store"));
+        headers.insert(CONNECTION, http::HeaderValue::from_static("close"));
+        headers.insert(
+            CONTENT_LENGTH,
+            http::HeaderValue::from_str(&content_length).expect("a decimal usize is a valid Content-Length"),
+        );
+        if status == StatusCode::METHOD_NOT_ALLOWED {
+            headers.insert(ALLOW, http::HeaderValue::from_static("GET"));
+        }
+        response
+    }
+
+    fn fixed_json_response(status: StatusCode, body: &'static [u8]) -> HttpResponse {
+        json_response(status, Bytes::from_static(body))
+    }
+
+    fn valid_host_value(value: &str) -> bool {
+        if value.is_empty() || value.contains('@') || value.contains(',') {
+            return false;
+        }
+        let Ok(authority) = value.parse::<Authority>() else {
+            return false;
+        };
+        let host = authority.host();
+        if host.is_empty() {
+            return false;
+        }
+
+        let suffix = &value[host.len()..];
+        suffix.is_empty()
+            || (suffix.starts_with(':') && suffix.len() > 1 && authority.port_u16().is_some())
+    }
+
+    fn request_has_one_valid_host(request: &Request<Incoming>) -> bool {
+        let mut hosts = request.headers().get_all(HOST).iter();
+        let Some(value) = hosts.next() else {
+            return false;
+        };
+        if hosts.next().is_some() {
+            return false;
+        }
+        let Ok(value) = value.to_str() else {
+            return false;
+        };
+        valid_host_value(value)
+    }
+
+    async fn route_request(
+        request: Request<Incoming>,
+        registry: Arc<UserStatsRegistry>,
+        max_response_bytes: usize,
+        client_permit: Arc<OwnedSemaphorePermit>,
+    ) -> Result<HttpResponse, Infallible> {
+        if request.version() != Version::HTTP_11 {
+            return Ok(fixed_json_response(
+                StatusCode::HTTP_VERSION_NOT_SUPPORTED,
+                ERROR_HTTP_VERSION_NOT_SUPPORTED,
+            ));
+        }
+
+        let uri = request.uri();
+        if uri.scheme().is_some()
+            || uri.authority().is_some()
+            || uri.query().is_some()
+            || !uri.path().starts_with('/')
+            || !request_has_one_valid_host(&request)
+            || request.headers().contains_key(CONTENT_LENGTH)
+            || request.headers().contains_key(TRANSFER_ENCODING)
+            || request.headers().contains_key(UPGRADE)
+        {
+            return Ok(fixed_json_response(StatusCode::BAD_REQUEST, ERROR_INVALID_REQUEST));
+        }
+
+        if request.method() != Method::GET {
+            return Ok(fixed_json_response(
+                StatusCode::METHOD_NOT_ALLOWED,
+                ERROR_METHOD_NOT_ALLOWED,
+            ));
+        }
+
+        match uri.path() {
+            "/healthz" => {
+                let (status, body) = if registry.is_healthy() {
+                    (StatusCode::OK, HEALTH_OK)
+                } else {
+                    (StatusCode::SERVICE_UNAVAILABLE, HEALTH_UNHEALTHY)
+                };
+                Ok(fixed_json_response(status, body))
+            }
+            "/v1/snapshot" => {
+                // A started blocking task cannot be force-cancelled. Keep the
+                // client permit in its result so a timed-out connection cannot
+                // free capacity while serialization is still running or its
+                // response buffer is still awaiting destruction.
+                let response = tokio::task::spawn_blocking(move || {
+                    let result = registry.serialize_snapshot_limited(max_response_bytes);
+                    (result, client_permit)
+                })
+                .await;
+                match response {
+                    Ok((Ok(body), _)) => Ok(json_response(StatusCode::OK, Bytes::from(body))),
+                    Ok((Err(SnapshotSerializeError::ResponseTooLarge(..)), _)) => Ok(fixed_json_response(
+                        StatusCode::INTERNAL_SERVER_ERROR,
+                        ERROR_RESPONSE_TOO_LARGE,
+                    )),
+                    Ok((Err(SnapshotSerializeError::Json(..)), _)) | Err(..) => {
+                        Ok(fixed_json_response(StatusCode::INTERNAL_SERVER_ERROR, ERROR_INTERNAL))
+                    }
+                }
+            }
+            _ => Ok(fixed_json_response(StatusCode::NOT_FOUND, ERROR_NOT_FOUND)),
+        }
+    }
+
+    async fn handle_client(
+        mut stream: UnixStream,
+        permit: OwnedSemaphorePermit,
+        registry: Arc<UserStatsRegistry>,
+        config: UserStatsConfig,
+    ) -> io::Result<()> {
+        let head = match time::timeout(
+            config.read_timeout,
+            read_request_head(&mut stream, config.max_request_bytes),
+        )
+        .await
+        {
+            Err(..) => {
+                write_direct_json(
+                    &mut stream,
+                    config.write_timeout,
+                    StatusCode::REQUEST_TIMEOUT,
+                    ERROR_READ_TIMEOUT,
+                )
+                .await;
+                return Ok(());
+            }
+            Ok(Err(ReadHeadError::TooLarge)) => {
+                write_direct_json(
+                    &mut stream,
+                    config.write_timeout,
+                    StatusCode::PAYLOAD_TOO_LARGE,
+                    ERROR_REQUEST_TOO_LARGE,
+                )
+                .await;
+                return Ok(());
+            }
+            Ok(Err(ReadHeadError::Invalid)) => {
+                write_direct_json(
+                    &mut stream,
+                    config.write_timeout,
+                    StatusCode::BAD_REQUEST,
+                    ERROR_INVALID_REQUEST,
+                )
+                .await;
+                return Ok(());
+            }
+            Ok(Err(ReadHeadError::UnsupportedVersion)) => {
+                write_direct_json(
+                    &mut stream,
+                    config.write_timeout,
+                    StatusCode::HTTP_VERSION_NOT_SUPPORTED,
+                    ERROR_HTTP_VERSION_NOT_SUPPORTED,
+                )
+                .await;
+                return Ok(());
+            }
+            Ok(Ok(head)) => head,
+        };
+
+        if let Err(error) = prevalidate_request_head(&head) {
+            let (status, body) = match error {
+                ReadHeadError::Invalid => (StatusCode::BAD_REQUEST, ERROR_INVALID_REQUEST),
+                ReadHeadError::TooLarge => (StatusCode::PAYLOAD_TOO_LARGE, ERROR_REQUEST_TOO_LARGE),
+                ReadHeadError::UnsupportedVersion => (
+                    StatusCode::HTTP_VERSION_NOT_SUPPORTED,
+                    ERROR_HTTP_VERSION_NOT_SUPPORTED,
+                ),
+            };
+            write_direct_json(&mut stream, config.write_timeout, status, body).await;
+            return Ok(());
+        }
+
+        let max_response_bytes = config.max_response_bytes;
+        let client_permit = Arc::new(permit);
+        let service = service_fn(move |request| {
+            route_request(request, registry.clone(), max_response_bytes, client_permit.clone())
+        });
+        let connection = http1::Builder::new()
+            .keep_alive(false)
+            .max_headers(MAX_HTTP_HEADERS)
+            .max_buf_size(USER_STATS_MAX_REQUEST_BYTES)
+            .serve_connection(TokioIo::new(PrefixedStream::new(head, stream)), service);
+
+        match time::timeout(config.write_timeout, connection).await {
+            Ok(Ok(())) => Ok(()),
+            Ok(Err(..)) => Err(io::Error::other("user statistics HTTP connection failed")),
+            Err(..) => Err(io::ErrorKind::TimedOut.into()),
+        }
+    }
+
+    fn direct_json_response(status: StatusCode, body: &[u8]) -> Vec<u8> {
+        let reason = status.canonical_reason().unwrap_or("Error");
+        let response_head = format!(
+            "HTTP/1.1 {} {}\r\nContent-Type: application/json\r\nCache-Control: no-store\r\nConnection: close\r\nContent-Length: {}\r\n\r\n",
+            status.as_u16(),
+            reason,
+            body.len()
+        );
+        let mut response = Vec::with_capacity(response_head.len() + body.len());
+        response.extend_from_slice(response_head.as_bytes());
+        response.extend_from_slice(body);
+        response
+    }
+
+    async fn write_direct_json(stream: &mut UnixStream, timeout: Duration, status: StatusCode, body: &[u8]) {
+        let response = direct_json_response(status, body);
+        let _ = time::timeout(timeout, async { stream.write_all(&response).await }).await;
+        let _ = stream.shutdown().await;
+    }
