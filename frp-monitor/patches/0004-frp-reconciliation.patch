new file mode 100644
--- /dev/null
+++ b/server/registry/monitor_test.go
@@ -0,0 +1,26 @@
+package registry
+
+import "testing"
+
+func TestMonitorSnapshotSkipsBusyAndOversize(t *testing.T) {
+	r := NewClientRegistry()
+	r.Register("team", "client", "run", "host", "v", "addr", "v2")
+	r.mu.Lock()
+	_, state := r.MonitorSnapshot(10)
+	r.mu.Unlock()
+	if state != "busy" {
+		t.Fatalf("busy registry: %s", state)
+	}
+	if _, state = r.MonitorSnapshot(0); state != "truncated" {
+		t.Fatalf("oversize registry: %s", state)
+	}
+	values, state := r.MonitorSnapshot(10)
+	if state != "ready" || len(values) != 1 || values[0].RawClientID != "client" {
+		t.Fatalf("snapshot: %#v %s", values, state)
+	}
+	values[0].User = "changed"
+	values, _ = r.MonitorSnapshot(10)
+	if values[0].User != "team" {
+		t.Fatal("snapshot aliased registry")
+	}
+}
