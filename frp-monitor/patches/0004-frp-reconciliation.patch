+// Copyright 2026 The frp Authors
+// Licensed under the Apache License, Version 2.0.
+package proxy
+
+// MonitorSnapshot only copies interface references under the registry lock.
+// Identity/config accessors return immutable lifecycle data after unlocking.
+func (pm *Manager) MonitorSnapshot(limit int) ([]Proxy, string) {
+	if !pm.mu.TryRLock() {
+		return nil, "busy"
+	}
+	defer pm.mu.RUnlock()
+	if len(pm.pxys) > limit {
+		return nil, "truncated"
+	}
+	out := make([]Proxy, 0, len(pm.pxys))
+	for _, p := range pm.pxys {
+		out = append(out, p)
+	}
+	return out, "ready"
+}
