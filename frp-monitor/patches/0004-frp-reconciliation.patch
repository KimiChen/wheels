--- /dev/null
+++ b/server/monitor_test.go
@@ -0,0 +1,40 @@
+package server
+
+import (
+	"encoding/json"
+	"github.com/fatedier/frp/extension/frpmonitor/shared"
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+	"github.com/fatedier/frp/server/proxy"
+	"github.com/fatedier/frp/server/registry"
+	"strings"
+	"testing"
+)
+
+func TestMonitorSnapshotIncludesNoProxyAndLegacyClients(t *testing.T) {
+	s := &Service{cfg: &v1.ServerConfig{}, clientRegistry: registry.NewClientRegistry(), pxyManager: proxy.NewManager()}
+	s.cfg.Monitor = shared.MonitorConfig{ServerID: "server"}
+	s.clientRegistry.Register("team", "stable", "secret-run-id", "host", "v", "addr", "v2")
+	s.clientRegistry.Register("team", "", "legacy-run-id", "legacy", "old", "old-addr", "v1")
+	snapshot := s.monitorSnapshot()
+	if snapshot.State != "ready" || len(snapshot.Clients) != 2 || snapshot.ServerID != "server" {
+		t.Fatalf("snapshot: %#v", snapshot)
+	}
+	stable, legacy := false, false
+	for _, c := range snapshot.Clients {
+		if c.RawClientID == nil {
+			legacy = c.ClientID == "legacy-run-id"
+		} else {
+			stable = *c.RawClientID == "stable" && c.ClientID == "stable"
+		}
+	}
+	if !stable || !legacy {
+		t.Fatal("client identity lost")
+	}
+	encoded, _ := json.Marshal(snapshot)
+	if strings.Contains(string(encoded), "secret-run-id") {
+		t.Fatal("stable client leaked session run ID")
+	}
+	if *monitorCounter(9007199254740993) != "9007199254740993" || monitorCounter(-1) != nil {
+		t.Fatal("unsafe numeric counter")
+	}
+}
