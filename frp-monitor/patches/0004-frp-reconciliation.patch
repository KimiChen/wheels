+// Copyright 2026 The frp Authors
+// Licensed under the Apache License, Version 2.0.
+package mem
+
+// MonitorSnapshot returns private scalar counters without blocking on a busy
+// collector. Copy only lifecycle data/references under the collector lock;
+// individual counters have their own locks and are read after releasing it.
+func MonitorSnapshot(limit int) ([]*ProxyStats, string) { return sm.monitorSnapshot(limit) }
+
+func (m *serverMetrics) monitorSnapshot(limit int) ([]*ProxyStats, string) {
+	if !m.mu.TryLock() {
+		return nil, "busy"
+	}
+	if len(m.info.ProxyStatistics) > limit {
+		m.mu.Unlock()
+		return nil, "truncated"
+	}
+	copies := make([]ProxyStatistics, 0, len(m.info.ProxyStatistics))
+	for _, p := range m.info.ProxyStatistics {
+		copies = append(copies, *p)
+	}
+	m.mu.Unlock()
+	out := make([]*ProxyStats, 0, len(copies))
+	for i := range copies {
+		out = append(out, toProxyStats(copies[i].Name, &copies[i]))
+	}
+	return out, "ready"
+}
diff --git a/server/monitor.go b/server/monitor.go
new file mode 100644
--- /dev/null
+++ b/server/monitor.go
@@ -0,0 +1,81 @@
+// Copyright 2026 The frp Authors
+// Licensed under the Apache License, Version 2.0.
+package server
+
+import (
+	"strconv"
+	"time"
+
+	"github.com/fatedier/frp/extension/frpmonitor/shared"
+	"github.com/fatedier/frp/pkg/metrics/mem"
+)
+
+// monitorSnapshot is a read-only private adapter. It never exposes native
+// authentication data, full configs, arbitrary metadata or plugin options.
+// Each native registry copy uses TryLock and has a hard size ceiling.
+func (svr *Service) monitorSnapshot() shared.ServerSnapshot {
+	out := shared.ServerSnapshot{State: "unavailable", ServerID: svr.cfg.Monitor.ServerID, GeneratedAt: time.Now().UTC(), TrafficScope: "server_local_day", Clients: []shared.ServerClient{}, Proxies: []shared.ServerProxy{}}
+	if svr.clientRegistry == nil || svr.pxyManager == nil {
+		return out
+	}
+	clients, state := svr.clientRegistry.MonitorSnapshot(4096)
+	if state != "ready" {
+		out.State = state
+		return out
+	}
+	proxies, state := svr.pxyManager.MonitorSnapshot(32768)
+	if state != "ready" {
+		out.State = state
+		return out
+	}
+	stats, state := mem.MonitorSnapshot(32768)
+	if state != "ready" {
+		out.State = state
+		return out
+	}
+	for _, c := range clients {
+		v := shared.ServerClient{User: c.User, ClientID: c.ClientID(), Hostname: c.Hostname, IP: c.IP, Version: c.Version, WireProtocol: c.WireProtocol, Online: c.Online}
+		if c.RawClientID != "" {
+			id := c.RawClientID
+			v.RawClientID = &id
+		}
+		out.Clients = append(out.Clients, v)
+	}
+	live := make(map[string]shared.ServerProxy, len(proxies))
+	for _, p := range proxies {
+		c := p.GetLoginMsg()
+		if c == nil {
+			continue
+		}
+		id := c.ClientID
+		if id == "" {
+			id = c.RunID
+		}
+		live[p.GetName()] = shared.ServerProxy{Name: p.GetName(), Type: p.GetConfigurer().GetBaseConfig().Type, User: c.User, ClientID: id, Online: true}
+	}
+	for _, p := range stats {
+		v := shared.ServerProxy{Name: p.Name, Type: p.Type, User: p.User, ClientID: p.ClientID, Connections: monitorCounter(p.CurConns), TodayRXBytes: monitorCounter(p.TodayTrafficIn), TodayTXBytes: monitorCounter(p.TodayTrafficOut)}
+		if current, ok := live[p.Name]; ok {
+			if current.User == p.User && current.ClientID == p.ClientID && current.Type == p.Type {
+				v.Online = true
+			} else {
+				v = current
+			}
+			delete(live, p.Name)
+		}
+		out.Proxies = append(out.Proxies, v)
+	}
+	for _, p := range live {
+		out.Proxies = append(out.Proxies, p)
+	}
+	out.State = "ready"
+	return out
+}
+
+func monitorCounter(n int64) *string {
+	if n < 0 {
+		return nil
+	}
+	v := strconv.FormatInt(n, 10)
+	return &v
+}
