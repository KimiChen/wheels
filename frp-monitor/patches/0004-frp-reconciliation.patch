@@ -0,0 +1,24 @@
+package mem
+
+import "testing"
+
+func TestMonitorSnapshotCountersAndNonblocking(t *testing.T) {
+	m := newServerMetrics()
+	m.NewProxy("monitor-test", "tcp", "team", "client")
+	m.AddTrafficIn("monitor-test", "tcp", 9007199254740993)
+	m.AddTrafficOut("monitor-test", "tcp", 42)
+	m.OpenConnection("monitor-test", "tcp")
+	m.mu.Lock()
+	_, state := m.monitorSnapshot(10)
+	m.mu.Unlock()
+	if state != "busy" {
+		t.Fatalf("busy collector: %s", state)
+	}
+	if _, state = m.monitorSnapshot(0); state != "truncated" {
+		t.Fatalf("oversize collector: %s", state)
+	}
+	values, state := m.monitorSnapshot(10)
+	if state != "ready" || len(values) != 1 || values[0].TodayTrafficIn != 9007199254740993 || values[0].TodayTrafficOut != 42 || values[0].CurConns != 1 {
+		t.Fatalf("snapshot: %#v %s", values, state)
+	}
+}
