@@ -0,0 +1,20 @@
+// Copyright 2026 The frp Authors
+// Licensed under the Apache License, Version 2.0.
+package registry
+
+// MonitorSnapshot skips busy or oversized registries rather than queuing
+// monitoring work behind native login/disconnect operations.
+func (cr *ClientRegistry) MonitorSnapshot(limit int) ([]ClientInfo, string) {
+	if !cr.mu.TryRLock() {
+		return nil, "busy"
+	}
+	defer cr.mu.RUnlock()
+	if len(cr.clients) > limit {
+		return nil, "truncated"
+	}
+	out := make([]ClientInfo, 0, len(cr.clients))
+	for _, c := range cr.clients {
+		out = append(out, *c)
+	}
+	return out, "ready"
+}
