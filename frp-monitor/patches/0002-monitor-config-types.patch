+//
+// frp-monitor：监控扩展配置的校验。新增文件。
+
+package validation
+
+import (
+	"fmt"
+	"net"
+	"net/url"
+	"strings"
+
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+)
+
+func validateAgentMonitorConfig(c *v1.AgentMonitorConfig) error {
+	if !c.Enable {
+		return nil
+	}
+	if c.ServerURL == "" {
+		return fmt.Errorf("monitor.serverURL 不能为空")
+	}
+	u, err := url.Parse(c.ServerURL)
+	if err != nil {
+		return fmt.Errorf("monitor.serverURL 非法：%v", err)
+	}
+	switch u.Scheme {
+	case "wss":
+	case "ws":
+		host := u.Hostname()
+		if ip := net.ParseIP(host); !(ip != nil && ip.IsLoopback()) &&
+			!strings.EqualFold(host, "localhost") {
+			return fmt.Errorf("monitor.serverURL 的 ws:// 仅允许回环地址，远程节点必须使用 wss://")
+		}
+	default:
+		return fmt.Errorf("monitor.serverURL 的 scheme 必须为 wss 或 ws")
+	}
+	if c.Token == "" {
+		return fmt.Errorf("monitor.token 不能为空")
+	}
+	if c.ReportIntervalSeconds < 0 || c.ReportIntervalSeconds > 3600 {
+		return fmt.Errorf("monitor.reportIntervalSeconds 越界 [0,3600]（0 为默认 1）：%d", c.ReportIntervalSeconds)
+	}
+	return nil
+}
+
+func validateServerMonitorConfig(c *v1.ServerMonitorConfig) error {
+	if !c.Enable {
+		return nil
+	}
+	addr := c.Addr
+	if addr == "" {
+		addr = "127.0.0.1:7400"
+	}
+	if _, _, err := net.SplitHostPort(addr); err != nil {
+		return fmt.Errorf("monitor.addr 非法：%v", err)
+	}
+	if c.CredentialsFile == "" {
+		return fmt.Errorf("monitor.credentialsFile 不能为空")
+	}
+	if c.AdminPasswordHash != "" {
+		if len(c.AdminPasswordHash) != 64 {
+			return fmt.Errorf("monitor.adminPasswordHash 应为 sha256 十六进制（64 字符）")
+		}
+		for _, r := range c.AdminPasswordHash {
+			if !('0' <= r && r <= '9' || 'a' <= r && r <= 'f') {
+				return fmt.Errorf("monitor.adminPasswordHash 只允许小写十六进制")
+			}
+		}
+	}
+	return nil
+}
