+//
+// frp-monitor：监控扩展的配置类型。新增文件，仅在 frpmonitor 构建标签下
+// 被生命周期钩子消费；原生构建解析后忽略 [monitor] 段。
+
+package v1
+
+// AgentMonitorConfig 为 frpc 的 [monitor] 段：节点监控上报配置。
+type AgentMonitorConfig struct {
+	// Enable 开启监控上报。默认 false。
+	Enable bool `json:"enable,omitempty"`
+	// ServerURL 为监控服务端 WSS 地址（如 wss://monitor.example.com/agent/v1/ws）。
+	// ws:// 仅允许回环地址（本地开发）。
+	ServerURL string `json:"serverURL,omitempty"`
+	// Token 为节点独立监控凭据，与 FRP 认证凭据分开。
+	// 建议使用环境变量引用，避免明文写入配置文件。
+	Token string `json:"token,omitempty"`
+	// ReportIntervalSeconds 为指标上报间隔秒数，范围 [1,3600]，默认 1。
+	ReportIntervalSeconds int `json:"reportIntervalSeconds,omitempty"`
+}
+
+// ServerMonitorConfig 为 frps 的 [monitor] 段：监控服务配置。
+type ServerMonitorConfig struct {
+	// Enable 开启监控服务。默认 false。
+	Enable bool `json:"enable,omitempty"`
+	// Addr 为独立监控 Listener 地址，默认 127.0.0.1:7400。
+	// 公开访问由 HTTPS 反向代理提供；与原 Dashboard/API 互不共用。
+	Addr string `json:"addr,omitempty"`
+	// CredentialsFile 为节点凭据文件（JSON，内容为 sha256 摘要）。
+	CredentialsFile string `json:"credentialsFile,omitempty"`
+	// AdminPasswordHash 为管理密码的 sha256 十六进制小写摘要；
+	// 为空时管理端（/admin/、/api/admin/、/events/admin）禁用。
+	AdminPasswordHash string `json:"adminPasswordHash,omitempty"`
+}
