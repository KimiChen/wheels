@@ -0,0 +1,51 @@
+package source
+
+import (
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+	"path/filepath"
+	"testing"
+)
+
+func TestMonitorProxiesPreservesEnabledPrecedenceAndClones(t *testing.T) {
+	disabled := false
+	entry := func(name string, port int, enabled *bool) v1.ProxyConfigurer {
+		return &v1.TCPProxyConfig{ProxyBaseConfig: v1.ProxyBaseConfig{Name: name, Type: "tcp", Enabled: enabled, ProxyBackend: v1.ProxyBackend{LocalPort: port}}}
+	}
+	cfg := NewConfigSource()
+	if err := cfg.ReplaceAll([]v1.ProxyConfigurer{entry("shared", 1001, nil), entry("disabled-only", 1002, &disabled)}, nil); err != nil {
+		t.Fatal(err)
+	}
+	store, err := NewStoreSource(StoreSourceConfig{Path: filepath.Join(t.TempDir(), "proxies.json")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := store.AddProxy(entry("shared", 2001, &disabled)); err != nil {
+		t.Fatal(err)
+	}
+	a := NewAggregator(cfg)
+	a.SetStoreSource(store)
+	check := func(want int) {
+		t.Helper()
+		p, err := a.MonitorProxies()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(p) != 2 || p[0].GetBaseConfig().Name != "disabled-only" || *p[0].GetBaseConfig().Enabled || p[1].GetBaseConfig().LocalPort != want {
+			t.Fatalf("bad merged snapshot: %+v", p)
+		}
+		p[1].GetBaseConfig().LocalPort = 9999
+	}
+	check(1001)
+	check(1001)
+	if err := store.UpdateProxy(entry("shared", 2001, nil)); err != nil {
+		t.Fatal(err)
+	}
+	check(2001)
+	native, _, err := a.Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(native) != 1 || native[0].GetBaseConfig().LocalPort != 2001 {
+		t.Fatal("monitoring changed native load")
+	}
+}
