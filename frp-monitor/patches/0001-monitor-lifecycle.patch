@@ -0,0 +1,52 @@
+package source
+
+import v1 "github.com/fatedier/frp/pkg/config/v1"
+
+// monitorAllProxies includes disabled entries and returns defensive copies.
+func (s *baseSource) monitorAllProxies() ([]v1.ProxyConfigurer, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	proxies := make([]v1.ProxyConfigurer, 0, len(s.proxies))
+	for _, p := range s.proxies {
+		proxies = append(proxies, p)
+	}
+	cloned, _, err := cloneConfigurers(proxies, nil)
+	return cloned, err
+}
+
+// MonitorProxies keeps native enabled-entry precedence and adds disabled-only names.
+// It does not change Load or any forwarding configuration.
+func (a *Aggregator) MonitorProxies() ([]v1.ProxyConfigurer, error) {
+	a.mu.RLock()
+	defer a.mu.RUnlock()
+	active := make(map[string]v1.ProxyConfigurer)
+	disabled := make(map[string]v1.ProxyConfigurer)
+	for _, src := range a.getSourcesLocked() {
+		var all []v1.ProxyConfigurer
+		var err error
+		switch s := src.(type) {
+		case *ConfigSource:
+			all, err = s.monitorAllProxies()
+		case *StoreSource:
+			all, err = s.monitorAllProxies()
+		}
+		if err != nil {
+			return nil, err
+		}
+		for _, p := range all {
+			b := p.GetBaseConfig()
+			if b.Enabled != nil && !*b.Enabled {
+				disabled[b.Name] = p
+			} else {
+				active[b.Name] = p
+			}
+		}
+	}
+	for name, p := range disabled {
+		if _, ok := active[name]; !ok {
+			active[name] = p
+		}
+	}
+	proxies, _ := a.mapsToSortedSlices(active, nil)
+	return proxies, nil
+}
