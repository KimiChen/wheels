@@ -0,0 +1,41 @@
+package client
+
+import (
+	"github.com/fatedier/frp/extension/frpmonitor/shared"
+	"github.com/fatedier/frp/pkg/config/source"
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+	"testing"
+)
+
+func TestMonitorSnapshotIncludesDisabledAndReloadedProxies(t *testing.T) {
+	disabled := false
+	p := &v1.TCPProxyConfig{ProxyBaseConfig: v1.ProxyBaseConfig{Name: "disabled", Type: "tcp", Enabled: &disabled, ProxyBackend: v1.ProxyBackend{LocalIP: "127.0.0.1", LocalPort: 8000}}}
+	src := source.NewConfigSource()
+	if err := src.ReplaceAll([]v1.ProxyConfigurer{p}, nil); err != nil {
+		t.Fatal(err)
+	}
+	common := &v1.ClientCommonConfig{ClientID: "stable-test-client", User: "test-user"}
+	svc, err := NewService(ServiceOptions{Common: common, ConfigSourceAggregator: source.NewAggregator(src)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	svc.common.Telemetry.ServerID = "test-server"
+	snap := svc.monitorSnapshot()
+	if snap.ControlState != "connecting" || len(snap.Proxies) != 1 || snap.Proxies[0].Enabled || snap.Proxies[0].Status != "disabled" {
+		t.Fatalf("unexpected snapshot: %+v", snap)
+	}
+	if err := (&shared.Extensions{FRP: &snap}).Validate(); err != nil {
+		t.Fatal(err)
+	}
+	p.Enabled = nil
+	if err := svc.UpdateConfigSource(common, []v1.ProxyConfigurer{p}, nil); err != nil {
+		t.Fatal(err)
+	}
+	next := svc.monitorSnapshot()
+	if !next.Proxies[0].Enabled || next.Proxies[0].Status != "unknown" {
+		t.Fatal("reload did not refresh effective snapshot")
+	}
+	if next.Association.User != "test-user" || *next.Association.RawClientID != "stable-test-client" {
+		t.Fatal("association changed")
+	}
+}
