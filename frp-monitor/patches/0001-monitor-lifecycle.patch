+// monitorSnapshot is the only adapter from native client internals to monitoring.
+// No config secrets, plugin options, remote endpoints or error messages cross it.
+func (svr *Service) monitorSnapshot() shared.FRP {
+	out := shared.FRP{
+		Association: shared.FRPAssociation{ServerID: svr.common.Telemetry.ServerID, User: svr.common.User},
+		Version:     version.Full(), ControlState: "connecting", Proxies: []shared.Proxy{},
+	}
+	if id := svr.common.ClientID; id != "" {
+		out.Association.RawClientID = &id
+	}
+	svr.ctlMu.RLock()
+	ctl := svr.ctl
+	svr.ctlMu.RUnlock()
+	connected := false
+	if ctl != nil {
+		select {
+		case <-ctl.Done():
+			out.ControlState = "disconnected"
+		default:
+			out.ControlState = "connected"
+			connected = true
+		}
+	}
+	svr.reloadMu.Lock()
+	aggregator := svr.aggregator
+	svr.cfgMu.RLock()
+	common := svr.reloadCommon
+	svr.cfgMu.RUnlock()
+	svr.reloadMu.Unlock()
+	if aggregator == nil {
+		return out
+	}
+	configs, err := aggregator.MonitorProxies()
+	if err != nil {
+		out.ControlState = "unknown"
+		return out
+	}
+	// One extra item makes the shared validator reject an oversized FRP section.
+	// The reporter can still send host metrics; never silently claim a partial list is complete.
+	if len(configs) > shared.MaxProxies+1 {
+		configs = configs[:shared.MaxProxies+1]
+	}
+	for _, cfg := range configs {
+		base := cfg.GetBaseConfig()
+		enabled := base.Enabled == nil || *base.Enabled
+		if len(common.Start) > 0 {
+			selected := false
+			for _, name := range common.Start {
+				if name == base.Name {
+					selected = true
+					break
+				}
+			}
+			enabled = enabled && selected
+		}
+		p := shared.Proxy{Name: base.Name, Type: base.Type, Enabled: enabled, Status: "unknown"}
+		if base.Plugin.ClientPluginOptions == nil && base.LocalPort > 0 {
+			ip := base.LocalIP
+			if ip == "" {
+				ip = "127.0.0.1"
+			}
+			target := net.JoinHostPort(ip, strconv.Itoa(base.LocalPort))
+			p.LocalTarget = &target
+		}
+		if !enabled {
+			p.Status = "disabled"
+		} else if connected {
+			if status, ok := ctl.pm.GetProxyStatus(base.Name); ok {
+				switch status.Phase {
+				case proxy.ProxyPhaseRunning:
+					p.Status = "running"
+				case proxy.ProxyPhaseNew, proxy.ProxyPhaseWaitStart:
+					p.Status = "starting"
+				case proxy.ProxyPhaseStartErr, proxy.ProxyPhaseCheckFailed:
+					p.Status = "error"
+				case proxy.ProxyPhaseClosed:
+					p.Status = "closed"
+				}
+			}
+		}
+		out.Proxies = append(out.Proxies, p)
+	}
+	return out
+}
