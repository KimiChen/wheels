+//
+// frp-monitor：server 生命周期钩子（frpmonitor 构建标签下的真实实现）。
+// 本文件在上游 server 包内做薄适配：读取 Registry 只读状态并交给扩展包，
+// 业务逻辑全部在 extension/frpmonitor/monitor/。
+
+//go:build frpmonitor
+
+package server
+
+import (
+	"context"
+
+	"github.com/fatedier/frp/pkg/util/log"
+
+	monitorservice "github.com/fatedier/frp/extension/frpmonitor/monitor/service"
+)
+
+// startFrpMonitor 在 server.Service.Run 起始处被调用。
+func (svr *Service) startFrpMonitor(ctx context.Context) {
+	// 局部 panic 边界：扩展启动失败不得影响 frps 主流程。
+	defer func() {
+		if r := recover(); r != nil {
+			log.Errorf("frp-monitor monitor 启动 panic（已隔离）：%v", r)
+		}
+	}()
+
+	cfg := svr.cfg.Monitor
+	if !cfg.Enable {
+		return
+	}
+	if err := monitorservice.Start(ctx, monitorservice.Config{
+		Enable:            true,
+		Addr:              cfg.Addr,
+		CredentialsFile:   cfg.CredentialsFile,
+		AdminPasswordHash: cfg.AdminPasswordHash,
+	}, frpRegistrySource{svr: svr}); err != nil {
+		// 监控启动失败只降级，不影响隧道。
+		log.Warnf("frp-monitor 监控服务启动失败，已降级（隧道不受影响）：%v", err)
+	}
+}
+
+// frpRegistrySource 实现 monitorservice.FRPRegistrySource。
+type frpRegistrySource struct {
+	svr *Service
+}
+
+func (s frpRegistrySource) ListClients() []monitorservice.FRPClientInfo {
+	infos := s.svr.clientRegistry.List()
+	out := make([]monitorservice.FRPClientInfo, 0, len(infos))
+	for _, info := range infos {
+		out = append(out, monitorservice.FRPClientInfo{
+			User:             info.User,
+			RawClientID:      info.RawClientID,
+			RunID:            info.RunID,
+			Version:          info.Version,
+			Online:           info.Online,
+			FirstConnectedAt: info.FirstConnectedAt.Unix(),
+			LastConnectedAt:  info.LastConnectedAt.Unix(),
+		})
+	}
+	return out
+}
