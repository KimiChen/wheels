diff --git a/server/monitor_shutdown_test.go b/server/monitor_shutdown_test.go
new file mode 100644
--- /dev/null
+++ b/server/monitor_shutdown_test.go
@@ -0,0 +1,37 @@
+package server
+
+import (
+	"context"
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+	"testing"
+	"time"
+)
+
+func TestMonitorContextCancellationStopsNativeListener(t *testing.T) {
+	cfg := &v1.ServerConfig{}
+	if err := cfg.Complete(); err != nil {
+		t.Fatal(err)
+	}
+	cfg.BindAddr = "127.0.0.1"
+	cfg.BindPort = 0
+	cfg.ProxyBindAddr = "127.0.0.1"
+	// Invalid runtime credential I/O also must not own the server lifecycle.
+	cfg.Monitor.Enabled = true
+	cfg.Monitor.BindAddr = "127.0.0.1"
+	cfg.Monitor.ServerID = "test"
+	cfg.Monitor.ReportIntervalSeconds = 1
+	cfg.Monitor.CredentialsFile = "missing-test-credentials"
+	service, err := NewService(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() { service.Run(ctx); close(done) }()
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("monitor server shutdown blocked")
+	}
+}
