# frp-monitor 本地准备、构建和测试目录。
# 复制为 .env 后按本机环境调整；.env 不得提交。
FRP_MONITOR_CACHE_DIR=.cache/frp-monitor
FRP_MONITOR_OUTPUT_DIR=dist

# 可选：使用本地镜像加速获取上游源码。留空时使用 upstream.lock 中的仓库。
FRP_MONITOR_UPSTREAM_MIRROR=

# 运行时 Token 不应直接写在本文件中。实现阶段只配置凭据文件路径，例如：
# FRP_MONITOR_REPORT_TOKEN_FILE=/path/to/report-token
