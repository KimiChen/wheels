# frp-monitor 本地准备、构建和测试目录（相对于本子项目根目录）。
# 可选复制为 .env；不设置时工具使用以下默认值，环境变量优先。
# 仅支持 KEY=VALUE 和单/双引号字面值，不执行 Shell、变量替换或命令。
FRP_MONITOR_CACHE_DIR=.cache
FRP_MONITOR_OUTPUT_DIR=dist

# 可选：使用本地镜像加速获取上游源码。留空时使用 upstream.lock 中的仓库。
FRP_MONITOR_UPSTREAM_MIRROR=

# scripts/local.py init 的本地演示默认值。仅生成回环配置；不影响已有安装。
FRP_MONITOR_PORT=17401
FRP_SERVER_PORT=17000
FRP_MONITOR_INTERVAL_SECONDS=1
FRP_AGENT_NAME="本地演示节点"
FRP_AGENT_IFACE=

# 初始化工具将分别随机生成 FRP 与监控凭据，保存在 ignored data/ 中的 0600 文件。
# 不在 .env 中保存明文 Token，也不把运行配置提交到公开 Git。
