# systemd 二进制构建目标；当前生产部署使用 linux/amd64。
BINARY_GOOS=linux
BINARY_GOARCH=amd64

# systemd 发布默认值。DATABASE_BACKUP_FILE 必须在每次发布时指向当次备份，
# 不要把真实服务器路径或任何凭据写入并提交。
SERVICE_NAME=sub2api
INSTALL_ROOT=/opt/sub2api
HEALTH_URL=http://127.0.0.1:8080/status
HEALTH_ATTEMPTS=30
HEALTH_INTERVAL=1
DATABASE_BACKUP_FILE=

# 可选 Docker 镜像名称；Docker 不是当前生产部署入口。
IMAGE_NAME=sub2api-plus:local

# 可选：Docker 目标平台，例如 linux/amd64。
DOCKER_PLATFORM=

# 设为 1 时，构建镜像前更新基础镜像。
DOCKER_PULL=0
