# frp-plus 本地准备、构建和测试目录（相对于本子项目根目录）。
# 可选复制为 .env；不设置时工具使用以下默认值，环境变量优先。
# 仅支持 KEY=VALUE 和单/双引号字面值，不执行 Shell、变量替换或命令。
FRP_MONITOR_CACHE_DIR=.cache
FRP_MONITOR_OUTPUT_DIR=dist

# 可选：使用本地镜像加速获取上游源码。留空时使用 upstream.lock 中的仓库。
FRP_MONITOR_UPSTREAM_MIRROR=

# local.py / ops.py 初始化默认值。local.py仅生成回环配置；不影响已有安装。
FRP_MONITOR_PORT=17401
FRP_SERVER_PORT=17000
FRP_MONITOR_INTERVAL_SECONDS=1
FRP_MONITOR_RETENTION_DAYS=7
# 留空关闭指标历史；填写 history 时初始化为运行目录内的 history/。
# 也可填写其他私有子目录，不接受目录穿越、符号链接或运行目录外部路径。
FRP_MONITOR_HISTORY_DATA_PATH=
FRP_AGENT_NAME="本地演示节点"
FRP_AGENT_IFACE=
# 仅影响新安装；启用后创建私有 managed/store.json 并关闭原生并行写入口。
# 当前写管理仍处开发验收阶段，仅在隔离测试节点使用。
FRP_CONFIG_MANAGEMENT_ENABLED=false

# 初始化工具将分别随机生成 FRP 与监控凭据，保存在 ignored data/ 中的 0600 文件。
# 不在 .env 中保存明文 Token，也不把运行配置提交到公开 Git。
# 配置和当前流量保存在 control.sqlite；可选内嵌 TSDB 默认关闭。
# TCP 探测需要 local.py init --probes 显式启用。

# 管理员只通过 github.com 登录；四项一起填写，留空时公开监控仍可运行。
# GitHub OAuth App 的 callback 必须与主控公开 HTTPS 地址完全一致，路径为：
# /api/admin/v1/auth/github/callback
# Secret 只填写受保护文件路径，原文件要求 0600；初始化复制为运行目录/github.secret。
# 管理员填 GitHub 登录名，以英文逗号分隔。
FRP_GITHUB_CLIENT_ID=
FRP_GITHUB_CLIENT_SECRET_FILE=
FRP_GITHUB_CALLBACK_URL=
FRP_GITHUB_ADMIN_USERS=
