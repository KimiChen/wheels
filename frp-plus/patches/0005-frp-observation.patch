new file mode 100644
index 0000000..93ac912
--- /dev/null
+++ b/client/visitor/monitor.go
@@ -0,0 +1,151 @@
+package visitor
+
+import (
+	"net"
+	"sync"
+	"sync/atomic"
+
+	"github.com/fatedier/frp/pkg/util/monitorstate"
+)
+
+type monitorObservation struct {
+	errors         monitorstate.Errors
+	active         atomic.Int64
+	attempts       atomic.Int64
+	everConnected  atomic.Bool
+	fallback       atomic.Int64
+	fallbackFailed atomic.Bool
+	localClosed    atomic.Bool
+	p2p            atomic.Int32 // 0 unknown, 1 connecting, 2 connected, 3 failed
+}
+
+type MonitorStatus struct {
+	LocalState, RemoteState, P2PState, FallbackState string
+	Error                                            *monitorstate.Error
+}
+
+func (v *BaseVisitor) monitorStatus() MonitorStatus {
+	s := MonitorStatus{RemoteState: "unknown", P2PState: "unknown", FallbackState: "unknown", Error: v.observation.errors.Snapshot()}
+	if v.observation.active.Load() > 0 {
+		s.RemoteState = "connected"
+	} else if v.observation.attempts.Load() > 0 {
+		s.RemoteState = "connecting"
+	} else if s.Error != nil && s.Error.RecoveredAt == "" {
+		s.RemoteState = "error"
+	} else if v.observation.everConnected.Load() {
+		s.RemoteState = "closed"
+	}
+	switch v.observation.p2p.Load() {
+	case 1:
+		s.P2PState = "connecting"
+	case 2:
+		s.P2PState = "connected"
+	case 3:
+		s.P2PState = "failed"
+	}
+	if v.observation.fallback.Load() > 0 {
+		s.FallbackState = "active"
+	} else if v.observation.fallbackFailed.Load() {
+		s.FallbackState = "failed"
+	}
+	if v.observation.localClosed.Load() {
+		s.LocalState = "closed"
+	}
+	return s
+}
+
+// Session liveness is inspected without opening a test stream or starting NAT
+// traversal. A previous successful handshake alone is not a current connection.
+func (v *XTCPVisitor) monitorStatus() MonitorStatus {
+	s := v.BaseVisitor.monitorStatus()
+	connected := false
+	switch session := v.session.(type) {
+	case *KCPTunnelSession:
+		if !session.mu.TryRLock() {
+			s.P2PState = "unknown"
+			return s
+		}
+		connected = session.session != nil && !session.session.IsClosed()
+		session.mu.RUnlock()
+	case *QUICTunnelSession:
+		if !session.mu.TryRLock() {
+			s.P2PState = "unknown"
+			return s
+		}
+		connected = session.session != nil && session.session.Context().Err() == nil
+		session.mu.RUnlock()
+	}
+	if connected {
+		s.P2PState = "connected"
+	} else if s.P2PState == "connected" {
+		s.P2PState = "failed"
+	}
+	return s
+}
+
+type monitorConn struct {
+	net.Conn
+	once sync.Once
+	done func()
+}
+
+func (c *monitorConn) Close() error { err := c.Conn.Close(); c.once.Do(c.done); return err }
+func (c *monitorConn) CloseWithError(reason error) error {
+	if inner, ok := c.Conn.(interface{ CloseWithError(error) error }); ok {
+		err := inner.CloseWithError(reason)
+		c.once.Do(c.done)
+		return err
+	}
+	return c.Close()
+}
+
+func (v *BaseVisitor) monitorConnection(c net.Conn) net.Conn {
+	v.observation.active.Add(1)
+	v.observation.everConnected.Store(true)
+	v.observation.errors.Recover()
+	return &monitorConn{Conn: c, done: func() { v.observation.active.Add(-1) }}
+}
+
+// MonitorSnapshot is read-only, bounded and never waits behind a visitor start.
+// A listening socket is not evidence of a successful remote connection.
+func (vm *Manager) MonitorSnapshot(limit int) (map[string]MonitorStatus, string) {
+	if !vm.mu.TryRLock() {
+		return nil, "busy"
+	}
+	defer vm.mu.RUnlock()
+	if len(vm.cfgs) > limit {
+		return nil, "truncated"
+	}
+	out := make(map[string]MonitorStatus, len(vm.cfgs))
+	for name, cfg := range vm.cfgs {
+		s := MonitorStatus{LocalState: "starting", RemoteState: "unknown", P2PState: "unknown", FallbackState: "unknown"}
+		if err := vm.monitorErrors[name]; err != nil {
+			s.LocalState = "error"
+			c := *err
+			s.Error = &c
+		}
+		if v, ok := vm.visitors[name].(interface{ monitorStatus() MonitorStatus }); ok {
+			s = v.monitorStatus()
+			if s.LocalState != "closed" {
+				s.LocalState = "configured"
+				if cfg.GetBaseConfig().BindPort > 0 {
+					s.LocalState = "listening"
+				}
+			}
+			if s.Error == nil {
+				if e := vm.monitorErrors[name]; e != nil {
+					c := *e
+					s.Error = &c
+				}
+			}
+		}
+		if vm.monitorClosed {
+			s.LocalState = "closed"
+			s.RemoteState = "closed"
+			s.P2PState = "unknown"
+			s.FallbackState = "unknown"
+		}
+		out[name] = s
+	}
+	return out, "ready"
+}
