@@ -0,0 +1,70 @@
+package source
+
+import (
+	"path/filepath"
+	"testing"
+
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+)
+
+func TestMonitorDetailPreservesPrecedenceOriginsAndVisitors(t *testing.T) {
+	disabled := false
+	p := &v1.TCPProxyConfig{ProxyBaseConfig: v1.ProxyBaseConfig{Name: "same", Type: "tcp"}, RemotePort: 1001}
+	v := &v1.STCPVisitorConfig{VisitorBaseConfig: v1.VisitorBaseConfig{Name: "visitor", Type: "stcp", Enabled: &disabled, ServerName: "private"}}
+	c := NewConfigSource()
+	if err := c.ReplaceAll([]v1.ProxyConfigurer{p}, []v1.VisitorConfigurer{v}); err != nil {
+		t.Fatal(err)
+	}
+	c.SetMonitorOrigins(map[string]string{"same": "include"}, map[string]string{"visitor": "file"})
+	store, err := NewStoreSource(StoreSourceConfig{Path: filepath.Join(t.TempDir(), "store.json")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	shadow := p.Clone()
+	shadow.GetBaseConfig().Enabled = &disabled
+	if err = store.AddProxy(shadow); err != nil {
+		t.Fatal(err)
+	}
+	a := NewAggregator(c)
+	a.SetStoreSource(store)
+	snapshot, state := a.MonitorDetail(10)
+	if state != "ready" || len(snapshot.Proxies) != 1 || len(snapshot.Visitors) != 1 {
+		t.Fatalf("incomplete snapshot: %#v %s", snapshot, state)
+	}
+	readAt := snapshot.ReadAt
+	if readAt.IsZero() {
+		t.Fatal("missing real source load/update time")
+	}
+	again, _ := a.MonitorDetail(10)
+	if !again.ReadAt.Equal(readAt) {
+		t.Fatal("sampling advanced source read time")
+	}
+	if snapshot.Proxies[0].Source != "include" || len(snapshot.Proxies[0].ShadowedSources) != 1 || snapshot.Proxies[0].ShadowedSources[0] != "store" || snapshot.Visitors[0].Source != "file" {
+		t.Fatal("disabled store changed native precedence or lost origin")
+	}
+	snapshot.Proxies[0].Config.GetBaseConfig().Name = "mutated"
+	native, _, err := a.Load()
+	if err != nil || native[0].GetBaseConfig().Name != "same" {
+		t.Fatal("monitor modified native configuration")
+	}
+	shadow.GetBaseConfig().Enabled = nil
+	if err = store.UpdateProxy(shadow); err != nil {
+		t.Fatal(err)
+	}
+	snapshot, state = a.MonitorDetail(10)
+	if state != "ready" || snapshot.Proxies[0].Source != "store" || snapshot.Proxies[0].ShadowedSources[0] != "include" {
+		t.Fatal("enabled store failed to win")
+	}
+	if snapshot.ReadAt.Before(readAt) {
+		t.Fatal("source update time moved backwards")
+	}
+	c.mu.Lock()
+	_, state = a.MonitorDetail(10)
+	c.mu.Unlock()
+	if state != "busy" {
+		t.Fatal("waited for busy source")
+	}
+	if _, state = a.MonitorDetail(1); state != "truncated" {
+		t.Fatal("oversized source was not rejected")
+	}
+}
