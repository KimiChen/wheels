@@ -0,0 +1,97 @@
+package visitor
+
+import (
+	"context"
+	"net"
+	"testing"
+
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+	"github.com/fatedier/frp/pkg/msg"
+)
+
+func TestVisitorMonitorListeningDoesNotClaimRemoteConnection(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	port := listener.Addr().(*net.TCPAddr).Port
+	cfg := &v1.STCPVisitorConfig{VisitorBaseConfig: v1.VisitorBaseConfig{Name: "test", Type: "stcp", ServerName: "remote", BindAddr: "127.0.0.1", BindPort: port}}
+	manager := NewManager(context.Background(), "run", &v1.ClientCommonConfig{}, nil, nil, nil)
+	defer manager.Close()
+	manager.UpdateAll([]v1.VisitorConfigurer{cfg})
+	values, state := manager.MonitorSnapshot(4)
+	if state != "ready" || values["test"].LocalState != "error" || values["test"].Error.Code != "listen_failed" || values["test"].Error.At == "" {
+		t.Fatalf("missing listen failure: %#v", values)
+	}
+	listener.Close()
+	manager.mu.Lock()
+	err = manager.startVisitor(cfg)
+	manager.mu.Unlock()
+	if err != nil {
+		t.Fatal(err)
+	}
+	values, _ = manager.MonitorSnapshot(4)
+	if values["test"].LocalState != "listening" || values["test"].RemoteState != "unknown" || values["test"].Error.RecoveredAt == "" {
+		t.Fatalf("listener fabricated remote state or lost recovery: %#v", values)
+	}
+	manager.mu.Lock()
+	_, state = manager.MonitorSnapshot(4)
+	manager.mu.Unlock()
+	if state != "busy" {
+		t.Fatal("monitor waits behind native lock")
+	}
+	if _, state = manager.MonitorSnapshot(0); state != "truncated" {
+		t.Fatal("missing bound")
+	}
+	manager.Close()
+	values, _ = manager.MonitorSnapshot(4)
+	if values["test"].LocalState != "closed" {
+		t.Fatal("closed visitor still listening")
+	}
+}
+
+func TestVisitorMonitorCountsActualConnectionLifetime(t *testing.T) {
+	v := &BaseVisitor{}
+	a, b := net.Pipe()
+	defer b.Close()
+	observed := v.monitorConnection(a)
+	if v.monitorStatus().RemoteState != "connected" {
+		t.Fatal("actual connection missing")
+	}
+	observed.Close()
+	observed.Close()
+	if v.monitorStatus().RemoteState != "closed" || v.observation.active.Load() != 0 {
+		t.Fatal("connection close not counted exactly once")
+	}
+	v.observation.errors.Fail("peer_failed", "visitor")
+	if v.monitorStatus().RemoteState != "error" {
+		t.Fatal("peer failure missing")
+	}
+}
+
+func TestVisitorMonitorPeerReplyDoesNotExportRawError(t *testing.T) {
+	a, b := net.Pipe()
+	defer a.Close()
+	defer b.Close()
+	server := msg.NewConn(b, msg.NewReadWriter(b, "v1"))
+	done := make(chan error, 1)
+	go func() {
+		if _, err := server.ReadMsg(); err != nil {
+			done <- err
+			return
+		}
+		done <- server.WriteMsg(&msg.NewVisitorConnResp{Error: "secretKey=do-not-export\n<script>"})
+	}()
+	base := &BaseVisitor{clientCfg: &v1.ClientCommonConfig{}, helper: &visitorHelperImpl{connectServerFn: func() (*msg.Conn, error) { return msg.NewConn(a, msg.NewReadWriter(a, "v1")), nil }}}
+	if _, err := base.dialRawVisitorConn(&v1.VisitorBaseConfig{ServerName: "missing"}); err == nil {
+		t.Fatal("expected server rejection")
+	}
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	s := base.monitorStatus()
+	if s.RemoteState != "error" || s.Error == nil || s.Error.Code != "peer_failed" || s.Error.At == "" {
+		t.Fatalf("missing classified event: %#v", s)
+	}
+}
