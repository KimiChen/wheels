diff --git a/server/monitor_detail.go b/server/monitor_detail.go
new file mode 100644
index 0000000..51ddcda
--- /dev/null
+++ b/server/monitor_detail.go
@@ -0,0 +1,73 @@
+package server
+
+import (
+	"github.com/fatedier/frp/extension/frpmonitor/shared"
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+)
+
+// Only live proxies are passed here: Manager.Add follows successful Run. TCP
+// and UDP Run replace RemotePort with the allocated port, including port zero.
+// ProxyBindAddr may be a wildcard/private address, never a public reachability
+// claim. Virtual-host endpoints use the actual server listener configuration.
+func (svr *Service) monitorEndpoints(cfg v1.ProxyConfigurer) ([]shared.FRPEndpoint, bool) {
+	out := []shared.FRPEndpoint{}
+	kind := cfg.GetBaseConfig().Type
+	port := 0
+	var domains []string
+	sub := ""
+	paths := []string{""}
+	switch c := cfg.(type) {
+	case *v1.TCPProxyConfig:
+		port = c.RemotePort
+		domains = []string{svr.cfg.ProxyBindAddr}
+	case *v1.UDPProxyConfig:
+		port = c.RemotePort
+		domains = []string{svr.cfg.ProxyBindAddr}
+	case *v1.HTTPProxyConfig:
+		port = svr.cfg.VhostHTTPPort
+		domains = c.CustomDomains
+		sub = c.SubDomain
+		if len(c.Locations) > 0 {
+			paths = c.Locations
+		}
+	case *v1.HTTPSProxyConfig:
+		port = svr.cfg.VhostHTTPSPort
+		domains = c.CustomDomains
+		sub = c.SubDomain
+	case *v1.TCPMuxProxyConfig:
+		port = svr.cfg.TCPMuxHTTPConnectPort
+		domains = c.CustomDomains
+		sub = c.SubDomain
+	default:
+		return []shared.FRPEndpoint{{Kind: "visitor", Source: "observed"}}, true
+	}
+	if port <= 0 || port > 65535 {
+		return out, true
+	}
+	appendHost := func(host string) bool {
+		if host == "" {
+			return true
+		}
+		for _, path := range paths {
+			p := uint16(port)
+			e := shared.FRPEndpoint{Kind: kind, Source: "observed", Host: host, Port: &p, Path: path}
+			if e.Validate() != nil {
+				return false
+			}
+			out = append(out, e)
+			if len(out) > shared.MaxDetailEndpoints {
+				return false
+			}
+		}
+		return true
+	}
+	for _, host := range domains {
+		if !appendHost(host) {
+			return nil, false
+		}
+	}
+	if sub != "" && !appendHost(sub+"."+svr.cfg.SubDomainHost) {
+		return nil, false
+	}
+	return out, true
+}
