+package config
+
+import (
+	"os"
+	"path/filepath"
+	"strconv"
+	"testing"
+)
+
+func TestLoadMonitorOriginsDistinguishesIncludes(t *testing.T) {
+	dir := t.TempDir()
+	included := filepath.Join(dir, "extra.toml")
+	main := filepath.Join(dir, "frpc.toml")
+	if err := os.WriteFile(included, []byte("[[proxies]]\nname='included'\ntype='tcp'\nlocalPort=8080\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	text := "includes=[" + strconv.Quote(included) + "]\n[[visitors]]\nname='main'\ntype='stcp'\nserverName='peer'\nbindPort=18000\n"
+	if err := os.WriteFile(main, []byte(text), 0600); err != nil {
+		t.Fatal(err)
+	}
+	result, err := LoadClientConfigResult(main, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.ProxyOrigins["included"] != "include" || result.VisitorOrigins["main"] != "file" {
+		t.Fatalf("origins not preserved: %#v %#v", result.ProxyOrigins, result.VisitorOrigins)
+	}
+}
