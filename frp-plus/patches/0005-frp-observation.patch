@@ -0,0 +1,38 @@
+package monitorstate
+
+import (
+	"sync"
+	"testing"
+)
+
+func TestErrorRecordsRecoveryWithoutRawText(t *testing.T) {
+	var e Errors
+	e.Fail("listen_failed", "visitor")
+	first := e.Snapshot()
+	e.Fail("listen_failed", "visitor")
+	if e.Snapshot().At != first.At {
+		t.Fatal("repeated error replaced first event time")
+	}
+	e.Recover()
+	next := e.Snapshot()
+	if next.RecoveredAt == "" || next.At != first.At {
+		t.Fatal("recovery did not preserve error event")
+	}
+	next.Code = "changed"
+	if e.Snapshot().Code != "listen_failed" {
+		t.Fatal("snapshot aliases state")
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				e.Fail("peer_failed", "visitor")
+				e.Recover()
+				_ = e.Snapshot()
+			}
+		}()
+	}
+	wg.Wait()
+}
