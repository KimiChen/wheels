diff --git a/pkg/util/monitorstate/error.go b/pkg/util/monitorstate/error.go
new file mode 100644
index 0000000..4141037
--- /dev/null
+++ b/pkg/util/monitorstate/error.go
@@ -0,0 +1,43 @@
+// Package monitorstate records fixed, credential-free lifecycle events.
+package monitorstate
+
+import (
+	"sync/atomic"
+	"time"
+)
+
+type Error struct{ Code, Stage, At, RecoveredAt string }
+type Errors struct{ current atomic.Pointer[Error] }
+
+func (e *Errors) Fail(code, stage string) {
+	for {
+		old := e.current.Load()
+		if old != nil && old.Code == code && old.Stage == stage && old.RecoveredAt == "" {
+			return
+		}
+		next := &Error{Code: code, Stage: stage, At: time.Now().UTC().Format(time.RFC3339Nano)}
+		if e.current.CompareAndSwap(old, next) {
+			return
+		}
+	}
+}
+func (e *Errors) Recover() {
+	for {
+		old := e.current.Load()
+		if old == nil || old.RecoveredAt != "" {
+			return
+		}
+		next := *old
+		next.RecoveredAt = time.Now().UTC().Format(time.RFC3339Nano)
+		if e.current.CompareAndSwap(old, &next) {
+			return
+		}
+	}
+}
+func (e *Errors) Snapshot() *Error {
+	if v := e.current.Load(); v != nil {
+		c := *v
+		return &c
+	}
+	return nil
+}
