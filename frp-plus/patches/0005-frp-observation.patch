diff --git a/pkg/config/source/monitor_detail.go b/pkg/config/source/monitor_detail.go
new file mode 100644
index 0000000..8eea336
--- /dev/null
+++ b/pkg/config/source/monitor_detail.go
@@ -0,0 +1,117 @@
+package source
+
+import (
+	"cmp"
+	"maps"
+	"slices"
+	"time"
+
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+)
+
+// MonitorEntry is a defensive, private configuration copy. Callers must project
+// an explicit field allowlist before crossing the monitoring boundary.
+type MonitorEntry[T any] struct {
+	Config          T
+	Source          string
+	ShadowedSources []string
+}
+
+type MonitorConfiguration struct {
+	ReadAt   time.Time `json:"-"`
+	Proxies  []MonitorEntry[v1.ProxyConfigurer]
+	Visitors []MonitorEntry[v1.VisitorConfigurer]
+	HasStore bool
+}
+
+func (s *ConfigSource) SetMonitorOrigins(proxies, visitors map[string]string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.monitorProxyOrigins = maps.Clone(proxies)
+	s.monitorVisitorOrigins = maps.Clone(visitors)
+}
+
+// MonitorDetail never waits behind a native mutation, never returns a partial
+// configuration and preserves native enabled-source precedence.
+func (a *Aggregator) MonitorDetail(limit int) (MonitorConfiguration, string) {
+	out := MonitorConfiguration{}
+	if !a.mu.TryRLock() {
+		return out, "busy"
+	}
+	defer a.mu.RUnlock()
+	proxies := make(map[string]MonitorEntry[v1.ProxyConfigurer])
+	visitors := make(map[string]MonitorEntry[v1.VisitorConfigurer])
+	count := 0
+	for _, src := range a.getSourcesLocked() {
+		var base *baseSource
+		var po, vo map[string]string
+		kind := "unknown"
+		switch s := src.(type) {
+		case *ConfigSource:
+			base = &s.baseSource
+			kind = "file"
+		case *StoreSource:
+			base = &s.baseSource
+			kind = "store"
+			out.HasStore = true
+		default:
+			return MonitorConfiguration{}, "unavailable"
+		}
+		if !base.mu.TryRLock() {
+			return MonitorConfiguration{}, "busy"
+		}
+		if s, ok := src.(*ConfigSource); ok {
+			po, vo = s.monitorProxyOrigins, s.monitorVisitorOrigins
+		}
+		if base.monitorReadAt.After(out.ReadAt) {
+			out.ReadAt = base.monitorReadAt
+		}
+		count += len(base.proxies) + len(base.visitors)
+		if count > limit {
+			base.mu.RUnlock()
+			return MonitorConfiguration{}, "truncated"
+		}
+		for name, p := range base.proxies {
+			origin := kind
+			if po[name] != "" {
+				origin = po[name]
+			}
+			next := MonitorEntry[v1.ProxyConfigurer]{Config: p.Clone(), Source: origin}
+			if old, ok := proxies[name]; ok {
+				if enabled(p.GetBaseConfig().Enabled) || !enabled(old.Config.GetBaseConfig().Enabled) {
+					next.ShadowedSources = append(slices.Clone(old.ShadowedSources), old.Source)
+				} else {
+					old.ShadowedSources = append(old.ShadowedSources, origin)
+					next = old
+				}
+			}
+			proxies[name] = next
+		}
+		for name, v := range base.visitors {
+			origin := kind
+			if vo[name] != "" {
+				origin = vo[name]
+			}
+			next := MonitorEntry[v1.VisitorConfigurer]{Config: v.Clone(), Source: origin}
+			if old, ok := visitors[name]; ok {
+				if enabled(v.GetBaseConfig().Enabled) || !enabled(old.Config.GetBaseConfig().Enabled) {
+					next.ShadowedSources = append(slices.Clone(old.ShadowedSources), old.Source)
+				} else {
+					old.ShadowedSources = append(old.ShadowedSources, origin)
+					next = old
+				}
+			}
+			visitors[name] = next
+		}
+		base.mu.RUnlock()
+	}
+	out.Proxies = slices.SortedFunc(maps.Values(proxies), func(a, b MonitorEntry[v1.ProxyConfigurer]) int {
+		return cmp.Compare(a.Config.GetBaseConfig().Name, b.Config.GetBaseConfig().Name)
+	})
+	out.Visitors = slices.SortedFunc(maps.Values(visitors), func(a, b MonitorEntry[v1.VisitorConfigurer]) int {
+		return cmp.Compare(a.Config.GetBaseConfig().Name, b.Config.GetBaseConfig().Name)
+	})
+	return out, "ready"
+}
+
+func enabled(v *bool) bool { return v == nil || *v }
