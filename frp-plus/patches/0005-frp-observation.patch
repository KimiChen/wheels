diff --git a/client/monitor_detail.go b/client/monitor_detail.go
new file mode 100644
index 0000000..1f7a883
--- /dev/null
+++ b/client/monitor_detail.go
@@ -0,0 +1,365 @@
+package client
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/fatedier/frp/client/proxy"
+	"github.com/fatedier/frp/client/visitor"
+	"github.com/fatedier/frp/extension/frpmonitor/shared"
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+	"github.com/fatedier/frp/pkg/util/monitorstate"
+)
+
+func (svr *Service) setMonitorControlError(code string) {
+	now := time.Now().UTC().Format(time.RFC3339Nano)
+	stage := "control"
+	if code == "login_failed" {
+		stage = "login"
+	}
+	old := svr.monitorControlError.Load()
+	if old != nil && old.Code == code && old.RecoveredAt == nil {
+		return
+	}
+	svr.monitorControlError.Store(&shared.FRPErrorDetail{Code: code, Stage: stage, At: &now})
+}
+
+func (svr *Service) recoverMonitorControlError() {
+	if old := svr.monitorControlError.Load(); old != nil && old.RecoveredAt == nil {
+		next := *old
+		now := time.Now().UTC().Format(time.RFC3339Nano)
+		next.RecoveredAt = &now
+		svr.monitorControlError.Store(&next)
+	}
+}
+
+func detailError(err *monitorstate.Error) *shared.FRPErrorDetail {
+	if err == nil {
+		return nil
+	}
+	out := &shared.FRPErrorDetail{Code: err.Code, Stage: err.Stage}
+	if err.At != "" {
+		at := err.At
+		out.At = &at
+	}
+	if err.RecoveredAt != "" {
+		at := err.RecoveredAt
+		out.RecoveredAt = &at
+	}
+	return out
+}
+
+func detailBool(v bool) *bool { return &v }
+func detailPort(v int) *uint16 {
+	if v < 0 || v > 65535 {
+		return nil
+	}
+	p := uint16(v)
+	return &p
+}
+func detailFailure(state string) shared.FRPDetail {
+	if state != "busy" && state != "truncated" {
+		state = "unavailable"
+	}
+	return shared.EmptyFRPDetail(state)
+}
+
+// monitorDetail is a separate allowlisted adapter. Raw config, errors, paths,
+// plugin options and credentials never cross the administrative boundary.
+func (svr *Service) monitorDetail() shared.FRPDetail {
+	if !svr.reloadMu.TryLock() {
+		return detailFailure("busy")
+	}
+	if !svr.cfgMu.TryRLock() {
+		svr.reloadMu.Unlock()
+		return detailFailure("busy")
+	}
+	common, reloadCommon, aggregator := svr.common, svr.reloadCommon, svr.aggregator
+	svr.cfgMu.RUnlock()
+	if common == nil || aggregator == nil {
+		svr.reloadMu.Unlock()
+		return detailFailure("unavailable")
+	}
+	config, state := aggregator.MonitorDetail(2 * (shared.MaxDetailProxies + shared.MaxDetailVisitors))
+	svr.reloadMu.Unlock()
+	if state != "ready" {
+		return detailFailure(state)
+	}
+	if len(config.Proxies) > shared.MaxDetailProxies || len(config.Visitors) > shared.MaxDetailVisitors {
+		return detailFailure("truncated")
+	}
+	if !svr.ctlMu.TryRLock() {
+		return detailFailure("busy")
+	}
+	ctl := svr.ctl
+	svr.ctlMu.RUnlock()
+	connected := false
+	if ctl != nil {
+		select {
+		case <-ctl.Done():
+		default:
+			connected = true
+		}
+	}
+	proxyStates := map[string]proxy.MonitorStatus{}
+	visitorStates := map[string]visitor.MonitorStatus{}
+	if connected {
+		proxyStates, state = ctl.pm.MonitorSnapshot(shared.MaxDetailProxies)
+		if state != "ready" {
+			return detailFailure(state)
+		}
+		visitorStates, state = ctl.vm.MonitorSnapshot(shared.MaxDetailVisitors)
+		if state != "ready" {
+			return detailFailure(state)
+		}
+	}
+	out := shared.EmptyFRPDetail("ready")
+	out.Association = shared.FRPAssociation{ServerID: common.Telemetry.ServerID, User: common.User}
+	if out.Association.ServerID == "" {
+		out.Association.ServerID = "default"
+	}
+	if common.ClientID != "" {
+		id := common.ClientID
+		out.Association.RawClientID = &id
+	}
+	id := sha256.Sum256([]byte(svr.configFilePath + "\x00" + common.User + "\x00" + common.ClientID + "\x00" + common.ServerAddr + ":" + strconv.Itoa(common.ServerPort)))
+	out.ServiceID = "svc-" + hex.EncodeToString(id[:16])
+	out.Transport = shared.FRPTransportDetail{Protocol: common.Transport.Protocol, WireProtocol: common.Transport.WireProtocol, Source: "configured", TLS: common.Transport.TLS.Enable, TCPMux: common.Transport.TCPMux}
+	if out.Transport.Protocol == "" {
+		out.Transport.Protocol = "unknown"
+	}
+	if out.Transport.WireProtocol == "" {
+		out.Transport.WireProtocol = "unknown"
+	}
+	if e := svr.monitorControlError.Load(); e != nil {
+		copy := *e
+		out.ControlError = &copy
+	}
+	out.Configuration = shared.FRPConfigurationDetail{Source: "file", SourceState: "active", NativeEntry: "file", Reloadable: detailBool(true)}
+	out.Configuration.DashboardEnabled = detailBool(common.WebServer.Port > 0)
+	if !config.ReadAt.IsZero() {
+		at := config.ReadAt.Format(time.RFC3339Nano)
+		out.Configuration.ReadAt = &at
+	}
+	if svr.configFilePath == "" {
+		out.Configuration.NativeEntry = "unavailable"
+		out.Configuration.Reloadable = detailBool(false)
+	}
+	if config.HasStore {
+		out.Configuration.Reloadable = detailBool(true)
+		out.Configuration.Source = "mixed"
+		out.Configuration.NativeEntry = "store"
+	}
+	// The digest is private and opaque, and includes secrets without returning them.
+	revisionInput := struct {
+		Config any
+		Start  []string
+	}{Config: config}
+	if reloadCommon != nil {
+		revisionInput.Start = reloadCommon.Start
+	}
+	if data, err := json.Marshal(revisionInput); err == nil {
+		sum := sha256.Sum256(data)
+		revision := hex.EncodeToString(sum[:])
+		out.Configuration.Revision = &revision
+	}
+	selected := func(name string, enabled *bool) bool {
+		return (enabled == nil || *enabled) && (reloadCommon == nil || len(reloadCommon.Start) == 0 || slices.Contains(reloadCommon.Start, name))
+	}
+	for _, entry := range config.Proxies {
+		cfg := entry.Config
+		base := cfg.GetBaseConfig()
+		p := shared.FRPProxyDetail{Name: base.Name, Type: base.Type, Source: entry.Source, SourceState: "active", ShadowedSources: detailShadowed(entry.ShadowedSources), Enabled: selected(base.Name, base.Enabled), Status: "unknown", Endpoints: detailConfiguredEndpoints(cfg, common.ServerAddr), Encryption: detailBool(base.Transport.UseEncryption), Compression: detailBool(base.Transport.UseCompression)}
+		if base.Plugin.Type != "" {
+			name := base.Plugin.Type
+			p.PluginType = &name
+		}
+		if base.Plugin.ClientPluginOptions == nil && base.LocalPort > 0 {
+			host := base.LocalIP
+			if host == "" {
+				host = "127.0.0.1"
+			}
+			target := net.JoinHostPort(host, strconv.Itoa(base.LocalPort))
+			p.LocalTarget = &target
+		}
+		if !p.Enabled {
+			p.Status = "disabled"
+		} else if status, ok := proxyStates[base.Name]; ok {
+			switch status.Phase {
+			case proxy.ProxyPhaseRunning:
+				p.Status = "running"
+			case proxy.ProxyPhaseNew, proxy.ProxyPhaseWaitStart:
+				p.Status = "starting"
+			case proxy.ProxyPhaseStartErr, proxy.ProxyPhaseCheckFailed:
+				p.Status = "error"
+			case proxy.ProxyPhaseClosed:
+				p.Status = "closed"
+			}
+			p.Error = detailError(status.Error)
+			if p.Status == "running" {
+				p.Endpoints = append(p.Endpoints, detailObservedEndpoints(base.Type, status.RemoteAddr, common.ServerAddr)...)
+			}
+		}
+		out.Proxies = append(out.Proxies, p)
+	}
+	for _, entry := range config.Visitors {
+		cfg := entry.Config
+		cfg.Complete()
+		base := cfg.GetBaseConfig()
+		v := shared.FRPVisitorDetail{Name: base.Name, Type: base.Type, Source: entry.Source, SourceState: "active", ShadowedSources: detailShadowed(entry.ShadowedSources), Enabled: selected(base.Name, base.Enabled), Status: "unknown", ServerUser: base.ServerUser, ServerName: base.ServerName, Protocol: out.Transport.Protocol, LocalState: "unknown", RemoteState: "unknown", P2PState: "unsupported", FallbackState: "disabled", Encryption: detailBool(base.Transport.UseEncryption), Compression: detailBool(base.Transport.UseCompression)}
+		if base.Plugin.Type != "" {
+			name := base.Plugin.Type
+			v.PluginType = &name
+		}
+		if v.ServerUser == "" {
+			v.ServerUser = common.User
+		}
+		if base.BindPort > 0 {
+			kind := "tcp"
+			if base.Type == "sudp" {
+				kind = "udp"
+			}
+			v.BindEndpoint = &shared.FRPEndpoint{Kind: kind, Source: "configured", Host: base.BindAddr, Port: detailPort(base.BindPort)}
+		}
+		if c, ok := cfg.(*v1.XTCPVisitorConfig); ok {
+			v.Protocol = c.Protocol
+			v.P2PState = "unknown"
+			if c.FallbackTo != "" {
+				fallback := c.FallbackTo
+				v.FallbackTo = &fallback
+				v.FallbackState = "available"
+			}
+		}
+		if !v.Enabled {
+			v.Status = "disabled"
+			v.LocalState = "disabled"
+		} else if status, ok := visitorStates[base.Name]; ok {
+			v.LocalState = status.LocalState
+			v.RemoteState = status.RemoteState
+			v.Error = detailError(status.Error)
+			if v.LocalState == "starting" {
+				v.LocalState = "unknown"
+				v.Status = "starting"
+			} else {
+				v.Status = v.LocalState
+			}
+			if v.LocalState == "listening" && v.BindEndpoint != nil {
+				v.BindEndpoint.Source = "observed"
+			}
+			if base.Type == "xtcp" {
+				v.P2PState = status.P2PState
+				if status.FallbackState != "unknown" {
+					v.FallbackState = status.FallbackState
+				}
+			}
+			if v.RemoteState == "connected" {
+				v.Status = "connected"
+			}
+		}
+		out.Visitors = append(out.Visitors, v)
+	}
+	if err := out.Validate(); err != nil {
+		if errors.Is(err, shared.ErrFRPDetailTooLarge) {
+			return detailFailure("truncated")
+		}
+		return detailFailure("unavailable")
+	}
+	return out
+}
+
+func detailShadowed(values []string) []string {
+	out := []string{}
+	for _, v := range values {
+		if (v == "file" || v == "include" || v == "store") && !slices.Contains(out, v) {
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+func detailConfiguredEndpoints(cfg v1.ProxyConfigurer, server string) []shared.FRPEndpoint {
+	out := []shared.FRPEndpoint{}
+	kind := cfg.GetBaseConfig().Type
+	var domains []string
+	var subdomain string
+	paths := []string{""}
+	switch c := cfg.(type) {
+	case *v1.TCPProxyConfig:
+		return []shared.FRPEndpoint{{Kind: kind, Source: "configured", Host: server, Port: detailPort(c.RemotePort)}}
+	case *v1.UDPProxyConfig:
+		return []shared.FRPEndpoint{{Kind: kind, Source: "configured", Host: server, Port: detailPort(c.RemotePort)}}
+	case *v1.HTTPProxyConfig:
+		domains, subdomain = c.CustomDomains, c.SubDomain
+		if len(c.Locations) > 0 {
+			paths = c.Locations
+		}
+	case *v1.HTTPSProxyConfig:
+		domains, subdomain = c.CustomDomains, c.SubDomain
+	case *v1.TCPMuxProxyConfig:
+		domains, subdomain = c.CustomDomains, c.SubDomain
+	default:
+		return []shared.FRPEndpoint{{Kind: "visitor", Source: "configured"}}
+	}
+	for _, host := range domains {
+		for _, path := range paths {
+			out = append(out, shared.FRPEndpoint{Kind: kind, Source: "configured", Host: host, Path: path})
+			if len(out) > shared.MaxDetailEndpoints {
+				return out
+			}
+		}
+	}
+	if subdomain != "" {
+		for _, path := range paths {
+			sub := subdomain
+			out = append(out, shared.FRPEndpoint{Kind: kind, Source: "configured", Subdomain: &sub, Path: path})
+			if len(out) > shared.MaxDetailEndpoints {
+				return out
+			}
+		}
+	}
+	return out
+}
+
+func detailObservedEndpoints(kind, remote, _ string) []shared.FRPEndpoint {
+	out := []shared.FRPEndpoint{}
+	if kind == "stcp" || kind == "sudp" || kind == "xtcp" {
+		return []shared.FRPEndpoint{{Kind: "visitor", Source: "observed"}}
+	}
+	for _, address := range strings.Split(remote, ",") {
+		if len(out) > shared.MaxDetailEndpoints {
+			return out
+		}
+		if address == "" {
+			continue
+		}
+		host, port, err := net.SplitHostPort(address)
+		if err != nil { // Native CanonicalAddr omits BOTH 80 and 443: port is unknown.
+			if kind == "tcp" || kind == "udp" {
+				continue
+			}
+			e := shared.FRPEndpoint{Kind: kind, Source: "observed", Host: address}
+			if e.Validate() == nil {
+				out = append(out, e)
+			}
+			continue
+		}
+		n, err := strconv.Atoi(port)
+		if err != nil || n <= 0 || n > 65535 {
+			continue
+		}
+		e := shared.FRPEndpoint{Kind: kind, Source: "observed", Host: host, Port: detailPort(n)}
+		if e.Validate() == nil && !slices.ContainsFunc(out, func(old shared.FRPEndpoint) bool {
+			return old.Kind == e.Kind && old.Host == e.Host && old.Port != nil && *old.Port == *e.Port
+		}) {
+			out = append(out, e)
+		}
+	}
+	return out
+}
diff --git a/client/monitor_detail_test.go b/client/monitor_detail_test.go
new file mode 100644
index 0000000..6ab6f2c
--- /dev/null
+++ b/client/monitor_detail_test.go
@@ -0,0 +1,86 @@
+package client
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/fatedier/frp/pkg/config/source"
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+)
+
+func TestMonitorDetailPrivateProjectionAndOrigins(t *testing.T) {
+	common := &v1.ClientCommonConfig{User: "team", ClientID: "stable", ServerAddr: "2001:db8::1"}
+	if err := common.Complete(); err != nil {
+		t.Fatal(err)
+	}
+	common.Auth.Token = "private-token-never-export"
+	p := &v1.HTTPProxyConfig{ProxyBaseConfig: v1.ProxyBaseConfig{Name: "web", Type: "http"}, DomainConfig: v1.DomainConfig{CustomDomains: []string{"example.invalid"}, SubDomain: "sub"}, HTTPPassword: "private-http-password", Locations: []string{"/app"}}
+	disabled := false
+	v := &v1.XTCPVisitorConfig{VisitorBaseConfig: v1.VisitorBaseConfig{Name: "private", Type: "xtcp", ServerName: "peer", SecretKey: "private-visitor-key", Enabled: &disabled, BindPort: -1}, FallbackTo: "backup"}
+	c := source.NewConfigSource()
+	if err := c.ReplaceAll([]v1.ProxyConfigurer{p}, []v1.VisitorConfigurer{v}); err != nil {
+		t.Fatal(err)
+	}
+	c.SetMonitorOrigins(map[string]string{"web": "include"}, map[string]string{"private": "file"})
+	svr, err := NewService(ServiceOptions{Common: common, ConfigSourceAggregator: source.NewAggregator(c)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	d := svr.monitorDetail()
+	if err = d.Validate(); err != nil {
+		t.Fatal(err)
+	}
+	if d.State != "ready" || len(d.Proxies) != 1 || len(d.Visitors) != 1 {
+		t.Fatalf("detail unavailable: %#v", d)
+	}
+	if d.Configuration.ReadAt == nil || d.Configuration.DashboardEnabled == nil || *d.Configuration.DashboardEnabled {
+		t.Fatal("missing source time or incorrect dashboard fact")
+	}
+	if d.Configuration.NativeEntry != "unavailable" || d.Configuration.Reloadable == nil || *d.Configuration.Reloadable {
+		t.Fatal("file-less service falsely offers native file reload")
+	}
+	if d.Proxies[0].Source != "include" || d.Proxies[0].Endpoints[1].Subdomain == nil || d.Proxies[0].Endpoints[1].Host != "" {
+		t.Fatal("invented subdomain hostname or lost include origin")
+	}
+	if d.Visitors[0].Status != "disabled" || d.Visitors[0].BindEndpoint != nil || d.Visitors[0].RemoteState != "unknown" {
+		t.Fatal("disabled/non-listening visitor projected incorrectly")
+	}
+	data, _ := json.Marshal(d)
+	for _, secret := range []string{common.Auth.Token, p.HTTPPassword, v.SecretKey} {
+		if strings.Contains(string(data), secret) {
+			t.Fatal("secret crossed detail projection")
+		}
+	}
+	svr.reloadMu.Lock()
+	busy := svr.monitorDetail()
+	svr.reloadMu.Unlock()
+	if busy.State != "busy" || len(busy.Proxies) != 0 || len(busy.Visitors) != 0 {
+		t.Fatal("busy detail lost lock state or claims completeness")
+	}
+	if err := busy.Validate(); err != nil {
+		t.Fatalf("busy detail violates wire contract: %v", err)
+	}
+	svr.setMonitorControlError("login_failed")
+	svr.recoverMonitorControlError()
+	d = svr.monitorDetail()
+	if d.ControlError == nil || d.ControlError.RecoveredAt == nil {
+		t.Fatal("missing login error recovery")
+	}
+}
+
+func TestMonitorEndpointDistinguishesDynamicAndUnknownPorts(t *testing.T) {
+	p := &v1.TCPProxyConfig{ProxyBaseConfig: v1.ProxyBaseConfig{Type: "tcp"}, RemotePort: 0}
+	configured := detailConfiguredEndpoints(p, "2001:db8::1")
+	if configured[0].Port == nil || *configured[0].Port != 0 {
+		t.Fatal("lost dynamic requested port")
+	}
+	observed := detailObservedEndpoints("tcp", ":12345", "2001:db8::1")
+	if len(observed) != 1 || observed[0].Host != "" || *observed[0].Port != 12345 {
+		t.Fatal("invented an observed public hostname")
+	}
+	observed = detailObservedEndpoints("https", "example.invalid", "control.invalid")
+	if len(observed) != 1 || observed[0].Port != nil {
+		t.Fatal("invented an omitted native port")
+	}
+}
diff --git a/client/proxy/monitor.go b/client/proxy/monitor.go
new file mode 100644
index 0000000..063b34b
--- /dev/null
+++ b/client/proxy/monitor.go
@@ -0,0 +1,27 @@
+package proxy
+
+import "github.com/fatedier/frp/pkg/util/monitorstate"
+
+type MonitorStatus struct {
+	Phase, RemoteAddr string
+	Error             *monitorstate.Error
+}
+
+func (pm *Manager) MonitorSnapshot(limit int) (map[string]MonitorStatus, string) {
+	if !pm.mu.TryRLock() {
+		return nil, "busy"
+	}
+	defer pm.mu.RUnlock()
+	if len(pm.proxies) > limit {
+		return nil, "truncated"
+	}
+	out := make(map[string]MonitorStatus, len(pm.proxies))
+	for name, p := range pm.proxies {
+		if !p.mu.TryRLock() {
+			return nil, "busy"
+		}
+		out[name] = MonitorStatus{Phase: p.Phase, RemoteAddr: p.RemoteAddr, Error: p.monitorErrors.Snapshot()}
+		p.mu.RUnlock()
+	}
+	return out, "ready"
+}
diff --git a/client/proxy/monitor_test.go b/client/proxy/monitor_test.go
new file mode 100644
index 0000000..b55fd88
--- /dev/null
+++ b/client/proxy/monitor_test.go
@@ -0,0 +1,35 @@
+package proxy
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestProxyMonitorSnapshotUsesFixedCodesAndSkipsBusyLocks(t *testing.T) {
+	p := &Wrapper{WorkingStatus: WorkingStatus{Name: "test", Phase: ProxyPhaseStartErr, Err: "secretKey=private\n<script>"}}
+	p.monitorErrors.Fail("register_failed", "proxy")
+	pm := &Manager{proxies: map[string]*Wrapper{"test": p}}
+	values, state := pm.MonitorSnapshot(1)
+	if state != "ready" || values["test"].Error.Code != "register_failed" {
+		t.Fatal("missing registration error")
+	}
+	data, _ := json.Marshal(values)
+	if strings.Contains(string(data), "private") || strings.Contains(string(data), "script") {
+		t.Fatal("raw native error was exported")
+	}
+	p.mu.Lock()
+	_, state = pm.MonitorSnapshot(1)
+	p.mu.Unlock()
+	if state != "busy" {
+		t.Fatal("waited behind proxy mutation")
+	}
+	if _, state = pm.MonitorSnapshot(0); state != "truncated" {
+		t.Fatal("missing snapshot bound")
+	}
+	p.monitorErrors.Recover()
+	values, _ = pm.MonitorSnapshot(1)
+	if values["test"].Error.RecoveredAt == "" {
+		t.Fatal("recovered error is still current")
+	}
+}
diff --git a/client/proxy/proxy_wrapper.go b/client/proxy/proxy_wrapper.go
index 37a7127..ba78d6a 100644
