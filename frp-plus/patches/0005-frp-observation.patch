+package server
+
+import (
+	"testing"
+
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+)
+
+func TestMonitorEndpointsUseServerListenerFacts(t *testing.T) {
+	s := &Service{cfg: &v1.ServerConfig{ProxyBindAddr: "::", VhostHTTPPort: 8080, SubDomainHost: "example.invalid"}}
+	e, ok := s.monitorEndpoints(&v1.TCPProxyConfig{ProxyBaseConfig: v1.ProxyBaseConfig{Type: "tcp"}, RemotePort: 12345})
+	if !ok || len(e) != 1 || e[0].Host != "::" || *e[0].Port != 12345 || e[0].Source != "observed" {
+		t.Fatal("actual listener lost")
+	}
+	e, ok = s.monitorEndpoints(&v1.HTTPProxyConfig{ProxyBaseConfig: v1.ProxyBaseConfig{Type: "http"}, DomainConfig: v1.DomainConfig{CustomDomains: []string{"first.invalid"}, SubDomain: "app"}, Locations: []string{"/v1", "/v2"}})
+	if !ok || len(e) != 4 || e[3].Host != "app.example.invalid" || e[3].Path != "/v2" || *e[3].Port != 8080 {
+		t.Fatalf("incorrect registered vhost routes: %#v", e)
+	}
+	e, ok = s.monitorEndpoints(&v1.STCPProxyConfig{ProxyBaseConfig: v1.ProxyBaseConfig{Type: "stcp"}})
+	if !ok || len(e) != 1 || e[0].Kind != "visitor" || e[0].Host != "" || e[0].Port != nil {
+		t.Fatal("private proxy fabricated public endpoint")
+	}
+}
