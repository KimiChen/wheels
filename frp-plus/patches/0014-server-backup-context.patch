@@ -0,0 +1,22 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"strings"
+	"testing"
+)
+
+func TestServerMaintenanceFixedFailure(t *testing.T) {
+	cmd := newServerMaintenanceCommand(func() string { return "/private/server.toml" })
+	var output bytes.Buffer
+	cmd.SetOut(&output)
+	cmd.SetErr(&output)
+	cmd.SetArgs([]string{"capture", "--offline", "--policy", "/private/not-a-real-policy", "--output", "/private/not-a-real-output"})
+	if err := cmd.ExecuteContext(context.Background()); err == nil {
+		t.Fatal("missing policy accepted")
+	}
+	if strings.Contains(output.String(), "/private/") || output.String() != "server_backup_policy_invalid\n" {
+		t.Fatal("CLI leaked paths or non-fixed diagnostics")
+	}
+}
