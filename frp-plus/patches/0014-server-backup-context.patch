+package main
+
+import (
+	"context"
+	"fmt"
+	"github.com/fatedier/frp/extension/frpmonitor/monitor/serverbackup"
+	"github.com/spf13/cobra"
+	"time"
+)
+
+func init() { rootCmd.AddCommand(newServerMaintenanceCommand(func() string { return cfgFile })) }
+func newServerMaintenanceCommand(configFile func() string) *cobra.Command {
+	parent := &cobra.Command{Use: "server-maintenance", Short: "Offline private server backup context", SilenceUsage: true, SilenceErrors: true}
+	for _, action := range []string{"capture", "transform"} {
+		request := serverbackup.CLIRequest{Action: action}
+		command := &cobra.Command{Use: action, SilenceUsage: true, SilenceErrors: true, Args: func(_ *cobra.Command, args []string) error {
+			if len(args) != 0 {
+				return fmt.Errorf("server_backup_arguments_invalid")
+			}
+			return nil
+		}, RunE: func(cmd *cobra.Command, _ []string) error {
+			request.ConfigFile = configFile()
+			ctx, cancel := context.WithTimeout(cmd.Context(), 60*time.Second)
+			defer cancel()
+			summary, err := serverbackup.RunCLI(ctx, request)
+			if err != nil {
+				fmt.Fprintln(cmd.ErrOrStderr(), err.Error())
+				return err
+			}
+			_, err = cmd.OutOrStdout().Write(serverbackup.MarshalSummary(summary))
+			return err
+		}}
+		command.Flags().BoolVar(&request.Offline, "offline", false, "Acknowledge that the server is stopped")
+		command.Flags().StringVar(&request.PolicyFile, "policy", "", "Private local path authorization JSON")
+		command.Flags().StringVar(&request.EnvFile, "env-file", "", "Private explicit template environment JSON")
+		command.Flags().StringVar(&request.Output, "output", "", "New private context output directory")
+		if action == "transform" {
+			command.Flags().StringVar(&request.SourcePolicyFile, "source-policy", "", "Private source path authorization JSON")
+			command.Flags().StringVar(&request.SourceEnvFile, "source-env-file", "", "Private source template environment JSON")
+			command.Flags().StringVar(&request.Checkpoint, "checkpoint", "", "Sealed source context directory")
+			command.Flags().StringVar(&request.ManifestDigest, "manifest-digest", "", "Expected CONTEXT.json SHA-256")
+		}
+		parent.AddCommand(command)
+	}
+	return parent
+}
