+func TestManagedProxyDistinguishesRejectedAttemptFromWaiting(t *testing.T) {
+	cfg := &v1.TCPProxyConfig{ProxyBaseConfig: v1.ProxyBaseConfig{Name: "p", Type: "tcp"}}
+	p := &Wrapper{WorkingStatus: WorkingStatus{Name: "p", Cfg: cfg}}
+	pm := &Manager{proxies: map[string]*Wrapper{"p": p}}
+	for _, test := range []struct {
+		phase, message string
+		rejected       bool
+	}{
+		{ProxyPhaseNew, "", false}, {ProxyPhaseWaitStart, "previous failure", false}, {ProxyPhaseCheckFailed, "health check failed", false}, {ProxyPhaseRunning, "previous failure", false}, {ProxyPhaseStartErr, "", false}, {ProxyPhaseStartErr, "server rejected this attempt", true},
+	} {
+		p.Phase, p.Err = test.phase, test.message
+		state := pm.ManagedSnapshotState()
+		if !state.Available || state.AttemptRejected != test.rejected {
+			t.Fatal("waiting and rejected registration were conflated")
+		}
+	}
+	p.mu.Lock()
+	state := pm.ManagedSnapshotState()
+	p.mu.Unlock()
+	if state.Available || state.AttemptRejected {
+		t.Fatal("lock contention became registration rejection")
+	}
+	pm.closed = true
+	state = pm.ManagedSnapshotState()
+	if state.Ready || state.AttemptRejected {
+		t.Fatal("closed manager became registration rejection")
+	}
+}
