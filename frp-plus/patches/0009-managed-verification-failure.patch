+		t.Fatal(err)
+	}
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	data, _ := json.Marshal(map[string]any{"proxies": []any{}, "visitors": []any{map[string]any{"name": "v", "type": "stcp", "serverName": "peer", "bindAddr": "127.0.0.1", "bindPort": listener.Addr().(*net.TCPAddr).Port}}})
