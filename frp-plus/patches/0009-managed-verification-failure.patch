+		t.Fatal(err)
+	}
+	if err = s.managedApply(ctx, desired); err != nil {
+		t.Fatal(err)
+	}
+	pm := proxy.NewManager(ctx, s.common, nil, nil, nil, "")
+	vm := visitor.NewManager(ctx, "run", s.common, nil, nil, nil)
+	defer pm.Close()
+	defer vm.Close()
+	done := make(chan struct{})
+	s.ctl = &Control{ctx: ctx, pm: pm, vm: vm, doneCh: done}
+	vm.UpdateAll(s.visitorCfgs)
+	result, err := s.managedVerifyOnce(desired)
+	if !errors.Is(err, managed.ErrRuntime) || !result.RuntimeLoaded || result.ResourcesReady {
+		t.Fatal("definite local startup failure was treated as waiting")
+	}
+	close(done)
+	result, err = s.managedVerifyOnce(desired)
+	if err != nil || result.ResourcesReady {
+		t.Fatal("closed control reused an old local failure")
+	}
