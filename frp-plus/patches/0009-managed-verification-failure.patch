+func TestManagedVisitorRejectsOnlyCurrentLocalStartupFailure(t *testing.T) {
+	cfg := &v1.STCPVisitorConfig{VisitorBaseConfig: v1.VisitorBaseConfig{Name: "v", Type: "stcp", ServerName: "peer", BindAddr: "127.0.0.1", BindPort: -1}}
+	vm := NewManager(context.Background(), "run", &v1.ClientCommonConfig{}, nil, nil, nil)
+	defer vm.Close()
+	vm.cfgs = map[string]v1.VisitorConfigurer{"v": cfg}
+	vm.monitorErrors = map[string]*monitorstate.Error{"v": {Code: "listen_failed", Stage: "visitor", At: "now"}}
+	state := vm.ManagedSnapshotState()
+	if !state.Available || state.Ready || !state.AttemptRejected {
+		t.Fatal("actual local startup failure was not rejected")
+	}
+	vm.monitorErrors["v"].RecoveredAt = "recovered"
+	state = vm.ManagedSnapshotState()
+	if state.AttemptRejected {
+		t.Fatal("historical local failure rejected current config")
+	}
+	vm.monitorErrors["v"] = &monitorstate.Error{Code: "peer_failed", Stage: "visitor", At: "now"}
+	state = vm.ManagedSnapshotState()
+	if state.AttemptRejected {
+		t.Fatal("remote failure became local startup rejection")
+	}
+	vm.mu.Lock()
+	err := vm.startVisitor(cfg)
+	vm.mu.Unlock()
+	if err != nil {
+		t.Fatal(err)
+	}
+	v := vm.visitors["v"].(*STCPVisitor)
+	v.observation.errors.Fail("peer_failed", "visitor")
+	v.observation.fallbackFailed.Store(true)
+	state = vm.ManagedSnapshotState()
+	if !state.Ready || state.AttemptRejected {
+		t.Fatal("remote/fallback uncertainty invalidated local listener")
+	}
+	vm.mu.Lock()
+	state = vm.ManagedSnapshotState()
+	vm.mu.Unlock()
+	if state.Available || state.AttemptRejected {
+		t.Fatal("busy visitor became startup rejection")
+	}
+	vm.Close()
+	state = vm.ManagedSnapshotState()
+	if state.Ready || state.AttemptRejected {
+		t.Fatal("closed visitor manager became startup rejection")
+	}
+}
