@@ -0,0 +1,39 @@
+package visitor
+
+import v1 "github.com/fatedier/frp/pkg/config/v1"
+
+// ManagedSnapshot includes failed/pending configurations and verifies existing
+// listeners or the internal-only negative bind-port mode. Remote sessions are
+// deliberately not required or opened as a side effect of verification.
+func (vm *Manager) ManagedSnapshot() ([]v1.VisitorConfigurer, bool, bool) {
+	if !vm.mu.TryRLock() {
+		return nil, false, false
+	}
+	defer vm.mu.RUnlock()
+	out := make([]v1.VisitorConfigurer, 0, len(vm.cfgs))
+	ready := !vm.monitorClosed && len(vm.visitors) == len(vm.cfgs)
+	for name, cfg := range vm.cfgs {
+		out = append(out, cfg.Clone())
+		v := vm.visitors[name]
+		local := false
+		switch typed := v.(type) {
+		case *STCPVisitor:
+			local = managedLocalReady(typed.BaseVisitor, cfg.GetBaseConfig().BindPort)
+		case *XTCPVisitor:
+			local = managedLocalReady(typed.BaseVisitor, cfg.GetBaseConfig().BindPort)
+		case *SUDPVisitor:
+			local = typed.udpConn != nil && !typed.observation.localClosed.Load()
+		}
+		ready = ready && local
+	}
+	return out, ready, true
+}
+func managedLocalReady(v *BaseVisitor, port int) bool {
+	if v == nil || v.observation.localClosed.Load() {
+		return false
+	}
+	if port > 0 {
+		return v.l != nil
+	}
+	return port < 0 && v.internalLn != nil
+}
