+	"github.com/fatedier/frp/extension/frpmonitor/agent/configuration"
+	"github.com/fatedier/frp/extension/frpmonitor/agent/managed"
+	"github.com/fatedier/frp/extension/frpmonitor/shared"
+	"github.com/fatedier/frp/pkg/config"
+	"github.com/fatedier/frp/pkg/config/source"
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+	"github.com/fatedier/frp/pkg/policy/security"
+)
+
+func managedFixture(t *testing.T) *Service {
+	t.Helper()
+	dir, err := filepath.EvalSymlinks(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Chmod(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	storePath := filepath.Join(dir, "store.json")
+	file := filepath.Join(dir, "frpc.json")
+	data, _ := json.Marshal(map[string]any{"serverAddr": "127.0.0.1", "store": map[string]any{"path": storePath}})
+	if err = os.WriteFile(file, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(storePath, []byte(`{"proxies":[],"visitors":[]}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	result, err := config.LoadClientConfigResult(file, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fs := source.NewConfigSource()
+	if err = fs.ReplaceAll(result.Proxies, result.Visitors); err != nil {
+		t.Fatal(err)
+	}
+	fs.ClaimManaged()
+	ss, err := source.NewStoreSource(source.StoreSourceConfig{Path: storePath, Managed: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	engine, err := managed.Open(managed.Options{Root: dir, StorePath: storePath})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { engine.Close() })
+	agg := source.NewAggregator(fs)
+	agg.SetStoreSource(ss)
+	return &Service{ctx: context.Background(), common: result.Common, reloadCommon: result.Common, configFilePath: file, configSource: fs, storeSource: ss, aggregator: agg, managedEngine: engine, unsafeFeatures: security.NewUnsafeFeatures(nil)}
+}
+func managedBase(t *testing.T, s *Service) managed.Operation {
+	t.Helper()
+	in, err := s.managedInput()
+	if err != nil {
+		t.Fatal(err)
+	}
+	view, err := configuration.Inspect(in)
+	if err != nil || view.State != "ready" {
+		t.Fatalf("invalid fixture: %v %#v", err, view)
+	}
+	return managed.Operation{BaseRevision: view.Revision, ContextRevision: view.ContextRevision}
+}
+func TestManagedNativeApplyVerifyAndWholeSetDeletion(t *testing.T) {
+	s := managedFixture(t)
+	ctx := context.Background()
+	op := managedBase(t, s)
+	if err := s.managedCheck(ctx, op, "apply"); err != nil {
+		t.Fatal(err)
+	}
+	desired := managed.StoreSnapshot{Exists: true, Bytes: []byte(`{"proxies":[{"name":"off","type":"tcp","localPort":80,"enabled":false}],"visitors":[{"name":"v","type":"stcp","serverName":"peer","bindPort":-1}]}`)}
+	if err := os.WriteFile(s.storeSource.Path(), desired.Bytes, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.managedApply(ctx, desired); err != nil {
+		t.Fatal(err)
+	}
+	data, _ := os.ReadFile(s.storeSource.Path())
+	if string(data) != string(desired.Bytes) {
+		t.Fatal("runtime apply rewrote disk")
+	}
+	ps, vs, _ := s.storeSource.SnapshotAll()
+	if len(ps) != 1 || len(vs) != 1 || len(s.proxyCfgs) != 0 || len(s.visitorCfgs) != 1 {
+		t.Fatal("disabled inventory or effective runtime incomplete")
+	}
+	view, err := s.managedVerifyOnce(desired)
+	if err != nil || !view.RuntimeLoaded || view.ResourcesReady {
+		t.Fatal("nil control reported resource readiness")
+	}
+	deadline, cancel := context.WithTimeout(ctx, 20*time.Millisecond)
+	defer cancel()
+	view, err = s.managedVerify(deadline, desired)
+	if !errors.Is(err, context.DeadlineExceeded) || view.ResourcesReady {
+		t.Fatal("verification ignored missing control")
+	}
+	pm := proxy.NewManager(ctx, s.common, nil, nil, nil, "")
+	vm := visitor.NewManager(ctx, "run", s.common, nil, nil, nil)
+	defer pm.Close()
+	defer vm.Close()
+	s.ctl = &Control{ctx: ctx, pm: pm, vm: vm, doneCh: make(chan struct{})}
+	vm.UpdateAll(s.visitorCfgs)
+	view, err = s.managedVerifyOnce(desired)
+	if err != nil || !view.RuntimeLoaded || !view.ResourcesReady || view.BusinessChecked {
+		t.Fatal("real internal visitor not verified", err, view)
+	}
+	// Applying the empty entire Store removes both disabled inventory and running visitors.
+	empty := managed.StoreSnapshot{Exists: true, Bytes: []byte(`{"proxies":[],"visitors":[]}`)}
+	if err = os.WriteFile(s.storeSource.Path(), empty.Bytes, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err = s.managedApply(ctx, empty); err != nil {
+		t.Fatal(err)
+	}
+	view, err = s.managedVerifyOnce(empty)
+	if err != nil || !view.ResourcesReady {
+		t.Fatal("deletion not independently verified", err, view)
+	}
+	ps, vs, _ = s.storeSource.SnapshotAll()
+	if len(ps)+len(vs) != 0 {
+		t.Fatal("old Store entries retained")
+	}
+	close(s.ctl.doneCh)
+	view, _ = s.managedVerifyOnce(empty)
+	if view.ResourcesReady {
+		t.Fatal("closed control reported ready")
+	}
+}
+func TestManagedNativeCASAndWriteEntrypoints(t *testing.T) {
+	s := managedFixture(t)
+	ctx := context.Background()
+	op := managedBase(t, s)
+	manager := &serviceConfigManager{svr: s}
+	before, _ := os.ReadFile(s.configFilePath)
+	if !errors.Is(manager.ReloadFromFile(true), configmgmt.ErrConflict) || !errors.Is(manager.WriteConfigFile([]byte("invalid")), configmgmt.ErrConflict) {
+		t.Fatal("native file API bypassed ownership")
+	}
+	calls := 0
+	if !errors.Is(manager.withStoreMutationAndReload(func(*source.StoreSource) error { calls++; return nil }), configmgmt.ErrConflict) {
+		t.Fatal("Store mutation accepted")
+	}
+	if _, err := manager.withStoreProxyMutationAndReload("x", func(*source.StoreSource) error { calls++; return nil }); !errors.Is(err, configmgmt.ErrConflict) {
+		t.Fatal("proxy mutation accepted")
+	}
+	if _, err := manager.withStoreVisitorMutationAndReload("x", func(*source.StoreSource) error { calls++; return nil }); !errors.Is(err, configmgmt.ErrConflict) {
+		t.Fatal("visitor mutation accepted")
+	}
+	if calls != 0 {
+		t.Fatal("blocked mutation callback executed")
+	}
+	if !errors.Is(s.UpdateConfigSource(s.common, nil, nil), source.ErrManaged) || !errors.Is(s.UpdateAllConfigurer(nil, nil), source.ErrManaged) {
+		t.Fatal("supported native write bypassed ownership")
+	}
+	after, _ := os.ReadFile(s.configFilePath)
+	if string(after) != string(before) {
+		t.Fatal("blocked file edit wrote disk")
+	}
+	if err := s.managedCheck(ctx, op, "apply"); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(s.storeSource.Path(), []byte("changed raw Store"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if !errors.Is(s.managedCheck(ctx, op, "apply"), managed.ErrConflict) {
+		t.Fatal("full CAS omitted Store")
+	}
