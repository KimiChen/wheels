+++ b/client/proxy/managed.go
@@ -0,0 +1,27 @@
+package proxy
+
+import v1 "github.com/fatedier/frp/pkg/config/v1"
+
+// ManagedSnapshot observes actual manager objects and registration phases.
+// It never starts traffic and never waits behind proxy work.
+func (pm *Manager) ManagedSnapshot() ([]v1.ProxyConfigurer, bool, bool) {
+	if !pm.mu.TryRLock() {
+		return nil, false, false
+	}
+	defer pm.mu.RUnlock()
+	out := make([]v1.ProxyConfigurer, 0, len(pm.proxies))
+	ready := !pm.closed
+	for _, p := range pm.proxies {
+		if !p.mu.TryRLock() {
+			return nil, false, false
+		}
+		if p.Cfg == nil {
+			p.mu.RUnlock()
+			return nil, false, false
+		}
+		out = append(out, p.Cfg.Clone())
+		ready = ready && p.Phase == ProxyPhaseRunning
+		p.mu.RUnlock()
+	}
+	return out, ready, true
+}
