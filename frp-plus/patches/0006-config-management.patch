+package visitor
+
+import (
+	"context"
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+	"net"
+	"testing"
+)
+
+func TestManagedVisitorRealListenerAndInternalOnlyMode(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	port := listener.Addr().(*net.TCPAddr).Port
+	cfg := &v1.STCPVisitorConfig{VisitorBaseConfig: v1.VisitorBaseConfig{Name: "v", Type: "stcp", ServerName: "peer", BindAddr: "127.0.0.1", BindPort: port}}
+	vm := NewManager(context.Background(), "run", &v1.ClientCommonConfig{}, nil, nil, nil)
+	defer vm.Close()
+	vm.UpdateAll([]v1.VisitorConfigurer{cfg})
+	values, ready, available := vm.ManagedSnapshot()
+	if !available || ready || len(values) != 1 {
+		t.Fatal("failed bind reported ready")
+	}
+	listener.Close()
+	vm.mu.Lock()
+	err = vm.startVisitor(cfg)
+	vm.mu.Unlock()
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, ready, _ = vm.ManagedSnapshot()
+	if !ready {
+		t.Fatal("actual listener not ready")
+	}
+	internal := cfg.Clone()
+	internal.GetBaseConfig().BindPort = -1
+	vm.UpdateAll([]v1.VisitorConfigurer{internal})
+	values, ready, _ = vm.ManagedSnapshot()
+	if !ready || values[0].GetBaseConfig().BindPort != -1 {
+		t.Fatal("internal listener mode missing")
+	}
+	vm.UpdateAll(nil)
+	values, ready, _ = vm.ManagedSnapshot()
+	if !ready || len(values) != 0 {
+		t.Fatal("deleted visitor retained")
+	}
+	vm.Close()
+	_, ready, _ = vm.ManagedSnapshot()
+	if ready {
+		t.Fatal("closed manager ready")
+	}
+}
