diff --git a/client/managed.go b/client/managed.go
new file mode 100644
index 0000000..3f0d72c
--- /dev/null
+++ b/client/managed.go
@@ -0,0 +1,304 @@
+package client
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"sync/atomic"
+	"time"
+
+	"github.com/fatedier/frp/extension/frpmonitor/agent/configuration"
+	"github.com/fatedier/frp/extension/frpmonitor/agent/managed"
+	"github.com/fatedier/frp/pkg/config"
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+	"github.com/fatedier/frp/pkg/policy/security"
+)
+
+var managedServiceInUse atomic.Bool
+
+func managedCommonClone(c *v1.ClientCommonConfig) (*v1.ClientCommonConfig, error) {
+	if c == nil {
+		return nil, managed.ErrRuntime
+	}
+	data, err := json.Marshal(c)
+	if err != nil {
+		return nil, managed.ErrRuntime
+	}
+	out := &v1.ClientCommonConfig{}
+	if json.Unmarshal(data, out) != nil {
+		return nil, managed.ErrRuntime
+	}
+	return out, nil
+}
+
+// Copy all memory under native locks and release them before disk inspection,
+// journaling, Engine calls or waits. Disabled objects remain in this snapshot.
+func (svr *Service) managedInput() (configuration.Input, error) {
+	if !svr.reloadMu.TryLock() {
+		return configuration.Input{}, managed.ErrBusy
+	}
+	defer svr.reloadMu.Unlock()
+	if !svr.cfgMu.TryRLock() {
+		return configuration.Input{}, managed.ErrBusy
+	}
+	defer svr.cfgMu.RUnlock()
+	if svr.configSource == nil || svr.storeSource == nil {
+		return configuration.Input{}, managed.ErrRuntime
+	}
+	startup, err := managedCommonClone(svr.common)
+	if err != nil {
+		return configuration.Input{}, err
+	}
+	reload, err := managedCommonClone(svr.reloadCommon)
+	if err != nil {
+		return configuration.Input{}, err
+	}
+	ps, vs, err := svr.configSource.SnapshotAll()
+	if err != nil {
+		return configuration.Input{}, managed.ErrRuntime
+	}
+	sp, sv, err := svr.storeSource.SnapshotAll()
+	if err != nil {
+		return configuration.Input{}, managed.ErrRuntime
+	}
+	cwd, err := os.Getwd()
+	if err != nil {
+		return configuration.Input{}, managed.ErrRuntime
+	}
+	env := map[string]string{}
+	for k, v := range config.GetValues().Envs {
+		env[k] = v
+	}
+	features := []string{}
+	for _, feature := range security.ClientUnsafeFeatures {
+		if svr.unsafeFeatures.IsEnabled(feature) {
+			features = append(features, feature)
+		}
+	}
+	return configuration.Input{ConfigFile: svr.configFilePath, StoreFile: svr.storeSource.Path(), WorkingDir: cwd, StartupCommon: startup, ReloadCommon: reload, FileMemory: configuration.Objects{Proxies: ps, Visitors: vs}, StoreMemory: configuration.Objects{Proxies: sp, Visitors: sv}, TemplateEnv: env, HTTPProxy: os.Getenv("http_proxy"), UnsafeFeatures: features, VirtualNetReady: svr.managedVNetReady.Load()}, nil
+}
+
+func (svr *Service) startManaged() error {
+	if svr.managedEngine == nil {
+		return nil
+	}
+	provider, err := configuration.NewProvider(svr.managedEngine, svr.managedInput)
+	if err != nil {
+		return managed.ErrRuntime
+	}
+	if err = svr.managedEngine.AttachRuntime(managed.Runtime{Check: svr.managedCheck, Apply: svr.managedApply, Verify: svr.managedVerify}); err != nil {
+		return managed.ErrRuntime
+	}
+	svr.managedProvider = provider
+	return nil
+}
+func (svr *Service) closeManaged() {
+	if svr.managedEngine != nil && svr.managedClosed.CompareAndSwap(false, true) {
+		if svr.managedEngine.Close() == nil {
+			managedServiceInUse.Store(false)
+		}
+	}
+}
+func (svr *Service) managedCheck(ctx context.Context, op managed.Operation, phase string) error {
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	in, err := svr.managedInput()
+	if err != nil {
+		return err
+	}
+	if phase == "apply" {
+		view, err := configuration.Inspect(in)
+		if err != nil || view.State != "ready" || view.Revision != op.BaseRevision || view.ContextRevision != op.ContextRevision {
+			return managed.ErrConflict
+		}
+	} else if phase == "rollback" || phase == "recovery" {
+		revision, err := configuration.InspectContext(in)
+		if err != nil || revision != op.ContextRevision {
+			return managed.ErrConflict
+		}
+	} else {
+		return managed.ErrInvalid
+	}
+	revision := op.ContextRevision
+	svr.managedContext.Store(&revision)
+	return nil
+}
+func (svr *Service) managedCheckContext(in configuration.Input) error {
+	expected := svr.managedContext.Load()
+	if expected == nil {
+		return managed.ErrConflict
+	}
+	current, err := configuration.InspectContext(in)
+	if err != nil || current != *expected {
+		return managed.ErrConflict
+	}
+	return nil
+}
+func managedStore(snapshot managed.StoreSnapshot) (configuration.Objects, error) {
+	if !snapshot.Exists {
+		if len(snapshot.Bytes) > 0 {
+			return configuration.Objects{}, managed.ErrInvalid
+		}
+		return configuration.Objects{}, nil
+	}
+	values, err := configuration.DecodeStore(snapshot.Bytes)
+	if err != nil {
+		return configuration.Objects{}, managed.ErrInvalid
+	}
+	return values, nil
+}
+func (svr *Service) managedApply(ctx context.Context, snapshot managed.StoreSnapshot) error {
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	values, err := managedStore(snapshot)
+	if err != nil {
+		return err
+	}
+	in, err := svr.managedInput()
+	if err != nil {
+		return err
+	}
+	if err = svr.managedCheckContext(in); err != nil {
+		return err
+	}
+	if !svr.reloadMu.TryLock() {
+		return managed.ErrBusy
+	}
+	defer svr.reloadMu.Unlock()
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	if svr.storeSource == nil {
+		return managed.ErrRuntime
+	}
+	if err = svr.storeSource.ReplaceManagedMemory(values.Proxies, values.Visitors); err != nil {
+		return managed.ErrRuntime
+	}
+	if err = svr.reloadConfigFromSourcesLocked(); err != nil {
+		return managed.ErrRuntime
+	}
+	return nil
+}
+func managedObjectsEqual(a, b configuration.Objects) bool {
+	encode := func(value configuration.Objects) ([]byte, error) {
+		values := map[string]any{}
+		for _, p := range value.Proxies {
+			if p == nil {
+				return nil, managed.ErrRuntime
+			}
+			key := "p/" + p.GetBaseConfig().Name
+			if _, ok := values[key]; ok {
+				return nil, managed.ErrRuntime
+			}
+			values[key] = p
+		}
+		for _, v := range value.Visitors {
+			if v == nil {
+				return nil, managed.ErrRuntime
+			}
+			key := "v/" + v.GetBaseConfig().Name
+			if _, ok := values[key]; ok {
+				return nil, managed.ErrRuntime
+			}
+			values[key] = v
+		}
+		return json.Marshal(values)
+	}
+	left, e1 := encode(a)
+	right, e2 := encode(b)
+	return e1 == nil && e2 == nil && string(left) == string(right)
+}
+func managedEffective(in configuration.Input, store configuration.Objects) configuration.Objects {
+	ps := append(append([]v1.ProxyConfigurer{}, in.FileMemory.Proxies...), store.Proxies...)
+	vs := append(append([]v1.VisitorConfigurer{}, in.FileMemory.Visitors...), store.Visitors...)
+	ps, vs = config.FilterClientConfigurers(in.ReloadCommon, ps, vs)
+	return configuration.Objects{Proxies: config.CompleteProxyConfigurers(ps), Visitors: config.CompleteVisitorConfigurers(vs)}
+}
+func (svr *Service) managedVerifyOnce(snapshot managed.StoreSnapshot) (managed.Verification, error) {
+	result := managed.Verification{}
+	desired, err := managedStore(snapshot)
+	if err != nil {
+		return result, err
+	}
+	in, err := svr.managedInput()
+	if err != nil {
+		return result, err
+	}
+	if err = svr.managedCheckContext(in); err != nil {
+		return result, err
+	}
+	if !managedObjectsEqual(desired, in.StoreMemory) {
+		return result, nil
+	}
+	expected := managedEffective(in, desired)
+	if !svr.cfgMu.TryRLock() {
+		return result, managed.ErrBusy
+	}
+	loaded := managedObjectsEqual(expected, configuration.Objects{Proxies: svr.proxyCfgs, Visitors: svr.visitorCfgs})
+	svr.cfgMu.RUnlock()
+	result.RuntimeLoaded = loaded
+	if !loaded {
+		return result, nil
+	}
+	if !svr.ctlMu.TryRLock() {
+		return result, managed.ErrBusy
+	}
+	ctl := svr.ctl
+	svr.ctlMu.RUnlock()
+	if ctl == nil || ctl.pm == nil || ctl.vm == nil {
+		return result, nil
+	}
+	select {
+	case <-ctl.Done():
+		return result, nil
+	default:
+	}
+	ps, pr, pa := ctl.pm.ManagedSnapshot()
+	vs, vr, va := ctl.vm.ManagedSnapshot()
+	if !pa || !va {
+		return result, managed.ErrBusy
+	}
+	result.RuntimeLoaded = managedObjectsEqual(expected, configuration.Objects{Proxies: ps, Visitors: vs})
+	result.ResourcesReady = result.RuntimeLoaded && pr && vr
+	if !svr.ctlMu.TryRLock() {
+		return result, managed.ErrBusy
+	}
+	current := svr.ctl == ctl
+	svr.ctlMu.RUnlock()
+	select {
+	case <-ctl.Done():
+		current = false
+	default:
+	}
+	if !current {
+		result.ResourcesReady = false
+	}
+	// No network probe is attempted; registration/listening is not business reachability.
+	return result, nil
+}
+func (svr *Service) managedVerify(ctx context.Context, snapshot managed.StoreSnapshot) (managed.Verification, error) {
+	ticker := time.NewTicker(50 * time.Millisecond)
+	defer ticker.Stop()
+	last := managed.Verification{}
+	for {
+		if ctx.Err() != nil {
+			return last, ctx.Err()
+		}
+		view, err := svr.managedVerifyOnce(snapshot)
+		last = view
+		if err != nil && !errors.Is(err, managed.ErrBusy) {
+			return last, err
+		}
+		if err == nil && view.RuntimeLoaded && view.ResourcesReady {
+			return view, nil
+		}
+		select {
+		case <-ctx.Done():
+			return last, ctx.Err()
+		case <-ticker.C:
+		}
+	}
+}
