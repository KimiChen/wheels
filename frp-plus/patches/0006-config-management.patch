diff --git a/pkg/config/source/managed.go b/pkg/config/source/managed.go
new file mode 100644
index 0000000..e739a94
--- /dev/null
+++ b/pkg/config/source/managed.go
@@ -0,0 +1,68 @@
+package source
+
+import (
+	"errors"
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+	"time"
+)
+
+var ErrManaged = errors.New("configuration is owned by the managed Store engine")
+
+// SnapshotAll clones both maps under one lock, including disabled objects.
+func (s *baseSource) SnapshotAll() ([]v1.ProxyConfigurer, []v1.VisitorConfigurer, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	ps := make([]v1.ProxyConfigurer, 0, len(s.proxies))
+	vs := make([]v1.VisitorConfigurer, 0, len(s.visitors))
+	for _, p := range s.proxies {
+		ps = append(ps, p)
+	}
+	for _, v := range s.visitors {
+		vs = append(vs, v)
+	}
+	return cloneConfigurers(ps, vs)
+}
+
+func (s *ConfigSource) ClaimManaged()  { s.mu.Lock(); defer s.mu.Unlock(); s.managed = true }
+func (s *StoreSource) IsManaged() bool { return s.config.Managed }
+func (s *StoreSource) Path() string    { return s.config.Path }
+
+// ReplaceManagedMemory is the engine adapter's only mutation surface. It does
+// not persist: the durable engine already owns disk and rollback sequencing.
+func (s *StoreSource) ReplaceManagedMemory(proxies []v1.ProxyConfigurer, visitors []v1.VisitorConfigurer) error {
+	if !s.config.Managed {
+		return ErrManaged
+	}
+	ps, vs, err := cloneConfigurers(proxies, visitors)
+	if err != nil {
+		return err
+	}
+	pm := make(map[string]v1.ProxyConfigurer, len(ps))
+	vm := make(map[string]v1.VisitorConfigurer, len(vs))
+	for _, p := range ps {
+		name, err := validateProxyName(p)
+		if err != nil {
+			return err
+		}
+		if _, ok := pm[name]; ok {
+			return ErrAlreadyExists
+		}
+		pm[name] = p
+	}
+	for _, v := range vs {
+		name, err := validateVisitorName(v)
+		if err != nil {
+			return err
+		}
+		if _, ok := vm[name]; ok {
+			return ErrAlreadyExists
+		}
+		vm[name] = v
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.proxies = pm
+	s.visitors = vm
+	s.monitorReadAt = time.Now().UTC()
+	return nil
+}
diff --git a/pkg/config/source/managed_test.go b/pkg/config/source/managed_test.go
new file mode 100644
index 0000000..69a60d9
--- /dev/null
+++ b/pkg/config/source/managed_test.go
@@ -0,0 +1,82 @@
+package source
+
+import (
+	"errors"
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestManagedSourceOwnershipAndWholeSetMemory(t *testing.T) {
+	disabled := false
+	p := &v1.TCPProxyConfig{ProxyBaseConfig: v1.ProxyBaseConfig{Name: "p", Type: "tcp", Enabled: &disabled, ProxyBackend: v1.ProxyBackend{LocalPort: 80}}}
+	v := &v1.STCPVisitorConfig{VisitorBaseConfig: v1.VisitorBaseConfig{Name: "v", Type: "stcp", BindPort: -1, ServerName: "peer", Enabled: &disabled}}
+	file := NewConfigSource()
+	if err := file.ReplaceAll([]v1.ProxyConfigurer{p}, []v1.VisitorConfigurer{v}); err != nil {
+		t.Fatal(err)
+	}
+	ps, vs, err := file.SnapshotAll()
+	if err != nil || len(ps) != 1 || len(vs) != 1 {
+		t.Fatal("disabled source entries lost")
+	}
+	ps[0].GetBaseConfig().LocalPort = 81
+	vs[0].GetBaseConfig().ServerName = "changed"
+	ps, vs, _ = file.SnapshotAll()
+	if ps[0].GetBaseConfig().LocalPort != 80 || vs[0].GetBaseConfig().ServerName != "peer" {
+		t.Fatal("snapshot aliases source")
+	}
+	file.ClaimManaged()
+	if !errors.Is(file.ReplaceAll(nil, nil), ErrManaged) {
+		t.Fatal("owned file source accepted replacement")
+	}
+	path := filepath.Join(t.TempDir(), "store.json")
+	original := []byte(`{"proxies":[],"visitors":[]}`)
+	if err = os.WriteFile(path, original, 0600); err != nil {
+		t.Fatal(err)
+	}
+	store, err := NewStoreSource(StoreSourceConfig{Path: path, Managed: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, mutation := range []func() error{func() error { return store.AddProxy(p) }, func() error { return store.UpdateProxy(p) }, func() error { return store.RemoveProxy("p") }, func() error { return store.AddVisitor(v) }, func() error { return store.UpdateVisitor(v) }, func() error { return store.RemoveVisitor("v") }} {
+		if !errors.Is(mutation(), ErrManaged) {
+			t.Fatal("native Store mutation bypassed ownership")
+		}
+	}
+	if err = store.ReplaceManagedMemory([]v1.ProxyConfigurer{p}, []v1.VisitorConfigurer{v}); err != nil {
+		t.Fatal(err)
+	}
+	ps, vs, _ = store.SnapshotAll()
+	if len(ps) != 1 || len(vs) != 1 {
+		t.Fatal("whole memory replacement lost disabled objects")
+	}
+	data, _ := os.ReadFile(path)
+	if string(data) != string(original) {
+		t.Fatal("memory adapter wrote Store")
+	}
+	if err = store.ReplaceManagedMemory([]v1.ProxyConfigurer{p, p}, nil); !errors.Is(err, ErrAlreadyExists) {
+		t.Fatal("duplicate replacement accepted")
+	}
+	ps, vs, _ = store.SnapshotAll()
+	if len(ps) != 1 || len(vs) != 1 {
+		t.Fatal("invalid whole-set replacement partially changed memory")
+	}
+	if err = store.ReplaceManagedMemory(nil, nil); err != nil {
+		t.Fatal(err)
+	}
+	ps, vs, _ = store.SnapshotAll()
+	if len(ps)+len(vs) != 0 {
+		t.Fatal("deletions not reflected")
+	}
+	ordinary, err := NewStoreSource(StoreSourceConfig{Path: filepath.Join(t.TempDir(), "store.json")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !errors.Is(ordinary.ReplaceManagedMemory(nil, nil), ErrManaged) {
+		t.Fatal("unowned replacement accepted")
+	}
+	if err = ordinary.AddProxy(p); err != nil {
+		t.Fatal("unmanaged native mutation changed", err)
+	}
+}
