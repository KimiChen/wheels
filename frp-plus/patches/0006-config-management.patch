@@ -0,0 +1,62 @@
+package sub
+
+import (
+	"context"
+	"errors"
+	"github.com/fatedier/frp/extension/frpmonitor/agent/configuration"
+	"github.com/fatedier/frp/extension/frpmonitor/agent/managed"
+	"github.com/fatedier/frp/pkg/config"
+	"github.com/fatedier/frp/pkg/config/source"
+	"github.com/fatedier/frp/pkg/policy/security"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+)
+
+var managedCommandInUse atomic.Bool
+
+func openManagedEngine(result *config.ClientConfigLoadResult, fileSource *source.ConfigSource, storePath string, unsafe *security.UnsafeFeatures, configFile string) (*managed.Engine, error) {
+	opt := result.Common.Telemetry.ConfigManagement
+	if opt == nil || !opt.Enabled {
+		return nil, nil
+	}
+	if cfgDir != "" || !result.Common.Store.IsEnabled() || !filepath.IsAbs(storePath) || filepath.Dir(filepath.Clean(storePath)) != opt.Root {
+		return nil, errors.New("configuration management requires one explicit private Store")
+	}
+	if !managedCommandInUse.CompareAndSwap(false, true) {
+		return nil, errors.New("configuration management requires one service per process")
+	}
+	// This process owns a single managed service for its full command lifetime.
+	ps, vs, err := fileSource.SnapshotAll()
+	if err != nil {
+		managedCommandInUse.Store(false)
+		return nil, errors.New("configuration source unavailable")
+	}
+	cwd, err := os.Getwd()
+	if err != nil {
+		managedCommandInUse.Store(false)
+		return nil, errors.New("configuration context unavailable")
+	}
+	features := []string{}
+	for _, feature := range security.ClientUnsafeFeatures {
+		if unsafe.IsEnabled(feature) {
+			features = append(features, feature)
+		}
+	}
+	input := configuration.Input{ConfigFile: configFile, StoreFile: storePath, WorkingDir: cwd, StartupCommon: result.Common, ReloadCommon: result.Common, FileMemory: configuration.Objects{Proxies: ps, Visitors: vs}, TemplateEnv: config.GetValues().Envs, HTTPProxy: os.Getenv("http_proxy"), UnsafeFeatures: features}
+	engine, err := managed.Open(managed.Options{Root: opt.Root, StorePath: storePath, RecoveryCheck: func(ctx context.Context, op managed.Operation) error {
+		if ctx.Err() != nil {
+			return ctx.Err()
+		}
+		revision, err := configuration.InspectContext(input)
+		if err != nil || revision != op.ContextRevision {
+			return managed.ErrConflict
+		}
+		return nil
+	}})
+	if err != nil {
+		managedCommandInUse.Store(false)
+		return nil, errors.New("managed Store initialization failed")
+	}
+	return engine, nil
+}
