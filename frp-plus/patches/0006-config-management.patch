@@ -0,0 +1,75 @@
+package sub
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/fatedier/frp/extension/frpmonitor/shared"
+	"github.com/fatedier/frp/pkg/config"
+	"github.com/fatedier/frp/pkg/config/source"
+	"github.com/fatedier/frp/pkg/policy/security"
+)
+
+func TestManagedCommandOptInAndFixedStore(t *testing.T) {
+	dir, err := filepath.EvalSymlinks(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Chmod(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	storePath := filepath.Join(dir, "store.json")
+	file := filepath.Join(dir, "frpc.json")
+	telemetry := shared.AgentConfig{Enabled: true, Endpoint: "ws://127.0.0.1:1/agent/v1/ws", TokenFile: filepath.Join(dir, "token"), AllowInsecureLoopback: true, ConfigManagement: &shared.ConfigManagementConfig{Enabled: true, Root: dir}}
+	data, _ := json.Marshal(map[string]any{"serverAddr": "127.0.0.1", "store": map[string]any{"path": storePath}, "telemetry": telemetry})
+	if err = os.WriteFile(file, data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	result, err := config.LoadClientConfigResult(file, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fs := source.NewConfigSource()
+	if err = fs.ReplaceAll(result.Proxies, result.Visitors); err != nil {
+		t.Fatal(err)
+	}
+	unsafe := security.NewUnsafeFeatures(nil)
+	opt := result.Common.Telemetry.ConfigManagement
+	result.Common.Telemetry.ConfigManagement = nil
+	engine, err := openManagedEngine(result, fs, storePath, unsafe, file)
+	if err != nil || engine != nil {
+		t.Fatal("disabled opt-in created an engine")
+	}
+	if _, err = os.Stat(filepath.Join(dir, "identity.json")); !os.IsNotExist(err) {
+		t.Fatal("disabled mode wrote private root")
+	}
+	result.Common.Telemetry.ConfigManagement = opt
+	if _, err = openManagedEngine(result, fs, filepath.Join(dir, "nested", "store.json"), unsafe, file); err == nil {
+		t.Fatal("nested Store path accepted")
+	}
+	savedDir := cfgDir
+	cfgDir = "synthetic"
+	_, err = openManagedEngine(result, fs, storePath, unsafe, file)
+	cfgDir = savedDir
+	if err == nil {
+		t.Fatal("multi-service command accepted")
+	}
+	engine, err = openManagedEngine(result, fs, storePath, unsafe, file)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer engine.Close()
+	defer managedCommandInUse.Store(false)
+	if _, err = os.Stat(storePath); !os.IsNotExist(err) {
+		t.Fatal("engine fabricated previously missing Store")
+	}
+	if _, err = openManagedEngine(result, fs, storePath, unsafe, file); err == nil {
+		t.Fatal("second managed command accepted")
+	}
+	store, err := source.NewStoreSource(source.StoreSourceConfig{Path: storePath, Managed: true})
+	if err != nil || !store.IsManaged() {
+		t.Fatal("post-recovery native Store creation failed")
+	}
+}
