@@ -0,0 +1,18 @@
+package client
+
+import "github.com/fatedier/frp/extension/frpmonitor/shared"
+
+func (svr *Service) monitorTunnels() shared.TunnelSnapshot {
+	if svr.tunnelRegistry == nil {
+		return shared.EmptyTunnelSnapshot("client", "unavailable")
+	}
+	if !svr.ctlMu.TryRLock() {
+		return shared.EmptyTunnelSnapshot("client", "unavailable")
+	}
+	ctl := svr.ctl
+	svr.ctlMu.RUnlock()
+	if ctl != nil && !ctl.vm.ObserveTunnels() {
+		return shared.EmptyTunnelSnapshot("client", "unavailable")
+	}
+	return svr.tunnelRegistry.Snapshot()
+}
