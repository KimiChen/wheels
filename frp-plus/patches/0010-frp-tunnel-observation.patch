@@ -0,0 +1,52 @@
+package proxy
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/fatedier/frp/pkg/util/tunnelmonitor"
+)
+
+func TestTunnelProxyNativeStatusDoesNotExportErrorOrMergeInstance(t *testing.T) {
+	r := tunnelmonitor.New("client")
+	identity := tunnelmonitor.ClientIdentity("server", "team", "client", "proxy", "same", "tcp")
+	p := &Wrapper{WorkingStatus: WorkingStatus{Name: "same", Type: "tcp", Phase: ProxyPhaseWaitStart}, tunnel: r.Open(identity)}
+	if p.SetRunningStatus("", "secretKey=private") == nil {
+		t.Fatal("expected native rejection")
+	}
+	s := r.Snapshot()
+	if s.Validate() != nil || len(s.Objects) != 1 || s.Objects[0].State.Status != "error" || s.Objects[0].State.ErrorCode != "start_failed" {
+		t.Fatal("registration rejection not classified")
+	}
+	data, _ := json.Marshal(s)
+	if strings.Contains(string(data), "private") || strings.Contains(string(data), "secretKey") {
+		t.Fatal("native error leaked")
+	}
+	id := s.Objects[0].InstanceID
+	p.mu.Lock()
+	p.Phase = ProxyPhaseCheckFailed
+	p.observeTunnelLocked()
+	p.mu.Unlock()
+	if r.Snapshot().Objects[0].State.ErrorCode != "health_check_failed" {
+		t.Fatal("health state conflated with registration error")
+	}
+	p.mu.Lock()
+	p.Phase = ProxyPhaseClosed
+	p.observeTunnelLocked()
+	p.mu.Unlock()
+	r.Open(identity)
+	s = r.Snapshot()
+	if len(s.Objects) != 2 || s.Objects[0].InstanceID == s.Objects[1].InstanceID {
+		t.Fatal("recreated proxy reused instance")
+	}
+	closed := false
+	for _, o := range s.Objects {
+		if o.InstanceID == id {
+			closed = o.ClosedAtMS != nil && o.State.Status == "closed"
+		}
+	}
+	if !closed {
+		t.Fatal("closed original missing")
+	}
+}
