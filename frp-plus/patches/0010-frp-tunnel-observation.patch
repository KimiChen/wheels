+package server
+
+import (
+	"testing"
+
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+	"github.com/fatedier/frp/pkg/msg"
+	"github.com/fatedier/frp/pkg/util/tunnelmonitor"
+)
+
+func TestTunnelIdentityUsesPrePluginRawNameAndRejectsGuessedOwner(t *testing.T) {
+	for _, test := range []struct{ name, user, client, raw, quality string }{{"alice.same", "alice", "stable", "same", "stable"}, {"same", "alice", "stable", "same", "instance_only"}, {"alice.alice.same", "alice", "stable", "alice.same", "stable"}, {"same", "", "", "same", "instance_only"}} {
+		r := tunnelmonitor.New("server")
+		ctl := &Control{sessionCtx: &SessionContext{TunnelRegistry: r, LoginMsg: &msg.Login{User: test.user, ClientID: test.client}, ServerCfg: &v1.ServerConfig{}}}
+		ctl.newTunnelObservation(test.name, "tcp")
+		s := r.Snapshot()
+		if s.Validate() != nil || len(s.Objects) != 1 || s.Objects[0].Identity.RawName != test.raw || s.Objects[0].Identity.Quality != test.quality {
+			t.Fatal("raw name or stable identity inferred incorrectly")
+		}
+	}
+}
