+++ b/server/tunnel.go
@@ -0,0 +1,37 @@
+package server
+
+import (
+	"strings"
+
+	"github.com/fatedier/frp/extension/frpmonitor/shared"
+	"github.com/fatedier/frp/pkg/util/tunnelmonitor"
+)
+
+func (ctl *Control) newTunnelObservation(requestedName, protocol string) *tunnelmonitor.Handle {
+	if ctl.sessionCtx.TunnelRegistry == nil {
+		return nil
+	}
+	login := ctl.sessionCtx.LoginMsg
+	serverID := ctl.sessionCtx.ServerCfg.Monitor.ServerID
+	if serverID == "" {
+		serverID = "default"
+	}
+	id := shared.TunnelIdentity{ServerID: serverID, User: login.User, RawName: requestedName, Kind: "proxy", Protocol: protocol, Quality: "instance_only"}
+	canonical := true
+	if login.User != "" {
+		prefix := login.User + "."
+		if strings.HasPrefix(requestedName, prefix) && len(requestedName) > len(prefix) {
+			id.RawName = strings.TrimPrefix(requestedName, prefix)
+		} else {
+			canonical = false
+		}
+	}
+	if login.ClientID != "" {
+		value := login.ClientID
+		id.RawClientID = &value
+		if canonical {
+			id.Quality = "stable"
+		}
+	}
+	return ctl.sessionCtx.TunnelRegistry.Open(id)
+}
