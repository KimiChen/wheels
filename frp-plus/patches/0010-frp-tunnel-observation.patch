--- /dev/null
+++ b/client/proxy/tunnel.go
@@ -0,0 +1,26 @@
+package proxy
+
+import "github.com/fatedier/frp/pkg/util/tunnelmonitor"
+
+// SetTunnelRegistry is called before the manager starts any wrappers.
+func (pm *Manager) SetTunnelRegistry(registry *tunnelmonitor.Registry) { pm.tunnelRegistry = registry }
+
+func (pw *Wrapper) observeTunnelLocked() {
+	state := tunnelmonitor.InitialState("unknown")
+	switch pw.Phase {
+	case ProxyPhaseNew, ProxyPhaseWaitStart:
+		state.Status = "starting"
+	case ProxyPhaseRunning:
+		state.Status = "running"
+	case ProxyPhaseStartErr:
+		state.Status = "error"
+		state.ErrorCode = "start_failed"
+	case ProxyPhaseCheckFailed:
+		state.Status = "error"
+		state.ErrorCode = "health_check_failed"
+	case ProxyPhaseClosed:
+		pw.tunnel.Close()
+		return
+	}
+	pw.tunnel.State(state)
+}
