diff --git a/pkg/util/tunnelmonitor/registry.go b/pkg/util/tunnelmonitor/registry.go
new file mode 100644
--- /dev/null
+++ b/pkg/util/tunnelmonitor/registry.go
@@ -0,0 +1,428 @@
+// Package tunnelmonitor records private instance observations independently of
+// FRP's name-keyed dashboard and Prometheus metrics. No forwarding decision
+// depends on the availability of this bounded, in-memory observer.
+package tunnelmonitor
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"math"
+	"sort"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/fatedier/frp/extension/frpmonitor/shared"
+)
+
+const maxInstances = 4096
+const ringSize = 2048
+
+type Registry struct {
+	mu                sync.Mutex
+	source, epoch     string
+	serviceID         string
+	objects           map[string]*Handle
+	ring              [ringSize]shared.TunnelEvent
+	sequence, dropped uint64
+	untracked         int
+	failed            bool
+	now               func() time.Time
+}
+
+type Handle struct {
+	mu                       sync.Mutex
+	registry                 *Registry
+	value                    shared.TunnelObject
+	rx, tx, connections      uint64
+	tracked, closed, invalid bool
+	settledAtMS              int64
+}
+
+func uuid() string {
+	var b [16]byte
+	if _, err := rand.Read(b[:]); err != nil {
+		return ""
+	}
+	b[6] = b[6]&15 | 64
+	b[8] = b[8]&63 | 128
+	s := hex.EncodeToString(b[:])
+	return s[:8] + "-" + s[8:12] + "-" + s[12:16] + "-" + s[16:20] + "-" + s[20:]
+}
+
+func New(source string, serviceIDs ...string) *Registry {
+	r := &Registry{source: source, epoch: uuid(), objects: map[string]*Handle{}, now: time.Now}
+	if len(serviceIDs) > 0 {
+		if source != "client" || serviceIDs[0] != "" && !shared.ValidConfigOperationID(serviceIDs[0]) {
+			r.failed = true
+		} else {
+			r.serviceID = serviceIDs[0]
+		}
+	}
+	return r
+}
+
+func InitialState(status string) shared.TunnelState {
+	return shared.TunnelState{Status: status, LocalState: "unknown", RemoteState: "unknown", P2PState: "unknown", FallbackState: "unknown"}
+}
+
+func ClientIdentity(server, user, client, kind, name, protocol string) shared.TunnelIdentity {
+	if server == "" {
+		server = "default"
+	}
+	i := shared.TunnelIdentity{ServerID: server, User: user, Kind: kind, RawName: name, Protocol: protocol, Quality: "instance_only"}
+	if client != "" {
+		i.RawClientID = &client
+		i.Quality = "stable"
+	}
+	return i
+}
+
+// Open creates a fresh handle even when the logical name already exists.
+// Registry admission is bounded; an untracked handle only records its eventual
+// close, allowing the inventory to recover from a temporary capacity limit.
+func (r *Registry) Open(identity shared.TunnelIdentity) *Handle {
+	if r == nil {
+		return nil
+	}
+	if identity.RawClientID != nil {
+		value := *identity.RawClientID
+		identity.RawClientID = &value
+	}
+	now := r.now().UTC()
+	h := &Handle{registry: r, value: shared.TunnelObject{InstanceID: uuid(), Identity: identity, State: InitialState("starting"), CreatedAtMS: now.UnixMilli(), OperationRelation: "none", ServiceID: r.serviceID, Counters: shared.TunnelCounters{Quality: "unsupported", ConnectionsQuality: "unsupported", Accounting: "not_observed", ByteScope: "not_observed"}}}
+	if r.source == "server" && identity.Protocol != "xtcp" {
+		h.value.Counters.Epoch = uuid()
+		if identity.Protocol != "udp" {
+			h.value.Counters.ConnectionsQuality = "ok"
+		}
+		if identity.Protocol != "sudp" {
+			h.value.Counters.Quality = "ok"
+			h.value.Counters.Accounting = "connection_close"
+			h.value.Counters.ByteScope = "forwarded_stream"
+			if identity.Protocol == "udp" {
+				h.value.Counters.Accounting = "datagram"
+				h.value.Counters.ByteScope = "datagram_payload"
+			}
+		}
+	}
+	r.mu.Lock()
+	// A completed handle remains observable long enough to collect final totals.
+	// Only registry ownership is evicted; callbacks still own the same handle.
+	r.pruneLocked(now.UnixMilli())
+	if h.snapshotLocked().Validate(r.source) != nil || r.epoch == "" || h.value.InstanceID == "" || (h.value.Counters.Quality == "ok" && h.value.Counters.Epoch == "") || len(r.objects) >= maxInstances {
+		r.untracked++
+		r.dropLocked()
+		r.mu.Unlock()
+		return h
+	}
+	h.tracked = true
+	r.objects[h.value.InstanceID] = h
+	r.mu.Unlock()
+	h.emit("created")
+	return h
+}
+
+func (r *Registry) dropLocked() {
+	if r.dropped == math.MaxUint64 {
+		r.failed = true
+	} else {
+		r.dropped++
+	}
+}
+
+func (h *Handle) snapshotLocked() shared.TunnelObject {
+	o := h.value
+	if o.Identity.RawClientID != nil {
+		value := *o.Identity.RawClientID
+		o.Identity.RawClientID = &value
+	}
+	if o.ClosedAtMS != nil {
+		value := *o.ClosedAtMS
+		o.ClosedAtMS = &value
+	}
+	if o.Counters.Quality == "ok" {
+		rx, tx := strconv.FormatUint(h.rx, 10), strconv.FormatUint(h.tx, 10)
+		o.Counters.RXBytes = &rx
+		o.Counters.TXBytes = &tx
+
+	}
+	if o.Counters.ConnectionsQuality == "ok" {
+		connections := strconv.FormatUint(h.connections, 10)
+		o.Counters.Connections = &connections
+	}
+	return o
+}
+
+func (h *Handle) emit(code string) {
+	if h == nil || !h.tracked {
+		return
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.emitLocked(code)
+}
+
+func (h *Handle) emitLocked(code string, bases ...string) {
+	if !h.tracked {
+		return
+	}
+	o := h.snapshotLocked()
+	r := h.registry
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.sequence == math.MaxUint64 {
+		r.failed = true
+		return
+	}
+	r.sequence++
+	if r.sequence > ringSize {
+		r.dropLocked()
+	}
+	basis := "native"
+	if len(bases) > 0 {
+		basis = bases[0]
+	}
+	r.ring[(r.sequence-1)%ringSize] = shared.TunnelEvent{TimeBasis: basis, Sequence: strconv.FormatUint(r.sequence, 10), OccurredAtMS: r.now().UTC().UnixMilli(), Code: code, Object: o}
+}
+
+func (h *Handle) State(state shared.TunnelState) { h.setState(state, "native") }
+
+// ObservedState dates a sampled change; it is not a native transition timestamp.
+func (h *Handle) ObservedState(state shared.TunnelState) { h.setState(state, "observed") }
+
+func (h *Handle) setState(state shared.TunnelState, basis string) {
+	if h == nil {
+		return
+	}
+	h.mu.Lock()
+	if h.closed || h.value.State == state {
+		h.mu.Unlock()
+		return
+	}
+	h.value.State = state
+	code := "state_changed"
+	if state.Status == "registered" {
+		code = "registered"
+	}
+	h.emitLocked(code, basis)
+	h.mu.Unlock()
+}
+
+func (h *Handle) Close() {
+	if h == nil {
+		return
+	}
+	h.mu.Lock()
+	if h.closed {
+		h.mu.Unlock()
+		return
+	}
+	h.closed = true
+	if h.connections == 0 {
+		h.settledAtMS = h.registry.now().UTC().UnixMilli()
+	}
+	at := h.registry.now().UTC().UnixMilli()
+	h.value.ClosedAtMS = &at
+	h.value.State.Status = "closed"
+	if h.value.Identity.Kind == "visitor" {
+		h.value.State.LocalState = "closed"
+		if h.value.State.RemoteState == "connected" || h.value.State.RemoteState == "connecting" {
+			h.value.State.RemoteState = "closed"
+		}
+		if h.value.State.P2PState == "connected" || h.value.State.P2PState == "connecting" {
+			h.value.State.P2PState = "unknown"
+		}
+		if h.value.State.FallbackState == "active" {
+			h.value.State.FallbackState = "unknown"
+		}
+	}
+	if !h.tracked {
+		h.mu.Unlock()
+		h.registry.mu.Lock()
+		h.registry.untracked--
+		h.registry.mu.Unlock()
+		return
+	}
+	h.emitLocked("closed")
+	h.mu.Unlock()
+}
+
+func (h *Handle) invalidateLocked() bool {
+	if h.invalid {
+		return false
+	}
+	h.invalid = true
+	if h.value.Counters.Quality != "unsupported" {
+		h.value.Counters.Quality = "unknown"
+	}
+	if h.value.Counters.ConnectionsQuality != "unsupported" {
+		h.value.Counters.ConnectionsQuality = "unknown"
+	}
+	h.value.Counters.Connections = nil
+	h.value.Counters.RXBytes = nil
+	h.value.Counters.TXBytes = nil
+	return true
+}
+
+func (h *Handle) OpenConnection() {
+	if h == nil || !h.tracked {
+		return
+	}
+	h.mu.Lock()
+	changed := false
+	if h.connections == math.MaxUint64 {
+		changed = h.invalidateLocked()
+	} else {
+		h.connections++
+	}
+	h.mu.Unlock()
+	if changed {
+		h.emit("counter_invalid")
+	}
+}
+
+// FinishConnection is called exactly once by the connection owner, including
+// after proxy Close. Its byte totals can only reach this original handle.
+func (h *Handle) FinishConnection(rx, tx int64) {
+	if h == nil || !h.tracked {
+		return
+	}
+	h.mu.Lock()
+	changed := false
+	if h.connections == 0 {
+		changed = h.invalidateLocked()
+	} else {
+		h.connections--
+	}
+	if rx < 0 || tx < 0 || math.MaxUint64-h.rx < uint64(rx) || math.MaxUint64-h.tx < uint64(tx) {
+		changed = h.invalidateLocked() || changed
+	} else {
+		h.rx += uint64(rx)
+		h.tx += uint64(tx)
+	}
+	final := h.closed && h.connections == 0
+	if final {
+		h.settledAtMS = h.registry.now().UTC().UnixMilli()
+	}
+	h.mu.Unlock()
+	if changed {
+		h.emit("counter_invalid")
+	} else if final {
+		h.emit("settled")
+	}
+}
+
+func (h *Handle) Add(rx, tx int64) {
+	if h == nil || !h.tracked {
+		return
+	}
+	h.mu.Lock()
+	changed := false
+	if rx < 0 || tx < 0 || math.MaxUint64-h.rx < uint64(rx) || math.MaxUint64-h.tx < uint64(tx) {
+		changed = h.invalidateLocked()
+	} else {
+		h.rx += uint64(rx)
+		h.tx += uint64(tx)
+	}
+	h.mu.Unlock()
+	if changed {
+		h.emit("counter_invalid")
+	}
+}
+
+// Snapshot never waits for native state/counter locks. Replay is intentionally
+// bounded to the latest wire window; a consumer detects gaps from sequence
+// bounds rather than treating overwritten events as complete history.
+func (r *Registry) Snapshot() shared.TunnelSnapshot {
+	if r == nil {
+		return shared.EmptyTunnelSnapshot("server", "unavailable")
+	}
+	out := shared.EmptyTunnelSnapshot(r.source, "unavailable")
+	if !r.mu.TryLock() {
+		return out
+	}
+	if r.epoch == "" || r.failed {
+		r.mu.Unlock()
+		return out
+	}
+	out.ProcessEpoch = r.epoch
+	out.CollectedAtMS = r.now().UTC().UnixMilli()
+	out.State = "ready"
+	r.pruneLocked(out.CollectedAtMS)
+	out.DroppedEvents = strconv.FormatUint(r.dropped, 10)
+	objects := make([]*Handle, 0, len(r.objects))
+	for _, h := range r.objects {
+		objects = append(objects, h)
+	}
+	if r.untracked > 0 || len(objects) > shared.MaxTunnelObjects {
+		out.State = "truncated"
+	}
+	if r.sequence > 0 {
+		first := uint64(1)
+		if r.sequence > shared.MaxTunnelEvents {
+			first = r.sequence - shared.MaxTunnelEvents + 1
+		}
+		out.FirstSequence = strconv.FormatUint(first, 10)
+		out.LastSequence = strconv.FormatUint(r.sequence, 10)
+		for seq := first; seq <= r.sequence; seq++ {
+			event := r.ring[(seq-1)%ringSize]
+			event.Object = cloneObject(event.Object)
+			out.Events = append(out.Events, event)
+			if seq == math.MaxUint64 {
+				break
+			}
+		}
+	}
+	r.mu.Unlock()
+	if out.State == "ready" {
+		for _, h := range objects {
+			if !h.mu.TryLock() {
+				out.State = "unavailable"
+				out.Objects = []shared.TunnelObject{}
+				break
+			}
+			out.Objects = append(out.Objects, h.snapshotLocked())
+			h.mu.Unlock()
+		}
+		sort.Slice(out.Objects, func(i, j int) bool { return out.Objects[i].InstanceID < out.Objects[j].InstanceID })
+	}
+	if err := out.Validate(); err != nil {
+		out.State = "truncated"
+		out.Objects = []shared.TunnelObject{}
+		if out.Validate() != nil {
+			return shared.EmptyTunnelSnapshot(r.source, "unavailable")
+		}
+	}
+	return out
+}
+
+func (r *Registry) pruneLocked(now int64) {
+	for id, h := range r.objects {
+		if h.mu.TryLock() {
+			eligible := h.closed && h.connections == 0 && h.settledAtMS != 0 && now-h.settledAtMS > int64(5*time.Minute/time.Millisecond)
+			h.mu.Unlock()
+			if eligible {
+				delete(r.objects, id)
+			}
+		}
+	}
+}
+func cloneObject(o shared.TunnelObject) shared.TunnelObject {
+	clone := func(p *string) *string {
+		if p == nil {
+			return nil
+		}
+		v := *p
+		return &v
+	}
+	o.Identity.RawClientID = clone(o.Identity.RawClientID)
+	o.Counters.RXBytes = clone(o.Counters.RXBytes)
+	o.Counters.TXBytes = clone(o.Counters.TXBytes)
+	o.Counters.Connections = clone(o.Counters.Connections)
+	if o.ClosedAtMS != nil {
+		v := *o.ClosedAtMS
+		o.ClosedAtMS = &v
+	}
+	return o
+}
diff --git a/pkg/util/tunnelmonitor/registry_test.go b/pkg/util/tunnelmonitor/registry_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/util/tunnelmonitor/registry_test.go
@@ -0,0 +1,191 @@
+package tunnelmonitor
+
+import (
+	"math"
+	"strconv"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/fatedier/frp/extension/frpmonitor/shared"
+)
+
+func testIdentity() shared.TunnelIdentity {
+	return ClientIdentity("test", "user", "client", "proxy", "same", "tcp")
+}
+func find(t *testing.T, r *Registry, id string) shared.TunnelObject {
+	t.Helper()
+	s := r.Snapshot()
+	if err := s.Validate(); err != nil {
+		t.Fatal(err)
+	}
+	for _, o := range s.Objects {
+		if o.InstanceID == id {
+			return o
+		}
+	}
+	t.Fatal("instance missing")
+	return shared.TunnelObject{}
+}
+
+func TestSameNameCallbacksKeepOriginalInstance(t *testing.T) {
+	r := New("server")
+	old := r.Open(testIdentity())
+	old.OpenConnection()
+	old.Close()
+	next := r.Open(testIdentity())
+	next.OpenConnection()
+	next.FinishConnection(7, 9)
+	old.FinishConnection(9007199254740993, 11)
+	a, b := find(t, r, old.value.InstanceID), find(t, r, next.value.InstanceID)
+	if a.InstanceID == b.InstanceID || *a.Counters.RXBytes != "9007199254740993" || *b.Counters.RXBytes != "7" || *a.Counters.Connections != "0" || *b.Counters.Connections != "0" {
+		t.Fatal("late connection totals reached a new same-name instance")
+	}
+	if a.ClosedAtMS == nil || b.ClosedAtMS != nil {
+		t.Fatal("lifecycle merged")
+	}
+}
+
+func TestCounterInvalidNeverWrapsOrInventsZero(t *testing.T) {
+	r := New("server")
+	h := r.Open(testIdentity())
+	h.rx = math.MaxUint64
+	h.Add(1, 0)
+	o := find(t, r, h.value.InstanceID)
+	if o.Counters.Quality != "unknown" || o.Counters.RXBytes != nil || o.Counters.Connections != nil {
+		t.Fatal("overflow produced a usable counter")
+	}
+	h = r.Open(testIdentity())
+	h.FinishConnection(1, 1)
+	if find(t, r, h.value.InstanceID).Counters.Quality != "unknown" {
+		t.Fatal("unmatched close produced negative connections")
+	}
+	legacy := testIdentity()
+	legacy.RawClientID = nil
+	legacy.Quality = "instance_only"
+	h = r.Open(legacy)
+	if find(t, r, h.value.InstanceID).Identity.Quality != "instance_only" {
+		t.Fatal("legacy identity became stable")
+	}
+}
+
+func TestReplayAndInventoryAreBoundedAndBusyFailsClosed(t *testing.T) {
+	r := New("server")
+	h := r.Open(testIdentity())
+	for i := 0; i < ringSize+10; i++ {
+		state := InitialState("starting")
+		if i%2 == 0 {
+			state.Status = "registered"
+		}
+		h.State(state)
+	}
+	s := r.Snapshot()
+	if s.Validate() != nil || len(s.Events) != shared.MaxTunnelEvents || s.DroppedEvents == "0" || s.FirstSequence == "1" {
+		t.Fatal("event overflow hidden or unbounded")
+	}
+	r.mu.Lock()
+	s = r.Snapshot()
+	r.mu.Unlock()
+	if s.State != "unavailable" || len(s.Objects) != 0 {
+		t.Fatal("busy registry claimed complete inventory")
+	}
+	for i := 0; i < shared.MaxTunnelObjects; i++ {
+		r.Open(testIdentity())
+	}
+	s = r.Snapshot()
+	if s.State != "truncated" || len(s.Objects) != 0 || len(s.Events) == 0 {
+		t.Fatal("partial inventory pretended complete or lost bounded events")
+	}
+	r.mu.Lock()
+	r.sequence = math.MaxUint64
+	r.mu.Unlock()
+	h.State(InitialState("running"))
+	if r.Snapshot().State != "unavailable" {
+		t.Fatal("sequence overflow wrapped")
+	}
+}
+
+func TestConcurrentCounterAndSnapshotOwnership(t *testing.T) {
+	r := New("server")
+	h := r.Open(testIdentity())
+	var wg sync.WaitGroup
+	for j := 0; j < 8; j++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for i := 0; i < 1000; i++ {
+				h.OpenConnection()
+				h.FinishConnection(1, 2)
+			}
+		}()
+	}
+	for i := 0; i < 100; i++ {
+		s := r.Snapshot()
+		if err := s.Validate(); err != nil {
+			t.Fatal(err)
+		}
+		if len(s.Objects) > 0 {
+			s.Objects[0].Identity.RawClientID = ptr("modified")
+		}
+	}
+	wg.Wait()
+	o := find(t, r, h.value.InstanceID)
+	if *o.Counters.RXBytes != strconv.Itoa(8000) || *o.Counters.TXBytes != "16000" || *o.Identity.RawClientID != "client" {
+		t.Fatal("counter race or provider alias")
+	}
+}
+func ptr(s string) *string { return &s }
+
+func TestProtocolCounterScopesDoNotInventComparableBytes(t *testing.T) {
+	for _, test := range []struct{ protocol, bytes, connections, accounting, scope string }{
+		{"tcp", "ok", "ok", "connection_close", "forwarded_stream"},
+		{"udp", "ok", "unsupported", "datagram", "datagram_payload"},
+		// A SUDP proxy can serve framed and transcoded payload sessions together.
+		{"sudp", "unsupported", "ok", "not_observed", "not_observed"},
+		{"xtcp", "unsupported", "unsupported", "not_observed", "not_observed"},
+	} {
+		t.Run(test.protocol, func(t *testing.T) {
+			r := New("server")
+			i := testIdentity()
+			i.Protocol = test.protocol
+			h := r.Open(i)
+			o := find(t, r, h.value.InstanceID)
+			c := o.Counters
+			if c.Quality != test.bytes || c.ConnectionsQuality != test.connections || c.Accounting != test.accounting || c.ByteScope != test.scope {
+				t.Fatal("incompatible protocol accounting combined")
+			}
+			if test.bytes == "unsupported" && (c.RXBytes != nil || c.TXBytes != nil) {
+				t.Fatal("unsupported traffic shown as zero")
+			}
+			if test.connections == "unsupported" && c.Connections != nil {
+				t.Fatal("unsupported connections shown as zero")
+			}
+		})
+	}
+}
+
+func TestSettledRetentionAndDetachedEventReplay(t *testing.T) {
+	r := New("server")
+	now := time.Now()
+	r.now = func() time.Time { return now }
+	h := r.Open(testIdentity())
+	h.OpenConnection()
+	h.Close()
+	now = now.Add(10 * time.Minute)
+	if len(r.Snapshot().Objects) != 1 {
+		t.Fatal("closed proxy with live stream was evicted")
+	}
+	h.FinishConnection(10, 11)
+	s := r.Snapshot()
+	if len(s.Objects) != 1 {
+		t.Fatal("late final totals were evicted before sampling")
+	}
+	*s.Events[0].Object.Identity.RawClientID = "mutated"
+	if *r.Snapshot().Events[0].Object.Identity.RawClientID != "client" {
+		t.Fatal("replay aliases registry")
+	}
+	now = now.Add(6 * time.Minute)
+	if len(r.Snapshot().Objects) != 0 {
+		t.Fatal("completed instances grew without retention")
+	}
+}
