diff --git a/client/visitor/tunnel.go b/client/visitor/tunnel.go
new file mode 100644
--- /dev/null
+++ b/client/visitor/tunnel.go
@@ -0,0 +1,47 @@
+package visitor
+
+import "github.com/fatedier/frp/pkg/util/tunnelmonitor"
+
+// SetTunnelRegistry is called before the manager starts any visitors.
+func (vm *Manager) SetTunnelRegistry(registry *tunnelmonitor.Registry) { vm.tunnelRegistry = registry }
+
+// Runtime remote/P2P state is sampled; lifecycle create/close is recorded at its
+// native transition. A transient handshake between samples is not guaranteed.
+func (vm *Manager) ObserveTunnels() bool {
+	if !vm.mu.TryRLock() {
+		return false
+	}
+	defer vm.mu.RUnlock()
+	for name, v := range vm.visitors {
+		observed, ok := v.(interface{ monitorStatus() MonitorStatus })
+		if !ok {
+			continue
+		}
+		got := observed.monitorStatus()
+		state := tunnelmonitor.InitialState("running")
+		state.LocalState = "configured"
+		if cfg := vm.cfgs[name]; cfg != nil && cfg.GetBaseConfig().BindPort > 0 {
+			state.LocalState = "listening"
+		}
+		if got.LocalState != "" {
+			state.LocalState = got.LocalState
+		}
+		state.RemoteState = got.RemoteState
+		state.P2PState = got.P2PState
+		state.FallbackState = got.FallbackState
+		if got.Error != nil && got.Error.RecoveredAt == "" {
+			switch got.Error.Code {
+			case "plugin_failed", "listen_failed":
+				state.ErrorCode = got.Error.Code
+			case "peer_failed":
+				state.ErrorCode = "remote_failed"
+			case "p2p_failed":
+				state.ErrorCode = "p2p_failed"
+			case "fallback_failed":
+				state.ErrorCode = "fallback_failed"
+			}
+		}
+		vm.tunnelHandles[name].ObservedState(state)
+	}
+	return true
+}
diff --git a/client/visitor/tunnel_test.go b/client/visitor/tunnel_test.go
new file mode 100644
--- /dev/null
+++ b/client/visitor/tunnel_test.go
@@ -0,0 +1,82 @@
+package visitor
+
+import (
+	"context"
+	"net"
+	"testing"
+
+	"github.com/fatedier/frp/extension/frpmonitor/shared"
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+	"github.com/fatedier/frp/pkg/util/tunnelmonitor"
+)
+
+func TestTunnelVisitorAttemptsAndRuntimeStatesRemainSeparate(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	cfg := &v1.STCPVisitorConfig{VisitorBaseConfig: v1.VisitorBaseConfig{Name: "same", Type: "stcp", ServerName: "private", BindAddr: "127.0.0.1", BindPort: listener.Addr().(*net.TCPAddr).Port}}
+	r := tunnelmonitor.New("client")
+	m := NewManager(context.Background(), "run", &v1.ClientCommonConfig{User: "team", ClientID: "client"}, nil, nil, nil)
+	m.SetTunnelRegistry(r)
+	defer m.Close()
+	m.UpdateAll([]v1.VisitorConfigurer{cfg})
+	snapshot := r.Snapshot()
+	if snapshot.Validate() != nil || len(snapshot.Objects) != 1 || snapshot.Objects[0].State.ErrorCode != "listen_failed" || snapshot.Objects[0].State.RemoteState != "unknown" {
+		t.Fatal("failed attempt was not retained")
+	}
+	old := snapshot.Objects[0].InstanceID
+	listener.Close()
+	m.mu.Lock()
+	err = m.startVisitor(cfg)
+	m.mu.Unlock()
+	if err != nil {
+		t.Fatal("visitor retry failed")
+	}
+	current := func() shared.TunnelObject {
+		t.Helper()
+		if !m.ObserveTunnels() {
+			t.Fatal("visitor lock unexpectedly busy")
+		}
+		s := r.Snapshot()
+		if s.Validate() != nil {
+			t.Fatal("invalid private visitor observation")
+		}
+		for _, o := range s.Objects {
+			if o.ClosedAtMS == nil {
+				return o
+			}
+		}
+		t.Fatal("active visitor missing")
+		return shared.TunnelObject{}
+	}
+	o := current()
+	if o.InstanceID == old || o.State.LocalState != "listening" || o.State.RemoteState != "unknown" || o.Counters.RXBytes != nil {
+		t.Fatal("listener invented remote connectivity or reused failed instance")
+	}
+	m.mu.RLock()
+	v := m.visitors["same"].(*STCPVisitor)
+	m.mu.RUnlock()
+	a, b := net.Pipe()
+	defer b.Close()
+	connection := v.monitorConnection(a)
+	if current().State.RemoteState != "connected" {
+		t.Fatal("real visitor connection missing")
+	}
+	connection.Close()
+	connection.Close()
+	if current().State.RemoteState != "closed" {
+		t.Fatal("visitor close lost")
+	}
+	m.mu.Lock()
+	if m.ObserveTunnels() {
+		t.Error("observer waited behind mutation lock")
+	}
+	m.mu.Unlock()
+	m.UpdateAll(nil)
+	m.UpdateAll([]v1.VisitorConfigurer{cfg})
+	if current().InstanceID == o.InstanceID {
+		t.Fatal("same-name visitor recreation reused generation")
+	}
+}
