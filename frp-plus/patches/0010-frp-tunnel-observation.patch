@@ -0,0 +1,188 @@
+package server
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/fatedier/frp/extension/frpmonitor/shared"
+	v1 "github.com/fatedier/frp/pkg/config/v1"
+	"github.com/fatedier/frp/pkg/util/tunnelmonitor"
+)
+
+// A real native frpc keeps its first TCP stream alive while a reload removes
+// and recreates the same name. This exercises BaseProxy's actual Join callback,
+// not just the registry API or a synthetic counter increment.
+func TestTunnelNativeSameNameKeepsOldConnectionAccounting(t *testing.T) {
+	binary := os.Getenv("FRP_TUNNEL_E2E_AGENT")
+	if binary == "" {
+		t.Skip("FRP_TUNNEL_E2E_AGENT is required for isolated native forwarding regression")
+	}
+	dir := t.TempDir()
+	cfg := &v1.ServerConfig{}
+	if err := cfg.Complete(); err != nil {
+		t.Fatal("server defaults unavailable")
+	}
+	cfg.BindAddr = "127.0.0.1"
+	cfg.BindPort = 0
+	cfg.ProxyBindAddr = "127.0.0.1"
+	cfg.Monitor.ServerID = "tunnel-test"
+	svr, err := NewService(cfg)
+	if err != nil {
+		t.Fatal("isolated native server failed")
+	}
+	svr.tunnelRegistry = tunnelmonitor.New("server")
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() { svr.Run(ctx); close(done) }()
+	t.Cleanup(func() {
+		cancel()
+		svr.Close()
+		select {
+		case <-done:
+		case <-time.After(3 * time.Second):
+			t.Error("native server shutdown timeout")
+		}
+	})
+	echo, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal("echo listener unavailable")
+	}
+	t.Cleanup(func() { echo.Close() })
+	go func() {
+		for {
+			c, e := echo.Accept()
+			if e != nil {
+				return
+			}
+			go func() { defer c.Close(); _, _ = io.Copy(c, c) }()
+		}
+	}()
+	freePort := func() int {
+		l, e := net.Listen("tcp", "127.0.0.1:0")
+		if e != nil {
+			t.Fatal("port reservation failed")
+		}
+		p := l.Addr().(*net.TCPAddr).Port
+		l.Close()
+		return p
+	}
+	adminPort, remotePort := freePort(), freePort()
+	configFile := filepath.Join(dir, "frpc.toml")
+	base := fmt.Sprintf("serverAddr = \"127.0.0.1\"\nserverPort = %d\nuser = \"test\"\nclientID = \"stable\"\nwebServer.addr = \"127.0.0.1\"\nwebServer.port = %d\nlog.to = %q\n", svr.listener.Addr().(*net.TCPAddr).Port, adminPort, filepath.Join(dir, "client.log"))
+	proxy := fmt.Sprintf("\n[[proxies]]\nname = \"same\"\ntype = \"tcp\"\nlocalIP = \"127.0.0.1\"\nlocalPort = %d\nremotePort = %d\n", echo.Addr().(*net.TCPAddr).Port, remotePort)
+	write := func(enabled bool) {
+		text := base
+		if enabled {
+			text += proxy
+		}
+		if os.WriteFile(configFile, []byte(text), 0600) != nil {
+			t.Fatal("fixture configuration write failed")
+		}
+	}
+	write(true)
+	logFile, err := os.OpenFile(filepath.Join(dir, "process.log"), os.O_CREATE|os.O_WRONLY, 0600)
+	if err != nil {
+		t.Fatal("fixture log unavailable")
+	}
+	defer logFile.Close()
+	cmd := exec.Command(binary, "-c", configFile)
+	cmd.Stdout = logFile
+	cmd.Stderr = logFile
+	if cmd.Start() != nil {
+		t.Fatal("native client failed to start")
+	}
+	t.Cleanup(func() { _ = cmd.Process.Kill(); _ = cmd.Wait() })
+	wait := func(test func() bool) {
+		deadline := time.Now().Add(10 * time.Second)
+		for time.Now().Before(deadline) {
+			if test() {
+				return
+			}
+			time.Sleep(20 * time.Millisecond)
+		}
+		t.Fatal("native tunnel observation did not reach expected state")
+	}
+	find := func(id string) (shared.TunnelObject, bool) {
+		s := svr.tunnelRegistry.Snapshot()
+		if s.State != "ready" {
+			return shared.TunnelObject{}, false
+		}
+		for _, o := range s.Objects {
+			if o.InstanceID == id || id == "" && o.State.Status == "registered" {
+				return o, true
+			}
+		}
+		return shared.TunnelObject{}, false
+	}
+	var first shared.TunnelObject
+	wait(func() bool { var ok bool; first, ok = find(""); return ok })
+	dial := func() net.Conn {
+		c, e := net.DialTimeout("tcp", fmt.Sprintf("127.0.0.1:%d", remotePort), time.Second)
+		if e != nil {
+			t.Fatal("isolated tunnel connection failed")
+		}
+		t.Cleanup(func() { c.Close() })
+		return c
+	}
+	exchange := func(c net.Conn, text string) {
+		_ = c.SetDeadline(time.Now().Add(3 * time.Second))
+		if _, e := io.WriteString(c, text); e != nil {
+			t.Fatal("forwarding write failed")
+		}
+		b := make([]byte, len(text))
+		if _, e := io.ReadFull(c, b); e != nil || string(b) != text {
+			t.Fatal("forwarding payload mismatch")
+		}
+	}
+	old := dial()
+	exchange(old, "old-before")
+	client := &http.Client{Timeout: 2 * time.Second}
+	reload := func() {
+		r, e := client.Get(fmt.Sprintf("http://127.0.0.1:%d/api/reload?strictConfig=true", adminPort))
+		if e != nil {
+			t.Fatal("native reload failed")
+		}
+		io.Copy(io.Discard, r.Body)
+		r.Body.Close()
+		if r.StatusCode != http.StatusOK {
+			t.Fatal("native reload rejected")
+		}
+	}
+	write(false)
+	reload()
+	wait(func() bool { o, ok := find(first.InstanceID); return ok && o.State.Status == "closed" })
+	write(true)
+	reload()
+	var second shared.TunnelObject
+	wait(func() bool { var ok bool; second, ok = find(""); return ok && second.InstanceID != first.InstanceID })
+	next := dial()
+	exchange(next, "new")
+	next.Close()
+	wait(func() bool {
+		o, ok := find(second.InstanceID)
+		return ok && o.Counters.RXBytes != nil && *o.Counters.RXBytes == "3" && *o.Counters.TXBytes == "3"
+	})
+	exchange(old, "old-after")
+	before, ok := find(first.InstanceID)
+	if !ok || before.Counters.RXBytes == nil || *before.Counters.RXBytes != "0" || *before.Counters.Connections != "1" {
+		t.Fatal("old connection was prematurely accounted or merged")
+	}
+	old.Close()
+	wait(func() bool {
+		o, ok := find(first.InstanceID)
+		return ok && o.Counters.RXBytes != nil && *o.Counters.RXBytes == "19" && *o.Counters.TXBytes == "19" && *o.Counters.Connections == "0"
+	})
+	final, ok := find(second.InstanceID)
+	if !ok || *final.Counters.RXBytes != "3" || *final.Counters.TXBytes != "3" || !strings.EqualFold(first.Identity.RawName, final.Identity.RawName) {
+		t.Fatal("late old callback contaminated new instance")
+	}
+}
