new file mode 100644
--- /dev/null
+++ b/cmd/frpc/sub/maintenance_v3_test.go
@@ -0,0 +1,109 @@
+//go:build linux || darwin
+
+package sub
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/fatedier/frp/extension/frpmonitor/agent/configuration"
+	"github.com/fatedier/frp/extension/frpmonitor/agent/managed"
+)
+
+func TestMaintenanceV3ExplicitPolicyAndLocalEnvironment(t *testing.T) {
+	t.Setenv("http_proxy", "")
+	prior, priorDir, priorStrict, priorUnsafe := cfgFile, cfgDir, strictConfigMode, allowUnsafe
+	defer func() { cfgFile, cfgDir, strictConfigMode, allowUnsafe = prior, priorDir, priorStrict, priorUnsafe }()
+	cfgDir, strictConfigMode, allowUnsafe = "", true, nil
+	parent, err := filepath.EvalSymlinks(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	os.Chmod(parent, 0700)
+	installation := filepath.Join(parent, "installation")
+	root := filepath.Join(installation, "managed")
+	os.Mkdir(installation, 0700)
+	os.Mkdir(root, 0700)
+	cfgFile = filepath.Join(installation, "agent.toml")
+	main := fmt.Sprintf("serverAddr='127.0.0.1'\n[auth]\nmethod='token'\ntoken='{{ .Envs.LOCAL_TOKEN }}'\n[store]\npath=%q\n[telemetry]\nenabled=true\nendpoint='ws://127.0.0.1:17401/agent/v1/ws'\ntokenFile=%q\nallowInsecureLoopback=true\n[telemetry.configManagement]\nenabled=true\nroot=%q\n", filepath.Join(root, "store.json"), filepath.Join(installation, "agent.token"), root)
+	for name, value := range map[string]string{"agent.toml": main, "agent.token": "synthetic-monitor-token", "installation.json": `{"format":2,"roles":["agent"],"managed":{"version":1,"root":"managed","store":"store.json"}}`} {
+		if err = os.WriteFile(filepath.Join(installation, name), []byte(value), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	policy := configuration.BackupGraphPolicy{ConfigFile: cfgFile, WorkingDir: installation, StoreFile: filepath.Join(root, "store.json"), Roots: []configuration.BackupRoot{{ID: "installation", Path: installation}}}
+	encoded, err := configuration.EncodeBackupPolicy(policy)
+	if err != nil {
+		t.Fatal(err)
+	}
+	policyPath := filepath.Join(parent, "policy.json")
+	os.WriteFile(policyPath, encoded, 0600)
+	envPath := filepath.Join(parent, "values.json")
+	secret := "synthetic-unarchived-environment-secret"
+	os.WriteFile(envPath, []byte(`{"LOCAL_TOKEN":"`+secret+`"}`), 0600)
+	e, err := managed.Open(managed.Options{Root: root, StorePath: policy.StoreFile})
+	if err != nil {
+		t.Fatal(err)
+	}
+	e.Close()
+	out := filepath.Join(parent, "checkpoint")
+	output, err := maintenanceCLI(t, "checkpoint", "--output", out, "--offline", "--policy", policyPath, "--env-file", envPath)
+	if err != nil {
+		t.Fatal("v3 checkpoint", err)
+	}
+	var summary managed.CheckpointSummary
+	if json.Unmarshal([]byte(output), &summary) != nil {
+		t.Fatal("summary")
+	}
+	if version, err := managed.CheckpointVersion(out, summary.ManifestDigest); err != nil || version != 3 {
+		t.Fatal("version3", version, err)
+	}
+	err = filepath.WalkDir(out, func(path string, entry os.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if !entry.IsDir() {
+			data, err := os.ReadFile(path)
+			if err != nil {
+				return err
+			}
+			if bytes.Contains(data, []byte(secret)) {
+				t.Fatal("rendered environment leaked")
+			}
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = maintenanceCLI(t, "restore-install", "--checkpoint", out, "--root", root, "--manifest-digest", summary.ManifestDigest, "--offline"); err == nil {
+		t.Fatal("v3 accepted without local authorization")
+	}
+	output, err = maintenanceCLI(t, "restore-install", "--checkpoint", out, "--root", root, "--manifest-digest", summary.ManifestDigest, "--offline", "--policy", policyPath, "--source-policy", policyPath, "--env-file", envPath)
+	if err != nil {
+		t.Fatal("v3 install", err)
+	}
+	if strings.Contains(output, parent) || strings.Contains(output, secret) {
+		t.Fatal("private CLI summary")
+	}
+}
+
+func TestMaintenanceEnvironmentFileCannotAlsoBecomeArchivedDependency(t *testing.T) {
+	policy := configuration.BackupGraphPolicy{StoreFile: "/synthetic/values.json"}
+	if !maintenanceEnvironmentCollision(policy.StoreFile, []string{policy.StoreFile}) {
+		t.Fatal("Store collision")
+	}
+	if maintenanceEnvironmentCollision("/synthetic/other", []string{policy.StoreFile}) {
+		t.Fatal("unrelated path rejected")
+	}
+	// The wrapper rejects Store aliasing before it reads configuration or writes a checkpoint.
+	_, err := maintenanceCaptureV3(policy, policy.StoreFile)(t.Context(), nil)
+	if err != managed.ErrUnsafePath {
+		t.Fatal("local input not excluded", err)
+	}
+}
