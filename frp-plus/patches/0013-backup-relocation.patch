+// Explicit environment inputs are local only, including when a configuration
+// or administrator mapping accidentally also references that file as a token.
+func maintenanceEnvironmentCollision(path string, excluded []string) bool {
+	for _, name := range excluded {
+		if name == "" {
+			continue
+		}
+		absolute, err := filepath.Abs(name)
+		if err != nil || absolute == path {
+			return true
+		}
+	}
+	return false
+}
+func maintenanceCaptureV3(policy configuration.BackupGraphPolicy, excluded ...string) managed.ContextCaptureV3 {
+	base := configuration.CheckpointCaptureV3(policy)
+	return func(ctx context.Context, variants []managed.StoreVariant) (managed.ContextSnapshotV3, error) {
+		if maintenanceEnvironmentCollision(policy.StoreFile, excluded) {
+			return managed.ContextSnapshotV3{}, managed.ErrUnsafePath
+		}
+		out, err := base(ctx, variants)
+		if err != nil {
+			return out, err
+		}
+		for _, file := range out.Files {
+			if maintenanceEnvironmentCollision(file.Path, excluded) {
+				return managed.ContextSnapshotV3{}, managed.ErrUnsafePath
+			}
+		}
+		return out, nil
+	}
+}
+func maintenanceRelocatorV3(source, target configuration.BackupGraphPolicy, excluded ...string) managed.ContextRelocatorV3 {
+	base := configuration.PrepareRelocationV3(source, target)
+	return func(ctx context.Context, m managed.CheckpointManifestV2, files []managed.ContextFile, variants []managed.StoreVariant, graph, policy []byte) (managed.RelocationContextV3, error) {
+		if maintenanceEnvironmentCollision(source.StoreFile, excluded) || maintenanceEnvironmentCollision(target.StoreFile, excluded) {
+			return managed.RelocationContextV3{}, managed.ErrUnsafePath
+		}
+		for _, file := range files {
+			if maintenanceEnvironmentCollision(file.Path, excluded) {
+				return managed.RelocationContextV3{}, managed.ErrUnsafePath
+			}
+		}
+		out, err := base(ctx, m, files, variants, graph, policy)
+		if err != nil {
+			return out, err
+		}
+		for _, file := range out.Context.Files {
+			if maintenanceEnvironmentCollision(file.Path, excluded) {
+				return managed.RelocationContextV3{}, managed.ErrUnsafePath
+			}
+		}
+		return out, nil
+	}
+}
